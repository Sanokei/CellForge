{
 "defs": {
  "all_present": {
   "act": "step",
   "kind": "cell",
   "params": {
    "W1": "all_W",
    "b1": "all_b"
   }
  },
  "any_present": {
   "act": "step",
   "kind": "cell",
   "params": {
    "W1": "any_W",
    "b1": "any_b"
   }
  },
  "closure_step": {
   "inputs": [
    "facts",
    "antecedents",
    "required",
    "active",
    "conclusions",
    "query"
   ],
   "kind": "bundle",
   "nodes": [
    {
     "id": "rules",
     "in": {
      "active": "$active",
      "antecedents": "$antecedents",
      "facts": "$facts",
      "required": "$required"
     },
     "use": "rule_firing"
    },
    {
     "id": "votes",
     "in": {
      "a": "$conclusions",
      "b": "rules.fired"
     },
     "use": "op:matmul"
    },
    {
     "id": "derived",
     "in": {
      "x": "votes"
     },
     "use": "any_present"
    },
    {
     "id": "closure",
     "in": {
      "a": "$facts",
      "b": "derived"
     },
     "use": "op:maximum"
    },
    {
     "id": "answer",
     "in": {
      "a": "$query",
      "b": "closure"
     },
     "use": "op:matmul"
    }
   ],
   "outputs": {
    "entailed": "answer",
    "facts": "closure",
    "fired": "rules.fired"
   },
   "role": "cluster"
  },
  "rule_firing": {
   "inputs": [
    "facts",
    "antecedents",
    "required",
    "active"
   ],
   "kind": "bundle",
   "nodes": [
    {
     "id": "counts",
     "in": {
      "a": "$antecedents",
      "b": "$facts"
     },
     "use": "op:matmul"
    },
    {
     "args": {
      "axis": 1
     },
     "id": "pair",
     "in": {
      "x0": "counts",
      "x1": "$required"
     },
     "use": "op:concat"
    },
    {
     "id": "ready",
     "in": {
      "x": "pair"
     },
     "use": "all_present"
    },
    {
     "id": "fire",
     "in": {
      "a": "ready",
      "b": "$active"
     },
     "use": "op:mul"
    }
   ],
   "outputs": {
    "fired": "fire"
   },
   "role": "cluster"
  }
 },
 "entries": {
  "step": "closure_step"
 },
 "format": "cellforge-graph/1",
 "meta": {
  "construction": "authored positive propositional Horn fixed point; no fitting",
  "deduction_interface": "horn-closure-graph/1",
  "limitations": "bounded supplied Horn rules only; no natural-language understanding or rule induction",
  "max_antecedents": 4,
  "max_atoms": 32,
  "max_rules": 64,
  "policy": "positive ASCII identifiers only; negation unsupported; not_proven does not mean false",
  "task": "deduction"
 },
