[{"task_id":"47c1f68c","source_lines":["def run(params, grid, demos):","    background = int(round(params['geometry'][0]))","    divisor = int(round(params['geometry'][1]))","    removal = int(round(params['geometry'][2]))","    horizontal = int(round(params['geometry'][3]))","    vertical = int(round(params['geometry'][4]))","    start = int(round(params['geometry'][5]))","    if divisor < 1 or removal < 1:","        return grid.copy()","    horizontal = horizontal % grid.ndim","    vertical = vertical % grid.ndim","    row = grid.shape[0] // divisor","    col = grid.shape[1] // divisor","    if row >= grid.shape[0] or col >= grid.shape[1]:","        return grid.copy()","    colour = int(grid[row, col])","    quadrant = grid[start:row + 1 - removal, start:col + 1 - removal]","    quadrant = np.where(quadrant != background, colour, background)","    upper = np.concatenate((quadrant, np.flip(quadrant, axis=horizontal)), axis=horizontal)","    return np.concatenate((upper, np.flip(upper, axis=vertical)), axis=vertical)"],"shapes":{"geometry":[6]},"params":{"geometry":[0,2,1,1,0,0]},"rationale":"Remove the central separator row and column, recolour the upper-left pattern with the separator colour, and reflect it horizontally and vertically to fill all four quadrants. Tensor values specify background, midpoint divisor, separator removal, reflection axes, and quadrant start."}]