[{"task_id":"6a11f6da","source_lines":["def run(params, grid, demos):","    count = int(round(params['panels'][0]))","    if count <= 0 or count > grid.shape[0]:","        return grid.copy()","    height = grid.shape[0] // count","    background = int(round(params['colors'][0]))","    out = np.full((height, grid.shape[1]), background, dtype=int)","    for step, value in enumerate(params['order']):","        panel = int(round(value))","        color = int(round(params['colors'][step + 1]))","        if panel >= 0 and panel < count:","            layer = grid[panel * height:(panel + 1) * height, :]","            out = np.where(layer == color, color, out)","    return out"],"shapes":{"panels":[1],"colors":[4],"order":[3]},"params":{"panels":[3],"colors":[0,8,1,6],"order":[1,0,2]},"rationale":"Split the input into three equal horizontal panels and overlay their colored cells, with 6 taking precedence over 1, and 1 over 8."}]