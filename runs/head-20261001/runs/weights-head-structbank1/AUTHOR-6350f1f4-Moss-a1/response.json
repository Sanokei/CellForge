[{"task_id":"6350f1f4","source_lines":["def spans(mask):","    result = []","    start = None","    for i in range(len(mask)):","        if not mask[i]:","            if start is None:","                start = i","        elif start is not None:","            result.append((start, i))","            start = None","    if start is not None:","        result.append((start, len(mask)))","    return result","","def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    noise = int(round(params['rule'][1]))","    diversity = int(round(params['rule'][2]))","    evidence = int(round(params['rule'][3]))","    separator = np.logical_or(grid == background, grid == noise)","    rows = spans(np.all(separator, axis=1))","    cols = spans(np.all(separator, axis=0))","    template = None","    for top, bottom in rows:","        for left, right in cols:","            block = grid[top:bottom, left:right]","            if np.any(block == noise) or np.any(block == background):","                continue","            if len(np.unique(block)) >= diversity:","                template = block.copy()","                break","        if template is not None:","            break","    if template is None:","        return grid.copy()","    colors, counts = np.unique(template, return_counts=True)","    main = int(colors[np.argmax(counts)])","    result = np.full(grid.shape, background, dtype=int)","    for top, bottom in rows:","        for left, right in cols:","            block = grid[top:bottom, left:right]","            if np.count_nonzero(block == main) >= evidence:","                result[top:bottom, left:right] = main","            elif block.shape == template.shape:","                result[top:bottom, left:right] = template","            else:","                return grid.copy()","    return result"],"shapes":{"rule":[4]},"params":{"rule":[0,5,2,1]},"rationale":"Zero separators partition the grid into blocks; gray is corruption. Recover an intact multicolor template and its majority color. Blocks containing that majority color become solid majority-color blocks, while blocks of the other color become copies of the template. Restore all separators to zero."}]