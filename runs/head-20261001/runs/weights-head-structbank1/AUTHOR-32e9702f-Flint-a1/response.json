[{"task_id":"32e9702f","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    fill = int(round(params['rule'][1]))","    shift = int(round(params['rule'][2]))","    out = np.full(grid.shape, fill, dtype=int)","    height, width = grid.shape","    for row in range(height):","        for col in range(width):","            if grid[row, col] != background:","                target = col + shift","                if 0 <= target < width:","                    out[row, target] = grid[row, col]","    return out"],"shapes":{"rule":[3]},"params":{"rule":[0,5,-1]},"rationale":"Shift every nonzero cell one column left, clipping at the left edge, and fill all remaining cells with gray (5). The tensor specifies the background color, fill color, and horizontal displacement."}]