[{"task_id":"e7dd8335","source_lines":["def run(params, grid, demos):","    source = int(round(params['rule'][0]))","    target = int(round(params['rule'][1]))","    axis = int(round(params['rule'][2])) % len(grid.shape)","    fraction = float(params['rule'][3])","    extent = float(params['rule'][4])","    result = grid.copy()","    positions = np.argwhere(grid == source)","    if len(positions) == 0:","        return result","    low = np.min(positions[:, axis])","    high = np.max(positions[:, axis])","    boundary = low + fraction * (high - low + extent)","    for position in positions:","        if position[axis] >= boundary:","            row, col = position","            result[row, col] = target","    return result"],"shapes":{"rule":[5]},"params":{"rule":[1,2,0,0.5,1]},"rationale":"Recolor blue cells in the lower half of the blue object's bounding box red. The tensors specify source and target colors, vertical axis, halfway fraction, and inclusive extent."}]