[{"task_id":"d968ffd4","source_lines":["def run(params, grid, demos):","    step = int(round(params['geometry'][0]))","    divisor = int(round(params['geometry'][1]))","    if step <= 0 or divisor <= step:","        return grid.copy()","    zero = step - step","    work = grid.copy()","    transposed = work.shape[0] < work.shape[1]","    if transposed:","        work = work.T.copy()","    background = work[zero, zero]","    occupied = np.any(work != background, axis=1)","    positions = np.where(occupied)[0]","    if len(positions) < divisor:","        return grid.copy()","    first = int(positions[zero])","    last = int(positions[len(positions) - step])","    gaps = []","    for row in range(first, last + step):","        if not occupied[row]:","            gaps.append(row)","    if len(gaps) == zero:","        return grid.copy()","    start = gaps[zero]","    end = gaps[len(gaps) - step] + step","    extent = (end - start) // divisor","    first_colors = work[first][work[first] != background]","    last_colors = work[last][work[last] != background]","    upper_color = int(first_colors[zero])","    lower_color = int(last_colors[zero])","    work[start:start + extent, :] = upper_color","    work[end - extent:end, :] = lower_color","    if transposed:","        work = work.T.copy()","    return work"],"shapes":{"geometry":[2]},"params":{"geometry":[1.0,2.0]},"rationale":"Orient along the longer axis. Each colored end block extends across the full short axis into half the intervening gap. An odd gap retains its central background line. The tensors specify the unit boundary increment and equal two-way division."}]