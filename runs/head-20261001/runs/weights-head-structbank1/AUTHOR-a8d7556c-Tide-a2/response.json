[{"task_id":"a8d7556c","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    highlight = int(round(params['rule'][1]))","    minimum_height = int(round(params['rule'][2]))","    minimum_width = int(round(params['rule'][3]))","    result = grid.copy()","    height, width = grid.shape","    if minimum_height <= 0 or minimum_width <= 0 or background == highlight:","        return result","    while True:","        best_area = 0","        best = None","        for row in range(height):","            for col in range(width):","                for bottom in range(row + minimum_height, height + 1):","                    for right in range(col + minimum_width, width + 1):","                        area = (bottom - row) * (right - col)","                        if area > best_area:","                            if np.all(result[row:bottom, col:right] == background):","                                best_area = area","                                best = (row, col, bottom, right)","        if best is None:","            break","        row, col, bottom, right = best","        result[row:bottom, col:right] = highlight","    return result"],"shapes":{"rule":[4]},"params":{"rule":[0,2,2,2]},"rationale":"Repeatedly recolor the largest remaining all-zero rectangle with both dimensions at least two. Choosing larger rectangles first preserves the third demonstration's four-by-two rectangle while excluding its overlapping two-by-three side bulge."}]