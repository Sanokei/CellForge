[{"task_id":"97c75046","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    obstacle = int(round(params['colors'][1]))","    marker = int(round(params['colors'][2]))","    directions = [(int(round(v[0])), int(round(v[1]))) for v in params['directions']]","    out = grid.copy()","    positions = np.argwhere(grid == marker)","    if len(positions) == 0:","        return out","    r, c = positions[0]","    h, w = grid.shape","    best = None","    for dr, dc in directions:","        rr, cc = r + dr, c + dc","        distance = 0","        while 0 <= rr < h and 0 <= cc < w:","            distance += 1","            if grid[rr, cc] == obstacle:","                if best is None or distance < best[0]:","                    best = (distance, dr, dc)","                break","            rr, cc = rr + dr, cc + dc","    if best is None:","        return out","    out[r, c] = bg","    distance, dr, dc = best","    for step in range(distance - 1):","        r, c = r + dr, c + dc","    for step in range(h + w):","        moved = False","        for sr, sc in directions:","            if sr * dr + sc * dc != 0:","                continue","            rr, cc = r + dr + sr, c + dc + sc","            if not (0 <= rr < h and 0 <= cc < w):","                continue","            if out[rr, cc] != bg:","                continue","            touching = False","            for ar, ac in directions:","                nr, nc = rr + ar, cc + ac","                if 0 <= nr < h and 0 <= nc < w and out[nr, nc] == obstacle:","                    touching = True","            if touching:","                r, c = rr, cc","                moved = True","                break","        if not moved:","            break","    out[r, c] = marker","    return out"],"shapes":{"colors":[3],"directions":[4,2]},"params":{"colors":[7,0,5],"directions":[[1,0],[-1,0],[0,1],[0,-1]]},"rationale":"Move the gray pixel toward the black shape along the nearest cardinal ray, then slide diagonally along its boundary while maintaining contact, stopping when the next position is blocked or loses contact."}]