[{"task_id":"6e19193c","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    size = int(round(params['rule'][1]))","    count = int(round(params['rule'][2]))","    step = int(round(params['rule'][3]))","    out = grid.copy()","    h, w = grid.shape","    if step <= 0 or size != step + step:","        return out","    for r in range(h - size + step):","        for c in range(w - size + step):","            block = grid[r:r + size, c:c + size]","            if np.count_nonzero(block != bg) != count:","                continue","            missing = np.argwhere(block == bg)","            colors = np.unique(block[block != bg])","            if len(missing) != step or len(colors) != step:","                continue","            mr, mc = missing[0]","            dr = int(mr * size - step)","            dc = int(mc * size - step)","            rr = r + int(mr) + dr","            cc = c + int(mc) + dc","            while 0 <= rr < h and 0 <= cc < w:","                out[rr, cc] = colors[0]","                rr += dr","                cc += dc","    return out"],"shapes":{"rule":[4]},"params":{"rule":[0,2,3,1]},"rationale":"Each monochromatic three-cell L in a 2×2 square emits a diagonal ray toward its missing corner. The missing corner stays empty; the ray starts one cell beyond it and continues to the grid boundary."}]