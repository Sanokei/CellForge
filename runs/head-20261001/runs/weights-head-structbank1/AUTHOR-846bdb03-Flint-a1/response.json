[{"task_id":"846bdb03","source_lines":["def run(params, grid, demos):","    bg = int(round(params['background'][0]))","    marker = int(round(params['marker'][0]))","    inset = int(round(params['inset'][0]))","    corners = int(round(params['corners'][0]))","    axis = int(round(params['reflection_axis'][0]))","    marks = np.argwhere(grid == marker)","    if len(marks) != corners or len(marks) == 0 or inset <= 0 or axis < 0 or axis >= grid.ndim:","        return grid.copy()","    top = int(np.min(marks[:, 0]))","    bottom = int(np.max(marks[:, 0]))","    left = int(np.min(marks[:, 1]))","    right = int(np.max(marks[:, 1]))","    if top + inset >= bottom or left + inset >= right:","        return grid.copy()","    left_color = int(grid[top + inset, left])","    right_color = int(grid[top + inset, right])","    points = []","    for point in np.argwhere(np.logical_and(grid != bg, grid != marker)):","        r = int(point[0])","        c = int(point[1])","        if r < top or r > bottom or c < left or c > right:","            points.append([r, c])","    if len(points) == 0:","        return grid.copy()","    positions = np.array(points)","    r0 = int(np.min(positions[:, 0]))","    r1 = int(np.max(positions[:, 0]))","    c0 = int(np.min(positions[:, 1]))","    c1 = int(np.max(positions[:, 1]))","    pattern = grid[r0:r1 + inset, c0:c1 + inset].copy()","    lp = np.argwhere(pattern == left_color)","    rp = np.argwhere(pattern == right_color)","    if len(lp) == 0 or len(rp) == 0:","        return grid.copy()","    if np.min(lp[:, axis]) > np.min(rp[:, axis]):","        pattern = np.flip(pattern, axis=axis)","    out = grid[top:bottom + inset, left:right + inset].copy()","    h, w = pattern.shape","    if h > out.shape[0] - inset - inset or w > out.shape[1] - inset - inset:","        return grid.copy()","    out[inset:inset + h, inset:inset + w] = pattern","    return out"],"shapes":{"background":[1],"marker":[1],"inset":[1],"corners":[1],"reflection_axis":[1]},"params":{"background":[0],"marker":[4],"inset":[1],"corners":[4],"reflection_axis":[1]},"rationale":"Crop the rectangle defined by the four yellow endpoints. Extract the separate two-color pattern, reflect it horizontally when its color order opposes the rectangle's side colors, and insert it between the side bars."}]