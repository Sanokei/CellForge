[{"task_id":"d492a647","source_lines":["def run(params, grid, demos):","    background = int(round(params['palette'][0]))","    obstacle = int(round(params['palette'][1]))","    row_period = int(round(params['period'][0]))","    col_period = int(round(params['period'][1]))","    out = grid.copy()","    if row_period <= 0 or col_period <= 0:","        return out","    seeds = np.argwhere((grid != background) & (grid != obstacle))","    if len(seeds) != 1:","        return out","    row, col = seeds[0]","    color = int(grid[row, col])","    for r in range(grid.shape[0]):","        for c in range(grid.shape[1]):","            if (r - row) % row_period == 0 and (c - col) % col_period == 0 and grid[r, c] == background:","                out[r, c] = color","    return out"],"shapes":{"palette":[2],"period":[2]},"params":{"palette":[0,5],"period":[2,2]},"rationale":"Extend the seed color across a lattice spaced two rows and two columns apart, anchored at the seed. Recolor only background cells, preserving gray obstacles."}]