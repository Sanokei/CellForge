[{"task_id":"4852f2fa","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    object_color = int(round(params['colors'][1]))","    marker_color = int(round(params['colors'][2]))","    height = int(round(params['layout'][0]))","    width = int(round(params['layout'][1]))","    unit = int(round(params['layout'][2]))","    positions = np.argwhere(grid == object_color)","    copies = int(np.count_nonzero(grid == marker_color))","    if height <= 0 or width <= 0 or copies <= 0 or len(positions) == 0:","        return np.full((1, 1), background, dtype=int)","    bottom = int(np.max(positions[:, 0]))","    right = int(np.max(positions[:, 1]))","    top = bottom - height + unit","    left = right - width + unit","    motif = np.full((height, width), background, dtype=int)","    for row in range(height):","        for col in range(width):","            source_row = top + row","            source_col = left + col","            if 0 <= source_row < grid.shape[0] and 0 <= source_col < grid.shape[1]:","                if grid[source_row, source_col] == object_color:","                    motif[row, col] = object_color","    return np.tile(motif, (unit, copies))"],"shapes":{"colors":[3],"layout":[3]},"params":{"colors":[0,8,4],"layout":[3,3,1]},"rationale":"Extract the azure motif into a 3×3 block aligned with its bottom and right edges, padding with background where needed. Repeat this block horizontally once per yellow marker."}]