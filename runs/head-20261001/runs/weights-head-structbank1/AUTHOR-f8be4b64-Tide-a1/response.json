[{"task_id":"f8be4b64","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    green = int(round(params['colors'][1]))","    arm = int(round(params['distances'][0]))","    start = int(round(params['distances'][1]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    h, w = grid.shape","    centers = []","    for r in range(h):","        for c in range(w):","            if grid[r, c] == green:","                continue","            valid = True","            for dr, dc in directions:","                rr = r + arm * dr","                cc = c + arm * dc","                if rr < 0 or rr >= h or cc < 0 or cc >= w:","                    valid = False","                    break","                if grid[rr, cc] != green:","                    valid = False","                    break","            if valid:","                centers.append((r, c, int(grid[r, c])))","    out = grid.copy()","    for dr, dc in directions:","        if dr == 0 and dc == 0:","            continue","        for r, c, color in centers:","            rr = r + start * dr","            cc = c + start * dc","            while rr >= 0 and rr < h and cc >= 0 and cc < w:","                if grid[rr, cc] == green:","                    break","                out[rr, cc] = bg if color == bg else color","                rr += dr","                cc += dc","    return out"],"shapes":{"colors":[2],"distances":[2],"directions":[4,2]},"params":{"colors":[0,3],"distances":[1,2],"directions":[[0,-1],[0,1],[-1,0],[1,0]]},"rationale":"Each center surrounded by four green arms emits horizontal and vertical rays in its center color, including background-colored centers. Rays begin beyond their own arms and stop at another green cell. Vertical rays take precedence over horizontal rays at intersections; original green arms and centers remain intact."}]