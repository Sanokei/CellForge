[{"task_id":"e5c44e8f","source_lines":["def run(params, grid, demos):","    ink = int(round(params['config'][0]))","    obstacle = int(round(params['config'][1]))","    length = int(round(params['config'][2]))","    growth = int(round(params['config'][3]))","    repeat = int(round(params['config'][4]))","    out = grid.copy()","    if ink == obstacle or ink < 0 or ink > 9 or repeat <= 0:","        return out","    seeds = np.argwhere(grid == ink)","    if len(seeds) != 1:","        return out","    row = int(seeds[0][0])","    col = int(seeds[0][1])","    height, width = grid.shape","    directions = params['directions']","    for segment in range((height + width) * len(directions)):","        direction = segment % len(directions)","        dr = int(round(directions[direction][0]))","        dc = int(round(directions[direction][1]))","        for step in range(max(0, length)):","            row += dr","            col += dc","            if 0 <= row < height and 0 <= col < width:","                if grid[row, col] == obstacle:","                    return out","                out[row, col] = ink","        if (segment + 1) % repeat == 0:","            length += growth","    return out"],"shapes":{"config":[5],"directions":[4,2]},"params":{"config":[3,2,2,2,2],"directions":[[-1,0],[0,1],[1,0],[0,-1]]},"rationale":"From the green seed, draw a clockwise square spiral with segment lengths 2,2,4,4,6,6,..., starting upward. Stop immediately before entering a red cell. Continue through coordinates outside the grid, drawing only visible portions; this explains the bottom green row in the unobstructed demonstration."}]