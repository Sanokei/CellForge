[{"task_id":"fd4b2b02","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colours'][0]))","    a = int(round(params['colours'][1]))","    b = int(round(params['colours'][2]))","    zero = int(round(params['geometry'][0]))","    unit = int(round(params['geometry'][1]))","    out = grid.copy()","    points = np.argwhere(grid != bg)","    if len(points) == 0:","        return out","    top = int(np.min(points[:, 0]))","    left = int(np.min(points[:, 1]))","    height = int(np.max(points[:, 0])) - top + unit","    width = int(np.max(points[:, 1])) - left + unit","    colour = int(grid[top, left])","    if colour != a and colour != b:","        return out","    rows = len(grid)","    cols = len(grid[0])","    for direction in params['directions']:","        dr = int(round(direction[0]))","        dc = int(round(direction[1]))","        r = top","        c = left","        h = height","        w = width","        value = colour","        for step in range(rows + cols):","            nh = w","            nw = h","            if dr > zero:","                nr = r + h","            else:","                nr = r - nh","            if dc > zero:","                nc = c + w","            else:","                nc = c - nw","            if value == a:","                value = b","            else:","                value = a","            rstart = max(zero, nr)","            rend = min(rows, nr + nh)","            cstart = max(zero, nc)","            cend = min(cols, nc + nw)","            if rstart < rend and cstart < cend:","                out[rstart:rend, cstart:cend] = value","            r = nr","            c = nc","            h = nh","            w = nw","    return out"],"shapes":{"colours":[3],"geometry":[2],"directions":[4,2]},"params":{"colours":[0,3,6],"geometry":[0,1],"directions":[[-1,-1],[-1,1],[1,-1],[1,1]]},"rationale":"Extend four diagonal staircases from the seed rectangle. Each successive rectangle swaps height and width, alternates green and magenta, and touches the preceding rectangle at a corner. Clip rectangles at the grid boundary."}]