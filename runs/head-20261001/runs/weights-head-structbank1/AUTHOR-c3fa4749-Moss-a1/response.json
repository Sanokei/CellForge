[{"task_id":"c3fa4749","source_lines":["def run(params, grid, demos):","    size = int(round(params['geometry'][0]))","    wall_min = int(round(params['geometry'][1]))","    hole_min = int(round(params['geometry'][2]))","    side_count = int(round(params['geometry'][3]))","    step = int(round(params['geometry'][4]))","    zero = int(round(params['geometry'][5]))","    out = grid.copy()","    if size < 2 or wall_min < size or hole_min < 1 or side_count != 1 or step != 1 or zero != 0:","        return out","    height, width = grid.shape","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    for color in np.unique(grid):","        color = int(color)","        core = np.zeros(grid.shape, dtype=bool)","        for r in range(height - size + step):","            for c in range(width - size + step):","                if np.all(grid[r:r + size, c:c + size] == color):","                    core[r:r + size, c:c + size] = True","        visited = set()","        for point in np.argwhere(core):","            start = (int(point[0]), int(point[1]))","            if start in visited:","                continue","            visited.add(start)","            queue = [start]","            cells = []","            while queue:","                r, c = queue.pop()","                cells.append((r, c))","                for dr, dc in directions:","                    nr, nc = r + dr, c + dc","                    if zero <= nr < height and zero <= nc < width and core[nr, nc] and (nr, nc) not in visited:","                        visited.add((nr, nc))","                        queue.append((nr, nc))","            if len(cells) < wall_min:","                continue","            top = min(p[0] for p in cells)","            bottom = max(p[0] for p in cells)","            left = min(p[1] for p in cells)","            right = max(p[1] for p in cells)","            holes_seen = set()","            for r in range(top, bottom + step):","                for c in range(left, right + step):","                    if grid[r, c] == color or (r, c) in holes_seen:","                        continue","                    holes_seen.add((r, c))","                    queue = [(r, c)]","                    hole = []","                    sides = set()","                    mouth = []","                    while queue:","                        hr, hc = queue.pop()","                        hole.append((hr, hc))","                        if hr == top:","                            sides.add('top')","                            mouth.append(int(grid[hr, hc]))","                        if hr == bottom:","                            sides.add('bottom')","                            mouth.append(int(grid[hr, hc]))","                        if hc == left:","                            sides.add('left')","                            mouth.append(int(grid[hr, hc]))","                        if hc == right:","                            sides.add('right')","                            mouth.append(int(grid[hr, hc]))","                        for dr, dc in directions:","                            nr, nc = hr + dr, hc + dc","                            if top <= nr <= bottom and left <= nc <= right and grid[nr, nc] != color and (nr, nc) not in holes_seen:","                                holes_seen.add((nr, nc))","                                queue.append((nr, nc))","                    if len(hole) >= hole_min and len(sides) == side_count and len(set(mouth)) == side_count:","                        replacement = mouth[zero]","                        for hr, hc in hole:","                            out[hr, hc] = replacement","    return out"],"shapes":{"geometry":[6],"directions":[4,2]},"params":{"geometry":[2,16,3,1,1,0],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Locate thick monochromatic walls through connected two-by-two blocks. A cavity opening onto exactly one side of its wall bounding box is filled with the uniform color at its mouth. Enclosed cavities and cavities with multiple openings remain unchanged. Geometry and connectivity are supplied by the tensors."}]