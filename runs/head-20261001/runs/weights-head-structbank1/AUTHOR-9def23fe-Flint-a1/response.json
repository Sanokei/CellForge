[{"task_id":"9def23fe","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    ink = int(round(params['colors'][1]))","    unit = int(round(params['step'][0]))","    out = grid.copy()","    if bg == ink or unit != 1:","        return out","    points = np.argwhere(grid == ink)","    if len(points) == 0:","        return out","    low = np.min(points, axis=0)","    high = np.max(points, axis=0)","    for av in params['axes']:","        axis = int(round(av))","        if axis < 0 or axis > unit:","            return grid.copy()","        other = unit - axis","        for dv in params['directions']:","            direction = int(round(dv))","            if abs(direction) != unit:","                return grid.copy()","            if direction < 0:","                start = int(low[axis]) - unit","                stop = -unit","            else:","                start = int(high[axis]) + unit","                stop = grid.shape[axis]","            for lane in range(int(low[other]), int(high[other]) + unit):","                ray = []","                clear = True","                for position in range(start, stop, direction):","                    coord = [lane, lane]","                    coord[axis] = position","                    row, col = coord","                    ray.append((row, col))","                    if grid[row, col] != bg:","                        clear = False","                if clear:","                    for row, col in ray:","                        out[row, col] = ink","    return out"],"shapes":{"colors":[2],"step":[1],"axes":[2],"directions":[2]},"params":{"colors":[0,2],"step":[1],"axes":[0,1],"directions":[-1,1]},"rationale":"Extend each row and column of the red rectangle outward to the grid boundary. Suppress an entire outward ray when any marker lies along it. Preserve the rectangle and all markers. The tensors specify background, paint color, axes, directions, and step."}]