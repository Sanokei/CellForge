[{"task_id":"d93c6891","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    base = int(round(params['colors'][1]))","    paint = int(round(params['colors'][2]))","    block = int(round(params['colors'][3]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    out = grid.copy()","    out[grid == paint] = base","    area = np.argwhere(grid != background)","    if len(area) == 0:","        return out","    top = int(np.min(area[:, 0]))","    bottom = int(np.max(area[:, 0]))","    left = int(np.min(area[:, 1]))","    right = int(np.max(area[:, 1]))","    height, width = grid.shape","    seen = set()","    for position in np.argwhere(np.logical_or(grid == paint, grid == block)):","        start = (int(position[0]), int(position[1]))","        if start in seen:","            continue","        seen.add(start)","        pending = [start]","        orange = []","        gray = []","        while pending:","            r, c = pending.pop()","            if grid[r, c] == paint:","                gray.append((r, c))","            else:","                orange.append((r, c))","            for dr, dc in directions:","                nr, nc = r + dr, c + dc","                if nr < 0 or nr >= height or nc < 0 or nc >= width:","                    continue","                point = (nr, nc)","                if point in seen:","                    continue","                if grid[nr, nc] == paint or grid[nr, nc] == block:","                    seen.add(point)","                    pending.append(point)","        if not orange or not gray:","            continue","        rows = [point[0] for point in orange]","        cols = [point[1] for point in orange]","        if min(rows) == top:","            span = len(set(cols))","            depth = len(gray) // span","            for r, c in orange:","                if r - top < depth:","                    out[r, c] = paint","        elif max(rows) == bottom:","            span = len(set(cols))","            depth = len(gray) // span","            for r, c in orange:","                if bottom - r < depth:","                    out[r, c] = paint","        elif min(cols) == left:","            span = len(set(rows))","            depth = len(gray) // span","            for r, c in orange:","                if c - left < depth:","                    out[r, c] = paint","        elif max(cols) == right:","            span = len(set(rows))","            depth = len(gray) // span","            for r, c in orange:","                if right - c < depth:","                    out[r, c] = paint","    return out"],"shapes":{"colors":[4],"directions":[4,2]},"params":{"colors":[0,4,5,7],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Each connected gray-and-orange component transfers its gray-cell count into complete layers of its orange rectangle, starting at the outer boundary. Gray runs may wrap around corners. Original gray cells become yellow; orange rectangles without connected gray remain unchanged."}]