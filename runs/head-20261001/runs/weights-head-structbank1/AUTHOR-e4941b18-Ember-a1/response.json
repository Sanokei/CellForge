[{"task_id":"e4941b18","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    block = int(round(params['colors'][1]))","    red = int(round(params['colors'][2]))","    blue = int(round(params['colors'][3]))","    step = int(round(params['step'][0]))","    out = grid.copy()","    blocks = np.argwhere(grid == block)","    reds = np.argwhere(grid == red)","    blues = np.argwhere(grid == blue)","    if len(blocks) == 0 or len(reds) != 1 or len(blues) != 1:","        return out","    rr, rc = reds[0]","    br, bc = blues[0]","    bottom = int(np.max(blocks[:, 0]))","    if bc > rc:","        side = int(np.max(blocks[:, 1])) + step","    else:","        side = int(np.min(blocks[:, 1])) - step","    if side < 0 or side >= grid.shape[1]:","        return out","    out[rr, rc] = background","    out[br, bc] = red","    out[bottom, side] = blue","    return out"],"shapes":{"colors":[4],"step":[1]},"params":{"colors":[7,5,2,8],"step":[1]},"rationale":"Red moves to blue's original position. Blue moves beside the bottom of the gray rectangle, on the right if originally right of red, otherwise on the left. Tensor values specify all colors and the exterior offset."}]