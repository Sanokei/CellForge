[{"task_id":"6ffe8f07","source_lines":["def run(params, grid, demos):","    anchor = int(round(params['colors'][0]))","    blocker = int(round(params['colors'][1]))","    paint = int(round(params['colors'][2]))","    directions = params['directions']","    out = grid.copy()","    height, width = grid.shape","    for point in np.argwhere(grid == anchor):","        for direction in directions:","            dr = int(round(direction[0]))","            dc = int(round(direction[1]))","            if dr == 0 and dc == 0:","                continue","            row = int(point[0]) + dr","            col = int(point[1]) + dc","            while 0 <= row < height and 0 <= col < width:","                if grid[row, col] == blocker:","                    break","                if grid[row, col] != anchor:","                    out[row, col] = paint","                row += dr","                col += dc","    return out"],"shapes":{"colors":[3],"directions":[4,2]},"params":{"colors":[8,1,4],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Extend yellow rays in all four cardinal directions from every cyan cell. Rays overwrite background and red cells, stop at blue cells, and preserve cyan cells. Each ray stops independently, so blue obstacles cast shadows."}]