[{"task_id":"3194b014","source_lines":["def run(params, grid, demos):","    palette = int(round(params['palette'][0]))","    noise_colors = int(round(params['noise_colors'][0]))","    side = int(round(params['output_side'][0]))","    counts = []","    for color in range(palette):","        counts.append((int(np.count_nonzero(grid == color)), color))","    counts.sort(reverse=True)","    candidates = counts[noise_colors:]","    if not candidates or side <= 0:","        return np.zeros((0, 0), dtype=int)","    color = candidates[0][1]","    return np.full((side, side), color, dtype=int)"],"shapes":{"palette":[1],"noise_colors":[1],"output_side":[1]},"params":{"palette":[10],"noise_colors":[3],"output_side":[3]},"rationale":"The three most frequent colors form the scattered background. Among the remaining colors, select the largest colored object by its cell count and return its color in a solid 3×3 grid. This selects 3, 4, and 8 in the demonstrations and 5 in the test."}]