[{"task_id":"20981f0e","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    ink = int(round(params['colors'][1]))","    marker = int(round(params['colors'][2]))","    dr = int(round(params['placement'][0]))","    dc = int(round(params['placement'][1]))","    margin = int(round(params['placement'][2]))","    out = grid.copy()","    points = np.argwhere(grid == marker)","    if len(points) == 0:","        return out","    rows = sorted(set(int(p[0]) for p in points))","    cols = sorted(set(int(p[1]) for p in points))","    out[grid == ink] = bg","    for ri in range(len(rows) - 1):","        top = rows[ri]","        bottom = rows[ri + 1]","        for ci in range(len(cols)):","            left = cols[ci]","            right = cols[ci + 1] if ci + 1 < len(cols) else grid.shape[1]","            rstart = top + margin","            cstart = left + margin","            patch = grid[rstart:bottom, cstart:right]","            cells = np.argwhere(patch == ink)","            if len(cells) == 0:","                continue","            rmin = int(np.min(cells[:, 0]))","            cmin = int(np.min(cells[:, 1]))","            for p in cells:","                r = top + dr + int(p[0]) - rmin","                c = left + dc + int(p[1]) - cmin","                if 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:","                    out[r, c] = ink","    return out"],"shapes":{"colors":[3],"placement":[3]},"params":{"colors":[0,1,2],"placement":[2,2,1]},"rationale":"Red markers define a lattice of cells. Translate each cell's blue shape, preserving its orientation, so its bounding box begins two rows below and two columns right of the cell's upper-left red marker. Preserve the markers and background."}]