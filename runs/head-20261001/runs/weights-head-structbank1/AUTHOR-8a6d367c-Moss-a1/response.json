[{"task_id":"8a6d367c","source_lines":["def run(params, grid, demos):","    bg = int(round(params['config'][0]))","    step = int(round(params['config'][1]))","    minimum = int(round(params['config'][2]))","    if step <= 0 or minimum <= step:","        return grid.copy()","    frame = None","    for color in np.unique(grid):","        if color == bg:","            continue","        points = np.argwhere(grid == color)","        top = int(np.min(points[:, 0]))","        bottom = int(np.max(points[:, 0]))","        left = int(np.min(points[:, 1]))","        right = int(np.max(points[:, 1]))","        if bottom - top + step < minimum or right - left + step < minimum:","            continue","        if np.all(grid[top, left:right + step] == color) and np.all(grid[bottom, left:right + step] == color) and np.all(grid[top:bottom + step, left] == color) and np.all(grid[top:bottom + step, right] == color):","            frame = (top, bottom, left, right)","            break","    if frame is None:","        return grid.copy()","    top, bottom, left, right = frame","    result = grid[top:bottom + step, left:right + step].copy()","    inside = result[step:-step, step:-step]","    paints = [int(c) for c in np.unique(inside) if c != bg]","    if len(paints) != step:","        return result","    paint = paints[0]","    examples = grid[:top, :]","    for color in np.unique(examples):","        if color == bg:","            continue","        points = np.argwhere(examples == color)","        r0 = int(np.min(points[:, 0]))","        r1 = int(np.max(points[:, 0])) + step","        c0 = int(np.min(points[:, 1]))","        c1 = int(np.max(points[:, 1])) + step","        mask = examples[r0:r1, c0:c1] == color","        height, width = mask.shape","        ih, iw = inside.shape","        if ih % height != 0 or iw % width != 0:","            continue","        sy = ih // height","        sx = iw // width","        if sy != sx or sy < step:","            continue","        expanded = np.kron(mask, np.ones((sy, sx), dtype=int))","        if np.all(np.logical_or(inside != paint, expanded != 0)):","            result[step:-step, step:-step] = np.where(expanded != 0, paint, bg)","            return result","    return result"],"shapes":{"config":[3]},"params":{"config":[8,1,5]},"rationale":"Find the large rectangular frame and select the small colored pattern whose uniformly enlarged mask contains every supplied interior paint cell. Complete that pattern using the interior paint color and crop to the frame. The background, border thickness, and minimum frame extent are tensor controlled."}]