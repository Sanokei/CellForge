[{"task_id":"13f06aa5","source_lines":["def run(params, grid, demos):","    zero = int(round(params['rule'][0]))","    one = int(round(params['rule'][1]))","    spacing = int(round(params['rule'][2]))","    intersection = int(round(params['rule'][3]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    colors, counts = np.unique(grid, return_counts=True)","    background = int(colors[np.argmax(counts)])","    remaining = np.where(colors == background, zero, counts)","    body = int(colors[np.argmax(remaining)])","    height, width = grid.shape","    result = grid.copy()","    borders = []","    markers = np.argwhere(np.logical_and(grid != background, grid != body))","    for position in markers:","        row, col = int(position[0]), int(position[1])","        color = int(grid[row, col])","        chosen = None","        for dr, dc in directions:","            nr, nc = row + dr, col + dc","            if zero <= nr < height and zero <= nc < width:","                if grid[nr, nc] == background:","                    chosen = (dr, dc)","        if chosen is None:","            continue","        dr, dc = chosen","        for distance in range(one, max(height, width) + one):","            nr = row + dr * spacing * distance","            nc = col + dc * spacing * distance","            if zero <= nr < height and zero <= nc < width:","                result[nr, nc] = color","        if dr < zero:","            borders.append((zero, zero, color))","        elif dr > zero:","            borders.append((zero, height - one, color))","        elif dc < zero:","            borders.append((one, zero, color))","        elif dc > zero:","            borders.append((one, width - one, color))","    painted = np.zeros(grid.shape, dtype=int)","    for axis, edge, color in borders:","        if axis == zero:","            for col in range(width):","                if painted[edge, col] != zero and result[edge, col] != color:","                    result[edge, col] = intersection","                else:","                    result[edge, col] = color","                painted[edge, col] = one","        else:","            for row in range(height):","                if painted[row, edge] != zero and result[row, edge] != color:","                    result[row, edge] = intersection","                else:","                    result[row, edge] = color","                painted[row, edge] = one","    return result"],"shapes":{"rule":[4],"directions":[4,2]},"params":{"rule":[0,1,2,0],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Each colored marker fires outward through the open side of its surrounding body, painting every second cell and the entire destination edge. Differently colored edges intersect in black. Background and body colors are inferred by frequency; tensors encode directions, spacing, and intersection color."}]