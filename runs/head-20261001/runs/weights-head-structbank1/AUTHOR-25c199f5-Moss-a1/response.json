[{"task_id":"25c199f5","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    sep = int(round(params['rule'][1]))","    step = int(round(params['rule'][2]))","    bottom = int(round(params['rule'][3]))","    if step == 0:","        return grid.copy()","    h, w = grid.shape","    cuts = []","    for c in range(w):","        if np.all(grid[:, c] == sep):","            cuts.append(c)","    if len(cuts) == 0:","        return grid.copy()","    panels = []","    start = 0","    for end in cuts + [w]:","        if end > start:","            panels.append(grid[:, start:end])","        start = end + 1","    pieces = []","    for panel in panels[::step]:","        rows = np.nonzero(np.any(panel != bg, axis=1))[0]","        if len(rows) > 0:","            pieces.append(panel[int(rows[0]):int(rows[-1]) + 1, :])","    if len(pieces) == 0:","        return np.full(panels[0].shape, bg, dtype=int)","    width = pieces[0].shape[1]","    for piece in pieces:","        if piece.shape[1] != width:","            return grid.copy()","    content = np.concatenate(pieces, axis=0)","    remaining = h - content.shape[0]","    if remaining < 0:","        return grid.copy()","    blank = np.full((remaining, width), bg, dtype=int)","    if bottom > 0:","        return np.concatenate([blank, content], axis=0)","    return np.concatenate([content, blank], axis=0)"],"shapes":{"rule":[4]},"params":{"rule":[7,6,-1,1]},"rationale":"Split at solid magenta columns, trim empty rows from each panel, then stack the objects in right-to-left panel order while preserving their horizontal positions. Align the combined stack to the bottom of the original height."}]