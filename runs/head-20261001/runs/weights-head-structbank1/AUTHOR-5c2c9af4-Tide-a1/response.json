[{"task_id":"5c2c9af4","source_lines":["def run(params, grid, demos):","    background = int(round(params['geometry'][0]))","    divisor = int(round(params['geometry'][1]))","    scale = int(round(params['geometry'][2]))","    phase = int(round(params['geometry'][3]))","    points = np.argwhere(grid != background)","    if divisor <= 0 or len(points) < divisor:","        return grid.copy()","    center = points[len(points) // divisor]","    spacing = abs(int(points[1, 0]) - int(points[0, 0])) * scale","    if spacing <= 0:","        return grid.copy()","    color = int(grid[int(center[0]), int(center[1])])","    rows = np.arange(grid.shape[0]).reshape(-1, 1)","    cols = np.arange(grid.shape[1]).reshape(1, -1)","    distance = np.maximum(np.abs(rows - center[0]), np.abs(cols - center[1]))","    return np.where(distance % spacing == phase, color, background).astype(int)"],"shapes":{"geometry":[4]},"params":{"geometry":[0,2,1,0]},"rationale":"The middle diagonal marker is the center. The marker spacing determines the interval between concentric square outlines, which extend outward and are clipped by the grid. The tensors encode background, middle-marker selection, spacing scale, and outline phase."}]