[{"task_id":"22806e14","source_lines":["def run(params, grid, demos):","    background = int(round(params['settings'][0]))","    divisor = int(round(params['settings'][1]))","    remainder = int(round(params['settings'][2]))","    retained_marker = int(round(params['settings'][3]))","    directions = params['directions']","    out = grid.copy()","    colors = [int(c) for c in np.unique(grid) if int(c) != background]","    if len(colors) != 2 or divisor <= 0:","        return out","    counts = [int(np.count_nonzero(grid == c)) for c in colors]","    object_color = colors[int(np.argmax(np.array(counts)))]","    marker_color = colors[1 - int(np.argmax(np.array(counts)))]","    if marker_color != retained_marker:","        out[grid == marker_color] = background","    height, width = grid.shape","    visited = set()","    for point in np.argwhere(grid == object_color):","        start = (int(point[0]), int(point[1]))","        if start in visited:","            continue","        visited.add(start)","        pending = [start]","        component = []","        while pending:","            row, col = pending.pop()","            component.append((row, col))","            for direction in directions:","                nr = row + int(round(direction[0]))","                nc = col + int(round(direction[1]))","                neighbor = (nr, nc)","                if 0 <= nr < height and 0 <= nc < width and neighbor not in visited and grid[nr, nc] == object_color:","                    visited.add(neighbor)","                    pending.append(neighbor)","        rows = [p[0] for p in component]","        cols = [p[1] for p in component]","        top, bottom = min(rows), max(rows)","        left, right = min(cols), max(cols)","        side = bottom - top + remainder","        span = right - left + remainder","        if side == span and len(component) == side * span and side % divisor == remainder:","            out[(top + bottom) // divisor, (left + right) // divisor] = marker_color","    return out"],"shapes":{"settings":[4],"directions":[4,2]},"params":{"settings":[7,2,1,3],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Recolor the center of every filled odd-sided square with the cross's color. Remove the source cross, with the demonstrated color-3 retention exception encoded explicitly. Background, parity, center calculation, retention color, and connectivity are tensor-controlled."}]