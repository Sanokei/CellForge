[{"task_id":"4290ef0e","source_lines":["def run(params, grid, demos):","    z = int(round(params['geometry'][0]))","    u = int(round(params['geometry'][1]))","    two = int(round(params['geometry'][2]))","    limit = int(round(params['geometry'][3]))","    signs = [int(round(v)) for v in params['directions']]","    if u <= z or two <= u or limit < u:","        return grid.copy()","    h, w = grid.shape","    colors, counts = np.unique(grid, return_counts=True)","    bg = int(colors[np.argmax(counts)])","    rings = []","    for color in colors:","        color = int(color)","        if color == bg:","            continue","        points = np.argwhere(grid == color).tolist()","        if len(points) == u:","            rings.append((z, u, color))","            continue","        found = False","        for radius in range(u, limit + u, u):","            if found:","                break","            for arm in range(u, radius + two * u, u):","                if found:","                    break","                corners = []","                offsets = set()","                for sy in signs:","                    for sx in signs:","                        corner = set()","                        for k in range(z, arm, u):","                            corner.add((sy * radius, sx * (radius - k)))","                            corner.add((sy * (radius - k), sx * radius))","                        corners.append(corner)","                        offsets.update(corner)","                for dy, dx in offsets:","                    cy = points[z][z] - dy","                    cx = points[z][u] - dx","                    good = True","                    for y, x in points:","                        if (y - cy, x - cx) not in offsets:","                            good = False","                            break","                    if not good:","                        continue","                    for corner in corners:","                        active = False","                        for oy, ox in corner:","                            y, x = cy + oy, cx + ox","                            if z <= y < h and z <= x < w and grid[y, x] == color:","                                active = True","                                break","                        if active:","                            for oy, ox in corner:","                                y, x = cy + oy, cx + ox","                                if z <= y < h and z <= x < w and grid[y, x] != color:","                                    good = False","                                    break","                        if not good:","                            break","                    if good:","                        rings.append((radius, arm, color))","                        found = True","                        break","        if not found:","            return grid.copy()","    if not rings:","        return grid.copy()","    outer = max(item[z] for item in rings)","    size = two * outer + u","    if size < u or size > two * limit + u:","        return grid.copy()","    result = np.full((size, size), bg, dtype=int)","    for radius, arm, color in rings:","        if radius == z:","            result[outer, outer] = color","        else:","            for sy in signs:","                for sx in signs:","                    for k in range(z, arm, u):","                        result[outer + sy * radius, outer + sx * (radius - k)] = color","                        result[outer + sy * (radius - k), outer + sx * radius] = color","    return result"],"shapes":{"geometry":[4],"directions":[2]},"params":{"geometry":[0,1,2,14],"directions":[-1,1]},"rationale":"Each non-background color supplies fragments of a square ring formed by four equal corner arms. Fit the smallest symmetric ring consistent with its visible fragments, allowing whole corners to be absent and arms to be clipped by input boundaries. Assemble all recovered rings concentrically, preserving isolated center pixels. This also recovers the test's clipped yellow radius-five ring and magenta radius-three ring."}]