[{"task_id":"05269061","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    period = int(round(params['rule'][1]))","    row_step = int(round(params['rule'][2]))","    col_step = int(round(params['rule'][3]))","    if period <= 0:","        return grid.copy()","    colors = {}","    height, width = grid.shape","    for row in range(height):","        for col in range(width):","            color = int(grid[row, col])","            if color != background:","                residue = (row_step * row + col_step * col) % period","                if residue in colors and colors[residue] != color:","                    return grid.copy()","                colors[residue] = color","    if len(colors) != period:","        return grid.copy()","    output = grid.copy()","    for row in range(height):","        for col in range(width):","            residue = (row_step * row + col_step * col) % period","            output[row, col] = colors[residue]","    return output"],"shapes":{"rule":[4]},"params":{"rule":[0,3,1,1]},"rationale":"Extend the observed colors across diagonals using (row + column) modulo three. The tensor specifies the background, period, and coordinate steps; the input determines each residue's color."}]