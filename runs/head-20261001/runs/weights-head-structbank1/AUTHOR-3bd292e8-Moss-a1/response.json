[{"task_id":"3bd292e8","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    wall = int(round(params['colors'][1]))","    first = int(round(params['colors'][2]))","    second = int(round(params['colors'][3]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    h, w = grid.shape","    labels = np.full((h, w), -1, dtype=int)","    regions = []","    for r in range(h):","        for c in range(w):","            if grid[r, c] != bg or labels[r, c] != -1:","                continue","            label = len(regions)","            cells = [(r, c)]","            labels[r, c] = label","            pos = 0","            while pos < len(cells):","                y, x = cells[pos]","                pos += 1","                for dy, dx in directions:","                    yy, xx = y + dy, x + dx","                    if 0 <= yy < h and 0 <= xx < w:","                        if grid[yy, xx] == bg and labels[yy, xx] == -1:","                            labels[yy, xx] = label","                            cells.append((yy, xx))","            regions.append(cells)","    edges = [set() for cells in regions]","    for label in range(len(regions)):","        for y, x in regions[label]:","            for dy, dx in directions:","                if dy == 0 and dx == 0:","                    continue","                yy, xx = y + dy, x + dx","                crossed = False","                while 0 <= yy < h and 0 <= xx < w and grid[yy, xx] == wall:","                    crossed = True","                    yy += dy","                    xx += dx","                if crossed and 0 <= yy < h and 0 <= xx < w:","                    other = int(labels[yy, xx])","                    if other >= 0 and other != label:","                        edges[label].add(other)","                        edges[other].add(label)","    out = grid.copy()","    if len(regions) == 0:","        return out","    ay = int(round(params['anchor'][0])) % h","    ax = int(round(params['anchor'][1])) % w","    seed = int(labels[ay, ax])","    if seed < 0:","        return out","    assigned = {seed: first}","    queue = [seed]","    pos = 0","    while pos < len(queue):","        label = queue[pos]","        pos += 1","        color = second if assigned[label] == first else first","        for other in edges[label]:","            if other not in assigned:","                assigned[other] = color","                queue.append(other)","    for label in assigned:","        for y, x in regions[label]:","            out[y, x] = assigned[label]","    return out"],"shapes":{"colors":[4],"directions":[4,2],"anchor":[2]},"params":{"colors":[7,2,5,3],"directions":[[-1,0],[1,0],[0,-1],[0,1]],"anchor":[-1,0]},"rationale":"The red paths partition the background into regions. Color the bottom-left region gray (5), then alternate gray and green (3) across each red boundary. Preserve the red paths."}]