[{"task_id":"2a28add5","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    anchor = int(round(params['colors'][1]))","    paint = int(round(params['colors'][2]))","    result = np.full(grid.shape, background, dtype=int)","    for r in range(grid.shape[0]):","        columns = np.argwhere(grid[r] != background).flatten().tolist()","        for index, column in enumerate(columns):","            if grid[r, column] == anchor:","                start = column - index","                for offset in range(len(columns)):","                    target = start + offset","                    if 0 <= target < grid.shape[1]:","                        result[r, target] = paint","                break","    return result"],"shapes":{"colors":[3]},"params":{"colors":[7,6,8]},"rationale":"For each row containing 6, compact all non-background cells into a contiguous horizontal segment while preserving their order and keeping the 6 at its original column. Paint the segment 8. Rows without 6 become background 7."}]