[{"task_id":"6d1d5c90","source_lines":["def run(params, grid, demos):","    marker = int(round(params['rule'][0]))","    column = int(round(params['rule'][1]))","    trim = int(round(params['rule'][2]))","    direction = int(round(params['rule'][3]))","    axis = int(round(params['rule'][4]))","    if column < 0 or column >= grid.shape[1]:","        return grid.copy()","    if trim <= 0 or trim >= grid.shape[1]:","        return grid.copy()","    if axis < 0 or axis >= len(grid.shape):","        return grid.copy()","    positions = np.argwhere(grid[:, column] == marker)","    if len(positions) != 1:","        return grid.copy()","    shift = direction * int(positions[0, 0])","    return np.roll(grid[:, trim:], shift, axis=axis)"],"shapes":{"rule":[5]},"params":{"rule":[2,0,1,1,0]},"rationale":"Remove the left control column and cyclically shift the remaining rows downward by the row index of its colour-2 marker. This reproduces all three demonstrations; the test shifts downward by one row."}]