[{"task_id":"c9680e90","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    divider = int(round(params['colors'][1]))","    mover = int(round(params['colors'][2]))","    track = int(round(params['colors'][3]))","    mirror = int(round(params['colors'][4]))","    factor = int(round(params['reflection'][0]))","    h, w = grid.shape","    out = grid.copy()","    rows = [r for r in range(h) if np.all(grid[r] == divider)]","    if not rows:","        return np.full(grid.shape, bg % 10, dtype=int)","    axis = rows[0]","    out[np.logical_or(np.logical_or(grid == mover, grid == track), grid == mirror)] = bg","    for position in np.argwhere(grid == mover):","        r, c = int(position[0]), int(position[1])","        end_r, end_c = r, c","        for direction in params['directions']:","            dr = int(round(direction[0]))","            dc = int(round(direction[1]))","            nr, nc = r + dr, c + dc","            if (dr != 0 or dc != 0) and 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == track:","                end_r, end_c = nr, nc","                for step in range(h + w):","                    nr, nc = end_r + dr, end_c + dc","                    if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == track:","                        end_r, end_c = nr, nc","                    else:","                        break","                break","        out[end_r, end_c] = mover","        reflected_r = factor * axis - end_r","        if 0 <= reflected_r < h:","            out[reflected_r, end_c] = mirror","    return out"],"shapes":{"colors":[5],"directions":[4,2],"reflection":[1]},"params":{"colors":[7,9,2,6,5],"directions":[[-1,0],[1,0],[0,-1],[0,1]],"reflection":[2]},"rationale":"Move each red cell to the far end of its contiguous green track, erase the tracks, and place its gray counterpart at the reflection across the horizontal divider."}]