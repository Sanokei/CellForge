[{"task_id":"fe45cba4","source_lines":["def run(params, grid, demos):","    bg = int(round(params['background'][0]))","    unit = int(round(params['geometry'][0]))","    axis = int(round(params['geometry'][1]))","    direction = int(round(params['geometry'][2]))","    out = grid.copy()","    if unit != 1 or axis != 1 or direction != 1:","        return out","    if not np.any(grid == bg):","        return out","    moves = []","    for pair in params['neighbors']:","        moves.append((int(round(pair[0])), int(round(pair[1]))))","    h, w = grid.shape","    for color in np.unique(grid):","        if color == bg:","            continue","        remaining = set()","        for p in np.argwhere(grid == color):","            remaining.add((int(p[0]), int(p[1])))","        components = []","        while remaining:","            seed = remaining.pop()","            component = [seed]","            pending = [seed]","            while pending:","                r, c = pending.pop()","                for dr, dc in moves:","                    neighbor = (r + dr, c + dc)","                    if neighbor in remaining:","                        remaining.remove(neighbor)","                        pending.append(neighbor)","                        component.append(neighbor)","            components.append(component)","        if len(components) <= unit:","            continue","        target = max(components, key=lambda component: max(p[axis] for p in component))","        top = min(p[0] for p in target)","        bottom = max(p[0] for p in target)","        right = max(p[axis] for p in target)","        height = bottom - top + unit","        total = sum(len(component) for component in components)","        if total % height != 0:","            continue","        width = total // height","        left = right - direction * (width - unit)","        if left < 0 or right >= w:","            continue","        out[grid == color] = bg","        out[top:bottom + unit, left:right + unit] = color","    return out"],"shapes":{"background":[1],"geometry":[3],"neighbors":[4,2]},"params":{"background":[7],"geometry":[1,1,1],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Disconnected objects of the same color combine into a solid rectangle anchored at the rightmost object's right edge and vertical span, conserving their total area. Singleton objects remain unchanged. The test combines the two azure objects into a 5-by-7 rectangle at rows 8–12 and columns 9–15."}]