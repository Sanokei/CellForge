[{"task_id":"1190e5a7","source_lines":["def run(params, grid, demos):","    row_axis = int(round(params['rule'][0])) % len(grid.shape)","    col_axis = int(round(params['rule'][1])) % len(grid.shape)","    increment = int(round(params['rule'][2]))","    background_direction = float(params['rule'][3])","    colors = np.unique(grid)","    scores = []","    for color in colors:","        rows = np.all(grid == color, axis=row_axis)","        cols = np.all(grid == color, axis=col_axis)","        scores.append(int(np.sum(rows)) + int(np.sum(cols)))","    scores = np.array(scores)","    separator = colors[int(np.argmax(scores))]","    background = colors[int(np.argmax(scores * background_direction))]","    height = int(np.sum(np.all(grid == separator, axis=row_axis))) + increment","    width = int(np.sum(np.all(grid == separator, axis=col_axis))) + increment","    return np.full((height, width), int(background), dtype=int)"],"shapes":{"rule":[4]},"params":{"rule":[1,0,1,-1]},"rationale":"Compress the partitioned grid to one background-colored cell per rectangular region. Output height and width equal the horizontal and vertical separator counts plus one. The tensors encode the reduction axes, region-count increment, and background selection direction."}]