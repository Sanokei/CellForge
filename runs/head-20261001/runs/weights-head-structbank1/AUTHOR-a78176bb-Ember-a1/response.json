[{"task_id":"a78176bb","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    marker = int(round(params['rule'][1]))","    slope = int(round(params['rule'][2]))","    gap = int(round(params['rule'][3]))","    positive = int(round(params['rule'][4]))","    negative = int(round(params['rule'][5]))","    neighbors = []","    for pair in params['neighbors']:","        neighbors.append((int(round(pair[0])), int(round(pair[1]))))","    out = grid.copy()","    out[grid == marker] = bg","    colored = np.argwhere((grid != bg) & (grid != marker))","    if len(colored) == 0:","        return out","    row, col = colored[0]","    color = int(grid[row, col])","    baseline = int(col - slope * row)","    remaining = set()","    for row, col in np.argwhere(grid == marker):","        remaining.add((int(row), int(col)))","    height, width = grid.shape","    while remaining:","        seed = remaining.pop()","        pending = [seed]","        component = [seed]","        while pending:","            row, col = pending.pop()","            for dr, dc in neighbors:","                point = (row + dr, col + dc)","                if point in remaining:","                    remaining.remove(point)","                    pending.append(point)","                    component.append(point)","        cols = [point[1] for point in component]","        leg = max(cols) - min(cols) + positive","        side = positive if seed[1] - slope * seed[0] > baseline else negative","        offset = baseline + side * (leg + gap)","        for row in range(height):","            col = slope * row + offset","            if 0 <= col < width:","                out[row, col] = color","    return out"],"shapes":{"rule":[6],"neighbors":[4,2]},"params":{"rule":[0,5,1,2,1,-1],"neighbors":[[1,0],[-1,0],[0,1],[0,-1]]},"rationale":"Erase each gray triangular component and draw a full parallel diagonal on its side of the original colored diagonal, displaced by its horizontal leg length plus two cells. Preserve the original colored diagonal."}]