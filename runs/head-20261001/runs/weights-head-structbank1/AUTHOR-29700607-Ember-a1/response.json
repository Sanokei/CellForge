[{"task_id":"29700607","source_lines":["def run(params, grid, demos):","    bg = int(round(params['background'][0]))","    top = int(round(params['geometry'][0]))","    step = int(round(params['geometry'][1]))","    end = int(round(params['geometry'][2]))","    left = int(round(params['geometry'][3]))","    h, w = grid.shape","    out = grid.copy()","    if step <= 0 or top < 0 or top >= h or left < 0 or left >= w:","        return out","    right = w + end","    if right < 0 or right >= w:","        return out","    for c in range(w):","        color = int(grid[top, c])","        if color == bg:","            continue","        stop = h - step","        target = c","        found = False","        for r in range(top + step, h, step):","            for side in (left, right):","                if int(grid[r, side]) == color:","                    stop = r","                    target = side","                    found = True","                    break","            if found:","                break","        for r in range(top, stop + step, step):","            if r < h:","                out[r, c] = color","        if found:","            for j in range(min(c, target), max(c, target) + step, step):","                if j < w:","                    out[stop, j] = color","    return out"],"shapes":{"background":[1],"geometry":[4]},"params":{"background":[0],"geometry":[0,1,-1,0]},"rationale":"Extend each top-row color downward until its matching side marker, then connect horizontally to that marker. Colors without a side marker extend to the bottom. The tensors specify background, starting row, traversal step, right-edge offset, and left-edge column."}]