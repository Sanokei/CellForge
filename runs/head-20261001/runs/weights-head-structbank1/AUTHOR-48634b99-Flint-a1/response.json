[{"task_id":"48634b99","source_lines":["def run(params, grid, demos):","    blue = int(round(params['rule'][0]))","    red = int(round(params['rule'][1]))","    dr = int(round(params['rule'][2]))","    dc = int(round(params['rule'][3]))","    length_gain = int(round(params['rule'][4]))","    mark_gain = int(round(params['rule'][5]))","    out = grid.copy()","    h, w = grid.shape","    if dr == 0 and dc == 0:","        return out","    rods = []","    source = None","    for r in range(h):","        for c in range(w):","            if grid[r, c] != blue and grid[r, c] != red:","                continue","            pr, pc = r - dr, c - dc","            if 0 <= pr < h and 0 <= pc < w:","                if grid[pr, pc] == blue or grid[pr, pc] == red:","                    continue","            cells = []","            rr, cc = r, c","            marked = 0","            while 0 <= rr < h and 0 <= cc < w:","                if grid[rr, cc] != blue and grid[rr, cc] != red:","                    break","                cells.append((rr, cc))","                if grid[rr, cc] == red:","                    marked += 1","                rr += dr","                cc += dc","            rods.append(cells)","            if marked > 0:","                source = (cells, marked, grid[r, c] == red)","    if source is None:","        return out","    cells, marked, from_start = source","    for r, c in cells:","        out[r, c] = blue","    for target in rods:","        if len(target) == len(cells) + length_gain:","            count = marked + mark_gain","            if count < 0 or count > len(target):","                continue","            chosen = target[:count] if from_start else target[len(target) - count:]","            for r, c in chosen:","                out[r, c] = red","    return out"],"shapes":{"rule":[6]},"params":{"rule":[8,9,1,0,2,1]},"rationale":"Move the red marking to the vertical rod two cells longer, increasing the marked length by one and preserving whether the marking touches the top or bottom. Restore the original rod to blue."}]