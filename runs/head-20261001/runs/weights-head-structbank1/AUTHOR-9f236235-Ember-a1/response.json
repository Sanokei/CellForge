[{"task_id":"9f236235","source_lines":["def run(params, grid, demos):","    gap = int(round(params['geometry'][0]))","    reverse = int(round(params['geometry'][1]))","    height, width = grid.shape","    block_height = height","    block_width = width","    for r in range(height):","        if grid[r, 0] != grid[0, 0]:","            block_height = r","            break","    for c in range(width):","        if grid[0, c] != grid[0, 0]:","            block_width = c","            break","    row_step = block_height + gap","    col_step = block_width + gap","    if row_step <= 0 or col_step <= 0:","        return grid.copy()","    result = grid[::row_step, ::col_step].copy()","    if reverse != 0:","        result = np.fliplr(result)","    return result"],"shapes":{"geometry":[2]},"params":{"geometry":[1,1]},"rationale":"Compress each solid rectangular cell to its representative colour by sampling at the block dimensions plus the learned separator thickness, then reflect the compressed grid horizontally. The tensors encode the one-pixel separator and horizontal reflection."}]