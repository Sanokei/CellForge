[{"task_id":"b20f7c8b","source_lines":["def run(params, grid, demos):","    bg = int(round(params['config'][0]))","    panel = int(round(params['config'][1]))","    base = int(round(params['config'][2]))","    ink = int(round(params['config'][3]))","    size = int(round(params['config'][4]))","    inset = int(round(params['config'][5]))","    turns = int(round(params['config'][6]))","    out = grid.copy()","    if size <= 0 or inset <= 0 or turns <= 0 or bg == panel or base == ink:","        return grid * 0","    h, w = grid.shape","    panel_cols = np.any(grid == panel, axis=0)","    refs = {}","    for color in np.unique(grid[:, panel_cols]):","        color = int(color)","        if color == panel or color == bg:","            continue","        mask = (grid == color) & panel_cols","        pts = np.argwhere(mask)","        if len(pts) == 0:","            continue","        lo = np.min(pts, axis=0)","        hi = np.max(pts, axis=0)","        refs[color] = mask[lo[0]:hi[0]+1, lo[1]:hi[1]+1].copy()","    seen = set()","    for r in range(h):","        for c in range(w):","            if panel_cols[c] or grid[r,c] == bg or (r,c) in seen:","                continue","            cells = [(r,c)]","            seen.add((r,c))","            pos = 0","            while pos < len(cells):","                y, x = cells[pos]","                pos += 1","                for delta in params['neighbors']:","                    dy = int(round(delta[0]))","                    dx = int(round(delta[1]))","                    yy, xx = y + dy, x + dx","                    if 0 <= yy < h and 0 <= xx < w:","                        if not panel_cols[xx] and grid[yy,xx] != bg and (yy,xx) not in seen:","                            seen.add((yy,xx))","                            cells.append((yy,xx))","            coords = np.array(cells)","            lo = np.min(coords, axis=0)","            hi = np.max(coords, axis=0)","            if hi[0]-lo[0]+1 != size or hi[1]-lo[1]+1 != size:","                continue","            y, x = int(lo[0]), int(lo[1])","            block = grid[y:y+size, x:x+size]","            colors = np.unique(block)","            if len(colors) == 1:","                color = int(colors[0])","                if color in refs:","                    pattern = refs[color]","                    ph, pw = pattern.shape","                    if ph + inset <= size and pw + inset <= size:","                        out[y:y+size,x:x+size] = base","                        region = out[y+inset:y+inset+ph,x+inset:x+inset+pw]","                        region[pattern] = ink","            else:","                mask = block == ink","                pts = np.argwhere(mask)","                if len(pts) == 0:","                    continue","                ml = np.min(pts, axis=0)","                mh = np.max(pts, axis=0)","                pattern = mask[ml[0]:mh[0]+1,ml[1]:mh[1]+1]","                found = None","                for color in refs:","                    reference = refs[color]","                    for k in range(turns):","                        rotated = np.rot90(pattern,k)","                        if rotated.shape == reference.shape:","                            if np.all(rotated == reference) or np.all(np.fliplr(rotated) == reference):","                                found = color","                    if found is not None:","                        break","                if found is not None:","                    out[y:y+size,x:x+size] = found","    return out"],"shapes":{"config":[7],"neighbors":[4,2]},"params":{"config":[0,8,2,1,5,1,4],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"The cyan panel supplies colored shape keys. Match each blue shape in a red square to a key under rotations and reflections, then fill the square with that key's color. Conversely, replace a solid colored square with a red square containing its panel shape in blue, preserving the panel shape's orientation."}]