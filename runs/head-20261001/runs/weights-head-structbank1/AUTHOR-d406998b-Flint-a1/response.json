[{"task_id":"d406998b","source_lines":["def run(params, grid, demos):","    source = int(round(params['rule'][0]))","    target = int(round(params['rule'][1]))","    period = int(round(params['rule'][2]))","    edge = int(round(params['rule'][3]))","    residue = int(round(params['rule'][4]))","    out = grid.copy()","    if period <= 0:","        return out","    for c in range(grid.shape[1]):","        if (grid.shape[1] - edge - c) % period == residue:","            for r in range(grid.shape[0]):","                if grid[r, c] == source:","                    out[r, c] = target","    return out"],"shapes":{"rule":[5]},"params":{"rule":[5,3,2,1,0]},"rationale":"Recolor gray cells green in alternating columns, starting with the rightmost column and moving left. All four demonstrations follow this right-anchored alternation."}]