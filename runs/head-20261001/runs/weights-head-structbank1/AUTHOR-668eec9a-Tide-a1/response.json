[{"task_id":"668eec9a","source_lines":["def run(params, grid, demos):","    background = int(round(params['background'][0]))","    height = int(round(params['size'][0]))","    width = int(round(params['size'][1]))","    if height <= 0 or width <= 0 or height > grid.shape[0] or width > grid.shape[1]:","        return grid.copy()","    ordered = []","    for color in np.unique(grid):","        if color != background:","            positions = np.argwhere(grid == color)","            ordered.append((int(np.min(positions[:, 0])), int(color)))","    ordered.sort()","    if len(ordered) > height:","        return grid.copy()","    result = np.full((height, width), background)","    for index, item in enumerate(ordered):","        result[height - len(ordered) + index, :] = item[1]","    return result"],"shapes":{"background":[1],"size":[2]},"params":{"background":[7],"size":[5,3]},"rationale":"Order foreground colors by their first occupied row, then represent each as a uniform row in a 5-by-3 output, padding above with background. This reproduces all demonstrations and predicts test rows 7, 5, 1, 4, 3."}]