[{"task_id":"834ec97d","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    paint = int(round(params['rule'][1]))","    period = int(round(params['rule'][2]))","    phase = int(round(params['rule'][3]))","    displacement = int(round(params['rule'][4]))","    out = grid.copy()","    if period <= 0:","        return out","    points = np.argwhere(grid != background)","    for point in points:","        r = int(point[0])","        c = int(point[1])","        color = int(grid[r, c])","        rows = np.arange(grid.shape[0])","        cols = np.arange(grid.shape[1])","        mask = (rows[:, None] <= r) & (((cols[None, :] - c) % period) == phase)","        out = np.where(mask, paint, out)","        destination = r + displacement","        if 0 <= destination < grid.shape[0]:","            out[destination, c] = color","    return out"],"shapes":{"rule":[5]},"params":{"rule":[0,4,2,0,1]},"rationale":"Paint yellow vertical stripes in every other column, aligned with the marker column, from the top through the marker's original row. Move the marker one row downward."}]