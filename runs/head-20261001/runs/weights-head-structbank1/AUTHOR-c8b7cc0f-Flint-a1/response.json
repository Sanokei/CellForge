[{"task_id":"c8b7cc0f","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    frame = int(round(params['rule'][1]))","    size = max(1, min(grid.shape[0], int(round(params['rule'][2]))))","    inset = max(0, int(round(params['rule'][3])))","    axis = int(round(params['rule'][4]))","    result = np.full((size, size), background, dtype=int)","    border = np.argwhere(grid == frame)","    if len(border) == 0:","        return result","    top = int(np.min(border[:, 0])) + inset","    bottom = int(np.max(border[:, 0])) - inset","    left = int(np.min(border[:, 1])) + inset","    right = int(np.max(border[:, 1])) - inset","    interior = grid[top:bottom + 1, left:right + 1]","    colours = np.unique(grid)","    colour = background","    best = 0","    for value in colours:","        if value != background and value != frame:","            frequency = int(np.count_nonzero(grid == value))","            if frequency > best:","                best = frequency","                colour = int(value)","    count = int(np.count_nonzero(interior == colour))","    for position in range(min(count, size * size)):","        row = position // size","        column = position % size","        if axis == 0:","            result[row, column] = colour","        else:","            result[column, row] = colour","    return result"],"shapes":{"rule":[5]},"params":{"rule":[0,1,3,1,0]},"rationale":"Count the coloured cells strictly inside the blue rectangular frame, then place that many cells of their colour in a 3×3 output, filling rows from the upper left. The demonstrations contain 5, 3, and 4 interior cells; the test contains 4."}]