[{"task_id":"c9e6f938","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    foreground = int(round(params['rule'][1]))","    axis = int(round(params['rule'][2])) % len(grid.shape)","    cell = np.where(grid == foreground, foreground, background)","    return np.concatenate((cell, np.flip(cell, axis=axis)), axis=axis)"],"shapes":{"rule":[3]},"params":{"rule":[0,7,1]},"rationale":"Append a horizontal mirror of the input to its right. The tensor specifies background color, foreground color, and reflection/concatenation axis."}]