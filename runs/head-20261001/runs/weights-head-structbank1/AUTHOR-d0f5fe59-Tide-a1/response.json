[{"task_id":"d0f5fe59","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    foreground = int(round(params['colors'][1]))","    directions = []","    for pair in params['neighbors']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    height, width = grid.shape","    remaining = set()","    for row in range(height):","        for col in range(width):","            if grid[row, col] == foreground:","                remaining.add((row, col))","    count = 0","    while remaining:","        seed = remaining.pop()","        pending = [seed]","        count += 1","        while pending:","            row, col = pending.pop()","            for dr, dc in directions:","                neighbor = (row + dr, col + dc)","                if neighbor in remaining:","                    remaining.remove(neighbor)","                    pending.append(neighbor)","    size = max(1, min(30, count))","    result = np.full((size, size), background, dtype=int)","    slope = int(round(params['diagonal'][0]))","    offset = int(round(params['diagonal'][1]))","    for row in range(size):","        col = (slope * row + offset) % size","        result[row, col] = foreground","    return result"],"shapes":{"colors":[2],"neighbors":[4,2],"diagonal":[2]},"params":{"colors":[0,8],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]],"diagonal":[1,0]},"rationale":"Count orthogonally connected azure objects and return a square of that size with azure on the main diagonal. Demonstrations contain 3, 4, and 2 objects; the test contains 5. Colors, connectivity, and diagonal placement come from the tensors."}]