[{"task_id":"4a1cacc2","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    start = int(round(params['rule'][1]))","    step = int(round(params['rule'][2]))","    midpoint = float(params['rule'][3])","    height, width = grid.shape","    result = grid.copy()","    for position in np.argwhere(grid != background):","        row, col = int(position[0]), int(position[1])","        color = int(grid[row, col])","        if row < height * midpoint:","            row_start, row_end = start, row + step","        else:","            row_start, row_end = row, height","        if col < width * midpoint:","            col_start, col_end = start, col + step","        else:","            col_start, col_end = col, width","        result[row_start:row_end, col_start:col_end] = color","    return result"],"shapes":{"rule":[4]},"params":{"rule":[8,0,1,0.5]},"rationale":"Each colored seed fills the inclusive rectangle extending to the corner in its quadrant. The tensors encode background, boundary origin, inclusive endpoint offset, and quadrant midpoint."}]