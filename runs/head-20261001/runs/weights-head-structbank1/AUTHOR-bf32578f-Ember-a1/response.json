[{"task_id":"bf32578f","source_lines":["def run(params, grid, demos):","    background = int(round(params['geometry'][0]))","    inset = int(round(params['geometry'][1]))","    reflection = int(round(params['geometry'][2]))","    out = np.full(grid.shape, background, dtype=int)","    points = np.argwhere(grid != background)","    if len(points) == 0:","        return out","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0]))","    axis_column = int(np.max(points[:, 1]))","    for row in range(top + inset, bottom - inset + 1):","        columns = np.argwhere(grid[row] != background)","        if len(columns) == 0:","            continue","        boundary = int(np.max(columns))","        colour = int(grid[row, boundary])","        left = boundary + inset","        right = reflection * axis_column + inset - boundary","        for column in range(left, right):","            if column >= 0 and column < grid.shape[1]:","                out[row, column] = colour","    return out"],"shapes":{"geometry":[3]},"params":{"geometry":[0,1,2]},"rationale":"Reflect the given left outline across the vertical axis immediately beyond its rightmost column, then return only the filled interior, excluding the outline and its top and bottom rows. The tensors specify background, boundary inset, and reflection multiplier."}]