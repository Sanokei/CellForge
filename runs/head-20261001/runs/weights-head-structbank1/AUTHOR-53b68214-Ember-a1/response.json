[{"task_id":"53b68214","source_lines":["def run(params, grid, demos):","    height = int(round(params['rule'][0]))","    bg = int(round(params['rule'][1]))","    step = int(round(params['rule'][2]))","    repeats = int(round(params['rule'][3]))","    h, w = grid.shape","    if step <= 0 or repeats <= 0 or height <= h:","        return grid.copy()","    period = h","    shift = 0","    found = False","    for p in range(step, h // repeats + step, step):","        for magnitude in range(0, w, step):","            for displacement in [magnitude, -magnitude]:","                valid = True","                for r in range(p, h):","                    for c in range(w):","                        source = c - displacement","                        value = bg","                        if 0 <= source < w:","                            value = grid[r - p, source]","                        if grid[r, c] != value:","                            valid = False","                            break","                    if not valid:","                        break","                if valid:","                    period = p","                    shift = displacement","                    found = True","                    break","            if found:","                break","        if found:","            break","    out = np.full((height, w), bg, dtype=int)","    out[:h, :] = grid","    for r in range(h, height):","        for c in range(w):","            source = c - shift","            if 0 <= source < w:","                out[r, c] = out[r - period, source]","    return out"],"shapes":{"rule":[4]},"params":{"rule":[10,0,1,2]},"rationale":"Extend the grid to ten rows by finding the shortest repeating row block, allowing a constant horizontal translation between blocks. Continue that recurrence with clipping at the grid edges. This captures stationary stripes, alternating patterns, and the diagonally advancing staircase."}]