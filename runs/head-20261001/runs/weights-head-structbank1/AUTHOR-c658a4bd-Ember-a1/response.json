[{"task_id":"c658a4bd","source_lines":["def run(params, grid, demos):","    background = int(round(params['geometry'][0]))","    unit = int(round(params['geometry'][1]))","    divisor = int(round(params['geometry'][2]))","    if unit <= 0 or divisor <= 0:","        return grid.copy()","    squares = []","    largest = unit","    for value in np.unique(grid):","        color = int(value)","        if color != background:","            points = np.argwhere(grid == color)","            height = int(np.max(points[:, 0]) - np.min(points[:, 0])) + unit","            width = int(np.max(points[:, 1]) - np.min(points[:, 1])) + unit","            size = max(height, width)","            squares.append((size, color))","            largest = max(largest, size)","    if largest > grid.shape[0] + grid.shape[1]:","        return grid.copy()","    result = np.full((largest, largest), background, dtype=int)","    for row in range(largest):","        for col in range(largest):","            best = largest + unit","            for size, color in squares:","                offset = (largest - size) // divisor","                if size < best and row >= offset and row < offset + size and col >= offset and col < offset + size:","                    result[row, col] = color","                    best = size","    return result"],"shapes":{"geometry":[3]},"params":{"geometry":[0,1,2]},"rationale":"Recover each colored square's side length from its maximum bounding-box extent, including clipped or overlapping outlines. Center the squares within the largest square, with smaller squares covering larger ones. The tensors encode the background, inclusive extent increment, and centering divisor."}]