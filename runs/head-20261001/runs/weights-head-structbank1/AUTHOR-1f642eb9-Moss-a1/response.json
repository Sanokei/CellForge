[{"task_id":"1f642eb9","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    block = int(round(params['colors'][1]))","    out = grid.copy()","    height, width = grid.shape","    markers = np.argwhere((grid != background) & (grid != block))","    for point in markers:","        row, col = point","        for direction in params['directions']:","            dr = int(round(direction[0]))","            dc = int(round(direction[1]))","            for distance in range(1, max(height, width)):","                r = row + distance * dr","                c = col + distance * dc","                if r < 0 or r >= height or c < 0 or c >= width:","                    break","                if grid[r, c] == block:","                    out[r, c] = grid[row, col]","                    break","                if grid[r, c] != background:","                    break","    return out"],"shapes":{"colors":[2],"directions":[4,2]},"params":{"colors":[0,8],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Each colored marker projects along cardinal directions through background onto the first cell of the azure rectangle. Markers remain unchanged. The tensors specify background, rectangle color, and projection directions."}]