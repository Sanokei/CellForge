[{"task_id":"d282b262","source_lines":["def run(params, grid, demos):","    bg = int(round(params['motion'][0]))","    step = int(round(params['motion'][1]))","    neighbors = []","    for pair in params['neighbors']:","        neighbors.append((int(round(pair[0])), int(round(pair[1]))))","    h, w = grid.shape","    out = np.full((h, w), bg, dtype=int)","    if step <= 0:","        return out","    seen = set()","    objects = []","    for r in range(h):","        for c in range(w):","            if grid[r, c] == bg or (r, c) in seen:","                continue","            cells = []","            queue = [(r, c)]","            seen.add((r, c))","            while queue:","                rr, cc = queue.pop()","                cells.append((rr, cc, int(grid[rr, cc])))","                for dr, dc in neighbors:","                    nr, nc = rr + dr, cc + dc","                    if 0 <= nr < h and 0 <= nc < w:","                        if grid[nr, nc] != bg and (nr, nc) not in seen:","                            seen.add((nr, nc))","                            queue.append((nr, nc))","            edge = max(cell[1] for cell in cells)","            objects.append((edge, cells))","    while objects:","        best = 0","        for i in range(len(objects)):","            if objects[i][0] > objects[best][0]:","                best = i","        edge, cells = objects.pop(best)","        shift = 0","        while True:","            candidate = shift + step","            valid = True","            for r, c, color in cells:","                nc = c + candidate","                if nc >= w:","                    valid = False","                    break","                if out[r, nc] != bg:","                    valid = False","                    break","            if not valid:","                break","            shift = candidate","        for r, c, color in cells:","            out[r, c + shift] = color","    return out"],"shapes":{"motion":[2],"neighbors":[4,2]},"params":{"motion":[0,1],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Identify connected checkerboard objects and slide them right, processing the rightmost objects first. Preserve their rows and patterns, stopping at the boundary or another object. The tensors specify background, movement step, and connectivity."}]