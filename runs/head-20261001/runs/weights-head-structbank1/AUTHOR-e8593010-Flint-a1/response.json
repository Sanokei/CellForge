[{"task_id":"e8593010","source_lines":["def run(params, grid, demos):","    target = int(round(params['colors'][0]))","    single = int(round(params['colors'][1]))","    pair = int(round(params['colors'][2]))","    larger = int(round(params['colors'][3]))","    single_size = int(round(params['sizes'][0]))","    pair_size = int(round(params['sizes'][1]))","    steps = []","    for row in params['steps']:","        steps.append((int(round(row[0])), int(round(row[1]))))","    out = grid.copy()","    seen = set()","    height, width = grid.shape","    for r in range(height):","        for c in range(width):","            if grid[r, c] != target or (r, c) in seen:","                continue","            component = [(r, c)]","            seen.add((r, c))","            pending = [(r, c)]","            while pending:","                y, x = pending.pop()","                for dy, dx in steps:","                    ny, nx = y + dy, x + dx","                    if 0 <= ny < height and 0 <= nx < width:","                        if grid[ny, nx] == target and (ny, nx) not in seen:","                            seen.add((ny, nx))","                            component.append((ny, nx))","                            pending.append((ny, nx))","            color = larger","            if len(component) == single_size:","                color = single","            elif len(component) == pair_size:","                color = pair","            for y, x in component:","                out[y, x] = color","    return out"],"shapes":{"colors":[4],"sizes":[2],"steps":[4,2]},"params":{"colors":[0,3,2,1],"sizes":[1,2],"steps":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Recolor each orthogonally connected zero component by its size: singleton green, pair red, and three-cell component blue. Preserve all other cells. Colors, size thresholds, and connectivity offsets come from the tensors."}]