[{"task_id":"a48eeaf7","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    anchor = int(round(params['colors'][1]))","    moving = int(round(params['colors'][2]))","    margin = int(round(params['margin'][0]))","    fixed = np.argwhere(grid == anchor)","    if len(fixed) == 0:","        return grid.copy()","    lower = np.min(fixed, axis=0) - margin","    upper = np.max(fixed, axis=0) + margin","    points = np.argwhere(grid == moving)","    result = grid.copy()","    result[grid == moving] = background","    for point in points:","        destination = np.minimum(np.maximum(point, lower), upper)","        row = int(destination[0])","        col = int(destination[1])","        if 0 <= row < grid.shape[0] and 0 <= col < grid.shape[1]:","            result[row, col] = moving","    return result"],"shapes":{"colors":[3],"margin":[1]},"params":{"colors":[0,2,5],"margin":[1]},"rationale":"Keep the red block fixed and pull each gray cell toward it until it touches the block's surrounding one-cell border, including diagonal contact. Clamp each gray cell's coordinates to the expanded red bounding box."}]