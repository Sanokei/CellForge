[{"task_id":"5b692c0f","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    mark = int(round(params['rule'][1]))","    minimum = int(round(params['rule'][2]))","    factor = int(round(params['rule'][3]))","    out = grid.copy()","    if bg == mark or not np.any(grid == mark):","        return out","    height, width = grid.shape","    for color in np.unique(grid):","        if color == bg or color == mark:","            continue","        points = np.argwhere(grid == color)","        top = int(np.min(points[:, 0]))","        bottom = int(np.max(points[:, 0]))","        left = int(np.min(points[:, 1]))","        right = int(np.max(points[:, 1]))","        patch = grid[top:bottom + 1, left:right + 1]","        markers = patch == mark","        rows = np.sum(markers, axis=1)","        cols = np.sum(markers, axis=0)","        if max(int(np.max(rows)), int(np.max(cols))) < minimum:","            continue","        vertical = int(np.max(cols)) > int(np.max(rows))","        if vertical:","            axis = left + int(np.argmax(cols))","        else:","            axis = top + int(np.argmax(rows))","        direction = 0","        for r, c in np.argwhere(markers):","            coordinate = left + int(c) if vertical else top + int(r)","            direction += coordinate - axis","        if direction == 0:","            continue","        out[top:bottom + 1, left:right + 1] = bg","        for r in range(top, bottom + 1):","            for c in range(left, right + 1):","                coordinate = c if vertical else r","                if (coordinate - axis) * direction < 0:","                    continue","                value = grid[r, c]","                out[r, c] = value","                reflected = factor * axis - coordinate","                if vertical:","                    if 0 <= reflected < width:","                        out[r, reflected] = value","                else:","                    if 0 <= reflected < height:","                        out[reflected, c] = value","    return out"],"shapes":{"rule":[4]},"params":{"rule":[0,4,2,2]},"rationale":"For each colored object, the longest yellow line defines its reflection axis. An additional yellow marker identifies the authoritative side. Replace the opposite side with its reflection, including background cells and yellow markers."}]