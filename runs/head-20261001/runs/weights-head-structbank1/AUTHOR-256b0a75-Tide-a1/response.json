[{"task_id":"256b0a75","source_lines":["def run(params, grid, demos):","    bg = int(round(params['settings'][0]))","    frame = int(round(params['settings'][1]))","    size = int(round(params['settings'][2]))","    count = int(round(params['settings'][3]))","    step = int(round(params['settings'][4]))","    out = grid.copy()","    h, w = grid.shape","    if bg == frame or size <= 0 or step <= 0 or size > min(h, w):","        return out","    corners = []","    fill = bg","    for r in range(h - size + step):","        for c in range(w - size + step):","            block = grid[r:r + size, c:c + size]","            if np.count_nonzero(block != bg) != count:","                continue","            colors = np.unique(block[block != bg])","            if len(colors) != step:","                continue","            color = int(colors[0])","            corners.append((r, c, color))","            if color != frame:","                fill = color","    if not corners or fill == bg:","        return out","    top = min(p[0] for p in corners)","    bottom = max(p[0] for p in corners) + size - step","    left = min(p[1] for p in corners)","    right = max(p[1] for p in corners) + size - step","    for r in range(h):","        for c in range(w):","            if (top <= r <= bottom or left <= c <= right) and grid[r, c] == bg:","                out[r, c] = fill","    out[top, left:right + step] = frame","    out[bottom, left:right + step] = frame","    out[top:bottom + step, left] = frame","    out[top:bottom + step, right] = frame","    for r in range(h):","        for c in range(w):","            color = int(grid[r, c])","            if color == bg:","                continue","            direction = None","            if left <= c <= right:","                if r < top:","                    direction = params['directions'][0]","                elif r > bottom:","                    direction = params['directions'][1]","            if top <= r <= bottom:","                if c < left:","                    direction = params['directions'][2]","                elif c > right:","                    direction = params['directions'][3]","            if direction is None:","                continue","            dr = int(round(direction[0]))","            dc = int(round(direction[1]))","            if dr == 0 and dc == 0:","                continue","            rr, cc = r + dr, c + dc","            while 0 <= rr < h and 0 <= cc < w:","                if grid[rr, cc] != bg:","                    break","                out[rr, cc] = color","                rr, cc = rr + dr, cc + dc","    return out"],"shapes":{"settings":[5],"directions":[4,2]},"params":{"settings":[0,8,2,3,1],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Detect the four monochromatic L-shaped corner markers. Their bounds define an azure rectangular frame; the exceptional corner color fills its interior and four outward bands. Colored points within those bands cast rays away from the rectangle, stopping at existing colored points. Points outside the bands remain unchanged."}]