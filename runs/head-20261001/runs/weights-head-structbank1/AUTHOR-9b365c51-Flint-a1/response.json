[{"task_id":"9b365c51","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    target = int(round(params['rule'][1]))","    step = int(round(params['rule'][2]))","    palette = []","    for c in range(grid.shape[1]):","        values = np.unique(grid[:, c]).tolist()","        if len(values) == step:","            color = int(values[0])","            if color != bg and color != target:","                palette.append(color)","    out = np.full(grid.shape, bg, dtype=int)","    previous = np.zeros(grid.shape[0], dtype=bool)","    index = -step","    for c in range(grid.shape[1]):","        mask = grid[:, c] == target","        if np.any(mask):","            if not np.all(mask == previous):","                index += step","            if index >= 0 and index < len(palette):","                out[mask, c] = palette[index]","        previous = mask.copy()","    return out"],"shapes":{"rule":[3]},"params":{"rule":[0,8,1]},"rationale":"Read the full-height color bars from left to right, then erase them. Partition the azure region into consecutive column groups with identical vertical occupancy, and recolor these rectangles using the bar colors in order. The tensors encode background, source color, and unit grouping increment."}]