[{"task_id":"855e0971","source_lines":["def run(params, grid, demos):","    marker = int(round(params['marker'][0]))","    directions = [int(round(v)) for v in params['directions']]","    candidates = [grid, grid.T]","    scores = []","    for candidate in candidates:","        score = 0","        for row in candidate:","            colors = np.unique(row[row != marker])","            if len(colors) == 1:","                score += 1","        scores.append(score)","    transpose = scores[1] > scores[0]","    work = grid.T if transpose else grid","    result = work.copy()","    labels = []","    for row in work:","        values, counts = np.unique(row[row != marker], return_counts=True)","        if len(values):","            labels.append(int(values[np.argmax(counts)]))","        else:","            labels.append(marker)","    height, width = work.shape","    for location in np.argwhere(work == marker):","        row, col = int(location[0]), int(location[1])","        color = labels[row]","        for direction in directions:","            current = row","            for iteration in range(height):","                current += direction","                if current < 0 or current >= height:","                    break","                if labels[current] != color:","                    break","                result[current, col] = marker","    return result.T if transpose else result"],"shapes":{"marker":[1],"directions":[2]},"params":{"marker":[0],"directions":[-1,1]},"rationale":"Identify whether the colored bands run horizontally or vertically by counting monochromatic lines while ignoring the marker color. Extend each marker in both tensor-defined directions across its own contiguous band, stopping at color boundaries. Zeroed directions leave markers unextended."}]