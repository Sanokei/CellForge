[{"task_id":"aa18de87","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    fill = int(round(params['rule'][1]))","    minimum_count = int(round(params['rule'][2]))","    axis = int(round(params['rule'][3]))","    result = grid.copy()","    if axis:","        result = result.T.copy()","    for row in result:","        positions = np.nonzero(row != background)[0]","        if len(positions) >= minimum_count and len(positions):","            left = int(np.min(positions))","            right = int(np.max(positions))","            for column in range(left, right):","                if row[column] == background:","                    row[column] = fill","    if axis:","        result = result.T.copy()","    return result"],"shapes":{"rule":[4]},"params":{"rule":[0,2,2,0]},"rationale":"Fill background cells with red between the leftmost and rightmost nonbackground cells in each row containing at least two boundary cells. Preserve every original colored cell."}]