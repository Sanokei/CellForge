[{"task_id":"f83cb3f6","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    barrier = int(round(params['rule'][1]))","    offset = int(round(params['rule'][2]))","    row_axis = int(round(params['axes'][0]))","    col_axis = int(round(params['axes'][1]))","    result = np.full(grid.shape, background)","    walls = np.argwhere(grid == barrier)","    if len(walls) == 0:","        return result","    for point in walls:","        result[point[row_axis], point[col_axis]] = barrier","    rows = np.unique(walls[:, row_axis])","    cols = np.unique(walls[:, col_axis])","    vertical = len(rows) > len(cols)","    points = np.argwhere(np.logical_and(grid != background, grid != barrier))","    if vertical:","        line = int(cols[0])","        for point in points:","            r = int(point[row_axis])","            c = int(point[col_axis])","            if grid[r, line] == barrier:","                destination = line - offset if c < line else line + offset","                if 0 <= destination < grid.shape[col_axis]:","                    result[r, destination] = grid[r, c]","    else:","        line = int(rows[0])","        for point in points:","            r = int(point[row_axis])","            c = int(point[col_axis])","            if grid[line, c] == barrier:","                destination = line - offset if r < line else line + offset","                if 0 <= destination < grid.shape[row_axis]:","                    result[destination, c] = grid[r, c]","    return result"],"shapes":{"rule":[3],"axes":[2]},"params":{"rule":[0,8,1],"axes":[0,1]},"rationale":"Move each nonbackground, nonbarrier cell straight toward the cyan barrier, stopping one cell away on its original side. Cells aligned with gaps in the barrier disappear; coincident destinations merge. Preserve the barrier and the grid dimensions."}]