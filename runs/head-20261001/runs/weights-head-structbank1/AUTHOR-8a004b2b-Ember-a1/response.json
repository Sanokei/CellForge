[{"task_id":"8a004b2b","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    marker = int(round(params['colors'][1]))","    unit = int(round(params['geometry'][0]))","    points = np.argwhere(grid == marker)","    if len(points) == 0 or unit <= 0:","        return grid.copy()","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0]))","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1]))","    out = grid[top:bottom + unit, left:right + unit].copy()","    exterior = grid.copy()","    exterior[top:bottom + unit, left:right + unit] = bg","    cells = np.argwhere((exterior != bg) & (exterior != marker))","    if len(cells) == 0:","        return out","    tr = int(np.min(cells[:, 0]))","    br = int(np.max(cells[:, 0]))","    tc = int(np.min(cells[:, 1]))","    bc = int(np.max(cells[:, 1]))","    template = exterior[tr:br + unit, tc:bc + unit]","    anchor = None","    for position in np.argwhere(template != bg):","        r = int(position[0])","        c = int(position[1])","        color = int(template[r, c])","        matches = np.argwhere(out == color)","        if len(matches) > 0:","            anchor = (r, c, int(matches[0, 0]), int(matches[0, 1]), color)","            break","    if anchor is None:","        return out","    r, c, ar, ac, color = anchor","    scale = 0","    while ac + scale < out.shape[1] and out[ar, ac + scale] == color:","        scale += unit","    origin_r = ar - r * scale","    origin_c = ac - c * scale","    for position in np.argwhere(template != bg):","        r = int(position[0])","        c = int(position[1])","        color = int(template[r, c])","        start_r = origin_r + r * scale","        start_c = origin_c + c * scale","        for dr in range(scale):","            for dc in range(scale):","                rr = start_r + dr","                cc = start_c + dc","                if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:","                    out[rr, cc] = color","    return out"],"shapes":{"colors":[2],"geometry":[1]},"params":{"colors":[0,4],"geometry":[1]},"rationale":"Crop to the four yellow corner markers. The small pattern outside this rectangle specifies the completed arrangement. Infer its enlargement factor and translation from an existing colored square inside the rectangle, then paint each nonbackground template cell as a square of that size. Preserve the cropped background and corner markers."}]