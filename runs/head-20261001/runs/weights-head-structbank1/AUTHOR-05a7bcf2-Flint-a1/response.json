[{"task_id":"05a7bcf2","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    yellow = int(round(params['colors'][1]))","    green = int(round(params['colors'][2]))","    blue = int(round(params['colors'][3]))","    red = int(round(params['colors'][4]))","    rowaxis = int(round(params['geometry'][0]))","    colaxis = int(round(params['geometry'][1]))","    step = int(round(params['geometry'][2]))","    for value in params['rotations']:","        turn = int(round(value))","        g = np.rot90(grid, turn).copy()","        lines = np.argwhere(np.all(g == blue, axis=colaxis)).flatten()","        ys = np.argwhere(g == yellow)","        rs = np.argwhere(g == red)","        if len(lines) != step or len(ys) == 0 or len(rs) == 0:","            continue","        line = int(lines[0])","        if not np.all(ys[:, rowaxis] < line) or not np.all(rs[:, rowaxis] > line):","            continue","        out = g.copy()","        height = g.shape[rowaxis]","        baseline = int(np.max(rs[:, rowaxis]))","        shift = height - step - baseline","        columns = np.unique(ys[:, colaxis])","        for column in columns:","            column = int(column)","            points = ys[ys[:, colaxis] == column, rowaxis]","            start = int(np.max(points)) + step","            out[start:line, column] = yellow","            out[line + step:height, column] = blue","            targets = rs[rs[:, colaxis] == column, rowaxis]","            for target in targets:","                destination = int(target) + shift","                if 0 <= destination < height:","                    out[destination, column] = red","        out[g == yellow] = green","        return np.rot90(out, -turn).copy()","    return grid.copy()"],"shapes":{"colors":[5],"geometry":[3],"rotations":[4]},"params":{"colors":[0,4,3,8,2],"geometry":[0,1,1],"rotations":[0,1,2,3]},"rationale":"Orient the grid so yellow objects lie above the full blue divider. Recolor original yellow pixels green and extend each occupied column in yellow to the divider. Continue these columns in blue to the opposite edge, replacing their original red pixels with the corresponding red silhouette translated so its shared baseline reaches that edge. Rotate back to the original orientation."}]