[{"task_id":"7b7f7511","source_lines":["def run(params, grid, demos):","    repeats = int(round(params['repeats'][0]))","    if repeats <= 1:","        return grid.copy()","    for value in params['axes']:","        axis = int(round(value))","        if axis not in (0, 1):","            continue","        length = grid.shape[axis]","        if length % repeats != 0:","            continue","        size = length // repeats","        if size <= 0:","            continue","        if axis == 0:","            block = grid[:size, :]","        else:","            block = grid[:, :size]","        rebuilt = np.concatenate([block] * repeats, axis=axis)","        if np.all(rebuilt == grid):","            return block.copy()","    return grid.copy()"],"shapes":{"repeats":[1],"axes":[2]},"params":{"repeats":[2],"axes":[1,0]},"rationale":"Extract one of two identical copies, checking horizontal repetition then vertical repetition. The test yields the first four rows. Tensor values specify the repetition count and axis order; zeroed tensors return the unchanged input."}]