[{"task_id":"2013d3e2","source_lines":["def run(params, grid, demos):","    bg = int(round(params['geometry'][0]))","    divisor = int(round(params['geometry'][1]))","    row_part = int(round(params['geometry'][2]))","    col_part = int(round(params['geometry'][3]))","    inclusive = int(round(params['geometry'][4]))","    if divisor <= 0:","        return grid.copy()","    points = np.argwhere(grid != bg)","    if len(points) == 0:","        return grid.copy()","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0]))","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1]))","    height = (bottom - top + inclusive) // divisor","    width = (right - left + inclusive) // divisor","    if height <= 0 or width <= 0:","        return grid.copy()","    start_row = top + row_part * height","    start_col = left + col_part * width","    return grid[start_row:start_row + height, start_col:start_col + width].copy()"],"shapes":{"geometry":[5]},"params":{"geometry":[0,2,0,0,1]},"rationale":"Crop the nonbackground bounding box and return its upper-left quadrant, the fundamental tile of the rotationally repeated pattern. The tensors specify background, subdivision, quadrant selection, and inclusive extent."}]