[{"task_id":"f341894c","source_lines":["def run(params, grid, demos):","    near = int(round(params['colours'][0]))","    far = int(round(params['colours'][1]))","    marker = int(round(params['colours'][2]))","    zero = int(round(params['zero'][0]))","    out = grid.copy()","    height, width = grid.shape","    markers = np.argwhere(grid == marker)","    for direction in params['directions']:","        dr = int(round(direction[0]))","        dc = int(round(direction[1]))","        if dr == zero and dc == zero:","            continue","        for r in range(height):","            for c in range(width):","                rr = r + dr","                cc = c + dc","                if rr < zero or rr >= height or cc < zero or cc >= width:","                    continue","                a = grid[r, c]","                b = grid[rr, cc]","                if not ((a == near and b == far) or (a == far and b == near)):","                    continue","                closest = None","                position = None","                for point in markers:","                    mr = int(point[0])","                    mc = int(point[1])","                    if (mr - r) * dc != (mc - c) * dr:","                        continue","                    distance = (mr - r) * dr + (mc - c) * dc","                    if closest is None or abs(distance) < closest:","                        closest = abs(distance)","                        position = distance","                if position is None:","                    continue","                if position < zero:","                    out[r, c] = near","                    out[rr, cc] = far","                elif position > zero:","                    out[r, c] = far","                    out[rr, cc] = near","    return out"],"shapes":{"colours":[3],"directions":[2,2],"zero":[1]},"params":{"colours":[6,1,7],"directions":[[0,1],[1,0]],"zero":[0]},"rationale":"Orient each adjacent blue–magenta pair along its row or column so magenta (6) faces the aligned orange marker (7). Preserve all positions and other cells. Alignment with a marker distinguishes the intended pairs even where several pairs touch."}]