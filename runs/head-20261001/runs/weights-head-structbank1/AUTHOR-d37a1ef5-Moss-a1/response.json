[{"task_id":"d37a1ef5","source_lines":["def run(params, grid, demos):","    fill = int(round(params['colors'][0]))","    marker = int(round(params['colors'][1]))","    fr, fc = np.nonzero(grid == fill)","    mr, mc = np.nonzero(grid == marker)","    out = grid.copy()","    if len(fr) == 0 or len(mr) == 0:","        return out","    rows = np.arange(grid.shape[0]).reshape(-1, 1)","    cols = np.arange(grid.shape[1]).reshape(1, -1)","    frame_box = (rows >= np.min(fr)) & (rows <= np.max(fr)) & (cols >= np.min(fc)) & (cols <= np.max(fc))","    marker_box = (rows >= np.min(mr)) & (rows <= np.max(mr)) & (cols >= np.min(mc)) & (cols <= np.max(mc))","    out[frame_box & np.logical_not(marker_box)] = fill","    return out"],"shapes":{"colors":[2]},"params":{"colors":[2,5]},"rationale":"Fill the rectangular frame with red while preserving the entire minimal bounding rectangle of the gray markers, including its black cells. Preserve everything outside the frame."}]