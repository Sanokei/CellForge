[{"task_id":"9c1e755f","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    marker = int(round(params['rule'][1]))","    step = int(round(params['rule'][2]))","    minimum_length = int(round(params['rule'][3]))","    if step <= 0 or minimum_length <= step:","        return grid.copy()","    result = grid.copy()","    for axis_value in params['axes']:","        axis = int(round(axis_value))","        if axis == 0:","            source = grid","            target = result","        else:","            source = grid.T","            target = result.T","        height, width = source.shape","        for row in range(height):","            for start in range(width):","                if source[row, start] != marker:","                    continue","                if start >= step and source[row, start - step] == marker:","                    continue","                end = start","                while end < width and source[row, end] == marker:","                    end += step","                if end - start < minimum_length:","                    continue","                depth = row + step","                while depth < height:","                    seeds = []","                    for column in range(start, end, step):","                        value = source[depth, column]","                        if value != background and value != marker:","                            seeds.append(column)","                    if not seeds:","                        break","                    first = min(seeds)","                    last = max(seeds)","                    period = last - first + step","                    for column in range(start, end, step):","                        template_column = first + (column - first) % period","                        target[depth, column] = source[depth, template_column]","                    depth += step","    return result"],"shapes":{"rule":[4],"axes":[2]},"params":{"rule":[0,5,1,2],"axes":[0,1]},"rationale":"Each gray bar specifies the span to fill. Read the adjacent colored template perpendicular to the bar and repeat it along the bar, preserving its phase. Transposition applies the same rule to vertical bars. Background, marker, traversal step, minimum bar length, and orientations come from the tensors."}]