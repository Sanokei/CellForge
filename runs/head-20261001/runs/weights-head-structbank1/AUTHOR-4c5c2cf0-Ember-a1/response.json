[{"task_id":"4c5c2cf0","source_lines":["def run(params, grid, demos):","    bg = int(round(params['background'][0]))","    offsets = [(int(round(v[0])), int(round(v[1]))) for v in params['marker_offsets']]","    signs = [int(round(v)) for v in params['reflection_signs']]","    divisor = int(round(params['center_divisor'][0]))","    out = grid.copy()","    if divisor == 0:","        return out","    height, width = grid.shape","    marker = None","    center = None","    for color in np.unique(grid):","        if color == bg:","            continue","        points = np.argwhere(grid == color)","        if len(points) != len(offsets):","            continue","        cr = int(round((int(np.min(points[:, 0])) + int(np.max(points[:, 0]))) / divisor))","        cc = int(round((int(np.min(points[:, 1])) + int(np.max(points[:, 1]))) / divisor))","        matches = True","        for dr, dc in offsets:","            rr, rc = cr + dr, cc + dc","            if not (0 <= rr < height and 0 <= rc < width):","                matches = False","                break","            if grid[rr, rc] != color:","                matches = False","                break","        if matches:","            marker = color","            center = (cr, cc)","            break","    if center is None:","        return out","    cr, cc = center","    for r, c in np.argwhere(np.logical_and(grid != bg, grid != marker)):","        for sr in signs:","            for sc in signs:","                rr = cr + sr * (int(r) - cr)","                rc = cc + sc * (int(c) - cc)","                if 0 <= rr < height and 0 <= rc < width:","                    out[rr, rc] = grid[r, c]","    return out"],"shapes":{"background":[1],"marker_offsets":[5,2],"reflection_signs":[2],"center_divisor":[1]},"params":{"background":[0],"marker_offsets":[[-1,-1],[-1,1],[0,0],[1,-1],[1,1]],"reflection_signs":[1,-1],"center_divisor":[2]},"rationale":"Identify the five-cell X marker and reflect every other colored cell across both axes through its center, preserving the original cells. The tensors encode background, marker geometry, center calculation, and reflection directions."}]