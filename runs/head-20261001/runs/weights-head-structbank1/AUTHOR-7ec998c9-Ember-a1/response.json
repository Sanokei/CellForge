[{"task_id":"7ec998c9","source_lines":["def run(params, grid, demos):","    ink = int(round(params['rule'][0]))","    modulus = int(round(params['rule'][1]))","    residue = int(round(params['rule'][2]))","    step = int(round(params['rule'][3]))","    out = grid.copy()","    if modulus <= 0 or step <= 0 or ink < 0 or ink > 9:","        return out","    colors, counts = np.unique(grid, return_counts=True)","    background = int(colors[np.argmax(counts)])","    points = np.argwhere(grid != background)","    if len(points) != step:","        return out","    row, col = points[0]","    height, width = grid.shape","    out[:, col] = ink","    out[row, col] = grid[row, col]","    if background % modulus == residue:","        out[0, :col + step] = ink","        out[height - step, col:] = ink","    else:","        out[0, col:] = ink","        out[height - step, :col + step] = ink","    out[row, col] = grid[row, col]","    return out"],"shapes":{"rule":[4]},"params":{"rule":[1,2,0,1]},"rationale":"Draw a blue vertical line through the unique marker, preserving it. Extend the top and bottom ends in opposite directions. The inferred direction convention is top-left for even background colors and top-right for odd background colors; this reproduces all demonstrations and predicts top-right for the test."}]