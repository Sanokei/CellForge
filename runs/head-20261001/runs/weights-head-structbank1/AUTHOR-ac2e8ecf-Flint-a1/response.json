[{"task_id":"ac2e8ecf","source_lines":["def run(params, grid, demos):","    bg = int(round(params['motion'][0]))","    step = int(round(params['motion'][1]))","    up = int(round(params['motion'][2]))","    down = int(round(params['motion'][3]))","    if step <= 0:","        return grid.copy()","    h, w = grid.shape","    neighbors = [(int(round(v[0])), int(round(v[1]))) for v in params['neighbors']]","    seen = set()","    upper = []","    lower = []","    for r in range(h):","        for c in range(w):","            if grid[r, c] == bg or (r, c) in seen:","                continue","            color = int(grid[r, c])","            cells = [(r, c)]","            seen.add((r, c))","            pos = 0","            while pos < len(cells):","                y, x = cells[pos]","                pos += 1","                for dy, dx in neighbors:","                    ny, nx = y + dy, x + dx","                    if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in seen and grid[ny, nx] == color:","                        seen.add((ny, nx))","                        cells.append((ny, nx))","            top = min(y for y, x in cells)","            bottom = max(y for y, x in cells)","            left = min(x for y, x in cells)","            right = max(x for y, x in cells)","            corners = [(top, left), (top, right), (bottom, left), (bottom, right)]","            if all(p in cells for p in corners):","                upper.append((top, cells, color))","            else:","                lower.append((bottom, cells, color))","    upper.sort(key=lambda item: item[0])","    lower.sort(key=lambda item: item[0], reverse=True)","    out = np.full(grid.shape, bg, dtype=int)","    for objects, direction in [(upper, up), (lower, down)]:","        for edge, cells, color in objects:","            shift = 0","            while direction != 0:","                trial = shift + direction * step","                valid = True","                for y, x in cells:","                    ny = y + trial","                    if ny < 0 or ny >= h:","                        valid = False","                        break","                    if out[ny, x] != bg:","                        valid = False","                        break","                if not valid:","                    break","                shift = trial","            for y, x in cells:","                out[y + shift, x] = color","    return out"],"shapes":{"motion":[4],"neighbors":[4,2]},"params":{"motion":[0,1,-1,1],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Extract same-colour connected objects. Hollow rectangular frames rise and crosses fall, preserving their columns and shapes, until stopped by the grid boundary or another settled object. Frames settle from top to bottom; crosses settle from bottom to top. The tensors encode background, movement magnitude, gravity directions, and connectivity."}]