[{"task_id":"feca6190","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    scale = int(round(params['rule'][1]))","    direction = int(round(params['rule'][2]))","    anchor = int(round(params['rule'][3]))","    values = grid.flatten()","    size = len(values) * int(np.count_nonzero(values != background)) * scale","    if size <= 0 or size > 30:","        return grid.copy()","    result = np.full((size, size), background, dtype=int)","    for row in range(size):","        shift = direction * (size - anchor - row)","        for index in range(len(values)):","            column = index + shift","            if 0 <= column < size:","                result[row, column] = values[index]","    return result"],"shapes":{"rule":[4]},"params":{"rule":[0,1,1,1]},"rationale":"The square side equals input length times its nonbackground count. Place the input along the bottom row and shift it one column right per row upward, clipping at the boundary. The test produces a 20-by-20 square."}]