[{"task_id":"996ec1f3","source_lines":["def run(params, grid, demos):","    size = int(round(params['layout'][0]))","    trim = int(round(params['layout'][1]))","    first = int(round(params['layout'][2]))","    middle = int(round(params['layout'][3]))","    last = int(round(params['layout'][4]))","    colors = int(round(params['layout'][5]))","    if size <= 0 or trim < 0 or colors <= 0:","        return grid.copy()","    height, width = grid.shape","    rows = []","    cols = []","    for r in range(height):","        if np.all(grid[r, :] == grid[r, first]):","            rows.append(r)","    for c in range(width):","        if np.all(grid[:, c] == grid[first, c]):","            cols.append(c)","    if not rows or not cols:","        return grid.copy()","    r = rows[first]","    c = cols[first]","    separator = int(grid[r, c])","    result = np.full((size, size), separator, dtype=int)","    row_regions = [(trim, r - trim), (r + trim + middle, height - trim)]","    col_regions = [(trim, c - trim), (c + trim + middle, width - trim)]","    positions = [first, last]","    for i, row_region in enumerate(row_regions):","        for j, col_region in enumerate(col_regions):","            block = grid[row_region[0]:row_region[1], col_region[0]:col_region[1]]","            if block.size == 0:","                return grid.copy()","            counts = np.bincount(block.flatten(), minlength=colors)","            result[positions[i], positions[j]] = int(np.argmax(counts))","    return result"],"shapes":{"layout":[6]},"params":{"layout":[3,1,0,1,2,10]},"rationale":"Find the uniform horizontal and vertical separator lines. Remove the noisy one-cell perimeter of each quadrant and place its dominant color at the corresponding corner of a 3-by-3 separator-colored output. The test output is [[2,1,4],[1,1,1],[0,1,8]]."}]