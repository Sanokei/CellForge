[{"task_id":"73182012","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    divisor = int(round(params['rule'][1]))","    row_part = int(round(params['rule'][2]))","    col_part = int(round(params['rule'][3]))","    if divisor <= 0:","        return grid.copy()","    points = np.argwhere(grid != background)","    if len(points) == 0:","        return grid.copy()","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0])) + 1","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1])) + 1","    height = (bottom - top) // divisor","    width = (right - left) // divisor","    if height <= 0 or width <= 0:","        return grid.copy()","    top = top + (row_part % divisor) * height","    left = left + (col_part % divisor) * width","    return grid[top:top + height, left:left + width].copy()"],"shapes":{"rule":[4]},"params":{"rule":[0,2,0,0]},"rationale":"Find the nonbackground object's bounding box and return its upper-left quadrant. Each demonstration contains an 8x8 reflection-symmetric object whose output is its upper-left 4x4 quarter. The tensors encode the background, subdivision factor, and selected row and column parts."}]