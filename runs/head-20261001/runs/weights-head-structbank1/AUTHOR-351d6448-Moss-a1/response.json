[{"task_id":"351d6448","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    separator = int(round(params['rule'][1]))","    unit = int(round(params['rule'][2]))","    last_index = int(round(params['rule'][3]))","    previous_index = int(round(params['rule'][4]))","    if unit <= 0:","        return grid.copy()","    panels = []","    start = 0","    for r in range(grid.shape[0]):","        if np.all(grid[r] == separator):","            if r > start:","                panels.append(grid[start:r].copy())","            start = r + unit","    if start < grid.shape[0]:","        panels.append(grid[start:].copy())","    if len(panels) < abs(previous_index):","        return grid.copy()","    a = panels[previous_index]","    b = panels[last_index]","    if a.shape != b.shape:","        return b.copy()","    out = b.copy()","    changed = a != b","    if np.all((a != bg) == (b != bg)) and np.any(changed):","        columns = np.arange(b.shape[1]).reshape((unit, b.shape[1]))","        for value in np.unique(b[changed]):","            color = int(value)","            old = np.argwhere(a == color)","            new = np.argwhere(b == color)","            if len(old) == 0 or len(new) == 0:","                continue","            old_left = int(np.min(old[:, 1]))","            new_left = int(np.min(new[:, 1]))","            old_right = int(np.max(old[:, 1]))","            new_right = int(np.max(new[:, 1]))","            if new_right > old_right:","                edge = new_right + new_right - old_right","                out[np.logical_and(b != bg, columns <= edge)] = color","            elif new_left < old_left:","                edge = new_left + new_left - old_left","                out[np.logical_and(b != bg, columns >= edge)] = color","        return out","    out = np.full(b.shape, bg, dtype=int)","    for r in range(b.shape[0]):","        for value in np.unique(b[r]):","            color = int(value)","            if color == bg:","                continue","            old = np.argwhere(a[r] == color).flatten()","            new = np.argwhere(b[r] == color).flatten()","            if len(old) == 0:","                out[r, new] = color","                continue","            left = int(np.min(new) + np.min(new) - np.min(old))","            right = int(np.max(new) + np.max(new) - np.max(old))","            left = max(0, left)","            right = min(b.shape[1], right + unit)","            if right > left:","                out[r, left:right] = color","    return out"],"shapes":{"rule":[5]},"params":{"rule":[0,5,1,-1,-2]},"rationale":"Gray rows separate successive animation frames. Predict the next frame by extending moving color boundaries: growing bars increase their length, translated objects continue moving, and a recoloring front advances across the existing foreground. In the test, the green front advances through column 5, recoloring its two red cells."}]