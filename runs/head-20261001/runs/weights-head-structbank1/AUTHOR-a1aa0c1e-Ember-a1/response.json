[{"task_id":"a1aa0c1e","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    base = int(round(params['rule'][1]))","    marker = int(round(params['rule'][2]))","    capacity = int(round(params['rule'][3]))","    extra = int(round(params['rule'][4]))","    rung_width = int(round(params['rule'][5]))","    step = int(round(params['rule'][6]))","    if capacity <= 0 or extra <= 0 or step <= 0:","        return np.full((1, 1), bg, dtype=int)","    h, w = grid.shape","    levels = []","    for r in range(h):","        color = int(grid[r, 0])","        if color != bg and color != base and np.all(grid[r] == color):","            levels.append((r, color))","    out = np.full((len(levels), capacity + extra), bg, dtype=int)","    points = np.argwhere(grid == marker)","    if len(levels) == 0 or len(points) == 0:","        return out","    marker_col = int(points[0, 1])","    stops = []","    for i in range(len(levels)):","        start, color = levels[i]","        end = h","        for r in range(start + step, h):","            if np.all(grid[r] == grid[r, 0]) and int(grid[r, 0]) != bg:","                end = r","                break","        band = grid[start + step:end]","        count = 0","        blocked = False","        for r in range(band.shape[0]):","            cells = np.argwhere(band[r] == color)","            if len(cells) == rung_width:","                count += step","            for cell in cells:","                if int(cell[0]) >= marker_col:","                    blocked = True","        out[i, :min(count, capacity)] = color","        out[i, capacity] = base","        stops.append(blocked)","    selected = 0","    for i in range(len(levels) - step, -step, -step):","        if stops[i]:","            selected = i","            break","    out[selected, capacity + step] = marker","    return out"],"shapes":{"rule":[7]},"params":{"rule":[0,9,5,3,2,3,1]},"rationale":"Compress each colored horizontal level into a row containing one cell per ladder rung, followed by the brown separator. Starting from the lowest level, the gray marker ascends past ladders entirely to its left and stops at the first ladder reaching its column or lying to its right; if all ladders are to its left, it reaches the top level."}]