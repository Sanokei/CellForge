[{"task_id":"da6e95e5","source_lines":["def run(params, grid, demos):","    arms = [int(round(v)) for v in params['arms']]","    inset = int(round(params['geometry'][0]))","    gap = int(round(params['geometry'][1]))","    if inset <= 0 or gap <= 0:","        return grid.copy()","    colors, counts = np.unique(grid, return_counts=True)","    bg = int(colors[np.argmax(counts)])","    height, width = grid.shape","    for point in np.argwhere(grid != bg):","        r, c = int(point[0]), int(point[1])","        color = int(grid[r, c])","        for arm in arms:","            if arm <= 0:","                continue","            for h in range(arm + arm + gap, height - r + 1):","                if grid[r + h - inset, c] != color:","                    continue","                for w in range(arm + arm + gap, width - c + 1):","                    if grid[r, c + w - inset] != color or grid[r + h - inset, c + w - inset] != color:","                        continue","                    valid = True","                    for x in range(w):","                        expected = color if x < arm or x >= w - arm else bg","                        if grid[r, c + x] != expected or grid[r + h - inset, c + x] != expected:","                            valid = False","                            break","                    if not valid:","                        continue","                    for y in range(h):","                        expected = color if y < arm or y >= h - arm else bg","                        if grid[r + y, c] != expected or grid[r + y, c + w - inset] != expected:","                            valid = False","                            break","                    if not valid:","                        continue","                    interior = grid[r + inset:r + h - inset, c + inset:c + w - inset]","                    points = np.argwhere(interior != bg)","                    if len(points) == 0:","                        continue","                    if not np.all(interior[interior != bg] == color):","                        continue","                    lo = np.min(points, axis=0)","                    hi = np.max(points, axis=0)","                    return interior[int(lo[0]):int(hi[0]) + inset, int(lo[1]):int(hi[1]) + inset].copy()","    return grid.copy()"],"shapes":{"arms":[2],"geometry":[2]},"params":{"arms":[2,3],"geometry":[1,1]},"rationale":"Find four matching corner brackets with tensor-specified arm lengths and gaps. Select the framed object whose foreground matches its bracket color, then return its tight bounding box, preserving background holes."}]