[{"task_id":"6d58a25d","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    nr = int(round(params['rule'][1]))","    nc = int(round(params['rule'][2]))","    step = int(round(params['rule'][3]))","    margin = int(round(params['rule'][4]))","    best = int(round(params['rule'][5]))","    out = grid.copy()","    h, w = grid.shape","    roof = None","    for color in np.unique(grid):","        if color == bg:","            continue","        score = 0","        for point in np.argwhere(grid == color):","            r, c = int(point[0]), int(point[1])","            rr, cc = r + nr, c + nc","            if 0 <= rr < h and 0 <= cc < w:","                if grid[rr, cc] == color:","                    score += 1","        if score > best:","            best = score","            roof = color","    if roof is None or step <= 0:","        return out","    points = np.argwhere(grid == roof)","    bottom = int(np.max(points[:, 0]))","    left = int(np.min(points[:, 1])) + margin","    right = int(np.max(points[:, 1])) - margin","    for color in np.unique(grid):","        if color == bg or color == roof:","            continue","        for c in range(max(0, left), min(w, right + 1)):","            seeds = np.argwhere(grid[:, c] == color)","            if not np.any(seeds > bottom):","                continue","            support = np.argwhere(grid[:, c] == roof)","            if len(support) == 0:","                continue","            start = int(np.max(support)) + step","            for r in range(start, h, step):","                out[r, c] = int(color)","    return out"],"shapes":{"rule":[6]},"params":{"rule":[0,0,1,1,1,0]},"rationale":"Identify the arrow by horizontal adjacency. Scattered pixels below its base and strictly inside its width select columns. Extend each selected color vertically from immediately below the arrow in that column to the bottom edge. The test selects columns 4, 5, and 7."}]