[{"task_id":"f3e62deb","source_lines":["def run(params, grid, demos):","    bg = int(round(params['base'][0]))","    unit = int(round(params['base'][1]))","    out = np.full(grid.shape, bg, dtype=int)","    for rule in params['motion']:","        color = int(round(rule[0]))","        dr = int(round(rule[1]))","        dc = int(round(rule[2]))","        points = np.argwhere(grid == color)","        if len(points) == 0:","            continue","        rows = points[:, 0]","        cols = points[:, 1]","        sr = 0","        sc = 0","        if dr < 0:","            sr = dr * int(np.min(rows))","        elif dr > 0:","            sr = dr * (grid.shape[0] - unit - int(np.max(rows)))","        if dc < 0:","            sc = dc * int(np.min(cols))","        elif dc > 0:","            sc = dc * (grid.shape[1] - unit - int(np.max(cols)))","        for point in points:","            r = int(point[0]) + sr","            c = int(point[1]) + sc","            if 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:","                out[r, c] = color","    return out"],"shapes":{"base":[2],"motion":[4,3]},"params":{"base":[0,1],"motion":[[3,0,-1],[4,1,0],[6,-1,0],[8,0,1]]},"rationale":"Translate each colored object to the boundary indicated by its color, preserving its shape and perpendicular position: magenta up, azure right, yellow down, and green left. Green's direction completes the four-color directional mapping."}]