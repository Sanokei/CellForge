[{"task_id":"d43fd935","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    center = int(round(params['colors'][1]))","    stride = int(round(params['stride'][0]))","    out = grid.copy()","    if stride <= 0 or background == center:","        return out","    directions = []","    for pair in params['directions']:","        dr = int(round(pair[0]))","        dc = int(round(pair[1]))","        if abs(dr) + abs(dc) != stride:","            return out","        directions.append((dr, dc))","    height, width = grid.shape","    for position in np.argwhere(grid == center):","        row = int(position[0])","        col = int(position[1])","        for dr, dc in directions:","            r = row + dr","            c = col + dc","            path = []","            while 0 <= r < height and 0 <= c < width:","                color = int(grid[r, c])","                if color != background:","                    if color != center:","                        for pr, pc in path:","                            out[pr, pc] = color","                    break","                path.append((r, c))","                r += dr","                c += dc","    return out"],"shapes":{"colors":[2],"stride":[1],"directions":[4,2]},"params":{"colors":[0,3],"stride":[1],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Extend each marker aligned with either row or column of the green square toward the square, filling the intervening background with the marker's color. The tensors specify the background, central object color, and four cardinal scanning directions."}]