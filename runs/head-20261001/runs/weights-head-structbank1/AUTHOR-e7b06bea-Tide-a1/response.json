[{"task_id":"e7b06bea","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    marker = int(round(params['rule'][1]))","    origin = int(round(params['rule'][2]))","    shift = int(round(params['rule'][3]))","    step = int(round(params['rule'][4]))","    height, width = grid.shape","    if origin < 0 or origin >= width or origin >= height or step <= 0:","        return grid.copy()","    block = int(np.count_nonzero(grid[:, origin] == marker))","    columns = []","    for column in range(width):","        color = int(grid[origin, column])","        if color != background and color != marker:","            columns.append(column)","    if block <= 0 or len(columns) == 0:","        return grid.copy()","    destination = columns[origin] + shift","    if destination < 0 or destination >= width:","        return grid.copy()","    palette = [int(grid[origin, column]) for column in columns]","    output = grid.copy()","    for column in columns:","        output[:, column] = background","    for row in range(height):","        index = ((row // block) * step) % len(palette)","        output[row, destination] = palette[index]","    return output"],"shapes":{"rule":[5]},"params":{"rule":[0,5,0,-1,1]},"rationale":"The gray marker's height sets the run length. Read the colored columns from left to right and cycle their colors vertically in runs of that length, placing the resulting column one position left of the original colored band and clearing the original band."}]