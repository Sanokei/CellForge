[{"task_id":"3618c87e","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    moving = int(round(params['rule'][1]))","    support = int(round(params['rule'][2]))","    dr = int(round(params['rule'][3]))","    dc = int(round(params['rule'][4]))","    out = grid.copy()","    height, width = grid.shape","    for r, c in np.argwhere(grid == moving):","        nr = r + dr","        nc = c + dc","        if 0 <= nr < height and 0 <= nc < width:","            if grid[nr, nc] == support:","                out[r, c] = background","                out[nr, nc] = moving","    return out"],"shapes":{"rule":[5]},"params":{"rule":[0,1,5,2,0]},"rationale":"Move each blue cell two rows downward, replacing the gray cell beneath its column and clearing its original position."}]