[{"task_id":"e3fe1151","source_lines":["def run(params, grid, demos):","    bg = int(round(params['layout'][0]))","    side = int(round(params['layout'][1]))","    gap = int(round(params['layout'][2]))","    count = int(round(params['layout'][3]))","    out = grid.copy()","    if side <= 0 or gap < 0 or count <= 0:","        return out","    extent = count * side + (count - 1) * gap","    if grid.shape[0] != extent or grid.shape[1] != extent:","        return out","    colors = [int(c) for c in np.unique(grid) if int(c) != bg]","    blocks = []","    target = {}","    for color in colors:","        target[color] = 0","    for br in range(count):","        for bc in range(count):","            r = br * (side + gap)","            c = bc * (side + gap)","            block = grid[r:r + side, c:c + side]","            blocks.append((r, c, block))","            for color in colors:","                amount = int(np.count_nonzero(block == color))","                target[color] = max(target[color], amount)","    for r, c, block in blocks:","        missing = []","        for color in colors:","            amount = target[color] - int(np.count_nonzero(block == color))","            for k in range(amount):","                missing.append(color)","        holes = np.argwhere(block == bg)","        if len(missing) == len(holes):","            for k in range(len(missing)):","                rr = int(holes[k][0])","                cc = int(holes[k][1])","                out[r + rr, c + cc] = missing[k]","    return out"],"shapes":{"layout":[4]},"params":{"layout":[7,2,1,2]},"rationale":"The four corner blocks share the same color multiset. Infer each color's required multiplicity as its maximum occurrence in any block, then replace background holes with missing colors. Tensor values specify the background, block size, separator width, and block count."}]