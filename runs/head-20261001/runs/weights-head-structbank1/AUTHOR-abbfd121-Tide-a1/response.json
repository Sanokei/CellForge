[{"task_id":"abbfd121","source_lines":["def run(params, grid, demos):","    unit = int(round(params['rules'][0]))","    minimum_side = int(round(params['rules'][1]))","    zero = int(round(params['rules'][2]))","    if unit <= zero:","        return grid.copy()","    h, w = grid.shape","    rectangles = []","    mask = np.zeros(grid.shape, dtype=bool)","    for color in np.unique(grid):","        points = np.argwhere(grid == color)","        top = int(np.min(points[:, 0]))","        bottom = int(np.max(points[:, 0])) + unit","        left = int(np.min(points[:, 1]))","        right = int(np.max(points[:, 1])) + unit","        if bottom - top >= minimum_side and right - left >= minimum_side:","            if np.all(grid[top:bottom, left:right] == color):","                rectangles.append((top, bottom, left, right))","                mask[top:bottom, left:right] = True","    if len(rectangles) == zero:","        return grid.copy()","    target = rectangles[zero]","    for rectangle in rectangles:","        area = (rectangle[1] - rectangle[0]) * (rectangle[3] - rectangle[2])","        best_area = (target[1] - target[0]) * (target[3] - target[2])","        if area > best_area:","            target = rectangle","    row_period = h","    for period in range(unit, h, unit):","        valid = np.logical_not(np.logical_or(mask[period:, :], mask[:-period, :]))","        if np.any(valid) and np.all(grid[period:, :][valid] == grid[:-period, :][valid]):","            row_period = period","            break","    column_period = w","    for period in range(unit, w, unit):","        valid = np.logical_not(np.logical_or(mask[:, period:], mask[:, :-period]))","        if np.any(valid) and np.all(grid[:, period:][valid] == grid[:, :-period][valid]):","            column_period = period","            break","    top, bottom, left, right = target","    result = np.full((bottom - top, right - left), zero, dtype=int)","    for r in range(top, bottom, unit):","        for c in range(left, right, unit):","            values = []","            for rr in range(r % row_period, h, row_period):","                for cc in range(c % column_period, w, column_period):","                    if not mask[rr, cc]:","                        values.append(int(grid[rr, cc]))","            if len(values) > zero:","                colors, counts = np.unique(np.array(values), return_counts=True)","                result[r - top, c - left] = colors[np.argmax(counts)]","    return result"],"shapes":{"rules":[3]},"params":{"rules":[1,2,0]},"rationale":"Identify solid rectangular occlusions, select the largest by area, infer the background's horizontal and vertical periods from visible cells, and return the restored pattern within that rectangle. The test selects the 8-by-9 rectangle of color 4."}]