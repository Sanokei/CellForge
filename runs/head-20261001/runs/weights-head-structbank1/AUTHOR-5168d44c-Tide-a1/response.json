[{"task_id":"5168d44c","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    frame = int(round(params['colors'][1]))","    marker = int(round(params['colors'][2]))","    stationary = int(round(params['motion'][0]))","    step = int(round(params['motion'][1]))","    points = np.argwhere(grid == marker)","    cells = np.argwhere(grid == frame)","    out = grid.copy()","    if len(points) == 0 or len(cells) == 0:","        return out","    row_span = np.max(points[:, 0]) - np.min(points[:, 0])","    col_span = np.max(points[:, 1]) - np.min(points[:, 1])","    if row_span > col_span:","        dr = step","        dc = stationary","    else:","        dr = stationary","        dc = step","    for r, c in cells:","        out[r, c] = background","    for r, c in cells:","        nr = r + dr","        nc = c + dc","        if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:","            out[nr, nc] = frame","    return out"],"shapes":{"colors":[3],"motion":[2]},"params":{"colors":[0,2,3],"motion":[0,2]},"rationale":"Move the red frame one marker interval forward along the green dotted line: two cells down for vertical lines or two cells right for horizontal lines. Preserve the green markers and erase the frame's previous position."}]