[{"task_id":"80214e03","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    step = int(round(params['rule'][1]))","    direction = int(round(params['rule'][2]))","    if step <= 0 or direction == 0:","        return grid.copy()","    points = np.argwhere(grid != bg)","    if len(points) == 0:","        return grid.copy()","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0])) + step","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1])) + step","    region = grid[top:bottom, left:right]","    rows = [0]","    cols = [0]","    for r in range(step, region.shape[0]):","        a = region[r - step, :]","        b = region[r, :]","        if np.any((a != bg) & (b != bg) & (a != b)):","            rows.append(r)","    rows.append(region.shape[0])","    for c in range(step, region.shape[1]):","        a = region[:, c - step]","        b = region[:, c]","        if np.any((a != bg) & (b != bg) & (a != b)):","            cols.append(c)","    cols.append(region.shape[1])","    result = np.full((len(rows) - step, len(cols) - step), bg, dtype=int)","    for r in range(len(rows) - step):","        for c in range(len(cols) - step):","            block = region[rows[r]:rows[r + step], cols[c]:cols[c + step]]","            values = block[block != bg]","            if len(values) > 0:","                result[r, c] = int(np.argmax(np.bincount(values)))","    return result[:, ::direction]"],"shapes":{"rule":[3]},"params":{"rule":[0,1,-1]},"rationale":"Infer rectangular row and column divisions from adjacent differing nonbackground colours, compress each tile to its dominant colour, and mirror horizontally. Spanning rectangles repeat their colour across the inferred tiles."}]