[{"task_id":"14754a24","source_lines":["def run(params, grid, demos):","    marker = int(round(params['colors'][0]))","    substrate = int(round(params['colors'][1]))","    paint = int(round(params['colors'][2]))","    required = int(round(params['minimum'][0]))","    offsets = [(int(round(pair[0])), int(round(pair[1]))) for pair in params['cross']]","    out = grid.copy()","    height, width = grid.shape","    for row in range(height):","        for col in range(width):","            cells = []","            valid = True","            markers = 0","            for dr, dc in offsets:","                rr, cc = row + dr, col + dc","                if rr < 0 or rr >= height or cc < 0 or cc >= width:","                    valid = False","                    break","                value = grid[rr, cc]","                if value != marker and value != substrate:","                    valid = False","                    break","                markers += int(value == marker)","                cells.append((rr, cc))","            if valid and markers >= required:","                for rr, cc in cells:","                    if grid[rr, cc] == substrate:","                        out[rr, cc] = paint","    return out"],"shapes":{"colors":[3],"minimum":[1],"cross":[5,2]},"params":{"colors":[4,5,2],"minimum":[2],"cross":[[0,0],[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Find five-cell orthogonal crosses composed entirely of yellow and gray, containing at least two yellow cells. Recolor every gray cell in each such cross red, preserving yellow markers and the surrounding grid."}]