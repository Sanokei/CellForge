[{"task_id":"58e15b12","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    colors = [int(round(params['rule'][1])), int(round(params['rule'][2]))]","    crossing = int(round(params['rule'][3]))","    step = int(round(params['rule'][4]))","    directions = [int(round(params['rule'][5])), int(round(params['rule'][6]))]","    out = np.full(grid.shape, bg, dtype=int)","    zero = step - step","    if step <= zero:","        return out","    for color in colors:","        points = np.argwhere(grid == color)","        if len(points) == zero:","            continue","        top = int(np.min(points[:, 0]))","        bottom = int(np.max(points[:, 0]))","        left = int(np.min(points[:, 1]))","        right = int(np.max(points[:, 1]))","        length = bottom - top + step","        if length <= zero:","            continue","        for row in range(grid.shape[0]):","            distance = max(top - row, row - bottom, zero)","            shift = ((distance + length - step) // length) * step","            for anchor, direction in zip([left, right], directions):","                col = anchor + direction * shift","                if zero <= col < grid.shape[1]:","                    if out[row, col] == bg or out[row, col] == color:","                        out[row, col] = color","                    else:","                        out[row, col] = crossing","    return out"],"shapes":{"rule":[7]},"params":{"rule":[0,3,8,6,1,-1,1]},"rationale":"Extend each pair of vertical colored segments upward and downward, moving both arms outward by one column per segment-height rows. Preserve the original narrow segments and mark intersections of green and azure arms with 6. The tensors encode background, arm colors, intersection color, step size, and outward directions."}]