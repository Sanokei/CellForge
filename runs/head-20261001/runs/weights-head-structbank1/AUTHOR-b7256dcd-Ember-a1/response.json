[{"task_id":"b7256dcd","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    body = int(round(params['colors'][1]))","    directions = []","    for row in params['directions']:","        directions.append((int(round(row[0])), int(round(row[1]))))","    h, w = grid.shape","    out = np.full((h, w), bg, dtype=int)","    seen = set()","    for r in range(h):","        for c in range(w):","            if int(grid[r, c]) != body or (r, c) in seen:","                continue","            cells = [(r, c)]","            seen.add((r, c))","            pending = [(r, c)]","            labels = []","            while pending:","                y, x = pending.pop()","                for dy, dx in directions:","                    yy, xx = y + dy, x + dx","                    if yy < 0 or yy >= h or xx < 0 or xx >= w:","                        continue","                    value = int(grid[yy, xx])","                    if value == body:","                        if (yy, xx) not in seen:","                            seen.add((yy, xx))","                            cells.append((yy, xx))","                            pending.append((yy, xx))","                    elif value != bg:","                        labels.append(value)","            color = labels[0] if labels else body","            for y, x in cells:","                out[y, x] = color","    return out"],"shapes":{"colors":[2],"directions":[4,2]},"params":{"colors":[7,6],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Each orthogonally connected component of color 6 takes the color of an orthogonally adjacent marker. Components without a touching marker remain 6. All marker cells become background 7, including isolated markers. The tensors encode the background, component color, and adjacency offsets."}]