[{"task_id":"f9a67cb5","source_lines":["def run(params, grid, demos):","    bg = int(round(params['geometry'][0]))","    ink = int(round(params['geometry'][1]))","    wall = int(round(params['geometry'][2]))","    step = int(round(params['geometry'][3]))","    out = grid.copy()","    if step <= 0 or step > min(grid.shape):","        return out","    seeds = np.argwhere(grid == ink)","    if len(seeds) != 1 or bg == ink or ink == wall or bg == wall:","        return out","    horizontal = np.max(np.sum(grid == wall, axis=1))","    vertical = np.max(np.sum(grid == wall, axis=0))","    transposed = vertical > horizontal","    work = grid.T.copy() if transposed else grid.copy()","    barriers = [r for r in range(work.shape[0]) if np.any(work[r] == wall)]","    if len(barriers) == 0:","        return out","    seed = np.argwhere(work == ink)[0]","    reversed = int(seed[0]) > barriers[0]","    if reversed:","        work = np.flipud(work).copy()","    result = work.copy()","    seed = np.argwhere(work == ink)[0]","    active = set([int(seed[1])])","    previous = int(seed[0]) - step","    barriers = [r for r in range(work.shape[0]) if np.any(work[r] == wall) and r > int(seed[0])]","    for row in barriers:","        following = set()","        for col in active:","            for r in range(previous + step, row, step):","                result[r, col] = ink","            if work[row, col] == bg:","                result[row, col] = ink","                following.add(col)","            else:","                for delta in [-step, step]:","                    x = col + delta","                    while 0 <= x < work.shape[1]:","                        result[row - step, x] = ink","                        if work[row, x] == bg:","                            result[row, x] = ink","                            following.add(x)","                            break","                        x += delta","        active = following","        previous = row","    for col in active:","        for r in range(previous + step, work.shape[0], step):","            result[r, col] = ink","    if reversed:","        result = np.flipud(result)","    if transposed:","        result = result.T","    return result.copy()"],"shapes":{"geometry":[4]},"params":{"geometry":[0,2,8,1]},"rationale":"Red rays travel toward successive cyan barriers. A ray hitting cyan splits along the preceding row in both directions, stopping at the first opening or grid boundary. Rays pass through openings and continue toward the next barrier. Orientation is inferred from the barriers and seed; the tensors specify background, ray and barrier colours and the movement step."}]