[{"task_id":"c7d4e6ad","source_lines":["def run(params, grid, demos):","    target = int(round(params['rule'][0]))","    column = int(round(params['rule'][1])) % grid.shape[1]","    out = grid.copy()","    for r in range(grid.shape[0]):","        out[r, grid[r] == target] = grid[r, column]","    return out"],"shapes":{"rule":[2]},"params":{"rule":[5,0]},"rationale":"Replace each gray cell with the color in the leftmost column of its row, preserving all other cells."}]