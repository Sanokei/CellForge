[{"task_id":"1a2e2828","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    coverage = float(params['rule'][1])","    size = int(round(params['rule'][2]))","    height, width = grid.shape","    winner = background","    for value in np.unique(grid):","        color = int(value)","        if color != background:","            mask = grid == color","            horizontal = np.any(np.sum(mask, axis=1) == width * coverage)","            vertical = np.any(np.sum(mask, axis=0) == height * coverage)","            if horizontal or vertical:","                winner = color","                break","    return np.full((size, size), winner)"],"shapes":{"rule":[3]},"params":{"rule":[0,1,1]},"rationale":"Return the color of the uninterrupted stripe that passes over every intersecting stripe. It occupies an entire row or column. The tensors encode background color, required full-line coverage, and output size. The test's uninterrupted vertical stripe is color 7."}]