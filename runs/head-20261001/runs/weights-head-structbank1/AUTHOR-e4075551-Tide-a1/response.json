[{"task_id":"e4075551","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    center = int(round(params['colors'][1]))","    line = int(round(params['colors'][2]))","    row_axis = int(round(params['geometry'][0]))","    col_axis = int(round(params['geometry'][1]))","    step = int(round(params['geometry'][2]))","    out = grid.copy()","    points = np.argwhere(grid != bg)","    centers = np.argwhere(grid == center)","    if len(points) == 0 or len(centers) != 1:","        return out","    if row_axis not in (0, 1) or col_axis not in (0, 1) or row_axis == col_axis or step <= 0:","        return out","    top = int(np.min(points[:, row_axis]))","    bottom = int(np.max(points[:, row_axis]))","    left = int(np.min(points[:, col_axis]))","    right = int(np.max(points[:, col_axis]))","    cr = int(centers[0, row_axis])","    cc = int(centers[0, col_axis])","    top_color = bg","    bottom_color = bg","    left_color = bg","    right_color = bg","    for point in points:","        r = int(point[row_axis])","        c = int(point[col_axis])","        color = int(grid[tuple(point)])","        if r == top:","            top_color = color","        if r == bottom:","            bottom_color = color","        if c == left:","            left_color = color","        if c == right:","            right_color = color","    for r in range(top, bottom + step):","        for c in range(left, right + step):","            position = [0, 0]","            position[row_axis] = r","            position[col_axis] = c","            position = tuple(position)","            if r == top:","                out[position] = top_color","            elif r == bottom:","                out[position] = bottom_color","            elif c == left:","                out[position] = left_color","            elif c == right:","                out[position] = right_color","            elif r == cr or c == cc:","                out[position] = line","    out[tuple(centers[0])] = center","    return out"],"shapes":{"colors":[3],"geometry":[3]},"params":{"colors":[0,2,5],"geometry":[0,1,1]},"rationale":"The four extreme seeds define a rectangle. Extend each seed along its corresponding boundary, with horizontal boundaries owning the corners. Draw a gray cross through the red seed inside the rectangle and preserve the red center."}]