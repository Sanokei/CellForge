[{"task_id":"1acc24af","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    wall = int(round(params['colors'][1]))","    piece = int(round(params['colors'][2]))","    paint = int(round(params['colors'][3]))","    steps = [(int(round(v[0])), int(round(v[1]))) for v in params['neighbors']]","    turns = [int(round(v)) for v in params['turns']]","    one = int(round(params['unit'][0]))","    out = grid.copy()","    if one != 1 or bg == wall or piece == paint:","        return out","    h, w = grid.shape","    marks = np.argwhere(grid == wall)","    if len(marks) == 0:","        return out","    low = int(np.min(marks[:, 0]))","    high = int(np.max(marks[:, 0]))","    remaining = set((int(r), int(c)) for r, c in np.argwhere(grid == bg) if low <= r <= high)","    cavities = []","    while remaining:","        start = next(iter(remaining))","        remaining.remove(start)","        group = {start}","        queue = [start]","        for r, c in queue:","            for dr, dc in steps:","                q = (r + dr, c + dc)","                if q in remaining:","                    remaining.remove(q)","                    group.add(q)","                    queue.append(q)","        upper = any(r == low for r, c in group)","        lower = any(r == high for r, c in group)","        if upper != lower:","            cavities.append((group, upper))","    remaining = set((int(r), int(c)) for r, c in np.argwhere(grid == piece))","    while remaining:","        start = next(iter(remaining))","        remaining.remove(start)","        group = {start}","        queue = [start]","        for r, c in queue:","            for dr, dc in steps:","                q = (r + dr, c + dc)","                if q in remaining:","                    remaining.remove(q)","                    group.add(q)","                    queue.append(q)","        rmin = min(r for r, c in group)","        cmin = min(c for r, c in group)","        rmax = max(r for r, c in group)","        cmax = max(c for r, c in group)","        mask = np.zeros((rmax - rmin + one, cmax - cmin + one), dtype=int)","        for r, c in group:","            mask[r - rmin, c - cmin] = one","        fits = False","        for turn in turns:","            shape = [(int(r), int(c)) for r, c in np.argwhere(np.rot90(mask, turn) == one)]","            for cavity, upper in cavities:","                if len(shape) < len(cavity):","                    continue","                anchor = next(iter(cavity))","                for sr, sc in shape:","                    dr = anchor[0] - sr","                    dc = anchor[1] - sc","                    placed = set((r + dr, c + dc) for r, c in shape)","                    if not cavity.issubset(placed):","                        continue","                    valid = True","                    for r, c in placed:","                        if c < 0 or c >= w:","                            valid = False","                            break","                        if low <= r <= high:","                            if (r, c) not in cavity:","                                valid = False","                                break","                        elif upper:","                            if r > high:","                                valid = False","                                break","                        elif r < low:","                            valid = False","                            break","                    if valid:","                        fits = True","                        break","                if fits:","                    break","            if fits:","                break","        if fits:","            for r, c in group:","                out[r, c] = paint","    return out"],"shapes":{"colors":[4],"neighbors":[4,2],"turns":[4],"unit":[1]},"params":{"colors":[0,1,5,2],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]],"turns":[0,1,2,3],"unit":[1]},"rationale":"The blue contour defines recesses opening upward or downward. Recolor a gray component when some rotation fills an entire recess without intersecting its blue boundary; excess cells may protrude through the open side. This accepts the square, straight bar, capped rectangle, P, T, and plus where their recesses permit them, while rejecting the zigzag and incompatible L."}]