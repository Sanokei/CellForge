[{"task_id":"6ea4a07e","source_lines":["def run(params, grid, demos):","    background = int(round(params['background'][0]))","    erased = int(round(params['erased'][0]))","    result = np.full(grid.shape, erased)","    for i in range(len(params['input_colours'])):","        colour = int(round(params['input_colours'][i]))","        replacement = int(round(params['output_colours'][i]))","        if np.any(grid == colour):","            result = np.where(grid == background, replacement, erased)","    return result"],"shapes":{"background":[1],"erased":[1],"input_colours":[3],"output_colours":[3]},"params":{"background":[0],"erased":[0],"input_colours":[5,8,3],"output_colours":[4,2,1]},"rationale":"Erase the foreground and fill its background complement with a colour determined by the original foreground: 5 maps to 4, 8 to 2, and 3 to 1."}]