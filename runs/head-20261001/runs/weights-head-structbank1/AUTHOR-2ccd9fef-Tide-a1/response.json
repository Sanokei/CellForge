[{"task_id":"2ccd9fef","source_lines":["def grow(mask, old, axis, amount, unit):","    if amount == 0:","        return mask","    a = mask if axis == 0 else mask.T","    b = old if axis == 0 else old.T","    change = a.shape[0] - b.shape[0]","    if amount < 0:","        a = a[:max(unit, a.shape[0] + amount)]","        return a if axis == 0 else a.T","    location = a.shape[0] - unit","    block = a[location:location + unit]","    if change > 0 and a.shape[1] == b.shape[1]:","        for k in range(a.shape[0] - change + unit):","            reduced = np.concatenate((a[:k], a[k + change:]), axis=0)","            if reduced.shape == b.shape and np.all(reduced == b):","                location = k","                block = a[k:k + change]","                break","    pieces = []","    for j in range(amount):","        pieces.append(block[j % block.shape[0]:j % block.shape[0] + unit])","    added = np.concatenate(pieces, axis=0)","    a = np.concatenate((a[:location], added, a[location:]), axis=0)","    return a if axis == 0 else a.T","def run(params, grid, demos):","    unit = int(round(params['rule'][0]))","    least = int(round(params['rule'][1]))","    minimum = int(round(params['rule'][2]))","    if unit != 1 or least < 3 or minimum < 3:","        return grid.copy()","    h, w = grid.shape","    chosen = None","    best = 0","    for axis in range(2):","        length = h if axis == 0 else w","        for count in range(least, length + unit):","            if length % count != 0:","                continue","            size = length // count","            if size < minimum:","                continue","            tiles = []","            for i in range(count):","                tile = grid[i * size:(i + unit) * size, :] if axis == 0 else grid[:, i * size:(i + unit) * size]","                tiles.append(tile)","            first = tiles[0]","            valid = True","            for tile in tiles[unit:]:","                if not (np.all(tile[0] == first[0]) and np.all(tile[-unit] == first[-unit]) and np.all(tile[:, 0] == first[:, 0]) and np.all(tile[:, -unit] == first[:, -unit])):","                    valid = False","                    break","            if valid and first.shape[0] * first.shape[1] > best:","                chosen = tiles","                best = first.shape[0] * first.shape[1]","    if chosen is None:","        return grid.copy()","    tiles = chosen","    result = tiles[-unit].copy()","    frame = np.unique(result)","    colours = np.unique(grid)","    target = len(tiles) - unit","    for colour in colours:","        if np.any(frame == colour):","            continue","        occurrences = []","        for i in range(target):","            positions = np.argwhere(tiles[i] == colour)","            if len(positions) > 0:","                low = np.min(positions, axis=0)","                high = np.max(positions, axis=0) + unit","                mask = tiles[i][low[0]:high[0], low[1]:high[1]] == colour","                occurrences.append((i, low, high, mask))","        if len(occurrences) < 2:","            continue","        previous = occurrences[-2]","        latest = occurrences[-unit]","        gap = latest[0] - previous[0]","        distance = target - latest[0]","        if distance % gap != 0:","            continue","        steps = distance // gap","        low = latest[1] + (latest[1] - previous[1]) * steps","        high = latest[2] + (latest[2] - previous[2]) * steps","        desired = high - low","        mask = latest[3]","        for axis in range(2):","            amount = int(desired[axis]) - mask.shape[axis]","            mask = grow(mask, previous[3], axis, amount, unit)","        for r in range(mask.shape[0]):","            for c in range(mask.shape[1]):","                rr = int(low[0]) + r","                cc = int(low[1]) + c","                if mask[r, c] and 0 <= rr < result.shape[0] and 0 <= cc < result.shape[1]:","                    result[rr, cc] = colour","    return result"],"shapes":{"rule":[3]},"params":{"rule":[1,3,3]},"rationale":"Find repeated framed panels and extrapolate their objects into the final empty panel. Each object's occurrence interval determines whether it appears next; bounding-box motion and growth follow its previous two occurrences. Growth repeats the row or column block inserted between those occurrences, preserving brackets, stems, rectangles, and alternating internal patterns."}]