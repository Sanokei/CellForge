[{"task_id":"c803e39c","source_lines":["def run(params, grid, demos):","    bg = int(round(params['roles'][0]))","    separator = int(round(params['roles'][1]))","    inner_color = int(round(params['roles'][2]))","    outer_color = int(round(params['roles'][3]))","    foreground_index = int(round(params['roles'][4]))","    background_index = int(round(params['roles'][5]))","    inner_points = np.argwhere(grid == inner_color)","    outer_points = np.argwhere(grid == outer_color)","    if len(inner_points) == 0 or len(outer_points) == 0:","        return grid.copy()","    inner_low = np.min(inner_points, axis=0)","    inner_high = np.max(inner_points, axis=0)","    outer_low = np.min(outer_points, axis=0)","    outer_high = np.max(outer_points, axis=0)","    inner = grid[inner_low[0]:inner_high[0]+1, inner_low[1]:inner_high[1]+1] == inner_color","    outer = grid[outer_low[0]:outer_high[0]+1, outer_low[1]:outer_high[1]+1] == outer_color","    palette = []","    for row in grid:","        for value in row:","            color = int(value)","            if color != bg and color != separator and color != inner_color and color != outer_color and color not in palette:","                palette.append(color)","    if foreground_index < 0 or background_index < 0 or foreground_index >= len(palette) or background_index >= len(palette):","        return grid.copy()","    mask = np.kron(outer, inner)","    return np.where(mask, palette[foreground_index], palette[background_index]).astype(int)"],"shapes":{"roles":[6]},"params":{"roles":[0,5,1,2,0,1]},"rationale":"The color-2 pattern selects blocks containing copies of the color-1 pattern. Their Kronecker product is painted with the third panel's color, while all remaining cells use the fourth panel's color. Bounding boxes recover the pattern dimensions, including the test's 5-by-5 patterns."}]