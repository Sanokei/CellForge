[{"task_id":"9841fdad","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    step = int(round(params['rule'][1]))","    turns = int(round(params['rule'][2]))","    g = np.rot90(grid, turns).copy()","    h, w = g.shape","    if step <= 0 or step + step >= min(h, w):","        return grid.copy()","    border = int(g[0, 0])","    dividers = []","    for c in range(step, w - step):","        if np.all(g[:, c] == border):","            dividers.append(c)","    if len(dividers) != 1:","        return grid.copy()","    sep = dividers[0]","    left = step + step","    right = sep - step - step","    target_left = sep + step + step","    target_right = w - step - step - step","    if left > right or target_left > target_right:","        return grid.copy()","    out = g.copy()","    for r in range(step, h - step):","        c = step","        while c < sep:","            if int(g[r, c]) == bg:","                c += step","            else:","                color = int(g[r, c])","                a = c","                while c < sep and int(g[r, c]) == color:","                    c += step","                b = c - step","                if a == left and b == right:","                    ta = target_left","                    tb = target_right","                elif a - left <= right - b:","                    ta = target_left + a - left","                    tb = ta + b - a","                else:","                    tb = target_right - (right - b)","                    ta = tb - (b - a)","                if ta >= sep + step and tb < w - step:","                    out[r, ta:tb + step] = color","    return np.rot90(out, -turns)"],"shapes":{"rule":[3]},"params":{"rule":[1,1,0]},"rationale":"Copy the left panel's colored shapes into the wider right panel. Preserve each row and shape height; anchor short runs to their nearest side, and stretch runs spanning the source's usable width across the target's usable width. The tensors specify background, border spacing, and orientation."}]