[{"task_id":"9f5f939b","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    fg = int(round(params['rule'][1]))","    mark = int(round(params['rule'][2]))","    start = int(round(params['rule'][3]))","    step = int(round(params['rule'][4]))","    axes = [[int(round(v)) for v in row] for row in params['axes']]","    signs = [int(round(v)) for v in params['signs']]","    out = grid.copy()","    h, w = grid.shape","    for r in range(h):","        for c in range(w):","            if grid[r, c] != bg:","                continue","            matched = True","            for dr, dc in axes:","                found = False","                for distance in range(max(0, start), max(h, w)):","                    good = True","                    for sign in signs:","                        for offset in (distance, distance + step):","                            rr = r + sign * offset * dr","                            cc = c + sign * offset * dc","                            if rr < 0 or rr >= h or cc < 0 or cc >= w:","                                good = False","                            elif grid[rr, cc] != fg:","                                good = False","                    if good:","                        found = True","                        break","                if not found:","                    matched = False","                    break","            if matched:","                out[r, c] = mark","    return out"],"shapes":{"rule":[5],"axes":[2,2],"signs":[2]},"params":{"rule":[8,1,4,2,1],"axes":[[1,0],[0,1]],"signs":[-1,1]},"rationale":"Mark background cells yellow where two vertical blue dominoes lie symmetrically above and below, and two horizontal blue dominoes lie symmetrically left and right. Horizontal and vertical distances may differ. The tensors encode colors, domino spacing, minimum distance, axes, and opposing directions."}]