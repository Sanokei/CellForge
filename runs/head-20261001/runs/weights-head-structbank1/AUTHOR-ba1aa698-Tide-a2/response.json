[{"task_id":"ba1aa698","source_lines":["def run(params, grid, demos):","    edge = int(round(params['motion'][0]))","    axis = int(round(params['motion'][1]))","    advance = int(round(params['motion'][2]))","    settle = int(round(params['motion'][3]))","    margin = int(round(params['motion'][4]))","    if edge <= 0 or axis != 0:","        return grid.copy()","    border = int(grid[0, 0])","    walls = np.where(np.all(grid == border, axis=axis))[0]","    if len(walls) < 3:","        return grid.copy()","    left = int(walls[0])","    right = int(walls[1])","    panel = grid[:, left:right + edge].copy()","    interior = panel[edge:-edge, edge:-edge]","    if interior.size == 0:","        return grid.copy()","    background = int(np.argmax(np.bincount(interior.flatten())))","    objects = []","    for k in range(len(walls) - 1):","        a = int(walls[k])","        b = int(walls[k + 1])","        block = grid[edge:-edge, a + edge:b]","        points = np.argwhere(block != background)","        if len(points) == 0:","            return grid.copy()","        top = int(np.min(points[:, 0])) + edge","        bottom = int(np.max(points[:, 0])) + edge","        x0 = int(np.min(points[:, 1])) + edge","        x1 = int(np.max(points[:, 1])) + edge","        objects.append((top, bottom, x0, x1))","    first = objects[0]","    last = objects[-1]","    velocity = objects[1][0] - first[0]","    target = last[0] + advance * velocity","    height = first[1] - first[0] + edge","    limit = grid.shape[0] - edge - margin - height","    if velocity > 0 and settle > 0 and limit - target <= settle * height:","        target = limit","    target = max(edge, min(limit, target))","    panel[edge:-edge, edge:-edge] = background","    sprite = grid[first[0]:first[1] + edge, left + first[2]:left + first[3] + edge]","    panel[target:target + height, first[2]:first[3] + edge] = sprite","    return panel"],"shapes":{"motion":[5]},"params":{"motion":[1,0,1,1,1]},"rationale":"Read the panels as successive frames, preserve the sprite, and extrapolate its vertical displacement into one output panel. A descending sprite near the bottom settles with one background row above the border, correcting the previous attempt's bottom placement."}]