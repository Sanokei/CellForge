[{"task_id":"9caf5b84","source_lines":["def run(params, grid, demos):","    replacement = int(round(params['rule'][0]))","    keep_count = int(round(params['rule'][1]))","    values, counts = np.unique(grid, return_counts=True)","    out = np.full(grid.shape, replacement, dtype=int)","    for step in range(min(max(keep_count, 0), len(values))):","        index = int(np.argmax(counts))","        color = values[index]","        out[grid == color] = color","        counts[index] = -1","    return out"],"shapes":{"rule":[2]},"params":{"rule":[7,2]},"rationale":"Preserve the two most frequent input colors and replace every other color with 7."}]