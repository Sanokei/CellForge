[{"task_id":"f0f8a26d","source_lines":["def run(params, grid, demos):","    bg = int(round(params['background'][0]))","    divisor = max(1, int(round(params['center'][0])))","    directions = []","    for row in params['neighbors']:","        directions.append((int(round(row[0])), int(round(row[1]))))","    rotation = []","    for row in params['rotation']:","        rotation.append((int(round(row[0])), int(round(row[1]))))","    height, width = grid.shape","    result = np.full(grid.shape, bg)","    seen = set()","    for r in range(height):","        for c in range(width):","            if grid[r, c] == bg or (r, c) in seen:","                continue","            color = int(grid[r, c])","            pending = [(r, c)]","            seen.add((r, c))","            component = []","            while pending:","                a, b = pending.pop()","                component.append((a, b))","                for dr, dc in directions:","                    nr, nc = a + dr, b + dc","                    if 0 <= nr < height and 0 <= nc < width:","                        if (nr, nc) not in seen and grid[nr, nc] == color:","                            seen.add((nr, nc))","                            pending.append((nr, nc))","            rows = [point[0] for point in component]","            cols = [point[1] for point in component]","            cr = (min(rows) + max(rows)) // divisor","            cc = (min(cols) + max(cols)) // divisor","            for a, b in component:","                dr, dc = a - cr, b - cc","                nr = cr + rotation[0][0] * dr + rotation[0][1] * dc","                nc = cc + rotation[1][0] * dr + rotation[1][1] * dc","                if 0 <= nr < height and 0 <= nc < width:","                    result[nr, nc] = color","    return result"],"shapes":{"background":[1],"center":[1],"neighbors":[4,2],"rotation":[2,2]},"params":{"background":[7],"center":[2],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]],"rotation":[[0,-1],[1,0]]},"rationale":"Rotate each connected foreground segment by 90 degrees around its own midpoint. Single pixels remain fixed; rotated segments may touch or overlap. The tensors specify the background, midpoint divisor, connectivity, and rotation."}]