[{"task_id":"a740d043","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    replacement = int(round(params['rule'][1]))","    inclusive = int(round(params['rule'][2]))","    points = np.argwhere(grid != background)","    if len(points) == 0:","        return grid.copy()","    low = np.min(points, axis=0)","    high = np.max(points, axis=0)","    cropped = grid[low[0]:high[0] + inclusive, low[1]:high[1] + inclusive].copy()","    return np.where(cropped == background, replacement, cropped)"],"shapes":{"rule":[3]},"params":{"rule":[1,0,1]},"rationale":"Crop to the bounding rectangle of all cells whose color differs from background 1, then replace background cells inside that rectangle with 0. Preserve all other colors."}]