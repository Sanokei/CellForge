[{"task_id":"52364a65","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    width = max(0, int(round(params['rule'][1])))","    axis = int(round(params['rule'][2])) % len(grid.shape)","    result = grid.copy()","    for color in np.unique(grid):","        if color == background:","            continue","        positions = np.argwhere(grid == color)","        start = np.min(positions[:, axis])","        for position in positions:","            if position[axis] < start + width:","                result[tuple(position)] = background","    return result"],"shapes":{"rule":[3]},"params":{"rule":[8,2,1]},"rationale":"For each non-background color, erase the first two columns of its bounding box. Background is 8; the tensor specifies the removal width and column axis. This reproduces both demonstrations, including complete removal of objects only two columns wide."}]