[{"task_id":"dc2aa30b","source_lines":["def run(params, grid, demos):","    colour = int(round(params['rule'][0]))","    size = int(round(params['rule'][1]))","    gap = int(round(params['rule'][2]))","    direction = int(round(params['rule'][3]))","    unit = int(round(params['rule'][4]))","    background = int(round(params['rule'][5]))","    stride = size + gap","    if size <= 0 or stride <= 0 or unit != 1:","        return np.full(grid.shape, background)","    height, width = grid.shape","    rows = (height + gap) // stride","    cols = (width + gap) // stride","    blocks = []","    order = []","    for r in range(rows):","        for c in range(cols):","            block = grid[r * stride:r * stride + size, c * stride:c * stride + size].copy()","            index = len(blocks)","            blocks.append(block)","            order.append((int(np.count_nonzero(block == colour)), index))","    order.sort()","    result = grid.copy()","    for r in range(rows):","        for c in range(cols):","            position = c","            if direction < 0:","                position = cols - unit - c","            index = order[r * cols + position][1]","            result[r * stride:r * stride + size, c * stride:c * stride + size] = blocks[index]","    return result"],"shapes":{"rule":[6]},"params":{"rule":[2,3,1,-1,1,0]},"rationale":"Sort the nine intact 3×3 blocks by their number of red cells, ascending across row groups from top to bottom and descending within each row. Preserve the separator lines."}]