[{"task_id":"5ad8a7c0","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    foreground = int(round(params['rule'][1]))","    endpoints = int(round(params['rule'][2]))","    out = grid.copy()","    for r in range(grid.shape[0]):","        positions = np.where(grid[r] == foreground)[0]","        if len(positions) == endpoints and len(positions) > 1:","            left = int(positions[0])","            right = int(positions[-1])","            if np.all(grid[:, left + 1:right] == background):","                out[r, left:right + 1] = foreground","    return out"],"shapes":{"rule":[3]},"params":{"rule":[0,2,2]},"rationale":"Connect each horizontal pair of red endpoints when every column strictly between them contains only background throughout the input. Inner red points block connecting outer pairs. The test's second row becomes [0,2,2,2,2,0]."}]