[{"task_id":"d6e50e54","source_lines":["def run(params, grid, demos):","    blue = int(round(params['colors'][0]))","    red = int(round(params['colors'][1]))","    marker = int(round(params['colors'][2]))","    background = int(round(params['colors'][3]))","    side_offset = int(round(params['geometry'][0]))","    top_offset = int(round(params['geometry'][1]))","    bottom_offset = int(round(params['geometry'][2]))","    near_gap = int(round(params['geometry'][3]))","    near_offset = int(round(params['geometry'][4]))","    out = grid.copy()","    block = np.argwhere(grid == blue)","    if len(block) == 0:","        return out","    rmin = int(np.min(block[:, 0]))","    rmax = int(np.max(block[:, 0]))","    cmin = int(np.min(block[:, 1]))","    cmax = int(np.max(block[:, 1]))","    points = np.argwhere(grid == marker)","    out[grid == blue] = red","    out[grid == marker] = background","    for point in points:","        r = int(point[0])","        c = int(point[1])","        nr = r","        nc = c","        if cmin <= c <= cmax:","            if r < rmin:","                nr = rmin + top_offset","            elif r > rmax:","                if r - rmax - side_offset <= near_gap:","                    nr = rmax + near_offset","                else:","                    nr = rmax + bottom_offset","        elif rmin <= r <= rmax:","            if c < cmin:","                nc = cmin - side_offset","            elif c > cmax:","                nc = cmax + side_offset","        if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:","            out[nr, nc] = marker","    return out"],"shapes":{"colors":[4],"geometry":[5]},"params":{"colors":[1,2,9,7],"geometry":[1,0,1,1,0]},"rationale":"Recolor the blue rectangle red and pull aligned maroon markers toward it. Horizontal markers stop immediately outside; upper markers occupy its top boundary. Lower markers stop outside except markers initially separated by one background cell, which occupy the bottom boundary. These tensor-controlled placements reproduce every demonstration."}]