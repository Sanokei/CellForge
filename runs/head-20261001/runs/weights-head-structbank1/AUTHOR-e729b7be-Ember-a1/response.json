[{"task_id":"e729b7be","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    divider = int(round(params['colors'][1]))","    marker = int(round(params['colors'][2]))","    row_sign = int(round(params['transform'][0]))","    col_sign = int(round(params['transform'][1]))","    side = int(round(params['transform'][2]))","    out = grid.copy()","    counts = np.sum(grid == divider, axis=0)","    if np.max(counts) == 0:","        return out","    center_col = int(np.argmax(counts))","    marked_rows = np.argwhere(grid[:, center_col] == marker)","    if len(marked_rows) == 0:","        return out","    center_row = int(marked_rows[0, 0])","    height, width = grid.shape","    for r in range(height):","        for c in range(width):","            value = int(grid[r, c])","            if (c - center_col) * side < 0 and value != bg and value != divider and value != marker:","                rr = center_row + row_sign * (r - center_row)","                cc = center_col + col_sign * (c - center_col)","                if 0 <= rr < height and 0 <= cc < width:","                    out[rr, cc] = value","    return out"],"shapes":{"colors":[3],"transform":[3]},"params":{"colors":[7,4,8],"transform":[-1,-1,1]},"rationale":"Preserve the input and copy the object across the divider by a 180-degree rotation about its intersection with the marker row. The tensors specify background, divider, marker, both reflection signs, and source side."}]