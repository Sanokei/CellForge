[{"task_id":"62ab2642","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    small_color = int(round(params['colors'][1]))","    large_color = int(round(params['colors'][2]))","    directions = [(int(round(pair[0])), int(round(pair[1]))) for pair in params['directions']]","    height, width = grid.shape","    seen = set()","    components = []","    for row in range(height):","        for col in range(width):","            if grid[row, col] != background or (row, col) in seen:","                continue","            component = [(row, col)]","            seen.add((row, col))","            position = 0","            while position < len(component):","                current_row, current_col = component[position]","                position += 1","                for dr, dc in directions:","                    next_row = current_row + dr","                    next_col = current_col + dc","                    if 0 <= next_row < height and 0 <= next_col < width:","                        if grid[next_row, next_col] == background and (next_row, next_col) not in seen:","                            seen.add((next_row, next_col))","                            component.append((next_row, next_col))","            components.append(component)","    result = grid.copy()","    if len(components) == 0:","        return result","    sizes = np.array([len(component) for component in components])","    smallest = np.min(sizes)","    largest = np.max(sizes)","    for component in components:","        if len(component) == smallest:","            for row, col in component:","                result[row, col] = small_color","        elif len(component) == largest:","            for row, col in component:","                result[row, col] = large_color","    return result"],"shapes":{"colors":[3],"directions":[4,2]},"params":{"colors":[0,7,8],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Find orthogonally connected background regions. Fill the smallest regions orange (7) and the largest regions azure (8), preserving all other cells. Colors and connectivity offsets are encoded in the tensors."}]