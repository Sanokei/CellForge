[{"task_id":"6430c8c4","source_lines":["def run(params, grid, demos):","    separator = int(round(params['rule'][0]))","    background = int(round(params['rule'][1]))","    marker = int(round(params['rule'][2]))","    gap = int(round(params['rule'][3]))","    rows = np.where(np.all(grid == separator, axis=1))[0]","    if len(rows) != 1:","        return grid.copy()","    split = int(rows[0])","    upper = grid[:split, :]","    lower = grid[split + gap:, :]","    if upper.shape != lower.shape:","        return grid.copy()","    empty = np.logical_and(upper == background, lower == background)","    return np.where(empty, marker, background).astype(int)"],"shapes":{"rule":[4]},"params":{"rule":[4,0,3,1]},"rationale":"Split at the solid yellow separator row and overlay the two panels. Mark a position green exactly when both panels have background there; otherwise leave it background. The tensors encode separator, background, output marker, and separator thickness."}]