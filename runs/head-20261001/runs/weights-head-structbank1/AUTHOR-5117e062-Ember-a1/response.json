[{"task_id":"5117e062","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    marker = int(round(params['colors'][1]))","    seeds = np.argwhere(grid == marker)","    if len(seeds) == 0:","        return grid.copy()","    height, width = grid.shape","    start = (int(seeds[0][0]), int(seeds[0][1]))","    pending = [start]","    visited = set([start])","    offsets = params['neighbors']","    while pending:","        row, col = pending.pop()","        for offset in offsets:","            next_row = row + int(round(offset[0]))","            next_col = col + int(round(offset[1]))","            if 0 <= next_row < height and 0 <= next_col < width:","                point = (next_row, next_col)","                if point not in visited and grid[next_row, next_col] != background:","                    visited.add(point)","                    pending.append(point)","    rows = [point[0] for point in visited]","    cols = [point[1] for point in visited]","    counts = {}","    for row, col in visited:","        color = int(grid[row, col])","        if color != marker and color != background:","            counts[color] = counts.get(color, 0) + 1","    if not counts:","        return grid.copy()","    replacement = max(counts, key=counts.get)","    result = grid[min(rows):max(rows) + 1, min(cols):max(cols) + 1].copy()","    result[result == marker] = replacement","    return result"],"shapes":{"colors":[2],"neighbors":[4,2]},"params":{"colors":[0,8],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Extract the connected non-background object containing the azure marker, crop to its bounding box, and replace azure with the object's dominant color. The test selects the yellow object and produces [[0,7,7],[7,7,7],[0,7,0]]."}]