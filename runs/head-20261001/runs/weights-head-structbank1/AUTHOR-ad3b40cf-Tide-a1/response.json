[{"task_id":"ad3b40cf","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    mirror = int(round(params['rule'][1]))","    reflection_factor = float(params['rule'][2])","    out = grid.copy()","    line = np.argwhere(grid == mirror)","    if len(line) < 2:","        return out","    start = line[0]","    end = line[-1]","    dr = int(end[0] - start[0])","    dc = int(end[1] - start[1])","    nr = dc","    nc = -dr","    denominator = nr * nr + nc * nc","    if denominator == 0:","        return out","    chosen = None","    smallest = None","    for value in np.unique(grid):","        color = int(value)","        if color == background or color == mirror:","            continue","        count = int(np.count_nonzero(grid == color))","        if smallest is None or count < smallest:","            smallest = count","            chosen = color","    if chosen is None:","        return out","    height, width = grid.shape","    for position in np.argwhere(grid == chosen):","        r = int(position[0])","        c = int(position[1])","        distance = ((r - int(start[0])) * nr + (c - int(start[1])) * nc) / denominator","        rr = int(round(r - reflection_factor * distance * nr))","        cc = int(round(c - reflection_factor * distance * nc))","        if 0 <= rr < height and 0 <= cc < width:","            out[rr, cc] = chosen","    return out"],"shapes":{"rule":[3]},"params":{"rule":[8,1,2]},"rationale":"Identify the blue mirror line and reflect every pixel of the least frequent object color across it, preserving the original objects. The tensors encode the background color, mirror color, and geometric reflection multiplier."}]