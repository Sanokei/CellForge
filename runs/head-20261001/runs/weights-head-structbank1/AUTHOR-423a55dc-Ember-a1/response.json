[{"task_id":"423a55dc","source_lines":["def run(params, grid, demos):","    background = int(round(params['transform'][0]))","    slope = int(round(params['transform'][1]))","    out = np.full(grid.shape, background, dtype=int)","    cells = np.argwhere(grid != background)","    if len(cells) == 0:","        return out","    bottom = int(np.max(cells[:, 0]))","    for row, col in cells:","        target = int(col) - slope * (bottom - int(row))","        if 0 <= target < grid.shape[1]:","            out[row, target] = grid[row, col]","    return out"],"shapes":{"transform":[2]},"params":{"transform":[0,1]},"rationale":"Shear the foreground left by one column per row above its bottommost row, keeping rows fixed and clipping pixels that move beyond the left edge. The background and shear rate are encoded in the tensor."}]