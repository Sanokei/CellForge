[{"task_id":"140c817e","source_lines":["def run(params, grid, demos):","    seed = int(round(params['colors'][0]))","    center = int(round(params['colors'][1]))","    corner = int(round(params['colors'][2]))","    horizontal = int(round(params['axes'][0]))","    vertical = int(round(params['axes'][1]))","    offsets = []","    for pair in params['corners']:","        offsets.append((int(round(pair[0])), int(round(pair[1]))))","    out = grid.copy()","    points = np.argwhere(grid == seed)","    h, w = grid.shape","    for r, c in points:","        if horizontal:","            out[r, :] = seed","        if vertical:","            out[:, c] = seed","    for r, c in points:","        for dr, dc in offsets:","            rr = r + dr","            cc = c + dc","            if 0 <= rr < h and 0 <= cc < w:","                out[rr, cc] = corner","    for r, c in points:","        out[r, c] = center","    return out"],"shapes":{"colors":[3],"axes":[2],"corners":[4,2]},"params":{"colors":[1,2,3],"axes":[1,1],"corners":[[-1,-1],[-1,1],[1,-1],[1,1]]},"rationale":"Extend every blue seed across its entire row and column, color its four adjacent diagonal cells green within grid bounds, and recolor the seed red. Preserve the varying background elsewhere."}]