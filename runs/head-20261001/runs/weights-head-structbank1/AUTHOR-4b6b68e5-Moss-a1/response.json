[{"task_id":"4b6b68e5","source_lines":["def run(params, grid, demos):","    bg = int(round(params['settings'][0]))","    limit = int(round(params['settings'][1]))","    directions = [(int(round(pair[0])), int(round(pair[1]))) for pair in params['directions']]","    h, w = grid.shape","    seen = np.zeros((h, w), dtype=bool)","    out = np.full((h, w), bg, dtype=int)","    objects = []","    for r in range(h):","        for c in range(w):","            if seen[r, c] or grid[r, c] == bg:","                continue","            color = int(grid[r, c])","            cells = [(r, c)]","            seen[r, c] = True","            pos = 0","            while pos < len(cells):","                y, x = cells[pos]","                pos += 1","                for dy, dx in directions:","                    yy, xx = y + dy, x + dx","                    if 0 <= yy < h and 0 <= xx < w:","                        if not seen[yy, xx] and grid[yy, xx] == color:","                            seen[yy, xx] = True","                            cells.append((yy, xx))","            if len(cells) >= limit:","                objects.append((color, cells))","    for color, cells in objects:","        wall = np.zeros((h, w), dtype=bool)","        for y, x in cells:","            wall[y, x] = True","            out[y, x] = color","        exterior = np.zeros((h, w), dtype=bool)","        queue = []","        for y in range(h):","            for x in range(w):","                if y == 0 or x == 0 or y == h - 1 or x == w - 1:","                    if not wall[y, x]:","                        exterior[y, x] = True","                        queue.append((y, x))","        pos = 0","        while pos < len(queue):","            y, x = queue[pos]","            pos += 1","            for dy, dx in directions:","                yy, xx = y + dy, x + dx","                if 0 <= yy < h and 0 <= xx < w:","                    if not wall[yy, xx] and not exterior[yy, xx]:","                        exterior[yy, xx] = True","                        queue.append((yy, xx))","        inside = np.logical_and(np.logical_not(wall), np.logical_not(exterior))","        votes = grid[np.logical_and(inside, grid != bg)]","        if votes.size:","            colors, counts = np.unique(votes, return_counts=True)","            winner = int(colors[np.argmax(counts)])","            out[inside] = winner","    return out"],"shapes":{"settings":[2],"directions":[4,2]},"params":{"settings":[0,4],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Preserve connected outline components and remove scattered dots. Flood from the grid edges around each outline to detect enclosed interiors; fill each with its most frequent original dot color. Open outlines remain unfilled. The tensors specify background, minimum outline size, and flood connectivity."}]