[{"task_id":"b9630600","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    fg = int(round(params['colors'][1]))","    inset = int(round(params['geometry'][0]))","    maxgap = int(round(params['geometry'][1]))","    steps = [(int(round(v[0])), int(round(v[1]))) for v in params['neighbors']]","    seen = set()","    boxes = []","    height, width = grid.shape","    for point in np.argwhere(grid == fg):","        start = (int(point[0]), int(point[1]))","        if start in seen:","            continue","        seen.add(start)","        pending = [start]","        rows = []","        cols = []","        while pending:","            r, c = pending.pop()","            rows.append(r)","            cols.append(c)","            for dr, dc in steps:","                nr, nc = r + dr, c + dc","                if 0 <= nr < height and 0 <= nc < width:","                    if (nr, nc) not in seen and grid[nr, nc] == fg:","                        seen.add((nr, nc))","                        pending.append((nr, nc))","        boxes.append(([min(rows), min(cols)], [max(rows), max(cols)]))","    result = grid.copy()","    for value in params['axes']:","        axis = int(round(value)) % len(grid.shape)","        other = 1 - axis","        for alo, ahi in boxes:","            for blo, bhi in boxes:","                if ahi[axis] >= blo[axis]:","                    continue","                begin = ahi[axis]","                end = blo[axis]","                if end - begin - inset > maxgap:","                    continue","                low = max(alo[other], blo[other]) + inset","                high = min(ahi[other], bhi[other]) - inset","                if low > high:","                    continue","                if axis == 0:","                    gap = grid[begin + inset:end, low:high + inset]","                else:","                    gap = grid[low:high + inset, begin + inset:end]","                if np.any(gap == fg):","                    continue","                if axis == 0:","                    result[begin:end + inset, low:high + inset] = bg","                    result[begin:end + inset, low] = fg","                    result[begin:end + inset, high] = fg","                else:","                    result[low:high + inset, begin:end + inset] = bg","                    result[low, begin:end + inset] = fg","                    result[high, begin:end + inset] = fg","    return result"],"shapes":{"colors":[2],"geometry":[2],"neighbors":[4,2],"axes":[2]},"params":{"colors":[0,3],"geometry":[1,7],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]],"axes":[0,1]},"rationale":"Connect nearby hollow green rectangles with hollow corridors spanning their shared interior coordinates. Remove the facing wall interiors and draw the corridor edges. A seven-cell maximum empty gap excludes the distant upper-left to lower-left connection in the second demonstration while retaining every demonstrated corridor."}]