[{"task_id":"5792cb4d","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    endpoint_degree = int(round(params['rule'][1]))","    reverse_step = int(round(params['rule'][2]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    result = grid.copy()","    if reverse_step == 0:","        return result","    cells = set()","    for position in np.argwhere(grid != background):","        cells.add((int(position[0]), int(position[1])))","    endpoints = []","    for cell in sorted(cells):","        degree = 0","        for dr, dc in directions:","            if (cell[0] + dr, cell[1] + dc) in cells:","                degree += 1","        if degree == endpoint_degree:","            endpoints.append(cell)","    if not endpoints:","        return result","    current = endpoints[0]","    visited = set()","    path = []","    while current not in visited:","        visited.add(current)","        path.append(current)","        candidates = []","        for dr, dc in directions:","            neighbor = (current[0] + dr, current[1] + dc)","            if neighbor in cells and neighbor not in visited:","                candidates.append(neighbor)","        if not candidates:","            break","        current = candidates[0]","    values = [int(grid[r, c]) for r, c in path]","    values = values[::reverse_step]","    for cell, value in zip(path, values):","        result[cell[0], cell[1]] = value","    return result"],"shapes":{"rule":[3],"directions":[4,2]},"params":{"rule":[8,1,-1],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"The non-background cells form an orthogonally connected path. Reverse its color sequence while preserving its occupied positions. Tensors specify the background, endpoint degree, reversal direction, and neighbor offsets."}]