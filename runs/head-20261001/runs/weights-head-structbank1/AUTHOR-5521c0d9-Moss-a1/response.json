[{"task_id":"5521c0d9","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    direction = int(round(params['rule'][4]))","    result = np.full(grid.shape, background, dtype=int)","    for value in params['rule'][1:4]:","        color = int(round(value))","        points = np.argwhere(grid == color)","        if len(points) == 0:","            continue","        height = len(np.unique(points[:, 0]))","        displacement = direction * height","        for row, column in points:","            target = row + displacement","            if 0 <= target < grid.shape[0]:","                result[target, column] = color","    return result"],"shapes":{"rule":[5]},"params":{"rule":[0,1,2,4,-1]},"rationale":"Move each colored rectangle upward by its own height, preserving its shape and columns. The genome specifies the background, rectangle colors, and upward direction."}]