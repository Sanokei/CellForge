[{"task_id":"05f2a901","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    moving = int(round(params['colors'][1]))","    target = int(round(params['colors'][2]))","    zero = int(round(params['geometry'][0]))","    spacing = int(round(params['geometry'][1]))","    points = np.argwhere(grid == moving)","    anchors = np.argwhere(grid == target)","    if len(points) == 0 or len(anchors) == 0:","        return grid.copy()","    low = np.min(points, axis=0)","    high = np.max(points, axis=0)","    anchor_low = np.min(anchors, axis=0)","    anchor_high = np.max(anchors, axis=0)","    shift = [zero, zero]","    best_gap = zero","    chosen_axis = zero","    chosen_shift = zero","    for axis in range(2):","        if high[axis] < anchor_low[axis]:","            amount = int(anchor_low[axis] - high[axis] - spacing)","            gap = amount","        elif anchor_high[axis] < low[axis]:","            amount = int(anchor_high[axis] - low[axis] + spacing)","            gap = -amount","        else:","            amount = zero","            gap = zero","        if gap > best_gap:","            best_gap = gap","            chosen_axis = axis","            chosen_shift = amount","    shift[chosen_axis] = chosen_shift","    result = grid.copy()","    result[grid == moving] = background","    for point in points:","        row = int(point[0]) + shift[0]","        col = int(point[1]) + shift[1]","        if zero <= row < grid.shape[0] and zero <= col < grid.shape[1]:","            result[row, col] = moving","    return result"],"shapes":{"colors":[3],"geometry":[2]},"params":{"colors":[0,2,8],"geometry":[0,1]},"rationale":"Translate the red object toward the cyan square along their separating axis until their bounding edges are one cell apart, preserving the object's shape and the square. In the test, the red object moves two columns left."}]