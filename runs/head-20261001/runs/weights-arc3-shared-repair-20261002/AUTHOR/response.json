[{"game":"shared","source_lines":["def candidates(params, frame, avail, roles):","    w = params['w']","    order = params['order']","    result = []","    for i in range(len(order)):","        a = int(order[i])","        if a in avail and a != 6:","            result.append(((a, 0, 0), w[0] / (i + 1)))","    if 6 not in avail:","        return result","    h, width = frame.shape","    counts = np.bincount(frame.reshape(-1), minlength=16)","    background = int(np.argmax(counts))","    seen = np.zeros(frame.shape)","    objects = []","    for point in np.argwhere(frame != background):","        y, x = int(point[0]), int(point[1])","        if seen[y, x] != 0:","            continue","        colour = int(frame[y, x])","        stack = [(y, x)]","        seen[y, x] = 1","        pixels = []","        while len(stack) > 0:","            cy, cx = stack.pop()","            pixels.append((cy, cx))","            for ny, nx in [(cy - 1, cx), (cy + 1, cx), (cy, cx - 1), (cy, cx + 1)]:","                if ny >= 0 and ny < h and nx >= 0 and nx < width:","                    if seen[ny, nx] == 0 and int(frame[ny, nx]) == colour:","                        seen[ny, nx] = 1","                        stack.append((ny, nx))","        size = len(pixels)","        sy = 0","        sx = 0","        for py, px in pixels:","            sy += py","            sx += px","        ty = sy / size","        tx = sx / size","        best = pixels[0]","        distance = h * h + width * width","        for py, px in pixels:","            d = (py - ty) * (py - ty) + (px - tx) * (px - tx)","            if d < distance:","                distance = d","                best = (py, px)","        rarity = 1.0 / (1.0 + counts[colour] / max(1.0, w[1]))","        compact = 1.0 / (1.0 + size / max(1.0, w[2]))","        score = w[3] * rarity + w[4] * compact + w[5] * roles[colour]","        objects.append((score, (6, int(best[1]), int(best[0]))))","    objects.sort(key=lambda item: -item[0])","    limit = max(1, int(abs(w[6])))","    for score, action in objects[:limit]:","        result.append((action, score))","    return result","","def act(params, mem, frame, avail, info):","    w = params['w']","    if 'nodes' not in mem:","        mem['nodes'] = {}","        mem['effects'] = {}","        mem['roles'] = [0.0] * 16","        mem['trail'] = []","    nodes = mem['nodes']","    effects = mem['effects']","    roles = mem['roles']","    level = int(info.get('levels', 0))","    resets = int(info.get('resets', 0))","    key = (level, info.get('key', ''))","    node = nodes.setdefault(key, {'visits': 0, 'tried': {}, 'edges': {}, 'options': []})","    node['visits'] += 1","    if 'previous' in mem:","        previous = mem['previous']","        oldkey, action, oldframe, oldlevel, oldresets = previous","        changed = frame != oldframe","        amount = float(np.sum(changed)) / frame.size","        gain = level > oldlevel","        failed = resets != oldresets","        stat = effects.setdefault(action[0], [0.0, 0.0, 0.0])","        stat[0] += 1","        stat[1] += amount","        stat[2] += float(gain)","        if oldkey in nodes:","            oldnode = nodes[oldkey]","            if not failed and not gain:","                oldnode['edges'][action] = key","            if key == oldkey or failed:","                oldnode['tried'][action] = oldnode['tried'].get(action, 0) + max(0.0, w[7])","        if np.any(changed):","            before = np.bincount(oldframe[changed], minlength=16)","            after = np.bincount(frame[changed], minlength=16)","            for colour in range(len(roles)):","                activity = float(before[colour] + after[colour]) / max(1.0, float(np.sum(changed)) * 2)","                roles[colour] = roles[colour] * w[8] + activity * w[9]","                if gain:","                    roles[colour] += activity * w[10]","        mem['trail'].append((oldkey, action))","        if len(mem['trail']) > max(1, int(abs(w[11]))):","            mem['trail'].pop(0)","        if gain:","            for trailkey, trailaction in mem['trail']:","                learned = effects.setdefault(trailaction[0], [0.0, 0.0, 0.0])","                learned[2] += w[12]","            mem['trail'] = []","    options = candidates(params, frame, avail, roles)","    node['options'] = [action for action, score in options]","    chosen = None","    bestscore = -1000000000.0","    fresh = False","    for action, salience in options:","        attempts = node['tried'].get(action, 0)","        if attempts == 0:","            fresh = True","        destination = node['edges'].get(action)","        visits = nodes[destination]['visits'] if destination in nodes else 0","        stat = effects.get(action[0], [0.0, 0.0, 0.0])","        motion = stat[1] / max(1.0, stat[0])","        success = stat[2] / max(1.0, stat[0])","        score = salience + w[13] / (1.0 + attempts) + w[14] * motion + w[15] * success - w[16] * visits","        if attempts == 0:","            score += w[17]","        if score > bestscore:","            bestscore = score","            chosen = action","    if not fresh and chosen is not None:","        queue = [(key, None, 0)]","        seen = {key}","        position = 0","        limit = max(1, int(abs(w[18])))","        while position < len(queue) and position < limit:","            current, first, depth = queue[position]","            position += 1","            other = nodes[current]","            frontier = False","            for option in other['options']:","                if other['tried'].get(option, 0) == 0:","                    frontier = True","                    break","            if frontier and first is not None:","                chosen = first","                break","            for edge, destination in other['edges'].items():","                if destination in nodes and destination not in seen:","                    if first is None and edge not in node['options']:","                        continue","                    seen.add(destination)","                    queue.append((destination, edge if first is None else first, depth + 1))","    if chosen is None:","        a = avail[0] if len(avail) > 0 else int(params['order'][0])","        chosen = (int(a), int(frame.shape[1] // 2), int(frame.shape[0] // 2))","    node['tried'][chosen] = node['tried'].get(chosen, 0) + 1","    mem['previous'] = (key, chosen, frame.copy(), level, resets)","    return chosen"],"shapes":{"order":[5],"w":[19]},"params":{"order":[1,3,2,4,5],"w":[0.18,80,24,0.7,0.45,0.8,18,2,0.95,0.2,2,12,0.12,2,0.8,3,0.3,4,180]},"rationale":"Runtime repair replaces unavailable str conversions with a tuple of the level integer and existing frame digest. The generic online mechanism and tensors are retained: frame segmentation supplies object clicks, frame differences teach action effects and colour activity, level gains credit recent actions, and bounded graph search routes toward unexplored actions. No game identities or stored solutions are used.","cannot_express":false}]