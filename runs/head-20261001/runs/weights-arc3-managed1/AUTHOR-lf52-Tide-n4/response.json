[{"game":"lf52","source_lines":["def moves(board, triples, blocked):","    out = []","    for a, b, c in triples:","        if board[a] and board[b] and not board[c] and (board, a, c) not in blocked:","            nxt = list(board)","            nxt[a] = 0","            nxt[b] = 0","            nxt[c] = 1","            out.append((tuple(nxt), a, c))","    return out","def search(board, triples, blocked, limit, visits, penalty):","    queue = [board]","    parents = {board: None}","    head = 0","    best = board","    while head < len(queue) and len(parents) < limit:","        state = queue[head]","        head += 1","        if sum(state) < sum(best):","            best = state","        if sum(state) <= 1:","            best = state","            break","        options = moves(state, triples, blocked)","        options.sort(key=lambda v: visits.get(v[0], 0) * penalty - len(moves(v[0], triples, blocked)))","        for nxt, a, c in options:","            if nxt not in parents:","                parents[nxt] = (state, a, c)","                queue.append(nxt)","    path = []","    while parents[best] is not None:","        old, a, c = parents[best]","        path.append((a, c, best))","        best = old","    path.reverse()","    return path","def act(params, mem, frame, avail, info):","    p = params['cfg']","    base, peg, click = int(p[0]), int(p[1]), int(p[2])","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level or mem.get('reset') != reset:","        mem.clear()","        mem['level'] = level","        mem['reset'] = reset","        remaining = set()","        for q in np.argwhere((frame == base) | (frame == peg)):","            y, x = int(q[0]), int(q[1])","            if y >= int(p[3]):","                remaining.add((y, x))","        slots = []","        while remaining:","            seed = min(remaining)","            remaining.remove(seed)","            todo = [seed]","            cells = []","            while todo:","                y, x = todo.pop()","                cells.append((y, x))","                for d in params['dirs']:","                    q = (y + int(d[0]), x + int(d[1]))","                    if q in remaining:","                        remaining.remove(q)","                        todo.append(q)","            if int(p[4]) <= len(cells) <= int(p[5]):","                ys = [q[0] for q in cells]","                xs = [q[1] for q in cells]","                slots.append((min(xs), min(ys), max(xs), max(ys)))","        slots.sort(key=lambda q: (q[1], q[0]))","        mem['slots'] = slots","        centers = [((q[0] + q[2]) // 2, (q[1] + q[3]) // 2) for q in slots]","        index = {q: i for i, q in enumerate(centers)}","        spacing = []","        for x, y in centers:","            for xx, yy in centers:","                if y == yy and xx > x:","                    spacing.append(xx - x)","                if x == xx and yy > y:","                    spacing.append(yy - y)","        stride = min(spacing) if spacing else 0","        triples = []","        for a, q in enumerate(centers):","            x, y = q","            for d in params['dirs']:","                dx, dy = int(d[1]) * stride, int(d[0]) * stride","                middle = (x + dx, y + dy)","                end = (x + int(p[6]) * dx, y + int(p[6]) * dy)","                if middle in index and end in index and index[middle] != a and index[end] != a:","                    triples.append((a, index[middle], index[end]))","        mem['centers'] = centers","        mem['triples'] = triples","        mem['blocked'] = set()","        mem['visits'] = {}","        mem['edges'] = {}","        mem['pairs'] = {}","        mem['plan'] = []","    slots = mem['slots']","    board = tuple(int(np.any(frame[q[1]:q[3]+1, q[0]:q[2]+1] == peg)) for q in slots)","    visits = mem['visits']","    visits[board] = visits.get(board, 0) + 1","    if 'pending' in mem:","        old, a, c, expected = mem.pop('pending')","        mem['edges'][(old, a, c)] = board","        if board == old:","            mem['blocked'].add((old, a, c))","            mem['plan'] = []","        elif board != expected:","            mem['plan'] = []","        else:","            mem['confirmed'] = mem.get('confirmed', 0) + 1","    if click not in avail or not slots:","        for a in params['fallback']:","            if int(a) in avail:","                return (int(a), 0, 0)","        return (avail[0], 0, 0)","    if 'destination' in mem:","        a, c, expected, old = mem.pop('destination')","        mem['pending'] = (old, a, c, expected)","        x, y = mem['centers'][c]","        return (click, x, y)","    if not mem['plan']:","        mem['plan'] = search(board, mem['triples'], mem['blocked'], max(1, int(p[8]) * int(p[9])), visits, float(p[12]))","    if mem['plan']:","        a, c, expected = mem['plan'].pop(0)","    else:","        options = []","        for a, occupied in enumerate(board):","            if not occupied:","                continue","            ax, ay = mem['centers'][a]","            for c, filled in enumerate(board):","                if filled or (board, a, c) in mem['blocked']:","                    continue","                cx, cy = mem['centers'][c]","                known = mem['edges'].get((board, a, c))","                score = float(p[10]) * mem['pairs'].get((board, a, c), 0)","                score += float(p[11]) * (abs(ax - cx) + abs(ay - cy))","                if known is not None:","                    score += float(p[12]) * visits.get(known, 0)","                    score += float(p[13]) * sum(known)","                options.append((score, a, c))","        if not options:","            mem['blocked'].clear()","            for a in params['fallback']:","                if int(a) in avail:","                    return (int(a), 0, 0)","            return (avail[0], 0, 0)","        score, a, c = min(options)","        expected = mem['edges'].get((board, a, c), board)","    pair = (board, a, c)","    mem['pairs'][pair] = mem['pairs'].get(pair, 0) + 1","    mem['destination'] = (a, c, expected, board)","    x, y = mem['centers'][a]","    return (click, x, y)"],"shapes":{"cfg":[14],"dirs":[4,2],"fallback":[5]},"params":{"cfg":[1,14,6,1,12,24,2,1,1000,60,10,0.02,0.1,2],"dirs":[[0,1],[1,0],[0,-1],[-1,0]],"fallback":[1,2,3,4,7]},"rationale":"Extracts board slots and spacing from observed components, then searches jump-and-remove hypotheses over peg occupancy. Executes source and destination clicks as a transaction, compares observed effects with predictions, records transitions, rejects ineffective pairs, and replans. Transfers the donor's abstract-state search and online model validation while replacing permutation models with capture hypotheses suited to the visible sparse board. Tensor shapes and all 27 finite entries were validated within bounds.","cannot_express":false}]