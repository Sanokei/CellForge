[{"game":"vc33","source_lines":["def blobs(frame, colours, start):","    seen = np.zeros(frame.shape, dtype=bool)","    result = []","    for y in range(start, frame.shape[0]):","        for x in range(frame.shape[1]):","            c = int(frame[y, x])","            if seen[y, x] or c not in colours:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                yy, xx = todo.pop()","                cells.append((yy, xx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = yy + dy, xx + dx","                    if start <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:","                        seen[ny, nx] = True","                        todo.append((ny, nx))","            result.append((c, sum(v[1] for v in cells) / len(cells), sum(v[0] for v in cells) / len(cells), len(cells)))","    return result","def describe(frame, p):","    rail = np.argwhere(frame == int(p[0]))","    actor = np.argwhere(frame == int(p[1]))","    if len(rail) == 0 or len(actor) == 0:","        return (), [], 0.0","    rows = np.bincount(rail[:, 0], minlength=frame.shape[0])","    cols = np.bincount(rail[:, 1], minlength=frame.shape[1])","    vertical = int(np.max(cols) > np.max(rows))","    counts = cols if vertical else rows","    bands = []","    for i in range(len(counts)):","        if counts[i] >= p[5]:","            if bands and i == bands[-1][-1] + 1:","                bands[-1].append(i)","            else:","                bands.append([i])","    ax = float(np.sum(actor[:, 1])) / len(actor)","    ay = float(np.sum(actor[:, 0])) / len(actor)","    progress = ax if vertical else ay","    cross = ay if vertical else ax","    markers = []","    for band in bands:","        mask = np.zeros(frame.shape, dtype=bool)","        if vertical:","            mask[:, band[0]:band[-1] + 1] = True","        else:","            mask[band[0]:band[-1] + 1, :] = True","        points = np.argwhere(mask & (frame == int(p[2])))","        if len(points) == 0:","            points = np.argwhere(mask & ((frame == int(p[3])) | (frame == int(p[4]))))","        if len(points):","            location = float(np.sum(points[:, 0 if vertical else 1])) / len(points)","            markers.append((sum(band) / len(band), location))","    markers.sort()","    feature = [progress, cross]","    for position, location in markers:","        feature.extend([position, location])","    return tuple(feature), markers, vertical","def loss(feature, p):","    if len(feature) < 4:","        return 0.0","    progress, cross = feature[:2]","    score = -p[6] * progress","    previous = cross","    distance = 0","    for i in range(2, len(feature), 2):","        position, location = feature[i:i + 2]","        if position + p[7] < progress:","            continue","        score += p[8] * abs(location - previous) / (1 + p[9] * distance)","        previous = location","        distance += 1","    return score","def act(params, mem, frame, avail, info):","    p = params['geometry']","    q = params['search']","    weights = params['colours']","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level:","        mem.clear()","        mem.update({'level': level, 'reset': reset, 'edges': {}, 'actions': {}, 'visits': {}, 'trials': {}, 'models': {}, 'effects': {}})","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('last', None)","    state = tuple(int(v) for v in frame[int(q[0]):, :].flatten())","    feature, markers, vertical = describe(frame, p)","    objects = blobs(frame, [i for i in range(len(weights)) if weights[i] > 0], int(q[0]))","    candidates = []","    for c, x, y, area in objects:","        if area <= q[1]:","            candidates.append((c, int(x), int(y)))","    if not candidates:","        return (avail[0], int(q[2]), int(q[3]))","    mem['actions'][state] = candidates","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, action, before = mem['last']","        mem['edges'].setdefault(old, {})[action] = state","        effect = mem['effects'].setdefault(action, [0, 0])","        effect[1] += 1","        if old != state:","            effect[0] += 1","            if len(before) == len(feature):","                delta = tuple(feature[i] - before[i] for i in range(len(feature)))","                mem['models'][action] = delta","        else:","            mem['models'].pop(action, None)","    next_position = None","    if feature:","        forward = [position for position, location in markers if position + p[7] >= feature[0]]","        if forward:","            next_position = min(forward)","    choices = []","    for action in candidates:","        c, x, y = action","        tried = mem['trials'].get((state, action), 0)","        successes, attempts = mem['effects'].get(action, [0, 0])","        value = -q[4] * weights[c] + q[5] * tried","        value += q[6] * (attempts - successes) / max(1, attempts)","        if attempts == 0:","            value -= q[7]","        if next_position is not None and c == int(p[10]):","            coordinate = x if vertical else y","            value += q[8] * abs(coordinate - next_position)","        delta = mem['models'].get(action)","        if delta is not None and len(delta) == len(feature):","            prediction = tuple(feature[i] + delta[i] for i in range(len(feature)))","            value += q[9] * (loss(prediction, p) - loss(feature, p))","        destination = mem['edges'].get(state, {}).get(action)","        if destination == state:","            value += q[10]","        elif destination is not None:","            value += q[11] * visits.get(destination, 0)","        choices.append((value, action))","    choices.sort(key=lambda item: (item[0], item[1]))","    action = choices[0][1]","    if all(mem['trials'].get((state, a), 0) > 0 for a in candidates):","        queue = [(state, None)]","        seen = {state}","        index = 0","        route = None","        while index < len(queue) and index < int(q[12]):","            node, first = queue[index]","            index += 1","            local = mem['actions'].get(node, [])","            if node != state and any(mem['trials'].get((node, a), 0) == 0 for a in local if a[0] == int(p[10])):","                route = first","                break","            for a, destination in mem['edges'].get(node, {}).items():","                if destination not in seen and destination != node:","                    seen.add(destination)","                    queue.append((destination, a if first is None else first))","        if route is not None and route in candidates:","            action = route","    mem['trials'][(state, action)] = mem['trials'].get((state, action), 0) + 1","    mem['last'] = (state, action, feature)","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)"],"shapes":{"geometry":[11],"search":[13],"colours":[16]},"params":{"geometry":[5,4,11,1,14,10,3,3,1,0.8,9],"search":[1,256,32,32,5,45,25,9,0.7,7,500,65,900],"colours":[0,0,0,0,0.15,0.1,0,0,0,5,0,0.2,0,0,0.2,0.2]},"rationale":"Retains component clicks and transition learning from the credited policy, but replaces nearest-pair alignment with ordered rail geometry anchored to the visible agent. Includes colour-1 rail segments, prioritizes the next crossing, learns click displacement from settled frames, and predicts alignment and forward progress. State-action penalties and BFS over recorded transitions seek untried controls; the graph persists across resets within a level. This targets the first unsolved level's multiple vertical rails rather than aligning only the two colour-11 components.","cannot_express":false}]