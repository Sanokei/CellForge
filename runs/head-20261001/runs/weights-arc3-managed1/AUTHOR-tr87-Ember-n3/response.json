[{"game":"tr87","source_lines":["def glyph(frame, y, x, size, ink):","    return tuple(int(frame[y+r, x+c] == ink) for r in range(size) for c in range(size))","","def predict(source, pairs, library, cfg):","    for left, right in pairs:","        if source == left:","            return right","    n = len(library)","    indices = {g:i for i,g in enumerate(library)}","    known = [(indices[a], indices[b]) for a,b in pairs if a in indices and b in indices]","    if source in indices and n > 1 and len(known) >= int(cfg[0]):","        candidates = []","        for multiplier in range(n):","            for offset in range(n):","                score = sum(int((a*multiplier+offset)%n == b) for a,b in known)","                candidates.append((score, multiplier, offset))","        best = max(candidates)","        if best[0] == len(known):","            return library[(indices[source]*best[1]+best[2])%n]","    width = len(source)","    result = []","    for output in range(width):","        desired = tuple(b[output] for a,b in pairs)","        choices = []","        for position in range(width):","            signature = tuple(a[position] for a,b in pairs)","            for inversion in range(2):","                error = sum(int((v ^ inversion) != t) for v,t in zip(signature,desired))","                choices.append((error, int(cfg[1])*abs(position-output)+inversion, source[position]^inversion))","        best = min(choices)","        if best[0] > 0:","            for first in range(width):","                for second in range(first+1,width):","                    for inversion in range(2):","                        error = sum(int((a[first]^a[second]^inversion) != b[output]) for a,b in pairs)","                        candidate = (error, int(cfg[2])+abs(first-output)+abs(second-output)+inversion, source[first]^source[second]^inversion)","                        if candidate < best:","                            best = candidate","        result.append(best[2])","    return tuple(result)","","def path_to(graph, start, target, actions):","    queue = [(start, [])]","    seen = {start}","    for node,path in queue:","        if node == target:","            return path","        for action in actions:","            nxt = graph.get(node, {}).get(action)","            if nxt is not None and nxt not in seen:","                seen.add(nxt)","                queue.append((nxt,path+[action]))","    return None","","def act(params, mem, frame, avail, info):","    g = params['geometry']","    size = max(1,min(8,int(g[0])))","    count = max(1,min(8,int(g[1])))","    stride = max(1,int(g[2]))","    sx,sy,oy,low,high = [max(0,min(63,int(v))) for v in g[3:]]","    ink = int(params['colours'][0])","    cursor_ink = int(params['colours'][1])","    actions = [int(v) for v in params['actions'] if int(v) in avail]","    if not actions:","        return (avail[0],0,0)","    cycle = actions[:2]","    moves = actions[2:]","    stamp = (info['levels'],info['resets'])","    if mem.get('stamp') != stamp:","        mem['stamp'] = stamp","        mem['previous'] = None","        mem['visits'] = {}","        mem['cursor'] = 0","        mem['probe'] = 0","        if 'library' not in mem:","            mem['library'] = []","            mem['graph'] = {}","            mem['directions'] = {}","            mem['closed'] = False","    sources = [glyph(frame,sy,min(64-size,sx+i*stride),size,ink) for i in range(count)]","    outputs = [glyph(frame,oy,min(64-size,sx+i*stride),size,ink) for i in range(count)]","    pairs = []","    for row in params['rows']:","        for cols in params['columns']:","            y = max(0,min(64-size,int(row)))","            x1 = max(0,min(64-size,int(cols[0])))","            x2 = max(0,min(64-size,int(cols[1])))","            pairs.append((glyph(frame,y,x1,size,ink),glyph(frame,y,x2,size,ink)))","    points = np.argwhere(frame[low:high+1,:] == cursor_ink)","    cursor = mem['cursor']","    if len(points):","        center = float(np.sum(points[:,1]))/len(points)","        cursor = max(0,min(count-1,int((center-sx-(size-1)/2)/stride+float(params['settings'][3]))))","    previous = mem.get('previous')","    graph = mem['graph']","    library = mem['library']","    if previous is not None:","        old_cursor,old_glyph,old_action = previous","        if old_action in cycle and old_cursor == cursor:","            new_glyph = outputs[cursor]","            graph.setdefault(old_glyph,{})[old_action] = new_glyph","            if old_action == cycle[0] and not mem['closed']:","                if not library:","                    library.append(old_glyph)","                if new_glyph == library[0] and len(library)>1:","                    mem['closed'] = True","                elif new_glyph not in library:","                    library.append(new_glyph)","        if old_action in moves and cursor != old_cursor:","            delta = (cursor-old_cursor)%count","            mem['directions'][old_action] = 1 if delta == 1 else -1","    targets = [predict(source,pairs,library if mem['closed'] else [],params['inference']) for source in sources]","    key = (cursor,tuple(outputs))","    visits = mem['visits'].setdefault(key,{})","    action = None","    if not mem['closed'] and len(library)<int(params['settings'][0]):","        action = cycle[0]","    else:","        wrong = [i for i in range(count) if outputs[i] != targets[i]]","        if cursor in wrong:","            path = path_to(graph,outputs[cursor],targets[cursor],cycle)","            if path:","                action = path[0]","            else:","                ranked = [(visits.get(a,0),len(graph.get(outputs[cursor],{})),j,a) for j,a in enumerate(cycle)]","                action = min(ranked)[3]","                if visits.get(action,0)>=int(params['settings'][1]) and moves:","                    action = moves[0]","        elif wrong and moves:","            choices = []","            for j,a in enumerate(moves):","                direction = mem['directions'].get(a,int(params['directions'][j%len(params['directions'])]))","                distance = min(((i-cursor)*direction)%count for i in wrong)","                choices.append((distance,visits.get(a,0),j,a))","            action = min(choices)[3]","        else:","            action = min((visits.get(a,0),j,a) for j,a in enumerate(actions))[2]","    if action is None:","        action = actions[0]","    visits[action] = visits.get(action,0)+1","    mem['cursor'] = cursor","    mem['previous'] = (cursor,outputs[cursor],action)","    return (action,0,0)"],"shapes":{"geometry":[8],"colours":[2],"actions":[4],"rows":[3],"columns":[2,2],"directions":[2],"settings":[4],"inference":[3]},"params":{"geometry":[5,5,7,15,41,52,48,62],"colours":[5,0],"actions":[1,2,3,4],"rows":[5,14,23],"columns":[[13,22],[35,44]],"directions":[-1,1],"settings":[40,3,2,0.5],"inference":[3,1,30]},"rationale":"Learns the glyph cycle and action transitions from observed changes, preserves that knowledge across resets, and infers the demonstrated substitution using exact examples, modular arithmetic over the learned alphabet, or pixel relations. It then routes each selected output toward its inferred target, with bounded exploration when a target is unreachable. Unlike the previous nearest-example policy, it can extrapolate to source glyphs absent from the demonstrations.","cannot_express":false}]