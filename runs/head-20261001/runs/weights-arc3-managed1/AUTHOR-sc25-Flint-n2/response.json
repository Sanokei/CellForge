[{"game":"sc25","source_lines":["def groups(mask):","    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))","    result = []","    while remaining:","        point = next(iter(remaining))","        remaining.remove(point)","        todo = [point]","        cells = [point]","        while todo:","            r, c = todo.pop()","            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):","                if q in remaining:","                    remaining.remove(q)","                    todo.append(q)","                    cells.append(q)","        r = sum(p[0] for p in cells) / len(cells)","        c = sum(p[1] for p in cells) / len(cells)","        near = min(cells, key=lambda p: abs(p[0] - r) + abs(p[1] - c))","        result.append((r, c, len(cells), near[0], near[1]))","    return result","def legacy(params, mem, frame, avail, info):","    cfg = params['config']","    colours = params['colours']","    bounds = int(cfg[0])","    width = int(cfg[1])","    mask = (frame == int(colours[0])) | (frame == int(colours[1]))","    mask[bounds:, :] = False","    mask[:, width:] = False","    objects = groups(mask)","    objects.sort(key=lambda p: p[2])","    agent = objects[0] if objects else None","    goal = objects[-1] if len(objects) > 1 else None","    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:","        motion = mem.get('motion', {})","        mem.clear()","        mem['motion'] = motion","        mem['level'] = info['levels']","        mem['reset'] = info['resets']","        mem['visits'] = {}","        mem['blocked'] = {}","        mem['effects'] = {}","        mem['stuck'] = 0","    signature = tuple(int(v) for v in frame[:bounds, :width].flatten())","    old = mem.get('previous')","    if old is not None:","        oldsig, identity, oldagent, oldframe = old","        delta = np.argwhere(frame[:, :width] != oldframe[:, :width])","        meaningful = any(int(p[0]) < bounds for p in delta)","        if signature == oldsig:","            pair = (oldsig, identity)","            mem['blocked'][pair] = mem['blocked'].get(pair, 0) + 1","            mem['stuck'] += 1","        else:","            mem['stuck'] = 0","        if identity[0] == 'key' and agent is not None and oldagent is not None:","            dr = agent[0] - oldagent[0]","            dc = agent[1] - oldagent[1]","            if abs(dr) + abs(dc) >= cfg[2] and abs(dr) + abs(dc) <= cfg[3]:","                mem['motion'][identity[1]] = (dr, dc)","        if identity[0] == 'click':","            changes = len(delta)","            previous_effect = mem['effects'].get(identity, 0)","            mem['effects'][identity] = max(previous_effect, changes if meaningful else changes * cfg[4])","    visits = mem['visits'].setdefault(signature, {})","    candidates = []","    for i in range(len(params['order'])):","        action = int(params['order'][i])","        if action not in avail:","            continue","        identity = ('key', action)","        score = cfg[5] - i * cfg[6]","        dr, dc = mem['motion'].get(action, (params['directions'][i][0], params['directions'][i][1]))","        if agent is not None and goal is not None:","            before = abs(agent[0] - goal[0]) + abs(agent[1] - goal[1])","            after = abs(agent[0] + dr - goal[0]) + abs(agent[1] + dc - goal[1])","            score += cfg[7] * (before - after)","            r = max(0, min(frame.shape[0] - 1, int(round(agent[0] + dr))))","            c = max(0, min(frame.shape[1] - 1, int(round(agent[1] + dc))))","            if int(frame[r, c]) == int(colours[2]):","                score += cfg[8]","            elif int(frame[r, c]) == int(colours[3]):","                score -= cfg[9]","        candidates.append((score, identity, action, 0, 0))","    click = int(cfg[10])","    if click in avail:","        for colour in params['click_colours']:","            for obj in groups(frame == int(colour)):","                r, c, area, pr, pc = obj","                if r >= cfg[11] and area <= cfg[12] and c < width:","                    identity = ('click', int(colour), int(round(r)), int(round(c)))","                    score = cfg[13] + min(cfg[14], mem['stuck']) * cfg[15]","                    score += min(cfg[16], mem['effects'].get(identity, 0)) * cfg[17]","                    candidates.append((score, identity, click, pc, pr))","        if agent is not None:","            identity = ('click', 'agent', int(round(agent[0])), int(round(agent[1])))","            candidates.append((cfg[18], identity, click, agent[4], agent[3]))","        if goal is not None:","            identity = ('click', 'goal', int(round(goal[0])), int(round(goal[1])))","            candidates.append((cfg[18], identity, click, goal[4], goal[3]))","    best = None","    bestscore = -1000000","    for score, identity, action, x, y in candidates:","        count = visits.get(identity, 0)","        failures = mem['blocked'].get((signature, identity), 0)","        score -= cfg[19] * count","        score -= cfg[20] * max(0, failures - cfg[21])","        if old is not None and identity == old[1] and signature != old[0]:","            score += cfg[22]","        if score > bestscore:","            bestscore = score","            best = (identity, action, x, y)","    if best is None:","        best = (('fallback', avail[0]), avail[0], 0, 0)","    identity, action, x, y = best","    visits[identity] = visits.get(identity, 0) + 1","    mem['previous'] = (signature, identity, agent, frame.copy())","    return (action, max(0, min(frame.shape[1] - 1, int(x))), max(0, min(frame.shape[0] - 1, int(y))))","def act(params, mem, frame, avail, info):","    cfg = params['route']","    if info['levels'] < int(cfg[0]):","        return legacy(params, mem, frame, avail, info)","    h = max(1, min(frame.shape[0], int(params['config'][0])))","    w = max(1, min(frame.shape[1], int(params['config'][1])))","    colours = params['colours']","    objects = groups((frame[:h, :w] == int(colours[0])) | (frame[:h, :w] == int(colours[1])))","    objects.sort(key=lambda p: p[2])","    agent = objects[0] if objects else None","    goal = objects[-1] if len(objects) > 1 else None","    state = tuple(int(v) for v in frame[:, :w].flatten())","    if mem.get('route_level') != info['levels']:","        mem.clear()","        mem['route_level'] = info['levels']","        mem['seen'] = {}","        mem['fail'] = {}","        mem['moves'] = {}","        mem['idle'] = 0","        mem['click_effect'] = {}","    old = mem.get('last')","    moved = False","    if old is not None and old[4] == info['resets']:","        oldstate, identity, oldagent, oldframe, reset = old","        if agent is not None and oldagent is not None:","            dr = agent[0] - oldagent[0]","            dc = agent[1] - oldagent[1]","            moved = abs(dr) + abs(dc) >= cfg[1]","            if moved and identity[0] == 'key' and abs(dr) + abs(dc) <= cfg[2]:","                mem['moves'][identity[1]] = (dr, dc)","        if not moved:","            mem['idle'] += 1","        else:","            mem['idle'] = 0","        if state == oldstate:","            pair = (oldstate, identity)","            mem['fail'][pair] = mem['fail'].get(pair, 0) + 1","        if identity[0] == 'click':","            changed = int(np.sum(frame[:h, :w] != oldframe[:h, :w]))","            mem['click_effect'][identity] = max(mem['click_effect'].get(identity, 0), changed)","    visits = mem['seen'].setdefault(state, {})","    target = goal","    gates = np.any(frame[:h, :w] == int(params['special'][1]))","    keys = groups(frame[:h, :w] == int(params['special'][0]))","    if gates and keys:","        keys.sort(key=lambda p: p[2], reverse=True)","        target = keys[0]","    board = frame[:h, :w]","    walk = (board == int(colours[2])) | (board == int(colours[0])) | (board == int(colours[1]))","    for colour in params['special']:","        walk = walk | (board == int(colour))","    distance = np.zeros((h, w)) + cfg[3]","    if target is not None:","        tr = max(0, min(h - 1, int(round(target[0]))))","        tc = max(0, min(w - 1, int(round(target[1]))))","        distance[tr, tc] = 0","        queue = [(tr, tc)]","        position = 0","        while position < len(queue):","            r, c = queue[position]","            position += 1","            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):","                if 0 <= nr < h and 0 <= nc < w and walk[nr, nc] and distance[nr, nc] > distance[r, c] + 1:","                    distance[nr, nc] = distance[r, c] + 1","                    queue.append((nr, nc))","    candidates = []","    for i in range(len(params['order'])):","        action = int(params['order'][i])","        if action not in avail:","            continue","        identity = ('key', action)","        score = cfg[4] - i * cfg[5]","        if agent is not None and target is not None:","            dr, dc = mem['moves'].get(action, (params['directions'][i][0], params['directions'][i][1]))","            r = max(0, min(h - 1, int(round(agent[0]))))","            c = max(0, min(w - 1, int(round(agent[1]))))","            nr = max(0, min(h - 1, int(round(agent[0] + dr))))","            nc = max(0, min(w - 1, int(round(agent[1] + dc))))","            if distance[r, c] < cfg[3] and distance[nr, nc] < cfg[3]:","                score += cfg[6] * (distance[r, c] - distance[nr, nc])","            else:","                before = abs(agent[0] - target[0]) + abs(agent[1] - target[1])","                after = abs(agent[0] + dr - target[0]) + abs(agent[1] + dc - target[1])","                score += cfg[7] * (before - after)","            if not walk[nr, nc]:","                score -= cfg[8]","            if gates and keys and int(board[nr, nc]) == int(params['special'][1]):","                score -= cfg[9]","        if old is not None and old[1] == identity and old[4] == info['resets']:","            if mem['idle'] <= cfg[10]:","                score += cfg[11]","        candidates.append((score, identity, action, 0, 0))","    click = int(params['config'][10])","    if click in avail and mem['idle'] >= cfg[12]:","        for point in params['buttons']:","            x = max(0, min(frame.shape[1] - 1, int(point[0])))","            y = max(0, min(frame.shape[0] - 1, int(point[1])))","            if int(frame[y, x]) == int(colours[3]):","                continue","            identity = ('click', x, y)","            score = cfg[13] + min(cfg[14], mem['idle']) * cfg[15]","            score += min(cfg[16], mem['click_effect'].get(identity, 0)) * cfg[17]","            candidates.append((score, identity, click, x, y))","    best = None","    bestscore = -1000000","    for score, identity, action, x, y in candidates:","        score -= cfg[18] * visits.get(identity, 0)","        score -= cfg[19] * max(0, mem['fail'].get((state, identity), 0) - cfg[20])","        if score > bestscore:","            bestscore = score","            best = (identity, action, x, y)","    if best is None:","        best = (('key', avail[0]), avail[0], 0, 0)","    identity, action, x, y = best","    visits[identity] = visits.get(identity, 0) + 1","    mem['last'] = (state, identity, agent, frame.copy(), info['resets'])","    return (action, int(x), int(y))"],"shapes":{"config":[23],"colours":[4],"order":[4],"directions":[4,2],"click_colours":[3],"route":[21],"special":[3],"buttons":[13,2]},"params":{"config":[45,62,1,20,0.05,8,0.5,5,8,6,6,46,80,-12,12,3,40,0.2,-16,9,24,1,3],"colours":[9,10,2,5],"order":[3,1,2,4],"directions":[[0,-4],[-4,0],[4,0],[0,4]],"click_colours":[0,2,15],"route":[2,1,20,1000,10,0.3,6,2,25,45,2,18,5,-8,15,3,40,0.1,14,35,1],"special":[6,13,4],"buttons":[[25,50],[30,50],[35,50],[25,55],[30,55],[35,55],[25,60],[30,60],[35,60],[15,52],[13,55],[17,55],[15,58]]},"rationale":"Preserves the credited solver for the first two levels. From the first unsolved level onward, replaces direct goal attraction with frame-derived floor routing and a conditional key-before-gate rule: when colour 13 and a colour 6 object coexist, seek the latter before the goal. This is a hypothesis from the supplied final frame, tested through movement and frame changes after every action. Distinguishes orientation changes from translation, permits short repeated key presses, probes controller buttons only after stalled movement, and retains failed state-action counts across resets within a level. Actual additional level progress remains unverified.","cannot_express":false}]