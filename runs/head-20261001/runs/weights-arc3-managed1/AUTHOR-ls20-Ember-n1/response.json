[{"game":"ls20","source_lines":["def act(params, mem, frame, avail, info):","    cfg = params['cfg']","    dirs = params['dirs']","    colors = params['colors']","    level = info['levels']","    if mem.get('level', -1) != level or info['step'] < mem.get('step', -1):","        mem.clear()","        mem['level'] = level","        mem['edges'] = {}","        mem['visits'] = {}","        mem['tried'] = {}","        mem['probe'] = 0","    mem['step'] = info['step']","    stride = max(1, int(abs(cfg[0])))","    half = max(0, int(abs(cfg[1])))","    pixels = np.argwhere(frame == int(colors[0]))","    visible = len(pixels) > 0","    if visible:","        y = int(np.sum(pixels[:, 0]) / len(pixels) + cfg[2])","        x = int(np.sum(pixels[:, 1]) / len(pixels) + cfg[3])","        pos = (x, y)","    else:","        pos = mem.get('pos', (32, 32))","    edges = mem['edges']","    visits = mem['visits']","    tried = mem['tried']","    old = mem.get('pos')","    last = mem.get('last')","    if old is not None and last is not None:","        edges[(old, last)] = pos","        if visible and old != pos:","            for row in dirs:","                a = int(row[0])","                if a in avail and int(row[1]) * (pos[0] - old[0]) + int(row[2]) * (pos[1] - old[1]) < 0:","                    edges[(pos, a)] = old","        if mem.get('frame') is not None:","            change = frame != mem['frame']","            mem['change'] = int(np.sum(change))","    visits[pos] = visits.get(pos, 0) + 1","    state = info['key']","    if state not in tried:","        tried[state] = {}","    legal = []","    for row in dirs:","        if int(row[0]) in avail:","            legal.append((int(row[0]), int(row[1]), int(row[2]), float(row[3])))","    if len(legal) == 0:","        return (avail[0], 0, 0)","    markers = np.argwhere((frame == int(colors[2])) | (frame == int(colors[3])))","    targets = []","    for p in markers:","        if int(p[0]) < int(cfg[4]) and int(p[1]) > int(cfg[5]):","            targets.append((int(p[1]), int(p[0])))","    chamber = np.argwhere(frame == int(colors[4]))","    if len(targets) == 0:","        for p in chamber:","            px = int(p[1])","            py = int(p[0])","            if py < int(cfg[6]) and px > int(cfg[5]) and px < int(cfg[7]):","                targets.append((px, py))","    queue = [pos]","    paths = {pos: 0}","    depth = {pos: 0}","    head = 0","    best = None","    bestscore = -1000000.0","    while head < len(queue) and head < int(cfg[8]):","        node = queue[head]","        head += 1","        if node != pos:","            distance = 1000","            for target in targets:","                d = abs(node[0] - target[0]) + abs(node[1] - target[1])","                if d < distance:","                    distance = d","            score = -float(distance) * cfg[9] - depth[node] * cfg[10] - visits.get(node, 0) * cfg[11]","            if len(targets) == 0:","                score = -depth[node] * cfg[10] - visits.get(node, 0) * cfg[11]","            if score > bestscore:","                bestscore = score","                best = paths[node]","        for a, dx, dy, priority in legal:","            dest = (node[0] + dx * stride, node[1] + dy * stride)","            if (node, a) in edges:","                dest = edges[(node, a)]","                if dest == node:","                    continue","            else:","                valid = True","                for oy in (-half, 0, half):","                    for ox in (-half, 0, half):","                        xx = dest[0] + ox","                        yy = dest[1] + oy","                        if xx < 0 or xx >= 64 or yy < 0 or yy >= int(cfg[4]):","                            valid = False","                        else:","                            c = int(frame[yy, xx])","                            if c == int(colors[5]):","                                valid = False","                            if c == int(colors[4]) and (yy >= int(cfg[6]) or xx <= int(cfg[5]) or xx >= int(cfg[7])):","                                valid = False","            if (node, a) not in edges and not valid:","                continue","            if dest not in paths:","                paths[dest] = a if node == pos else paths[node]","                depth[dest] = depth[node] + 1","                queue.append(dest)","    action = best","    probe = mem['probe']","    if probe < len(legal):","        action = legal[probe][0]","        mem['probe'] = probe + 1","    else:","        current = tried[state]","        chosen = None","        scorebest = -1000000.0","        for a, dx, dy, priority in legal:","            dest = edges.get((pos, a), (pos[0] + dx * stride, pos[1] + dy * stride))","            score = priority - current.get(a, 0) * cfg[12] - visits.get(dest, 0) * cfg[13]","            if dest == pos:","                score -= cfg[14]","            if a == best:","                score += cfg[15]","            if score > scorebest:","                scorebest = score","                chosen = a","        action = chosen","    tried[state][action] = tried[state].get(action, 0) + 1","    mem['pos'] = pos","    mem['last'] = action","    mem['frame'] = frame.copy()","    return (action, 0, 0)"],"shapes":{"cfg":[16],"colors":[6],"dirs":[4,4]},"params":{"cfg":[5,2,1.5,0,52,12,18,54,600,5,0.3,8,18,3,100,24],"colors":[12,9,0,1,5,4],"dirs":[[1,0,-1,0.4],[2,0,1,0.1],[3,-1,0,0.3],[4,1,0,0.2]]},"rationale":"Probes every keyboard action on each new level, locates the moving sprite from its cap, and learns blocked and successful transitions from successive frames. Spatial BFS uses the observed floor geometry to seek small goal cues and then the upper chamber, while state-action counts and position visits penalize loops. Colors, stride, geometry thresholds, action directions, and exploration weights are tensor-controlled.","cannot_express":false}]