[{"game":"lf52","source_lines":["def solve(state, jumps, failed, budget, goal, rank):","    if state.bit_count() <= goal:","        return []","    if state in failed:","        return None","    if budget[0] <= 0:","        return False","    budget[0] -= 1","    choices = []","    for a, b, c, take, put in jumps:","        if state & take == take and state & put == 0:","            nxt = (state ^ take) | put","            mobility = sum(1 for aa, bb, cc, tt, pp in jumps if nxt & tt == tt and nxt & pp == 0)","            choices.append((-float(rank[0]) * mobility, a, b, c, nxt))","    choices.sort()","    incomplete = False","    for score, a, b, c, nxt in choices:","        result = solve(nxt, jumps, failed, budget, goal, rank)","        if result is False:","            incomplete = True","        elif result is not None:","            return [(a, b, c, nxt)] + result","    if incomplete:","        return False","    failed.add(state)","    return None","def components(frame, colours, directions, top):","    remaining = set((int(v[0]), int(v[1])) for v in np.argwhere(np.any(frame[:, :, None] == colours, axis=2)) if int(v[0]) >= top)","    result = []","    while remaining:","        seed = min(remaining)","        remaining.remove(seed)","        todo = [seed]","        cells = []","        while todo:","            y, x = todo.pop()","            cells.append((y, x))","            for dy, dx in directions:","                q = (y + int(dy), x + int(dx))","                if q in remaining:","                    remaining.remove(q)","                    todo.append(q)","        result.append(cells)","    return result","def act(params, mem, frame, avail, info):","    p = params['settings']","    base, peg, selected, click = [int(v) for v in p[:4]]","    epoch = (info.get('levels', 0), info.get('resets', 0))","    if mem.get('epoch') != epoch:","        mem.clear()","        mem['epoch'] = epoch","        mem['tries'] = {}","        mem['dead'] = set()","        mem['tested'] = {}","        mem['plan'] = []","        mem['phase'] = 0","        mem['failed'] = set()","    signature = tuple(int(v) for row in frame[int(p[4]):] for v in row)","    if 'last' in mem:","        oldsig, target, oldstate, phase, expected = mem.pop('last')","        if signature == oldsig:","            mem['dead'].add((signature, target))","            mem['plan'] = []","            mem['phase'] = 0","        elif phase == int(p[13]):","            mem['tested'][target] = mem['tested'].get(target, 0) + 1","    slots = []","    for cells in components(frame, params['slot_colours'], params['directions'], int(p[4])):","        if int(p[5]) <= len(cells) <= int(p[6]):","            ys = [v[0] for v in cells]","            xs = [v[1] for v in cells]","            slots.append(((min(xs) + max(xs)) // 2, (min(ys) + max(ys)) // 2))","    slots.sort(key=lambda v: (v[1], v[0]))","    state = 0","    selected_slots = []","    for i, (x, y) in enumerate(slots):","        colour = int(frame[y, x])","        if colour == peg or colour == selected:","            state |= 1 << i","        if colour == selected:","            selected_slots.append(i)","    lookup = {v: i for i, v in enumerate(slots)}","    gaps = [abs(x - xx) + abs(y - yy) for x, y in slots for xx, yy in slots if (x == xx or y == yy) and (x, y) != (xx, yy)]","    jumps = []","    if gaps:","        gap = min(gaps)","        for a, (x, y) in enumerate(slots):","            for dy, dx in params['directions']:","                dx, dy = int(dx) * gap, int(dy) * gap","                middle, end = (x + dx, y + dy), (x + dx + dx, y + dy + dy)","                if middle in lookup and end in lookup:","                    b, c = lookup[middle], lookup[end]","                    jumps.append((a, b, c, (1 << a) | (1 << b), 1 << c))","    if mem.get('geometry') != tuple(slots):","        mem['geometry'] = tuple(slots)","        mem['failed'] = set()","        mem['plan'] = []","        mem['phase'] = 0","    if mem['plan'] and mem['phase'] == int(p[11]):","        a, b, c, expected = mem['plan'][0]","        if state == expected:","            mem['plan'].pop(0)","        else:","            mem['plan'] = []","        mem['phase'] = 0","    targets = []","    for colour in range(len(params['colour_priority'])):","        priority = float(params['colour_priority'][colour])","        if priority <= 0:","            continue","        for cells in components(frame, np.array([colour]), params['directions'], int(p[4])):","            if len(cells) < int(p[14]):","                continue","            ys = [v[0] for v in cells]","            xs = [v[1] for v in cells]","            cy, cx = (min(ys) + max(ys)) // 2, (min(xs) + max(xs)) // 2","            y, x = min(cells, key=lambda v: abs(v[0] - cy) + abs(v[1] - cx))","            target = (x, y)","            if target not in slots:","                targets.append((priority, target))","    target = None","    phase = int(p[13])","    expected = state","    if epoch[0] >= int(p[10]):","        fresh = [(priority, point) for priority, point in targets if mem['tested'].get(point, 0) == 0 and (signature, point) not in mem['dead']]","        if fresh:","            fresh.sort(key=lambda v: (-v[0], v[1][1], v[1][0]))","            target = fresh[0][1]","            mem['tested'][target] = 1","            mem['plan'] = []","            mem['phase'] = 0","    if target is None and click in avail:","        if not mem['plan']:","            budget = [max(1, int(p[7]) * int(p[8]))]","            result = solve(state, jumps, mem['failed'], budget, int(p[9]), params['ranking'])","            if result is not None and result is not False:","                mem['plan'] = result","        if mem['plan']:","            a, b, c, expected = mem['plan'][0]","            if state & (1 << a) and state & (1 << b) and state & (1 << c) == 0:","                if mem['phase'] == int(p[12]) or a in selected_slots:","                    target = slots[c]","                    phase = int(p[11])","                else:","                    target = slots[a]","                    phase = int(p[12])","                if (signature, target) in mem['dead']:","                    target = None","                    mem['plan'] = []","                else:","                    mem['phase'] = phase","            else:","                mem['plan'] = []","    if target is None:","        candidates = list(targets)","        for i, point in enumerate(slots):","            colour = int(frame[point[1], point[0]])","            value = float(params['colour_priority'][colour])","            if selected_slots and i not in selected_slots:","                value += float(params['ranking'][1])","            candidates.append((value, point))","        choices = []","        for priority, point in candidates:","            if (signature, point) in mem['dead']:","                continue","            attempts = mem['tries'].get((signature, point), 0)","            score = priority - float(params['ranking'][2]) * attempts - float(params['ranking'][3]) * mem['tested'].get(point, 0)","            choices.append((score, point))","        if choices:","            choices.sort(key=lambda v: (-v[0], v[1][1], v[1][0]))","            target = choices[0][1]","            mem['plan'] = []","            mem['phase'] = 0","    if target is not None and click in avail:","        mem['tries'][(signature, target)] = mem['tries'].get((signature, target), 0) + 1","        mem['last'] = (signature, target, state, phase, expected)","        return (click, target[0], target[1])","    for value in params['fallback']:","        action = int(value)","        if action in avail:","            return (action, 0, 0)","    return (avail[0], 0, 0)"],"shapes":{"settings":[15],"slot_colours":[3],"directions":[4,2],"ranking":[4],"colour_priority":[16],"fallback":[6]},"params":{"settings":[1,14,2,6,1,4,24,1000,160,1,1,2,1,3,4],"slot_colours":[1,14,2],"directions":[[0,1],[1,0],[0,-1],[-1,0]],"ranking":[1,9,24,2],"colour_priority":[0,1,3,0,0,0,6,6,6,0,0,14,18,12,10,16],"fallback":[7,1,2,3,4,6]},"rationale":"Retains visual peg-jump search for the credited first level, treats selected pegs as occupied, and preserves selection across the two-click move. Subsequent levels first probe distinct visible device components, then refresh geometry and targets from each frame. Exploration records per-board target attempts and suppresses clicks with no board effect, excluding the changing top-row action counter from comparison. Device colours, geometry, search budget and exploration priorities are tensor controlled.","cannot_express":false}]