[{"game":"m0r0","source_lines":["def objects(frame, colour):","    remaining = set()","    for p in np.argwhere(frame == colour):","        remaining.add((int(p[0]), int(p[1])))","    result = []","    while remaining:","        start = next(iter(remaining))","        remaining.remove(start)","        todo = [start]","        group = [start]","        while todo:","            r, c = todo.pop()","            for p in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):","                if p in remaining:","                    remaining.remove(p)","                    todo.append(p)","                    group.append(p)","        result.append((min(p[0] for p in group), min(p[1] for p in group)))","    result.sort(key=lambda p: p[1])","    return result","def advance(state, action, board, directions, size):","    result = []","    for i in range(len(state)):","        r, c = state[i]","        dr, dc = directions[action][i]","        rr = r + dr","        cc = c + dc","        if rr >= 0 and cc >= 0 and rr + size <= board.shape[0] and cc + size <= board.shape[1]:","            if np.all(board[rr:rr + size, cc:cc + size]):","                result.append((rr, cc))","            else:","                result.append((r, c))","        else:","            result.append((r, c))","    return tuple(result)","def act(params, mem, frame, avail, info):","    cfg = params['config']","    level = info['levels']","    reset = info['resets']","    if mem.get('level', -1) != level or mem.get('reset', -1) != reset:","        mem.clear()","        mem['level'] = level","        mem['reset'] = reset","        mem['board'] = (frame == int(cfg[0])) | (frame == int(cfg[1]))","        mem['visits'] = {}","        mem['tried'] = []","        mem['clicks'] = []","        mem['directions'] = {}","        for j in range(len(params['order'])):","            action = int(params['order'][j])","            mem['directions'][action] = [(int(params['motion'][j][i][0]), int(params['motion'][j][i][1])) for i in range(2)]","    positions = objects(frame, int(cfg[1]))","    state = tuple(positions)","    previous = mem.get('previous')","    if previous is not None and len(state) == 2 and len(previous[0]) == 2:","        old, action, oldkey = previous","        if action in mem['directions']:","            for i in range(2):","                dr = state[i][0] - old[i][0]","                dc = state[i][1] - old[i][1]","                if (dr != 0 or dc != 0) and abs(dr) + abs(dc) <= cfg[3]:","                    mem['directions'][action][i] = (dr, dc)","        if oldkey == info['key']:","            blocked = mem.setdefault('blocked', {})","            blocked[(oldkey, action)] = blocked.get((oldkey, action), 0) + 1","    if len(state) != 2:","        count = mem.get('fallback', 0)","        mem['fallback'] = count + 1","        action = int(params['order'][count % len(params['order'])])","        if action not in avail:","            action = avail[count % len(avail)]","        mem['previous'] = (state, action, info['key'])","        return (action, int(cfg[4]), int(cfg[4]))","    visits = mem['visits'].setdefault(info['key'], {})","    action = None","    for candidate in params['order']:","        candidate = int(candidate)","        if candidate in avail and candidate not in mem['tried']:","            mem['tried'].append(candidate)","            action = candidate","            break","    if action is None and int(cfg[5]) in avail and len(mem['clicks']) < len(state):","        index = len(mem['clicks'])","        r, c = state[index]","        mem['clicks'].append(state[index])","        action = int(cfg[5])","        mem['previous'] = (state, action, info['key'])","        return (action, c + int(cfg[6]), r + int(cfg[6]))","    if action is None:","        board = mem['board']","        size = max(1, min(frame.shape[0], int(abs(cfg[2]))))","        queue = [state]","        first = {state: None}","        depth = {state: 0}","        cursor = 0","        best = None","        bestscore = -1000000","        limit = max(1, min(20000, int(abs(cfg[7]))))","        while cursor < len(queue) and cursor < limit:","            current = queue[cursor]","            cursor += 1","            distance = abs(current[0][0] - current[1][0]) + abs(current[0][1] - current[1][1])","            score = -cfg[8] * distance - cfg[9] * (current[0][0] + current[1][0]) - cfg[10] * depth[current]","            if first[current] is not None:","                score -= cfg[11] * visits.get(first[current], 0)","                score -= cfg[12] * mem.get('blocked', {}).get((info['key'], first[current]), 0)","                if score > bestscore:","                    bestscore = score","                    best = first[current]","            if distance <= cfg[13] and first[current] is not None:","                best = first[current]","                break","            for candidate in params['order']:","                candidate = int(candidate)","                if candidate not in avail:","                    continue","                successor = advance(current, candidate, board, mem['directions'], size)","                if successor == current or successor in first:","                    continue","                first[successor] = candidate if first[current] is None else first[current]","                depth[successor] = depth[current] + 1","                queue.append(successor)","        action = best","        if action is None:","            minimum = 1000000","            for candidate in params['order']:","                candidate = int(candidate)","                if candidate in avail:","                    count = visits.get(candidate, 0)","                    if count < minimum:","                        minimum = count","                        action = candidate","        if action is None:","            action = avail[0]","    visits[action] = visits.get(action, 0) + 1","    mem['previous'] = (state, action, info['key'])","    return (action, int(cfg[4]), int(cfg[4]))"],"shapes":{"config":[14],"order":[4],"motion":[4,2,2]},"params":{"config":[5,10,5,10,32,6,2,1000,20,0.25,0.1,3,50,0],"order":[1,3,4,2],"motion":[[[-5,0],[-5,0]],[[0,-5],[0,5]],[[0,5],[0,-5]],[[5,0],[5,0]]]},"rationale":"Transfers online movement inference, blocked-action memory, and frame-key visit penalties. Separately probes keyboard actions and clicks on both tokens. Reads the walkable maze from the frame, learns each token's action displacement, and searches joint positions with independent wall blocking for a short route that brings the tokens together. Colour identities, token size, mirrored motion priors, action order, search budget, and scoring weights reside in tensors.","cannot_express":false}]