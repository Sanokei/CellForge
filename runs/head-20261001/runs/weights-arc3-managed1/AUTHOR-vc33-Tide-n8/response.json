[{"game":"vc33","source_lines":["def components(frame, colours):","    seen = np.zeros(frame.shape, dtype=bool)","    out = []","    for y in range(1, frame.shape[0]):","        for x in range(frame.shape[1]):","            c = int(frame[y, x])","            if seen[y, x] or c not in colours:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                yy, xx = todo.pop()","                cells.append((yy, xx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = yy + dy, xx + dx","                    if 1 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:","                        seen[ny, nx] = True","                        todo.append((ny, nx))","            xs = [v[1] for v in cells]","            ys = [v[0] for v in cells]","            out.append((c, min(xs), min(ys), max(xs), max(ys), len(cells), sum(xs) / len(xs), sum(ys) / len(ys)))","    return out","def features(objects, p):","    markers = sorted([o for o in objects if o[0] == int(p[1])], key=lambda o: (-o[5], o[2], o[1]))","    agents = [o for o in objects if o[0] == int(p[2])]","    tracks = [o for o in objects if o[0] == int(p[3])]","    result = []","    for i in range(2):","        if i < len(markers):","            result.extend([markers[i][6], markers[i][7]])","        else:","            result.extend([-1.0, -1.0])","    for group in [agents, tracks]:","        if group:","            total = sum(o[5] for o in group)","            result.extend([sum(o[6] * o[5] for o in group) / total, sum(o[7] * o[5] for o in group) / total])","        else:","            result.extend([-1.0, -1.0])","    return tuple(result)","def objective(v, p):","    score = 0.0","    if min(v[:4]) >= 0:","        score += p[4] * abs(v[0] - v[2]) + p[5] * abs(v[1] - v[3])","    if min(v[4:]) >= 0:","        score += p[6] * abs(v[5] - v[7])","    return score","def early(params, mem, frame, avail, info):","    p = params['settings']","    weights = params['colours']","    colours = [i for i in range(len(weights)) if weights[i] > 0]","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level or mem.get('reset') != reset:","        wins = mem.get('wins', {})","        if mem.get('level', level) < level and 'last' in mem:","            previous = mem['last'][1]","            wins[previous[0]] = wins.get(previous[0], 0) + 1","        mem.clear()","        mem.update({'level': level, 'reset': reset, 'wins': wins, 'pairs': {}, 'visits': {}, 'effects': {}, 'uses': {}, 'models': {}, 'edges': {}, 'streak': 0})","    objects = components(frame, colours)","    state = tuple(int(v) for v in frame[int(p[0]):, :].flatten())","    feature = features(objects, p)","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, action, before = mem['last']","        changed = old != state","        entry = mem['effects'].setdefault(action, [0, 0])","        entry[0] += int(changed)","        entry[1] += 1","        mem['edges'][(old, action)] = state","        if changed:","            delta = tuple(feature[i] - before[i] for i in range(len(feature)))","            model = mem['models'].get(action)","            if model is None:","                mem['models'][action] = [delta, 1]","            elif max(abs(delta[i] - model[0][i]) for i in range(len(delta))) <= p[7]:","                count = model[1]","                mem['models'][action] = [tuple((model[0][i] * count + delta[i]) / (count + 1) for i in range(len(delta))), count + 1]","            else:","                mem['models'][action] = [delta, 1]","        else:","            mem['models'].pop(action, None)","    candidates = {}","    for o in objects:","        if o[5] > p[8]:","            continue","        c, x0, y0, x1, y1, area, cx, cy = o","        x, y = int(cx), int(cy)","        if int(frame[y, x]) != c:","            positions = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)","            middle = positions[len(positions) // 2]","            y, x = y0 + int(middle[0]), x0 + int(middle[1])","        candidates[(c, x, y)] = weights[c]","    if not candidates:","        if 6 in avail:","            return (6, int(p[9]), int(p[10]))","        return (avail[0], 0, 0)","    choices = []","    for action, priority in candidates.items():","        successes, trials = mem['effects'].get(action, [0, 0])","        value = -p[11] * priority + p[12] * mem['pairs'].get((state, action), 0)","        value += p[13] * (trials - successes) + p[14] * mem['uses'].get(action, 0)","        if trials == 0:","            value -= p[15]","        if successes:","            value -= p[16] * successes / max(1, trials)","        destination = mem['edges'].get((state, action))","        if destination is not None:","            value += p[17] * visits.get(destination, 0)","        model = mem['models'].get(action)","        if model is not None and model[1] >= int(p[18]):","            predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))","            value += p[19] * (objective(predicted, p) - objective(feature, p))","        if 'last' in mem and action == mem['last'][1]:","            value -= p[20] / (1 + mem['streak'] / max(1.0, p[21]))","        value -= p[22] * mem['wins'].get(action[0], 0)","        choices.append((value, action))","    choices.sort(key=lambda item: (item[0], item[1]))","    action = choices[0][1]","    if 'last' in mem and action == mem['last'][1]:","        mem['streak'] += 1","    else:","        mem['streak'] = 0","    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1","    mem['uses'][action] = mem['uses'].get(action, 0) + 1","    mem['last'] = (state, action, feature)","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)","def geometry(objects, q):","    result = []","    for colour in q[:3]:","        group = sorted([o for o in objects if o[0] == int(colour)], key=lambda o: (o[2], o[1]))","        if len(group) >= 2:","            best = None","            for i in range(len(group)):","                for j in range(i + 1, len(group)):","                    a, b = group[i], group[j]","                    distance = q[3] * abs(a[6] - b[6]) + q[4] * abs(a[7] - b[7])","                    if best is None or distance < best[0]:","                        best = (distance, a[6] - b[6], a[7] - b[7])","            result.extend([best[1], best[2]])","        else:","            result.extend([0.0, 0.0])","    return tuple(result)","def cost(v, q):","    return sum(q[3] * abs(v[i]) + q[4] * abs(v[i + 1]) for i in range(0, len(v), 2))","def credited(params, mem, frame, avail, info):","    q = params['search']","    if info.get('levels', 0) < int(q[5]):","        return early(params, mem, frame, avail, info)","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('searchlevel') != level:","        mem.clear()","        mem.update({'searchlevel': level, 'reset': reset, 'edges': {}, 'pairs': {}, 'visits': {}, 'effects': {}, 'models': {}, 'probes': {}, 'uses': {}})","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('last', None)","    weights = params['probe_colours']","    objects = components(frame, [i for i in range(len(weights)) if weights[i] > 0])","    state = tuple(int(v) for v in frame[int(q[6]):, :].flatten())","    feature = geometry(objects, q)","    score = cost(feature, q)","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, action, before = mem['last']","        changed = old != state","        mem['edges'].setdefault(old, {})[action] = state","        effect = mem['effects'].setdefault(action, [0, 0])","        effect[0] += int(changed)","        effect[1] += 1","        if changed:","            delta = tuple(feature[i] - before[i] for i in range(len(feature)))","            mem['models'][action] = delta","        else:","            mem['models'].pop(action, None)","    candidates = []","    for o in objects:","        if o[5] > q[7]:","            continue","        c, x0, y0, x1, y1, area, cx, cy = o","        x, y = int(cx), int(cy)","        if int(frame[y, x]) != c:","            cells = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)","            middle = cells[len(cells) // 2]","            x, y = x0 + int(middle[1]), y0 + int(middle[0])","        candidates.append((c, x, y))","    if not candidates:","        return (avail[0], int(q[8]), int(q[9]))","    unprobed = [a for a in candidates if mem['probes'].get(a, 0) == 0]","    if unprobed:","        unprobed.sort(key=lambda a: (-weights[a[0]], a[2], a[1]))","        action = unprobed[0]","    else:","        choices = []","        for a in candidates:","            successes, trials = mem['effects'].get(a, [0, 0])","            used = mem['pairs'].get((state, a), 0)","            value = -q[10] * weights[a[0]] + q[11] * used","            value += q[12] * (trials - successes) / max(1, trials)","            value += q[13] * mem['uses'].get(a, 0)","            destination = mem['edges'].get(state, {}).get(a)","            if destination == state:","                value += q[14]","            elif destination is not None:","                value += q[15] * visits.get(destination, 0)","            delta = mem['models'].get(a)","            if delta is not None:","                predicted = tuple(feature[i] + delta[i] for i in range(len(feature)))","                value += q[16] * (cost(predicted, q) - score)","            if successes:","                value -= q[17] * successes / max(1, trials)","            choices.append((value, a))","        choices.sort(key=lambda item: (item[0], item[1]))","        action = choices[0][1]","        if all(mem['pairs'].get((state, a), 0) > 0 for a in candidates):","            queue = [(state, None)]","            seen = {state}","            index = 0","            route = None","            while index < len(queue) and index < int(q[18]):","                node, first = queue[index]","                index += 1","                outgoing = mem['edges'].get(node, {})","                if node != state and any(mem['pairs'].get((node, a), 0) == 0 for a in candidates if a[0] == int(q[19])):","                    route = first","                    break","                for a, destination in outgoing.items():","                    if destination not in seen and destination != node:","                        seen.add(destination)","                        queue.append((destination, a if first is None else first))","            if route is not None and route in candidates:","                action = route","    mem['probes'][action] = mem['probes'].get(action, 0) + 1","    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1","    mem['uses'][action] = mem['uses'].get(action, 0) + 1","    mem['last'] = (state, action, feature)","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)","def rectangle_gap(a, b):","    dx = max(0.0, a[0] - b[2], b[0] - a[2])","    dy = max(0.0, a[1] - b[3], b[1] - a[3])","    return dx * dx + dy * dy","def route_score(v, labels, p):","    agents = []","    markers = []","    bridges = []","    penalty = 0.0","    for i in range(len(labels)):","        r = v[i * 4:i * 4 + 4]","        penalty += sum(max(0.0, -x, x - p[14]) for x in r) * p[15]","        if labels[i] == int(p[1]):","            agents.append(r)","        elif labels[i] == int(p[2]):","            markers.append(r)","        elif labels[i] == int(p[3]):","            bridges.append(r)","    if not agents or not markers:","        return penalty","    agent = agents[0]","    for a in agents:","        if (a[2] - a[0]) * (a[3] - a[1]) > (agent[2] - agent[0]) * (agent[3] - agent[1]):","            agent = a","    own = min(markers, key=lambda r: rectangle_gap(agent, r))","    start = own if rectangle_gap(agent, own) <= p[4] else agent","    targets = [r for r in markers if r != own]","    if not targets:","        targets = markers","    goal = min(targets, key=lambda r: rectangle_gap(start, r))","    direct = rectangle_gap(start, goal)","    horizontal = abs(start[0] + start[2] - goal[0] - goal[2]) >= abs(start[1] + start[3] - goal[1] - goal[3])","    axis = 0 if horizontal else 1","    startpos = (start[axis] + start[axis + 2]) / 2","    goalpos = (goal[axis] + goal[axis + 2]) / 2","    lo, hi = min(startpos, goalpos), max(startpos, goalpos)","    route = [r for r in bridges if lo < (r[axis] + r[axis + 2]) / 2 < hi]","    route.sort(key=lambda r: abs((r[axis] + r[axis + 2]) / 2 - startpos))","    if not route:","        return penalty + direct","    value = rectangle_gap(start, route[0])","    previous = route[0]","    discount = p[5]","    for r in route[1:] + [goal]:","        value += discount * rectangle_gap(previous, r)","        discount *= p[5]","        previous = r","    return penalty + value + p[6] * direct","def vector_key(v):","    return tuple(int(round(x)) for x in v)","def adaptive(params, mem, frame, avail, info):","    p = params['planner']","    weights = params['probe_colours']","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('adaptivelevel') != level:","        mem.clear()","        mem.update({'adaptivelevel': level, 'reset': reset, 'edges': {}, 'pairs': {}, 'visits': {}, 'effects': {}, 'models': {}, 'uses': {}, 'nodes': {}, 'vectors': {}, 'dead': {}, 'ticks': 0})","    if mem.get('reset') != reset:","        if 'last' in mem:","            old, action, before, oldlabels = mem['last']","            mem['dead'][(old, action)] = mem['dead'].get((old, action), 0) + 1","        mem['reset'] = reset","        mem.pop('last', None)","    colours = [i for i in range(len(weights)) if weights[i] > 0]","    if int(p[3]) not in colours:","        colours.append(int(p[3]))","    objects = components(frame, colours)","    selected = sorted([o for o in objects if o[0] in [int(p[1]), int(p[2]), int(p[3])]], key=lambda o: (o[0], o[1], o[2]))","    labels = tuple(o[0] for o in selected)","    vector = tuple(float(z) for o in selected for z in o[1:5])","    state = tuple(int(v) for v in frame[int(params['search'][6]):, :].flatten())","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    vk = (labels, vector_key(vector))","    mem['vectors'][vk] = mem['vectors'].get(vk, 0) + 1","    candidates = []","    for o in objects:","        if o[5] > params['search'][7] or o[0] == int(p[3]):","            continue","        c, x0, y0, x1, y1, area, cx, cy = o","        x, y = int(cx), int(cy)","        if int(frame[y, x]) != c:","            cells = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)","            cell = cells[len(cells) // 2]","            x, y = x0 + int(cell[1]), y0 + int(cell[0])","        candidates.append((c, x, y))","    if not candidates:","        return (avail[0], int(params['search'][8]), int(params['search'][9]))","    candidates.sort(key=lambda a: (-weights[a[0]], a[2], a[1]))","    mem['nodes'][state] = candidates","    if 'last' in mem:","        old, action, before, oldlabels = mem['last']","        changed = old != state","        mem['edges'].setdefault(old, {})[action] = state","        effect = mem['effects'].setdefault(action, [0, 0])","        effect[0] += int(changed)","        effect[1] += 1","        if changed and labels == oldlabels and len(before) == len(vector):","            delta = tuple(vector[i] - before[i] for i in range(len(vector)))","            if any(abs(d) > 0 for d in delta):","                model = mem['models'].get(action)","                if model is not None and model[2] == labels and max(abs(delta[i] - model[0][i]) for i in range(len(delta))) <= p[7]:","                    count = model[1]","                    mem['models'][action] = (tuple((model[0][i] * count + delta[i]) / (count + 1) for i in range(len(delta))), count + 1, labels)","                else:","                    mem['models'][action] = (delta, 1, labels)","        if not changed:","            mem['models'].pop(action, None)","    priority = max(weights[a[0]] for a in candidates)","    controls = [a for a in candidates if weights[a[0]] >= priority]","    unprobed = [a for a in controls if mem['effects'].get(a, [0, 0])[1] == 0]","    action = None","    if unprobed:","        action = unprobed[0]","    base = route_score(vector, labels, p)","    choices = []","    for a in candidates:","        success, trials = mem['effects'].get(a, [0, 0])","        used = mem['pairs'].get((state, a), 0)","        destination = mem['edges'].get(state, {}).get(a)","        value = p[8] * used + p[9] * (trials - success) / max(1, trials)","        value += p[10] * mem['uses'].get(a, 0) - weights[a[0]]","        value += p[15] * mem['dead'].get((state, a), 0)","        if destination is not None:","            value += p[11] * visits.get(destination, 0)","        if trials == 0:","            value -= p[12]","        model = mem['models'].get(a)","        if model is not None and model[2] == labels:","            predicted = tuple(vector[i] + model[0][i] for i in range(len(vector)))","            value += route_score(predicted, labels, p) - base","        choices.append((value, a))","    choices.sort(key=lambda item: (item[0], item[1]))","    if action is None:","        action = choices[0][1]","        beam = [(vector, None, 0.0, {vector_key(vector)})]","        best = None","        for depth in range(int(p[13])):","            expanded = []","            for current, first, expense, path in beam:","                for a in controls:","                    model = mem['models'].get(a)","                    if model is None or model[2] != labels:","                        continue","                    predicted = tuple(current[i] + model[0][i] for i in range(len(current)))","                    key = vector_key(predicted)","                    if key in path:","                        continue","                    root = a if first is None else first","                    addition = p[10]","                    if first is None:","                        addition += p[8] * mem['pairs'].get((state, a), 0)","                        destination = mem['edges'].get(state, {}).get(a)","                        if destination is not None:","                            addition += p[11] * visits.get(destination, 0)","                        addition += p[15] * mem['dead'].get((state, a), 0)","                    addition += p[11] * mem['vectors'].get((labels, key), 0)","                    uncertainty = (depth + 1) / max(1, model[1])","                    total = expense + addition + uncertainty * p[10]","                    value = route_score(predicted, labels, p) + total","                    newpath = set(path)","                    newpath.add(key)","                    expanded.append((value, predicted, root, total, newpath))","                    if best is None or value < best[0]:","                        best = (value, root)","            if not expanded:","                break","            expanded.sort(key=lambda item: (item[0], item[2]))","            beam = [(item[1], item[2], item[3], item[4]) for item in expanded[:int(p[0])]]","        if best is not None and best[0] - base < choices[0][0]:","            action = best[1]","        if all(mem['pairs'].get((state, a), 0) > 0 for a in controls):","            queue = [(state, None)]","            seen = {state}","            index = 0","            route = None","            while index < len(queue) and index < int(params['search'][18]):","                node, first = queue[index]","                index += 1","                available = mem['nodes'].get(node, [])","                frontier = [a for a in available if weights[a[0]] >= priority and mem['pairs'].get((node, a), 0) == 0]","                if node != state and frontier:","                    route = first","                    break","                for a, destination in mem['edges'].get(node, {}).items():","                    if destination not in seen and destination != node:","                        seen.add(destination)","                        queue.append((destination, a if first is None else first))","            if route is not None and route in candidates:","                action = route","    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1","    mem['uses'][action] = mem['uses'].get(action, 0) + 1","    mem['last'] = (state, action, vector, labels)","    mem['ticks'] += 1","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)","def act(params, mem, frame, avail, info):","    if info.get('levels', 0) < int(params['planner'][16]):","        return credited(params, mem, frame, avail, info)","    return adaptive(params, mem, frame, avail, info)"],"shapes":{"colours":[16],"settings":[23],"probe_colours":[16],"search":[20],"planner":[17]},"params":{"colours":[0,0,0,0,0.3,0.2,0,0,0,4,0,0.4,0,0,0,0],"settings":[1,11,4,5,0.5,1,0.25,0.2,256,32,32,4,90,8,0.025,6,14,35,2,2,3,8,4],"probe_colours":[0,0,0,0,0.3,0.2,0,0,0,4,0,0.4,0,0,0.4,0.4],"search":[11,14,15,0.25,1,2,1,256,32,32,4,28,35,0.015,300,12,5,18,800,9],"planner":[20,4,11,1,36,0.35,0.08,0.25,65,90,0.12,24,18,6,63,700,3]},"rationale":"Preserves the credited policy unchanged for the first three levels. Starting at the first unsolved level, probes distinct controls and learns their effects on agent, marker, and intermediate platform rectangles. Uses short beam searches over learned movements, executes only the first click, and replans from the actual frame. Prioritizes contact with intermediate platforms rather than only bringing terminal markers together. Excludes the timer from state identity, penalizes repeated state/action pairs and known reset-causing clicks, retains discoveries across resets, and routes through observed transitions toward untested controls.","cannot_express":false}]