[{"game":"sk48","source_lines":["def groups(frame, colour, lo, hi):","    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour) if lo <= p[0] < hi)","    result = []","    while remaining:","        start = next(iter(remaining))","        remaining.remove(start)","        todo = [start]","        cells = [start]","        while todo:","            r, c = todo.pop()","            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):","                if q in remaining:","                    remaining.remove(q)","                    todo.append(q)","                    cells.append(q)","        result.append((min(p[0] for p in cells), min(p[1] for p in cells), max(p[0] for p in cells), max(p[1] for p in cells), len(cells)))","    return result","def act(params, mem, frame, avail, info):","    cfg = params['config']","    actions = [int(v) for v in params['actions']]","    cutoff = max(1, min(frame.shape[0], int(cfg[0])))","    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:","        motion = mem.get('motion', {})","        effects = mem.get('effects', {})","        mem.clear()","        mem['level'] = info['levels']","        mem['reset'] = info['resets']","        mem['motion'] = motion","        mem['effects'] = effects","        mem['visits'] = {}","        mem['blocked'] = {}","        mem['edges'] = {}","        mem['done'] = set()","        mem['attempts'] = {}","        mem['stuck'] = 0","    heads = groups(frame, int(cfg[1]), 0, cutoff)","    heads = [b for b in heads if b[4] >= cfg[2]]","    heads.sort(key=lambda b: -b[4])","    head = heads[0] if heads else None","    row = None","    end = None","    if head is not None:","        row = (head[0] + head[2]) / 2","        end = head[3]","        for p in np.argwhere((frame == int(cfg[3])) | (frame == int(cfg[4]))):","            if p[0] < cutoff and abs(float(p[0]) - row) <= cfg[5] and p[1] > head[3]:","                end = max(end, int(p[1]))","    targets = []","    legend = []","    for value in params['colours']:","        colour = int(value)","        hud = groups(frame, colour, cutoff, frame.shape[0])","        hud = [b for b in hud if b[4] >= cfg[6]]","        if hud:","            hud.sort(key=lambda b: -b[4])","            box = hud[0]","            legend.append((box[1], colour))","            interior = frame[box[0]:box[2] + 1, box[1]:box[3] + 1]","            if np.sum(interior == int(cfg[7])) >= cfg[8]:","                mem['done'].add(colour)","        for box in groups(frame, colour, 0, cutoff):","            if box[4] >= cfg[6]:","                targets.append((colour, box))","    legend.sort()","    order = [p[1] for p in legend]","    if not order:","        order = [int(v) for v in params['colours']]","    targets.sort(key=lambda t: (order.index(t[0]) if t[0] in order else len(order), t[1][0], t[1][1]))","    signature = tuple(int(v) for v in frame[:cutoff, :].flatten())","    old = mem.get('previous')","    if old is not None:","        oldsig, token, oldrow, oldend, oldframe, oldtarget = old","        delta = np.argwhere(frame != oldframe)","        changes = len(delta)","        meaningful = sum(1 for p in delta if p[0] < cutoff)","        mem['effects'][token] = max(mem['effects'].get(token, 0), meaningful + cfg[9] * (changes - meaningful))","        mem['edges'][(oldsig, token)] = signature","        if signature == oldsig:","            pair = (oldsig, token)","            mem['blocked'][pair] = mem['blocked'].get(pair, 0) + 1","            mem['stuck'] += 1","        else:","            mem['stuck'] = 0","        if row is not None and oldrow is not None and token[0] != actions[4]:","            dr = row - oldrow","            de = end - oldend","            if cfg[10] <= abs(dr) + abs(de) <= cfg[11]:","                mem['motion'][token[0]] = (dr, de)","        if oldtarget is not None and token[0] == actions[3] and signature == oldsig:","            mem['attempts'][oldtarget] = mem['attempts'].get(oldtarget, 0) + 1","    remaining = [t for t in targets if t[0] not in mem['done']]","    target = remaining[0] if remaining else None","    visits = mem['visits'].setdefault(signature, {})","    candidates = []","    desired_action = None","    if head is not None:","        if target is None:","            desired_action = actions[2] if end > head[3] + cfg[12] else actions[5]","        else:","            desiredrow = (target[1][0] + target[1][2]) / 2","            aligned = abs(row - desiredrow) <= cfg[5]","            if not aligned:","                if end > head[3] + cfg[12]:","                    desired_action = actions[2]","                else:","                    desired_action = actions[0] if desiredrow < row else actions[1]","            else:","                desired_action = actions[3]","                failures = mem['blocked'].get((signature, (actions[3], 0, 0)), 0)","                if failures >= cfg[13]:","                    desired_action = actions[2]","                    if mem['attempts'].get(target[0], 0) >= cfg[14]:","                        mem['done'].add(target[0])","    for i in range(len(actions)):","        action = actions[i]","        if action not in avail or action == actions[4]:","            continue","        token = (action, 0, 0)","        score = cfg[15] - i * cfg[16]","        if action == desired_action:","            score += cfg[17]","        if head is not None and target is not None:","            dr, de = mem['motion'].get(action, (params['motion'][i][0], params['motion'][i][1]))","            desiredrow = (target[1][0] + target[1][2]) / 2","            if end <= head[3] + cfg[12]:","                score += cfg[18] * (abs(row - desiredrow) - abs(row + dr - desiredrow))","            elif abs(row - desiredrow) > cfg[5]:","                score -= cfg[19] * abs(dr)","        candidates.append((score, token))","    click = actions[4]","    if click in avail:","        for colour, box in targets:","            x = int((box[1] + box[3]) / 2)","            y = int((box[0] + box[2]) / 2)","            token = (click, x, y)","            effect = mem['effects'].get(token)","            score = cfg[20] if effect is None else cfg[21] + min(cfg[22], effect) * cfg[23]","            if head is not None and abs(row - y) <= cfg[5] and end >= box[1] and colour not in mem['done']:","                score += cfg[24]","            if effect == 0:","                score -= cfg[25]","            candidates.append((score, token))","    best = None","    bestscore = -1000000","    for score, token in candidates:","        score -= cfg[26] * visits.get(token, 0)","        score -= cfg[27] * mem['blocked'].get((signature, token), 0)","        successor = mem['edges'].get((signature, token))","        if successor is not None:","            score -= cfg[28] * sum(mem['visits'].get(successor, {}).values())","        if score > bestscore:","            bestscore = score","            best = token","    if best is None:","        best = (avail[0], 0, 0)","    visits[best] = visits.get(best, 0) + 1","    mem['previous'] = (signature, best, row, end, frame.copy(), target[0] if target is not None else None)","    return best"],"shapes":{"config":[29],"actions":[6],"motion":[6,2],"colours":[3]},"params":{"config":[52,6,12,1,2,1.5,8,0,2,0.2,1,18,0,1,3,0,0.2,120,3,12,-35,-100,100,1,45,500,8,160,1],"actions":[1,2,3,4,6,7],"motion":[[-6,0],[6,0],[0,-6],[0,6],[0,0],[0,0]],"colours":[8,14,9]},"rationale":"Adapts the donor's observed-effect learning, blocked-action suppression, and visited-state graph to a vertically movable telescoping arm. Reads target order and hollow completion markers from the HUD, retracts before changing rows, and advances to the next colour after acquisition. Learns keyboard motion from frame differences and tests contextual clicks only when useful; ineffective clicks receive a persistent penalty. This directly addresses the previous policy repeatedly pursuing an already hollowed blue target and spending most actions on ineffective clicks.","cannot_express":false}]