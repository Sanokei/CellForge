[{"game":"vc33","source_lines":["def components(frame, colours):","    seen = np.zeros(frame.shape, dtype=bool)","    out = []","    for y in range(1, frame.shape[0]):","        for x in range(frame.shape[1]):","            c = int(frame[y, x])","            if seen[y, x] or c not in colours:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                yy, xx = todo.pop()","                cells.append((yy, xx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = yy + dy, xx + dx","                    if 1 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:","                        seen[ny, nx] = True","                        todo.append((ny, nx))","            xs = [v[1] for v in cells]","            ys = [v[0] for v in cells]","            out.append((c, min(xs), min(ys), max(xs), max(ys), len(cells), sum(xs) / len(xs), sum(ys) / len(ys)))","    return out","def features(objects, p):","    markers = sorted([o for o in objects if o[0] == int(p[1])], key=lambda o: (-o[5], o[2], o[1]))","    agents = [o for o in objects if o[0] == int(p[2])]","    tracks = [o for o in objects if o[0] == int(p[3])]","    result = []","    for i in range(2):","        if i < len(markers):","            result.extend([markers[i][6], markers[i][7]])","        else:","            result.extend([-1.0, -1.0])","    for group in [agents, tracks]:","        if group:","            total = sum(o[5] for o in group)","            result.extend([sum(o[6] * o[5] for o in group) / total, sum(o[7] * o[5] for o in group) / total])","        else:","            result.extend([-1.0, -1.0])","    return tuple(result)","def objective(v, p):","    score = 0.0","    if min(v[:4]) >= 0:","        score += p[4] * abs(v[0] - v[2]) + p[5] * abs(v[1] - v[3])","    if min(v[4:]) >= 0:","        score += p[6] * abs(v[5] - v[7])","    return score","def early(params, mem, frame, avail, info):","    p = params['settings']","    weights = params['colours']","    colours = [i for i in range(len(weights)) if weights[i] > 0]","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level or mem.get('reset') != reset:","        wins = mem.get('wins', {})","        if mem.get('level', level) < level and 'last' in mem:","            previous = mem['last'][1]","            wins[previous[0]] = wins.get(previous[0], 0) + 1","        mem.clear()","        mem.update({'level': level, 'reset': reset, 'wins': wins, 'pairs': {}, 'visits': {}, 'effects': {}, 'uses': {}, 'models': {}, 'edges': {}, 'streak': 0})","    objects = components(frame, colours)","    state = tuple(int(v) for v in frame[int(p[0]):, :].flatten())","    feature = features(objects, p)","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, action, before = mem['last']","        changed = old != state","        entry = mem['effects'].setdefault(action, [0, 0])","        entry[0] += int(changed)","        entry[1] += 1","        mem['edges'][(old, action)] = state","        if changed:","            delta = tuple(feature[i] - before[i] for i in range(len(feature)))","            model = mem['models'].get(action)","            if model is None:","                mem['models'][action] = [delta, 1]","            elif max(abs(delta[i] - model[0][i]) for i in range(len(delta))) <= p[7]:","                count = model[1]","                mem['models'][action] = [tuple((model[0][i] * count + delta[i]) / (count + 1) for i in range(len(delta))), count + 1]","            else:","                mem['models'][action] = [delta, 1]","        else:","            mem['models'].pop(action, None)","    candidates = {}","    for o in objects:","        if o[5] > p[8]:","            continue","        c, x0, y0, x1, y1, area, cx, cy = o","        x, y = int(cx), int(cy)","        if int(frame[y, x]) != c:","            positions = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)","            middle = positions[len(positions) // 2]","            y, x = y0 + int(middle[0]), x0 + int(middle[1])","        candidates[(c, x, y)] = weights[c]","    if not candidates:","        if 6 in avail:","            return (6, int(p[9]), int(p[10]))","        return (avail[0], 0, 0)","    choices = []","    for action, priority in candidates.items():","        successes, trials = mem['effects'].get(action, [0, 0])","        value = -p[11] * priority + p[12] * mem['pairs'].get((state, action), 0)","        value += p[13] * (trials - successes) + p[14] * mem['uses'].get(action, 0)","        if trials == 0:","            value -= p[15]","        if successes:","            value -= p[16] * successes / max(1, trials)","        destination = mem['edges'].get((state, action))","        if destination is not None:","            value += p[17] * visits.get(destination, 0)","        model = mem['models'].get(action)","        if model is not None and model[1] >= int(p[18]):","            predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))","            value += p[19] * (objective(predicted, p) - objective(feature, p))","        if 'last' in mem and action == mem['last'][1]:","            value -= p[20] / (1 + mem['streak'] / max(1.0, p[21]))","        value -= p[22] * mem['wins'].get(action[0], 0)","        choices.append((value, action))","    choices.sort(key=lambda item: (item[0], item[1]))","    action = choices[0][1]","    if 'last' in mem and action == mem['last'][1]:","        mem['streak'] += 1","    else:","        mem['streak'] = 0","    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1","    mem['uses'][action] = mem['uses'].get(action, 0) + 1","    mem['last'] = (state, action, feature)","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)","def geometry(objects, q):","    result = []","    for colour in q[:3]:","        group = sorted([o for o in objects if o[0] == int(colour)], key=lambda o: (o[2], o[1]))","        if len(group) >= 2:","            best = None","            for i in range(len(group)):","                for j in range(i + 1, len(group)):","                    a, b = group[i], group[j]","                    distance = q[3] * abs(a[6] - b[6]) + q[4] * abs(a[7] - b[7])","                    if best is None or distance < best[0]:","                        best = (distance, a[6] - b[6], a[7] - b[7])","            result.extend([best[1], best[2]])","        else:","            result.extend([0.0, 0.0])","    return tuple(result)","def cost(v, q):","    return sum(q[3] * abs(v[i]) + q[4] * abs(v[i + 1]) for i in range(0, len(v), 2))","def credited(params, mem, frame, avail, info):","    q = params['search']","    if info.get('levels', 0) < int(q[5]):","        return early(params, mem, frame, avail, info)","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('searchlevel') != level:","        mem.clear()","        mem.update({'searchlevel': level, 'reset': reset, 'edges': {}, 'pairs': {}, 'visits': {}, 'effects': {}, 'models': {}, 'probes': {}, 'uses': {}})","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('last', None)","    weights = params['probe_colours']","    objects = components(frame, [i for i in range(len(weights)) if weights[i] > 0])","    state = tuple(int(v) for v in frame[int(q[6]):, :].flatten())","    feature = geometry(objects, q)","    score = cost(feature, q)","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, action, before = mem['last']","        changed = old != state","        mem['edges'].setdefault(old, {})[action] = state","        effect = mem['effects'].setdefault(action, [0, 0])","        effect[0] += int(changed)","        effect[1] += 1","        if changed:","            delta = tuple(feature[i] - before[i] for i in range(len(feature)))","            mem['models'][action] = delta","        else:","            mem['models'].pop(action, None)","    candidates = []","    for o in objects:","        if o[5] > q[7]:","            continue","        c, x0, y0, x1, y1, area, cx, cy = o","        x, y = int(cx), int(cy)","        if int(frame[y, x]) != c:","            cells = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)","            middle = cells[len(cells) // 2]","            x, y = x0 + int(middle[1]), y0 + int(middle[0])","        candidates.append((c, x, y))","    if not candidates:","        return (avail[0], int(q[8]), int(q[9]))","    unprobed = [a for a in candidates if mem['probes'].get(a, 0) == 0]","    if unprobed:","        unprobed.sort(key=lambda a: (-weights[a[0]], a[2], a[1]))","        action = unprobed[0]","    else:","        choices = []","        for a in candidates:","            successes, trials = mem['effects'].get(a, [0, 0])","            used = mem['pairs'].get((state, a), 0)","            value = -q[10] * weights[a[0]] + q[11] * used","            value += q[12] * (trials - successes) / max(1, trials)","            value += q[13] * mem['uses'].get(a, 0)","            destination = mem['edges'].get(state, {}).get(a)","            if destination == state:","                value += q[14]","            elif destination is not None:","                value += q[15] * visits.get(destination, 0)","            delta = mem['models'].get(a)","            if delta is not None:","                predicted = tuple(feature[i] + delta[i] for i in range(len(feature)))","                value += q[16] * (cost(predicted, q) - score)","            if successes:","                value -= q[17] * successes / max(1, trials)","            choices.append((value, a))","        choices.sort(key=lambda item: (item[0], item[1]))","        action = choices[0][1]","        if all(mem['pairs'].get((state, a), 0) > 0 for a in candidates):","            queue = [(state, None)]","            seen = {state}","            index = 0","            route = None","            while index < len(queue) and index < int(q[18]):","                node, first = queue[index]","                index += 1","                outgoing = mem['edges'].get(node, {})","                if node != state and any(mem['pairs'].get((node, a), 0) == 0 for a in candidates if a[0] == int(q[19])):","                    route = first","                    break","                for a, destination in outgoing.items():","                    if destination not in seen and destination != node:","                        seen.add(destination)","                        queue.append((destination, a if first is None else first))","            if route is not None and route in candidates:","                action = route","    mem['probes'][action] = mem['probes'].get(action, 0) + 1","    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1","    mem['uses'][action] = mem['uses'].get(action, 0) + 1","    mem['last'] = (state, action, feature)","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)","def layout(objects, r):","    agents = [o for o in objects if o[0] == int(r[2])]","    markers = [o for o in objects if o[0] == int(r[3])]","    platforms = [o for o in objects if o[0] == int(r[4])]","    tracks = [o for o in objects if o[0] == int(r[5])]","    vertical = sum(o[4] - o[2] for o in tracks) >= sum(o[3] - o[1] for o in tracks)","    axis = 6 if vertical else 7","    height = 7 if vertical else 6","    anchor = sorted(agents, key=lambda o: -o[5])","    if anchor:","        a = anchor[0]","        support = sorted(markers, key=lambda o: abs(o[6] - a[6]) + abs(o[7] - a[7]))","        player = support[0][height] if support and abs(support[0][axis] - a[axis]) <= r[6] else a[height]","        position = a[axis]","    else:","        player = r[7]","        position = r[7]","    targets = []","    for o in markers + platforms:","        if abs(o[axis] - position) > r[6]:","            targets.append((o[axis], o[height]))","    targets.sort()","    merged = []","    for a, h in targets:","        if merged and abs(a - merged[-1][0]) <= r[8]:","            old = merged[-1]","            merged[-1] = ((old[0] + a) / 2, (old[1] + h) / 2)","        else:","            merged.append((a, h))","    ahead = [t for t in merged if t[0] > position + r[6]]","    if not ahead:","        ahead = list(reversed([t for t in merged if t[0] < position - r[6]]))","    chosen = ahead[:int(r[9])]","    signature = (int(vertical), len(chosen)) + tuple(int(t[0]) for t in chosen)","    v = [position, player]","    for a, h in chosen:","        v.extend([a, h])","    return signature, tuple(v)","def alignment(v, r):","    score = -r[10] * v[0]","    previous = v[1]","    for i in range(2, len(v), 2):","        weight = r[11] if i == 2 else r[12]","        score += weight * abs(v[i + 1] - previous)","        previous = v[i + 1]","    return score","def act(params, mem, frame, avail, info):","    r = params['revision']","    if info.get('levels', 0) < int(r[0]):","        return credited(params, mem, frame, avail, info)","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('revisionlevel') != level:","        mem.clear()","        mem.update({'revisionlevel': level, 'reset': reset, 'edges': {}, 'pairs': {}, 'visits': {}, 'effects': {}, 'models': {}, 'probes': {}, 'uses': {}, 'options': {}, 'stall': 0})","    if mem.get('reset') != reset:","        if 'last' in mem:","            old, action, sig, before = mem['last']","            entry = mem['effects'].setdefault(action, [0, 0, 0])","            entry[2] += 1","        mem['reset'] = reset","        mem.pop('last', None)","        mem['stall'] = 0","    weights = params['alternative_colours']","    objects = components(frame, [i for i in range(len(weights)) if weights[i] > 0])","    state = tuple(int(v) for v in frame[int(r[1]):, :].flatten())","    sig, feature = layout(objects, r)","    score = alignment(feature, r)","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, action, oldsig, before = mem['last']","        changed = old != state","        mem['edges'].setdefault(old, {})[action] = state","        entry = mem['effects'].setdefault(action, [0, 0, 0])","        entry[0] += int(changed)","        entry[1] += 1","        if changed and sig == oldsig:","            delta = tuple(feature[i] - before[i] for i in range(len(feature)))","            modelkey = (action, sig)","            model = mem['models'].get(modelkey)","            if model is None or max(abs(delta[i] - model[0][i]) for i in range(len(delta))) > r[13]:","                mem['models'][modelkey] = (delta, 1)","            else:","                count = model[1]","                mem['models'][modelkey] = (tuple((model[0][i] * count + delta[i]) / (count + 1) for i in range(len(delta))), count + 1)","        if not changed or (sig == oldsig and score >= alignment(before, r) - r[14]):","            mem['stall'] += 1","        else:","            mem['stall'] = 0","    candidates = []","    for o in objects:","        if o[5] > r[15]:","            continue","        c, x0, y0, x1, y1, area, cx, cy = o","        x, y = int(cx), int(cy)","        if int(frame[y, x]) != c:","            cells = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)","            middle = cells[len(cells) // 2]","            y, x = y0 + int(middle[0]), x0 + int(middle[1])","        a = (c, x, y)","        if a not in candidates:","            candidates.append(a)","    if not candidates:","        return (avail[0], int(r[16]), int(r[17]))","    mem['options'][state] = list(candidates)","    choices = []","    for a in candidates:","        successes, trials, deaths = mem['effects'].get(a, [0, 0, 0])","        used = mem['pairs'].get((state, a), 0)","        value = -r[18] * weights[a[0]] + r[19] * used","        value += r[20] * (trials - successes) / max(1, trials) + r[21] * deaths","        value += r[22] * mem['uses'].get(a, 0)","        destination = mem['edges'].get(state, {}).get(a)","        if destination == state:","            value += r[23]","        elif destination is not None:","            value += r[24] * visits.get(destination, 0)","        if trials == 0:","            value -= r[25]","        model = mem['models'].get((a, sig))","        if model is not None:","            predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))","            improvement = alignment(predicted, r) - score","            value += r[26] * improvement","            if improvement < -r[14] and used == 0:","                value -= r[27]","        if 'last' in mem and a == mem['last'][1] and mem['stall'] >= int(r[28]):","            value += r[29] * mem['stall']","        choices.append((value, a))","    choices.sort(key=lambda item: (item[0], item[1]))","    action = choices[0][1]","    fresh = [a for a in candidates if mem['probes'].get(a, 0) == 0]","    if fresh and (mem['stall'] >= int(r[28]) or not any(mem['effects'].get(a, [0, 0, 0])[0] for a in candidates)):","        fresh.sort(key=lambda a: (-weights[a[0]], a[2], a[1]))","        action = fresh[0]","    if all(mem['pairs'].get((state, a), 0) > 0 for a in candidates):","        queue = [(state, None)]","        seen = {state}","        index = 0","        route = None","        while index < len(queue) and index < int(r[30]):","            node, first = queue[index]","            index += 1","            options = mem['options'].get(node, [])","            if node != state and any(mem['pairs'].get((node, a), 0) == 0 for a in options):","                route = first","                break","            for a, destination in mem['edges'].get(node, {}).items():","                if destination not in seen and destination != node:","                    seen.add(destination)","                    queue.append((destination, a if first is None else first))","        if route is not None and route in candidates:","            action = route","    mem['probes'][action] = mem['probes'].get(action, 0) + 1","    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1","    mem['uses'][action] = mem['uses'].get(action, 0) + 1","    mem['last'] = (state, action, sig, feature)","    if 6 in avail:","        return (6, action[1], action[2])","    return (avail[0], 0, 0)"],"shapes":{"colours":[16],"settings":[23],"probe_colours":[16],"search":[20],"alternative_colours":[16],"revision":[31]},"params":{"colours":[0,0,0,0,0.3,0.2,0,0,0,4,0,0.4,0,0,0,0],"settings":[1,11,4,5,0.5,1,0.25,0.2,256,32,32,4,90,8,0.025,6,14,35,2,2,3,8,4],"probe_colours":[0,0,0,0,0.3,0.2,0,0,0,4,0,0.4,0,0,0.4,0.4],"search":[11,14,15,0.25,1,2,1,256,32,32,4,28,35,0.015,300,12,5,18,800,9],"alternative_colours":[0,2.8,0,0,0.5,1.2,0,0,0,4,0,2,0,0,1.5,1.5],"revision":[3,1,4,11,1,5,4,32,3,5,1.5,3,0.35,0.5,0.1,400,32,32,4,90,100,120,0.03,500,35,24,9,12,3,35,900]},"rationale":"Preserves the credited cell's decisions exactly until three levels are completed. The fourth-level revision adds colour-1 components to the clickable candidates, compares actual successor states, penalizes unchanged clicks and fatal transitions, and switches components after repeated failure to improve. It learns component-specific motion models against an ordered chain of visible platforms and the player's support height, replacing the previous nearest-marker-pair objective. A stored transition graph routes back to states with untried component clicks, using each state's own candidate set. Exploration and learned effects survive resets within the unsolved level.","cannot_express":false}]