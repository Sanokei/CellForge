[{"game":"g50t","source_lines":["def blobs(frame, colour, low, high):","    unseen = set()","    for cell in np.argwhere(frame == colour):","        y, x = int(cell[0]), int(cell[1])","        if low <= y < high:","            unseen.add((y, x))","    out = []","    while unseen:","        seed = unseen.pop()","        todo = [seed]","        group = [seed]","        while todo:","            y, x = todo.pop()","            for q in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):","                if q in unseen:","                    unseen.remove(q)","                    todo.append(q)","                    group.append(q)","        ys = [q[0] for q in group]","        xs = [q[1] for q in group]","        out.append((min(ys),min(xs),max(ys),max(xs),len(group)))","    return out","def act(params, mem, frame, avail, info):","    p = params['settings']","    agentcolour, floorcolour, specialcolour = int(p[0]), int(p[1]), int(p[2])","    low, high = int(p[3]), int(p[4])","    radius = max(1,int(abs(p[5])))","    stride = max(1,int(abs(p[6])))","    level, reset = info.get('levels',0), info.get('resets',0)","    if mem.get('level') != level:","        wins = mem.get('wins',{})","        if 'last' in mem:","            a = mem['last'][1]","            wins[a] = wins.get(a,0)+1","        mem.clear()","        mem.update({'level':level,'reset':reset,'edges':{},'pairs':{},'visits':{},'effects':{},'vectors':{},'wins':wins,'stage':0,'touches':0})","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem['stage'] = 0","        mem['touches'] = 0","        mem.pop('last',None)","        mem.pop('position',None)","    objects = blobs(frame,agentcolour,low,high)","    oldpos = mem.get('position')","    candidates = []","    for g in objects:","        if g[2]-g[0]+1 <= int(p[7]) and g[3]-g[1]+1 <= int(p[7]) and g[4] >= int(p[8]):","            pos = ((g[0]+g[2])//2,(g[1]+g[3])//2)","            score = g[4]","            if oldpos is not None:","                score -= p[9]*(abs(pos[0]-oldpos[0])+abs(pos[1]-oldpos[1]))","            candidates.append((score,pos,g))","    order = [int(a) for a in params['order'] if int(a) in avail]","    if not order:","        order = list(avail)","    if not candidates:","        index = mem.get('fallback',0)","        mem['fallback'] = index+1","        return (order[index % len(order)],0,0)","    selected = max(candidates)","    pos, agent = selected[1], selected[2]","    state = tuple(int(v) for v in frame[low:high,:].flatten())","    visits = mem['visits']","    visits[state] = visits.get(state,0)+1","    edges, pairs = mem['edges'], mem['pairs']","    if 'last' in mem:","        before, action, previouspos = mem['last']","        edges.setdefault(before,{})[action] = state","        effect = mem['effects'].setdefault(action,[0,0])","        effect[0] += int(state != before)","        effect[1] += 1","        dy, dx = pos[0]-previouspos[0], pos[1]-previouspos[1]","        if dy or dx:","            if abs(dy)+abs(dx) <= p[10]:","                mem['vectors'][action] = (dy,dx)","    mem['position'] = pos","    goals = [g for g in objects if g != agent and g[4] >= int(p[11])]","    goal = pos","    if goals:","        g = max(goals,key=lambda g:g[4])","        goal = ((g[0]+g[2])//2,(g[1]+g[3])//2)","    switches = []","    for cell in np.argwhere(frame == specialcolour):","        y,x = int(cell[0]),int(cell[1])","        if low+radius <= y < high-radius and radius <= x < frame.shape[1]-radius:","            patch = frame[y-radius:y+radius+1,x-radius:x+radius+1]","            density = int(np.sum(patch == specialcolour))","            if density >= int(p[12]):","                switches.append((y*p[13]-density*p[14],y,x))","    target = goal","    if mem['stage'] == 0 and switches:","        switch = min(switches)","        target = (switch[1],switch[2])","        if abs(pos[0]-target[0])+abs(pos[1]-target[1]) <= p[15]:","            mem['touches'] += 1","            if mem['touches'] <= int(p[16]) and int(p[17]) in avail:","                action = int(p[17])","                pairs[(state,action)] = pairs.get((state,action),0)+1","                mem['last'] = (state,action,pos)","                return (action,0,0)","            mem['stage'] = 1","            target = goal","    elif not switches:","        mem['stage'] = 1","    directions = []","    for row in params['moves']:","        a = int(row[0])","        if a in avail:","            dy,dx = mem['vectors'].get(a,(int(row[1])*stride,int(row[2])*stride))","            directions.append((a,dy,dx))","    queue = [pos]","    costs = {pos:0.0}","    first = {}","    cursor = 0","    best = pos","    bestvalue = p[18]*(abs(pos[0]-target[0])+abs(pos[1]-target[1]))","    while cursor < len(queue) and cursor < int(p[19]):","        node = queue[cursor]","        cursor += 1","        for a,dy,dx in directions:","            q = (node[0]+dy,node[1]+dx)","            y,x = q","            if y-radius < low or y+radius >= high or x-radius < 0 or x+radius >= frame.shape[1]:","                continue","            patch = frame[y-radius:y+radius+1,x-radius:x+radius+1]","            valid = (patch == floorcolour)|(patch == agentcolour)|(patch == specialcolour)","            if not bool(np.all(valid)):","                continue","            initial = a if node == pos else first[node]","            observed = edges.get(state,{}).get(initial)","            penalty = 0.0","            if node == pos:","                penalty += p[20]*pairs.get((state,a),0)","                if observed == state:","                    penalty += p[21]","                elif observed is not None:","                    penalty += p[22]*visits.get(observed,0)","            hazard = int(np.sum(patch == specialcolour))","            if mem['stage'] == 0 and abs(y-target[0])+abs(x-target[1]) > p[15]:","                penalty += p[23]*hazard","            cost = costs[node]+p[24]+penalty","            if q in costs and costs[q] <= cost:","                continue","            costs[q] = cost","            first[q] = initial","            queue.append(q)","            value = cost+p[18]*(abs(y-target[0])+abs(x-target[1]))","            if value < bestvalue:","                bestvalue,best = value,q","    action = first.get(best)","    if action is None or visits[state] >= int(p[25]):","        untried = [a for a in order if pairs.get((state,a),0) == 0]","        if untried:","            action = untried[0]","        else:","            search = [(state,None)]","            seen = {state}","            cursor = 0","            route = None","            while cursor < len(search) and cursor < int(p[26]):","                node,initial = search[cursor]","                cursor += 1","                if node != state and any(pairs.get((node,a),0) == 0 for a in order):","                    route = initial","                    break","                for a,destination in edges.get(node,{}).items():","                    if destination not in seen:","                        seen.add(destination)","                        search.append((destination,a if initial is None else initial))","            if route is not None:","                action = route","            else:","                action = min(order,key=lambda a:p[27]*pairs.get((state,a),0)+p[28]*visits.get(edges.get(state,{}).get(a),0)-p[29]*mem['wins'].get(a,0))","    pairs[(state,action)] = pairs.get((state,action),0)+1","    mem['last'] = (state,action,pos)","    return (int(action),0,0)"],"shapes":{"settings":[30],"moves":[4,3],"order":[5]},"params":{"settings":[9,5,8,7,62,2,6,5,15,0.7,12,30,8,2,0.1,3,2,5,4,900,8,100,3,1.5,1,5,800,20,4,8],"moves":[[1,-1,0],[2,1,0],[3,0,-1],[4,0,1]],"order":[4,2,5,1,3]},"rationale":"The earlier policy headed directly toward the outlined destination and repeatedly reset. This revision first seeks the dense upper cyan endpoint, tests interaction there, then navigates toward the large destination. It learns movement vectors and action effects from observations, excludes the timer from state identity, retains transition knowledge across resets, and uses the donor's observed-state graph search to reach untested actions when navigation stalls. Colours, footprint, movement scale, switch selection, hazard costs, and exploration priorities are tensor controlled.","cannot_express":false}]