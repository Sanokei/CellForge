 "source_lines": [
  "def groups(frame, colour, lo, hi):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour) if lo <= p[0] < hi)",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        queue = [start]",
  "        cells = [start]",
  "        while queue:",
  "            r, c = queue.pop()",
  "            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    queue.append(q)",
  "                    cells.append(q)",
  "        result.append((min(p[0] for p in cells), min(p[1] for p in cells), max(p[0] for p in cells), max(p[1] for p in cells), len(cells)))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    cutoff = max(1, min(frame.shape[0], int(cfg[0])))",
  "    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:",
  "        motion = mem.get('motion', {})",
  "        effects = mem.get('effects', {})",
  "        mem.clear()",
  "        mem.update({'level': info['levels'], 'reset': info['resets'], 'motion': motion, 'effects': effects, 'blocked': set(), 'visits': {}, 'edges': {}, 'done': set(), 'stuck': 0})",
  "    signature = tuple(int(v) for v in frame[:cutoff].flatten())",
  "    heads = groups(frame, int(cfg[1]), 0, cutoff)",
  "    heads.sort(key=lambda b: -b[4])",
  "    head = heads[0] if heads else None",
  "    row = None",
  "    end = None",
  "    if head is not None:",
  "        row = (head[0] + head[2]) / 2",
  "        end = head[3]",
  "        for p in np.argwhere((frame == int(cfg[2])) | (frame == int(cfg[3]))):",
  "            if p[0] < cutoff and abs(float(p[0]) - row) <= cfg[4] and p[1] > head[3]:",
  "                end = max(end, int(p[1]))",
  "    targets = []",
  "    hud = []",
  "    for value in params['colours']:",
  "        colour = int(value)",
  "        upper = groups(frame, colour, 0, cutoff)",
  "        lower = groups(frame, colour, cutoff, frame.shape[0])",
  "        lower.sort(key=lambda b: -b[4])",
  "        if lower:",
  "            box = lower[0]",
  "            hud.append((box[1], colour))",
  "            interior = frame[box[0]:box[2] + 1, box[1]:box[3] + 1]",
  "            if np.any(interior == int(cfg[5])):",
  "                mem['done'].add(colour)",
  "        for box in upper:",
  "            if box[4] >= cfg[6]:",
  "                targets.append((colour, box))",
  "    hud.sort()",
  "    order = [p[1] for p in hud]",
  "    if not order:",
  "        order = [int(v) for v in params['colours']]",
  "    targets.sort(key=lambda t: (order.index(t[0]) if t[0] in order else len(order), t[1][1], t[1][0]))",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, token, oldrow, oldend, oldframe = old",
  "        mem['edges'][(oldsig, token)] = signature",
  "        if signature == oldsig:",
  "            mem['blocked'].add((oldsig, token))",
  "            mem['stuck'] += 1",
  "        else:",
  "            mem['stuck'] = 0",
  "        if token[0] != int(cfg[7]) and row is not None and oldrow is not None:",
  "            dr, de = row - oldrow, end - oldend",
  "            if cfg[8] <= abs(dr) + abs(de) <= cfg[9]:",
  "                mem['motion'][token[0]] = (dr, de)",
  "        if token[0] == int(cfg[7]):",
  "            delta = int(np.sum(frame[:cutoff] != oldframe[:cutoff]))",
  "            mem['effects'][token] = max(mem['effects'].get(token, 0), delta)",
  "    remaining = [t for t in targets if t[0] not in mem['done']]",
  "    if row is not None and remaining:",
  "        colour, box = remaining[0]",
  "        if abs(row - (box[0] + box[2]) / 2) <= cfg[4] and end >= box[3] + cfg[10]:",
  "            mem['done'].add(colour)",
  "            remaining = [t for t in targets if t[0] not in mem['done']]",
  "    goal = remaining[0][1] if remaining else None",
  "    visits = mem['visits'].setdefault(signature, {})",
  "    candidates = []",
  "    for i in range(len(params['actions'])):",
  "        action = int(params['actions'][i])",
  "        if action not in avail:",
  "            continue",
  "        token = (action, 0, 0)",
  "        dr, de = mem['motion'].get(action, (float(params['motion'][i][0]), float(params['motion'][i][1])))",
  "        score = cfg[11] - i * cfg[12]",
  "        if head is not None and goal is not None:",
  "            desired = (goal[0] + goal[2]) / 2",
  "            if abs(row - desired) > cfg[4]:",
  "                if end > head[3] + cfg[13]:",
  "                    score += cfg[14] * (-de) - cfg[15] * abs(dr)",
  "                else:",
  "                    score += cfg[14] * (abs(row - desired) - abs(row + dr - desired)) - cfg[15] * abs(de)",
  "            else:",
  "                score += cfg[14] * (abs(goal[3] + cfg[10] - end) - abs(goal[3] + cfg[10] - end - de)) - cfg[15] * abs(dr)",
  "        elif head is not None and targets:",
  "            score += cfg[16] * (-de)",
  "        candidates.append((score, token))",
  "    click = int(cfg[7])",
  "    if click in avail:",
  "        boxes = [t[1] for t in targets] + heads",
  "        for colour in params['colours']:",
  "            boxes.extend(groups(frame, int(colour), cutoff, frame.shape[0]))",
  "        for box in boxes:",
  "            x = int((box[1] + box[3]) / 2)",
  "            y = int((box[0] + box[2]) / 2)",
  "            token = (click, x, y)",
  "            score = cfg[17] + min(cfg[18], mem['stuck']) * cfg[19]",
  "            score += min(cfg[20], mem['effects'].get(token, 0)) * cfg[21]",
  "            candidates.append((score, token))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score, token in candidates:",
  "        score -= cfg[22] * visits.get(token, 0)",
  "        if (signature, token) in mem['blocked']:",
  "            score -= cfg[23]",
  "        successor = mem['edges'].get((signature, token))",
  "        if successor is not None:",
  "            score -= cfg[24] * sum(mem['visits'].get(successor, {}).values())",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = token",
  "    if best is None:",
  "        best = (avail[0], 0, 0)",
  "    visits[best] = visits.get(best, 0) + 1",
  "    mem['previous'] = (signature, best, row, end, frame.copy())",
  "    return best"
 ],
