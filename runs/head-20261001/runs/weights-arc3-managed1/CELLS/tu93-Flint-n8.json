 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    c = params['config']",
  "    colours = params['colours']",
  "    order = params['order']",
  "    directions = params['directions']",
  "    h = max(1, min(frame.shape[0], int(c[0])))",
  "    board = frame[:h]",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    points = np.argwhere(board == int(colours[0]))",
  "    targets = np.argwhere(board == int(colours[1]))",
  "    signature = tuple(int(v) for v in board.flatten())",
  "    records = mem.setdefault('records', {})",
  "    record = records.setdefault(level, {'visits': {}, 'bad': {}, 'edges': {}, 'prefix': [], 'best': float(c[12])})",
  "    previous = mem.get('previous')",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem['path'] = []",
  "        mem['replay'] = list(record['prefix'])",
  "    position = None",
  "    if len(points):",
  "        position = (int(points[0][0]), int(points[0][1]))",
  "    motion = mem.setdefault('motion', {})",
  "    if previous is not None:",
  "        oldlevel, oldreset, oldsig, oldpos, action, oldframe = previous",
  "        oldrecord = records.setdefault(oldlevel, {'visits': {}, 'bad': {}, 'edges': {}, 'prefix': [], 'best': float(c[12])})",
  "        edge = (oldsig, action)",
  "        if level == oldlevel and reset == oldreset:",
  "            oldrecord['edges'][edge] = signature",
  "            if position is not None and oldpos is not None:",
  "                dr = position[0] - oldpos[0]",
  "                dx = position[1] - oldpos[1]",
  "                if c[1] <= abs(dr) + abs(dx) <= c[2] and (dr == 0 or dx == 0):",
  "                    motion[action] = (dr, dx)",
  "                if position == oldpos:",
  "                    oldrecord['bad'][edge] = oldrecord['bad'].get(edge, 0) + c[3]",
  "        elif level == oldlevel:",
  "            oldrecord['bad'][edge] = oldrecord['bad'].get(edge, 0) + c[4]",
  "        elif level > oldlevel:",
  "            mem.setdefault('solutions', {})[oldlevel] = list(mem.get('path', []))",
  "    moves = []",
  "    for i in range(len(order)):",
  "        action = int(order[i])",
  "        if action in avail:",
  "            dr, dx = motion.get(action, (int(directions[i][0]), int(directions[i][1])))",
  "            moves.append((action, dr, dx, i))",
  "    hazards = np.zeros(board.shape)",
  "    for colour in params['hazards']:",
  "        hazards = hazards + (board == int(colour))",
  "    predicted = hazards.copy()",
  "    if previous is not None and previous[0] == level and previous[1] == reset:",
  "        oldmarkers = np.argwhere(previous[5] == int(colours[2]))",
  "        markers = np.argwhere(board == int(colours[2]))",
  "        for marker in markers:",
  "            if len(oldmarkers):",
  "                distances = np.sum(np.abs(oldmarkers - marker), axis=1)",
  "                oldmarker = oldmarkers[int(np.argmin(distances))]",
  "                dr = int(marker[0] - oldmarker[0])",
  "                dx = int(marker[1] - oldmarker[1])",
  "                if abs(dr) + abs(dx) <= c[5]:",
  "                    r = int(marker[0]) + dr",
  "                    x = int(marker[1]) + dx",
  "                    radius = int(c[6])",
  "                    for rr in range(max(0, r - radius), min(h, r + radius + 1)):",
  "                        for xx in range(max(0, x - radius), min(board.shape[1], x + radius + 1)):",
  "                            predicted[rr, xx] = 1",
  "    goals = []",
  "    if len(targets):",
  "        remaining = set((int(p[0]), int(p[1])) for p in targets)",
  "        while remaining:",
  "            p = next(iter(remaining))",
  "            remaining.remove(p)",
  "            queue = [p]",
  "            component = []",
  "            while queue:",
  "                r, x = queue.pop()",
  "                component.append((r, x))",
  "                for q in ((r - 1, x), (r + 1, x), (r, x - 1), (r, x + 1)):",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        queue.append(q)",
  "            goals.append((int(round(sum(p[0] for p in component) / len(component))), int(round(sum(p[1] for p in component) / len(component)))))",
  "    routes = {}",
  "    if position is not None and goals:",
  "        queue = list(goals)",
  "        distances = {g: 0.0 for g in goals}",
  "        done = set()",
  "        while queue and len(done) < int(c[7]):",
  "            bestindex = 0",
  "            for i in range(1, len(queue)):",
  "                if distances[queue[i]] < distances[queue[bestindex]]:",
  "                    bestindex = i",
  "            p = queue.pop(bestindex)",
  "            if p in done:",
  "                continue",
  "            done.add(p)",
  "            for action, dr, dx, rank in moves:",
  "                q = (p[0] - dr, p[1] - dx)",
  "                if q[0] < 0 or q[1] < 0 or q[0] >= h or q[1] >= board.shape[1]:",
  "                    continue",
  "                length = max(abs(dr), abs(dx))",
  "                clear = length > 0",
  "                danger = 0",
  "                for t in range(length + 1):",
  "                    r = q[0] + int(round(dr * t / max(1, length)))",
  "                    x = q[1] + int(round(dx * t / max(1, length)))",
  "                    value = int(board[r, x])",
  "                    if not any(value == int(v) for v in params['passable']):",
  "                        clear = False",
  "                        break",
  "                    if hazards[r, x] > 0:",
  "                        danger = 1",
  "                if clear:",
  "                    cost = distances[p] + c[8] + c[9] * danger",
  "                    if q not in distances or cost < distances[q]:",
  "                        distances[q] = cost",
  "                        routes[q] = action",
  "                        queue.append(q)",
  "        proximity = min(abs(position[0] - g[0]) + abs(position[1] - g[1]) for g in goals)",
  "        if proximity < record['best']:",
  "            record['best'] = proximity",
  "            record['prefix'] = list(mem.get('path', []))",
  "    visits = record['visits']",
  "    visits[signature] = visits.get(signature, 0) + 1",
  "    replay = mem.get('replay', [])",
  "    preferred = None",
  "    if replay:",
  "        expected, action = replay.pop(0)",
  "        if expected == signature and record['bad'].get((signature, action), 0) < c[10]:",
  "            preferred = action",
  "        else:",
  "            mem['replay'] = []",
  "    best = None",
  "    bestscore = -float(c[12])",
  "    for action, dr, dx, rank in moves:",
  "        score = -c[11] * rank",
  "        edge = (signature, action)",
  "        score -= record['bad'].get(edge, 0)",
  "        destination = record['edges'].get(edge)",
  "        if destination is not None:",
  "            score -= c[13] * visits.get(destination, 0)",
  "        else:",
  "            score += c[14]",
  "        if position is not None:",
  "            q = (position[0] + dr, position[1] + dx)",
  "            length = max(abs(dr), abs(dx))",
  "            clear = length > 0",
  "            danger = False",
  "            for t in range(1, length + 1):",
  "                r = position[0] + int(round(dr * t / length))",
  "                x = position[1] + int(round(dx * t / length))",
  "                if r < 0 or x < 0 or r >= h or x >= board.shape[1]:",
  "                    clear = False",
  "                    break",
  "                if not any(int(board[r, x]) == int(v) for v in params['passable']):",
  "                    clear = False",
  "                    break",
  "                if predicted[r, x] > 0:",
  "                    danger = True",
  "            if clear:",
  "                score += c[15]",
  "                if goals:",
  "                    score -= c[16] * distances.get(q, float(c[17]))",
  "                if routes.get(position) == action:",
  "                    score += c[18]",
  "                if danger:",
  "                    score -= c[19]",
  "            else:",
  "                score -= c[20]",
  "                if routes.get(position) is not None:",
  "                    score += c[21]",
  "        if preferred == action:",
  "            score += c[22]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = action",
  "    if best is None:",
  "        best = avail[0]",
  "    mem.setdefault('path', []).append((signature, best))",
  "    mem['previous'] = (level, reset, signature, position, best, board.copy())",
  "    mem['level'] = level",
  "    mem['reset'] = reset",
  "    return (int(best), 0, 0)"
 ],
