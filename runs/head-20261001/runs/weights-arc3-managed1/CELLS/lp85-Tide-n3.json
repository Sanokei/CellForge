 "source_lines": [
  "def objects(frame, params):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    result = []",
  "    height, width = frame.shape",
  "    for y in range(height):",
  "        for x in range(width):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or params['colour'][c] <= 0:",
  "                continue",
  "            seen[y, x] = True",
  "            todo = [(y, x)]",
  "            cells = []",
  "            while todo:",
  "                cy, cx = todo.pop()",
  "                cells.append((cy, cx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = cy + dy, cx + dx",
  "                    if 0 <= ny < height and 0 <= nx < width and not seen[ny, nx] and frame[ny, nx] == c:",
  "                        seen[ny, nx] = True",
  "                        todo.append((ny, nx))",
  "            area = len(cells)",
  "            if not params['geometry'][0] <= area <= params['geometry'][1]:",
  "                continue",
  "            ys = [p[0] for p in cells]",
  "            xs = [p[1] for p in cells]",
  "            ymin, ymax = min(ys), max(ys)",
  "            xmin, xmax = min(xs), max(xs)",
  "            cy = (ymin + ymax) // 2",
  "            cx = (xmin + xmax) // 2",
  "            point = min(cells, key=lambda p: abs(p[0] - cy) + abs(p[1] - cx))",
  "            priority = float(params['colour'][c])",
  "            if params['geometry'][2] <= cy <= params['geometry'][3]:",
  "                priority += params['priority'][0]",
  "            if xmax - xmin == ymax - ymin:",
  "                priority += params['priority'][1]",
  "            if area <= params['geometry'][4]:",
  "                priority += params['priority'][2]",
  "            if max(xmax - xmin, ymax - ymin) > params['geometry'][5]:",
  "                priority -= params['priority'][3]",
  "            result.append(((6, point[1], point[0]), priority, c))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['nodes'] = {}",
  "        mem['effects'] = {}",
  "        mem['uses'] = {}",
  "        mem['blocked'] = set()",
  "    nodes = mem['nodes']",
  "    key = info.get('key', '')",
  "    if not key:",
  "        key = tuple(int(v) for v in frame.flatten())",
  "    node = nodes.setdefault(key, {'edges': {}, 'tried': {}, 'visits': 0, 'choices': {}, 'bad': set()})",
  "    node['visits'] += 1",
  "    changed_reset = mem.get('reset', reset) != reset",
  "    if 'last' in mem:",
  "        oldkey, action, oldframe = mem['last']",
  "        oldnode = nodes[oldkey]",
  "        changed = bool(np.any(frame != oldframe))",
  "        if changed_reset:",
  "            oldnode['bad'].add(action)",
  "            oldnode['edges'].pop(action, None)",
  "            mem['blocked'].clear()",
  "        else:",
  "            oldnode['edges'][action] = key",
  "            effect = mem['effects'].setdefault(action, [0, 0])",
  "            effect[0] += 1",
  "            if changed:",
  "                effect[1] += 1",
  "                mem['blocked'].clear()",
  "            else:",
  "                oldnode['bad'].add(action)",
  "                mem['blocked'].add(action)",
  "    mem['reset'] = reset",
  "    choices = {}",
  "    if 6 in avail:",
  "        for action, priority, colour in objects(frame, params):",
  "            if level > 0:",
  "                priority += params['control'][colour]",
  "            choices[action] = max(choices.get(action, -1000000), priority)",
  "    for action in avail:",
  "        if action != 6:",
  "            choices[(action, 0, 0)] = params['priority'][4]",
  "    node['choices'] = choices",
  "    def frontier(current):",
  "        record = nodes[current]",
  "        best = None",
  "        bestscore = -1000000000",
  "        for action, priority in record['choices'].items():",
  "            if action in record['tried'] or action in record['bad']:",
  "                continue",
  "            if current == key and action in mem['blocked']:",
  "                continue",
  "            effect = mem['effects'].get(action, [0, 0])",
  "            score = priority + params['priority'][5] * effect[1] / max(1, effect[0])",
  "            score -= params['priority'][6] * mem['uses'].get(action, 0)",
  "            if score > bestscore:",
  "                best, bestscore = action, score",
  "        return best, bestscore",
  "    best, route_score = frontier(key)",
  "    queue = [(key, None, 0)]",
  "    reached = {key}",
  "    head = 0",
  "    while head < len(queue) and head < int(params['search'][0]):",
  "        current, first, distance = queue[head]",
  "        head += 1",
  "        candidate, score = frontier(current)",
  "        if candidate is not None and first is not None:",
  "            score -= params['priority'][7] * distance",
  "            if score > route_score:",
  "                route_score = score",
  "                best = first",
  "        if distance >= int(params['search'][1]):",
  "            continue",
  "        record = nodes[current]",
  "        for action, destination in record['edges'].items():",
  "            if action in record['bad'] or destination == current or destination in reached or destination not in nodes:",
  "                continue",
  "            if current == key and (action not in choices or action in mem['blocked']):",
  "                continue",
  "            reached.add(destination)",
  "            queue.append((destination, action if first is None else first, distance + 1))",
  "    if best is None:",
  "        bestscore = -1000000000",
  "        for action, priority in choices.items():",
  "            if action in node['bad'] or action in mem['blocked']:",
  "                continue",
  "            destination = node['edges'].get(action)",
  "            if destination == key:",
  "                continue",
  "            effect = mem['effects'].get(action, [0, 0])",
  "            score = priority + params['priority'][5] * effect[1] / max(1, effect[0])",
  "            score -= params['priority'][8] * node['tried'].get(action, 0)",
  "            score -= params['priority'][9] * nodes.get(destination, {}).get('visits', 0)",
  "            if score > bestscore:",
  "                bestscore, best = score, action",
  "    if best is None and 6 in avail:",
  "        candidates = []",
  "        stride = max(1, int(params['probe'][0]))",
  "        for y in range(int(params['probe'][1]), frame.shape[0], stride):",
  "            for x in range(int(params['probe'][1]), frame.shape[1], stride):",
  "                colour = int(frame[y, x])",
  "                action = (6, x, y)",
  "                if params['colour'][colour] > 0 and action not in node['tried'] and action not in mem['blocked']:",
  "                    score = params['colour'][colour] + params['control'][colour]",
  "                    candidates.append((score, action))",
  "        if candidates:",
  "            best = max(candidates, key=lambda p: p[0])[1]",
  "            node['choices'][best] = params['priority'][4]",
  "    if best is None:",
  "        best = (avail[0], int(params['fallback'][0]), int(params['fallback'][1]))",
  "    node['tried'][best] = node['tried'].get(best, 0) + 1",
  "    mem['uses'][best] = mem['uses'].get(best, 0) + 1",
  "    mem['last'] = (key, best, frame.copy())",
  "    return best"
 ],
