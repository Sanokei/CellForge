 "source_lines": [
  "def objects(frame, colour):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        point = next(iter(remaining))",
  "        remaining.remove(point)",
  "        todo = [point]",
  "        group = [point]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    group.append(q)",
  "        rows = [p[0] for p in group]",
  "        cols = [p[1] for p in group]",
  "        result.append((min(rows), max(rows), min(cols), max(cols), len(group)))",
  "    return result",
  "def values_at(params, frame, slots):",
  "    cfg = params['config']",
  "    radius = int(cfg[8])",
  "    colours = [int(v) for v in params['colours']]",
  "    values = []",
  "    for r, c in slots:",
  "        patch = frame[max(0, r - radius):min(frame.shape[0], r + radius + 1), max(0, c - radius):min(frame.shape[1], c + radius + 1)]",
  "        counts = [(int(np.sum(patch == colour)), colour) for colour in colours]",
  "        counts.sort(reverse=True)",
  "        values.append(counts[0][1] if counts and counts[0][0] >= cfg[9] else int(cfg[3]))",
  "    return tuple(values)",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    click, submit, wait = [int(v) for v in cfg[:3]]",
  "    empty = int(cfg[3])",
  "    colours = [int(v) for v in params['colours']]",
  "    transition = mem.get('level') != info['levels'] or mem.get('reset') != info['resets']",
  "    if transition:",
  "        mem.clear()",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['attempts'] = {}",
  "        mem['failures'] = {}",
  "        mem['outcomes'] = {}",
  "        refs = []",
  "        slots = []",
  "        for colour in colours + [empty]:",
  "            for r0, r1, c0, c1, area in objects(frame, colour):",
  "                r = int(round((r0 + r1) / 2))",
  "                c = int(round((c0 + c1) / 2))",
  "                if colour != empty and r1 < cfg[4]:",
  "                    refs.append((c, colour))",
  "                elif r0 >= cfg[5] and area <= cfg[7] and r1 - r0 <= cfg[10] and c1 - c0 <= cfg[10]:",
  "                    slots.append((r, c))",
  "        mem['targets'] = [colour for c, colour in sorted(refs)]",
  "        mem['slots'] = sorted(set(slots))",
  "        mem['destinations'] = [i for i, p in enumerate(mem['slots']) if p[0] < cfg[6]]",
  "    slots = mem['slots']",
  "    targets = mem['targets']",
  "    destinations = mem['destinations']",
  "    values = values_at(params, frame, slots)",
  "    signature = values",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        before, identity, oldframe = previous",
  "        changed = bool(np.any(frame[:int(cfg[6]), :] != oldframe[:int(cfg[6]), :])) or before != values",
  "        record = mem['outcomes'].setdefault(identity, [0, 0])",
  "        record[0 if changed else 1] += 1",
  "        if not changed:",
  "            token = (before, identity)",
  "            mem['failures'][token] = mem['failures'].get(token, 0) + 1",
  "    pending = mem.pop('pending', None)",
  "    if pending is not None:",
  "        source, destination, before = pending",
  "        if click in avail and source < len(values) and values[source] != empty:",
  "            r, c = slots[destination]",
  "            identity = ('place', source, destination)",
  "            mem['checking'] = (before, source, destination)",
  "            mem['previous'] = (values, identity, frame.copy())",
  "            return (click, c, r)",
  "    checking = mem.pop('checking', None)",
  "    if checking is not None:",
  "        before, source, destination = checking",
  "        token = (before, ('move', source, destination))",
  "        if values == before:",
  "            mem['failures'][token] = mem['failures'].get(token, 0) + 1",
  "        else:",
  "            mem['outcomes'][('transfer', source, destination)] = [before[source], values[destination]]",
  "    desired = {}",
  "    for j in range(min(len(destinations), len(targets))):",
  "        desired[destinations[j]] = targets[j]",
  "    wrong = [i for i in destinations if i in desired and values[i] != desired[i]]",
  "    moves = []",
  "    for rank, destination in enumerate(wrong):",
  "        target = desired[destination]",
  "        sources = [i for i in range(len(slots)) if values[i] == target and i != destination and (i not in desired or values[i] != desired[i])]",
  "        if values[destination] == empty:",
  "            for source in sources:",
  "                moves.append((cfg[11] - rank * cfg[12], source, destination))",
  "        elif sources:",
  "            for spare in range(len(slots)):",
  "                if values[spare] == empty and spare != destination:",
  "                    score = cfg[13] - rank * cfg[12]",
  "                    if spare not in destinations:",
  "                        score += cfg[14]",
  "                    elif spare in desired and desired[spare] == values[destination]:",
  "                        score += cfg[15]",
  "                    moves.append((score, destination, spare))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score, source, destination in moves:",
  "        identity = ('move', source, destination)",
  "        score -= cfg[16] * mem['failures'].get((signature, identity), 0)",
  "        score -= cfg[17] * mem['attempts'].get((signature, identity), 0)",
  "        score -= cfg[18] * mem['failures'].get((signature, ('pick', source)), 0)",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (source, destination)",
  "    if best is not None and bestscore > cfg[19] and click in avail:",
  "        source, destination = best",
  "        identity = ('move', source, destination)",
  "        token = (signature, identity)",
  "        mem['attempts'][token] = mem['attempts'].get(token, 0) + 1",
  "        mem['pending'] = (source, destination, values)",
  "        mem['previous'] = (values, ('pick', source), frame.copy())",
  "        r, c = slots[source]",
  "        return (click, c, r)",
  "    candidates = []",
  "    if submit in avail:",
  "        candidates.append((cfg[20] if not wrong and desired else cfg[21], ('key', submit), submit, 0, 0))",
  "    if click in avail:",
  "        for i, (r, c) in enumerate(slots):",
  "            score = cfg[22] if values[i] != empty else cfg[23]",
  "            candidates.append((score, ('probe', i), click, c, r))",
  "    if wait in avail:",
  "        candidates.append((cfg[24], ('key', wait), wait, 0, 0))",
  "    chosen = None",
  "    bestscore = -1000000",
  "    for score, identity, action, x, y in candidates:",
  "        token = (signature, identity)",
  "        score -= cfg[25] * mem['attempts'].get(token, 0)",
  "        score -= cfg[26] * mem['failures'].get(token, 0)",
  "        if score > bestscore:",
  "            bestscore = score",
  "            chosen = (identity, action, x, y)",
  "    if chosen is None:",
  "        chosen = (('key', avail[0]), avail[0], 0, 0)",
  "    identity, action, x, y = chosen",
  "    token = (signature, identity)",
  "    mem['attempts'][token] = mem['attempts'].get(token, 0) + 1",
  "    mem['previous'] = (values, identity, frame.copy())",
  "    return (action, int(x), int(y))"
 ],
