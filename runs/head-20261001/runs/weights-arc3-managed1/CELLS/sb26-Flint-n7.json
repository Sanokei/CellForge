 "source_lines": [
  "def components(frame, colour):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        todo = [start]",
  "        group = [start]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for point in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if point in remaining:",
  "                    remaining.remove(point)",
  "                    todo.append(point)",
  "                    group.append(point)",
  "        r = sum(p[0] for p in group) / len(group)",
  "        c = sum(p[1] for p in group) / len(group)",
  "        pixel = min(group, key=lambda p: abs(p[0] - r) + abs(p[1] - c))",
  "        result.append((r, c, pixel[0], pixel[1], len(group)))",
  "    return sorted(result, key=lambda p: (p[0], p[1]))",
  "def act(params, mem, frame, avail, info):",
  "    q = params['config']",
  "    click = int(q[0])",
  "    blank = int(q[1])",
  "    bg = int(q[2])",
  "    border = int(q[3])",
  "    objects = []",
  "    refs = []",
  "    for cv in params['palette']:",
  "        colour = int(cv)",
  "        if colour == bg or colour == border or colour == blank:",
  "            continue",
  "        for obj in components(frame, colour):",
  "            r, c, pr, pc, area = obj",
  "            if r < q[4] and area >= q[5]:",
  "                refs.append((c, colour))",
  "            elif r > q[4] and q[6] <= area <= q[7]:",
  "                objects.append((r, c, pr, pc, colour, area))",
  "    refs.sort()",
  "    targets = [v[1] for v in refs]",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        history = mem.get('history', {})",
  "        mem.clear()",
  "        mem['history'] = history",
  "        mem['epoch'] = epoch",
  "        mem['visits'] = {}",
  "        mem['failed'] = {}",
  "        mem['edges'] = {}",
  "        mem['probed'] = []",
  "        mem['slots'] = []",
  "        for obj in components(frame, blank):",
  "            if q[8] < obj[0] < q[9] and obj[4] <= q[10]:",
  "                mem['slots'].append((int(round(obj[0])), int(round(obj[1]))))",
  "        mem['slots'].sort()",
  "        mem['pending'] = None",
  "        mem['stall'] = 0",
  "    slots = mem['slots']",
  "    values = tuple(int(frame[r, c]) for r, c in slots)",
  "    rows = []",
  "    for r in range(frame.shape[0]):",
  "        timer = np.sum((frame[r] == int(q[11])) | (frame[r] == int(q[12])))",
  "        if timer < q[13]:",
  "            rows.append(tuple(int(v) for v in frame[r]))",
  "    state = tuple(rows)",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        previous_state, identity, previous_frame, previous_values = old",
  "        delta = np.argwhere(frame != previous_frame)",
  "        changed_colours = []",
  "        for p in delta:",
  "            r, c = int(p[0]), int(p[1])",
  "            changed_colours.append((int(previous_frame[r, c]), int(frame[r, c])))",
  "        mem['history'][(epoch[0], identity)] = (len(delta), tuple(set(changed_colours)), values != previous_values)",
  "        mem['edges'][(previous_state, identity)] = state",
  "        if state == previous_state:",
  "            pair = (state, identity)",
  "            mem['failed'][pair] = mem['failed'].get(pair, 0) + 1",
  "            mem['stall'] += 1",
  "        else:",
  "            mem['stall'] = 0",
  "    visits = mem['visits'].setdefault(state, {})",
  "    candidates = []",
  "    pending = mem.get('pending')",
  "    if pending is not None and click in avail:",
  "        r, c, target_index = pending",
  "        candidates.append((q[14], ('destination', target_index, r, c), click, c, r, None))",
  "        mem['pending'] = None",
  "    mismatch = [i for i in range(min(len(slots), len(targets))) if values[i] != targets[i]]",
  "    focus = mismatch[0] if mismatch else -1",
  "    if click in avail:",
  "        for i in mismatch:",
  "            r, c = slots[i]",
  "            desired = targets[i]",
  "            for obj in objects:",
  "                sr, sc, pr, pc, colour, area = obj",
  "                if colour != desired:",
  "                    continue",
  "                source_slot = -1",
  "                for j in range(len(slots)):",
  "                    tr, tc = slots[j]",
  "                    if abs(sr - tr) + abs(sc - tc) <= q[15]:",
  "                        source_slot = j",
  "                if source_slot == i:",
  "                    continue",
  "                score = q[16] + (q[17] if i == focus else 0)",
  "                if sr > q[18]:",
  "                    score += q[19]",
  "                if source_slot >= 0 and source_slot < len(targets) and values[source_slot] == targets[source_slot]:",
  "                    score -= q[20]",
  "                identity = ('transfer', i, colour, pr, pc)",
  "                candidates.append((score, identity, click, pc, pr, (r, c, i)))",
  "            candidates.append((q[21] + (q[22] if i == focus else 0), ('slot', i), click, c, r, None))",
  "        empty = []",
  "        for obj in components(frame, blank):",
  "            if obj[0] > q[18] and obj[4] <= q[10]:",
  "                empty.append((int(round(obj[0])), int(round(obj[1]))))",
  "        for i in mismatch:",
  "            if values[i] == blank or values[i] == bg:",
  "                continue",
  "            r, c = slots[i]",
  "            for er, ec in empty:",
  "                score = q[23] + (q[24] if i == focus else 0)",
  "                candidates.append((score, ('evacuate', i, er, ec), click, c, r, (er, ec, -1)))",
  "        for obj in objects:",
  "            r, c, pr, pc, colour, area = obj",
  "            candidates.append((q[25], ('object', colour, pr, pc), click, pc, pr, None))",
  "        for i in range(len(slots)):",
  "            r, c = slots[i]",
  "            candidates.append((q[26], ('inspect', i), click, c, r, None))",
  "    for rank in range(len(params['keys'])):",
  "        action = int(params['keys'][rank])",
  "        if action in avail:",
  "            score = q[27] - rank * q[28]",
  "            if action not in mem['probed']:",
  "                score += q[29]",
  "            if slots and not mismatch:",
  "                score += q[30]",
  "            if mem['stall'] >= q[31]:",
  "                score += q[32]",
  "            candidates.append((score, ('key', action), action, 0, 0, None))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score, identity, action, x, y, plan in candidates:",
  "        score -= q[33] * visits.get(identity, 0)",
  "        score -= q[34] * mem['failed'].get((state, identity), 0)",
  "        result = mem['edges'].get((state, identity))",
  "        if result is not None:",
  "            score -= q[35]",
  "            if result in mem['visits']:",
  "                score -= q[36]",
  "        if identity[0] == 'destination':",
  "            score += q[37]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity, action, x, y, plan)",
  "    if best is None:",
  "        best = (('fallback', avail[0]), avail[0], 0, 0, None)",
  "    identity, action, x, y, plan = best",
  "    visits[identity] = visits.get(identity, 0) + 1",
  "    if identity[0] == 'key' and action not in mem['probed']:",
  "        mem['probed'].append(action)",
  "    mem['pending'] = plan",
  "    mem['previous'] = (state, identity, frame.copy(), values)",
  "    return (action, max(0, min(frame.shape[1] - 1, int(x))), max(0, min(frame.shape[0] - 1, int(y))))"
 ],
