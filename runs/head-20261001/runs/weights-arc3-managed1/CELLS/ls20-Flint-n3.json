 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    c = params['colors']",
  "    q = params['cfg']",
  "    directions = params['directions']",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['phase'] = 0",
  "        mem['blocked'] = {}",
  "        mem['visits'] = {}",
  "        mem['attempts'] = {}",
  "        mem['fail'] = 0",
  "        mem['effects'] = {}",
  "        mem['probe'] = []",
  "        mem['switches'] = {}",
  "    advanced = level >= int(q[19])",
  "    stride = max(1, int(abs(q[0])))",
  "    half = max(0, int(abs(q[1])))",
  "    ceiling = int(q[20]) if advanced else int(q[2])",
  "    points = np.argwhere(frame == int(c[0]))",
  "    points = [p for p in points if int(p[0]) < ceiling and int(p[1]) > int(q[7])]",
  "    if len(points) == 0:",
  "        return (avail[int(abs(q[3])) % len(avail)], 0, 0)",
  "    x = int(sum(int(p[1]) for p in points) / len(points) + q[4])",
  "    y = int(sum(int(p[0]) for p in points) / len(points) + q[5])",
  "    pos = (x, y)",
  "    old = mem.get('pos')",
  "    last = mem.get('last')",
  "    phase = mem['phase']",
  "    blocked = mem['blocked']",
  "    signature = ()",
  "    if advanced:",
  "        signature = tuple(int(frame[py, px]) for py in range(max(0, y-half), min(ceiling, y+half+1)) for px in range(max(0, x-half), min(frame.shape[1], x+half+1)))",
  "    if old is not None and last is not None:",
  "        if old == pos:",
  "            if not advanced or signature == mem.get('signature'):",
  "                blocked[(phase, old, last)] = True",
  "            mem['fail'] += 1",
  "        else:",
  "            mem['fail'] = 0",
  "            dx = pos[0] - old[0]",
  "            dy = pos[1] - old[1]",
  "            if abs(dx) + abs(dy) > 0 and abs(dx) + abs(dy) < q[6]:",
  "                mem['stride'] = abs(dx) + abs(dy)",
  "        if advanced:",
  "            changed = int(np.sum(frame[:ceiling, int(q[7]):] != mem['frame'][:ceiling, int(q[7]):]))",
  "            effect = (pos[0]-old[0], pos[1]-old[1], changed, signature != mem.get('signature'))",
  "            mem['effects'][last] = effect",
  "            if effect[3]:",
  "                mem['blocked'] = {}",
  "                blocked = mem['blocked']",
  "                mem['switches'][old] = mem['switches'].get(old, 0) + 1",
  "    stride = int(mem.get('stride', stride))",
  "    markers = np.argwhere((frame == int(c[2])) | (frame == int(c[3])))",
  "    targets = [(int(p[1]), int(p[0])) for p in markers if int(p[0]) < ceiling and int(p[1]) > int(q[7])]",
  "    touched = any(abs(x-tx) <= half and abs(y-ty) <= half for tx, ty in targets)",
  "    if phase == 0 and (touched or len(targets) == 0):",
  "        phase = 1",
  "        mem['phase'] = phase",
  "        mem['fail'] = 0",
  "        mem['goalsteps'] = 0",
  "    goals = []",
  "    for p in np.argwhere(frame == int(c[1])):",
  "        py = int(p[0])",
  "        px = int(p[1])",
  "        if not advanced:",
  "            if py < int(q[8]):",
  "                goals.append((px, py))",
  "        elif py < ceiling and px > int(q[7]):",
  "            patch = frame[max(0,py-1):min(ceiling,py+2), max(0,px-1):min(frame.shape[1],px+2)]",
  "            if np.any(patch == int(c[5])):",
  "                goals.append((px, py))",
  "    goal = None",
  "    if len(goals) > 0:",
  "        goal = (int(sum(p[0] for p in goals)/len(goals)), int(sum(p[1] for p in goals)/len(goals)))",
  "    if phase == 1:",
  "        mem['goalsteps'] = mem.get('goalsteps', 0) + 1",
  "        near = goal is not None and abs(x-goal[0])+abs(y-goal[1]) <= q[9]",
  "        if (near and mem['fail'] >= int(q[10])) or mem['goalsteps'] > int(q[11]):",
  "            phase = 0",
  "            mem['phase'] = phase",
  "            mem['blocked'] = {}",
  "            blocked = mem['blocked']",
  "            mem['fail'] = 0",
  "            mem['goalsteps'] = 0",
  "    if phase == 1 and goal is not None:",
  "        targets = [goal]",
  "    if len(targets) == 0 and goal is not None:",
  "        targets = [goal]",
  "    visits = mem['visits']",
  "    visitkey = (phase, pos, signature) if advanced else (phase, pos)",
  "    visits[visitkey] = visits.get(visitkey, 0) + 1",
  "    legal = []",
  "    for row in directions:",
  "        action = int(row[0])",
  "        if action in avail:",
  "            legal.append((action, int(row[1]), int(row[2]), float(row[3])))",
  "    if len(legal) == 0:",
  "        return (avail[0], 0, 0)",
  "    if advanced:",
  "        objects = []",
  "        seen = set()",
  "        for p in np.argwhere(frame == int(c[6])):",
  "            px = int(p[1])",
  "            py = int(p[0])",
  "            if py >= ceiling or px <= int(q[7]) or (px,py) in seen:",
  "                continue",
  "            component = [(px,py)]",
  "            seen.add((px,py))",
  "            head = 0",
  "            while head < len(component):",
  "                cx, cy = component[head]",
  "                head += 1",
  "                for ox, oy in ((1,0),(-1,0),(0,1),(0,-1)):",
  "                    nx, ny = cx+ox, cy+oy",
  "                    if 0 <= nx < frame.shape[1] and 0 <= ny < ceiling and (nx,ny) not in seen and int(frame[ny,nx]) == int(c[6]):",
  "                        seen.add((nx,ny))",
  "                        component.append((nx,ny))",
  "            if len(component) >= int(q[21]):",
  "                objects.append((int(sum(p[0] for p in component)/len(component)), int(sum(p[1] for p in component)/len(component))))",
  "        if phase == 0:",
  "            targets = targets + objects",
  "        mem['objects'] = objects",
  "    queue = [pos]",
  "    first = {pos: None}",
  "    depth = {pos: 0}",
  "    head = 0",
  "    best = None",
  "    bestscore = -1000000.0",
  "    attempts = mem['attempts']",
  "    state = (phase, pos, signature) if advanced else (phase, pos, info['key'])",
  "    counts = attempts.setdefault(state, {})",
  "    while head < len(queue) and head < int(q[12]):",
  "        node = queue[head]",
  "        head += 1",
  "        if node != pos:",
  "            distance = 1000",
  "            for tx, ty in targets:",
  "                d = max(0, abs(node[0]-tx)-half) + max(0, abs(node[1]-ty)-half)",
  "                if advanced and phase == 0:",
  "                    d += mem['switches'].get((tx,ty), 0) * q[22]",
  "                distance = min(distance, d)",
  "            if len(targets) == 0:",
  "                distance = 0",
  "            vk = (phase,node,signature) if advanced else (phase,node)",
  "            score = -distance*q[13] - depth[node]*q[14] - visits.get(vk,0)*q[15]",
  "            if advanced:",
  "                score -= counts.get(first[node],0)*q[23]",
  "            if score > bestscore:",
  "                bestscore = score",
  "                best = first[node]",
  "        for action, dx, dy, priority in legal:",
  "            if blocked.get((phase,node,action),False):",
  "                continue",
  "            dest = (node[0]+dx*stride, node[1]+dy*stride)",
  "            if dest in first:",
  "                continue",
  "            valid = True",
  "            for offset in range(1,stride+1):",
  "                cx = node[0]+dx*offset",
  "                cy = node[1]+dy*offset",
  "                for oy in (-half,0,half):",
  "                    for ox in (-half,0,half):",
  "                        px, py = cx+ox, cy+oy",
  "                        if px < 0 or px >= frame.shape[1] or py < 0 or py >= ceiling:",
  "                            valid = False",
  "                        else:",
  "                            color = int(frame[py,px])",
  "                            if color == int(c[4]):",
  "                                valid = False",
  "                            if color == int(c[5]):",
  "                                if advanced:",
  "                                    if goal is None or abs(px-goal[0]) > q[24] or abs(py-goal[1]) > q[24]:",
  "                                        valid = False",
  "                                elif not (py < int(q[8]) and px > int(q[7])):",
  "                                    valid = False",
  "            if valid:",
  "                first[dest] = action if node == pos else first[node]",
  "                depth[dest] = depth[node]+1",
  "                queue.append(dest)",
  "    if advanced:",
  "        pending = [a for a,dx,dy,p in legal if a not in mem['probe']]",
  "        if len(pending) > 0:",
  "            best = pending[0]",
  "            mem['probe'].append(best)",
  "        elif visits.get(visitkey,0) > int(q[25]):",
  "            best = None",
  "    if best is None:",
  "        scorebest = -1000000.0",
  "        for action, dx, dy, priority in legal:",
  "            dest = (x+dx*stride,y+dy*stride)",
  "            vk = (phase,dest,signature) if advanced else (phase,dest)",
  "            score = priority-counts.get(action,0)*q[16]-visits.get(vk,0)*q[17]",
  "            if blocked.get((phase,pos,action),False):",
  "                score -= q[18]",
  "            if score > scorebest:",
  "                scorebest = score",
  "                best = action",
  "    counts[best] = counts.get(best,0)+1",
  "    if advanced and visits.get(visitkey,0) > int(q[26]):",
  "        mem['phase'] = 0",
  "        mem['goalsteps'] = 0",
  "    mem['pos'] = pos",
  "    mem['last'] = best",
  "    mem['signature'] = signature",
  "    if advanced:",
  "        mem['frame'] = frame.copy()",
  "    return (best,0,0)"
 ],
