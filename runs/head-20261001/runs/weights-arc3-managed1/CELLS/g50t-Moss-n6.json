 "source_lines": [
  "def groups(frame, color, low, high):",
  "    unseen = set()",
  "    for p in np.argwhere(frame == color):",
  "        y, x = int(p[0]), int(p[1])",
  "        if low <= y < high:",
  "            unseen.add((y, x))",
  "    result = []",
  "    while unseen:",
  "        seed = unseen.pop()",
  "        stack = [seed]",
  "        points = [seed]",
  "        while stack:",
  "            y, x = stack.pop()",
  "            for v in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):",
  "                if v in unseen:",
  "                    unseen.remove(v)",
  "                    stack.append(v)",
  "                    points.append(v)",
  "        ys = [v[0] for v in points]",
  "        xs = [v[1] for v in points]",
  "        result.append((min(ys),min(xs),max(ys),max(xs),len(points)))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    c = params['cfg']",
  "    level = info.get('levels',0)",
  "    epoch = (level,info.get('resets',0))",
  "    if mem.get('epoch') != epoch:",
  "        vectors = mem.get('vectors',{})",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "        mem['vectors'] = vectors",
  "        mem['blocked'] = {}",
  "        mem['visits'] = {}",
  "        mem['attempts'] = {}",
  "        mem['tested'] = {}",
  "        mem['done'] = {}",
  "        mem['age'] = 0",
  "    low, high = int(c[3]), int(c[4])",
  "    objects = groups(frame,int(c[0]),low,high)",
  "    old = mem.get('pos')",
  "    candidates = []",
  "    goals = []",
  "    for g in objects:",
  "        h, w = g[2]-g[0]+1,g[3]-g[1]+1",
  "        center = ((g[0]+g[2])//2,(g[1]+g[3])//2)",
  "        if h <= int(c[5]) and w <= int(c[5]) and g[4] >= int(c[6]):",
  "            score = g[4]",
  "            if old is not None:",
  "                score -= c[7]*(abs(center[0]-old[0])+abs(center[1]-old[1]))",
  "            candidates.append((score,center))",
  "        elif h >= int(c[8]) and w >= int(c[8]):",
  "            goals.append(center)",
  "    if not candidates:",
  "        order = [int(v) for v in params['order'] if int(v) in avail]",
  "        if not order:",
  "            order = list(avail)",
  "        t = mem.get('fallback',0)",
  "        mem['fallback'] = t+1",
  "        return (order[t % len(order)],0,0)",
  "    pos = max(candidates)[1]",
  "    vectors = mem['vectors']",
  "    blocked = mem['blocked']",
  "    tested = mem['tested']",
  "    prior = mem.get('last')",
  "    if prior is not None and old is not None:",
  "        dy, dx = pos[0]-old[0],pos[1]-old[1]",
  "        tested[prior] = tested.get(prior,0)+1",
  "        if abs(dy)+abs(dx) > 0 and abs(dy)+abs(dx) <= c[9]:",
  "            vectors[prior] = (dy,dx)",
  "            blocked.pop((old,prior),None)",
  "        elif pos == old:",
  "            blocked[(old,prior)] = blocked.get((old,prior),0)+1",
  "        previous = mem.get('board')",
  "        if previous is not None:",
  "            changed = int(np.sum(frame[low:high] != previous))",
  "            if changed > int(c[10]):",
  "                mem['progress'] = mem.get('progress',0)+1",
  "                if pos == old:",
  "                    blocked.pop((old,prior),None)",
  "    visits = mem['visits']",
  "    visits[pos] = visits.get(pos,0)+1",
  "    mem['age'] += 1",
  "    markers = []",
  "    half = max(1,int(abs(c[11])))",
  "    for p in np.argwhere(frame == int(c[2])):",
  "        y,x = int(p[0]),int(p[1])",
  "        if low+half <= y < high-half and half <= x < frame.shape[1]-half:",
  "            density = int(np.sum(frame[y-half:y+half+1,x-half:x+half+1] == int(c[2])))",
  "            if density >= int(c[12]):",
  "                markers.append((density,y,x))",
  "    markers.sort(reverse=True)",
  "    targets = []",
  "    for density,y,x in markers:",
  "        if all(abs(y-v[0])+abs(x-v[1]) > c[13] for v in targets):",
  "            targets.append((y,x))",
  "    done = mem['done']",
  "    for target in targets:",
  "        if abs(pos[0]-target[0])+abs(pos[1]-target[1]) <= c[14]:",
  "            done[target] = done.get(target,0)+1",
  "    pending = [v for v in targets if done.get(v,0) < int(c[15])]",
  "    if pending:",
  "        target = min(pending,key=lambda v: abs(v[0]-pos[0])+abs(v[1]-pos[1]))",
  "    elif goals:",
  "        target = min(goals,key=lambda v: abs(v[0]-pos[0])+abs(v[1]-pos[1]))",
  "    else:",
  "        target = pos",
  "    signature = (pos,tuple(targets),tuple(goals),int(np.sum(frame[low:high] == int(c[2]))))",
  "    counts = mem['attempts'].setdefault(signature,{})",
  "    directions = []",
  "    for row in params['moves']:",
  "        a = int(row[0])",
  "        if a in avail:",
  "            dy,dx = vectors.get(a,(int(row[1])*int(c[16]),int(row[2])*int(c[16])))",
  "            directions.append((a,dy,dx,float(row[3])))",
  "    action = None",
  "    for v in params['order']:",
  "        a = int(v)",
  "        if a in avail and tested.get(a,0) < int(c[17]):",
  "            action = a",
  "            break",
  "    if action is None:",
  "        queue = [pos]",
  "        first = {pos:None}",
  "        depth = {pos:0}",
  "        head = 0",
  "        bestscore = -1000000.0",
  "        best = None",
  "        while head < len(queue) and head < int(c[18]):",
  "            node = queue[head]",
  "            head += 1",
  "            if node != pos:",
  "                distance = max(0,abs(node[0]-target[0])+abs(node[1]-target[1])-c[14])",
  "                score = -c[19]*distance-c[20]*depth[node]-c[21]*visits.get(node,0)",
  "                if score > bestscore:",
  "                    bestscore,best = score,first[node]",
  "            for a,dy,dx,priority in directions:",
  "                if blocked.get((node,a),0) >= int(c[22]):",
  "                    continue",
  "                dest = (node[0]+dy,node[1]+dx)",
  "                if dest in first:",
  "                    continue",
  "                valid = True",
  "                length = max(abs(dy),abs(dx),1)",
  "                for offset in range(1,length+1):",
  "                    y = node[0]+dy*offset//length",
  "                    x = node[1]+dx*offset//length",
  "                    if y < low or y >= high or x < 0 or x >= frame.shape[1]:",
  "                        valid = False",
  "                        break",
  "                    color = int(frame[y,x])",
  "                    if color != int(c[0]) and color != int(c[1]) and color != int(c[2]):",
  "                        valid = False",
  "                        break",
  "                if valid:",
  "                    first[dest] = a if node == pos else first[node]",
  "                    depth[dest] = depth[node]+1",
  "                    queue.append(dest)",
  "        action = best",
  "        near = abs(pos[0]-target[0])+abs(pos[1]-target[1]) <= c[14]",
  "        interact = int(c[23])",
  "        if near and interact in avail and counts.get(interact,0) < int(c[24]):",
  "            action = interact",
  "        if action is None or counts.get(action,0) >= int(c[25]):",
  "            options = []",
  "            for a,dy,dx,priority in directions:",
  "                dest = (pos[0]+dy,pos[1]+dx)",
  "                score = priority-c[26]*counts.get(a,0)-c[27]*blocked.get((pos,a),0)-c[28]*visits.get(dest,0)",
  "                options.append((score,a))",
  "            if interact in avail:",
  "                options.append((-c[26]*counts.get(interact,0)-c[27]*blocked.get((pos,interact),0),interact))",
  "            if options:",
  "                action = max(options)[1]",
  "            else:",
  "                action = avail[0]",
  "    counts[action] = counts.get(action,0)+1",
  "    mem['pos'] = pos",
  "    mem['last'] = action",
  "    mem['board'] = frame[low:high].copy()",
  "    return (int(action),0,0)"
 ],
