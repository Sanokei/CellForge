 "source_lines": [
  "def groups(frame, colour, radius):",
  "    remaining = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        seed = remaining.pop()",
  "        todo = [seed]",
  "        cells = [seed]",
  "        while todo:",
  "            y, x = todo.pop()",
  "            for dy in range(-radius, radius + 1):",
  "                for dx in range(-radius, radius + 1):",
  "                    q = (y + dy, x + dx)",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        cells.append(q)",
  "                        todo.append(q)",
  "        result.append(cells)",
  "    return result",
  "def centre(cells):",
  "    return (sum(q[1] for q in cells) / len(cells), sum(q[0] for q in cells) / len(cells))",
  "def dist(a, b):",
  "    return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    directions = params['directions']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['models'] = {}",
  "        mem['uses'] = {}",
  "        mem['pairs'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "    if mem.get('reset') != reset:",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "    endpoints = []",
  "    active = None",
  "    for colour in [int(p[0]), int(p[1])]:",
  "        for g in groups(frame, colour, int(p[2])):",
  "            if p[3] <= len(g) <= p[4]:",
  "                q = centre(g)",
  "                endpoints.append(q)",
  "                if colour == int(p[0]):",
  "                    active = q",
  "    balls = [centre(g) for g in groups(frame, int(p[5]), int(p[2])) if len(g) <= p[6]]",
  "    targets = []",
  "    for colour in params['shells']:",
  "        c = int(colour)",
  "        for g in groups(frame, c, int(p[7])):",
  "            q = centre(g)",
  "            xs = [v[1] for v in g]",
  "            ys = [v[0] for v in g]",
  "            if p[8] <= len(g) <= p[9] and max(xs) - min(xs) >= p[10] and max(ys) - min(ys) >= p[10]:",
  "                if all(dist(q, b) > p[11] ** 2 for b in balls) and all(dist(q, e) > p[12] ** 2 for e in endpoints):",
  "                    targets.append((q, c))",
  "    if not endpoints or not balls or not targets:",
  "        choices = endpoints + balls + [q for q, c in targets]",
  "        if choices:",
  "            key = info.get('key', '')",
  "            counts = mem.setdefault('fallback', {})",
  "            q = min(choices, key=lambda v: counts.get((key, int(v[0]), int(v[1])), 0))",
  "            tag = (key, int(q[0]), int(q[1]))",
  "            counts[tag] = counts.get(tag, 0) + 1",
  "            return (avail[0], int(round(q[0])), int(round(q[1])))",
  "        return (avail[0], int(p[13]), int(p[14]))",
  "    endpoints.sort(key=lambda q: (q[1], q[0]))",
  "    balls.sort(key=lambda q: (q[1], q[0]))",
  "    key = info.get('key', '')",
  "    mem['visits'][key] = mem['visits'].get(key, 0) + 1",
  "    assignments = []",
  "    for b in balls:",
  "        x = max(0, min(frame.shape[1] - 1, int(round(b[0]))))",
  "        y = max(0, min(frame.shape[0] - 1, int(round(b[1]))))",
  "        shell = int(frame[y, max(0, x - int(p[15]))])",
  "        matching = [t for t, c in targets if c == shell]",
  "        if not matching:",
  "            matching = [t for t, c in targets]",
  "        assignments.append(min(matching, key=lambda t: dist(b, t)))",
  "    if 'last' in mem:",
  "        oldkey, oldend, oldballs, tag, oldframe, selected = mem['last']",
  "        changed = int(np.sum(frame != oldframe))",
  "        mem['edges'][(oldkey, tag)] = key",
  "        if changed <= p[16]:",
  "            mem['blocked'][(oldkey, tag)] = True",
  "        if not selected and active is not None and len(oldballs) == len(balls):",
  "            movement = (active[0] - oldend[0], active[1] - oldend[1])",
  "            if p[17] ** 2 < dist(active, oldend) < p[18] ** 2:",
  "                remaining = list(balls)",
  "                observed = []",
  "                for b in oldballs:",
  "                    q = min(remaining, key=lambda v: dist(b, v))",
  "                    remaining.remove(q)",
  "                    observed.append((q[0] - b[0], q[1] - b[1]))",
  "                signature = tag[0]",
  "                model = mem['models'].setdefault((signature, tag[1]), [0.0, 0.0, 0.0])",
  "                nearest = min(range(len(oldballs)), key=lambda i: dist(oldballs[i], oldend))",
  "                model[0] += observed[nearest][0]",
  "                model[1] += observed[nearest][1]",
  "                model[2] += 1.0",
  "    best = None",
  "    bestscore = float('inf')",
  "    for endpoint in endpoints:",
  "        selected = active is None or dist(endpoint, active) > p[19] ** 2",
  "        nearest = min(range(len(balls)), key=lambda i: dist(endpoint, balls[i]))",
  "        ball = balls[nearest]",
  "        target = assignments[nearest]",
  "        signature = (nearest, int(round((endpoint[0] - ball[0]) / max(p[20], 1))), int(round((endpoint[1] - ball[1]) / max(p[20], 1))))",
  "        for i in range(len(directions)):",
  "            ux, uy = directions[i]",
  "            norm = max((ux * ux + uy * uy) ** 0.5, p[21])",
  "            dx, dy = p[22] * ux / norm, p[22] * uy / norm",
  "            nx, ny = endpoint[0] + dx, endpoint[1] + dy",
  "            if nx < p[23] or ny < p[23] or nx > p[24] or ny > p[24]:",
  "                continue",
  "            valid = True",
  "            for fraction in params['fractions']:",
  "                x = int(round(endpoint[0] + fraction * dx))",
  "                y = int(round(endpoint[1] + fraction * dy))",
  "                if int(frame[y, x]) in [int(p[25]), int(p[26])]:",
  "                    valid = False",
  "            if not valid:",
  "                continue",
  "            tag = (signature, i)",
  "            if not selected and mem['blocked'].get((key, tag), False):",
  "                continue",
  "            bx, by = p[27] * dx, p[27] * dy",
  "            model = mem['models'].get((signature, i))",
  "            if model is not None and model[2] >= p[28]:",
  "                bx, by = model[0] / model[2], model[1] / model[2]",
  "            predicted = (ball[0] + bx, ball[1] + by)",
  "            score = dist(predicted, target) - dist(ball, target)",
  "            score += p[29] * (dist((nx, ny), target) - dist(endpoint, target))",
  "            score += p[30] * float(selected)",
  "            score += p[31] * mem['pairs'].get((key, tag), 0)",
  "            nxt = mem['edges'].get((key, tag))",
  "            if nxt is not None:",
  "                score += p[32] * mem['visits'].get(nxt, 0)",
  "            score += p[33] * mem['uses'].get(tag, 0)",
  "            if score < bestscore:",
  "                bestscore = score",
  "                best = (endpoint, i, tag, selected)",
  "    if best is None:",
  "        endpoint = min(endpoints, key=lambda q: dist(q, assignments[0]))",
  "        best = (endpoint, 0, ((0, 0, 0), 0), active is None or dist(endpoint, active) > p[19] ** 2)",
  "    endpoint, i, tag, selected = best",
  "    if selected:",
  "        x, y = endpoint",
  "        record = (tag[0], -1)",
  "    else:",
  "        ux, uy = directions[i]",
  "        norm = max((ux * ux + uy * uy) ** 0.5, p[21])",
  "        x = endpoint[0] + p[34] * ux / norm",
  "        y = endpoint[1] + p[34] * uy / norm",
  "        record = tag",
  "    mem['pairs'][(key, record)] = mem['pairs'].get((key, record), 0) + 1",
  "    mem['uses'][record] = mem['uses'].get(record, 0) + 1",
  "    mem['last'] = (key, endpoint, balls, record, frame.copy(), selected)",
  "    return (6 if 6 in avail else avail[0], max(0, min(int(p[24]), int(round(x)))), max(0, min(int(p[24]), int(round(y)))))"
 ],
