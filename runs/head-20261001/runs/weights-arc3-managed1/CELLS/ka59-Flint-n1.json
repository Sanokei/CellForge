 "source_lines": [
  "def components(frame, colour, limit):",
  "    points = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while points:",
  "        start = points.pop()",
  "        queue = [start]",
  "        cells = [start]",
  "        index = 0",
  "        while index < len(queue):",
  "            y, x = queue[index]",
  "            index += 1",
  "            for dy, dx in ((0, 1), (0, -1), (1, 0), (-1, 0)):",
  "                point = (y + dy, x + dx)",
  "                if point in points:",
  "                    points.remove(point)",
  "                    queue.append(point)",
  "                    cells.append(point)",
  "        if len(cells) > 1 and len(cells) <= limit:",
  "            y = int(round(sum(p[0] for p in cells) / len(cells)))",
  "            x = int(round(sum(p[1] for p in cells) / len(cells)))",
  "            result.append((x, y))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    c = [int(round(v)) for v in params['config']]",
  "    ring, goal, floor, gate, wall, player, crate, stride, budget, area, clicklimit, height = c",
  "    moves = [(int(round(r[0])), int(round(r[1])), int(round(r[2]))) for r in params['moves']]",
  "    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:",
  "        mem.clear()",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['phase'] = 0",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['clicks'] = []",
  "    objects = components(frame, ring, max(1, area))",
  "    targets = components(frame, goal, max(1, area))",
  "    targets = [p for p in targets if p[1] < height]",
  "    actor = None",
  "    box = None",
  "    for x, y in objects:",
  "        if int(frame[y, x]) == player:",
  "            actor = (x, y)",
  "        elif int(frame[y, x]) == crate:",
  "            box = (x, y)",
  "    if actor is None and objects:",
  "        actor = objects[0]",
  "    if box is None:",
  "        for point in objects:",
  "            if point != actor:",
  "                box = point",
  "                break",
  "    key = info['key']",
  "    visits = mem['visits']",
  "    visits[key] = visits.get(key, 0) + 1",
  "    state = None",
  "    if actor is not None and box is not None:",
  "        state = actor + box",
  "    edges = mem['edges']",
  "    if state is not None and mem.get('previous') is not None:",
  "        old = mem['previous']",
  "        action = mem['action']",
  "        edges[(old, action)] = state",
  "        if old != state and old[2:] == state[2:]:",
  "            dx = state[0] - old[0]",
  "            dy = state[1] - old[1]",
  "            if abs(dx) + abs(dy) == abs(stride):",
  "                learned = mem.setdefault('directions', {})",
  "                learned[action] = (dx, dy)",
  "    directions = mem.get('directions', {})",
  "    moves = [(a, directions.get(a, (dx, dy))[0], directions.get(a, (dx, dy))[1]) for a, dx, dy in moves if a in avail]",
  "    action = None",
  "    click = (0, 0)",
  "    phase = mem['phase']",
  "    if phase < 2 * len(moves) and moves:",
  "        probe = moves[phase // 2]",
  "        if phase % 2 == 0:",
  "            action = probe[0]",
  "        else:",
  "            for a, dx, dy in moves:",
  "                if dx == -probe[1] and dy == -probe[2]:",
  "                    action = a",
  "                    break",
  "        mem['phase'] = phase + 1",
  "    elif not mem.get('click_ready'):",
  "        candidates = []",
  "        for colour in (ring, goal, gate, floor):",
  "            for point in components(frame, colour, max(1, area)):",
  "                if point[1] < height and point not in candidates:",
  "                    candidates.append(point)",
  "        mem['clicks'] = candidates[:max(0, clicklimit)]",
  "        mem['click_ready'] = True",
  "    if action is None and 6 in avail and mem['clicks']:",
  "        click = mem['clicks'].pop(0)",
  "        action = 6",
  "        mem['previous'] = None",
  "    if action is None and state is not None and stride > 0 and len(targets) >= 2:",
  "        board = set()",
  "        radius = stride // 2",
  "        allowed = set((floor, gate, goal, ring, player, crate))",
  "        for y in range(actor[1] % stride, min(height, frame.shape[0]), stride):",
  "            for x in range(actor[0] % stride, frame.shape[1], stride):",
  "                valid = True",
  "                for yy in range(y - radius, y + radius + 1):",
  "                    for xx in range(x - radius, x + radius + 1):",
  "                        if yy < 0 or xx < 0 or yy >= frame.shape[0] or xx >= frame.shape[1]:",
  "                            valid = False",
  "                        elif int(frame[yy, xx]) not in allowed:",
  "                            valid = False",
  "                if valid:",
  "                    board.add((x, y))",
  "        signature = (tuple(sorted(board)), int(np.sum(frame[:max(0, height)] == gate)))",
  "        if mem.get('terrain') != signature:",
  "            mem['terrain'] = signature",
  "            edges.clear()",
  "        queue = [state]",
  "        parents = {state: None}",
  "        first = {state: None}",
  "        index = 0",
  "        best = None",
  "        bestscore = None",
  "        terminal = None",
  "        cap = max(1, budget) * max(1, len(board))",
  "        while index < len(queue) and index < cap:",
  "            current = queue[index]",
  "            index += 1",
  "            ax, ay, bx, by = current",
  "            distance = None",
  "            solved = False",
  "            for t in targets:",
  "                for u in targets:",
  "                    if t == u:",
  "                        continue",
  "                    d = abs(ax - t[0]) + abs(ay - t[1]) + abs(bx - u[0]) + abs(by - u[1])",
  "                    if distance is None or d < distance:",
  "                        distance = d",
  "                    if (ax, ay) == t and (bx, by) == u:",
  "                        solved = True",
  "            if solved and current != state:",
  "                terminal = current",
  "                break",
  "            if current != state:",
  "                score = distance + float(params['search'][0]) * index / max(1, len(board))",
  "                score += float(params['search'][1]) * mem.get('position_visits', {}).get(current, 0)",
  "                if bestscore is None or score < bestscore:",
  "                    bestscore = score",
  "                    best = current",
  "            for a, dx, dy in moves:",
  "                edge = (current, a)",
  "                if edge in edges:",
  "                    following = edges[edge]",
  "                else:",
  "                    destination = (ax + dx, ay + dy)",
  "                    if destination not in board:",
  "                        continue",
  "                    newbox = (bx, by)",
  "                    if destination == newbox:",
  "                        newbox = (bx + dx, by + dy)",
  "                        if newbox not in board:",
  "                            continue",
  "                    following = destination + newbox",
  "                if following == current or following in parents:",
  "                    continue",
  "                parents[following] = current",
  "                first[following] = a if current == state else first[current]",
  "                queue.append(following)",
  "        chosen = terminal if terminal is not None else best",
  "        if chosen is not None:",
  "            action = first[chosen]",
  "        positions = mem.setdefault('position_visits', {})",
  "        positions[state] = positions.get(state, 0) + 1",
  "    if action is None:",
  "        candidates = []",
  "        for a, dx, dy in moves:",
  "            destination = edges.get((state, a)) if state is not None else None",
  "            score = mem.setdefault('fallback_counts', {}).get((key, a), 0)",
  "            if destination == state:",
  "                score += max(1, budget)",
  "            candidates.append((score, a))",
  "        if candidates:",
  "            candidates.sort()",
  "            action = candidates[0][1]",
  "            counts = mem['fallback_counts']",
  "            counts[(key, action)] = counts.get((key, action), 0) + 1",
  "        else:",
  "            action = avail[0]",
  "    if action == 6 and click == (0, 0):",
  "        candidates = objects + targets + components(frame, gate, max(1, area))",
  "        if candidates:",
  "            n = mem.get('extra_click', 0)",
  "            click = candidates[n % len(candidates)]",
  "            mem['extra_click'] = n + 1",
  "    if action != 6:",
  "        mem['previous'] = state",
  "        mem['action'] = action",
  "    else:",
  "        mem['previous'] = None",
  "    return (action, int(click[0]), int(click[1]))"
