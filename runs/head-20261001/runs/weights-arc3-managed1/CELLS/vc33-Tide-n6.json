{
 "game": "vc33",
 "house": "Tide",
 "n": 6,
 "source_lines": [
  "def components(frame, colours):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(1, frame.shape[0]):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c not in colours:",
  "                continue",
  "            todo = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while todo:",
  "                yy, xx = todo.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if 1 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                        seen[ny, nx] = True",
  "                        todo.append((ny, nx))",
  "            xs = [v[1] for v in cells]",
  "            ys = [v[0] for v in cells]",
  "            out.append((c, min(xs), min(ys), max(xs), max(ys), len(cells), sum(xs) / len(xs), sum(ys) / len(ys)))",
  "    return out",
  "def features(objects, p):",
  "    markers = sorted([o for o in objects if o[0] == int(p[1])], key=lambda o: (-o[5], o[2], o[1]))",
  "    agents = [o for o in objects if o[0] == int(p[2])]",
  "    tracks = [o for o in objects if o[0] == int(p[3])]",
  "    result = []",
  "    for i in range(2):",
  "        if i < len(markers):",
  "            result.extend([markers[i][6], markers[i][7]])",
  "        else:",
  "            result.extend([-1.0, -1.0])",
  "    for group in [agents, tracks]:",
  "        if group:",
  "            total = sum(o[5] for o in group)",
  "            result.extend([sum(o[6] * o[5] for o in group) / total, sum(o[7] * o[5] for o in group) / total])",
  "        else:",
  "            result.extend([-1.0, -1.0])",
  "    return tuple(result)",
  "def objective(v, p):",
  "    score = 0.0",
  "    if min(v[:4]) >= 0:",
  "        score += p[4] * abs(v[0] - v[2]) + p[5] * abs(v[1] - v[3])",
  "    if min(v[4:]) >= 0:",
  "        score += p[6] * abs(v[5] - v[7])",
  "    return score",
  "def early(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    weights = params['colours']",
  "    colours = [i for i in range(len(weights)) if weights[i] > 0]",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        wins = mem.get('wins', {})",
  "        if mem.get('level', level) < level and 'last' in mem:",
  "            previous = mem['last'][1]",
  "            wins[previous[0]] = wins.get(previous[0], 0) + 1",
  "        mem.clear()",
  "        mem.update({'level': level, 'reset': reset, 'wins': wins, 'pairs': {}, 'visits': {}, 'effects': {}, 'uses': {}, 'models': {}, 'edges': {}, 'streak': 0})",
  "    objects = components(frame, colours)",
  "    state = tuple(int(v) for v in frame[int(p[0]):, :].flatten())",
  "    feature = features(objects, p)",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if 'last' in mem:",
  "        old, action, before = mem['last']",
  "        changed = old != state",
  "        entry = mem['effects'].setdefault(action, [0, 0])",
  "        entry[0] += int(changed)",
  "        entry[1] += 1",
  "        mem['edges'][(old, action)] = state",
  "        if changed:",
  "            delta = tuple(feature[i] - before[i] for i in range(len(feature)))",
  "            model = mem['models'].get(action)",
  "            if model is None:",
  "                mem['models'][action] = [delta, 1]",
  "            elif max(abs(delta[i] - model[0][i]) for i in range(len(delta))) <= p[7]:",
  "                count = model[1]",
  "                mem['models'][action] = [tuple((model[0][i] * count + delta[i]) / (count + 1) for i in range(len(delta))), count + 1]",
  "            else:",
  "                mem['models'][action] = [delta, 1]",
  "        else:",
  "            mem['models'].pop(action, None)",
  "    candidates = {}",
  "    for o in objects:",
  "        if o[5] > p[8]:",
  "            continue",
  "        c, x0, y0, x1, y1, area, cx, cy = o",
  "        x, y = int(cx), int(cy)",
  "        if int(frame[y, x]) != c:",
  "            positions = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)",
  "            middle = positions[len(positions) // 2]",
  "            y, x = y0 + int(middle[0]), x0 + int(middle[1])",
  "        candidates[(c, x, y)] = weights[c]",
  "    if not candidates:",
  "        return (avail[0], int(p[9]), int(p[10]))",
  "    choices = []",
  "    for action, priority in candidates.items():",
  "        successes, trials = mem['effects'].get(action, [0, 0])",
  "        value = -p[11] * priority + p[12] * mem['pairs'].get((state, action), 0)",
  "        value += p[13] * (trials - successes) + p[14] * mem['uses'].get(action, 0)",
  "        if trials == 0:",
  "            value -= p[15]",
  "        if successes:",
  "            value -= p[16] * successes / max(1, trials)",
  "        destination = mem['edges'].get((state, action))",
  "        if destination is not None:",
  "            value += p[17] * visits.get(destination, 0)",
  "        model = mem['models'].get(action)",
  "        if model is not None and model[1] >= int(p[18]):",
  "            predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))",
  "            value += p[19] * (objective(predicted, p) - objective(feature, p))",
  "        if 'last' in mem and action == mem['last'][1]:",
  "            value -= p[20] / (1 + mem['streak'] / max(1.0, p[21]))",
  "        value -= p[22] * mem['wins'].get(action[0], 0)",
  "        choices.append((value, action))",
  "    choices.sort(key=lambda item: (item[0], item[1]))",
  "    action = choices[0][1]",
  "    if 'last' in mem and action == mem['last'][1]:",
  "        mem['streak'] += 1",
  "    else:",
  "        mem['streak'] = 0",
  "    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1",
  "    mem['uses'][action] = mem['uses'].get(action, 0) + 1",
  "    mem['last'] = (state, action, feature)",
  "    return (6 if 6 in avail else avail[0], action[1], action[2])",
  "def geometry(objects, q):",
  "    result = []",
  "    for colour in q[:3]:",
  "        group = sorted([o for o in objects if o[0] == int(colour)], key=lambda o: (o[2], o[1]))",
  "        if len(group) >= 2:",
  "            best = None",
  "            for i in range(len(group)):",
  "                for j in range(i + 1, len(group)):",
  "                    a, b = group[i], group[j]",
  "                    distance = q[3] * abs(a[6] - b[6]) + q[4] * abs(a[7] - b[7])",
  "                    if best is None or distance < best[0]:",
  "                        best = (distance, a[6] - b[6], a[7] - b[7])",
  "            result.extend([best[1], best[2]])",
  "        else:",
  "            result.extend([0.0, 0.0])",
  "    return tuple(result)",
  "def cost(v, q):",
  "    return sum(q[3] * abs(v[i]) + q[4] * abs(v[i + 1]) for i in range(0, len(v), 2))",
  "def third(params, mem, frame, avail, info):",
  "    q = params['search']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('searchlevel') != level:",
  "        mem.clear()",
  "        mem.update({'searchlevel': level, 'reset': reset, 'edges': {}, 'pairs': {}, 'visits': {}, 'effects': {}, 'models': {}, 'probes': {}, 'uses': {}})",
  "    if mem.get('reset') != reset:",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "    weights = params['probe_colours']",
  "    objects = components(frame, [i for i in range(len(weights)) if weights[i] > 0])",
  "    state = tuple(int(v) for v in frame[int(q[6]):, :].flatten())",
  "    feature = geometry(objects, q)",
  "    score = cost(feature, q)",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if 'last' in mem:",
  "        old, action, before = mem['last']",
  "        changed = old != state",
  "        mem['edges'].setdefault(old, {})[action] = state",
  "        effect = mem['effects'].setdefault(action, [0, 0])",
  "        effect[0] += int(changed)",
  "        effect[1] += 1",
  "        if changed:",
  "            mem['models'][action] = tuple(feature[i] - before[i] for i in range(len(feature)))",
  "        else:",
  "            mem['models'].pop(action, None)",
  "    candidates = []",
  "    for o in objects:",
  "        if o[5] > q[7]:",
  "            continue",
  "        c, x0, y0, x1, y1, area, cx, cy = o",
  "        x, y = int(cx), int(cy)",
  "        if int(frame[y, x]) != c:",
  "            cells = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)",
  "            middle = cells[len(cells) // 2]",
  "            x, y = x0 + int(middle[1]), y0 + int(middle[0])",
  "        candidates.append((c, x, y))",
  "    if not candidates:",
  "        return (avail[0], int(q[8]), int(q[9]))",
  "    unprobed = [a for a in candidates if mem['probes'].get(a, 0) == 0]",
  "    if unprobed:",
  "        unprobed.sort(key=lambda a: (-weights[a[0]], a[2], a[1]))",
  "        action = unprobed[0]",
  "    else:",
  "        choices = []",
  "        for a in candidates:",
  "            successes, trials = mem['effects'].get(a, [0, 0])",
  "            value = -q[10] * weights[a[0]] + q[11] * mem['pairs'].get((state, a), 0)",
  "            value += q[12] * (trials - successes) / max(1, trials)",
  "            value += q[13] * mem['uses'].get(a, 0)",
  "            destination = mem['edges'].get(state, {}).get(a)",
  "            if destination == state:",
  "                value += q[14]",
  "            elif destination is not None:",
  "                value += q[15] * visits.get(destination, 0)",
  "            delta = mem['models'].get(a)",
  "            if delta is not None:",
  "                predicted = tuple(feature[i] + delta[i] for i in range(len(feature)))",
  "                value += q[16] * (cost(predicted, q) - score)",
  "            if successes:",
  "                value -= q[17] * successes / max(1, trials)",
  "            choices.append((value, a))",
  "        choices.sort(key=lambda item: (item[0], item[1]))",
  "        action = choices[0][1]",
  "        if all(mem['pairs'].get((state, a), 0) > 0 for a in candidates):",
  "            queue = [(state, None)]",
  "            seen = {state}",
  "            index = 0",
  "            route = None",
  "            while index < len(queue) and index < int(q[18]):",
  "                node, first = queue[index]",
  "                index += 1",
  "                outgoing = mem['edges'].get(node, {})",
  "                if node != state and any(mem['pairs'].get((node, a), 0) == 0 for a in candidates if a[0] == int(q[19])):",
  "                    route = first",
  "                    break",
  "                for a, destination in outgoing.items():",
  "                    if destination not in seen and destination != node:",
  "                        seen.add(destination)",
  "                        queue.append((destination, a if first is None else first))",
  "            if route is not None and route in candidates:",
  "                action = route",
  "    mem['probes'][action] = mem['probes'].get(action, 0) + 1",
  "    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1",
  "    mem['uses'][action] = mem['uses'].get(action, 0) + 1",
  "    mem['last'] = (state, action, feature)",
  "    return (6 if 6 in avail else avail[0], action[1], action[2])",
  "def board_features(frame, objects, p):",
  "    result = []",
  "    for colour in p[:4]:",
  "        mask = frame[1:, :] == int(colour)",
  "        for x in range(frame.shape[1]):",
  "            rows = np.where(mask[:, x])[0]",
  "            if len(rows):",
  "                result.extend([float(rows[0] + 1), float(rows[-1] + 1)])",
  "            else:",
  "                result.extend([-1.0, -1.0])",
  "    return tuple(result)",
  "def board_cost(v, p):",
  "    width = len(v) // 8",
  "    markers = []",
  "    for x in range(width):",
  "        i = 2 * x",
  "        if v[i] >= 0:",
  "            markers.append((x, (v[i] + v[i + 1]) / 2))",
  "    score = 0.0",
  "    if markers:",
  "        left = markers[0]",
  "        right = markers[-1]",
  "        score += p[4] * abs(right[1] - left[1])",
  "        score += p[5] * abs(right[0] - left[0])",
  "    agent = []",
  "    for x in range(width):",
  "        i = 2 * width + 2 * x",
  "        if v[i] >= 0:",
  "            agent.append((x, (v[i] + v[i + 1]) / 2))",
  "    if agent:",
  "        ax = sum(a[0] for a in agent) / len(agent)",
  "        ay = sum(a[1] for a in agent) / len(agent)",
  "        if markers:",
  "            target = max(markers, key=lambda a: abs(a[0] - ax))",
  "            score += p[6] * abs(target[0] - ax) + p[7] * abs(target[1] - ay)",
  "        intervals = []",
  "        for x in range(width):",
  "            i = 4 * width + 2 * x",
  "            if v[i] >= 0:",
  "                if not intervals or x > intervals[-1][0] + 1:",
  "                    intervals.append((x, v[i], v[i + 1]))",
  "                else:",
  "                    last = intervals[-1]",
  "                    intervals[-1] = (x, min(last[1], v[i]), max(last[2], v[i + 1]))",
  "        for x, lo, hi in intervals:",
  "            score += p[8] * max(0.0, lo - ay, ay - hi)",
  "        for i in range(len(intervals) - 1):",
  "            a, b = intervals[i], intervals[i + 1]",
  "            score += p[9] * max(0.0, a[1] - b[2], b[1] - a[2])",
  "    return score",
  "def advanced(params, mem, frame, avail, info):",
  "    p = params['planner']",
  "    weights = params['probe_colours']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('advanced') != level:",
  "        mem.clear()",
  "        mem.update({'advanced': level, 'reset': reset, 'edges': {}, 'nodes': {}, 'visits': {}, 'effects': {}, 'models': {}, 'uses': {}, 'pairs': {}})",
  "    if mem.get('reset') != reset:",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "    colours = [i for i in range(len(weights)) if weights[i] > 0]",
  "    if int(p[2]) not in colours:",
  "        colours.append(int(p[2]))",
  "    objects = components(frame, colours)",
  "    state = tuple(int(v) for v in frame[int(p[10]):, :].flatten())",
  "    feature = board_features(frame, objects, p)",
  "    selection = tuple((o[1], o[2], o[3], o[4]) for o in objects if o[0] == int(p[2]))",
  "    mem['visits'][state] = mem['visits'].get(state, 0) + 1",
  "    if 'last' in mem:",
  "        old, action, before, previous_selection = mem['last']",
  "        mem['edges'].setdefault(old, {})[action] = state",
  "        effect = mem['effects'].setdefault(action, [0, 0, 0])",
  "        moved = any(abs(feature[i] - before[i]) > p[11] for i in range(len(feature)) if i < len(feature) // 2 or i >= len(feature) * 3 // 4)",
  "        effect[0] += int(moved)",
  "        effect[1] += int(old != state)",
  "        effect[2] += 1",
  "        delta = tuple(feature[i] - before[i] for i in range(len(feature)))",
  "        context = (previous_selection, action)",
  "        if old != state:",
  "            model = mem['models'].get(context)",
  "            if model is not None and max(abs(model[0][i] - delta[i]) for i in range(len(delta))) <= p[12]:",
  "                n = model[1]",
  "                mem['models'][context] = (tuple((model[0][i] * n + delta[i]) / (n + 1) for i in range(len(delta))), n + 1, selection)",
  "            else:",
  "                mem['models'][context] = (delta, 1, selection)",
  "        else:",
  "            mem['models'].pop(context, None)",
  "    candidates = []",
  "    for o in objects:",
  "        if o[5] > p[13]:",
  "            continue",
  "        c, x0, y0, x1, y1, area, cx, cy = o",
  "        cells = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)",
  "        if len(cells):",
  "            middle = cells[len(cells) // 2]",
  "            a = (c, x0 + int(middle[1]), y0 + int(middle[0]))",
  "            if a not in candidates:",
  "                candidates.append(a)",
  "    if not candidates:",
  "        return (avail[0], int(p[14]), int(p[15]))",
  "    mem['nodes'][state] = candidates",
  "    base = board_cost(feature, p)",
  "    choices = []",
  "    for a in candidates:",
  "        effect = mem['effects'].get(a, [0, 0, 0])",
  "        used = mem['pairs'].get((state, a), 0)",
  "        value = -p[16] * weights[a[0]] + p[17] * used",
  "        if effect[2] == 0:",
  "            value -= p[18]",
  "        else:",
  "            value += p[19] * (effect[2] - effect[1]) / effect[2]",
  "            value -= p[20] * effect[0] / effect[2]",
  "        value += p[21] * mem['uses'].get(a, 0)",
  "        destination = mem['edges'].get(state, {}).get(a)",
  "        if destination is not None:",
  "            value += p[22] * mem['visits'].get(destination, 0)",
  "        model = mem['models'].get((selection, a))",
  "        if model is not None:",
  "            predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))",
  "            value += p[23] * (board_cost(predicted, p) - base)",
  "            beam = [(board_cost(predicted, p), predicted, model[2])]",
  "            best = beam[0][0]",
  "            for depth in range(max(0, int(p[24]) - 1)):",
  "                expanded = []",
  "                for current_cost, current, context in beam:",
  "                    for key, learned in mem['models'].items():",
  "                        if key[0] != context:",
  "                            continue",
  "                        nxt = tuple(current[i] + learned[0][i] for i in range(len(current)))",
  "                        if any(z < -1 - p[12] or z > frame.shape[0] + p[12] for z in nxt):",
  "                            continue",
  "                        next_cost = board_cost(nxt, p)",
  "                        expanded.append((next_cost + p[25] * (depth + 1), nxt, learned[2]))",
  "                        best = min(best, next_cost + p[25] * (depth + 1))",
  "                if not expanded:",
  "                    break",
  "                expanded.sort(key=lambda item: item[0])",
  "                beam = expanded[:max(1, int(p[26]))]",
  "            value += p[27] * (best - base)",
  "        choices.append((value, a))",
  "    choices.sort(key=lambda item: (item[0], item[1]))",
  "    action = choices[0][1]",
  "    if all(mem['pairs'].get((state, a), 0) > 0 for a in candidates):",
  "        queue = [(state, None)]",
  "        seen = {state}",
  "        index = 0",
  "        while index < len(queue) and index < int(p[28]):",
  "            node, first = queue[index]",
  "            index += 1",
  "            node_actions = mem['nodes'].get(node, [])",
  "            if node != state and any(mem['pairs'].get((node, a), 0) == 0 for a in node_actions):",
  "                if first in candidates:",
  "                    action = first",
  "                break",
  "            for a, destination in mem['edges'].get(node, {}).items():",
  "                if destination != node and destination not in seen:",
  "                    seen.add(destination)",
  "                    queue.append((destination, a if first is None else first))",
  "    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1",
  "    mem['uses'][action] = mem['uses'].get(action, 0) + 1",
  "    mem['last'] = (state, action, feature, selection)",
  "    return (6 if 6 in avail else avail[0], action[1], action[2])",
  "def act(params, mem, frame, avail, info):",
  "    level = info.get('levels', 0)",
  "    if level < int(params['search'][5]):",
  "        return early(params, mem, frame, avail, info)",
  "    if level < int(params['planner'][29]):",
  "        return third(params, mem, frame, avail, info)",
  "    return advanced(params, mem, frame, avail, info)"
 ],
