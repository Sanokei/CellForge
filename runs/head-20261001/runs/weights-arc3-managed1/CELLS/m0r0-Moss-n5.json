 "source_lines": [
  "def pieces(frame, colour):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        todo = [start]",
  "        group = [start]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for p in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):",
  "                if p in remaining:",
  "                    remaining.remove(p)",
  "                    todo.append(p)",
  "                    group.append(p)",
  "        result.append((min(p[0] for p in group), min(p[1] for p in group), max(p[0] for p in group)-min(p[0] for p in group)+1, max(p[1] for p in group)-min(p[1] for p in group)+1))",
  "    result.sort(key=lambda p: p[1])",
  "    return result",
  "def move(state, action, mem):",
  "    cache = mem['cache']",
  "    key = (state, action)",
  "    if key in cache:",
  "        return cache[key]",
  "    out = []",
  "    board = mem['board']",
  "    for i in range(len(state)):",
  "        r, c = state[i]",
  "        dr, dc = mem['motion'][action][i]",
  "        h, w = mem['sizes'][i]",
  "        rr, cc = r+dr, c+dc",
  "        if rr >= 0 and cc >= 0 and rr+h <= board.shape[0] and cc+w <= board.shape[1] and np.all(board[rr:rr+h,cc:cc+w]):",
  "            out.append((rr,cc))",
  "        else:",
  "            out.append((r,c))",
  "    successor = tuple(out)",
  "    cache[key] = successor",
  "    return successor",
  "def startsearch(mem, state):",
  "    mem['queue'] = [state]",
  "    mem['seen'] = {state: 0}",
  "    mem['cursor'] = 0",
  "    mem['reverse'] = {}",
  "    mem['goal'] = None",
  "    mem['distance'] = {}",
  "    mem['backqueue'] = []",
  "    mem['backcursor'] = 0",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    order = [int(a) for a in params['order'] if int(a) in avail]",
  "    if not order:",
  "        return (avail[0], int(cfg[11]), int(cfg[11]))",
  "    found = pieces(frame, int(cfg[1]))",
  "    state = tuple((p[0],p[1]) for p in found)",
  "    changedlevel = mem.get('level') != info['levels']",
  "    changedreset = mem.get('reset') != info['resets']",
  "    if changedlevel or changedreset:",
  "        saved = mem.get('learned', {})",
  "        mem.clear()",
  "        mem['learned'] = saved",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['edges'] = {}",
  "        mem['cache'] = {}",
  "        mem['board'] = (frame == int(cfg[0])) | (frame == int(cfg[1]))",
  "        mem['sizes'] = [(p[2],p[3]) for p in found]",
  "        mem['motion'] = {}",
  "        for j in range(len(params['order'])):",
  "            a = int(params['order'][j])",
  "            motion = []",
  "            for i in range(len(found)):",
  "                h,w = mem['sizes'][i]",
  "                motion.append((int(params['motion'][j][i % 2][0])*h, int(params['motion'][j][i % 2][1])*w))",
  "            mem['motion'][a] = saved.get((info['levels'],a), motion)",
  "        startsearch(mem,state)",
  "    if len(state) != int(cfg[2]):",
  "        count = mem.get('fallback',0)",
  "        mem['fallback'] = count+1",
  "        return (order[count % len(order)], int(cfg[11]), int(cfg[11]))",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old, action, predicted, oldkey = previous",
  "        mem['edges'][(old,action)] = state",
  "        if state != old:",
  "            mem['bestprogress'] = state",
  "        if state != predicted:",
  "            motion = list(mem['motion'][action])",
  "            altered = False",
  "            for i in range(len(state)):",
  "                dr,dc = state[i][0]-old[i][0],state[i][1]-old[i][1]",
  "                if dr != 0 or dc != 0:",
  "                    if abs(dr)+abs(dc) <= cfg[3]:",
  "                        if motion[i] != (dr,dc):",
  "                            motion[i] = (dr,dc)",
  "                            altered = True",
  "            mem['motion'][action] = motion",
  "            mem['learned'][(info['levels'],action)] = motion",
  "            if altered:",
  "                mem['cache'] = {}",
  "            mem['cache'][(old,action)] = state",
  "            startsearch(mem,state)",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state,0)+1",
  "    budget = max(1,int(abs(cfg[4])))",
  "    limit = max(budget,int(abs(cfg[5]))*int(abs(cfg[6])))",
  "    queue = mem['queue']",
  "    seen = mem['seen']",
  "    reverse = mem['reverse']",
  "    used = 0",
  "    while mem['goal'] is None and mem['cursor'] < len(queue) and used < budget:",
  "        current = queue[mem['cursor']]",
  "        mem['cursor'] += 1",
  "        used += 1",
  "        separation = abs(current[0][0]-current[1][0])+abs(current[0][1]-current[1][1])",
  "        if separation <= cfg[7]:",
  "            mem['goal'] = current",
  "            mem['distance'] = {current:0}",
  "            mem['backqueue'] = [current]",
  "            break",
  "        for action in order:",
  "            successor = move(current,action,mem)",
  "            if successor == current:",
  "                continue",
  "            reverse.setdefault(successor,[]).append((current,action))",
  "            if successor not in seen and len(queue) < limit:",
  "                seen[successor] = seen[current]+1",
  "                queue.append(successor)",
  "    used = 0",
  "    back = mem['backqueue']",
  "    distance = mem['distance']",
  "    while mem['backcursor'] < len(back) and used < budget:",
  "        current = back[mem['backcursor']]",
  "        mem['backcursor'] += 1",
  "        used += 1",
  "        for predecessor, action in reverse.get(current,[]):",
  "            if predecessor not in distance:",
  "                distance[predecessor] = distance[current]+1",
  "                back.append(predecessor)",
  "    best = None",
  "    bestscore = -1000000000",
  "    for action in order:",
  "        successor = move(state,action,mem)",
  "        if successor == state:",
  "            continue",
  "        if successor in distance:",
  "            score = cfg[8]-cfg[9]*distance[successor]",
  "        else:",
  "            separation = abs(successor[0][0]-successor[1][0])+abs(successor[0][1]-successor[1][1])",
  "            score = -separation-cfg[10]*visits.get(successor,0)",
  "            if (state,action) not in mem['edges']:",
  "                score += cfg[12]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = action",
  "    if best is None:",
  "        counts = mem.setdefault('stuck',{})",
  "        best = order[0]",
  "        for action in order:",
  "            if counts.get((state,action),0) < counts.get((state,best),0):",
  "                best = action",
  "        counts[(state,best)] = counts.get((state,best),0)+1",
  "    if mem['cursor'] >= len(queue) and mem['goal'] is None and state not in seen:",
  "        startsearch(mem,state)",
  "    predicted = move(state,best,mem)",
  "    mem['previous'] = (state,best,predicted,info['key'])",
  "    return (best,int(cfg[11]),int(cfg[11]))"
 ],
