 "source_lines": [
  "def parts(frame, top, bottom, excluded):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(top, bottom):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c in excluded:",
  "                continue",
  "            todo = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while todo:",
  "                yy, xx = todo.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if top <= ny < bottom and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                        seen[ny, nx] = True",
  "                        todo.append((ny, nx))",
  "            n = len(cells)",
  "            xs = [v[1] for v in cells]",
  "            ys = [v[0] for v in cells]",
  "            out.append((c, int(round(sum(xs) / n)), int(round(sum(ys) / n)), n, max(xs) - min(xs) + 1, max(ys) - min(ys) + 1))",
  "    return out",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['tries'] = {}",
  "        mem['bad'] = {}",
  "        mem['fatal'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['motion'] = {}",
  "        mem['local'] = {}",
  "    if mem.get('reset') != reset:",
  "        if 'last' in mem:",
  "            old, point, oldpos, mode, distance, palette_click = mem['last']",
  "            mem['fatal'][(old, point)] = mem['fatal'].get((old, point), 0) + 1",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "        mem.pop('position', None)",
  "    top = max(0, min(frame.shape[0], int(p[0])))",
  "    bottom = max(top, min(frame.shape[0], int(p[1])))",
  "    excluded = [int(p[2]), int(p[3])]",
  "    body = parts(frame, top, bottom, excluded)",
  "    header = parts(frame, 0, top, excluded)",
  "    palette = {}",
  "    displays = []",
  "    for o in header:",
  "        if o[4] == o[5] and o[3] == o[4] * o[5]:",
  "            if p[4] <= o[3] <= p[5]:",
  "                palette[o[0]] = (o[1], o[2])",
  "            elif o[3] >= p[6]:",
  "                displays.append(o)",
  "    active = max(displays, key=lambda o: o[3])[0] if displays else int(p[7])",
  "    goals = [o for o in body if o[0] == int(p[8]) and o[3] >= p[9]]",
  "    actors = [o for o in body if o[0] != int(p[8]) and o[3] == o[4] * o[5] and o[4] == o[5] and p[10] <= o[3] <= p[11]]",
  "    oldpos = mem.get('position')",
  "    actor = None",
  "    if actors:",
  "        largest = max(o[3] for o in actors)",
  "        pool = [o for o in actors if o[3] == largest]",
  "        if oldpos is None:",
  "            actor = pool[0]",
  "        else:",
  "            actor = min(pool, key=lambda o: (o[1] - oldpos[0]) ** 2 + (o[2] - oldpos[1]) ** 2)",
  "    if actor is not None:",
  "        pos = (actor[1], actor[2], actor[0])",
  "    else:",
  "        pos = mem.get('position', (int(p[12]), int(p[13]), active))",
  "    mem['position'] = pos",
  "    if not displays:",
  "        active = pos[2]",
  "    if goals:",
  "        goal = max(goals, key=lambda o: o[3])",
  "        mem['goal'] = (goal[1], goal[2])",
  "    gx, gy = mem.get('goal', (pos[0], pos[1]))",
  "    state = (active, tuple(sorted(body)), tuple(sorted(header)))",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if 'last' in mem:",
  "        old, point, previous, mode, distance, palette_click = mem['last']",
  "        mem['edges'][(old, point)] = state",
  "        if state == old:",
  "            mem['bad'][(old, point)] = mem['bad'].get((old, point), 0) + 1",
  "            localkey = (previous[0], previous[1], mode, point)",
  "            mem['local'][localkey] = mem['local'].get(localkey, 0) + 1",
  "        elif not palette_click:",
  "            moved = ((pos[0] - previous[0]) ** 2 + (pos[1] - previous[1]) ** 2) ** 0.5",
  "            if moved > p[14]:",
  "                record = mem['motion'].setdefault(mode, [0.0, 0.0, 0.0])",
  "                record[0] += moved",
  "                record[1] += 1",
  "                record[2] = max(record[2], distance)",
  "    candidates = {}",
  "    for o in body:",
  "        if o[3] <= p[15] or o in goals:",
  "            point = (o[1], o[2])",
  "            if point != pos[:2]:",
  "                candidates[point] = o",
  "    current = ((pos[0] - gx) ** 2 + (pos[1] - gy) ** 2) ** 0.5",
  "    options = []",
  "    untried = 0",
  "    for point, o in candidates.items():",
  "        x, y = point",
  "        d = ((x - pos[0]) ** 2 + (y - pos[1]) ** 2) ** 0.5",
  "        if d <= p[14]:",
  "            continue",
  "        remaining = ((x - gx) ** 2 + (y - gy) ** 2) ** 0.5",
  "        count = mem['tries'].get((state, point), 0)",
  "        bad = mem['bad'].get((state, point), 0)",
  "        fatal = mem['fatal'].get((state, point), 0)",
  "        value = p[16] * d + p[17] * remaining",
  "        if remaining >= current - p[18]:",
  "            value += p[19]",
  "        reach = p[20]",
  "        learned = mem['motion'].get(active)",
  "        if learned is not None:",
  "            reach = max(reach, learned[2] + p[21])",
  "        if d > reach:",
  "            value += p[22] * (d - reach)",
  "        if o[0] == int(p[23]) and p[24] <= o[3] <= p[25]:",
  "            value -= p[26]",
  "        value += p[27] * count + p[28] * bad + p[29] * fatal",
  "        value += p[30] * mem['local'].get((pos[0], pos[1], active, point), 0)",
  "        nxt = mem['edges'].get((state, point))",
  "        if nxt is not None:",
  "            value += p[31] * visits.get(nxt, 0)",
  "        if count == 0 and bad == 0 and fatal == 0:",
  "            untried += 1",
  "        options.append((value, point, d, False))",
  "    for colour, point in palette.items():",
  "        if colour == active:",
  "            continue",
  "        count = mem['tries'].get((state, point), 0)",
  "        value = p[32]",
  "        nearest = None",
  "        for o in body:",
  "            if o[0] == colour and o[3] <= p[15]:",
  "                d = ((o[1] - pos[0]) ** 2 + (o[2] - pos[1]) ** 2) ** 0.5",
  "                remaining = ((o[1] - gx) ** 2 + (o[2] - gy) ** 2) ** 0.5",
  "                if d > p[14]:",
  "                    score = d + p[33] * remaining",
  "                    if nearest is None or score < nearest:",
  "                        nearest = score",
  "        if nearest is not None:",
  "            value -= p[34]",
  "        if actor is None:",
  "            value -= p[35]",
  "        if visits[state] > p[36] or untried == 0:",
  "            value -= p[37]",
  "        value += p[27] * count + p[28] * mem['bad'].get((state, point), 0) + p[29] * mem['fatal'].get((state, point), 0)",
  "        nxt = mem['edges'].get((state, point))",
  "        if nxt is not None:",
  "            value += p[31] * visits.get(nxt, 0)",
  "        options.append((value, point, 0.0, True))",
  "    if options:",
  "        options.sort()",
  "        value, chosen, distance, palette_click = options[0]",
  "    else:",
  "        chosen = (int(p[12]), int(p[13]))",
  "        distance = 0.0",
  "        palette_click = False",
  "    mem['tries'][(state, chosen)] = mem['tries'].get((state, chosen), 0) + 1",
  "    mem['last'] = (state, chosen, pos, active, distance, palette_click)",
  "    action = int(p[38])",
  "    if action not in avail:",
  "        action = avail[0]",
  "    return (action, max(0, min(frame.shape[1] - 1, chosen[0])), max(0, min(frame.shape[0] - 1, chosen[1])))"
 ],
