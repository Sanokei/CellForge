 "source_lines": [
  "def groups(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    result = []",
  "    while remaining:",
  "        point = next(iter(remaining))",
  "        remaining.remove(point)",
  "        todo = [point]",
  "        cells = [point]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        result.append((min(p[0] for p in cells), min(p[1] for p in cells), max(p[0] for p in cells), max(p[1] for p in cells), len(cells)))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    cutoff = max(1, min(frame.shape[0], int(cfg[0])))",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        motion = mem.get('motion', {})",
  "        success = mem.get('success', {})",
  "        if mem.get('level') is not None and level > mem['level']:",
  "            success[mem['level']] = mem.get('history', [])[:]",
  "        mem.clear()",
  "        mem.update({'level': level, 'reset': reset, 'motion': motion, 'success': success, 'visits': {}, 'blocked': {}, 'effects': {}, 'tested': set(), 'clicktested': set(), 'done': set(), 'history': [], 'stuck': 0})",
  "    hm = frame == int(cfg[1])",
  "    hm[cutoff:, :] = False",
  "    heads = groups(hm)",
  "    heads.sort(key=lambda p: -p[4])",
  "    head = heads[0] if heads else None",
  "    row = (head[0] + head[2]) / 2 if head else None",
  "    end = head[3] if head else None",
  "    if head is not None:",
  "        wire = np.argwhere((frame == int(cfg[2])) | (frame == int(cfg[3])))",
  "        for p in wire:",
  "            if p[0] < cutoff and abs(float(p[0]) - row) <= cfg[4] and p[1] > head[3]:",
  "                end = max(end, int(p[1]))",
  "    targets = []",
  "    legend = []",
  "    for value in params['colours']:",
  "        colour = int(value)",
  "        mask = frame == colour",
  "        board = mask.copy()",
  "        board[cutoff:, :] = False",
  "        for box in groups(board):",
  "            if box[4] >= cfg[5]:",
  "                targets.append((colour, box))",
  "        mask[:cutoff, :] = False",
  "        boxes = groups(mask)",
  "        if boxes:",
  "            box = max(boxes, key=lambda p: p[4])",
  "            legend.append((box[1], colour))",
  "            interior = frame[box[0]:box[2] + 1, box[1]:box[3] + 1]",
  "            if np.sum(interior == int(cfg[6])) >= cfg[7]:",
  "                mem['done'].add(colour)",
  "    legend.sort()",
  "    order = [p[1] for p in legend]",
  "    if not order:",
  "        order = [int(v) for v in params['colours']]",
  "    targets.sort(key=lambda p: (order.index(p[0]) if p[0] in order else len(order), p[1][1]))",
  "    pending = [t for t in targets if t[0] not in mem['done']]",
  "    goal = pending[0][1] if pending else None",
  "    signature = tuple(int(v) for v in frame[:cutoff, :].flatten())",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, token, oldrow, oldend, oldframe = old",
  "        changed = int(np.sum(frame != oldframe))",
  "        if signature == oldsig:",
  "            pair = (oldsig, token)",
  "            mem['blocked'][pair] = mem['blocked'].get(pair, 0) + 1",
  "            mem['stuck'] += 1",
  "        else:",
  "            mem['stuck'] = 0",
  "        if token[0] != int(cfg[8]) and row is not None and oldrow is not None and signature != oldsig:",
  "            dr, de = row - oldrow, end - oldend",
  "            if abs(dr) + abs(de) <= cfg[9]:",
  "                mem['motion'][token[0]] = (dr, de)",
  "        if token[0] == int(cfg[8]):",
  "            mem['effects'][token] = max(mem['effects'].get(token, 0), changed)",
  "    visits = mem['visits'].setdefault(signature, {})",
  "    candidates = []",
  "    for i in range(len(params['actions'])):",
  "        action = int(params['actions'][i])",
  "        if action not in avail:",
  "            continue",
  "        token = (action, 0, 0)",
  "        dr, de = mem['motion'].get(action, (float(params['motion'][i][0]), float(params['motion'][i][1])))",
  "        score = -i * cfg[10]",
  "        if action not in mem['tested'] and len(mem['history']) < cfg[11]:",
  "            score += cfg[12]",
  "        elif head is not None:",
  "            desired = (goal[0] + goal[2]) / 2 if goal is not None else row",
  "            if goal is None or abs(row - desired) > cfg[4]:",
  "                if end > head[3] + cfg[13]:",
  "                    score += cfg[14] * (-de) - cfg[15] * abs(dr)",
  "                elif goal is not None:",
  "                    score += cfg[14] * (abs(row - desired) - abs(row + dr - desired)) - cfg[15] * abs(de)",
  "                elif action == int(cfg[16]):",
  "                    score += cfg[17]",
  "            else:",
  "                score += cfg[14] * de - cfg[15] * abs(dr)",
  "                if end >= goal[3] + cfg[18] and de > 0:",
  "                    score -= cfg[19]",
  "                if end >= goal[3] + cfg[18] and mem['stuck'] >= cfg[20] and de < 0:",
  "                    score += cfg[19]",
  "        candidates.append((score, token))",
  "    click = int(cfg[8])",
  "    if click in avail and mem['stuck'] >= cfg[21]:",
  "        boxes = [t[1] for t in targets] + heads",
  "        for value in params['colours']:",
  "            mask = frame == int(value)",
  "            mask[:cutoff, :] = False",
  "            boxes.extend(groups(mask))",
  "        for box in boxes:",
  "            x, y = int((box[1] + box[3]) / 2), int((box[0] + box[2]) / 2)",
  "            token = (click, x, y)",
  "            if token not in mem['clicktested'] or mem['effects'].get(token, 0) > 0:",
  "                score = cfg[22] + min(cfg[23], mem['effects'].get(token, 0)) * cfg[24]",
  "                candidates.append((score, token))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score, token in candidates:",
  "        score -= cfg[25] * visits.get(token, 0)",
  "        score -= cfg[26] * mem['blocked'].get((signature, token), 0)",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = token",
  "    if best is None:",
  "        best = (avail[0], 0, 0)",
  "    visits[best] = visits.get(best, 0) + 1",
  "    if best[0] == click:",
  "        mem['clicktested'].add(best)",
  "    else:",
  "        mem['tested'].add(best[0])",
  "    mem['history'].append(best)",
  "    mem['previous'] = (signature, best, row, end, frame.copy())",
  "    return best"
 ],
