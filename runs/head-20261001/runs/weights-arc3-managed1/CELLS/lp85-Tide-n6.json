 "source_lines": [
  "def components(frame, colours):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(frame.shape[0]):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c not in colours:",
  "                continue",
  "            todo = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while todo:",
  "                yy, xx = todo.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if 0 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                        seen[ny, nx] = True",
  "                        todo.append((ny, nx))",
  "            xs = [v[1] for v in cells]",
  "            ys = [v[0] for v in cells]",
  "            out.append((c, min(xs), min(ys), max(xs), max(ys), len(cells)))",
  "    return out",
  "def transform(board, mapping):",
  "    return tuple(board[s] for s in mapping)",
  "def fit(samples, n):",
  "    candidates = []",
  "    for d in range(n):",
  "        candidates.append([s for s in range(n) if all(after[d] == before[s] for before, after in samples)])",
  "    if any(len(v) == 0 for v in candidates):",
  "        return None",
  "    owners = {}",
  "    def assign(d, seen):",
  "        for s in sorted(candidates[d], key=lambda s: (s != d, s)):",
  "            if s in seen:",
  "                continue",
  "            seen.add(s)",
  "            if s not in owners or assign(owners[s], seen):",
  "                owners[s] = d",
  "                return True",
  "        return False",
  "    for d in sorted(range(n), key=lambda d: len(candidates[d])):",
  "        if not assign(d, set()):",
  "            return None",
  "    mapping = [0] * n",
  "    for s, d in owners.items():",
  "        mapping[d] = s",
  "    return tuple(mapping)",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    colours = [i for i in range(len(params['tiles'])) if params['tiles'][i] > 0]",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        comps = components(frame, colours + [int(p[0]), int(p[1])])",
  "        squares = [o for o in comps if o[0] in colours and o[3] - o[1] == o[4] - o[2] and o[5] == (o[3] - o[1] + 1) ** 2]",
  "        counts = {}",
  "        for o in squares:",
  "            counts[o[5]] = counts.get(o[5], 0) + 1",
  "        size = max(counts, key=lambda k: counts[k] * k ** float(p[2])) if counts else 0",
  "        tiles = sorted([o for o in squares if o[5] == size], key=lambda o: (o[2], o[1]))",
  "        mem['slots'] = [((o[1] + o[3]) // 2, (o[2] + o[4]) // 2) for o in tiles]",
  "        targets = []",
  "        for i, o in enumerate(tiles):",
  "            c, x0, y0, x1, y1, area = o",
  "            if x0 > 0 and y0 > 0 and x1 + 1 < frame.shape[1] and y1 + 1 < frame.shape[0]:",
  "                corners = [int(frame[y0 - 1, x0 - 1]), int(frame[y0 - 1, x1 + 1]), int(frame[y1 + 1, x0 - 1]), int(frame[y1 + 1, x1 + 1])]",
  "                if corners[0] in colours and all(v == corners[0] for v in corners):",
  "                    targets.append((i, corners[0]))",
  "        mem['targets'] = targets",
  "        arrows = [o for o in comps if o[0] in [int(p[0]), int(p[1])] and o[5] <= p[3] and o[3] > o[1] and o[4] > o[2]]",
  "        arrows.sort(key=lambda o: (o[2], o[1]))",
  "        mem['actions'] = [(6, (o[1] + o[3]) // 2, (o[2] + o[4]) // 2) for o in arrows]",
  "        for name in ['models', 'samples', 'runs', 'visits', 'pairs', 'edges', 'failed', 'uses', 'cache']:",
  "            mem[name] = {}",
  "        mem['version'] = 0",
  "        mem['plan'] = []",
  "    actions = mem['actions']",
  "    if not actions or not mem['slots']:",
  "        return (avail[0], int(p[4]), int(p[5]))",
  "    board = tuple(int(frame[y, x]) for x, y in mem['slots'])",
  "    visits = mem['visits']",
  "    visits[board] = visits.get(board, 0) + 1",
  "    models = mem['models']",
  "    if 'last' in mem:",
  "        old, a = mem['last']",
  "        mem['edges'][(old, a)] = board",
  "        samples = mem['samples'].setdefault(a, [])",
  "        pair = (old, board)",
  "        fresh = pair not in samples",
  "        if fresh:",
  "            samples.append(pair)",
  "        if old == board:",
  "            mem['failed'][a] = mem['failed'].get(a, 0) + 1",
  "        invalid = a in models and transform(old, models[a]) != board",
  "        if invalid:",
  "            models.pop(a)",
  "            mem['version'] += 1",
  "            mem['plan'] = []",
  "        mem['runs'][a] = mem['runs'].get(a, 0) + 1",
  "        if fresh and (invalid or a not in models) and mem['runs'][a] >= int(p[6]):",
  "            mapping = fit(samples, len(board))",
  "            if mapping is not None:",
  "                models[a] = mapping",
  "                mem['version'] += 1",
  "                mem['plan'] = []",
  "    chosen = None",
  "    if mem['plan']:",
  "        expected, a = mem['plan'].pop(0)",
  "        if expected == board and a in models:",
  "            chosen = a",
  "        else:",
  "            mem['plan'] = []",
  "    unlearned = [a for a in range(len(actions)) if a not in models and mem['runs'].get(a, 0) < int(p[7]) and mem['failed'].get(a, 0) < int(p[8])]",
  "    if chosen is None and unlearned:",
  "        chosen = min(unlearned, key=lambda a: (mem['uses'].get(a, 0), a))",
  "        if 'last' in mem:",
  "            last = mem['last'][1]",
  "            if last in unlearned and mem['runs'].get(last, 0) < int(p[6]):",
  "                chosen = last",
  "    targets = mem['targets']",
  "    if chosen is None and models and targets:",
  "        version = mem['version']",
  "        if mem.get('distance_version') != version:",
  "            distances = []",
  "            for target, colour in targets:",
  "                dist = [int(p[9])] * len(board)",
  "                dist[target] = 0",
  "                queue = [target]",
  "                head = 0",
  "                while head < len(queue):",
  "                    d = queue[head]",
  "                    head += 1",
  "                    for mapping in models.values():",
  "                        s = mapping[d]",
  "                        if dist[s] > dist[d] + 1:",
  "                            dist[s] = dist[d] + 1",
  "                            queue.append(s)",
  "                distances.append(dist)",
  "            mem['distances'] = distances",
  "            mem['distance_version'] = version",
  "            mem['cache'] = {}",
  "        distances = mem['distances']",
  "        def score(state):",
  "            total = 0.0",
  "            for j, item in enumerate(targets):",
  "                target, colour = item",
  "                total += min([distances[j][i] for i, c in enumerate(state) if c == colour] + [int(p[9])])",
  "                if state[target] != colour:",
  "                    total += p[10]",
  "            return total",
  "        def signature(state):",
  "            return tuple(tuple(i for i, c in enumerate(state) if c == colour) for colour in sorted(set(c for t, c in targets)))",
  "        cached = mem['cache'].get(board)",
  "        path = cached",
  "        if cached is None:",
  "            beam = [(board, [])]",
  "            reached = {signature(board)}",
  "            best = float('inf')",
  "            path = []",
  "            solved = False",
  "            expanded = 0",
  "            for depth in range(int(p[11])):",
  "                candidates = []",
  "                for state, route in beam:",
  "                    for a, mapping in models.items():",
  "                        expanded += 1",
  "                        nxt = transform(state, mapping)",
  "                        sig = signature(nxt)",
  "                        if sig in reached:",
  "                            continue",
  "                        reached.add(sig)",
  "                        trail = route + [(state, a)]",
  "                        value = score(nxt) + p[12] * visits.get(nxt, 0) + p[13] * depth",
  "                        if value < best:",
  "                            best = value",
  "                            path = trail",
  "                        if all(nxt[t] == c for t, c in targets):",
  "                            path = trail",
  "                            solved = True",
  "                            break",
  "                        candidates.append((value, nxt, trail))",
  "                    if solved or expanded >= int(p[20]):",
  "                        break",
  "                if solved or not candidates or expanded >= int(p[20]):",
  "                    break",
  "                candidates.sort(key=lambda v: v[0])",
  "                beam = [(v[1], v[2]) for v in candidates[:int(p[14])]]",
  "            mem['cache'][board] = path",
  "        if path:",
  "            chosen = path[0][1]",
  "            mem['plan'] = list(path[1:])",
  "    if chosen is None or mem['pairs'].get((board, chosen), 0) >= int(p[15]):",
  "        mem['plan'] = []",
  "        options = []",
  "        for a in range(len(actions)):",
  "            nxt = mem['edges'].get((board, a))",
  "            if nxt is None and a in models:",
  "                nxt = transform(board, models[a])",
  "            value = p[16] * mem['pairs'].get((board, a), 0) + p[17] * mem['failed'].get(a, 0)",
  "            if nxt is not None:",
  "                value += p[18] * visits.get(nxt, 0)",
  "            value += p[19] * mem['uses'].get(a, 0)",
  "            options.append((value, a))",
  "        options.sort()",
  "        chosen = options[0][1]",
  "    mem['pairs'][(board, chosen)] = mem['pairs'].get((board, chosen), 0) + 1",
  "    mem['uses'][chosen] = mem['uses'].get(chosen, 0) + 1",
  "    mem['last'] = (board, chosen)",
  "    return actions[chosen]"
 ],
