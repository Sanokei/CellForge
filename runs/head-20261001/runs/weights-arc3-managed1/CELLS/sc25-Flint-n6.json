 "n": 6,
 "source_lines": [
  "def groups(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    result = []",
  "    while remaining:",
  "        point = next(iter(remaining))",
  "        remaining.remove(point)",
  "        todo = [point]",
  "        cells = [point]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        r = sum(p[0] for p in cells)/len(cells)",
  "        c = sum(p[1] for p in cells)/len(cells)",
  "        near = min(cells, key=lambda p: abs(p[0]-r)+abs(p[1]-c))",
  "        result.append((r,c,len(cells),near[0],near[1]))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    colours = params['colours']",
  "    advanced = info['levels'] >= int(params['probe'][0])",
  "    bounds = max(1,min(frame.shape[0],int(cfg[0])))",
  "    width = max(1,min(frame.shape[1],int(cfg[1])))",
  "    mask = (frame == int(colours[0])) | (frame == int(colours[1]))",
  "    mask[bounds:,:] = False",
  "    mask[:,width:] = False",
  "    objects = groups(mask)",
  "    objects.sort(key=lambda p:p[2])",
  "    agent = objects[0] if objects else None",
  "    goal = objects[-1] if len(objects)>1 else None",
  "    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:",
  "        motion = mem.get('motion',{})",
  "        knowledge = mem.get('knowledge',{})",
  "        mem.clear()",
  "        mem['motion'] = motion",
  "        mem['knowledge'] = knowledge",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['effects'] = {}",
  "        mem['stuck'] = 0",
  "        mem['positions'] = {}",
  "        mem['transitions'] = {}",
  "        mem['modes'] = {}",
  "        mem['mode'] = ()",
  "    signature = tuple(int(v) for v in frame[:bounds,:width].flatten())",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, identity, oldagent, oldframe = old",
  "        delta = np.argwhere(frame[:,:width] != oldframe[:,:width])",
  "        meaningful = any(int(p[0]) < bounds for p in delta)",
  "        if signature == oldsig:",
  "            pair = (oldsig,identity)",
  "            mem['blocked'][pair] = mem['blocked'].get(pair,0)+1",
  "            mem['stuck'] += 1",
  "        else:",
  "            mem['stuck'] = 0",
  "        if identity[0] == 'key' and agent is not None and oldagent is not None:",
  "            dr = agent[0]-oldagent[0]",
  "            dc = agent[1]-oldagent[1]",
  "            if abs(dr)+abs(dc) >= cfg[2] and abs(dr)+abs(dc) <= cfg[3]:",
  "                mem['motion'][identity[1]] = (dr,dc)",
  "                if advanced:",
  "                    mode = mem.get('lastmode',())",
  "                    mem['modes'][(mode,identity[1])] = (dr,dc)",
  "            if advanced:",
  "                start = (int(round(oldagent[0])),int(round(oldagent[1])),mem.get('lastmode',()))",
  "                end = (int(round(agent[0])),int(round(agent[1])),mem['mode'])",
  "                if signature != oldsig:",
  "                    mem['transitions'][(start,identity[1])] = end",
  "        if identity[0] == 'click':",
  "            changes = len(delta)",
  "            previous_effect = mem['effects'].get(identity,0)",
  "            mem['effects'][identity] = max(previous_effect,changes if meaningful else changes*cfg[4])",
  "            if advanced and meaningful:",
  "                mem['mode'] = identity",
  "    visits = mem['visits'].setdefault(signature,{})",
  "    candidates = []",
  "    for i in range(len(params['order'])):",
  "        action = int(params['order'][i])",
  "        if action not in avail:",
  "            continue",
  "        identity = ('key',action)",
  "        score = cfg[5]-i*cfg[6]",
  "        dr,dc = mem['motion'].get(action,(params['directions'][i][0],params['directions'][i][1]))",
  "        if agent is not None and goal is not None:",
  "            before = abs(agent[0]-goal[0])+abs(agent[1]-goal[1])",
  "            after = abs(agent[0]+dr-goal[0])+abs(agent[1]+dc-goal[1])",
  "            score += cfg[7]*(before-after)",
  "            r = max(0,min(frame.shape[0]-1,int(round(agent[0]+dr))))",
  "            c = max(0,min(frame.shape[1]-1,int(round(agent[1]+dc))))",
  "            if int(frame[r,c]) == int(colours[2]):",
  "                score += cfg[8]",
  "            elif int(frame[r,c]) == int(colours[3]):",
  "                score -= cfg[9]",
  "        candidates.append((score,identity,action,0,0))",
  "    click = int(cfg[10])",
  "    if click in avail:",
  "        for colour in params['click_colours']:",
  "            for obj in groups(frame == int(colour)):",
  "                r,c,area,pr,pc = obj",
  "                if r >= cfg[11] and area <= cfg[12] and c < width:",
  "                    identity = ('click',int(colour),int(round(r)),int(round(c)))",
  "                    score = cfg[13]+min(cfg[14],mem['stuck'])*cfg[15]",
  "                    score += min(cfg[16],mem['effects'].get(identity,0))*cfg[17]",
  "                    candidates.append((score,identity,click,pc,pr))",
  "        if agent is not None:",
  "            identity = ('click','agent',int(round(agent[0])),int(round(agent[1])))",
  "            candidates.append((cfg[18],identity,click,agent[4],agent[3]))",
  "        if goal is not None:",
  "            identity = ('click','goal',int(round(goal[0])),int(round(goal[1])))",
  "            candidates.append((cfg[18],identity,click,goal[4],goal[3]))",
  "    newrule = info['levels'] >= int(params['adapt'][0])",
  "    if newrule and agent is not None:",
  "        adapt = params['adapt']",
  "        probe = params['probe']",
  "        targets = []",
  "        for colour in params['targets']:",
  "            tm = frame == int(colour)",
  "            tm[bounds:,:] = False",
  "            tm[:,width:] = False",
  "            for obj in groups(tm):",
  "                if not advanced or obj[1] >= probe[1]:",
  "                    targets.append(obj)",
  "        if not advanced and targets:",
  "            targets.sort(key=lambda p:p[2])",
  "            goal = targets[0]",
  "        if advanced and goal is None and targets:",
  "            goal = min(targets,key=lambda p:abs(p[0]-agent[0])+abs(p[1]-agent[1]))",
  "        sr = int(round(agent[0]))",
  "        sc = int(round(agent[1]))",
  "        position = (sr,sc)",
  "        mode = mem['mode']",
  "        poskey = (sr,sc,mode) if advanced else position",
  "        mem['positions'][poskey] = mem['positions'].get(poskey,0)+1",
  "        route = None",
  "        if goal is not None:",
  "            queue = [position]",
  "            distance = {position:0}",
  "            first = {}",
  "            head = 0",
  "            nearest = position",
  "            nearestscore = abs(sr-goal[0])+abs(sc-goal[1])",
  "            limit = max(1,int(adapt[1]))",
  "            while head < len(queue) and head < limit:",
  "                r,c = queue[head]",
  "                head += 1",
  "                proximity = abs(r-goal[0])+abs(c-goal[1])",
  "                if proximity < nearestscore:",
  "                    nearestscore = proximity",
  "                    nearest = (r,c)",
  "                if proximity <= adapt[2]:",
  "                    nearest = (r,c)",
  "                    break",
  "                for i in range(len(params['order'])):",
  "                    action = int(params['order'][i])",
  "                    if action not in avail:",
  "                        continue",
  "                    default = mem['motion'].get(action,(params['directions'][i][0],params['directions'][i][1]))",
  "                    dr,dc = mem['modes'].get((mode,action),default) if advanced else default",
  "                    nr = int(round(r+dr))",
  "                    nc = int(round(c+dc))",
  "                    q = (nr,nc)",
  "                    if q in distance or nr < 0 or nr >= bounds or nc < 0 or nc >= width:",
  "                        continue",
  "                    pixel = int(frame[nr,nc])",
  "                    passable = pixel == int(colours[2]) or pixel == int(colours[0]) or pixel == int(colours[1])",
  "                    passable = passable or any(pixel == int(v) for v in params['targets'])",
  "                    if advanced:",
  "                        passable = passable or pixel == int(probe[2])",
  "                        if mem['blocked'].get((signature,('key',action)),0) > cfg[21] and (r,c) == position:",
  "                            passable = False",
  "                    if not passable:",
  "                        continue",
  "                    distance[q] = distance[(r,c)]+1",
  "                    first[q] = action if (r,c) == position else first[(r,c)]",
  "                    queue.append(q)",
  "            route = first.get(nearest)",
  "        revised = []",
  "        for score,identity,action,x,y in candidates:",
  "            if identity[0] == 'key':",
  "                score = adapt[3]",
  "                if action == route:",
  "                    score += adapt[4]",
  "                i = next((j for j in range(len(params['order'])) if int(params['order'][j]) == action),0)",
  "                default = mem['motion'].get(action,(params['directions'][i][0],params['directions'][i][1]))",
  "                dr,dc = mem['modes'].get((mode,action),default) if advanced else default",
  "                nr = int(round(sr+dr))",
  "                nc = int(round(sc+dc))",
  "                if goal is not None:",
  "                    score += adapt[5]*(abs(sr-goal[0])+abs(sc-goal[1])-abs(nr-goal[0])-abs(nc-goal[1]))",
  "                nextkey = (nr,nc,mode) if advanced else (nr,nc)",
  "                score -= adapt[6]*mem['positions'].get(nextkey,0)",
  "                if nr < 0 or nr >= bounds or nc < 0 or nc >= width:",
  "                    score -= adapt[7]",
  "                elif int(frame[nr,nc]) == int(colours[3]):",
  "                    score -= adapt[7]",
  "                score -= i*cfg[6]",
  "                if advanced and (mode,action) not in mem['modes']:",
  "                    score += probe[3]",
  "                revised.append((score,identity,action,x,y))",
  "        if click in avail:",
  "            control_colours = params['extra_controls'] if advanced else params['controls']",
  "            for colour in control_colours:",
  "                cm = frame == int(colour)",
  "                if not advanced:",
  "                    cm[:int(cfg[11]),:] = False",
  "                cm[:,width:] = False",
  "                for obj in groups(cm):",
  "                    r,c,area,pr,pc = obj",
  "                    if area > cfg[12]:",
  "                        continue",
  "                    if advanced and r < cfg[11] and c >= probe[1]:",
  "                        continue",
  "                    identity = ('click',int(colour),int(round(r)),int(round(c)))",
  "                    failures = mem['blocked'].get((signature,identity),0)",
  "                    effect = mem['effects'].get(identity,0)",
  "                    score = adapt[8]+min(adapt[9],mem['stuck'])*adapt[10]",
  "                    if route is None:",
  "                        score += adapt[11]",
  "                    score += min(cfg[16],effect)*adapt[12]",
  "                    score -= failures*adapt[13]",
  "                    if advanced:",
  "                        score += probe[4] if identity not in mem['knowledge'] else 0",
  "                        score -= probe[5]*mem['knowledge'].get(identity,0)",
  "                        if effect > probe[6]:",
  "                            score += probe[7]",
  "                    revised.append((score,identity,click,pc,pr))",
  "            if mem['stuck'] >= adapt[14]:",
  "                for obj in objects:",
  "                    identity = ('click','object',int(round(obj[0])),int(round(obj[1])))",
  "                    revised.append((adapt[15],identity,click,obj[4],obj[3]))",
  "        candidates = revised",
  "    best = None",
  "    bestscore = -1000000",
  "    for score,identity,action,x,y in candidates:",
  "        count = visits.get(identity,0)",
  "        failures = mem['blocked'].get((signature,identity),0)",
  "        score -= cfg[19]*count",
  "        score -= cfg[20]*max(0,failures-cfg[21])",
  "        if old is not None and identity == old[1] and signature != old[0]:",
  "            score += cfg[22]",
  "        if newrule and old is not None and identity == old[1] and signature == old[0] and failures <= cfg[21]:",
  "            score += params['adapt'][16]",
  "        if advanced and failures > cfg[21]:",
  "            score -= params['probe'][8]*failures",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity,action,x,y)",
  "    if best is None:",
  "        best = (('fallback',avail[0]),avail[0],0,0)",
  "    identity,action,x,y = best",
  "    visits[identity] = visits.get(identity,0)+1",
  "    if advanced and identity[0] == 'click':",
  "        mem['knowledge'][identity] = mem['knowledge'].get(identity,0)+1",
  "    mem['lastmode'] = mem['mode']",
  "    mem['previous'] = (signature,identity,agent,frame.copy())",
  "    return (action,max(0,min(frame.shape[1]-1,int(x))),max(0,min(frame.shape[0]-1,int(y))))"
 ],
