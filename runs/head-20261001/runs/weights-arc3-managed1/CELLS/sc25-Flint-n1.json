 "source_lines": [
  "def groups(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    result = []",
  "    while remaining:",
  "        point = next(iter(remaining))",
  "        remaining.remove(point)",
  "        todo = [point]",
  "        cells = [point]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        r = sum(p[0] for p in cells) / len(cells)",
  "        c = sum(p[1] for p in cells) / len(cells)",
  "        near = min(cells, key=lambda p: abs(p[0] - r) + abs(p[1] - c))",
  "        result.append((r, c, len(cells), near[0], near[1]))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    colours = params['colours']",
  "    bounds = int(cfg[0])",
  "    width = int(cfg[1])",
  "    mask = (frame == int(colours[0])) | (frame == int(colours[1]))",
  "    mask[bounds:, :] = False",
  "    mask[:, width:] = False",
  "    objects = groups(mask)",
  "    objects.sort(key=lambda p: p[2])",
  "    agent = objects[0] if objects else None",
  "    goal = objects[-1] if len(objects) > 1 else None",
  "    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:",
  "        motion = mem.get('motion', {})",
  "        mem.clear()",
  "        mem['motion'] = motion",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['effects'] = {}",
  "        mem['stuck'] = 0",
  "    signature = tuple(int(v) for v in frame[:bounds, :width].flatten())",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, identity, oldagent, oldframe = old",
  "        delta = np.argwhere(frame[:, :width] != oldframe[:, :width])",
  "        meaningful = any(int(p[0]) < bounds for p in delta)",
  "        if signature == oldsig:",
  "            pair = (oldsig, identity)",
  "            mem['blocked'][pair] = mem['blocked'].get(pair, 0) + 1",
  "            mem['stuck'] += 1",
  "        else:",
  "            mem['stuck'] = 0",
  "        if identity[0] == 'key' and agent is not None and oldagent is not None:",
  "            dr = agent[0] - oldagent[0]",
  "            dc = agent[1] - oldagent[1]",
  "            if abs(dr) + abs(dc) >= cfg[2] and abs(dr) + abs(dc) <= cfg[3]:",
  "                mem['motion'][identity[1]] = (dr, dc)",
  "        if identity[0] == 'click':",
  "            changes = len(delta)",
  "            previous_effect = mem['effects'].get(identity, 0)",
  "            mem['effects'][identity] = max(previous_effect, changes if meaningful else changes * cfg[4])",
  "    visits = mem['visits'].setdefault(signature, {})",
  "    candidates = []",
  "    for i in range(len(params['order'])):",
  "        action = int(params['order'][i])",
  "        if action not in avail:",
  "            continue",
  "        identity = ('key', action)",
  "        score = cfg[5] - i * cfg[6]",
  "        dr, dc = mem['motion'].get(action, (params['directions'][i][0], params['directions'][i][1]))",
  "        if agent is not None and goal is not None:",
  "            before = abs(agent[0] - goal[0]) + abs(agent[1] - goal[1])",
  "            after = abs(agent[0] + dr - goal[0]) + abs(agent[1] + dc - goal[1])",
  "            score += cfg[7] * (before - after)",
  "            r = max(0, min(frame.shape[0] - 1, int(round(agent[0] + dr))))",
  "            c = max(0, min(frame.shape[1] - 1, int(round(agent[1] + dc))))",
  "            if int(frame[r, c]) == int(colours[2]):",
  "                score += cfg[8]",
  "            elif int(frame[r, c]) == int(colours[3]):",
  "                score -= cfg[9]",
  "        candidates.append((score, identity, action, 0, 0))",
  "    click = int(cfg[10])",
  "    if click in avail:",
  "        for colour in params['click_colours']:",
  "            for obj in groups(frame == int(colour)):",
  "                r, c, area, pr, pc = obj",
  "                if r >= cfg[11] and area <= cfg[12] and c < width:",
  "                    identity = ('click', int(colour), int(round(r)), int(round(c)))",
  "                    score = cfg[13] + min(cfg[14], mem['stuck']) * cfg[15]",
  "                    score += min(cfg[16], mem['effects'].get(identity, 0)) * cfg[17]",
  "                    candidates.append((score, identity, click, pc, pr))",
  "        if agent is not None:",
  "            identity = ('click', 'agent', int(round(agent[0])), int(round(agent[1])))",
  "            candidates.append((cfg[18], identity, click, agent[4], agent[3]))",
  "        if goal is not None:",
  "            identity = ('click', 'goal', int(round(goal[0])), int(round(goal[1])))",
  "            candidates.append((cfg[18], identity, click, goal[4], goal[3]))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score, identity, action, x, y in candidates:",
  "        count = visits.get(identity, 0)",
  "        failures = mem['blocked'].get((signature, identity), 0)",
  "        score -= cfg[19] * count",
  "        score -= cfg[20] * max(0, failures - cfg[21])",
  "        if old is not None and identity == old[1] and signature != old[0]:",
  "            score += cfg[22]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity, action, x, y)",
  "    if best is None:",
  "        best = (('fallback', avail[0]), avail[0], 0, 0)",
  "    identity, action, x, y = best",
  "    visits[identity] = visits.get(identity, 0) + 1",
  "    mem['previous'] = (signature, identity, agent, frame.copy())",
  "    return (action, max(0, min(frame.shape[1] - 1, int(x))), max(0, min(frame.shape[0] - 1, int(y))))"
 ],
