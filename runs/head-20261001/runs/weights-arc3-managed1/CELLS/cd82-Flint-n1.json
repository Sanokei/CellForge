 "source_lines": [
  "def components(frame, bg):",
  "    seen = set()",
  "    out = []",
  "    for y in range(frame.shape[0]):",
  "        for x in range(frame.shape[1]):",
  "            if (y, x) in seen or int(frame[y, x]) == bg:",
  "                continue",
  "            colour = int(frame[y, x])",
  "            queue = [(y, x)]",
  "            seen.add((y, x))",
  "            points = []",
  "            while queue:",
  "                ry, rx = queue.pop()",
  "                points.append((ry, rx))",
  "                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
  "                    ny, nx = ry + dy, rx + dx",
  "                    if ny >= 0 and nx >= 0 and ny < frame.shape[0] and nx < frame.shape[1]:",
  "                        if (ny, nx) not in seen and int(frame[ny, nx]) == colour:",
  "                            seen.add((ny, nx))",
  "                            queue.append((ny, nx))",
  "            out.append((colour, points))",
  "    return out",
  "def act(params, mem, frame, avail, info):",
  "    p = params['p']",
  "    order = [int(v) for v in params['order']]",
  "    bg, dark, light = int(p[0]), int(p[1]), int(p[2])",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    fresh = mem.get('level') != level or mem.get('reset') != reset",
  "    if fresh:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['graph'] = {}",
  "        mem['tried'] = {}",
  "        mem['quality'] = {}",
  "        mem['visits'] = {}",
  "        mem['effects'] = {}",
  "        mem['ticks'] = 0",
  "        ty, tx, n = int(p[3]), int(p[4]), max(1, int(p[5]))",
  "        mem['target'] = frame[ty:ty+n, tx:tx+n].copy()",
  "        cy, cx = int(p[9]), int(p[10])",
  "        clicks = []",
  "        largest = 0",
  "        for colour, points in components(frame, bg):",
  "            count = len(points)",
  "            ys = [v[0] for v in points]",
  "            xs = [v[1] for v in points]",
  "            if colour == dark and min(xs) >= int(p[6]) and min(ys) >= int(p[7]) and count > largest:",
  "                largest = count",
  "                cy, cx = min(ys), min(xs)",
  "            if count <= p[14]:",
  "                my = sum(ys) / count",
  "                mx = sum(xs) / count",
  "                best = min(points, key=lambda v: (v[0]-my)*(v[0]-my)+(v[1]-mx)*(v[1]-mx))",
  "                clicks.append((6, best[1], best[0]))",
  "        mem['canvas'] = (cy, cx)",
  "        mem['probe'] = [(a, 0, 0) for a in order if a in avail]",
  "        if 6 in avail:",
  "            mem['probe'] += clicks[:max(0, int(p[15]))]",
  "        mem['clicks'] = clicks",
  "    y0, x0, y1 = int(p[7]), int(p[6]), int(p[8])",
  "    state = tuple(tuple(int(v) for v in row[x0:]) for row in frame[y0:y1])",
  "    cy, cx = mem['canvas']",
  "    target = mem['target']",
  "    n = target.shape[0]",
  "    patch = frame[cy:cy+n, cx:cx+n]",
  "    quality = 0.0",
  "    if patch.shape == target.shape and target.size > 0:",
  "        relevant = (target == dark) | (target == light)",
  "        denom = max(1, int(np.sum(relevant)))",
  "        quality = float(np.sum((patch == target) & relevant)) / denom",
  "    graph = mem['graph']",
  "    tried = mem['tried']",
  "    values = mem['quality']",
  "    graph.setdefault(state, {})",
  "    tried.setdefault(state, set())",
  "    values[state] = quality",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if 'last' in mem:",
  "        previous, command, oldquality = mem['last']",
  "        graph.setdefault(previous, {})[command] = state",
  "        tried.setdefault(previous, set()).add(command)",
  "        effect = mem['effects'].setdefault(command[0], [0, 0, 0.0])",
  "        effect[0] += 1",
  "        if previous != state:",
  "            effect[1] += 1",
  "        effect[2] += quality - oldquality",
  "    command = None",
  "    if mem['probe']:",
  "        command = mem['probe'].pop(0)",
  "    else:",
  "        actions = [(a, 0, 0) for a in order if a in avail]",
  "        frontier = [(state, [])]",
  "        reached = {state}",
  "        index = 0",
  "        bestscore = -1000000.0",
  "        while index < len(frontier) and index < int(p[16]):",
  "            node, path = frontier[index]",
  "            index += 1",
  "            used = tried.setdefault(node, set())",
  "            for rank, candidate in enumerate(actions):",
  "                if candidate not in used:",
  "                    effect = mem['effects'].get(candidate[0], [0, 0, 0.0])",
  "                    activity = effect[1] / max(1, effect[0])",
  "                    score = p[12]*values.get(node, quality) - p[11]*len(path) + p[13]*activity - p[17]*rank",
  "                    score -= p[18]*visits.get(node, 0)",
  "                    if score > bestscore:",
  "                        bestscore = score",
  "                        command = path[0] if path else candidate",
  "            for edge, destination in graph.get(node, {}).items():",
  "                if destination not in reached and edge[0] in avail:",
  "                    reached.add(destination)",
  "                    frontier.append((destination, path + [edge]))",
  "        if command is None:",
  "            candidates = actions",
  "            if 6 in avail:",
  "                candidates += mem['clicks']",
  "            bestscore = -1000000.0",
  "            for rank, candidate in enumerate(candidates):",
  "                destination = graph[state].get(candidate)",
  "                score = values.get(destination, quality) * p[12] - p[18]*visits.get(destination, 0) - p[17]*rank",
  "                if destination is None:",
  "                    score += p[19]",
  "                if score > bestscore:",
  "                    bestscore = score",
  "                    command = candidate",
  "    if command is None or command[0] not in avail:",
  "        command = (avail[0], 0, 0)",
  "    mem['last'] = (state, command, quality)",
  "    mem['ticks'] += 1",
  "    return command"
