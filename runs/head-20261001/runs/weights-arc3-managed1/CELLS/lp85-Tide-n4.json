 "source_lines": [
  "def components(frame, colours):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(frame.shape[0]):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c not in colours:",
  "                continue",
  "            todo = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while todo:",
  "                yy, xx = todo.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if 0 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                        seen[ny, nx] = True",
  "                        todo.append((ny, nx))",
  "            ys = [p[0] for p in cells]",
  "            xs = [p[1] for p in cells]",
  "            out.append((c, min(xs), min(ys), max(xs), max(ys), len(cells)))",
  "    return out",
  "def read_board(frame, slots):",
  "    return tuple(int(frame[y, x]) for x, y in slots)",
  "def infer(history):",
  "    n = len(history[0])",
  "    mapping = [-1] * n",
  "    used = set()",
  "    for d in range(n):",
  "        if all(h[d] == history[0][d] for h in history):",
  "            mapping[d] = d",
  "            used.add(d)",
  "    for d in range(n):",
  "        if mapping[d] >= 0:",
  "            continue",
  "        candidates = []",
  "        for s in range(n):",
  "            if s not in used and all(history[t + 1][d] == history[t][s] for t in range(len(history) - 1)):",
  "                candidates.append(s)",
  "        if len(candidates) == 1:",
  "            mapping[d] = candidates[0]",
  "            used.add(candidates[0])",
  "    if any(v < 0 for v in mapping):",
  "        return None",
  "    return tuple(mapping)",
  "def transform(board, mapping):",
  "    return tuple(board[s] for s in mapping)",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    level = info.get('levels', 0)",
  "    colours = [i for i in range(len(params['tiles'])) if params['tiles'][i] > 0]",
  "    if mem.get('level') != level or mem.get('reset') != info.get('resets', 0):",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = info.get('resets', 0)",
  "        comps = components(frame, colours + [int(p[0]), int(p[1])])",
  "        squares = [o for o in comps if o[0] in colours and o[3] - o[1] == o[4] - o[2] and o[5] == (o[3] - o[1] + 1) ** 2]",
  "        counts = {}",
  "        for o in squares:",
  "            counts[o[5]] = counts.get(o[5], 0) + 1",
  "        size = max(counts, key=lambda k: counts[k] * k ** float(p[3])) if counts else 0",
  "        tiles = sorted([o for o in squares if o[5] == size], key=lambda o: (o[2], o[1]))",
  "        mem['slots'] = [((o[1] + o[3]) // 2, (o[2] + o[4]) // 2) for o in tiles]",
  "        targets = []",
  "        for i, o in enumerate(tiles):",
  "            c, x0, y0, x1, y1, area = o",
  "            if x0 > 0 and y0 > 0 and x1 + 1 < frame.shape[1] and y1 + 1 < frame.shape[0]:",
  "                corners = [frame[y0 - 1, x0 - 1], frame[y0 - 1, x1 + 1], frame[y1 + 1, x0 - 1], frame[y1 + 1, x1 + 1]]",
  "                if all(int(v) == int(p[2]) for v in corners):",
  "                    targets.append(i)",
  "        mem['targets'] = targets",
  "        arrows = [o for o in comps if o[0] in [int(p[0]), int(p[1])] and o[5] <= p[4] and o[3] - o[1] > 0 and o[4] - o[2] > 0]",
  "        arrows.sort(key=lambda o: (o[2], o[1]))",
  "        mem['actions'] = [(6, (o[1] + o[3]) // 2, (o[2] + o[4]) // 2) for o in arrows]",
  "        mem['models'] = {}",
  "        mem['probe'] = 0",
  "        mem['history'] = []",
  "        mem['visits'] = {}",
  "        mem['failed'] = {}",
  "        mem['edges'] = {}",
  "    actions = mem['actions']",
  "    if not actions:",
  "        return (avail[0], int(p[5]), int(p[6]))",
  "    board = read_board(frame, mem['slots'])",
  "    visits = mem['visits']",
  "    visits[board] = visits.get(board, 0) + 1",
  "    if 'last' in mem:",
  "        old, a = mem['last']",
  "        mem['edges'][(old, a)] = board",
  "        if old == board:",
  "            mem['failed'][a] = mem['failed'].get(a, 0) + 1",
  "        if a in mem['models'] and transform(old, mem['models'][a]) != board:",
  "            mem['models'].pop(a)",
  "    probe = mem['probe']",
  "    if probe < len(actions):",
  "        a = probe",
  "        history = mem['history']",
  "        if not history:",
  "            history.append(board)",
  "        elif mem.get('last', (None, None))[1] == a:",
  "            history.append(board)",
  "        model = infer(history) if len(history) >= int(p[7]) else None",
  "        if model is not None:",
  "            mem['models'][a] = model",
  "            inverse = [0] * len(model)",
  "            for d, s in enumerate(model):",
  "                inverse[s] = d",
  "            for b, click in enumerate(actions):",
  "                if b != a and abs(click[2] - actions[a][2]) <= p[8]:",
  "                    mem['models'][b] = tuple(inverse)",
  "            mem['probe'] += 1",
  "            while mem['probe'] < len(actions) and mem['probe'] in mem['models']:",
  "                mem['probe'] += 1",
  "            mem['history'] = []",
  "        elif len(history) >= int(p[9]) or mem['failed'].get(a, 0) >= int(p[10]):",
  "            mem['probe'] += 1",
  "            mem['history'] = []",
  "        else:",
  "            mem['last'] = (board, a)",
  "            return actions[a]",
  "    models = mem['models']",
  "    targets = mem['targets']",
  "    goal = int(p[2])",
  "    distances = []",
  "    for target in targets:",
  "        dist = [int(p[11])] * len(board)",
  "        dist[target] = 0",
  "        for step in range(len(board)):",
  "            change = False",
  "            for mapping in models.values():",
  "                for d, s in enumerate(mapping):",
  "                    if dist[s] > dist[d] + 1:",
  "                        dist[s] = dist[d] + 1",
  "                        change = True",
  "            if not change:",
  "                break",
  "        distances.append(dist)",
  "    def score(state):",
  "        total = 0.0",
  "        for j, target in enumerate(targets):",
  "            best = min([distances[j][i] for i, c in enumerate(state) if c == goal] + [int(p[11])])",
  "            total += best",
  "            if state[target] != goal:",
  "                total += p[12]",
  "        return total",
  "    best_action = None",
  "    best_value = float('inf')",
  "    beam = [(board, None)]",
  "    reached = {board}",
  "    solved = False",
  "    for depth in range(int(p[13])):",
  "        candidates = []",
  "        for state, first in beam:",
  "            for a, mapping in models.items():",
  "                nxt = transform(state, mapping)",
  "                if nxt == state or nxt in reached:",
  "                    continue",
  "                reached.add(nxt)",
  "                initial = a if first is None else first",
  "                value = score(nxt)",
  "                rank = value + p[14] * visits.get(nxt, 0) + p[15] * depth",
  "                if rank < best_value:",
  "                    best_value = rank",
  "                    best_action = initial",
  "                if targets and all(nxt[t] == goal for t in targets):",
  "                    best_action = initial",
  "                    solved = True",
  "                    break",
  "                candidates.append((rank, nxt, initial))",
  "            if solved:",
  "                break",
  "        if solved or not candidates:",
  "            break",
  "        candidates.sort(key=lambda item: item[0])",
  "        beam = [(item[1], item[2]) for item in candidates[:int(p[16])]]",
  "    if best_action is None:",
  "        options = []",
  "        for a in range(len(actions)):",
  "            nxt = mem['edges'].get((board, a))",
  "            penalty = p[17] * mem['failed'].get(a, 0)",
  "            if nxt is not None:",
  "                penalty += p[18] * visits.get(nxt, 0)",
  "            penalty += p[19] * mem.get('uses', {}).get(a, 0)",
  "            options.append((penalty, a))",
  "        options.sort()",
  "        best_action = options[0][1]",
  "    mem.setdefault('uses', {})[best_action] = mem.setdefault('uses', {}).get(best_action, 0) + 1",
  "    mem['last'] = (board, best_action)",
  "    return actions[best_action]"
