{
 "game": "s5i5",
 "house": "Tide",
 "n": 3,
 "source_lines": [
  "def components(frame, colour):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        stack = [start]",
  "        group = []",
  "        while stack:",
  "            y, x = stack.pop()",
  "            group.append((y, x))",
  "            for dy in (-1, 0, 1):",
  "                for dx in (-1, 0, 1):",
  "                    q = (y + dy, x + dx)",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        stack.append(q)",
  "        result.append(group)",
  "    return result",
  "def distance(markers, targets):",
  "    total = 0.0",
  "    for x, y in markers:",
  "        if targets:",
  "            total += min(abs(x - tx) + abs(y - ty) for tx, ty in targets)",
  "    return total",
  "def first_level(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    controls = []",
  "    for group in components(frame, int(p[0])):",
  "        if p[2] <= len(group) <= p[3]:",
  "            cy = sum(q[0] for q in group) / len(group)",
  "            cx = sum(q[1] for q in group) / len(group)",
  "            if cy < p[4]:",
  "                point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))",
  "                controls.append((point[1], point[0]))",
  "    controls.sort()",
  "    markers = []",
  "    targets = []",
  "    for group in components(frame, int(p[1])):",
  "        x = sum(q[1] for q in group) / len(group)",
  "        y = sum(q[0] for q in group) / len(group)",
  "        if len(group) <= p[5]:",
  "            markers.append((x, y))",
  "        elif p[6] <= len(group) <= p[7]:",
  "            targets.append((x, y))",
  "    markers.sort()",
  "    targets.sort()",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "        mem['models'] = {}",
  "        mem['trials'] = {}",
  "        mem['used'] = {}",
  "        mem['visits'] = {}",
  "    models = mem['models']",
  "    trials = mem['trials']",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old_markers, old_targets, old_action = previous",
  "        effects = []",
  "        unmatched = list(markers)",
  "        for ox, oy in old_markers:",
  "            if unmatched:",
  "                current = min(unmatched, key=lambda q: abs(q[0] - ox) + abs(q[1] - oy))",
  "                unmatched.remove(current)",
  "                dx = current[0] - ox",
  "                dy = current[1] - oy",
  "                if abs(dx) + abs(dy) > p[8]:",
  "                    effects.append((current[0], current[1], dx, dy))",
  "        models[old_action] = effects",
  "        trials[old_action] = trials.get(old_action, 0) + 1",
  "    state = (tuple(markers), tuple(targets), int(np.sum(frame == int(p[9]))), int(np.sum(frame == int(p[10]))))",
  "    used = mem['used'].setdefault(state, {})",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if not controls:",
  "        objects = []",
  "        for colour in np.unique(frame):",
  "            if int(colour) != int(p[11]):",
  "                for group in components(frame, int(colour)):",
  "                    if p[2] <= len(group) <= p[3]:",
  "                        cy = sum(q[0] for q in group) / len(group)",
  "                        cx = sum(q[1] for q in group) / len(group)",
  "                        if cy < p[4]:",
  "                            point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))",
  "                            objects.append((point[1], point[0]))",
  "        controls = sorted(set(objects))",
  "    if not controls:",
  "        return (avail[0], int(p[12]), int(p[13]))",
  "    current_distance = distance(markers, targets)",
  "    best = controls[0]",
  "    best_score = -1000000000.0",
  "    for index, action in enumerate(controls):",
  "        count = trials.get(action, 0)",
  "        score = 0.0",
  "        if count == 0:",
  "            score += p[14]",
  "        else:",
  "            effects = models.get(action, [])",
  "            predicted = list(markers)",
  "            assigned = set()",
  "            for ax, ay, dx, dy in effects:",
  "                candidates = [i for i in range(len(markers)) if i not in assigned]",
  "                if candidates:",
  "                    i = min(candidates, key=lambda j: abs(markers[j][0] - ax) + abs(markers[j][1] - ay))",
  "                    assigned.add(i)",
  "                    predicted[i] = (markers[i][0] + dx * p[15], markers[i][1] + dy * p[15])",
  "            score += p[16] * (current_distance - distance(predicted, targets))",
  "            if not effects:",
  "                score -= p[17]",
  "            predicted_state = (tuple(sorted(predicted)), tuple(targets), state[2], state[3])",
  "            score -= p[18] * visits.get(predicted_state, 0)",
  "        score -= p[19] * used.get(action, 0)",
  "        score -= p[20] * count",
  "        score += p[21] * index",
  "        if score > best_score:",
  "            best_score = score",
  "            best = action",
  "    used[best] = used.get(best, 0) + 1",
  "    mem['previous'] = (markers, targets, best)",
  "    return (6 if 6 in avail else avail[0], int(best[0]), int(best[1]))",
  "def board_read(params, frame):",
  "    p = params['search']",
  "    mask = np.ones(frame.shape, dtype=bool)",
  "    mask[int(p[3]):, :] = False",
  "    controls = []",
  "    for group in components(frame, int(p[0])):",
  "        if len(group) >= p[4]:",
  "            y0 = min(q[0] for q in group)",
  "            y1 = max(q[0] for q in group)",
  "            x0 = min(q[1] for q in group)",
  "            x1 = max(q[1] for q in group)",
  "            mask[y0:y1 + 1, x0:x1 + 1] = False",
  "            for part in components(frame[y0:y1 + 1, x0:x1 + 1], int(p[1])):",
  "                if len(part) >= p[5]:",
  "                    cy = sum(q[0] for q in part) / len(part)",
  "                    cx = sum(q[1] for q in part) / len(part)",
  "                    q = min(part, key=lambda v: abs(v[0] - cy) + abs(v[1] - cx))",
  "                    controls.append((q[1] + x0, q[0] + y0))",
  "    clean = np.where(mask, frame, int(p[2]))",
  "    markers = []",
  "    targets = []",
  "    for group in components(clean, int(p[6])):",
  "        center = (sum(q[1] for q in group) / len(group), sum(q[0] for q in group) / len(group))",
  "        if len(group) <= p[7]:",
  "            markers.append(center)",
  "        elif p[8] <= len(group) <= p[9]:",
  "            targets.append(center)",
  "    bodies = []",
  "    for colour in params['bodies']:",
  "        points = np.argwhere(clean == int(colour))",
  "        bodies.append(tuple((int(q[1]), int(q[0])) for q in points))",
  "    walls = set((int(q[1]), int(q[0])) for q in np.argwhere(clean == int(p[10])))",
  "    state = tuple(tuple(int(v) for v in row) for row in clean)",
  "    return sorted(set(controls)), sorted(markers), sorted(targets), bodies, walls, state, clean",
  "def translated(bodies, shifts):",
  "    return [tuple((x + shifts[i][0], y + shifts[i][1]) for x, y in body) for i, body in enumerate(bodies)]",
  "def act(params, mem, frame, avail, info):",
  "    if info['levels'] < params['search'][11]:",
  "        return first_level(params, mem, frame, avail, info)",
  "    p = params['search']",
  "    controls, markers, targets, bodies, walls, state, clean = board_read(params, frame)",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "        mem['models'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['attempts'] = {}",
  "    models = mem['models']",
  "    edges = mem['edges']",
  "    visits = mem['visits']",
  "    attempts = mem['attempts']",
  "    previous = mem.get('last')",
  "    if previous is not None:",
  "        old_state, old_bodies, old_markers, action = previous",
  "        edges[(old_state, action)] = state",
  "        if state != old_state:",
  "            shifts = []",
  "            for old, new in zip(old_bodies, bodies):",
  "                if old and new and len(old) == len(new):",
  "                    dx = int(round((sum(q[0] for q in new) - sum(q[0] for q in old)) / len(old)))",
  "                    dy = int(round((sum(q[1] for q in new) - sum(q[1] for q in old)) / len(old)))",
  "                    shifts.append((dx, dy))",
  "                else:",
  "                    shifts.append((0, 0))",
  "            if any(abs(dx) + abs(dy) > p[12] for dx, dy in shifts):",
  "                models[action] = tuple(shifts)",
  "    visits[state] = visits.get(state, 0) + 1",
  "    used = attempts.setdefault(state, {})",
  "    extra = []",
  "    for colour in np.unique(clean):",
  "        c = int(colour)",
  "        if c != int(p[2]) and c != int(p[10]):",
  "            for group in components(clean, c):",
  "                if p[13] <= len(group) <= p[14]:",
  "                    cy = sum(q[0] for q in group) / len(group)",
  "                    cx = sum(q[1] for q in group) / len(group)",
  "                    q = min(group, key=lambda v: abs(v[0] - cy) + abs(v[1] - cx))",
  "                    extra.append((q[1], q[0]))",
  "    candidates = controls + [q for q in sorted(set(extra)) if q not in controls]",
  "    if not candidates:",
  "        return (avail[0], int(p[15]), int(p[16]))",
  "    marker_body = []",
  "    for mx, my in markers:",
  "        owner = -1",
  "        best = p[17]",
  "        for i, body in enumerate(bodies):",
  "            if body:",
  "                d = min(abs(mx - x) + abs(my - y) for x, y in body)",
  "                if d < best:",
  "                    best = d",
  "                    owner = i",
  "        marker_body.append(owner)",
  "    shifts0 = tuple((0, 0) for body in bodies)",
  "    frontier = [(distance(markers, targets), 0, shifts0, None)]",
  "    seen = {shifts0: 0}",
  "    route = {}",
  "    expanded = 0",
  "    while frontier and expanded < int(p[18]):",
  "        index = min(range(len(frontier)), key=lambda i: frontier[i][0])",
  "        priority, depth, shifts, first = frontier.pop(index)",
  "        expanded += 1",
  "        current_markers = [(m[0] + (shifts[owner][0] if owner >= 0 else 0), m[1] + (shifts[owner][1] if owner >= 0 else 0)) for m, owner in zip(markers, marker_body)]",
  "        heuristic = distance(current_markers, targets)",
  "        if first is not None:",
  "            value = heuristic + p[19] * depth",
  "            if first not in route or value < route[first]:",
  "                route[first] = value",
  "        if depth >= int(p[20]):",
  "            continue",
  "        for action in controls:",
  "            if action not in models:",
  "                continue",
  "            if depth == 0 and edges.get((state, action)) == state:",
  "                continue",
  "            delta = models[action]",
  "            nxt = tuple((shifts[i][0] + delta[i][0], shifts[i][1] + delta[i][1]) for i in range(len(bodies)))",
  "            if seen.get(nxt, int(p[21])) <= depth + 1:",
  "                continue",
  "            moved = translated(bodies, nxt)",
  "            occupied = []",
  "            valid = True",
  "            for body in moved:",
  "                footprint = set(body)",
  "                if any(x < p[22] or x >= frame.shape[1] - p[22] or y < p[22] or y >= p[3] for x, y in footprint):",
  "                    valid = False",
  "                    break",
  "                if footprint.intersection(walls):",
  "                    valid = False",
  "                    break",
  "                if any(footprint.intersection(other) for other in occupied):",
  "                    valid = False",
  "                    break",
  "                occupied.append(footprint)",
  "            if not valid:",
  "                continue",
  "            seen[nxt] = depth + 1",
  "            projected = [(m[0] + (nxt[owner][0] if owner >= 0 else 0), m[1] + (nxt[owner][1] if owner >= 0 else 0)) for m, owner in zip(markers, marker_body)]",
  "            value = distance(projected, targets) + p[19] * (depth + 1)",
  "            frontier.append((value, depth + 1, nxt, action if first is None else first))",
  "    best = candidates[0]",
  "    best_score = -1000000000.0",
  "    base = distance(markers, targets)",
  "    for index, action in enumerate(candidates):",
  "        count = used.get(action, 0)",
  "        destination = edges.get((state, action))",
  "        score = p[23] * (base - route.get(action, base + p[24]))",
  "        if destination == state:",
  "            score -= p[25]",
  "        elif destination is not None:",
  "            score -= p[26] * visits.get(destination, 0)",
  "        if count == 0:",
  "            score += p[27] if action in controls else p[28]",
  "        score -= p[29] * count",
  "        score -= p[30] * index",
  "        if action in controls and action not in models and count == 0:",
  "            score += p[31]",
  "        if score > best_score:",
  "            best_score = score",
  "            best = action",
  "    used[best] = used.get(best, 0) + 1",
  "    mem['last'] = (state, bodies, markers, best)",
  "    return (6 if 6 in avail else avail[0], int(best[0]), int(best[1]))"
 ],
