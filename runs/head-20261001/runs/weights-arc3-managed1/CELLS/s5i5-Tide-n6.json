 "source_lines": [
  "def groups(frame, colour):",
  "    remaining = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        stack = [start]",
  "        group = []",
  "        while stack:",
  "            y, x = stack.pop()",
  "            group.append((y, x))",
  "            for dy in (-1, 0, 1):",
  "                for dx in (-1, 0, 1):",
  "                    q = (y + dy, x + dx)",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        stack.append(q)",
  "        result.append(group)",
  "    return result",
  "def dist(markers, targets):",
  "    return sum(min(abs(x - tx) + abs(y - ty) for tx, ty in targets) for x, y in markers) if targets else 0.0",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    controls = []",
  "    panels = []",
  "    for group in groups(frame, int(p[0])):",
  "        if len(group) >= p[1]:",
  "            panels.append((min(q[1] for q in group), min(q[0] for q in group), max(q[1] for q in group), max(q[0] for q in group)))",
  "    for group in groups(frame, int(p[2])):",
  "        if p[3] <= len(group) <= p[4]:",
  "            cy = sum(q[0] for q in group) / len(group)",
  "            cx = sum(q[1] for q in group) / len(group)",
  "            if cy < p[5]:",
  "                point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))",
  "                controls.append((point[1], point[0]))",
  "    controls.sort()",
  "    markers = []",
  "    targets = []",
  "    for group in groups(frame, int(p[6])):",
  "        x = sum(q[1] for q in group) / len(group)",
  "        y = sum(q[0] for q in group) / len(group)",
  "        if len(group) <= p[7]:",
  "            markers.append((x, y))",
  "        elif p[8] <= len(group) <= p[9]:",
  "            targets.append((x, y))",
  "    markers.sort()",
  "    targets.sort()",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "        mem['models'] = {}",
  "        mem['trials'] = {}",
  "        mem['used'] = {}",
  "        mem['visits'] = {}",
  "        mem['moves'] = {}",
  "        mem['edges'] = {}",
  "    if not controls:",
  "        return (avail[0], int(p[10]), int(p[11]))",
  "    boxes = []",
  "    colours = []",
  "    for value in params['objects']:",
  "        colour = int(value)",
  "        points = []",
  "        for q in np.argwhere(frame == colour):",
  "            y, x = int(q[0]), int(q[1])",
  "            inside = False",
  "            for left, top, right, bottom in panels:",
  "                if left <= x <= right and top <= y <= bottom:",
  "                    inside = True",
  "            if not inside and y < p[12]:",
  "                points.append((x, y))",
  "        if points:",
  "            colours.append(colour)",
  "            boxes.append((min(q[0] for q in points), min(q[1] for q in points), max(q[0] for q in points), max(q[1] for q in points)))",
  "    boxes = tuple(boxes)",
  "    state = (boxes, tuple(markers), tuple(targets))",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    used = mem['used'].setdefault(state, {})",
  "    models = mem['models']",
  "    trials = mem['trials']",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old_markers, old_boxes, old_colours, old_action, old_state = previous",
  "        effects = []",
  "        unmatched = list(markers)",
  "        for ox, oy in old_markers:",
  "            if unmatched:",
  "                current = min(unmatched, key=lambda q: abs(q[0] - ox) + abs(q[1] - oy))",
  "                unmatched.remove(current)",
  "                dx, dy = current[0] - ox, current[1] - oy",
  "                if abs(dx) + abs(dy) > p[13]:",
  "                    effects.append((current[0], current[1], dx, dy))",
  "        models[old_action] = effects",
  "        trials[old_action] = trials.get(old_action, 0) + 1",
  "        motion = []",
  "        if old_colours == colours:",
  "            for i in range(len(boxes)):",
  "                dx = boxes[i][0] - old_boxes[i][0]",
  "                dy = boxes[i][1] - old_boxes[i][1]",
  "                if abs(dx) + abs(dy) > p[13]:",
  "                    motion.append((i, dx, dy))",
  "        if motion:",
  "            mem['moves'][old_action] = motion",
  "        mem['edges'][(old_state, old_action)] = state",
  "    best = controls[0]",
  "    best_score = -1000000000.0",
  "    current_distance = dist(markers, targets)",
  "    for index, action in enumerate(controls):",
  "        count = trials.get(action, 0)",
  "        score = p[14] if count == 0 else 0.0",
  "        if count:",
  "            predicted = list(markers)",
  "            assigned = set()",
  "            effects = models.get(action, [])",
  "            for ax, ay, dx, dy in effects:",
  "                candidates = [i for i in range(len(markers)) if i not in assigned]",
  "                if candidates:",
  "                    i = min(candidates, key=lambda j: abs(markers[j][0] - ax) + abs(markers[j][1] - ay))",
  "                    assigned.add(i)",
  "                    predicted[i] = (markers[i][0] + dx, markers[i][1] + dy)",
  "            score += p[15] * (current_distance - dist(predicted, targets))",
  "            if not effects:",
  "                score -= p[16]",
  "        destination = mem['edges'].get((state, action))",
  "        if destination is not None:",
  "            score -= p[17] * visits.get(destination, 0)",
  "            if destination == state:",
  "                score -= p[18]",
  "        score -= p[19] * used.get(action, 0)",
  "        score -= p[20] * count",
  "        score += p[21] * index",
  "        if score > best_score:",
  "            best_score, best = score, action",
  "    if info['levels'] >= p[22] and boxes and markers and targets:",
  "        attached = []",
  "        for x, y in markers:",
  "            candidates = [i for i, b in enumerate(boxes) if b[0] <= x <= b[2] and b[1] <= y <= b[3]]",
  "            attached.append(candidates[0] if candidates else -1)",
  "        ready = all(action in mem['moves'] or trials.get(action, 0) >= p[23] for action in controls)",
  "        if not ready:",
  "            choices = [a for a in controls if a not in mem['moves'] and trials.get(a, 0) < p[23] and used.get(a, 0) == 0]",
  "            if choices:",
  "                best = min(choices, key=lambda a: trials.get(a, 0))",
  "        else:",
  "            beam = [(boxes, tuple(markers), None, 0.0)]",
  "            seen = set([(boxes, tuple(markers))])",
  "            winner = None",
  "            winning_score = 1000000000.0",
  "            for depth in range(int(p[24])):",
  "                candidates = []",
  "                for bs, ms, first, cost in beam:",
  "                    for action in controls:",
  "                        motion = mem['moves'].get(action, [])",
  "                        if not motion:",
  "                            continue",
  "                        shifted = list(bs)",
  "                        moved = set()",
  "                        valid = True",
  "                        for i, dx, dy in motion:",
  "                            if i >= len(bs):",
  "                                valid = False",
  "                                break",
  "                            b = bs[i]",
  "                            nb = (b[0] + dx, b[1] + dy, b[2] + dx, b[3] + dy)",
  "                            if nb[0] < p[25] or nb[1] < p[25] or nb[2] >= frame.shape[1] or nb[3] >= p[12]:",
  "                                valid = False",
  "                                break",
  "                            if np.any(frame[int(nb[1]):int(nb[3]) + 1, int(nb[0]):int(nb[2]) + 1] == int(p[26])):",
  "                                valid = False",
  "                                break",
  "                            shifted[i] = nb",
  "                            moved.add(i)",
  "                        if not valid:",
  "                            continue",
  "                        for i in moved:",
  "                            a = shifted[i]",
  "                            for j, b in enumerate(shifted):",
  "                                if i != j and a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]:",
  "                                    valid = False",
  "                        if not valid:",
  "                            continue",
  "                        newmarkers = list(ms)",
  "                        for k, i in enumerate(attached):",
  "                            if i in moved:",
  "                                newmarkers[k] = (ms[k][0] + shifted[i][0] - bs[i][0], ms[k][1] + shifted[i][1] - bs[i][1])",
  "                        ns = (tuple(shifted), tuple(newmarkers))",
  "                        if ns in seen:",
  "                            continue",
  "                        seen.add(ns)",
  "                        first_action = action if first is None else first",
  "                        fullstate = (ns[0], ns[1], tuple(targets))",
  "                        penalty = p[27] * visits.get(fullstate, 0)",
  "                        if first is None:",
  "                            real = mem['edges'].get((state, action))",
  "                            if real == state:",
  "                                penalty += p[28]",
  "                            penalty += p[29] * used.get(action, 0)",
  "                        newcost = cost + p[30] + penalty",
  "                        remaining = dist(newmarkers, targets)",
  "                        rank = remaining * p[31] + newcost",
  "                        candidates.append((rank, ns[0], ns[1], first_action, newcost))",
  "                        if rank < winning_score:",
  "                            winning_score, winner = rank, first_action",
  "                        if remaining <= p[32]:",
  "                            winner = first_action",
  "                            winning_score = -1000000000.0",
  "                    if winning_score < 0:",
  "                        break",
  "                if winning_score < 0 or not candidates:",
  "                    break",
  "                candidates.sort(key=lambda q: q[0])",
  "                beam = [(q[1], q[2], q[3], q[4]) for q in candidates[:int(p[33])]]",
  "            if winner is not None:",
  "                best = winner",
  "    used[best] = used.get(best, 0) + 1",
  "    mem['previous'] = (markers, boxes, colours, best, state)",
  "    return (6 if 6 in avail else avail[0], int(best[0]), int(best[1]))"
 ],
