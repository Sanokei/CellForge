 "source_lines": [
  "def groups(frame, colour, radius):",
  "    remaining = set((int(v[0]), int(v[1])) for v in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        root = remaining.pop()",
  "        todo = [root]",
  "        cells = [root]",
  "        while todo:",
  "            y, x = todo.pop()",
  "            for dy in range(-radius, radius + 1):",
  "                for dx in range(-radius, radius + 1):",
  "                    q = (y + dy, x + dx)",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        todo.append(q)",
  "                        cells.append(q)",
  "        result.append(cells)",
  "    return result",
  "def centre(cells):",
  "    return (sum(v[1] for v in cells) / len(cells), sum(v[0] for v in cells) / len(cells))",
  "def squared(a, b):",
  "    return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['pairs'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['models'] = {}",
  "        mem['blocked'] = {}",
  "    if mem.get('reset') != reset:",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "    endpoints = []",
  "    for colour in [int(p[0]), int(p[1])]:",
  "        for cells in groups(frame, colour, int(p[6])):",
  "            if p[7] <= len(cells) <= p[8]:",
  "                pos = centre(cells)",
  "                x, y = int(round(pos[0])), int(round(pos[1]))",
  "                pigment = int(frame[y, x])",
  "                endpoints.append((pos, colour == int(p[0]), pigment))",
  "    balls = []",
  "    for cells in groups(frame, int(p[2]), int(p[6])):",
  "        if len(cells) <= p[9]:",
  "            pos = centre(cells)",
  "            x, y = int(round(pos[0])), int(round(pos[1]))",
  "            surround = []",
  "            for dx, dy in params['neighbours']:",
  "                xx, yy = x + int(dx), y + int(dy)",
  "                if 0 <= xx < frame.shape[1] and 0 <= yy < frame.shape[0]:",
  "                    surround.append(int(frame[yy, xx]))",
  "            pigment = max(set(surround), key=surround.count) if surround else int(p[3])",
  "            balls.append((pos, pigment))",
  "    goals = []",
  "    for pigment in [int(v) for v in params['pigments']]:",
  "        for cells in groups(frame, pigment, int(p[10])):",
  "            if p[11] <= len(cells) <= p[12]:",
  "                pos = centre(cells)",
  "                width = max(v[1] for v in cells) - min(v[1] for v in cells)",
  "                height = max(v[0] for v in cells) - min(v[0] for v in cells)",
  "                if min(width, height) >= p[13] and all(squared(pos, b[0]) > p[14] ** 2 for b in balls):",
  "                    goals.append((pos, pigment))",
  "    state = tuple((int(round(e[0][0])), int(round(e[0][1])), int(e[1]), e[2]) for e in sorted(endpoints))",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    active = [e for e in endpoints if e[1]]",
  "    if 'last' in mem:",
  "        oldstate, oldpos, click, token, oldframe = mem['last']",
  "        mem['edges'][(oldstate, token)] = state",
  "        if active and token[0] == 0:",
  "            now = min(active, key=lambda e: squared(e[0], oldpos))[0]",
  "            dx, dy = now[0] - oldpos[0], now[1] - oldpos[1]",
  "            length = squared(now, oldpos) ** 0.5",
  "            requested = squared(click, oldpos) ** 0.5",
  "            changed = int(np.sum(frame != oldframe))",
  "            mem['blocked'][(oldstate, token)] = length < p[15] or changed <= p[16]",
  "            if p[15] <= length <= p[17] and requested > p[15]:",
  "                model = mem['models'].setdefault('motion', [0.0, 0.0, 0.0])",
  "                model[0] += length",
  "                model[1] += length / requested",
  "                model[2] += 1.0",
  "    candidates = []",
  "    if active:",
  "        a = active[0]",
  "        matching = [b for b in balls if b[1] == a[2]]",
  "        if not matching:",
  "            matching = balls",
  "        if matching:",
  "            ball = min(matching, key=lambda b: squared(a[0], b[0]))",
  "            others = [e for e in endpoints if not e[1] and e[2] == ball[1]]",
  "            if not others:",
  "                others = [e for e in endpoints if not e[1]]",
  "            if others:",
  "                other = min(others, key=lambda e: squared(((e[0][0] + a[0][0]) / 2, (e[0][1] + a[0][1]) / 2), ball[0]))",
  "                targets = [g for g in goals if g[1] == ball[1]]",
  "                if targets:",
  "                    target = min(targets, key=lambda g: squared(g[0], ball[0]))[0]",
  "                    residual = (ball[0][0] - (a[0][0] + other[0][0]) / 2, ball[0][1] - (a[0][1] + other[0][1]) / 2)",
  "                    step = p[18]",
  "                    if 'motion' in mem['models']:",
  "                        model = mem['models']['motion']",
  "                        step = model[0] / max(1.0, model[2])",
  "                    for i, direction in enumerate(params['directions']):",
  "                        norm = max(p[19], (direction[0] ** 2 + direction[1] ** 2) ** 0.5)",
  "                        dx, dy = direction[0] / norm, direction[1] / norm",
  "                        dest = (a[0][0] + step * dx, a[0][1] + step * dy)",
  "                        x, y = int(round(dest[0])), int(round(dest[1]))",
  "                        if 0 <= x < frame.shape[1] and 0 <= y < frame.shape[0]:",
  "                            hazard = params['hazards'][int(frame[y, x])]",
  "                            newball = (ball[0][0] + step * dx / 2, ball[0][1] + step * dy / 2)",
  "                            desiredother = (2 * (target[0] - residual[0]) - dest[0], 2 * (target[1] - residual[1]) - dest[1])",
  "                            outside = max(0, -desiredother[0], desiredother[0] - p[20]) ** 2 + max(0, -desiredother[1], desiredother[1] - p[20]) ** 2",
  "                            value = squared(newball, target) + p[21] * squared(dest, target) + p[22] * outside + p[23] * hazard",
  "                            token = (0, i)",
  "                            click = (a[0][0] + p[24] * dx, a[0][1] + p[24] * dy)",
  "                            candidates.append((value, token, click))",
  "                    reflected = (2 * (target[0] - residual[0]) - other[0][0], 2 * (target[1] - residual[1]) - other[0][1])",
  "                    if 0 <= reflected[0] <= p[20] and 0 <= reflected[1] <= p[20]:",
  "                        direction = (reflected[0] - a[0][0], reflected[1] - a[0][1])",
  "                        norm = max(p[19], squared(reflected, a[0]) ** 0.5)",
  "                        dest = (a[0][0] + min(step, norm) * direction[0] / norm, a[0][1] + min(step, norm) * direction[1] / norm)",
  "                        x, y = int(round(dest[0])), int(round(dest[1]))",
  "                        value = squared(((dest[0] + other[0][0]) / 2 + residual[0], (dest[1] + other[0][1]) / 2 + residual[1]), target)",
  "                        value += p[23] * params['hazards'][int(frame[y, x])]",
  "                        candidates.append((value, (0, len(params['directions'])), reflected))",
  "                    switching = squared(ball[0], target) + p[25]",
  "                    switching += p[21] * squared(other[0], target)",
  "                    candidates.append((switching, (1, int(round(other[0][0])), int(round(other[0][1]))), other[0]))",
  "    if not candidates:",
  "        for e in endpoints:",
  "            candidates.append((0.0, (2, int(round(e[0][0])), int(round(e[0][1]))), e[0]))",
  "        for g in goals:",
  "            candidates.append((p[26], (3, int(round(g[0][0])), int(round(g[0][1]))), g[0]))",
  "        for b in balls:",
  "            candidates.append((p[26], (4, int(round(b[0][0])), int(round(b[0][1]))), b[0]))",
  "    if not candidates:",
  "        return (avail[0], int(p[27]), int(p[28]))",
  "    ranked = []",
  "    for value, token, click in candidates:",
  "        value += p[29] * mem['pairs'].get((state, token), 0)",
  "        value += p[30] * float(mem['blocked'].get((state, token), False))",
  "        nxt = mem['edges'].get((state, token))",
  "        if nxt is not None:",
  "            value += p[31] * visits.get(nxt, 0)",
  "        ranked.append((value, token, click))",
  "    ranked.sort(key=lambda v: v[0])",
  "    value, token, click = ranked[0]",
  "    x = max(0, min(int(p[20]), int(round(click[0]))))",
  "    y = max(0, min(int(p[20]), int(round(click[1]))))",
  "    mem['pairs'][(state, token)] = mem['pairs'].get((state, token), 0) + 1",
  "    oldpos = active[0][0] if active else click",
  "    mem['last'] = (state, oldpos, (x, y), token, frame.copy())",
  "    return (6 if 6 in avail else avail[0], x, y)"
 ],
