 "source_lines": [
  "def objects(frame, colours, top, bottom):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(top, bottom):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c not in colours:",
  "                continue",
  "            todo = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while todo:",
  "                yy, xx = todo.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if top <= ny < bottom and 0 <= nx < frame.shape[1]:",
  "                        if not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                            seen[ny, nx] = True",
  "                            todo.append((ny, nx))",
  "            n = len(cells)",
  "            cx = sum(v[1] for v in cells) / n",
  "            cy = sum(v[0] for v in cells) / n",
  "            point = min(cells, key=lambda v: (v[1] - cx) ** 2 + (v[0] - cy) ** 2)",
  "            out.append((c, cx, cy, n, point[1], point[0]))",
  "    return out",
  "def first(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['edges'] = {}",
  "        mem['pairs'] = {}",
  "        mem['visits'] = {}",
  "        mem['bad'] = {}",
  "    if mem.get('reset') != reset:",
  "        if 'last' in mem:",
  "            old, action, origin = mem['last']",
  "            mem['bad'][(origin, action)] = mem['bad'].get((origin, action), 0) + 1",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "    top = max(0, min(frame.shape[0], int(p[0])))",
  "    bottom = max(top, min(frame.shape[0], int(p[1])))",
  "    comps = objects(frame, [int(p[2]), int(p[3]), int(p[4]), int(p[5])], top, bottom)",
  "    agents = [o for o in comps if o[0] == int(p[2]) and p[6] <= o[3] <= p[7]]",
  "    goals = [o for o in comps if o[0] == int(p[4]) and o[3] >= p[8]]",
  "    if not agents:",
  "        return (avail[0], int(p[9]), int(p[10]))",
  "    agent = max(agents, key=lambda o: o[3])",
  "    ax, ay = agent[1], agent[2]",
  "    origin = (int(round(ax)), int(round(ay)))",
  "    if goals:",
  "        goal = max(goals, key=lambda o: o[3])",
  "        gx, gy = goal[1], goal[2]",
  "        mem['goal'] = (gx, gy)",
  "    else:",
  "        gx, gy = mem.get('goal', (ax, ay))",
  "    landmarks = []",
  "    for o in comps:",
  "        if o[0] == int(p[3]) and o[3] <= p[11]:",
  "            landmarks.append((int(round(o[1])), int(round(o[2]))))",
  "        if o[0] == int(p[5]) and p[12] <= o[3] <= p[13]:",
  "            landmarks.append((int(round(o[1])), int(round(o[2]))))",
  "    if goals:",
  "        landmarks.append((int(round(gx)), int(round(gy))))",
  "    state = (origin, tuple(sorted(set(landmarks))))",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if 'last' in mem:",
  "        old, action, previous_origin = mem['last']",
  "        mem['edges'][(old, action)] = state",
  "        if origin == previous_origin:",
  "            pair = (previous_origin, action)",
  "            mem['bad'][pair] = mem['bad'].get(pair, 0) + 1",
  "        else:",
  "            dx = origin[0] - previous_origin[0]",
  "            dy = origin[1] - previous_origin[1]",
  "            mem['stride'] = (dx * dx + dy * dy) ** 0.5",
  "    candidates = list(set(landmarks))",
  "    if not candidates:",
  "        for o in comps:",
  "            if o[0] != int(p[2]) and o[3] <= p[14]:",
  "                candidates.append((int(round(o[1])), int(round(o[2]))))",
  "    current_distance = ((ax - gx) ** 2 + (ay - gy) ** 2) ** 0.5",
  "    scored = []",
  "    for point in candidates:",
  "        x, y = point",
  "        distance = ((x - ax) ** 2 + (y - ay) ** 2) ** 0.5",
  "        if distance <= p[15]:",
  "            continue",
  "        remaining = ((x - gx) ** 2 + (y - gy) ** 2) ** 0.5",
  "        score = p[16] * distance + p[17] * remaining",
  "        if remaining >= current_distance - p[18]:",
  "            score += p[19]",
  "        score += p[20] * mem['pairs'].get((state, point), 0)",
  "        score += p[21] * mem['bad'].get((origin, point), 0)",
  "        nxt = mem['edges'].get((state, point))",
  "        if nxt is not None:",
  "            score += p[22] * visits.get(nxt, 0)",
  "        if distance > p[23]:",
  "            score += p[24] * (distance - p[23])",
  "        scored.append((score, point))",
  "    if scored:",
  "        scored.sort()",
  "        chosen = scored[0][1]",
  "    else:",
  "        chosen = (int(round(gx)), int(round(gy)))",
  "    mem['pairs'][(state, chosen)] = mem['pairs'].get((state, chosen), 0) + 1",
  "    mem['last'] = (state, chosen, origin)",
  "    action = int(p[25])",
  "    if action not in avail:",
  "        return (avail[0], 0, 0)",
  "    return (action, max(0, min(frame.shape[1] - 1, chosen[0])), max(0, min(frame.shape[0] - 1, chosen[1])))",
  "def act(params, mem, frame, avail, info):",
  "    p = params['explore']",
  "    if info.get('levels', 0) < p[0]:",
  "        return first(params, mem, frame, avail, info)",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['counts'] = {}",
  "        mem['edges'] = {}",
  "        mem['bad'] = {}",
  "        mem['visits'] = {}",
  "        mem['effects'] = {}",
  "        mem['routes'] = {}",
  "        mem['path'] = []",
  "    top = max(0, min(frame.shape[0], int(p[1])))",
  "    bottom = max(top, min(frame.shape[0], int(p[2])))",
  "    colours = [c for c in range(16) if c != int(p[3]) and c != int(p[4])]",
  "    board = objects(frame, colours, top, bottom)",
  "    header = objects(frame, colours, 0, top)",
  "    palette = [o for o in header if o[1] < p[5] and p[6] <= o[3] <= p[7]]",
  "    indicator = [o for o in header if o[1] >= p[5] and o[3] >= p[6]]",
  "    active = max(indicator, key=lambda o: o[3])[0] if indicator else int(p[8])",
  "    state = (active, tuple((o[0], o[4], o[5], o[3]) for o in board), tuple((o[0], o[4], o[5], o[3]) for o in header))",
  "    agents = [o for o in board if p[9] <= o[3] <= p[10] and o[0] != int(p[11])]",
  "    goals = [o for o in board if o[0] == int(p[11]) and o[3] >= p[12]]",
  "    agent = max(agents, key=lambda o: (o[0] == active, o[3])) if agents else None",
  "    origin = (agent[4], agent[5]) if agent else None",
  "    if mem.get('reset') != reset:",
  "        if 'last' in mem:",
  "            old, action, oldorigin, oldsize = mem['last']",
  "            pair = (old, action)",
  "            mem['bad'][pair] = mem['bad'].get(pair, 0) + 1",
  "        mem['path'] = []",
  "        mem.pop('last', None)",
  "        mem['reset'] = reset",
  "    elif 'last' in mem:",
  "        old, action, oldorigin, oldsize = mem['last']",
  "        pair = (old, action)",
  "        mem['edges'][pair] = state",
  "        moved = origin is not None and oldorigin is not None and origin != oldorigin",
  "        effect = (state != old, moved, len(board) < oldsize)",
  "        mem['effects'][pair] = effect",
  "        if state != old:",
  "            path = mem['path'] + [(old, action, state)]",
  "            if state in mem['routes']:",
  "                previous = mem['routes'][state]",
  "                if len(previous) < len(path):",
  "                    path = previous[:]",
  "            mem['path'] = path",
  "            mem['routes'][state] = path[:]",
  "    mem['visits'][state] = mem['visits'].get(state, 0) + 1",
  "    candidates = []",
  "    for o in board:",
  "        if o[3] <= p[13]:",
  "            candidates.append((o[4], o[5], o[0], o[3], False))",
  "    for o in palette:",
  "        candidates.append((o[4], o[5], o[0], o[3], True))",
  "    scored = []",
  "    for x, y, colour, size, ispalette in candidates:",
  "        action = (x, y)",
  "        pair = (state, action)",
  "        count = mem['counts'].get(pair, 0)",
  "        bad = mem['bad'].get(pair, 0)",
  "        effect = mem['effects'].get(pair)",
  "        if effect is not None and not effect[0]:",
  "            continue",
  "        if origin is not None and action == origin and not ispalette:",
  "            continue",
  "        score = p[14] * count + p[15] * bad",
  "        if ispalette:",
  "            score += p[16]",
  "            if colour == active:",
  "                score += p[17]",
  "        else:",
  "            if size <= p[18]:",
  "                score -= p[19]",
  "            if colour == active:",
  "                score -= p[20]",
  "            if colour == int(p[21]) and p[22] <= size <= p[23]:",
  "                score -= p[24]",
  "            if origin is not None:",
  "                distance = ((x - origin[0]) ** 2 + (y - origin[1]) ** 2) ** 0.5",
  "                score += p[25] * distance",
  "            if goals:",
  "                goal = max(goals, key=lambda o: o[3])",
  "                score += p[26] * ((x - goal[1]) ** 2 + (y - goal[2]) ** 2) ** 0.5",
  "        nxt = mem['edges'].get(pair)",
  "        if nxt is not None:",
  "            score += p[27] * mem['visits'].get(nxt, 0)",
  "        if effect is not None:",
  "            score -= p[28] * int(effect[1]) + p[29] * int(effect[2])",
  "        scored.append((score, x, y))",
  "    if scored:",
  "        scored.sort()",
  "        chosen = (scored[0][1], scored[0][2])",
  "    elif mem['path']:",
  "        chosen = mem['path'][-1][1]",
  "        old = mem['path'][-1][0]",
  "        for pair, nxt in mem['edges'].items():",
  "            if pair[0] == state and nxt == old:",
  "                chosen = pair[1]",
  "                break",
  "    elif board:",
  "        o = min(board, key=lambda o: o[3])",
  "        chosen = (o[4], o[5])",
  "    else:",
  "        chosen = (int(p[30]), int(p[31]))",
  "    pair = (state, chosen)",
  "    mem['counts'][pair] = mem['counts'].get(pair, 0) + 1",
  "    mem['last'] = (state, chosen, origin, len(board))",
  "    action = int(p[32])",
  "    if action not in avail:",
  "        action = avail[0]",
  "    return (action, chosen[0], chosen[1])"
