{
 "game": "re86",
 "house": "Moss",
 "n": 3,
 "source_lines": [
  "def first(params, mem, frame, avail, info):",
  "    cfg = params['legacy']",
  "    colours = params['colours'][:2]",
  "    border = frame == int(cfg[0])",
  "    surrounding = np.roll(border, 1, axis=0).astype(int) + np.roll(border, -1, axis=0).astype(int) + np.roll(border, 1, axis=1).astype(int) + np.roll(border, -1, axis=1).astype(int)",
  "    for colour in colours:",
  "        colour = int(colour)",
  "        points = np.argwhere((frame == colour) & (surrounding >= cfg[1]))",
  "        remembered = mem['targets'].setdefault(colour, [])",
  "        for point in points:",
  "            p = (int(point[0]), int(point[1]))",
  "            if p not in remembered:",
  "                remembered.append(p)",
  "    centers = np.argwhere(frame[:int(cfg[2])] == int(cfg[3]))",
  "    if len(centers) == 0:",
  "        count = mem.get('fallback', 0)",
  "        mem['fallback'] = count + 1",
  "        action = int(params['order'][count % len(params['order'])])",
  "        if action not in avail:",
  "            action = avail[count % len(avail)]",
  "        return (action, int(cfg[4]), int(cfg[4]))",
  "    row = int(centers[0][0])",
  "    col = int(centers[0][1])",
  "    colour = int(colours[0])",
  "    best_count = -1",
  "    for candidate in colours:",
  "        candidate = int(candidate)",
  "        count = 0",
  "        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):",
  "            rr = row + dr",
  "            cc = col + dc",
  "            if 0 <= rr < frame.shape[0] and 0 <= cc < frame.shape[1] and frame[rr, cc] == candidate:",
  "                count += 1",
  "        if count > best_count:",
  "            best_count = count",
  "            colour = candidate",
  "    effects = mem.setdefault('effects', {})",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        pr, pc, old_colour, action, signature = previous",
  "        if old_colour == colour and (pr != row or pc != col):",
  "            effects[action] = (row - pr, col - pc)",
  "        elif old_colour != colour:",
  "            mem['switch'] = action",
  "        else:",
  "            blocked = mem.setdefault('blocked', {})",
  "            blocked[(signature, action)] = blocked.get((signature, action), 0) + 1",
  "    points = mem['targets'].get(colour, [])",
  "    rows = [row]",
  "    cols = [col]",
  "    for rr, cc in points:",
  "        if rr not in rows:",
  "            rows.append(rr)",
  "        if cc not in cols:",
  "            cols.append(cc)",
  "    best_score = -1000000",
  "    target_row = row",
  "    target_col = col",
  "    for rr in rows:",
  "        for cc in cols:",
  "            covered = 0",
  "            for tr, tc in points:",
  "                if (tr == rr and abs(tc - cc) <= cfg[5]) or (tc == cc and abs(tr - rr) <= cfg[5]):",
  "                    covered += 1",
  "            score = cfg[6] * covered - cfg[7] * (abs(rr - row) + abs(cc - col))",
  "            if score > best_score:",
  "                best_score = score",
  "                target_row = rr",
  "                target_col = cc",
  "    signature = (info['levels'], colour, row, col, tuple(points))",
  "    visits = mem['visits'].setdefault(signature, {})",
  "    tested = mem.setdefault('tested', [])",
  "    action = None",
  "    for candidate in params['order']:",
  "        candidate = int(candidate)",
  "        if candidate in avail and candidate not in tested:",
  "            action = candidate",
  "            tested.append(candidate)",
  "            break",
  "    if action is None:",
  "        best_score = -1000000",
  "        for index in range(len(params['order'])):",
  "            candidate = int(params['order'][index])",
  "            if candidate not in avail:",
  "                continue",
  "            dr, dc = params['directions'][candidate - 1]",
  "            if candidate in effects:",
  "                dr, dc = effects[candidate]",
  "            before = abs(target_row - row) + abs(target_col - col)",
  "            after = abs(target_row - row - dr) + abs(target_col - col - dc)",
  "            score = cfg[8] * (before - after)",
  "            if candidate == mem.get('switch', int(cfg[9])):",
  "                score = cfg[10] if before == 0 else -cfg[11]",
  "            score -= cfg[12] * visits.get(candidate, 0)",
  "            score -= cfg[13] * mem.get('blocked', {}).get((signature, candidate), 0)",
  "            score -= params['priority'][index]",
  "            if score > best_score:",
  "                best_score = score",
  "                action = candidate",
  "        if action is None:",
  "            action = avail[0]",
  "    visits[action] = visits.get(action, 0) + 1",
  "    mem['previous'] = (row, col, colour, action, signature)",
  "    return (action, int(cfg[4]), int(cfg[4]))",
  "def make_shape(kind, radius):",
  "    offsets = set()",
  "    for d in range(-radius, radius + 1):",
  "        if kind == 0:",
  "            offsets.add((d, 0))",
  "            offsets.add((0, d))",
  "        elif kind == 1:",
  "            offsets.add((d, d))",
  "            offsets.add((d, -d))",
  "        else:",
  "            w = radius - abs(d)",
  "            offsets.add((d, w))",
  "            offsets.add((d, -w))",
  "    offsets.add((0, 0))",
  "    return offsets",
  "def act(params, mem, frame, avail, info):",
  "    p = params['config']",
  "    level = info['levels']",
  "    if mem.get('level', -1) != level or mem.get('reset', -1) != info['resets']:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = info['resets']",
  "        mem['targets'] = {}",
  "        mem['visits'] = {}",
  "        mem['previous'] = None",
  "        mem['objects'] = {}",
  "        mem['edges'] = {}",
  "        mem['blocked'] = {}",
  "        mem['clicks'] = {}",
  "    if level == 0:",
  "        return first(params, mem, frame, avail, info)",
  "    border = frame == int(p[0])",
  "    around = np.roll(border, 1, axis=0).astype(int) + np.roll(border, -1, axis=0).astype(int) + np.roll(border, 1, axis=1).astype(int) + np.roll(border, -1, axis=1).astype(int)",
  "    boxed = around >= p[1]",
  "    centers = np.argwhere(frame[:int(p[2])] == int(p[3]))",
  "    black = None",
  "    if len(centers):",
  "        black = (int(centers[0][0]), int(centers[0][1]))",
  "    objects = mem['objects']",
  "    old_positions = {}",
  "    for colour in objects:",
  "        old_positions[colour] = objects[colour]['pos']",
  "    active = mem.get('active')",
  "    best_active = -1",
  "    for index in range(len(params['colours'])):",
  "        colour = int(params['colours'][index])",
  "        targets = mem['targets'].setdefault(colour, [])",
  "        for point in np.argwhere((frame == colour) & boxed):",
  "            pos = (int(point[0]), int(point[1]))",
  "            if pos not in targets:",
  "                targets.append(pos)",
  "        pixels = np.argwhere((frame[:int(p[2])] == colour) & (~boxed[:int(p[2])]))",
  "        if len(pixels) < p[4]:",
  "            continue",
  "        if colour not in objects:",
  "            rr = int((np.min(pixels[:, 0]) + np.max(pixels[:, 0])) // 2)",
  "            cc = int((np.min(pixels[:, 1]) + np.max(pixels[:, 1])) // 2)",
  "            radius = int(max(np.max(pixels[:, 0]) - np.min(pixels[:, 0]), np.max(pixels[:, 1]) - np.min(pixels[:, 1])) // 2)",
  "            radius = max(int(p[5]), min(int(p[6]), radius))",
  "            best = -1000000",
  "            chosen = None",
  "            for kind in range(int(p[7])):",
  "                template = make_shape(kind, radius)",
  "                score = 0",
  "                for point in pixels:",
  "                    if (int(point[0]) - rr, int(point[1]) - cc) in template:",
  "                        score += 1",
  "                if score > best:",
  "                    best = score",
  "                    chosen = template",
  "            objects[colour] = {'pos': (rr, cc), 'shape': chosen, 'plan': None}",
  "        obj = objects[colour]",
  "        rr, cc = obj['pos']",
  "        candidates = set([(rr, cc)])",
  "        previous = mem.get('last')",
  "        if previous is not None and previous[1] == colour:",
  "            action = previous[0]",
  "            if action <= len(params['moves']):",
  "                dr, dc = mem.get('motion', {}).get(action, tuple(params['moves'][action - 1]))",
  "                candidates.add((rr + int(dr), cc + int(dc)))",
  "        if black is not None:",
  "            candidates.add(black)",
  "        reach = int(p[8])",
  "        for dr in range(-reach, reach + 1):",
  "            for dc in range(-reach, reach + 1):",
  "                candidates.add((rr + dr, cc + dc))",
  "        best = -1000000",
  "        position = (rr, cc)",
  "        for cr, ccol in candidates:",
  "            if cr < 0 or ccol < 0 or cr >= int(p[2]) or ccol >= frame.shape[1]:",
  "                continue",
  "            score = -p[9] * (abs(cr - rr) + abs(ccol - cc))",
  "            for dr, dc in obj['shape']:",
  "                tr = cr + dr",
  "                tc = ccol + dc",
  "                if 0 <= tr < int(p[2]) and 0 <= tc < frame.shape[1]:",
  "                    if frame[tr, tc] == colour and not boxed[tr, tc]:",
  "                        score += p[10]",
  "            if black == (cr, ccol):",
  "                score += p[11]",
  "            if score > best:",
  "                best = score",
  "                position = (cr, ccol)",
  "        obj['pos'] = position",
  "        if black == position:",
  "            score = 0",
  "            for dr, dc in obj['shape']:",
  "                tr = position[0] + dr",
  "                tc = position[1] + dc",
  "                if 0 <= tr < int(p[2]) and 0 <= tc < frame.shape[1] and frame[tr, tc] == colour:",
  "                    score += 1",
  "            if score > best_active:",
  "                best_active = score",
  "                active = colour",
  "    previous = mem.get('last')",
  "    if previous is not None:",
  "        action, old_active, old_key, old_pos = previous",
  "        if old_active in objects:",
  "            new_pos = objects[old_active]['pos']",
  "            if action != int(p[12]) and action != int(p[13]):",
  "                dr = new_pos[0] - old_pos[0]",
  "                dc = new_pos[1] - old_pos[1]",
  "                if abs(dr) + abs(dc) > 0:",
  "                    mem.setdefault('motion', {})[action] = (dr, dc)",
  "                else:",
  "                    key = (old_active, old_pos, action)",
  "                    mem['blocked'][key] = mem['blocked'].get(key, 0) + 1",
  "        mem['edges'][(old_key, action)] = info['key']",
  "        if action == int(p[12]) and active == old_active and black is None:",
  "            changed = []",
  "            old_frame = mem.get('frame')",
  "            if old_frame is not None:",
  "                for colour in objects:",
  "                    count = int(np.sum((frame == colour) & (old_frame != colour)))",
  "                    changed.append((count, colour))",
  "                if changed:",
  "                    changed.sort()",
  "                    if changed[-1][0] > 0:",
  "                        active = changed[-1][1]",
  "    if active not in objects and objects:",
  "        active = list(objects.keys())[0]",
  "    mem['active'] = active",
  "    mem['frame'] = frame.copy()",
  "    state_visits = mem['visits']",
  "    state_visits[info['key']] = state_visits.get(info['key'], 0) + 1",
  "    if active not in objects:",
  "        action = int(params['order'][info['step'] % len(params['order'])])",
  "        if action not in avail:",
  "            action = avail[0]",
  "        return (action, int(p[14]), int(p[14]))",
  "    obj = objects[active]",
  "    row, col = obj['pos']",
  "    targets = mem['targets'].get(active, [])",
  "    step = int(p[15])",
  "    if obj['plan'] is None:",
  "        best = -1000000",
  "        plan = (row, col)",
  "        for rr in range(row % step, int(p[2]), step):",
  "            for cc in range(col % step, frame.shape[1], step):",
  "                covered = 0",
  "                for tr, tc in targets:",
  "                    if (tr - rr, tc - cc) in obj['shape']:",
  "                        covered += 1",
  "                score = p[16] * covered - p[17] * (abs(rr - row) + abs(cc - col))",
  "                if score > best:",
  "                    best = score",
  "                    plan = (rr, cc)",
  "        obj['plan'] = plan",
  "    target_row, target_col = obj['plan']",
  "    signature = (active, row, col)",
  "    local = mem.setdefault('local', {}).setdefault(signature, {})",
  "    probes = mem.setdefault('probes', {})",
  "    action = None",
  "    for value in params['probe_order']:",
  "        candidate = int(value)",
  "        if candidate in avail and candidate != int(p[13]) and probes.get(candidate, 0) < int(p[18]):",
  "            action = candidate",
  "            probes[candidate] = probes.get(candidate, 0) + 1",
  "            break",
  "    click = None",
  "    if action is None and int(p[13]) in avail and mem.get('click_probe', 0) < int(p[19]):",
  "        options = []",
  "        for colour in mem['targets']:",
  "            options.extend(mem['targets'][colour])",
  "        if options:",
  "            options.sort(key=lambda point: mem['clicks'].get(point, 0))",
  "            click = options[0]",
  "            mem['clicks'][click] = mem['clicks'].get(click, 0) + 1",
  "            mem['click_probe'] = mem.get('click_probe', 0) + 1",
  "            action = int(p[13])",
  "    if action is None:",
  "        before = abs(target_row - row) + abs(target_col - col)",
  "        best = -1000000",
  "        for index in range(len(params['order'])):",
  "            candidate = int(params['order'][index])",
  "            if candidate not in avail:",
  "                continue",
  "            if candidate == int(p[12]):",
  "                score = p[20] if before == 0 else -p[21]",
  "            else:",
  "                dr, dc = mem.get('motion', {}).get(candidate, tuple(params['moves'][candidate - 1]))",
  "                next_pos = (row + int(dr), col + int(dc))",
  "                after = abs(target_row - next_pos[0]) + abs(target_col - next_pos[1])",
  "                score = p[22] * (before - after)",
  "                score -= p[23] * mem['blocked'].get((active, (row, col), candidate), 0)",
  "                score -= p[24] * mem.get('local', {}).get((active, next_pos[0], next_pos[1]), {}).get(candidate, 0)",
  "            successor = mem['edges'].get((info['key'], candidate))",
  "            if successor is not None:",
  "                score -= p[25] * state_visits.get(successor, 0)",
  "            score -= p[26] * local.get(candidate, 0)",
  "            score -= params['priority'][index]",
  "            if score > best:",
  "                best = score",
  "                action = candidate",
  "    if action is None:",
  "        action = avail[0]",
  "    local[action] = local.get(action, 0) + 1",
  "    mem['last'] = (action, active, info['key'], (row, col))",
  "    if click is not None:",
  "        return (action, click[1], click[0])",
  "    return (action, int(p[14]), int(p[14]))"
 ],
