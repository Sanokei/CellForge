 "source_lines": [
  "def groups(frame, colour):",
  "    points = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))",
  "    result = []",
  "    while points:",
  "        start = min(points)",
  "        points.remove(start)",
  "        todo = [start]",
  "        group = []",
  "        while todo:",
  "            y, x = todo.pop()",
  "            group.append((y, x))",
  "            for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                q = (y + dy, x + dx)",
  "                if q in points:",
  "                    points.remove(q)",
  "                    todo.append(q)",
  "        result.append(group)",
  "    return result",
  "def configuration(frame, pieces):",
  "    state = []",
  "    for colour, shape, origin in pieces:",
  "        points = [(int(q[1]), int(q[0])) for q in np.argwhere(frame == colour) if (int(q[1]), int(q[0])) not in origin]",
  "        if points:",
  "            state.append((min(q[0] for q in points), min(q[1] for q in points)))",
  "        else:",
  "            state.append((-1, -1))",
  "    return tuple(state)",
  "def advance(state, action, pieces, walls, size):",
  "    index, dx, dy = action",
  "    if index < 0 or index >= len(state):",
  "        return state",
  "    x, y = state[index]",
  "    occupied = set(walls)",
  "    for j, item in enumerate(pieces):",
  "        if j != index:",
  "            px, py = state[j]",
  "            occupied.update((px + ox, py + oy) for ox, oy in item[1])",
  "    destination = [(x + dx + ox, y + dy + oy) for ox, oy in pieces[index][1]]",
  "    if any(xx < 0 or yy < 0 or xx >= size or yy >= size or (xx, yy) in occupied for xx, yy in destination):",
  "        return state",
  "    result = list(state)",
  "    result[index] = (x + dx, y + dy)",
  "    return tuple(result)",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "        excluded = set()",
  "        boxes = []",
  "        for group in groups(frame, int(p[0])):",
  "            if len(group) < p[1]:",
  "                continue",
  "            x0 = min(q[1] for q in group)",
  "            x1 = max(q[1] for q in group)",
  "            y0 = min(q[0] for q in group)",
  "            y1 = max(q[0] for q in group)",
  "            boxes.append((x0, y0, x1, y1))",
  "            excluded.update((x, y) for y in range(y0, y1 + 1) for x in range(x0, x1 + 1))",
  "        controls = []",
  "        colours = set()",
  "        for group in groups(frame, int(p[2])):",
  "            if len(group) < p[3]:",
  "                continue",
  "            cx = sum(q[1] for q in group) / len(group)",
  "            cy = sum(q[0] for q in group) / len(group)",
  "            box = next((b for b in boxes if b[0] <= cx <= b[2] and b[1] <= cy <= b[3]), None)",
  "            if box is None:",
  "                continue",
  "            candidates = {}",
  "            for y, x in group:",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    yy, xx = y + dy, x + dx",
  "                    if 0 <= yy < frame.shape[0] and 0 <= xx < frame.shape[1]:",
  "                        c = int(frame[yy, xx])",
  "                        if params['roles'][c] > 0:",
  "                            candidates[c] = candidates.get(c, 0) + 1",
  "            if not candidates:",
  "                continue",
  "            colour = max(candidates, key=candidates.get)",
  "            colours.add(colour)",
  "            point = min(group, key=lambda q: abs(q[1] - cx) + abs(q[0] - cy))",
  "            if box[2] - box[0] > box[3] - box[1]:",
  "                delta = (-int(p[4]) if cx < (box[0] + box[2]) / 2 else int(p[4]), 0)",
  "            else:",
  "                delta = (0, -int(p[4]) if cy < (box[1] + box[3]) / 2 else int(p[4]))",
  "            controls.append((point[1], point[0], colour, delta[0], delta[1]))",
  "        colours = sorted(colours)",
  "        pieces = []",
  "        for colour in colours:",
  "            cells = set((int(q[1]), int(q[0])) for q in np.argwhere(frame == colour) if (int(q[1]), int(q[0])) not in excluded)",
  "            extra = set()",
  "            for x, y in cells:",
  "                for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    xx, yy = x + dx, y + dy",
  "                    if 0 <= xx < frame.shape[1] and 0 <= yy < int(p[5]) and (xx, yy) not in excluded and int(frame[yy, xx]) in [int(p[6]), int(p[7])]:",
  "                        extra.add((xx, yy))",
  "            cells.update(extra)",
  "            if not cells:",
  "                continue",
  "            x0 = min(q[0] for q in cells)",
  "            y0 = min(q[1] for q in cells)",
  "            pieces.append((colour, tuple(sorted((x - x0, y - y0) for x, y in cells)), excluded))",
  "        mem['pieces'] = pieces",
  "        mem['controls'] = controls",
  "        mem['models'] = [(next((i for i, item in enumerate(pieces) if item[0] == a[2]), -1), a[3], a[4]) for a in controls]",
  "        mem['walls'] = set((int(q[1]), int(q[0])) for q in np.argwhere(frame == int(p[8])) if (int(q[1]), int(q[0])) not in excluded)",
  "        mem['targets'] = []",
  "        mem['marker'] = None",
  "        initial = configuration(frame, pieces)",
  "        marker_groups = groups(frame, int(p[7]))",
  "        singles = []",
  "        for group in marker_groups:",
  "            if any((x, y) in excluded for y, x in group):",
  "                continue",
  "            cx = sum(q[1] for q in group) / len(group)",
  "            cy = sum(q[0] for q in group) / len(group)",
  "            if len(group) >= p[9]:",
  "                mem['targets'].append((int(round(cx)), int(round(cy))))",
  "            else:",
  "                singles.append((int(round(cx)), int(round(cy))))",
  "        if singles and pieces:",
  "            choices = []",
  "            for x, y in singles:",
  "                for i, item in enumerate(pieces):",
  "                    px, py = initial[i]",
  "                    distance = min(abs(x - px - ox) + abs(y - py - oy) for ox, oy in item[1])",
  "                    choices.append((distance, i, x - px, y - py))",
  "            choice = min(choices)",
  "            mem['marker'] = choice[1:]",
  "        mem['uses'] = {}",
  "        mem['pairs'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['failures'] = {}",
  "        mem['plan'] = []",
  "        targets = mem['targets']",
  "        distances = {}",
  "        queue = list(targets)",
  "        for target in targets:",
  "            distances[target] = 0",
  "        head = 0",
  "        while head < len(queue):",
  "            x, y = queue[head]",
  "            head += 1",
  "            for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                q = (x + dx, y + dy)",
  "                if 0 <= q[0] < int(p[5]) and 0 <= q[1] < int(p[5]) and q not in mem['walls'] and q not in distances:",
  "                    distances[q] = distances[(x, y)] + 1",
  "                    queue.append(q)",
  "        mem['distances'] = distances",
  "    pieces = mem['pieces']",
  "    controls = mem['controls']",
  "    if not controls or not pieces:",
  "        return (avail[0], int(p[10]), int(p[11]))",
  "    state = configuration(frame, pieces)",
  "    models = mem['models']",
  "    if 'last' in mem:",
  "        old, a = mem['last']",
  "        mem['edges'][(old, a)] = state",
  "        if state == old:",
  "            mem['failures'][(old, a)] = mem['failures'].get((old, a), 0) + 1",
  "        else:",
  "            moved = [i for i in range(len(state)) if state[i] != old[i]]",
  "            if len(moved) == 1:",
  "                i = moved[0]",
  "                models[a] = (i, state[i][0] - old[i][0], state[i][1] - old[i][1])",
  "    mem['visits'][state] = mem['visits'].get(state, 0) + 1",
  "    chosen = None",
  "    untested = [a for a in range(len(controls)) if mem['uses'].get(a, 0) < int(p[12]) and not mem['failures'].get((state, a), 0)]",
  "    if untested:",
  "        chosen = min(untested, key=lambda a: (mem['uses'].get(a, 0), a))",
  "    marker = mem['marker']",
  "    def value(board):",
  "        if marker is None or not mem['targets']:",
  "            return 0.0",
  "        i, ox, oy = marker",
  "        x, y = board[i]",
  "        point = (x + ox, y + oy)",
  "        direct = min(abs(point[0] - tx) + abs(point[1] - ty) for tx, ty in mem['targets'])",
  "        return p[13] * mem['distances'].get(point, int(p[14])) + p[15] * direct",
  "    if chosen is None:",
  "        beam = [(state, [], 0.0)]",
  "        reached = {state: 0}",
  "        best = float('inf')",
  "        best_path = []",
  "        solved = False",
  "        for depth in range(max(1, int(p[16]))):",
  "            candidates = []",
  "            for board, path, cost in beam:",
  "                for a in range(len(controls)):",
  "                    if board == state and mem['failures'].get((state, a), 0) >= p[17]:",
  "                        continue",
  "                    nxt = mem['edges'].get((board, a))",
  "                    if nxt is None:",
  "                        nxt = advance(board, models[a], pieces, mem['walls'], int(p[5]))",
  "                    if nxt == board:",
  "                        continue",
  "                    length = len(path) + 1",
  "                    if reached.get(nxt, int(p[14])) <= length:",
  "                        continue",
  "                    reached[nxt] = length",
  "                    new_path = path + [a]",
  "                    new_cost = cost + p[18]",
  "                    score = value(nxt) + new_cost + p[19] * mem['visits'].get(nxt, 0)",
  "                    if score < best:",
  "                        best = score",
  "                        best_path = new_path",
  "                    if marker is not None and mem['targets'] and value(nxt) == 0:",
  "                        best_path = new_path",
  "                        solved = True",
  "                        break",
  "                    candidates.append((score, nxt, new_path, new_cost))",
  "                if solved:",
  "                    break",
  "            if solved or not candidates:",
  "                break",
  "            candidates.sort(key=lambda q: q[0])",
  "            beam = [(q[1], q[2], q[3]) for q in candidates[:max(1, int(p[20]))]]",
  "        if best_path:",
  "            chosen = best_path[0]",
  "    if chosen is None or mem['pairs'].get((state, chosen), 0) >= p[21]:",
  "        options = []",
  "        for a in range(len(controls)):",
  "            nxt = mem['edges'].get((state, a))",
  "            score = p[22] * mem['failures'].get((state, a), 0) + p[23] * mem['pairs'].get((state, a), 0) + p[24] * mem['uses'].get(a, 0)",
  "            if nxt is not None:",
  "                score += p[19] * mem['visits'].get(nxt, 0)",
  "            options.append((score, a))",
  "        chosen = min(options)[1]",
  "    mem['pairs'][(state, chosen)] = mem['pairs'].get((state, chosen), 0) + 1",
  "    mem['uses'][chosen] = mem['uses'].get(chosen, 0) + 1",
  "    mem['last'] = (state, chosen)",
  "    action = controls[chosen]",
  "    return (6 if 6 in avail else avail[0], int(action[0]), int(action[1]))"
 ],
