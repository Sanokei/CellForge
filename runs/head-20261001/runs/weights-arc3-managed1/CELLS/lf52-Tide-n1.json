 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['cfg']",
  "    weights = params['weights']",
  "    base = int(cfg[0])",
  "    peg = int(cfg[1])",
  "    click = int(cfg[2])",
  "    restart = int(cfg[3])",
  "    level = info.get('levels', 0)",
  "    resets = info.get('resets', 0)",
  "    if mem.get('level', -1) != level or mem.get('resets', -1) != resets:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['resets'] = resets",
  "        mem['graph'] = {}",
  "        mem['visits'] = {}",
  "        mem['stalls'] = 0",
  "        mask = (frame == base) | (frame == peg)",
  "        points = np.argwhere(mask)",
  "        remaining = set()",
  "        for p in points:",
  "            if int(p[0]) >= int(cfg[4]):",
  "                remaining.add((int(p[0]), int(p[1])))",
  "        nodes = []",
  "        while remaining:",
  "            seed = min(remaining)",
  "            remaining.remove(seed)",
  "            component = [seed]",
  "            queue = [seed]",
  "            head = 0",
  "            while head < len(queue):",
  "                y, x = queue[head]",
  "                head += 1",
  "                for d in params['directions']:",
  "                    q = (y + int(d[0]), x + int(d[1]))",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        component.append(q)",
  "                        queue.append(q)",
  "            if len(component) >= int(cfg[5]) and len(component) <= int(cfg[6]):",
  "                ys = [p[0] for p in component]",
  "                xs = [p[1] for p in component]",
  "                nodes.append(((min(xs) + max(xs)) // 2, (min(ys) + max(ys)) // 2))",
  "        mem['nodes'] = sorted(nodes, key=lambda p: (p[1], p[0]))",
  "    nodes = mem['nodes']",
  "    state = tuple(int(v) for row in frame[int(cfg[4]):] for v in row)",
  "    graph = mem['graph']",
  "    visits = mem['visits']",
  "    edges = graph.setdefault(state, {})",
  "    visits[state] = visits.get(state, 0) + 1",
  "    count = int(np.sum(frame == peg))",
  "    if 'previous' in mem:",
  "        old = mem['previous']",
  "        action = mem['action']",
  "        graph.setdefault(old, {})[action] = state",
  "        if state == old:",
  "            mem['stalls'] += 1",
  "            mem['selected'] = -1",
  "        else:",
  "            mem['stalls'] = 0",
  "            if count == mem['count'] and action >= 0:",
  "                mem['selected'] = action",
  "            else:",
  "                mem['selected'] = -1",
  "    selected = mem.get('selected', -1)",
  "    candidates = []",
  "    for i in range(len(nodes)):",
  "        if i not in edges:",
  "            x, y = nodes[i]",
  "            colour = int(frame[y, x])",
  "            score = float(weights[colour])",
  "            if selected >= 0 and selected < len(nodes):",
  "                sx, sy = nodes[selected]",
  "                distance = abs(x - sx) + abs(y - sy)",
  "                score -= float(cfg[11]) * abs(distance - float(cfg[7]))",
  "                if colour == base:",
  "                    score += float(cfg[8])",
  "                if i == selected:",
  "                    score -= float(cfg[9])",
  "            score -= float(cfg[12]) * i",
  "            candidates.append((score, i))",
  "    chosen = -1",
  "    if candidates:",
  "        chosen = max(candidates)[1]",
  "    else:",
  "        queue = [(state, -1)]",
  "        seen = {state}",
  "        head = 0",
  "        while head < len(queue) and head < int(cfg[10]):",
  "            current, first = queue[head]",
  "            head += 1",
  "            current_edges = graph.get(current, {})",
  "            if current != state and len(current_edges) < len(nodes):",
  "                chosen = first",
  "                break",
  "            successors = sorted(current_edges.items(), key=lambda item: visits.get(item[1], 0))",
  "            for action, destination in successors:",
  "                if destination != current and destination not in seen:",
  "                    seen.add(destination)",
  "                    queue.append((destination, action if first < 0 else first))",
  "    if click in avail and chosen >= 0:",
  "        x, y = nodes[chosen]",
  "        mem['previous'] = state",
  "        mem['action'] = chosen",
  "        mem['count'] = count",
  "        return (click, x, y)",
  "    mem.pop('previous', None)",
  "    if restart in avail and mem['stalls'] >= int(cfg[13]):",
  "        mem['stalls'] = 0",
  "        return (restart, 0, 0)",
  "    if click in avail and nodes:",
  "        ranked = []",
  "        for i in range(len(nodes)):",
  "            destination = edges.get(i, state)",
  "            ranked.append((visits.get(destination, 0), i))",
  "        chosen = min(ranked)[1]",
  "        mem['previous'] = state",
  "        mem['action'] = chosen",
  "        mem['count'] = count",
  "        mem['stalls'] += 1",
  "        x, y = nodes[chosen]",
  "        return (click, x, y)",
  "    for action in params['fallback']:",
  "        if int(action) in avail:",
  "            return (int(action), 0, 0)",
  "    return (avail[0], 0, 0)"
 ],
