 "source_lines": [
  "def blobs(frame, colour):",
  "    left = set((int(v[0]), int(v[1])) for v in np.argwhere(frame == colour))",
  "    out = []",
  "    while left:",
  "        root = next(iter(left))",
  "        left.remove(root)",
  "        todo = [root]",
  "        cells = []",
  "        while todo:",
  "            r, c = todo.pop()",
  "            cells.append((r, c))",
  "            for p in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):",
  "                if p in left:",
  "                    left.remove(p)",
  "                    todo.append(p)",
  "        ys = [v[0] for v in cells]",
  "        xs = [v[1] for v in cells]",
  "        out.append((min(ys), max(ys), min(xs), max(xs), sum(ys)/len(ys), sum(xs)/len(xs), len(cells)))",
  "    return sorted(out, key=lambda o: (-o[6], o[2]))",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    colours = params['colours']",
  "    order = params['actions']",
  "    objects = blobs(frame, int(colours[0]))",
  "    cargoes = blobs(frame, int(colours[1]))",
  "    goals = blobs(frame, int(colours[2]))",
  "    goals.sort(key=lambda o: o[5])",
  "    agent = objects[0] if objects else None",
  "    cargo = cargoes[0] if cargoes else None",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    if mem.get('level') != level:",
  "        wins = mem.get('wins', {})",
  "        if mem.get('level', level) < level:",
  "            mode = mem.get('mode', 0)",
  "            wins[mode] = wins.get(mode, 0) + 1",
  "        mem.clear()",
  "        mem.update({'level': level, 'reset': -1, 'wins': wins, 'attempt': 0, 'edges': {}, 'pairs': {}, 'visits': {}, 'motion': {}, 'effects': {}})",
  "    if mem['reset'] != reset:",
  "        mem['reset'] = reset",
  "        attempt = mem['attempt']",
  "        mem['attempt'] = attempt + 1",
  "        modes = len(params['offsets'])",
  "        successful = sorted(mem['wins'], key=lambda k: -mem['wins'][k])",
  "        mem['mode'] = successful[0] if successful else attempt % max(1, modes)",
  "        mem['phase'] = 0",
  "        mem['age'] = 0",
  "        mem['stall'] = 0",
  "        mem['startcargo'] = cargo",
  "        mem['bottom'] = False",
  "        mem.pop('last', None)",
  "    mode = int(mem['mode'])",
  "    offset = params['offsets'][mode % len(params['offsets'])]",
  "    state = tuple(int(v) for v in frame[int(p[0]):int(p[1]), :].flatten())",
  "    mem['visits'][state] = mem['visits'].get(state, 0) + 1",
  "    if 'last' in mem:",
  "        oldstate, action, oldagent, oldcargo = mem['last']",
  "        mem['edges'].setdefault(oldstate, {})[action] = state",
  "        effect = mem['effects'].setdefault(action, [0, 0])",
  "        effect[0] += int(state != oldstate)",
  "        effect[1] += 1",
  "        mem['stall'] = mem['stall'] + 1 if state == oldstate else 0",
  "        if agent is not None and oldagent is not None and action != int(p[2]):",
  "            dy = agent[4] - oldagent[4]",
  "            dx = agent[5] - oldagent[5]",
  "            if p[3] <= abs(dy) + abs(dx) <= p[4]:",
  "                mem['motion'][action] = (dy, dx)",
  "        if cargo is not None and oldcargo is not None:",
  "            dy = cargo[4] - oldcargo[4]",
  "            dx = cargo[5] - oldcargo[5]",
  "            if abs(dy) + abs(dx) >= p[3]:",
  "                mem['phase'] = max(1, mem['phase'])",
  "                if agent is not None and oldagent is not None:",
  "                    ady = agent[4] - oldagent[4]",
  "                    adx = agent[5] - oldagent[5]",
  "                    if abs(dy-ady) + abs(dx-adx) <= p[5]:",
  "                        mem['attached'] = (cargo[4]-agent[4], cargo[5]-agent[5])",
  "    mem['age'] += 1",
  "    target = None",
  "    if agent is not None:",
  "        half = (agent[1]-agent[0])/2",
  "        if mem['phase'] == 0 and cargo is not None:",
  "            target = (p[6]+half, cargo[5]+offset[0])",
  "            if abs(agent[4]-target[0]) + abs(agent[5]-target[1]) <= p[7]:",
  "                mem['phase'] = 1",
  "                mem['age'] = 0",
  "        if mem['phase'] >= 1 and goals:",
  "            destination = int(offset[1]) % len(goals)",
  "            if 'destination' not in mem:",
  "                if offset[1] < 0 and cargo is not None:",
  "                    destination = min(range(len(goals)), key=lambda i: abs(goals[i][5]-cargo[5]))",
  "                mem['destination'] = destination",
  "            goal = goals[mem['destination'] % len(goals)]",
  "            attached = mem.get('attached')",
  "            if attached is not None:",
  "                tx = goal[5]-attached[1]",
  "                ty = goal[0]+p[8]-attached[0]",
  "            else:",
  "                tx = goal[5]+offset[2]",
  "                ty = p[9]+half",
  "            target = (min(p[1]-half-1, ty), tx)",
  "            if mem['age'] <= p[10] and cargo is not None and 'attached' not in mem:",
  "                target = (p[6]+half, cargo[5]+offset[0])",
  "            if abs(agent[4]-target[0])+abs(agent[5]-target[1]) <= p[7] and mem['age'] > p[10]:",
  "                mem['phase'] = 2",
  "                mem['bottom'] = True",
  "                mem['release_age'] = mem.get('release_age', 0)+1",
  "            if mem['phase'] == 2:",
  "                direction = offset[3]",
  "                target = (agent[4], agent[5]+direction*p[11])",
  "                if mem.get('release_age', 0) > p[12]:",
  "                    mem['phase'] = 0",
  "                    mem['age'] = 0",
  "                    mem.pop('attached', None)",
  "                    mem.pop('release_age', None)",
  "    choices = []",
  "    for i in range(len(order)):",
  "        action = int(order[i])",
  "        if action not in avail:",
  "            continue",
  "        dy, dx = mem['motion'].get(action, (params['motion'][i][0], params['motion'][i][1]))",
  "        value = i*p[13]",
  "        if target is not None:",
  "            before = abs(agent[4]-target[0])+abs(agent[5]-target[1])",
  "            after = abs(agent[4]+dy-target[0])+abs(agent[5]+dx-target[1])",
  "            value += p[14]*(after-before)",
  "            if agent[0]+dy < p[6] or agent[1]+dy >= p[1] or agent[2]+dx < 0 or agent[3]+dx >= frame.shape[1]:",
  "                value += p[15]",
  "            if mem['phase'] == 1 and abs(agent[5]-target[1]) > p[7] and dy > 0:",
  "                value += p[16]",
  "        if action == int(p[2]):",
  "            value += p[17]",
  "            if mem['phase'] == 1 and mem['age'] <= p[10]:",
  "                value -= p[18]",
  "            if mem['phase'] == 2:",
  "                value -= p[19]",
  "        value += p[20]*mem['pairs'].get((state, action), 0)",
  "        destination = mem['edges'].get(state, {}).get(action)",
  "        if destination == state:",
  "            value += p[21]",
  "        elif destination is not None:",
  "            value += p[22]*mem['visits'].get(destination, 0)",
  "        choices.append((value, action, 0, 0))",
  "    if int(p[23]) in avail and mem['stall'] >= p[24]:",
  "        for colour in params['click_colours']:",
  "            for obj in blobs(frame, int(colour)):",
  "                identity = (int(p[23]), int(obj[5]), int(obj[4]))",
  "                value = p[25]+p[20]*mem['pairs'].get((state, identity), 0)",
  "                choices.append((value, identity, identity[1], identity[2]))",
  "    if not choices:",
  "        return (avail[0], 0, 0)",
  "    choices.sort(key=lambda item: item[0])",
  "    value, action, x, y = choices[0]",
  "    if all(mem['pairs'].get((state, int(a)), 0) > 0 for a in order if int(a) in avail) and mem['stall'] >= p[26]:",
  "        queue = [(state, None)]",
  "        seen = {state}",
  "        index = 0",
  "        while index < len(queue) and index < int(p[27]):",
  "            node, first = queue[index]",
  "            index += 1",
  "            if node != state and any(mem['pairs'].get((node, int(a)), 0) == 0 for a in order if int(a) in avail):",
  "                if first in avail:",
  "                    action, x, y = first, 0, 0",
  "                break",
  "            for a, successor in mem['edges'].get(node, {}).items():",
  "                if successor not in seen and successor != node:",
  "                    seen.add(successor)",
  "                    queue.append((successor, a if first is None else first))",
  "    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0)+1",
  "    mem['last'] = (state, action, agent, cargo)",
  "    if isinstance(action, tuple):",
  "        return (action[0], action[1], action[2])",
  "    return (action, x, y)"
 ],
