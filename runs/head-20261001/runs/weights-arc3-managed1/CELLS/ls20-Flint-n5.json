 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    c = params['colors']",
  "    q = params['cfg']",
  "    rows = params['moves']",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['blocked'] = {}",
  "        mem['visits'] = {}",
  "        mem['attempts'] = {}",
  "        mem['motion'] = {}",
  "        mem['probed'] = {}",
  "        mem['phase'] = 0",
  "    ceiling = min(frame.shape[0], int(q[0]))",
  "    half = int(q[1])",
  "    stride = int(q[2])",
  "    points = np.argwhere(frame[:ceiling, :] == int(c[0]))",
  "    if len(points) == 0:",
  "        return (avail[int(abs(q[3])) % len(avail)], 0, 0)",
  "    x = int(np.sum(points[:, 1]) / len(points) + q[4])",
  "    y = int(np.sum(points[:, 0]) / len(points) + q[5])",
  "    pos = (x, y)",
  "    old = mem.get('pos')",
  "    last = mem.get('last')",
  "    blocked = mem['blocked']",
  "    motion = mem['motion']",
  "    if old is not None and last is not None:",
  "        dx = x - old[0]",
  "        dy = y - old[1]",
  "        mem['probed'][last] = True",
  "        if abs(dx) + abs(dy) == 0:",
  "            blocked[(old, last)] = True",
  "        elif abs(dx) + abs(dy) <= q[6]:",
  "            motion[last] = (dx, dy)",
  "            blocked.pop((old, last), None)",
  "    legal = []",
  "    for row in rows:",
  "        a = int(row[0])",
  "        if a in avail:",
  "            delta = motion.get(a, (int(row[1]) * stride, int(row[2]) * stride))",
  "            legal.append((a, delta[0], delta[1], float(row[3])))",
  "    if len(legal) == 0:",
  "        return (avail[0], 0, 0)",
  "    markers = np.argwhere((frame[:ceiling, :] == int(c[2])) | (frame[:ceiling, :] == int(c[3])))",
  "    targets = []",
  "    for p in markers:",
  "        if int(p[1]) > int(q[7]):",
  "            targets.append((int(p[1]), int(p[0])))",
  "    goals = []",
  "    rings = []",
  "    for yy in range(half, ceiling - half):",
  "        for xx in range(int(q[7]) + half, frame.shape[1] - half):",
  "            if int(frame[yy, xx]) == int(c[4]):",
  "                if int(frame[yy - 1, xx]) == int(c[5]) and int(frame[yy + 1, xx]) == int(c[5]) and int(frame[yy, xx - 1]) == int(c[5]) and int(frame[yy, xx + 1]) == int(c[5]):",
  "                    rings.append((xx, yy))",
  "            if int(frame[yy, xx]) == int(c[1]):",
  "                if int(frame[yy - 1, xx]) == int(c[6]) or int(frame[yy + 1, xx]) == int(c[6]):",
  "                    goals.append((xx, yy))",
  "    if len(targets) == 0:",
  "        mem['phase'] = 1",
  "    if mem['phase'] == 1 and len(goals) > 0:",
  "        targets = goals",
  "    if len(targets) == 0:",
  "        targets = rings + goals",
  "    phase = mem['phase']",
  "    visits = mem['visits']",
  "    visits[(phase, pos)] = visits.get((phase, pos), 0) + 1",
  "    counts = mem['attempts'].setdefault((phase, pos), {})",
  "    if level > 0:",
  "        for a, dx, dy, priority in legal:",
  "            if not mem['probed'].get(a, False):",
  "                mem['pos'] = pos",
  "                mem['last'] = a",
  "                counts[a] = counts.get(a, 0) + 1",
  "                return (a, 0, 0)",
  "    queue = [pos]",
  "    first = {pos: None}",
  "    depth = {pos: 0}",
  "    head = 0",
  "    best = None",
  "    bestscore = -1000000.0",
  "    targetnode = None",
  "    targetdepth = 1000000",
  "    ringnodes = []",
  "    while head < len(queue) and head < int(q[8]):",
  "        node = queue[head]",
  "        head += 1",
  "        distance = 1000000",
  "        for tx, ty in targets:",
  "            d = max(0, abs(node[0] - tx) - half) + max(0, abs(node[1] - ty) - half)",
  "            distance = min(distance, d)",
  "        if distance == 0 and depth[node] < targetdepth:",
  "            targetnode = node",
  "            targetdepth = depth[node]",
  "        for rx, ry in rings:",
  "            if abs(node[0] - rx) <= half and abs(node[1] - ry) <= half:",
  "                if node != pos:",
  "                    ringnodes.append(node)",
  "                break",
  "        if node != pos:",
  "            score = -distance * q[9] - depth[node] * q[10] - visits.get((phase, node), 0) * q[11]",
  "            score -= counts.get(first[node], 0) * q[12]",
  "            if score > bestscore:",
  "                bestscore = score",
  "                best = first[node]",
  "        for a, dx, dy, priority in legal:",
  "            if blocked.get((node, a), False):",
  "                continue",
  "            dest = (node[0] + dx, node[1] + dy)",
  "            if dest in first:",
  "                continue",
  "            valid = True",
  "            length = max(abs(dx), abs(dy))",
  "            for offset in range(1, length + 1):",
  "                cx = node[0] + int(dx * offset / max(1, length))",
  "                cy = node[1] + int(dy * offset / max(1, length))",
  "                for oy in (-half, 0, half):",
  "                    for ox in (-half, 0, half):",
  "                        px = cx + ox",
  "                        py = cy + oy",
  "                        if px < 0 or px >= frame.shape[1] or py < 0 or py >= ceiling:",
  "                            valid = False",
  "                        else:",
  "                            color = int(frame[py, px])",
  "                            if color == int(c[7]):",
  "                                valid = False",
  "                            if color == int(c[6]):",
  "                                insidegoal = False",
  "                                for gx, gy in goals:",
  "                                    if abs(px - gx) <= q[13] and abs(py - gy) <= q[13]:",
  "                                        insidegoal = True",
  "                                        break",
  "                                if not insidegoal:",
  "                                    valid = False",
  "            if valid:",
  "                first[dest] = a if node == pos else first[node]",
  "                depth[dest] = depth[node] + 1",
  "                queue.append(dest)",
  "    if targetnode is not None and targetnode != pos:",
  "        best = first[targetnode]",
  "    energy = int(np.sum(frame[int(q[14]), int(q[15]):int(q[16])] == int(c[4])))",
  "    if level > 0 and len(ringnodes) > 0 and energy < targetdepth + q[17]:",
  "        ringbest = None",
  "        ringscore = 1000000",
  "        for node in ringnodes:",
  "            score = depth[node] + visits.get((phase, node), 0) * q[18]",
  "            if score < ringscore and depth[node] + q[19] < energy:",
  "                ringscore = score",
  "                ringbest = node",
  "        if ringbest is not None:",
  "            best = first[ringbest]",
  "    if best is None or counts.get(best, 0) >= q[20]:",
  "        scorebest = -1000000.0",
  "        for a, dx, dy, priority in legal:",
  "            dest = (x + dx, y + dy)",
  "            score = priority - counts.get(a, 0) * q[21] - visits.get((phase, dest), 0) * q[22]",
  "            if blocked.get((pos, a), False):",
  "                score -= q[23]",
  "            if score > scorebest:",
  "                scorebest = score",
  "                best = a",
  "    counts[best] = counts.get(best, 0) + 1",
  "    mem['pos'] = pos",
  "    mem['last'] = best",
  "    return (best, 0, 0)"
 ],
