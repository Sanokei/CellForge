 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    c = params['config']",
  "    pixels = np.argwhere(frame == int(c[0]))",
  "    if len(pixels) == 0:",
  "        a = int(c[5])",
  "        return (a if a in avail else avail[0], 0, 0)",
  "    pos = np.sum(pixels, axis=0) / len(pixels)",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem['epoch'] = epoch",
  "        mem['done'] = {}",
  "        mem['focus'] = None",
  "        mem['press'] = 0",
  "        mem['visits'] = {}",
  "        mem['previous'] = None",
  "        mem['blocked'] = {}",
  "        mem['round'] = 0",
  "    previous = mem.get('previous')",
  "    moves = mem.setdefault('moves', {})",
  "    if previous is not None:",
  "        delta = pos - previous['pos']",
  "        distance = float(np.sum(np.abs(delta)))",
  "        a = previous['action']",
  "        if distance > float(c[6]) and distance < float(c[7]):",
  "            moves[a] = delta",
  "        if a != int(c[5]):",
  "            mem['blocked'][(previous['cell'], a)] = distance <= float(c[6])",
  "        if a == int(c[5]) and previous['focus'] is not None:",
  "            old = previous['frame']",
  "            center = previous['goal']",
  "            r = int(center[0])",
  "            q = int(center[1])",
  "            radius = int(c[8])",
  "            changed = int(np.sum(frame[max(0,r-radius):min(frame.shape[0],r+radius+1), max(0,q-radius):min(frame.shape[1],q+radius+1)] != old[max(0,r-radius):min(frame.shape[0],r+radius+1), max(0,q-radius):min(frame.shape[1],q+radius+1)]))",
  "            if changed > int(c[9]):",
  "                mem['done'][previous['focus']] = mem['round'] + float(c[10])",
  "                mem['focus'] = None",
  "                mem['press'] = 0",
  "    remaining = set()",
  "    for p in np.argwhere((frame == int(c[1])) | (frame == int(c[2])) | (frame == int(c[3]))):",
  "        if int(p[0]) < frame.shape[0] - int(c[11]):",
  "            remaining.add((int(p[0]), int(p[1])))",
  "    objects = []",
  "    while remaining:",
  "        seed = next(iter(remaining))",
  "        remaining.remove(seed)",
  "        stack = [seed]",
  "        component = []",
  "        goal_pixels = []",
  "        while stack:",
  "            p = stack.pop()",
  "            component.append(p)",
  "            if int(frame[p[0],p[1]]) == int(c[3]):",
  "                goal_pixels.append(p)",
  "            for d in params['neighbors']:",
  "                n = (p[0] + int(d[0]), p[1] + int(d[1]))",
  "                if n in remaining:",
  "                    remaining.remove(n)",
  "                    stack.append(n)",
  "        if len(component) >= int(c[12]):",
  "            center = np.sum(np.array(component), axis=0) / len(component)",
  "            ident = (int(center[0]), int(center[1]))",
  "            large = len(goal_pixels) > int(c[13])",
  "            objects.append((ident, center, large))",
  "    stride = max(float(c[4]), 1.0)",
  "    cell = (int(pos[0] / stride), int(pos[1] / stride))",
  "    visits = mem['visits']",
  "    visits[cell] = visits.get(cell, 0) + 1",
  "    eligible = []",
  "    for ident, center, large in objects:",
  "        if mem['done'].get(ident, -1) <= mem['round']:",
  "            eligible.append((ident, center, large))",
  "    if len(eligible) == 0 and len(objects) > 0:",
  "        mem['round'] += 1",
  "        eligible = objects",
  "        mem['focus'] = None",
  "    chosen = None",
  "    best = None",
  "    for ident, center, large in eligible:",
  "        score = float(np.sum(np.abs(pos-center))) / stride",
  "        if large:",
  "            score += float(c[14])",
  "        if ident == mem['focus']:",
  "            score -= float(c[15])",
  "        if best is None or score < best:",
  "            best = score",
  "            chosen = (ident, center, large)",
  "    goal = None",
  "    action = None",
  "    if chosen is not None:",
  "        ident, center, large = chosen",
  "        if mem['focus'] != ident:",
  "            mem['focus'] = ident",
  "            mem['press'] = 0",
  "        goal = center",
  "        if large:",
  "            offset = params['goal_offsets'][mem['round'] % len(params['goal_offsets'])]",
  "            goal = center + offset * stride",
  "        error = np.abs(pos-goal)",
  "        if float(np.max(error)) <= float(c[16]):",
  "            limit = int(params['holds'][mem['round'] % len(params['holds'])])",
  "            if mem['press'] < limit and int(c[5]) in avail:",
  "                action = int(c[5])",
  "                mem['press'] += 1",
  "            else:",
  "                mem['done'][ident] = mem['round'] + float(c[17])",
  "                mem['focus'] = None",
  "                mem['press'] = 0",
  "    if action is None:",
  "        best = None",
  "        for i in range(len(params['order'])):",
  "            a = int(params['order'][i])",
  "            if a not in avail:",
  "                continue",
  "            vector = moves.get(a, params['vectors'][i] * stride)",
  "            predicted = pos + vector",
  "            nxt = (int(predicted[0] / stride), int(predicted[1] / stride))",
  "            score = float(params['bias'][i])",
  "            if goal is not None:",
  "                score += float(c[18]) * (float(np.sum(np.abs(pos-goal))) - float(np.sum(np.abs(predicted-goal)))) / stride",
  "            score -= min(visits.get(nxt, 0), int(c[19])) * float(c[20])",
  "            if mem['blocked'].get((cell,a), False):",
  "                score -= float(c[21])",
  "            if predicted[0] < float(c[22]) or predicted[1] < float(c[22]) or predicted[0] >= frame.shape[0]-float(c[22]) or predicted[1] >= frame.shape[1]-float(c[22]):",
  "                score -= float(c[23])",
  "            if best is None or score > best:",
  "                best = score",
  "                action = a",
  "    if action is None:",
  "        action = avail[0]",
  "    mem['previous'] = {'action': action, 'pos': pos.copy(), 'cell': cell, 'focus': mem['focus'], 'goal': None if goal is None else goal.copy(), 'frame': frame.copy()}",
  "    return (action, 0, 0)"
 ],
