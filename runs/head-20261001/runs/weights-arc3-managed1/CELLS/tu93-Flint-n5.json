 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    c = params['config']",
  "    colours = params['colours']",
  "    h = max(1, min(frame.shape[0], int(c[0])))",
  "    board = frame[:h]",
  "    signature = tuple(int(v) for v in board.flatten())",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    changed_run = mem.get('level') != level or mem.get('reset') != reset",
  "    records = mem.setdefault('records', {})",
  "    graph = records.setdefault(level, {})",
  "    node = graph.setdefault(signature, {'used': {}, 'edges': {}, 'bad': {}, 'score': 0})",
  "    actors = []",
  "    marks = np.argwhere(board == int(colours[0]))",
  "    for p in marks:",
  "        r, x = int(p[0]), int(p[1])",
  "        nearby = np.argwhere(board == int(colours[3]))",
  "        points = [(r, x)]",
  "        for q in nearby:",
  "            if abs(int(q[0]) - r) <= c[19] and abs(int(q[1]) - x) <= c[19]:",
  "                points.append((int(q[0]), int(q[1])))",
  "        actors.append(((min(q[0] for q in points) + max(q[0] for q in points)) // 2, (min(q[1] for q in points) + max(q[1] for q in points)) // 2))",
  "        break",
  "    if not actors:",
  "        points = np.argwhere(board == int(colours[1]))",
  "        if len(points):",
  "            actors.append((int(points[0][0]), int(points[0][1])))",
  "    targets = np.argwhere(board == int(colours[2]))",
  "    remaining = set((int(p[0]), int(p[1])) for p in targets)",
  "    goals = []",
  "    while remaining:",
  "        p = next(iter(remaining))",
  "        remaining.remove(p)",
  "        todo = [p]",
  "        component = [p]",
  "        while todo:",
  "            r, x = todo.pop()",
  "            for q in ((r - 1, x), (r + 1, x), (r, x - 1), (r, x + 1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    component.append(q)",
  "        goals.append((int(round(sum(q[0] for q in component) / len(component))), int(round(sum(q[1] for q in component) / len(component)))))",
  "    previous = mem.get('previous')",
  "    motion = mem.setdefault('motion', {})",
  "    constraints = mem.setdefault('constraints', {}).setdefault(level, {})",
  "    effects = mem.setdefault('effects', {}).setdefault(level, {})",
  "    if previous is not None:",
  "        oldlevel, oldsig, identity, oldreset, oldpos = previous",
  "        oldgraph = records.setdefault(oldlevel, {})",
  "        oldnode = oldgraph.setdefault(oldsig, {'used': {}, 'edges': {}, 'bad': {}, 'score': 0})",
  "        if level == oldlevel and reset == oldreset:",
  "            oldnode['edges'][identity] = signature",
  "            if signature == oldsig:",
  "                oldnode['bad'][identity] = oldnode['bad'].get(identity, 0) + 1",
  "            if identity[0] == 'key' and oldpos is not None and actors:",
  "                dr = actors[0][0] - oldpos[0]",
  "                dc = actors[0][1] - oldpos[1]",
  "                pair = (oldpos, identity[1])",
  "                if dr == 0 and dc == 0:",
  "                    constraints[pair] = constraints.get(pair, 0) + 1",
  "                else:",
  "                    constraints[pair] = 0",
  "                    effects[identity[1]] = effects.get(identity[1], 0) + 1",
  "                    if c[2] <= abs(dr) + abs(dc) <= c[3] and (dr == 0 or dc == 0):",
  "                        motion[identity[1]] = (dr, dc)",
  "        elif level == oldlevel:",
  "            oldnode['bad'][identity] = oldnode['bad'].get(identity, 0) + int(c[1])",
  "            if identity[0] == 'key' and oldpos is not None:",
  "                constraints[(oldpos, identity[1])] = int(c[1])",
  "    moves = []",
  "    for i in range(len(params['order'])):",
  "        action = int(params['order'][i])",
  "        if action in avail:",
  "            direction = motion.get(action, (int(params['directions'][i][0]), int(params['directions'][i][1])))",
  "            moves.append((action, direction[0], direction[1], i))",
  "    route = None",
  "    distance_to_goal = int(c[4])",
  "    if actors and goals:",
  "        start = actors[0]",
  "        queue = [start]",
  "        first = {}",
  "        distances = {start: 0}",
  "        head = 0",
  "        while head < len(queue) and head < int(c[4]):",
  "            p = queue[head]",
  "            head += 1",
  "            if any(abs(p[0] - g[0]) + abs(p[1] - g[1]) <= c[5] for g in goals):",
  "                route = first.get(p)",
  "                distance_to_goal = distances[p]",
  "                break",
  "            for action, dr, dc, rank in moves:",
  "                if constraints.get((p, action), 0) >= c[20]:",
  "                    continue",
  "                q = (p[0] + dr, p[1] + dc)",
  "                if q in distances or q[0] < 0 or q[1] < 0 or q[0] >= h or q[1] >= board.shape[1]:",
  "                    continue",
  "                length = max(abs(dr), abs(dc))",
  "                clear = length > 0",
  "                for t in range(1, length + 1):",
  "                    r = p[0] + int(round(dr * t / length))",
  "                    x = p[1] + int(round(dc * t / length))",
  "                    if not any(int(board[r, x]) == int(v) for v in params['passable']):",
  "                        clear = False",
  "                        break",
  "                if clear:",
  "                    distances[q] = distances[p] + 1",
  "                    first[q] = action if p == start else first[p]",
  "                    queue.append(q)",
  "    identities = []",
  "    for action, dr, dc, rank in moves:",
  "        base = float(c[6]) - rank * c[7] + (c[8] if action == route else 0)",
  "        if actors:",
  "            base -= c[21] * constraints.get((actors[0], action), 0)",
  "        base += c[22] * min(effects.get(action, 0), int(c[23]))",
  "        identities.append((('key', action), action, 0, 0, base))",
  "    for action in avail:",
  "        if action != int(c[9]) and not any(action == m[0] for m in moves):",
  "            identities.append((('key', action), action, 0, 0, float(c[10])))",
  "    if int(c[9]) in avail:",
  "        clickpoints = actors + goals",
  "        for colour in params['click_colours']:",
  "            points = np.argwhere(board == int(colour))",
  "            remaining = set((int(p[0]), int(p[1])) for p in points)",
  "            while remaining:",
  "                p = next(iter(remaining))",
  "                remaining.remove(p)",
  "                todo = [p]",
  "                component = [p]",
  "                while todo:",
  "                    r, x = todo.pop()",
  "                    for q in ((r - 1, x), (r + 1, x), (r, x - 1), (r, x + 1)):",
  "                        if q in remaining:",
  "                            remaining.remove(q)",
  "                            todo.append(q)",
  "                            component.append(q)",
  "                clickpoints.append((int(round(sum(q[0] for q in component) / len(component))), int(round(sum(q[1] for q in component) / len(component)))))",
  "        seen = set()",
  "        for r, x in clickpoints:",
  "            if (r, x) not in seen:",
  "                seen.add((r, x))",
  "                identities.append((('click', x, r), int(c[9]), x, r, float(c[11])))",
  "    node['actions'] = identities",
  "    node['score'] = -distance_to_goal",
  "    best = None",
  "    bestscore = -float(c[12]) * float(c[12])",
  "    for identity, action, x, y, base in identities:",
  "        score = base - c[13] * node['used'].get(identity, 0) - c[14] * node['bad'].get(identity, 0)",
  "        if identity not in node['used']:",
  "            score += c[15]",
  "        destination = node['edges'].get(identity)",
  "        if destination in graph and destination != signature:",
  "            score -= c[24] * sum(graph[destination]['used'].values())",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity, action, x, y)",
  "    if identities and all(identity in node['used'] for identity, action, x, y, base in identities):",
  "        queue = [signature]",
  "        depth = {signature: 0}",
  "        firstedge = {}",
  "        head = 0",
  "        frontier = None",
  "        frontier_score = -float(c[12]) * float(c[12])",
  "        while head < len(queue) and head < int(c[4]):",
  "            state = queue[head]",
  "            head += 1",
  "            record = graph[state]",
  "            if state != signature:",
  "                untested = [item for item in record.get('actions', []) if item[0] not in record['used']]",
  "                if untested:",
  "                    score = c[16] * record['score'] - c[17] * depth[state] + max(item[4] for item in untested)",
  "                    if score > frontier_score:",
  "                        frontier_score = score",
  "                        frontier = firstedge[state]",
  "            for identity, destination in record['edges'].items():",
  "                if destination in graph and destination not in depth and record['bad'].get(identity, 0) < c[18]:",
  "                    depth[destination] = depth[state] + 1",
  "                    firstedge[destination] = identity if state == signature else firstedge[state]",
  "                    queue.append(destination)",
  "        if frontier is not None:",
  "            for identity, action, x, y, base in identities:",
  "                if identity == frontier:",
  "                    best = (identity, action, x, y)",
  "                    break",
  "    if best is None:",
  "        best = (('key', avail[0]), avail[0], 0, 0)",
  "    identity, action, x, y = best",
  "    node['used'][identity] = node['used'].get(identity, 0) + 1",
  "    mem['previous'] = (level, signature, identity, reset, actors[0] if actors else None)",
  "    mem['level'] = level",
  "    mem['reset'] = reset",
  "    return (int(action), int(x), int(y))"
 ],
