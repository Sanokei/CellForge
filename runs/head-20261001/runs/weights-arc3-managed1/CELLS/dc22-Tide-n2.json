 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['cfg']",
  "    order = params['order']",
  "    motion = params['motion']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['effects'] = {}",
  "        mem['clicks'] = {}",
  "        mem['phase'] = 0",
  "    split = max(1, min(frame.shape[1], int(cfg[0])))",
  "    size = max(1, min(8, int(cfg[1])))",
  "    player = int(cfg[2])",
  "    points = np.argwhere(frame[:, :split] == player)",
  "    if len(points) == 0:",
  "        count = mem.get('missing', 0)",
  "        mem['missing'] = count + 1",
  "        action = int(order[count % len(order)])",
  "        if action not in avail:",
  "            action = avail[0]",
  "        return (action, 0, 0)",
  "    pos = (int(np.min(points[:, 0])), int(np.min(points[:, 1])))",
  "    colours = [int(v) for v in params['terrain']]",
  "    board = np.zeros(frame.shape, dtype=bool)",
  "    for colour in colours:",
  "        board = board | (frame == colour)",
  "    board[:, split:] = False",
  "    signature = tuple(tuple(row[:split]) for row in frame[int(cfg[3]):int(cfg[4])])",
  "    visits = mem['visits']",
  "    visits[signature] = visits.get(signature, 0) + 1",
  "    blocked = mem['blocked']",
  "    if 'previous' in mem:",
  "        oldpos, oldaction, oldsignature, oldframe = mem['previous']",
  "        if oldaction[0] != int(cfg[5]):",
  "            dr = pos[0] - oldpos[0]",
  "            dc = pos[1] - oldpos[1]",
  "            if abs(dr) + abs(dc) > 0 and abs(dr) + abs(dc) <= cfg[6]:",
  "                mem['effects'][oldaction[0]] = (dr, dc)",
  "            elif pos == oldpos:",
  "                token = (oldsignature, oldaction[0])",
  "                blocked[token] = blocked.get(token, 0) + 1",
  "        else:",
  "            token = (oldsignature, oldaction)",
  "            mem['clicks'][token] = mem['clicks'].get(token, 0) + 1",
  "        if oldpos == pos:",
  "            mem['stuck'] = mem.get('stuck', 0) + 1",
  "        else:",
  "            mem['stuck'] = 0",
  "        for colour in params['goals']:",
  "            colour = int(colour)",
  "            if np.any(oldframe[:, :split] == colour) and not np.any(frame[:, :split] == colour):",
  "                mem['phase'] += 1",
  "    targets = []",
  "    for index in range(len(params['goals'])):",
  "        colour = int(params['goals'][index])",
  "        cells = np.argwhere(frame[:, :split] == colour)",
  "        if len(cells):",
  "            target = (int(np.min(cells[:, 0])), int(np.min(cells[:, 1])))",
  "            targets.append((index, target))",
  "    directions = {}",
  "    for index in range(len(order)):",
  "        action = int(order[index])",
  "        directions[action] = mem['effects'].get(action, (int(motion[index][0]), int(motion[index][1])))",
  "    queue = [pos]",
  "    first = {pos: None}",
  "    depths = {pos: 0}",
  "    cursor = 0",
  "    best = None",
  "    bestscore = -1000000000.0",
  "    limit = max(1, min(1000, int(abs(cfg[7]))))",
  "    while cursor < len(queue) and cursor < limit:",
  "        current = queue[cursor]",
  "        cursor += 1",
  "        distance = 1000000.0",
  "        for index, target in targets:",
  "            d = abs(current[0] - target[0]) + abs(current[1] - target[1]) + cfg[8] * index",
  "            if d < distance:",
  "                distance = d",
  "        candidate = first[current]",
  "        if candidate is not None:",
  "            score = -cfg[9] * distance - cfg[10] * depths[current]",
  "            score -= cfg[11] * blocked.get((signature, candidate), 0)",
  "            score -= cfg[12] * mem.get('usage', {}).get((signature, candidate), 0)",
  "            if score > bestscore:",
  "                bestscore = score",
  "                best = candidate",
  "        for value in order:",
  "            action = int(value)",
  "            if action not in avail:",
  "                continue",
  "            dr, dc = directions[action]",
  "            nxt = (current[0] + dr, current[1] + dc)",
  "            r, c = nxt",
  "            if r < 0 or c < 0 or r + size > frame.shape[0] or c + size > split or nxt in first:",
  "                continue",
  "            patch = board[r:r + size, c:c + size]",
  "            if np.sum(patch) < cfg[13] * size * size:",
  "                continue",
  "            if current == pos and blocked.get((signature, action), 0) >= cfg[14]:",
  "                continue",
  "            first[nxt] = action if current == pos else first[current]",
  "            depths[nxt] = depths[current] + 1",
  "            queue.append(nxt)",
  "    clicks = []",
  "    if int(cfg[5]) in avail:",
  "        for value in params['tools']:",
  "            colour = int(value)",
  "            cells = np.argwhere(frame[:, split:] == colour)",
  "            if len(cells):",
  "                x = int(np.sum(cells[:, 1]) / len(cells)) + split",
  "                y = int(np.sum(cells[:, 0]) / len(cells))",
  "                clicks.append((int(cfg[5]), x, y))",
  "    result = None",
  "    if best is not None:",
  "        dr, dc = directions[best]",
  "        r, c = pos[0] + dr, pos[1] + dc",
  "        patch = frame[r:r + size, c:c + size]",
  "        for index in range(len(params['tools'])):",
  "            colour = int(params['tools'][index])",
  "            if np.any(patch == colour) and np.any(patch == int(cfg[15])) and index < len(clicks):",
  "                candidate = clicks[index]",
  "                count = mem['clicks'].get((signature, candidate), 0)",
  "                if count < cfg[16]:",
  "                    result = candidate",
  "                    break",
  "        if result is None:",
  "            result = (best, 0, 0)",
  "    if result is None or mem.get('stuck', 0) >= cfg[17]:",
  "        candidates = list(clicks)",
  "        for value in order:",
  "            action = int(value)",
  "            if action in avail:",
  "                candidates.append((action, 0, 0))",
  "        usage = mem.setdefault('usage', {})",
  "        minimum = 1000000000.0",
  "        for index in range(len(candidates)):",
  "            candidate = candidates[index]",
  "            count = usage.get((signature, candidate[0] if candidate[0] != int(cfg[5]) else candidate), 0)",
  "            score = cfg[18] * count + cfg[19] * index",
  "            if candidate[0] != int(cfg[5]):",
  "                score += cfg[20] * blocked.get((signature, candidate[0]), 0)",
  "            if score < minimum:",
  "                minimum = score",
  "                result = candidate",
  "    if result is None:",
  "        result = (avail[0], 0, 0)",
  "    usage = mem.setdefault('usage', {})",
  "    token = (signature, result[0] if result[0] != int(cfg[5]) else result)",
  "    usage[token] = usage.get(token, 0) + 1",
  "    mem['previous'] = (pos, result, signature, frame.copy())",
  "    return result"
 ],
