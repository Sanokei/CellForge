 "source_lines": [
  "def groups(mask):",
  "    todo = set((int(q[0]), int(q[1])) for q in np.argwhere(mask))",
  "    result = []",
  "    while todo:",
  "        seed = next(iter(todo))",
  "        todo.remove(seed)",
  "        stack = [seed]",
  "        cells = [seed]",
  "        while stack:",
  "            r, c = stack.pop()",
  "            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if q in todo:",
  "                    todo.remove(q)",
  "                    stack.append(q)",
  "                    cells.append(q)",
  "        r = sum(q[0] for q in cells) / len(cells)",
  "        c = sum(q[1] for q in cells) / len(cells)",
  "        near = min(cells, key=lambda q: abs(q[0] - r) + abs(q[1] - c))",
  "        result.append((r, c, len(cells), near[0], near[1]))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    p = params['config']",
  "    w = params['weights']",
  "    height = max(1, min(frame.shape[0], int(p[0])))",
  "    width = frame.shape[1]",
  "    board = frame[:height]",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        motion = mem.get('motion', {})",
  "        effects = mem.get('effects', {})",
  "        mem.clear()",
  "        mem['motion'] = motion",
  "        mem['effects'] = effects",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['nodes'] = {}",
  "        mem['stuck'] = 0",
  "    pixels = np.argwhere((board == int(p[1])) | (board == int(p[2])))",
  "    if len(pixels):",
  "        ay = float(np.sum(pixels[:, 0])) / len(pixels)",
  "        ax = float(np.sum(pixels[:, 1])) / len(pixels)",
  "    else:",
  "        ay = float(p[3])",
  "        ax = float(p[4])",
  "    targets = groups(board == int(p[5]))",
  "    targets.sort(key=lambda q: (q[0], q[1]))",
  "    signature = tuple(int(v) for v in board.flatten())",
  "    nodes = mem['nodes']",
  "    node = nodes.setdefault(signature, {'visits': 0, 'trials': {}, 'edges': {}})",
  "    node['visits'] += 1",
  "    potential = -w[0] * len(targets) - w[1] * ay",
  "    node['value'] = float(potential)",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        oldsig, identity, olday, oldax, oldcount = previous",
  "        oldnode = nodes[oldsig]",
  "        oldnode['edges'][identity] = signature",
  "        changed = signature != oldsig",
  "        mem['stuck'] = 0 if changed else mem['stuck'] + 1",
  "        effect = mem['effects'].setdefault(identity[0], [0.0, 0.0, 0.0])",
  "        effect[0] += 1",
  "        effect[1] += oldcount - len(targets)",
  "        effect[2] += olday - ay",
  "        if identity[0] != int(p[6]) and changed:",
  "            dr = ay - olday",
  "            dc = ax - oldax",
  "            if p[7] <= abs(dr) + abs(dc) <= p[8]:",
  "                mem['motion'][identity[0]] = (dr, dc)",
  "    candidates = []",
  "    for i, v in enumerate(params['order']):",
  "        action = int(v)",
  "        if action in avail:",
  "            dr, dc = mem['motion'].get(action, (params['motion'][i][0], params['motion'][i][1]))",
  "            nr = int(round(ay + dr))",
  "            nc = int(round(ax + dc))",
  "            score = w[2] - w[3] * i",
  "            if targets:",
  "                goal = min(targets, key=lambda q: abs(q[1] - ax) + p[9] * abs(q[0] - ay))",
  "                before = abs(goal[1] - ax)",
  "                after = abs(goal[1] - ax - dc)",
  "                score += w[4] * (before - after)",
  "            if nr < 0 or nr >= height or nc < 0 or nc >= width:",
  "                score -= w[5]",
  "            elif int(board[nr, nc]) == int(p[10]):",
  "                score -= w[6]",
  "            candidates.append(((action, 0, 0), score))",
  "    click = int(p[6])",
  "    if click in avail:",
  "        for r, c, area, pr, pc in targets:",
  "            if area < p[11] or area > p[12]:",
  "                continue",
  "            identity = (click, pc, pr)",
  "            score = w[7] - w[8] * abs(c - ax) - w[9] * abs(r - ay)",
  "            if r < ay:",
  "                score += w[10]",
  "            score += w[11] * min(p[13], mem['stuck'])",
  "            candidates.append((identity, score))",
  "    if not candidates:",
  "        candidates = [((int(avail[0]), 0, 0), 0.0)]",
  "    node['candidates'] = [q[0] for q in candidates]",
  "    best = candidates[0][0]",
  "    bestscore = -float(p[14])",
  "    for identity, score in candidates:",
  "        trials = node['trials'].get(identity, 0)",
  "        score += w[12] / (1 + trials)",
  "        score -= w[13] * trials",
  "        effect = mem['effects'].get(identity[0])",
  "        if effect is not None and effect[0] > 0:",
  "            score += w[14] * (w[0] * effect[1] + w[1] * effect[2]) / effect[0]",
  "        destination = node['edges'].get(identity)",
  "        if destination is not None:",
  "            other = nodes[destination]",
  "            score += w[15] * (other['value'] - potential)",
  "            score -= w[16] * other['visits']",
  "            if destination == signature:",
  "                score -= w[17]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = identity",
  "    if all(node['trials'].get(q[0], 0) > 0 for q in candidates):",
  "        queue = [(signature, None, 0)]",
  "        seen = set([signature])",
  "        head = 0",
  "        route = None",
  "        routescore = -float(p[14])",
  "        while head < len(queue) and head < int(p[15]):",
  "            state, first, depth = queue[head]",
  "            head += 1",
  "            entry = nodes[state]",
  "            fresh = sum(1 for a in entry.get('candidates', []) if entry['trials'].get(a, 0) == 0)",
  "            if first is not None and fresh:",
  "                score = w[18] * fresh - w[19] * depth + w[20] * (entry['value'] - potential)",
  "                if score > routescore:",
  "                    routescore = score",
  "                    route = first",
  "            for identity, destination in entry['edges'].items():",
  "                if destination in nodes and destination not in seen:",
  "                    seen.add(destination)",
  "                    queue.append((destination, identity if first is None else first, depth + 1))",
  "        if route is not None:",
  "            best = route",
  "    node['trials'][best] = node['trials'].get(best, 0) + 1",
  "    mem['previous'] = (signature, best, ay, ax, len(targets))",
  "    return best"
 ],
