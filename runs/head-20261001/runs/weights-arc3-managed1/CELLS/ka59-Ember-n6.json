 "source_lines": [
  "def groups(frame, colour, height, limit):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame[:height] == colour))",
  "    result = []",
  "    while remaining:",
  "        start = remaining.pop()",
  "        todo = [start]",
  "        cells = [start]",
  "        while todo:",
  "            y, x = todo.pop()",
  "            for q in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        if 1 < len(cells) <= limit:",
  "            result.append((int(round(sum(p[1] for p in cells)/len(cells))), int(round(sum(p[0] for p in cells)/len(cells)))))",
  "    return sorted(result)",
  "def act(params, mem, frame, avail, info):",
  "    c = [int(round(v)) for v in params['config']]",
  "    ring, target, floor, gate, wall, player, boxcolour, stride, height, limit, tolerance, cap, clickid = c",
  "    height = max(1,min(frame.shape[0],height))",
  "    moves = [(int(r[0]),int(r[1]),int(r[2])) for r in params['moves'] if int(r[0]) in avail]",
  "    records = mem.setdefault('records',{})",
  "    level = info['levels']",
  "    graph = records.setdefault(level,{})",
  "    signature = tuple(int(v) for v in frame[:height].flatten())",
  "    node = graph.setdefault(signature,{'used':{},'edges':{},'bad':{}})",
  "    rings = groups(frame,ring,height,max(1,limit))",
  "    actor = None",
  "    box = None",
  "    for x,y in rings:",
  "        if int(frame[y,x]) == player:",
  "            actor = (x,y)",
  "        elif int(frame[y,x]) == boxcolour:",
  "            box = (x,y)",
  "    if actor is None and rings:",
  "        actor = rings[0]",
  "    if box is None:",
  "        others = [p for p in rings if p != actor]",
  "        if others:",
  "            box = others[0]",
  "    state = actor + box if actor is not None and box is not None else None",
  "    fresh = mem.get('level') != level or mem.get('reset') != info['resets']",
  "    previous = mem.get('previous')",
  "    if fresh:",
  "        mem['goals'] = groups(frame,target,height,max(1,limit))",
  "        mem['physics'] = {}",
  "        mem['motion'] = {}",
  "        mem['probe'] = 0",
  "        mem['clickprobe'] = 0",
  "        mem['positions'] = {}",
  "    goals = mem.get('goals',[])",
  "    physics = mem.setdefault('physics',{})",
  "    motion = mem.setdefault('motion',{})",
  "    if previous is not None:",
  "        oldlevel,oldsig,identity,oldreset,oldstate = previous",
  "        oldgraph = records.setdefault(oldlevel,{})",
  "        oldnode = oldgraph.setdefault(oldsig,{'used':{},'edges':{},'bad':{}})",
  "        if oldlevel == level and oldreset == info['resets']:",
  "            oldnode['edges'][identity] = signature",
  "            if signature == oldsig:",
  "                oldnode['bad'][identity] = oldnode['bad'].get(identity,0)+1",
  "            if state is not None and oldstate is not None and identity[0] == 0:",
  "                a = identity[1]",
  "                physics[(oldstate,a)] = state",
  "                dx,dy = state[0]-oldstate[0],state[1]-oldstate[1]",
  "                if abs(dx)+abs(dy) == abs(stride):",
  "                    motion[a] = (dx,dy)",
  "                if oldstate[2:] != state[2:] and oldstate[:2] != state[:2]:",
  "                    bx,by = state[2]-oldstate[2],state[3]-oldstate[3]",
  "                    if abs(oldstate[0]-oldstate[2])+abs(oldstate[1]-oldstate[3]) > abs(stride):",
  "                        mem.setdefault('coupled',{})[a] = (bx,by)",
  "        elif oldlevel == level:",
  "            oldnode['bad'][identity] = oldnode['bad'].get(identity,0)+float(params['search'][0])",
  "        else:",
  "            oldnode['success'] = identity",
  "    moves = [(a,motion.get(a,(dx,dy))[0],motion.get(a,(dx,dy))[1]) for a,dx,dy in moves]",
  "    positions = mem.setdefault('positions',{})",
  "    if state is not None:",
  "        positions[state] = positions.get(state,0)+1",
  "    route = None",
  "    if state is not None and stride > 0 and goals:",
  "        board = set()",
  "        gates = set()",
  "        radius = stride//2",
  "        allowed = set((floor,gate,target,ring,player,boxcolour))",
  "        for y in range(actor[1]%stride,height,stride):",
  "            for x in range(actor[0]%stride,frame.shape[1],stride):",
  "                clear = True",
  "                gated = False",
  "                for yy in range(y-radius,y+radius+1):",
  "                    for xx in range(x-radius,x+radius+1):",
  "                        if yy < 0 or xx < 0 or yy >= height or xx >= frame.shape[1]:",
  "                            clear = False",
  "                        else:",
  "                            value = int(frame[yy,xx])",
  "                            if value not in allowed:",
  "                                clear = False",
  "                            if value == gate:",
  "                                gated = True",
  "                if clear:",
  "                    board.add((x,y))",
  "                    if gated:",
  "                        gates.add((x,y))",
  "        goalcells = []",
  "        for gx,gy in goals:",
  "            goalcells.append(set(p for p in board if abs(p[0]-gx)<=tolerance and abs(p[1]-gy)<=tolerance))",
  "        queue = [state]",
  "        first = {state:None}",
  "        depth = {state:0}",
  "        head = 0",
  "        bestscore = None",
  "        best = None",
  "        while head < len(queue) and head < max(1,cap)*max(1,len(board)):",
  "            current = queue[head]",
  "            head += 1",
  "            ax,ay,bx,by = current",
  "            occupied = any((ax,ay) in g or (bx,by) in g for g in goalcells)",
  "            solved = any((ax,ay) in goalcells[i] and (bx,by) in goalcells[j] for i in range(len(goalcells)) for j in range(len(goalcells)) if i != j)",
  "            if solved and current != state:",
  "                route = first[current]",
  "                break",
  "            if current != state:",
  "                distances = [abs(ax-gx)+abs(ay-gy)+abs(bx-hx)+abs(by-hy) for gx,gy in goals for hx,hy in goals if (gx,gy)!=(hx,hy)]",
  "                distance = min(distances) if distances else min(abs(ax-gx)+abs(ay-gy) for gx,gy in goals)",
  "                score = distance + float(params['search'][1])*depth[current] + float(params['search'][2])*positions.get(current,0)",
  "                if bestscore is None or score < bestscore:",
  "                    bestscore = score",
  "                    best = first[current]",
  "            for a,dx,dy in moves:",
  "                if (current,a) in physics:",
  "                    following = physics[(current,a)]",
  "                else:",
  "                    destination = (ax+dx,ay+dy)",
  "                    if destination not in board or (destination in gates and not occupied):",
  "                        continue",
  "                    newbox = (bx,by)",
  "                    if a in mem.get('coupled',{}):",
  "                        ux,uy = mem['coupled'][a]",
  "                        proposed = (bx+ux,by+uy)",
  "                        if proposed in board and (proposed not in gates or occupied):",
  "                            newbox = proposed",
  "                    elif destination == newbox:",
  "                        newbox = (bx+dx,by+dy)",
  "                        if newbox not in board or (newbox in gates and not occupied):",
  "                            continue",
  "                    following = destination + newbox",
  "                if following == current or following in first:",
  "                    continue",
  "                first[following] = a if current == state else first[current]",
  "                depth[following] = depth[current]+1",
  "                queue.append(following)",
  "        if route is None:",
  "            route = best",
  "    identities = []",
  "    for rank,(a,dx,dy) in enumerate(moves):",
  "        base = float(params['search'][3]) if a == route else 0.0",
  "        base -= rank*float(params['search'][4])",
  "        identities.append(((0,a),a,0,0,base))",
  "    clickpoints = rings + goals + groups(frame,gate,height,max(1,limit))",
  "    if clickid in avail:",
  "        for x,y in sorted(set(clickpoints)):",
  "            identities.append(((1,x,y),clickid,x,y,float(params['search'][5])))",
  "    node['actions'] = identities",
  "    best = None",
  "    bestscore = None",
  "    for identity,a,x,y,base in identities:",
  "        score = base - float(params['search'][6])*node['used'].get(identity,0) - float(params['search'][7])*node['bad'].get(identity,0)",
  "        if identity not in node['used']:",
  "            score += float(params['search'][8])",
  "        destination = node['edges'].get(identity)",
  "        if destination is not None:",
  "            score -= float(params['search'][9])*graph.get(destination,{}).get('visits',0)",
  "        if bestscore is None or score > bestscore:",
  "            bestscore = score",
  "            best = (identity,a,x,y)",
  "    probe = mem.get('probe',0)",
  "    if probe < len(moves):",
  "        a,dx,dy = moves[probe]",
  "        best = ((0,a),a,0,0)",
  "        mem['probe'] = probe+1",
  "    elif mem.get('clickprobe',0) < len(rings) and clickid in avail:",
  "        index = mem.get('clickprobe',0)",
  "        x,y = rings[index]",
  "        best = ((1,x,y),clickid,x,y)",
  "        mem['clickprobe'] = index+1",
  "    elif identities and all(item[0] in node['used'] for item in identities):",
  "        queue = [signature]",
  "        depth = {signature:0}",
  "        firstedge = {}",
  "        head = 0",
  "        frontier = None",
  "        frontscore = None",
  "        while head < len(queue) and head < max(1,cap):",
  "            sig = queue[head]",
  "            head += 1",
  "            record = graph[sig]",
  "            untested = [item for item in record.get('actions',[]) if item[0] not in record['used']]",
  "            if sig != signature and untested:",
  "                score = max(item[4] for item in untested)-float(params['search'][10])*depth[sig]",
  "                if frontscore is None or score > frontscore:",
  "                    frontscore = score",
  "                    frontier = firstedge[sig]",
  "            for identity,destination in record['edges'].items():",
  "                if destination in graph and destination not in depth and record['bad'].get(identity,0) == 0:",
  "                    depth[destination] = depth[sig]+1",
  "                    firstedge[destination] = identity if sig == signature else firstedge[sig]",
  "                    queue.append(destination)",
  "        if frontier is not None:",
  "            for identity,a,x,y,base in identities:",
  "                if identity == frontier:",
  "                    best = (identity,a,x,y)",
  "                    break",
  "    if best is None:",
  "        best = ((0,avail[0]),avail[0],0,0)",
  "    identity,a,x,y = best",
  "    node['visits'] = node.get('visits',0)+1",
  "    node['used'][identity] = node['used'].get(identity,0)+1",
  "    mem['previous'] = (level,signature,identity,info['resets'],state)",
  "    mem['level'] = level",
  "    mem['reset'] = info['resets']",
  "    return (int(a),int(x),int(y))"
 ],
