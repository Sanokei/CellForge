 "source_lines": [
  "def glyph(frame, y, x, n, colour):",
  "    return tuple(int(frame[y+r, x+c] == colour) for r in range(n) for c in range(n))",
  "",
  "def search(graph, start, target, actions, counts):",
  "    queue = [(start, [])]",
  "    seen = {start}",
  "    frontier = []",
  "    for node, path in queue:",
  "        if node == target:",
  "            return path, True",
  "        edges = graph.get(node, {})",
  "        for action in actions:",
  "            if action not in edges:",
  "                frontier.append((counts.get((node, action), 0), len(path), actions.index(action), path+[action]))",
  "            else:",
  "                nxt = edges[action]",
  "                if nxt not in seen:",
  "                    seen.add(nxt)",
  "                    queue.append((nxt, path+[action]))",
  "    if frontier:",
  "        frontier.sort(key=lambda item: item[:3])",
  "        return frontier[0][3], False",
  "    return [], False",
  "",
  "def act(params, mem, frame, avail, info):",
  "    g = params['geometry']",
  "    n = max(1, min(8, int(g[0])))",
  "    count = max(1, min(7, int(g[1])))",
  "    stride = max(1, int(g[2]))",
  "    sx = max(0, min(63-n-(count-1)*stride, int(g[3])))",
  "    sy = max(0, min(64-n, int(g[4])))",
  "    oy = max(0, min(64-n, int(g[5])))",
  "    low = max(0, min(63, int(g[6])))",
  "    high = max(low+1, min(64, int(g[7])))",
  "    ink = int(params['colours'][0])",
  "    cursor_colour = int(params['colours'][1])",
  "    actions = [int(a) for a in params['actions'] if int(a) in avail]",
  "    cycles = actions[:2]",
  "    moves = actions[2:]",
  "    if not actions:",
  "        return (avail[0], 0, 0)",
  "    sources = [glyph(frame, sy, sx+i*stride, n, ink) for i in range(count)]",
  "    outputs = [glyph(frame, oy, sx+i*stride, n, ink) for i in range(count)]",
  "    pairs = []",
  "    for row in params['rows']:",
  "        y = max(0, min(64-n, int(row)))",
  "        for columns in params['columns']:",
  "            x = max(0, min(64-n, int(columns[0])))",
  "            z = max(0, min(64-n, int(columns[1])))",
  "            pairs.append((glyph(frame, y, x, n, ink), glyph(frame, y, z, n, ink)))",
  "    signature = tuple(pairs)",
  "    if mem.get('signature') != signature:",
  "        mem.clear()",
  "        mem['signature'] = signature",
  "        mem['graphs'] = {}",
  "        mem['counts'] = {}",
  "        mem['directions'] = {}",
  "    stamp = (info['levels'], info['resets'])",
  "    if mem.get('stamp') != stamp:",
  "        mem['stamp'] = stamp",
  "        mem['previous'] = None",
  "        mem['visits'] = {}",
  "        mem['done'] = set()",
  "    targets = []",
  "    for source in sources:",
  "        ranked = sorted(pairs, key=lambda pair: sum(int(a != b) for a, b in zip(source, pair[0])))",
  "        targets.append(ranked[0][1])",
  "    points = np.argwhere(frame[low:high, :] == cursor_colour)",
  "    cursor = mem.get('cursor', 0)",
  "    if len(points):",
  "        center = float(np.sum(points[:, 1])) / len(points)",
  "        cursor = max(0, min(count-1, int((center-sx-(n-1)/2)/stride+float(params['rounding'][0]))))",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old_cursor, old_output, old_source, action = previous",
  "        if action in cycles and old_cursor == cursor:",
  "            graph = mem['graphs'].setdefault(old_source, {})",
  "            graph.setdefault(old_output, {})[action] = outputs[cursor]",
  "            counts = mem['counts'].setdefault(old_source, {})",
  "            edge = (old_output, action)",
  "            counts[edge] = counts.get(edge, 0)+1",
  "        elif action in moves and cursor != old_cursor:",
  "            delta = cursor-old_cursor",
  "            if abs(delta) == 1:",
  "                mem['directions'][action] = 1 if delta > 0 else -1",
  "            elif abs(delta) == count-1:",
  "                mem['directions'][action] = -1 if delta > 0 else 1",
  "    visits = mem['visits']",
  "    state = (cursor, tuple(outputs))",
  "    visits[state] = visits.get(state, 0)+1",
  "    wrong = [i for i in range(count) if outputs[i] != targets[i]]",
  "    action = None",
  "    if cursor in wrong and cycles:",
  "        graph = mem['graphs'].setdefault(sources[cursor], {})",
  "        counts = mem['counts'].setdefault(sources[cursor], {})",
  "        path, solved = search(graph, outputs[cursor], targets[cursor], cycles, counts)",
  "        if path:",
  "            action = path[0]",
  "        else:",
  "            mem['done'].add(cursor)",
  "    pending = [i for i in wrong if i not in mem['done']]",
  "    if action is None and moves and pending:",
  "        scored = []",
  "        for index, candidate in enumerate(moves):",
  "            direction = mem['directions'].get(candidate, int(params['directions'][index]))",
  "            direction = 1 if direction > 0 else -1",
  "            distance = min(((i-cursor)*direction) % count for i in pending)",
  "            scored.append((distance, index, candidate))",
  "        scored.sort()",
  "        action = scored[0][2]",
  "    if action is None:",
  "        if not pending:",
  "            mem['done'] = set()",
  "        options = cycles if cycles else actions",
  "        action = options[(visits[state]-1) % len(options)]",
  "    mem['cursor'] = cursor",
  "    mem['previous'] = (cursor, outputs[cursor], sources[cursor], action)",
  "    return (action, 0, 0)"
 ],
