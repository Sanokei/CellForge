 "source_lines": [
  "def glyph(frame, y, x, n, ink):",
  "    return tuple(int(frame[y+r, x+c] == ink) for r in range(n) for c in range(n))",
  "",
  "def plan(graph, start, target, actions, limit):",
  "    queue = [(start, [])]",
  "    seen = {start}",
  "    frontier = None",
  "    head = 0",
  "    while head < len(queue) and head < limit:",
  "        node, path = queue[head]",
  "        head += 1",
  "        if node == target:",
  "            return path",
  "        edges = graph.get(node, {})",
  "        for a in actions:",
  "            if a not in edges:",
  "                score = sum(int(x != y) for x, y in zip(node, target))",
  "                candidate = (score, len(path), path + [a])",
  "                if frontier is None or candidate[:2] < frontier[:2]:",
  "                    frontier = candidate",
  "            else:",
  "                dest = edges[a]",
  "                if dest not in seen:",
  "                    seen.add(dest)",
  "                    queue.append((dest, path + [a]))",
  "    if frontier is not None:",
  "        return frontier[2]",
  "    return None",
  "",
  "def act(params, mem, frame, avail, info):",
  "    g = params['geometry']",
  "    n = max(1, min(8, int(abs(g[0]))))",
  "    count = max(1, min(8, int(abs(g[1]))))",
  "    stride = max(1, int(abs(g[2])))",
  "    sx = max(0, min(63-n, int(g[3])))",
  "    sy = max(0, min(63-n, int(g[4])))",
  "    oy = max(0, min(63-n, int(g[5])))",
  "    ink = int(params['colors'][0])",
  "    marker = int(params['colors'][1])",
  "    actions = [int(a) for a in params['actions'] if int(a) in avail]",
  "    if len(actions) < 4 or sx+(count-1)*stride+n > 64:",
  "        return (avail[0], 0, 0)",
  "    edits = actions[:2]",
  "    moves = actions[2:]",
  "    stamp = (info['levels'], info['resets'])",
  "    if mem.get('stamp') != stamp:",
  "        retained = mem.get('graph', {}) if mem.get('level') == info['levels'] else {}",
  "        mem.clear()",
  "        mem['stamp'] = stamp",
  "        mem['level'] = info['levels']",
  "        mem['graph'] = retained",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['directions'] = {}",
  "        mem['turns'] = {}",
  "    sources = [glyph(frame, sy, sx+i*stride, n, ink) for i in range(count)]",
  "    outputs = [glyph(frame, oy, sx+i*stride, n, ink) for i in range(count)]",
  "    pairs = []",
  "    for row in params['rows']:",
  "        for cols in params['columns']:",
  "            y = max(0, min(63-n, int(row)))",
  "            x1 = max(0, min(63-n, int(cols[0])))",
  "            x2 = max(0, min(63-n, int(cols[1])))",
  "            pairs.append((glyph(frame,y,x1,n,ink),glyph(frame,y,x2,n,ink)))",
  "    targets = []",
  "    for source in sources:",
  "        exact = [b for a,b in pairs if a == source]",
  "        if exact:",
  "            targets.append(exact[0])",
  "            continue",
  "        best_error = n*n*len(pairs)+1",
  "        best_map = None",
  "        for flip in range(2):",
  "            for rotation in range(4):",
  "                for dy in range(n):",
  "                    for dx in range(n):",
  "                        mapping = []",
  "                        for r in range(n):",
  "                            for c in range(n):",
  "                                rr, cc = (r+dy)%n, (c+dx)%n",
  "                                if flip:",
  "                                    cc = n-1-cc",
  "                                for turn in range(rotation):",
  "                                    rr, cc = n-1-cc, rr",
  "                                mapping.append(rr*n+cc)",
  "                        error = sum(int(a[mapping[j]] != b[j]) for a,b in pairs for j in range(n*n))",
  "                        if error < best_error:",
  "                            best_error = error",
  "                            best_map = mapping",
  "        if best_error <= params['cfg'][0]:",
  "            targets.append(tuple(source[j] for j in best_map))",
  "        else:",
  "            target = []",
  "            for j in range(n*n):",
  "                best = len(pairs)+1",
  "                candidates = []",
  "                for k in range(n*n):",
  "                    for invert in range(2):",
  "                        error = sum(int((a[k]^invert) != b[j]) for a,b in pairs)",
  "                        if error < best:",
  "                            best = error",
  "                            candidates = [(k,invert)]",
  "                        elif error == best:",
  "                            candidates.append((k,invert))",
  "                votes = sum(source[k]^inv for k,inv in candidates)",
  "                target.append(int(votes >= len(candidates)*params['cfg'][1]))",
  "            targets.append(tuple(target))",
  "    lo = max(0, min(63,int(g[6])))",
  "    hi = max(lo+1,min(64,int(g[7])))",
  "    points = np.argwhere(frame[lo:hi,:] == marker)",
  "    if len(points):",
  "        center = float(np.sum(points[:,1]))/len(points)",
  "        cursor = max(0,min(count-1,int((center-sx-(n-1)/2)/stride+params['cfg'][2])))",
  "    else:",
  "        return (moves[int(info['step'])%len(moves)],0,0)",
  "    graph = mem['graph']",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old_cursor, old_output, last = previous",
  "        if last in edits and old_cursor == cursor:",
  "            graph.setdefault(old_output,{})[last] = outputs[cursor]",
  "            if old_output == outputs[cursor]:",
  "                mem['blocked'][(old_output,last)] = True",
  "        if last in moves and old_cursor != cursor:",
  "            delta = (cursor-old_cursor)%count",
  "            if delta == 1:",
  "                mem['directions'][last] = 1",
  "            elif delta == count-1:",
  "                mem['directions'][last] = -1",
  "    state = (cursor,outputs[cursor])",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state,0)+1",
  "    wrong = [i for i in range(count) if outputs[i] != targets[i]]",
  "    action = None",
  "    if cursor in wrong:",
  "        path = plan(graph,outputs[cursor],targets[cursor],edits,int(params['cfg'][3]))",
  "        if path:",
  "            action = path[0]",
  "        else:",
  "            counts = mem['turns'].setdefault(state,{})",
  "            bestscore = -1000000",
  "            for a in edits:",
  "                dest = graph.get(outputs[cursor],{}).get(a)",
  "                score = -counts.get(a,0)*params['cfg'][4]",
  "                if dest is not None:",
  "                    score -= sum(int(x != y) for x,y in zip(dest,targets[cursor]))*params['cfg'][5]",
  "                    score -= visits.get((cursor,dest),0)*params['cfg'][6]",
  "                if mem['blocked'].get((outputs[cursor],a),False):",
  "                    score -= params['cfg'][7]",
  "                if score > bestscore:",
  "                    bestscore = score",
  "                    action = a",
  "            counts[action] = counts.get(action,0)+1",
  "        if visits[state] > params['cfg'][8] and len(wrong)>1:",
  "            action = None",
  "    if action is None:",
  "        bestcost = 1000000",
  "        for index,a in enumerate(moves):",
  "            direction = mem['directions'].get(a,int(params['directions'][index]))",
  "            if direction == 0:",
  "                direction = 1",
  "            distances = [((i-cursor)*direction)%count for i in wrong if i != cursor]",
  "            cost = min(distances) if distances else 0",
  "            if cost < bestcost:",
  "                bestcost = cost",
  "                action = a",
  "    mem['previous'] = (cursor,outputs[cursor],action)",
  "    return (action,0,0)"
 ],
