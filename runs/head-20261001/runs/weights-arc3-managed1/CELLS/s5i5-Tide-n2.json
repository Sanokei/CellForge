 "source_lines": [
  "def groups(frame, colour):",
  "    remaining = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        stack = [start]",
  "        group = []",
  "        while stack:",
  "            y, x = stack.pop()",
  "            group.append((y, x))",
  "            for dy in (-1, 0, 1):",
  "                for dx in (-1, 0, 1):",
  "                    q = (y + dy, x + dx)",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        stack.append(q)",
  "        result.append(group)",
  "    return result",
  "def distance(markers, targets):",
  "    total = 0.0",
  "    for x, y in markers:",
  "        if targets:",
  "            total += min(abs(x - tx) + abs(y - ty) for tx, ty in targets)",
  "    return total",
  "def opening(params, mem, frame, avail, info):",
  "    p = params['opening']",
  "    controls = []",
  "    for group in groups(frame, int(p[0])):",
  "        if p[2] <= len(group) <= p[3]:",
  "            cy = sum(q[0] for q in group) / len(group)",
  "            cx = sum(q[1] for q in group) / len(group)",
  "            if cy < p[4]:",
  "                point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))",
  "                controls.append((point[1], point[0]))",
  "    controls.sort()",
  "    markers = []",
  "    targets = []",
  "    for group in groups(frame, int(p[1])):",
  "        x = sum(q[1] for q in group) / len(group)",
  "        y = sum(q[0] for q in group) / len(group)",
  "        if len(group) <= p[5]:",
  "            markers.append((x, y))",
  "        elif p[6] <= len(group) <= p[7]:",
  "            targets.append((x, y))",
  "    markers.sort()",
  "    targets.sort()",
  "    models = mem.setdefault('models', {})",
  "    trials = mem.setdefault('trials', {})",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old_markers, old_targets, old_action = previous",
  "        effects = []",
  "        unmatched = list(markers)",
  "        for ox, oy in old_markers:",
  "            if unmatched:",
  "                current = min(unmatched, key=lambda q: abs(q[0] - ox) + abs(q[1] - oy))",
  "                unmatched.remove(current)",
  "                dx, dy = current[0] - ox, current[1] - oy",
  "                if abs(dx) + abs(dy) > p[8]:",
  "                    effects.append((current[0], current[1], dx, dy))",
  "        models[old_action] = effects",
  "        trials[old_action] = trials.get(old_action, 0) + 1",
  "    state = (tuple(markers), tuple(targets), int(np.sum(frame == int(p[9]))), int(np.sum(frame == int(p[10]))))",
  "    used = mem.setdefault('used', {}).setdefault(state, {})",
  "    visits = mem.setdefault('visits', {})",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if not controls:",
  "        return (avail[0], int(p[12]), int(p[13]))",
  "    current_distance = distance(markers, targets)",
  "    best = controls[0]",
  "    best_score = -1000000000.0",
  "    for index, action in enumerate(controls):",
  "        count = trials.get(action, 0)",
  "        score = p[14] if count == 0 else 0.0",
  "        if count:",
  "            effects = models.get(action, [])",
  "            predicted = list(markers)",
  "            assigned = set()",
  "            for ax, ay, dx, dy in effects:",
  "                candidates = [i for i in range(len(markers)) if i not in assigned]",
  "                if candidates:",
  "                    i = min(candidates, key=lambda j: abs(markers[j][0] - ax) + abs(markers[j][1] - ay))",
  "                    assigned.add(i)",
  "                    predicted[i] = (markers[i][0] + dx * p[15], markers[i][1] + dy * p[15])",
  "            score += p[16] * (current_distance - distance(predicted, targets))",
  "            if not effects:",
  "                score -= p[17]",
  "            predicted_state = (tuple(sorted(predicted)), tuple(targets), state[2], state[3])",
  "            score -= p[18] * visits.get(predicted_state, 0)",
  "        score -= p[19] * used.get(action, 0)",
  "        score -= p[20] * count",
  "        score += p[21] * index",
  "        if score > best_score:",
  "            best_score, best = score, action",
  "    used[best] = used.get(best, 0) + 1",
  "    mem['previous'] = (markers, targets, best)",
  "    return (6 if 6 in avail else avail[0], int(best[0]), int(best[1]))",
  "def describe(frame, p):",
  "    markers = []",
  "    targets = []",
  "    for group in groups(frame, int(p[1])):",
  "        point = (sum(q[1] for q in group) / len(group), sum(q[0] for q in group) / len(group))",
  "        if len(group) <= p[2]:",
  "            markers.append(point)",
  "        elif p[3] <= len(group) <= p[4]:",
  "            targets.append(point)",
  "    markers.sort()",
  "    targets.sort()",
  "    objects = []",
  "    signature = []",
  "    for colour in p[18:]:",
  "        points = [(int(q[1]), int(q[0])) for q in np.argwhere(frame == int(colour)) if q[0] < p[5]]",
  "        signature.append(tuple(sorted(points)))",
  "        if points:",
  "            objects.append((sum(q[0] for q in points) / len(points), sum(q[1] for q in points) / len(points)))",
  "        else:",
  "            objects.append((0.0, 0.0))",
  "    return (tuple(signature), tuple(markers)), markers, targets, objects",
  "def goalfield(frame, markers, targets, p):",
  "    field = {}",
  "    if not markers or not targets:",
  "        return field",
  "    mx, my = markers[0]",
  "    offsets = []",
  "    for q in np.argwhere(frame == int(p[19])):",
  "        if q[0] < p[5]:",
  "            offsets.append((int(q[1] - mx), int(q[0] - my)))",
  "    if not offsets:",
  "        offsets = [(0, 0)]",
  "    blocked = set()",
  "    for q in np.argwhere(frame == int(p[6])):",
  "        for dx, dy in offsets:",
  "            blocked.add((int(q[1]) - dx, int(q[0]) - dy))",
  "    queue = []",
  "    for tx, ty in targets:",
  "        point = (int(tx), int(ty))",
  "        field[point] = 0",
  "        queue.append(point)",
  "    head = 0",
  "    while head < len(queue):",
  "        x, y = queue[head]",
  "        head += 1",
  "        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
  "            q = (x + dx, y + dy)",
  "            if 0 <= q[0] < frame.shape[1] and 0 <= q[1] < p[5] and q not in blocked and q not in field:",
  "                field[q] = field[(x, y)] + 1",
  "                queue.append(q)",
  "    return field",
  "def metric(markers, targets, field, p):",
  "    return sum(field.get((int(x), int(y)), p[7] + min([abs(x - tx) + abs(y - ty) for tx, ty in targets] + [p[7]])) for x, y in markers)",
  "def act(params, mem, frame, avail, info):",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "    if info['levels'] == 0:",
  "        return opening(params, mem, frame, avail, info)",
  "    p = params['search']",
  "    controls = []",
  "    for group in groups(frame, int(p[0])):",
  "        if p[8] <= len(group) <= p[9]:",
  "            cy = sum(q[0] for q in group) / len(group)",
  "            cx = sum(q[1] for q in group) / len(group)",
  "            point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))",
  "            controls.append((point[1], point[0]))",
  "    controls = sorted(set(controls))",
  "    if not controls:",
  "        return (avail[0], int(p[10]), int(p[10]))",
  "    state, markers, targets, objects = describe(frame, p)",
  "    if 'field' not in mem:",
  "        mem['field'] = goalfield(frame, markers, targets, p)",
  "    field = mem['field']",
  "    cost = metric(markers, targets, field, p)",
  "    nodes = mem.setdefault('nodes', {})",
  "    edges = mem.setdefault('edges', {})",
  "    models = mem.setdefault('effects', {})",
  "    counts = mem.setdefault('counts', {})",
  "    node = nodes.setdefault(state, {'cost': cost, 'used': {}, 'visits': 0})",
  "    node['visits'] += 1",
  "    previous = mem.get('last')",
  "    if previous is not None:",
  "        oldstate, action, oldmarkers, oldobjects = previous",
  "        edges.setdefault(oldstate, {})[action] = state",
  "        counts[action] = counts.get(action, 0) + 1",
  "        if oldstate != state:",
  "            deltas = [(objects[i][0] - oldobjects[i][0], objects[i][1] - oldobjects[i][1]) for i in range(len(objects))]",
  "            md = [(markers[i][0] - oldmarkers[i][0], markers[i][1] - oldmarkers[i][1]) for i in range(min(len(markers), len(oldmarkers)))]",
  "            models[action] = (deltas, md)",
  "    used = node['used']",
  "    best = controls[0]",
  "    bestscore = -1000000000.0",
  "    for index, action in enumerate(controls):",
  "        predicted = list(markers)",
  "        model = models.get(action)",
  "        if model is not None:",
  "            for i in range(min(len(predicted), len(model[1]))):",
  "                predicted[i] = (predicted[i][0] + model[1][i][0], predicted[i][1] + model[1][i][1])",
  "        score = p[11] * (cost - metric(predicted, targets, field, p))",
  "        score += p[12] if action not in counts else 0.0",
  "        score -= p[13] * used.get(action, 0)",
  "        destination = edges.get(state, {}).get(action)",
  "        if destination == state:",
  "            score -= p[14]",
  "        elif destination is not None:",
  "            score -= p[15] * nodes.get(destination, {}).get('visits', 0)",
  "        if model is not None and any(abs(dx) + abs(dy) > 0 for dx, dy in model[0]):",
  "            score += p[16]",
  "        score -= index * p[17]",
  "        if score > bestscore:",
  "            bestscore, best = score, action",
  "    if all(action in edges.get(state, {}) for action in controls) or used.get(best, 0) > 0:",
  "        queue = [(state, None, 0)]",
  "        seen = {state}",
  "        head = 0",
  "        frontier = None",
  "        frontier_score = 1000000000.0",
  "        while head < len(queue):",
  "            current, first, depth = queue[head]",
  "            head += 1",
  "            data = nodes[current]",
  "            unexplored = [a for a in controls if a not in edges.get(current, {})]",
  "            if unexplored:",
  "                value = data['cost'] * p[11] + depth * p[16] + data['visits'] * p[15]",
  "                if value < frontier_score:",
  "                    frontier_score = value",
  "                    frontier = first if first is not None else min(unexplored, key=lambda a: counts.get(a, 0))",
  "            for action, destination in edges.get(current, {}).items():",
  "                if destination in nodes and destination not in seen:",
  "                    seen.add(destination)",
  "                    queue.append((destination, action if first is None else first, depth + 1))",
  "        if frontier is not None:",
  "            best = frontier",
  "    used[best] = used.get(best, 0) + 1",
  "    mem['last'] = (state, best, markers, objects)",
  "    return (6 if 6 in avail else avail[0], int(best[0]), int(best[1]))"
