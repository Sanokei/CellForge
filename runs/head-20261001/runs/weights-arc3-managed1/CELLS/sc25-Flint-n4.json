 "source_lines": [
  "def groups(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    result = []",
  "    while remaining:",
  "        point = next(iter(remaining))",
  "        remaining.remove(point)",
  "        todo = [point]",
  "        cells = [point]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        r = sum(p[0] for p in cells) / len(cells)",
  "        c = sum(p[1] for p in cells) / len(cells)",
  "        result.append((r,c,len(cells),min(p[0] for p in cells),min(p[1] for p in cells),max(p[0] for p in cells),max(p[1] for p in cells)))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    p = params['config']",
  "    colours = params['colours']",
  "    h = max(1,min(frame.shape[0],int(p[0])))",
  "    w = max(1,min(frame.shape[1],int(p[1])))",
  "    mask = (frame == int(colours[0])) | (frame == int(colours[1]))",
  "    mask[h:,:] = False",
  "    mask[:,w:] = False",
  "    objects = groups(mask)",
  "    objects.sort(key=lambda q:q[2])",
  "    agent = objects[0] if objects else None",
  "    goal = objects[-1] if len(objects)>1 else None",
  "    level = info['levels']",
  "    if mem.get('level') != level or mem.get('reset') != info['resets']:",
  "        motion = mem.get('motion',{})",
  "        history = mem.get('history',{})",
  "        mem.clear()",
  "        mem['motion'] = motion",
  "        mem['history'] = history",
  "        mem['level'] = level",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['failures'] = {}",
  "        mem['edges'] = {}",
  "        mem['effects'] = {}",
  "        mem['positions'] = {}",
  "        mem['stuck'] = 0",
  "        mem['clicks'] = {}",
  "    signature = tuple(int(v) for v in frame[:h,:w].flatten())",
  "    position = (int(round(agent[0])),int(round(agent[1]))) if agent is not None else None",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, identity, oldagent, oldframe, oldpos = old",
  "        same = signature == oldsig",
  "        pair = (oldsig,identity)",
  "        if same:",
  "            mem['failures'][pair] = mem['failures'].get(pair,0)+1",
  "        mem['stuck'] = mem['stuck']+1 if same else 0",
  "        mem['edges'][(oldsig,identity)] = signature",
  "        mem['history'][(level,identity)] = mem['history'].get((level,identity),0)+int(not same)",
  "        if identity[0] == 'key' and agent is not None and oldagent is not None:",
  "            dr = agent[0]-oldagent[0]",
  "            dc = agent[1]-oldagent[1]",
  "            if p[2] <= abs(dr)+abs(dc) <= p[3]:",
  "                mem['motion'][identity[1]] = (dr,dc)",
  "            if position == oldpos:",
  "                edge = (oldpos,identity[1],mem.get('control',0))",
  "                mem['edges'][edge] = mem['edges'].get(edge,0)+1",
  "        if identity[0] == 'click':",
  "            delta = np.argwhere(frame[:h,:w] != oldframe[:h,:w])",
  "            effect = len(delta)",
  "            mem['effects'][identity] = max(mem['effects'].get(identity,0),effect)",
  "            if effect:",
  "                mem['control'] = mem.get('control',0)+1",
  "                mem['motion'] = {}",
  "    visits = mem['visits'].setdefault(signature,{})",
  "    if position is not None and (old is None or position != old[4]):",
  "        mem['positions'][position] = mem['positions'].get(position,0)+1",
  "    candidates = []",
  "    advanced = level >= int(p[4])",
  "    route = None",
  "    if advanced and agent is not None and goal is not None:",
  "        start = position",
  "        queue = [start]",
  "        costs = {start:0}",
  "        first = {}",
  "        head = 0",
  "        nearest = start",
  "        nearestscore = abs(start[0]-goal[0])+abs(start[1]-goal[1])",
  "        while head < len(queue) and head < int(p[5]):",
  "            r,c = queue[head]",
  "            head += 1",
  "            proximity = abs(r-goal[0])+abs(c-goal[1])",
  "            if proximity < nearestscore:",
  "                nearestscore = proximity",
  "                nearest = (r,c)",
  "            if proximity <= p[6]:",
  "                nearest = (r,c)",
  "                break",
  "            for i in range(len(params['order'])):",
  "                action = int(params['order'][i])",
  "                if action not in avail:",
  "                    continue",
  "                dr,dc = mem['motion'].get(action,tuple(params['directions'][i]))",
  "                nr,nc = int(round(r+dr)),int(round(c+dc))",
  "                q = (nr,nc)",
  "                if q in costs or nr<0 or nr>=h or nc<0 or nc>=w:",
  "                    continue",
  "                pixel = int(frame[nr,nc])",
  "                if pixel == int(colours[3]) or pixel == int(colours[4]):",
  "                    continue",
  "                if (r,c) == start and mem['edges'].get((start,action,mem.get('control',0)),0) >= p[7]:",
  "                    continue",
  "                costs[q] = costs[(r,c)]+1",
  "                first[q] = action if (r,c)==start else first[(r,c)]",
  "                queue.append(q)",
  "        route = first.get(nearest)",
  "    for i in range(len(params['order'])):",
  "        action = int(params['order'][i])",
  "        if action not in avail:",
  "            continue",
  "        identity = ('key',action)",
  "        dr,dc = mem['motion'].get(action,tuple(params['directions'][i]))",
  "        score = p[8]-i*p[9]",
  "        if agent is not None and goal is not None:",
  "            before = abs(agent[0]-goal[0])+abs(agent[1]-goal[1])",
  "            after = abs(agent[0]+dr-goal[0])+abs(agent[1]+dc-goal[1])",
  "            score += p[10]*(before-after)",
  "            nr = max(0,min(h-1,int(round(agent[0]+dr))))",
  "            nc = max(0,min(w-1,int(round(agent[1]+dc))))",
  "            pixel = int(frame[nr,nc])",
  "            if pixel == int(colours[2]):",
  "                score += p[11]",
  "            elif pixel == int(colours[3]):",
  "                score -= p[12]",
  "            if advanced:",
  "                score = p[13]-i*p[9]+p[14]*(before-after)",
  "                score += p[15] if action==route else 0",
  "                score -= p[16]*mem['positions'].get((nr,nc),0)",
  "                if pixel == int(colours[3]):",
  "                    score -= p[17]",
  "                score -= p[18]*max(0,mem['edges'].get((position,action,mem.get('control',0)),0)-p[19])",
  "        candidates.append((score,identity,action,0,0))",
  "    click = int(p[20])",
  "    if click in avail:",
  "        targets = []",
  "        if advanced:",
  "            panels = groups(frame == int(colours[4]))",
  "            for panel in panels:",
  "                r,c,area,r0,c0,r1,c1 = panel",
  "                if r1-r0 >= p[21] and c1-c0 >= p[21]:",
  "                    for fraction in params['fractions']:",
  "                        for other in params['fractions']:",
  "                            y = int(round(r0+(r1-r0)*fraction))",
  "                            x = int(round(c0+(c1-c0)*other))",
  "                            targets.append((x,y))",
  "        for colour in params['controls']:",
  "            for obj in groups(frame == int(colour)):",
  "                r,c,area,r0,c0,r1,c1 = obj",
  "                if c<w and area<=p[22] and (advanced or r>=p[23]):",
  "                    targets.append((int(round(c)),int(round(r))))",
  "        for x,y in set(targets):",
  "            identity = ('click',x,y)",
  "            score = p[24]+min(p[25],mem['stuck'])*p[26]",
  "            score += min(p[27],mem['effects'].get(identity,0))*p[28]",
  "            if advanced:",
  "                score = p[29]+min(p[25],mem['stuck'])*p[30]",
  "                if route is None:",
  "                    score += p[31]",
  "                score += min(p[27],mem['effects'].get(identity,0))*p[32]",
  "                score -= p[33]*mem['clicks'].get(identity,0)",
  "            candidates.append((score,identity,click,x,y))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score,identity,action,x,y in candidates:",
  "        failures = mem['failures'].get((signature,identity),0)",
  "        score -= p[34]*visits.get(identity,0)",
  "        score -= p[35]*max(0,failures-p[19])",
  "        if old is not None and identity==old[1]:",
  "            if signature != old[0]:",
  "                score += p[36]",
  "            elif advanced and failures <= p[19]:",
  "                score += p[37]",
  "        if score>bestscore:",
  "            bestscore = score",
  "            best = (identity,action,x,y)",
  "    if best is None:",
  "        best = (('fallback',avail[0]),avail[0],0,0)",
  "    identity,action,x,y = best",
  "    visits[identity] = visits.get(identity,0)+1",
  "    if identity[0]=='click':",
  "        mem['clicks'][identity] = mem['clicks'].get(identity,0)+1",
  "    mem['previous'] = (signature,identity,agent,frame.copy(),position)",
  "    return (action,max(0,min(frame.shape[1]-1,int(x))),max(0,min(frame.shape[0]-1,int(y))))"
 ],
