 "source_lines": [
  "def search(state, jumps, failed, visits, budget, goal, weights):",
  "    if state.bit_count() <= goal:",
  "        return []",
  "    if state in failed:",
  "        return None",
  "    if budget[0] <= 0:",
  "        return False",
  "    budget[0] -= 1",
  "    options = []",
  "    for a, b, c, take, put in jumps:",
  "        if state & take == take and state & put == 0:",
  "            nxt = (state ^ take) | put",
  "            mobility = 0",
  "            for aa, bb, cc, tt, pp in jumps:",
  "                if nxt & tt == tt and nxt & pp == 0:",
  "                    mobility += 1",
  "            value = weights[0] * visits.get(nxt, 0) - weights[1] * mobility",
  "            options.append((value, a, b, c, nxt))",
  "    options.sort()",
  "    incomplete = False",
  "    for value, a, b, c, nxt in options:",
  "        result = search(nxt, jumps, failed, visits, budget, goal, weights)",
  "        if result is False:",
  "            incomplete = True",
  "        elif result is not None:",
  "            return [(a, b, c, nxt)] + result",
  "    if incomplete:",
  "        return False",
  "    failed.add(state)",
  "    return None",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    base, peg, hint, click = int(p[0]), int(p[1]), int(p[2]), int(p[3])",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        points = np.argwhere((frame == base) | (frame == peg))",
  "        remaining = set((int(v[0]), int(v[1])) for v in points if int(v[0]) >= int(p[4]))",
  "        slots = []",
  "        while remaining:",
  "            seed = min(remaining)",
  "            remaining.remove(seed)",
  "            todo = [seed]",
  "            cells = []",
  "            while todo:",
  "                y, x = todo.pop()",
  "                cells.append((y, x))",
  "                for direction in params['directions']:",
  "                    q = (y + int(direction[0]), x + int(direction[1]))",
  "                    if q in remaining:",
  "                        remaining.remove(q)",
  "                        todo.append(q)",
  "            if int(p[5]) <= len(cells) <= int(p[6]):",
  "                ys = [v[0] for v in cells]",
  "                xs = [v[1] for v in cells]",
  "                slots.append(((min(xs) + max(xs)) // 2, (min(ys) + max(ys)) // 2))",
  "        slots.sort(key=lambda v: (v[1], v[0]))",
  "        mem['slots'] = slots",
  "        lookup = {v: i for i, v in enumerate(slots)}",
  "        gaps = []",
  "        for x, y in slots:",
  "            for xx, yy in slots:",
  "                if x == xx and y != yy:",
  "                    gaps.append(abs(y - yy))",
  "                if y == yy and x != xx:",
  "                    gaps.append(abs(x - xx))",
  "        gap = min(gaps) if gaps else 0",
  "        jumps = []",
  "        if gap > 0:",
  "            for a, position in enumerate(slots):",
  "                x, y = position",
  "                for direction in params['directions']:",
  "                    dy, dx = int(direction[0]) * gap, int(direction[1]) * gap",
  "                    middle = (x + dx, y + dy)",
  "                    end = (x + dx + dx, y + dy + dy)",
  "                    if middle in lookup and end in lookup:",
  "                        b, c = lookup[middle], lookup[end]",
  "                        jumps.append((a, b, c, (1 << a) | (1 << b), 1 << c))",
  "        mem['jumps'] = jumps",
  "        mem['failed'] = set()",
  "        mem['visits'] = {}",
  "        mem['pairs'] = {}",
  "        mem['effects'] = {}",
  "        mem['bad'] = set()",
  "        mem['plan'] = []",
  "        mem['phase'] = 0",
  "    slots = mem['slots']",
  "    if not slots or click not in avail:",
  "        for value in params['fallback']:",
  "            action = int(value)",
  "            if action in avail:",
  "                return (action, 0, 0)",
  "        return (avail[0], 0, 0)",
  "    state = 0",
  "    for i, position in enumerate(slots):",
  "        x, y = position",
  "        if int(frame[y, x]) == peg:",
  "            state |= 1 << i",
  "    visits = mem['visits']",
  "    if mem.get('observed') != state:",
  "        visits[state] = visits.get(state, 0) + 1",
  "        mem['observed'] = state",
  "    if 'last' in mem:",
  "        old, phase, a, b, c, expected = mem.pop('last')",
  "        if phase == 1:",
  "            mem['effects'][(old, a, c)] = state",
  "            if state == expected and state.bit_count() < old.bit_count():",
  "                if mem['plan'] and mem['plan'][0][:3] == (a, b, c):",
  "                    mem['plan'].pop(0)",
  "            else:",
  "                mem['plan'] = []",
  "                if state == old:",
  "                    mem['bad'].add((old, a, c))",
  "            mem['phase'] = 0",
  "        elif state != old:",
  "            mem['phase'] = 0",
  "            mem['plan'] = []",
  "    if mem['phase'] == 1 and mem['plan']:",
  "        a, b, c, expected = mem['plan'][0]",
  "        x, y = slots[c]",
  "        hints = [i for i, position in enumerate(slots) if int(frame[position[1], position[0]]) == hint]",
  "        if hints and c not in hints:",
  "            alternatives = []",
  "            for aa, bb, cc, take, put in mem['jumps']:",
  "                if aa == a and cc in hints and state & take == take and state & put == 0:",
  "                    nxt = (state ^ take) | put",
  "                    alternatives.append((visits.get(nxt, 0), aa, bb, cc, nxt))",
  "            if alternatives:",
  "                value, a, b, c, expected = min(alternatives)",
  "                mem['plan'] = [(a, b, c, expected)]",
  "                x, y = slots[c]",
  "        mem['last'] = (state, 1, a, b, c, expected)",
  "        mem['pairs'][(state, a, c)] = mem['pairs'].get((state, a, c), 0) + 1",
  "        return (click, x, y)",
  "    if not mem['plan']:",
  "        usable = [j for j in mem['jumps'] if (state, j[0], j[2]) not in mem['bad']]",
  "        budget = [max(1, int(p[7]) * int(p[8]))]",
  "        result = search(state, usable, mem['failed'], visits, budget, int(p[9]), params['ranking'])",
  "        if result is not None and result is not False:",
  "            mem['plan'] = result",
  "        if not mem['plan']:",
  "            options = []",
  "            for a, b, c, take, put in usable:",
  "                if state & take == take and state & put == 0:",
  "                    nxt = (state ^ take) | put",
  "                    mobility = 0",
  "                    for aa, bb, cc, tt, pp in mem['jumps']:",
  "                        if nxt & tt == tt and nxt & pp == 0:",
  "                            mobility += 1",
  "                    value = params['ranking'][0] * visits.get(nxt, 0)",
  "                    value += params['ranking'][2] * mem['pairs'].get((state, a, c), 0)",
  "                    value -= params['ranking'][1] * mobility",
  "                    if nxt in mem['failed']:",
  "                        value += params['ranking'][3]",
  "                    options.append((value, a, b, c, nxt))",
  "            if options:",
  "                value, a, b, c, nxt = min(options)",
  "                mem['plan'] = [(a, b, c, nxt)]",
  "    if mem['plan']:",
  "        a, b, c, expected = mem['plan'][0]",
  "        if state & (1 << a) and state & (1 << b) and state & (1 << c) == 0:",
  "            x, y = slots[a]",
  "            mem['phase'] = 1",
  "            mem['last'] = (state, 0, a, b, c, expected)",
  "            return (click, x, y)",
  "        mem['plan'] = []",
  "    probes = []",
  "    for i, position in enumerate(slots):",
  "        x, y = position",
  "        colour = int(frame[y, x])",
  "        value = float(params['colours'][colour])",
  "        value -= params['ranking'][2] * mem['pairs'].get((state, i, i), 0)",
  "        probes.append((value, i))",
  "    value, i = max(probes)",
  "    mem['pairs'][(state, i, i)] = mem['pairs'].get((state, i, i), 0) + 1",
  "    x, y = slots[i]",
  "    return (click, x, y)"
