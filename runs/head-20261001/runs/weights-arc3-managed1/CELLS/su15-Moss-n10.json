 "source_lines": [
  "def components(frame, lo, hi, excluded):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    result = []",
  "    for y in range(lo, hi):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c in excluded:",
  "                continue",
  "            pending = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while pending:",
  "                yy, xx = pending.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if lo <= ny < hi and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                        seen[ny, nx] = True",
  "                        pending.append((ny, nx))",
  "            xs = [v[1] for v in cells]",
  "            ys = [v[0] for v in cells]",
  "            result.append((c, int(round(sum(xs) / len(xs))), int(round(sum(ys) / len(ys))), len(cells), max(xs) - min(xs) + 1, max(ys) - min(ys) + 1))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    p = params['p']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if 'books' not in mem:",
  "        mem['books'] = {}",
  "    book = mem['books'].setdefault(level, {'tries': {}, 'blocked': {}, 'dead': {}, 'edges': {}, 'visits': {}, 'reach': {}})",
  "    if mem.get('level') != level:",
  "        mem['level'] = level",
  "        mem.pop('last', None)",
  "        mem.pop('pos', None)",
  "        mem['stall'] = 0",
  "    if mem.get('reset') != reset:",
  "        if 'last' in mem:",
  "            old, point, origin, mode, kind, signature = mem['last']",
  "            failure = (origin, mode, point)",
  "            book['dead'][failure] = book['dead'].get(failure, 0) + 1",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "        mem.pop('pos', None)",
  "        mem['stall'] = 0",
  "    top = max(0, min(frame.shape[0], int(p[0])))",
  "    bottom = max(top, min(frame.shape[0], int(p[1])))",
  "    excluded = [int(p[2]), int(p[3])]",
  "    body = components(frame, top, bottom, excluded)",
  "    head = components(frame, 0, top, excluded)",
  "    palette = {o[0]: (o[1], o[2]) for o in head if o[1] < p[4] and p[5] <= o[3] <= p[6] and o[4] == o[5]}",
  "    indicators = [o for o in head if o[1] >= p[4] and p[5] <= o[3] <= p[7] and o[4] == o[5]]",
  "    mode = max(indicators, key=lambda o: o[3])[0] if indicators else int(p[8])",
  "    goals = [o for o in body if o[0] == int(p[9]) and o[3] >= p[10]]",
  "    actors = [o for o in body if o[0] == mode and p[11] <= o[3] <= p[7] and o[4] == o[5] and o[3] == o[4] * o[5]]",
  "    signature = tuple(sorted(body))",
  "    if actors:",
  "        previous = mem.get('pos')",
  "        if previous is None:",
  "            actor = max(actors, key=lambda o: o[3])",
  "        else:",
  "            actor = min(actors, key=lambda o: (o[1] - previous[0]) ** 2 + (o[2] - previous[1]) ** 2)",
  "        pos = (actor[1], actor[2])",
  "    else:",
  "        pos = mem.get('pos', (int(p[12]), int(p[13])))",
  "    if 'last' in mem:",
  "        old, point, origin, oldmode, kind, oldsignature = mem['last']",
  "        pair = (old, point)",
  "        if signature == oldsignature and mode == oldmode:",
  "            book['blocked'][pair] = book['blocked'].get(pair, 0) + 1",
  "            mem['stall'] = mem.get('stall', 0) + 1",
  "        else:",
  "            mem['stall'] = 0",
  "            if kind == 0:",
  "                nearby = [o for o in actors if (o[1] - point[0]) ** 2 + (o[2] - point[1]) ** 2 <= p[14] ** 2]",
  "                if nearby:",
  "                    a = min(nearby, key=lambda o: (o[1] - point[0]) ** 2 + (o[2] - point[1]) ** 2)",
  "                    pos = (a[1], a[2])",
  "                elif any(o[0] == int(p[15]) and (o[1], o[2]) == origin for o in body):",
  "                    pos = point",
  "                if pos != origin:",
  "                    distance = ((pos[0] - origin[0]) ** 2 + (pos[1] - origin[1]) ** 2) ** 0.5",
  "                    book['reach'][oldmode] = max(book['reach'].get(oldmode, p[16]), distance)",
  "                    book['edges'][pair] = (pos, mode, signature)",
  "    mem['pos'] = pos",
  "    state = (pos, mode, signature)",
  "    book['visits'][state] = book['visits'].get(state, 0) + 1",
  "    if goals:",
  "        goal = max(goals, key=lambda o: o[3])",
  "        mem['goal'] = (goal[1], goal[2])",
  "    gx, gy = mem.get('goal', pos)",
  "    current = ((pos[0] - gx) ** 2 + (pos[1] - gy) ** 2) ** 0.5",
  "    candidates = {}",
  "    for o in body:",
  "        point = (o[1], o[2])",
  "        if o[3] <= p[17] or o in goals:",
  "            if point != pos:",
  "                candidates[point] = (o, 0)",
  "    for colour, point in palette.items():",
  "        if colour != mode:",
  "            candidates[point] = ((colour, point[0], point[1], 0, 0, 0), 1)",
  "    reach = book['reach'].get(mode, p[16])",
  "    scores = []",
  "    for point, item in candidates.items():",
  "        o, kind = item",
  "        pair = (state, point)",
  "        if book['blocked'].get(pair, 0) >= p[18]:",
  "            continue",
  "        d = ((point[0] - pos[0]) ** 2 + (point[1] - pos[1]) ** 2) ** 0.5",
  "        remaining = ((point[0] - gx) ** 2 + (point[1] - gy) ** 2) ** 0.5",
  "        if kind == 0:",
  "            score = p[19] * d + p[20] * remaining",
  "            if remaining >= current - p[21]:",
  "                score += p[22]",
  "            if d > reach:",
  "                score += p[23] * (d - reach)",
  "            if o[0] == int(p[15]):",
  "                score -= p[24]",
  "            score += p[25] * book['dead'].get((pos, mode, point), 0)",
  "        else:",
  "            score = p[26] - p[27] * mem.get('stall', 0)",
  "            moves = [v for q, v in candidates.items() if v[1] == 0 and v[0][0] == o[0]]",
  "            if moves:",
  "                score -= p[28]",
  "            score += p[25] * book['dead'].get((pos, mode, point), 0)",
  "        score += p[29] * book['tries'].get(pair, 0)",
  "        nxt = book['edges'].get(pair)",
  "        if nxt is not None:",
  "            score += p[30] * book['visits'].get(nxt, 0)",
  "        scores.append((score, point, kind))",
  "    if scores:",
  "        score, chosen, kind = min(scores)",
  "    else:",
  "        alternatives = [(book['tries'].get((state, (o[1], o[2])), 0), (o[1], o[2])) for o in body + head if o[3] <= p[17]]",
  "        chosen = min(alternatives)[1] if alternatives else (int(p[12]), int(p[13]))",
  "        kind = int(chosen[1] < top)",
  "    pair = (state, chosen)",
  "    book['tries'][pair] = book['tries'].get(pair, 0) + 1",
  "    mem['last'] = (state, chosen, pos, mode, kind, signature)",
  "    action = int(p[31])",
  "    if action not in avail:",
  "        action = avail[0]",
  "    return (action, max(0, min(frame.shape[1] - 1, chosen[0])), max(0, min(frame.shape[0] - 1, chosen[1])))"
 ],
