 "source_lines": [
  "def glyph(frame, y, x, size, colour):",
  "    return tuple(int(frame[y+r, x+c] == colour) for r in range(size) for c in range(size))",
  "",
  "def route(graph, start, target, actions):",
  "    queue = [(start, [])]",
  "    seen = {start}",
  "    frontier = None",
  "    for node, path in queue:",
  "        if node == target:",
  "            return path",
  "        edges = graph.get(node, {})",
  "        for action in actions:",
  "            if action not in edges and frontier is None:",
  "                frontier = path + [action]",
  "            if action in edges:",
  "                nxt = edges[action]",
  "                if nxt not in seen:",
  "                    seen.add(nxt)",
  "                    queue.append((nxt, path + [action]))",
  "    return frontier",
  "",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['geometry']",
  "    size = int(cfg[0])",
  "    count = int(cfg[1])",
  "    stride = int(cfg[2])",
  "    sx = int(cfg[3])",
  "    sy = int(cfg[4])",
  "    oy = int(cfg[5])",
  "    low = int(cfg[6])",
  "    high = int(cfg[7])",
  "    ink = int(params['colours'][0])",
  "    cursor_colour = int(params['colours'][1])",
  "    cycle = [int(v) for v in params['actions'][:2] if int(v) in avail]",
  "    moves = [int(v) for v in params['actions'][2:] if int(v) in avail]",
  "    level = info['levels']",
  "    stamp = (level, info['resets'])",
  "    if mem.get('stamp') != stamp:",
  "        mem.clear()",
  "        mem['stamp'] = stamp",
  "        mem['graph'] = {}",
  "        mem['used'] = {}",
  "        mem['probe'] = 0",
  "        mem['directions'] = {}",
  "    sources = [glyph(frame, sy, sx+i*stride, size, ink) for i in range(count)]",
  "    outputs = [glyph(frame, oy, sx+i*stride, size, ink) for i in range(count)]",
  "    pairs = []",
  "    for row in params['rows']:",
  "        for columns in params['columns']:",
  "            left = glyph(frame, int(row), int(columns[0]), size, ink)",
  "            right = glyph(frame, int(row), int(columns[1]), size, ink)",
  "            pairs.append((left, right))",
  "    targets = []",
  "    for source in sources:",
  "        best = None",
  "        distance = size*size + 1",
  "        for left, right in pairs:",
  "            d = sum(int(a != b) for a, b in zip(source, left))",
  "            if d < distance:",
  "                distance = d",
  "                best = right",
  "        targets.append(best)",
  "    points = np.argwhere(frame[low:high, :] == cursor_colour)",
  "    if len(points):",
  "        center = float(np.sum(points[:, 1])) / len(points)",
  "        cursor = int((center-sx-(size-1)/2)/stride + float(params['rounding'][0]))",
  "        cursor = max(0, min(count-1, cursor))",
  "    else:",
  "        cursor = mem.get('cursor', 0)",
  "    previous = mem.get('previous')",
  "    graph = mem['graph']",
  "    if previous is not None:",
  "        old_cursor, old_glyph, action, old_key = previous",
  "        if action in cycle and old_cursor == cursor:",
  "            graph.setdefault(old_glyph, {})[action] = outputs[cursor]",
  "        if action in moves and old_cursor != cursor:",
  "            delta = (cursor-old_cursor) % count",
  "            if delta == 1:",
  "                mem['directions'][action] = 1",
  "            elif delta == count-1:",
  "                mem['directions'][action] = -1",
  "    key = info['key']",
  "    used = mem['used'].setdefault(key, set())",
  "    action = None",
  "    probes = [int(v) for v in params['actions'] if int(v) in avail]",
  "    if mem['probe'] < len(probes):",
  "        action = probes[mem['probe']]",
  "        mem['probe'] += 1",
  "    else:",
  "        wrong = [i for i in range(count) if outputs[i] != targets[i]]",
  "        if cursor in wrong and cycle:",
  "            path = route(graph, outputs[cursor], targets[cursor], cycle)",
  "            if path:",
  "                action = path[0]",
  "            if action is None or action in used:",
  "                options = [a for a in cycle if a not in used]",
  "                if options:",
  "                    action = options[0]",
  "        elif wrong and moves:",
  "            best_cost = count + 1",
  "            for candidate in moves:",
  "                direction = mem['directions'].get(candidate, int(params['directions'][moves.index(candidate)]))",
  "                if direction == 0:",
  "                    continue",
  "                distance = min(((i-cursor)*direction) % count for i in wrong)",
  "                if distance < best_cost:",
  "                    best_cost = distance",
  "                    action = candidate",
  "    if action is None or action not in avail:",
  "        options = [a for a in probes if a not in used]",
  "        if options:",
  "            action = options[0]",
  "        elif probes:",
  "            action = probes[int(info['step']) % len(probes)]",
  "        else:",
  "            action = avail[0]",
  "    used.add(action)",
  "    mem['cursor'] = cursor",
  "    mem['previous'] = (cursor, outputs[cursor], action, key)",
  "    return (action, 0, 0)"
 ],
