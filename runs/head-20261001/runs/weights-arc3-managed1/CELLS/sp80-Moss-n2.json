 "source_lines": [
  "def groups(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    out = []",
  "    while remaining:",
  "        p = next(iter(remaining))",
  "        remaining.remove(p)",
  "        todo = [p]",
  "        cells = [p]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        rs = [p[0] for p in cells]",
  "        cs = [p[1] for p in cells]",
  "        out.append((sum(rs)/len(rs),sum(cs)/len(cs),min(rs),max(rs),min(cs),max(cs),len(cells)))",
  "    return out",
  "def act(params, mem, frame, avail, info):",
  "    c = params['config']",
  "    colours = params['colours']",
  "    actors = groups(frame == int(colours[0]))",
  "    actors.sort(key=lambda p: -p[6])",
  "    agent = actors[0] if actors else None",
  "    loads = groups((frame == int(colours[1])) | (frame == int(colours[2])))",
  "    loads.sort(key=lambda p: -p[6])",
  "    cargo = loads[0] if loads else None",
  "    goals = groups(frame == int(colours[3]))",
  "    goals.sort(key=lambda p: p[1])",
  "    fresh = mem.get('level') != info['levels'] or mem.get('reset') != info['resets']",
  "    if fresh:",
  "        trials = mem.get('trials', {})",
  "        level = info['levels']",
  "        trial = trials.get(level, 0)",
  "        trials[level] = trial + 1",
  "        motion = mem.get('motion', {})",
  "        effects = mem.get('effects', {})",
  "        winner = mem.get('winner', 0)",
  "        if mem.get('level', level) < level:",
  "            winner = mem.get('strategy', winner)",
  "        mem.clear()",
  "        mem['trials'] = trials",
  "        mem['motion'] = motion",
  "        mem['effects'] = effects",
  "        mem['winner'] = winner",
  "        mem['strategy'] = (trial + winner) % len(params['approaches'])",
  "        mem['level'] = level",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['phase'] = 0",
  "        mem['contact'] = 0",
  "        mem['age'] = 0",
  "        mem['offset'] = None",
  "        mem['start'] = cargo",
  "    signature = tuple(int(v) for v in frame[int(c[0]):int(c[1]), :].flatten())",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, identity, oa, oc = old",
  "        if signature == oldsig:",
  "            pair = (oldsig, identity)",
  "            mem['blocked'][pair] = mem['blocked'].get(pair, 0) + 1",
  "        else:",
  "            mem['effects'][identity] = mem['effects'].get(identity, 0) + 1",
  "        if identity[0] == 0 and agent is not None and oa is not None:",
  "            dr, dc = agent[0]-oa[0], agent[1]-oa[1]",
  "            if c[2] <= abs(dr)+abs(dc) <= c[3]:",
  "                mem['motion'][identity[1]] = (dr,dc)",
  "            if cargo is not None and oc is not None:",
  "                cr, cc = cargo[0]-oc[0], cargo[1]-oc[1]",
  "                if abs(cr)+abs(cc) >= c[2]:",
  "                    mem['phase'] = 1",
  "                    if abs(cr-dr)+abs(cc-dc) <= c[4]:",
  "                        mem['offset'] = (cargo[0]-agent[0],cargo[1]-agent[1])",
  "        if cargo is None and oc is not None and agent is not None:",
  "            mem['phase'] = 1",
  "            if mem['offset'] is None and oa is not None:",
  "                mem['offset'] = (oc[0]-oa[0],oc[1]-oa[1])",
  "    mem['age'] += 1",
  "    strategy = int(mem['strategy'])",
  "    approach = params['approaches'][strategy]",
  "    goal = goals[int(approach[2]) % len(goals)] if goals else None",
  "    target = None",
  "    if agent is not None:",
  "        ah = (agent[3]-agent[2])/2",
  "        aw = (agent[5]-agent[4])/2",
  "        if mem['phase'] == 0 and cargo is not None:",
  "            if abs(approach[0]) > 0:",
  "                tr = cargo[3]+c[5]+ah if approach[0] > 0 else cargo[2]-c[5]-ah",
  "                tc = cargo[1]",
  "            else:",
  "                tr = cargo[0]",
  "                tc = cargo[5]+c[5]+aw if approach[1] > 0 else cargo[4]-c[5]-aw",
  "            target = (max(c[0]+ah,min(c[1]-c[5]-ah,tr)),max(aw,min(frame.shape[1]-c[5]-aw,tc)))",
  "            distance = abs(agent[0]-target[0])+abs(agent[1]-target[1])",
  "            if distance <= c[6]:",
  "                mem['contact'] += 1",
  "            if mem['contact'] > c[7]:",
  "                target = (cargo[0],cargo[1])",
  "            if mem['contact'] > c[8]:",
  "                mem['phase'] = 1",
  "                mem['offset'] = (cargo[0]-agent[0],cargo[1]-agent[1])",
  "        if mem['phase'] == 1 and goal is not None:",
  "            offset = mem.get('offset')",
  "            if offset is None:",
  "                offset = (cargo[0]-agent[0],cargo[1]-agent[1]) if cargo is not None else (0,0)",
  "            target = (goal[2]+c[9]-offset[0],goal[1]-offset[1])",
  "            if cargo is not None and abs(cargo[1]-goal[1]) > c[10]:",
  "                target = (agent[0],goal[1]-offset[1])",
  "    visits = mem['visits'].setdefault(signature,{})",
  "    candidates = []",
  "    for i in range(len(params['order'])):",
  "        action = int(params['order'][i])",
  "        if action not in avail:",
  "            continue",
  "        identity = (0,action)",
  "        dr,dc = mem['motion'].get(action,(params['directions'][i][0],params['directions'][i][1]))",
  "        score = c[11]-i*c[12]",
  "        if agent is not None and target is not None:",
  "            before = abs(agent[0]-target[0])+abs(agent[1]-target[1])",
  "            after = abs(agent[0]+dr-target[0])+abs(agent[1]+dc-target[1])",
  "            score += c[13]*(before-after)",
  "            if agent[2]+dr < c[0] or agent[3]+dr >= c[1] or agent[4]+dc < 0 or agent[5]+dc >= frame.shape[1]:",
  "                score -= c[14]",
  "        if action == int(c[15]):",
  "            score = c[16]",
  "            if mem['contact'] > 0:",
  "                score += c[17]",
  "        score += min(c[18],mem['effects'].get(identity,0))*c[19]",
  "        candidates.append((score,identity,action,0,0))",
  "    if int(c[20]) in avail:",
  "        for colour in params['click_colours']:",
  "            for obj in groups(frame == int(colour)):",
  "                if obj[6] > c[21]:",
  "                    continue",
  "                r, x = int(round(obj[0])), int(round(obj[1]))",
  "                identity = (1,int(colour),r,x)",
  "                score = c[22]",
  "                if mem['contact'] > 0:",
  "                    score += c[23]",
  "                score += min(c[18],mem['effects'].get(identity,0))*c[24]",
  "                candidates.append((score,identity,int(c[20]),x,r))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score,identity,action,x,y in candidates:",
  "        score -= c[25]*visits.get(identity,0)",
  "        score -= c[26]*mem['blocked'].get((signature,identity),0)",
  "        if old is not None and identity == old[1] and signature != old[0]:",
  "            score += c[27]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity,action,x,y)",
  "    if best is None:",
  "        best = ((0,avail[0]),avail[0],0,0)",
  "    identity,action,x,y = best",
  "    visits[identity] = visits.get(identity,0)+1",
  "    mem['previous'] = (signature,identity,agent,cargo)",
  "    return (action,max(0,min(frame.shape[1]-1,int(x))),max(0,min(frame.shape[0]-1,int(y))))"
 ],
