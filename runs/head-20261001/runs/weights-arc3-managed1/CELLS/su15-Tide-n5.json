 "source_lines": [
  "def components(frame, top, bottom, excluded):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(top, bottom):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c in excluded:",
  "                continue",
  "            stack = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while stack:",
  "                yy, xx = stack.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if top <= ny < bottom and 0 <= nx < frame.shape[1]:",
  "                        if not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                            seen[ny, nx] = True",
  "                            stack.append((ny, nx))",
  "            n = len(cells)",
  "            out.append((c, int(round(sum(v[1] for v in cells) / n)), int(round(sum(v[0] for v in cells) / n)), n))",
  "    return out",
  "def act(params, mem, frame, avail, info):",
  "    p = params['policy']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['attempts'] = {}",
  "        mem['blocked'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['failures'] = {}",
  "    top = max(0, min(frame.shape[0], int(p[0])))",
  "    bottom = max(top, min(frame.shape[0], int(p[1])))",
  "    excluded = [int(p[2]), int(p[3])]",
  "    body = components(frame, top, bottom, excluded)",
  "    header = components(frame, 0, top, excluded)",
  "    state = tuple(sorted(body + header))",
  "    previous = mem.get('last')",
  "    if mem.get('reset') != reset:",
  "        if previous is not None:",
  "            old, point, origin = previous",
  "            pair = (old, point)",
  "            mem['failures'][pair] = mem['failures'].get(pair, 0) + 1",
  "        previous = None",
  "        mem.pop('origin', None)",
  "        mem['reset'] = reset",
  "    if previous is not None:",
  "        old, point, origin = previous",
  "        if old == state:",
  "            mem['blocked'][(state, point)] = True",
  "        else:",
  "            mem['edges'][(old, point)] = state",
  "    mem['visits'][state] = mem['visits'].get(state, 0) + 1",
  "    goals = [o for o in body if o[0] == int(p[4]) and o[3] >= p[5]]",
  "    if goals:",
  "        goal = max(goals, key=lambda o: o[3])",
  "        mem['goal'] = (goal[1], goal[2])",
  "    gx, gy = mem.get('goal', (int(p[6]), int(p[7])))",
  "    agents = [o for o in body if p[8] <= o[3] <= p[9] and o[0] != int(p[4])]",
  "    selected = [o for o in header if o[3] >= p[10]]",
  "    active = max(selected, key=lambda o: o[3])[0] if selected else None",
  "    matching = [o for o in agents if o[0] == active]",
  "    if matching:",
  "        agents = matching",
  "    if agents:",
  "        if 'origin' in mem:",
  "            ox, oy = mem['origin']",
  "            agent = min(agents, key=lambda o: (o[1] - ox) ** 2 + (o[2] - oy) ** 2)",
  "        else:",
  "            agent = max(agents, key=lambda o: o[3])",
  "        ax, ay = agent[1], agent[2]",
  "        mem['origin'] = (ax, ay)",
  "    else:",
  "        ax, ay = mem.get('origin', (gx, gy))",
  "    points = {}",
  "    colours = {}",
  "    for o in body:",
  "        if o[3] <= p[11] and (o[1], o[2]) != (ax, ay):",
  "            points[(o[1], o[2])] = 'body'",
  "            colours[o[0]] = colours.get(o[0], 0) + 1",
  "    for o in goals:",
  "        points[(o[1], o[2])] = 'goal'",
  "    for o in header:",
  "        if o[3] <= p[12]:",
  "            points[(o[1], o[2])] = o[0]",
  "    distance_goal = ((ax - gx) ** 2 + (ay - gy) ** 2) ** 0.5",
  "    scored = []",
  "    for point, kind in points.items():",
  "        if mem['blocked'].get((state, point), False):",
  "            continue",
  "        x, y = point",
  "        distance = ((x - ax) ** 2 + (y - ay) ** 2) ** 0.5",
  "        remaining = ((x - gx) ** 2 + (y - gy) ** 2) ** 0.5",
  "        if kind == 'body' or kind == 'goal':",
  "            score = p[13] * distance + p[14] * remaining",
  "            if remaining >= distance_goal - p[15]:",
  "                score += p[16]",
  "            if distance > p[17]:",
  "                score += p[18] * (distance - p[17])",
  "        else:",
  "            score = p[19] - p[20] * colours.get(kind, 0)",
  "            if kind == active:",
  "                score += p[21]",
  "            if not agents:",
  "                score -= p[22]",
  "        pair = (state, point)",
  "        score += p[23] * mem['attempts'].get(pair, 0)",
  "        score += p[24] * mem['failures'].get(pair, 0)",
  "        nxt = mem['edges'].get(pair)",
  "        if nxt is not None:",
  "            score += p[25] * mem['visits'].get(nxt, 0)",
  "        scored.append((score, point))",
  "    if scored:",
  "        scored.sort()",
  "        chosen = scored[0][1]",
  "    else:",
  "        visible = [(o[1], o[2]) for o in body + header]",
  "        chosen = min(visible, key=lambda q: mem['attempts'].get((state, q), 0)) if visible else (int(p[6]), int(p[7]))",
  "    mem['attempts'][(state, chosen)] = mem['attempts'].get((state, chosen), 0) + 1",
  "    mem['last'] = (state, chosen, (ax, ay))",
  "    action = int(p[26])",
  "    if action not in avail:",
  "        return (avail[0], 0, 0)",
  "    return (action, max(0, min(frame.shape[1] - 1, chosen[0])), max(0, min(frame.shape[0] - 1, chosen[1])))"
 ],
