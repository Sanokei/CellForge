 "source_lines": [
  "def components(frame, colour, diagonal=False):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = next(iter(remaining))",
  "        remaining.remove(start)",
  "        todo = [start]",
  "        group = [start]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            neighbours = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]",
  "            if diagonal:",
  "                neighbours += [(r - 1, c - 1), (r - 1, c + 1), (r + 1, c - 1), (r + 1, c + 1)]",
  "            for p in neighbours:",
  "                if p in remaining:",
  "                    remaining.remove(p)",
  "                    todo.append(p)",
  "                    group.append(p)",
  "        result.append((min(p[0] for p in group), min(p[1] for p in group), max(p[0] for p in group), max(p[1] for p in group), len(group)))",
  "    result.sort(key=lambda p: p[1])",
  "    return result",
  "def transition(state, action, board, motion, size):",
  "    result = []",
  "    for i in range(len(state)):",
  "        r, c = state[i]",
  "        dr, dc = motion[action][i]",
  "        rr, cc = r + dr, c + dc",
  "        if rr >= 0 and cc >= 0 and rr + size <= board.shape[0] and cc + size <= board.shape[1] and np.all(board[rr:rr + size, cc:cc + size]):",
  "            result.append((rr, cc))",
  "        else:",
  "            result.append((r, c))",
  "    return tuple(result)",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    order = [int(v) for v in params['order']]",
  "    blobs = components(frame, int(cfg[1]))",
  "    state = tuple((p[0], p[1]) for p in blobs)",
  "    level = info['levels']",
  "    if mem.get('level', -1) != level or mem.get('reset', -1) != info['resets']:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['edges'] = {}",
  "        mem['probes'] = []",
  "        mem['clicks'] = []",
  "        size = int(cfg[2])",
  "        if level > 0 and len(blobs) == 2:",
  "            size = min(blobs[0][2] - blobs[0][0] + 1, blobs[0][3] - blobs[0][1] + 1)",
  "        mem['size'] = max(1, size)",
  "        mem['motion'] = {}",
  "        for j in range(len(order)):",
  "            scale = mem['size'] / max(1, cfg[2])",
  "            mem['motion'][order[j]] = [(int(params['motion'][j][i][0] * scale), int(params['motion'][j][i][1] * scale)) for i in range(2)]",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old, action, oldkey, oldframe = previous",
  "        changed = int(np.sum(frame != oldframe))",
  "        mem['effects'] = mem.get('effects', {})",
  "        mem['effects'][(oldkey, action)] = changed",
  "        if len(old) == 2 and len(state) == 2:",
  "            mem['edges'][(old, action)] = state",
  "            if action in mem['motion']:",
  "                for i in range(2):",
  "                    dr, dc = state[i][0] - old[i][0], state[i][1] - old[i][1]",
  "                    if 0 < abs(dr) + abs(dc) <= cfg[3]:",
  "                        mem['motion'][action][i] = (dr, dc)",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    action = None",
  "    x, y = int(cfg[4]), int(cfg[4])",
  "    for candidate in order:",
  "        if candidate in avail and candidate not in mem['probes']:",
  "            mem['probes'].append(candidate)",
  "            action = candidate",
  "            break",
  "    click = int(cfg[5])",
  "    if action is None and click in avail:",
  "        targets = []",
  "        if level == 0:",
  "            targets = [(p[1] + int(cfg[6]), p[0] + int(cfg[6])) for p in blobs]",
  "        else:",
  "            for colour in (int(cfg[1]), int(cfg[7])):",
  "                for p in components(frame, colour, True):",
  "                    targets.append(((p[1] + p[3]) // 2, (p[0] + p[2]) // 2))",
  "        for index in range(len(targets)):",
  "            if index not in mem['clicks']:",
  "                mem['clicks'].append(index)",
  "                x, y = targets[index]",
  "                action = click",
  "                break",
  "    if action is None and len(state) == 2:",
  "        board = (frame == int(cfg[0])) | (frame == int(cfg[1]))",
  "        queue = [state]",
  "        first = {state: None}",
  "        depth = {state: 0}",
  "        cursor = 0",
  "        best = None",
  "        bestscore = -1000000000",
  "        limit = max(1, int(abs(cfg[8]))) * frame.shape[0]",
  "        while cursor < len(queue) and cursor < limit:",
  "            current = queue[cursor]",
  "            cursor += 1",
  "            distance = abs(current[0][0] - current[1][0]) + abs(current[0][1] - current[1][1])",
  "            if first[current] is not None:",
  "                score = -cfg[9] * distance - cfg[10] * depth[current] - cfg[11] * visits.get(current, 0)",
  "                if level == 0:",
  "                    score -= cfg[12] * (current[0][0] + current[1][0])",
  "                if score > bestscore:",
  "                    bestscore, best = score, first[current]",
  "                if distance <= cfg[13]:",
  "                    best = first[current]",
  "                    break",
  "            for candidate in order:",
  "                if candidate not in avail:",
  "                    continue",
  "                successor = transition(current, candidate, board, mem['motion'], mem['size'])",
  "                successor = mem['edges'].get((current, candidate), successor)",
  "                if successor == current or successor in first:",
  "                    continue",
  "                first[successor] = candidate if first[current] is None else first[current]",
  "                depth[successor] = depth[current] + 1",
  "                queue.append(successor)",
  "        action = best",
  "        if action is None:",
  "            lowest = 1000000000",
  "            for candidate in order:",
  "                if candidate in avail:",
  "                    successor = transition(state, candidate, board, mem['motion'], mem['size'])",
  "                    successor = mem['edges'].get((state, candidate), successor)",
  "                    cost = visits.get(successor, 0) + cfg[14] * (successor == state)",
  "                    count = mem.setdefault('attempts', {}).get((state, candidate), 0)",
  "                    cost += count",
  "                    if cost < lowest:",
  "                        lowest, action = cost, candidate",
  "    if action is None:",
  "        count = mem.get('fallback', 0)",
  "        mem['fallback'] = count + 1",
  "        legal = [a for a in order if a in avail]",
  "        action = legal[count % len(legal)] if legal else avail[0]",
  "    attempts = mem.setdefault('attempts', {})",
  "    attempts[(state, action)] = attempts.get((state, action), 0) + 1",
  "    mem['previous'] = (state, action, info['key'], frame.copy())",
  "    return (action, x, y)"
 ],
