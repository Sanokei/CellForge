 "source_lines": [
  "def regions(frame, colour):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    result = []",
  "    for yy, xx in np.argwhere(frame == colour):",
  "        y, x = int(yy), int(xx)",
  "        if seen[y, x]:",
  "            continue",
  "        todo = [(y, x)]",
  "        seen[y, x] = True",
  "        cells = []",
  "        while todo:",
  "            y, x = todo.pop()",
  "            cells.append((y, x))",
  "            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:",
  "                ny, nx = y + dy, x + dx",
  "                if 0 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == colour:",
  "                    seen[ny, nx] = True",
  "                    todo.append((ny, nx))",
  "        xs = [v[1] for v in cells]",
  "        ys = [v[0] for v in cells]",
  "        result.append((min(xs), min(ys), max(xs), max(ys), len(cells)))",
  "    return result",
  "def signature(frame, slots):",
  "    return tuple(int(frame[y, x]) for x, y in slots)",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    fresh = mem.get('level') != level or mem.get('reset') != reset",
  "    if fresh:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['pairs'] = {}",
  "        mem['uses'] = {}",
  "        mem['useful'] = {}",
  "        mem['idle'] = {}",
  "        mem['motion'] = {}",
  "        mem['actions'] = []",
  "        mem['slots'] = []",
  "        mem['tested'] = {}",
  "        mem['counter'] = 0",
  "        borders = regions(frame, int(p[0]))",
  "        boxes = [o for o in borders if o[2] - o[0] >= p[1] and o[3] - o[1] >= p[2]]",
  "        if boxes:",
  "            box = max(boxes, key=lambda o: (o[2] - o[0]) * (o[3] - o[1]))",
  "            x0, y0, x1, y1, area = box",
  "            mem['box'] = box",
  "            step = max(1, int(p[3]))",
  "            for y in range(y0 + 1, y1, step):",
  "                for x in range(x0 + 1, x1, step):",
  "                    mem['slots'].append((x, y))",
  "            row_counts = []",
  "            for y in range(y0 + 1, y1):",
  "                count = int(np.sum(frame[y, x0 + 1:x1] == int(p[4])))",
  "                row_counts.append((count, y))",
  "            row_counts.sort(reverse=True)",
  "            if row_counts and row_counts[0][0] > 0:",
  "                cy = row_counts[0][1]",
  "                runs = []",
  "                start = None",
  "                for x in range(x0 + 1, x1 + 1):",
  "                    marked = x < x1 and int(frame[cy, x]) in [int(p[4]), int(p[5])]",
  "                    if marked and start is None:",
  "                        start = x",
  "                    if not marked and start is not None:",
  "                        if x - start <= p[6]:",
  "                            runs.append(((start + x - 1) // 2, cy))",
  "                        start = None",
  "                mem['actions'].extend(runs)",
  "        for colour in range(len(params['click_colours'])):",
  "            if params['click_colours'][colour] <= 0:",
  "                continue",
  "            for o in regions(frame, colour):",
  "                x0, y0, x1, y1, area = o",
  "                if p[7] <= area <= p[8] and x1 - x0 <= p[9] and y1 - y0 <= p[9]:",
  "                    point = ((x0 + x1) // 2, (y0 + y1) // 2)",
  "                    if point not in mem['actions']:",
  "                        mem['actions'].append(point)",
  "        mem['primary'] = len(mem['actions'])",
  "        if 'box' in mem:",
  "            x0, y0, x1, y1, area = mem['box']",
  "            step = max(1, int(p[3]))",
  "            for y in range(y0 + step // 2 + 1, y1, step):",
  "                for x in range(x0 + step // 2 + 1, x1, step):",
  "                    point = (x, y)",
  "                    if point not in mem['actions']:",
  "                        mem['actions'].append(point)",
  "        if not mem['actions']:",
  "            mem['actions'] = [(int(p[10]), int(p[11]))]",
  "        if not mem['slots']:",
  "            stride = max(1, int(p[12]))",
  "            mem['slots'] = [(x, y) for y in range(0, frame.shape[0], stride) for x in range(0, frame.shape[1], stride)]",
  "    actions = mem['actions']",
  "    objects = regions(frame, int(p[13]))",
  "    objects.sort(key=lambda o: o[4])",
  "    location = None",
  "    target = None",
  "    if len(objects) >= 2:",
  "        small = objects[0]",
  "        large = objects[-1]",
  "        target = ((small[0] + small[2]) / 2, (small[1] + small[3]) / 2)",
  "        location = ((large[0] + large[2]) / 2, (large[1] + large[3]) / 2)",
  "    key = info.get('key', '')",
  "    board = signature(frame, mem['slots'])",
  "    state = (key, board)",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    edges = mem['edges']",
  "    pairs = mem['pairs']",
  "    if 'last' in mem:",
  "        old, a, old_location, old_target = mem['last']",
  "        edges[(old, a)] = state",
  "        changed = int(np.sum(frame != mem['previous']))",
  "        if changed == 0:",
  "            mem['idle'][a] = mem['idle'].get(a, 0) + 1",
  "        else:",
  "            mem['useful'][a] = mem['useful'].get(a, 0) + 1",
  "        if location is not None and old_location is not None:",
  "            dx, dy = location[0] - old_location[0], location[1] - old_location[1]",
  "            if abs(dx) + abs(dy) > 0:",
  "                samples = mem['motion'].setdefault(a, [])",
  "                samples.append((dx, dy))",
  "                if len(samples) > int(p[14]):",
  "                    samples.pop(0)",
  "        if changed > 0 and 'box' in mem:",
  "            box = mem['box']",
  "            for colour in range(len(params['click_colours'])):",
  "                if params['click_colours'][colour] <= 0:",
  "                    continue",
  "                for o in regions(frame, colour):",
  "                    x0, y0, x1, y1, area = o",
  "                    if p[7] <= area <= p[8] and x1 - x0 <= p[9] and y1 - y0 <= p[9] and y0 > box[3]:",
  "                        point = ((x0 + x1) // 2, (y0 + y1) // 2)",
  "                        if point not in actions:",
  "                            actions.append(point)",
  "    mem['counter'] += 1",
  "    primary = max(1, mem['primary'])",
  "    candidates = []",
  "    for a in range(len(actions)):",
  "        used = pairs.get((state, a), 0)",
  "        useful = mem['useful'].get(a, 0)",
  "        idle = mem['idle'].get(a, 0)",
  "        known = edges.get((state, a))",
  "        value = p[15] * used + p[16] * idle / (1 + useful) + p[17] * mem['uses'].get(a, 0)",
  "        if a >= primary:",
  "            value += p[18]",
  "        if known is not None:",
  "            value += p[19] * visits.get(known, 0)",
  "        if location is not None and target is not None and a in mem['motion']:",
  "            samples = mem['motion'][a]",
  "            dx = sum(v[0] for v in samples) / len(samples)",
  "            dy = sum(v[1] for v in samples) / len(samples)",
  "            before = abs(location[0] - target[0]) + abs(location[1] - target[1])",
  "            after = abs(location[0] + dx - target[0]) + abs(location[1] + dy - target[1])",
  "            value += p[20] * (after - before)",
  "        value += params['order'][a % len(params['order'])]",
  "        candidates.append((value, a))",
  "    candidates.sort()",
  "    chosen = candidates[0][1]",
  "    local_tried = all(pairs.get((state, a), 0) > 0 for a in range(primary))",
  "    if local_tried:",
  "        queue = [state]",
  "        parents = {state: None}",
  "        head = 0",
  "        found = None",
  "        while head < len(queue) and len(queue) < int(p[21]):",
  "            node = queue[head]",
  "            head += 1",
  "            frontier = [a for a in range(primary) if pairs.get((node, a), 0) == 0 and mem['idle'].get(a, 0) <= p[22] + mem['useful'].get(a, 0)]",
  "            if node != state and frontier:",
  "                found = node",
  "                break",
  "            order = sorted(range(len(actions)), key=lambda a: (mem['idle'].get(a, 0), mem['uses'].get(a, 0), a))",
  "            for a in order:",
  "                nxt = edges.get((node, a))",
  "                if nxt is not None and nxt != node and nxt not in parents:",
  "                    parents[nxt] = (node, a)",
  "                    queue.append(nxt)",
  "        if found is not None:",
  "            while parents[found][0] != state:",
  "                found = parents[found][0]",
  "            chosen = parents[found][1]",
  "    pairs[(state, chosen)] = pairs.get((state, chosen), 0) + 1",
  "    mem['uses'][chosen] = mem['uses'].get(chosen, 0) + 1",
  "    mem['last'] = (state, chosen, location, target)",
  "    mem['previous'] = frame.copy()",
  "    x, y = actions[chosen]",
  "    action = int(p[23])",
  "    if action not in avail:",
  "        action = avail[0]",
  "    return (action, max(0, min(frame.shape[1] - 1, int(x))), max(0, min(frame.shape[0] - 1, int(y))))"
 ],
