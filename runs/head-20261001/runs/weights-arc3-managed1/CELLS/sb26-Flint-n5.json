{
 "game": "sb26",
 "house": "Flint",
 "n": 5,
 "source_lines": [
  "def components(frame, colour):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))",
  "    result = []",
  "    while remaining:",
  "        start = min(remaining)",
  "        remaining.remove(start)",
  "        todo = [start]",
  "        group = [start]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for point in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):",
  "                if point in remaining:",
  "                    remaining.remove(point)",
  "                    todo.append(point)",
  "                    group.append(point)",
  "        r = sum(p[0] for p in group) / len(group)",
  "        c = sum(p[1] for p in group) / len(group)",
  "        pixel = min(group, key=lambda p: abs(p[0]-r)+abs(p[1]-c))",
  "        result.append((r,c,pixel[0],pixel[1],len(group)))",
  "    return sorted(result, key=lambda p:p[1])",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    click = int(cfg[0])",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        learned = mem.get('learned', {})",
  "        mem.clear()",
  "        mem['learned'] = learned",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['pairs'] = {}",
  "        mem['slots'] = []",
  "        for obj in components(frame, int(cfg[1])):",
  "            if cfg[2] < obj[0] < cfg[3] and obj[4] <= cfg[4]:",
  "                mem['slots'].append((int(round(obj[0])),int(round(obj[1]))))",
  "        refs = []",
  "        palette = [int(v) for v in params['colours']]",
  "        if level > 0:",
  "            palette = []",
  "            for colour in range(len(params['palette'])):",
  "                if params['palette'][colour] > 0:",
  "                    if any(obj[0] < cfg[5] for obj in components(frame,colour)):",
  "                        palette.append(colour)",
  "        for colour in palette:",
  "            for obj in components(frame,colour):",
  "                if obj[0] < cfg[5]:",
  "                    refs.append((obj[1],colour))",
  "        refs.sort()",
  "        mem['targets'] = [p[1] for p in refs]",
  "        mem['palette'] = palette",
  "    slots = mem['slots']",
  "    targets = mem['targets']",
  "    colours = mem['palette']",
  "    values = tuple(int(frame[r,c]) for r,c in slots)",
  "    if level == 0:",
  "        signature = tuple(int(v) for v in frame[:int(cfg[3]),:].flatten())",
  "    else:",
  "        signature = tuple(int(v) for v in frame[:int(params['adaptive'][0]),:].flatten()) + tuple(int(v) for v in frame[int(params['adaptive'][1]):,:].flatten())",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        oldsig, identity, oldvalues = old",
  "        if oldsig == signature:",
  "            pair = (oldsig,identity)",
  "            mem['blocked'][pair] = mem['blocked'].get(pair,0)+1",
  "        elif values != oldvalues:",
  "            changes = [i for i in range(len(values)) if values[i] != oldvalues[i]]",
  "            mem['learned'][identity] = tuple((i,values[i]) for i in changes)",
  "    visits = mem['visits'].setdefault(signature,{})",
  "    mismatch = [i for i in range(min(len(slots),len(targets))) if values[i] != targets[i]]",
  "    focus = mismatch[0] if mismatch else 0",
  "    desired = targets[focus] if focus < len(targets) else (colours[0] if colours else int(cfg[1]))",
  "    candidates = []",
  "    if click in avail:",
  "        for i in range(len(slots)):",
  "            r,c = slots[i]",
  "            score = cfg[6] if i == focus else cfg[7]",
  "            if i < len(targets) and values[i] == targets[i]:",
  "                score -= cfg[8]",
  "            candidates.append((score,('slot',i),click,c,r))",
  "        for colour in colours:",
  "            for obj in components(frame,colour):",
  "                r,c,pr,pc,area = obj",
  "                region = 0 if r < cfg[5] else 1 if r > cfg[9] else 2",
  "                score = cfg[10] if colour == desired else cfg[11]",
  "                if region == 1:",
  "                    score += cfg[12]",
  "                if region == 2:",
  "                    score -= cfg[13]",
  "                candidates.append((score,('colour',colour,region,int(c)),click,pc,pr))",
  "                if int(round(r)) != pr or int(round(c)) != pc:",
  "                    candidates.append((score-cfg[14],('centre',colour,region,int(c)),click,int(round(c)),int(round(r))))",
  "        for colour in params['explore']:",
  "            for obj in components(frame,int(colour)):",
  "                if cfg[2] < obj[0] < cfg[3] and obj[4] <= cfg[15]:",
  "                    candidates.append((cfg[16],('object',int(colour),int(obj[0]),int(obj[1])),click,obj[3],obj[2]))",
  "    for i in range(len(params['order'])):",
  "        action = int(params['order'][i])",
  "        if action in avail:",
  "            score = cfg[17]-i*cfg[18]",
  "            if slots and not mismatch:",
  "                score += cfg[19]",
  "            candidates.append((score,('key',action),action,0,0))",
  "    if level > 0:",
  "        ad = params['adaptive']",
  "        pending = mem.pop('pending',None)",
  "        if pending is not None and click in avail:",
  "            origin,source,dest,startvalues = pending",
  "            r,c = dest",
  "            identity = ('finish',source,dest)",
  "            mem['macro'] = (origin,source,dest,startvalues)",
  "            mem['previous'] = (signature,identity,values)",
  "            return (click,c,r)",
  "        macro = mem.pop('macro',None)",
  "        if macro is not None:",
  "            origin,source,dest,startvalues = macro",
  "            pair = (origin,source,dest)",
  "            record = mem['pairs'].setdefault(pair,[0,0])",
  "            record[0] += 1",
  "            record[1] += int(values != startvalues)",
  "        sources = []",
  "        destinations = list(slots)",
  "        for colour in colours:",
  "            for obj in components(frame,colour):",
  "                r,c,pr,pc,area = obj",
  "                if r > cfg[5] and area <= ad[2]:",
  "                    sources.append((colour,pr,pc))",
  "        for r,c in slots:",
  "            colour = int(frame[r,c])",
  "            if colour in colours:",
  "                sources.append((colour,r,c))",
  "        bestpair = None",
  "        pairscore = -1000000",
  "        if click in avail:",
  "            for colour,sr,sc in sources:",
  "                source = (sr,sc)",
  "                for i in range(len(destinations)):",
  "                    dest = destinations[i]",
  "                    if source == dest:",
  "                        continue",
  "                    record = mem['pairs'].get((signature,source,dest),[0,0])",
  "                    score = ad[3] - ad[4]*record[0]",
  "                    if i < len(targets):",
  "                        if colour == targets[i] and values[i] != targets[i]:",
  "                            score += ad[5]",
  "                        if values[i] == targets[i]:",
  "                            score -= ad[6]",
  "                    if sr > cfg[9]:",
  "                        score += ad[7]",
  "                    score -= ad[8]*mem['blocked'].get((signature,('source',source,dest)),0)",
  "                    if score > pairscore:",
  "                        pairscore = score",
  "                        bestpair = (source,dest)",
  "        if bestpair is not None and (mismatch or not slots) and pairscore > ad[9]:",
  "            source,dest = bestpair",
  "            mem['pending'] = (signature,source,dest,values)",
  "            identity = ('source',source,dest)",
  "            mem['previous'] = (signature,identity,values)",
  "            return (click,source[1],source[0])",
  "        filtered = []",
  "        for score,identity,action,x,y in candidates:",
  "            if mem['blocked'].get((signature,identity),0) == 0:",
  "                if identity[0] == 'key':",
  "                    score += ad[10]",
  "                filtered.append((score,identity,action,x,y))",
  "        if filtered:",
  "            candidates = filtered",
  "        else:",
  "            candidates = []",
  "            if click in avail:",
  "                for obj in components(frame,int(cfg[1])):",
  "                    if obj[4] <= cfg[4]:",
  "                        identity = ('fresh',obj[2],obj[3])",
  "                        if mem['blocked'].get((signature,identity),0) == 0:",
  "                            candidates.append((ad[11],identity,click,obj[3],obj[2]))",
  "            for action in avail:",
  "                if action != click:",
  "                    candidates.append((ad[9],('key',action),action,0,0))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score,identity,action,x,y in candidates:",
  "        score -= cfg[20]*visits.get(identity,0)",
  "        score -= cfg[21]*mem['blocked'].get((signature,identity),0)",
  "        for i,colour in mem['learned'].get(identity,()):",
  "            if i < len(targets):",
  "                score += cfg[22] if colour == targets[i] else -cfg[23]",
  "        if old is not None:",
  "            previous = old[1]",
  "            if previous[0] in ('colour','centre') and identity[0] == 'slot' and identity[1] == focus:",
  "                score += cfg[24]",
  "            if previous[0] == 'slot' and identity[0] == 'colour' and identity[1] == desired:",
  "                score += cfg[25]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity,action,x,y)",
  "    if best is None:",
  "        best = (('fallback',avail[0]),avail[0],0,0)",
  "    identity,action,x,y = best",
  "    visits[identity] = visits.get(identity,0)+1",
  "    mem['previous'] = (signature,identity,values)",
  "    return (action,max(0,min(frame.shape[1]-1,int(x))),max(0,min(frame.shape[0]-1,int(y))))"
 ],
