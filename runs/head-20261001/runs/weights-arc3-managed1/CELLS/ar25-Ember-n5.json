 "source_lines": [
  "def opening(params, mem, frame, avail, info):",
  "    cfg = params['cfg']",
  "    moves = params['moves']",
  "    w = params['weights']",
  "    level = info['levels']",
  "    if mem.get('level') != level or mem.get('reset') != info['resets']:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = info['resets']",
  "        mem['effects'] = {}",
  "        mem['visits'] = {}",
  "        mem['tried'] = {}",
  "    edge = int(cfg[3])",
  "    points = np.argwhere(frame == int(cfg[0]))",
  "    points = points[(points[:, 0] < edge) & (points[:, 1] < edge)]",
  "    mode = int(cfg[0])",
  "    if len(points) == 0:",
  "        mode = int(cfg[2])",
  "        points = np.argwhere(frame == mode)",
  "        points = points[(points[:, 0] < edge) & (points[:, 1] < edge)]",
  "    pixels = np.argwhere(frame == int(cfg[1]))",
  "    pixels = pixels[(pixels[:, 0] < edge) & (pixels[:, 1] < edge)]",
  "    remaining = set(tuple(p) for p in pixels.tolist())",
  "    goals = []",
  "    while remaining:",
  "        seed = remaining.pop()",
  "        component = [seed]",
  "        queue = [seed]",
  "        head = 0",
  "        while head < len(queue):",
  "            y, x = queue[head]",
  "            head += 1",
  "            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:",
  "                neighbour = (y + dy, x + dx)",
  "                if neighbour in remaining:",
  "                    remaining.remove(neighbour)",
  "                    queue.append(neighbour)",
  "                    component.append(neighbour)",
  "        if len(component) >= cfg[4]:",
  "            goals.append(np.array(component))",
  "    if len(goals) > 0:",
  "        mem['goals'] = goals",
  "    else:",
  "        goals = mem.get('goals', [])",
  "    if len(points) == 0:",
  "        for row in moves:",
  "            if int(row[0]) in avail:",
  "                return (int(row[0]), 0, 0)",
  "        return (avail[0], 0, 0)",
  "    centre = np.sum(points, axis=0) / len(points)",
  "    previous = mem.get('centre')",
  "    last = mem.get('last')",
  "    if previous is not None and last is not None and mem.get('mode') == mode:",
  "        delta = centre - previous",
  "        magnitude = np.sum(np.abs(delta))",
  "        if magnitude > cfg[5] and magnitude < cfg[6]:",
  "            token = (mode, last)",
  "            old = mem['effects'].get(token)",
  "            if old is None:",
  "                mem['effects'][token] = delta.copy()",
  "            else:",
  "                mem['effects'][token] = old * w[0] + delta * (1 - w[0])",
  "        if magnitude < cfg[5]:",
  "            oldstate = mem.get('state')",
  "            if oldstate is not None:",
  "                blocked = mem['tried'].setdefault(oldstate, {})",
  "                blocked[last] = blocked.get(last, 0) + w[1]",
  "    state = (mode, tuple(np.sum(points, axis=0).tolist()), len(points))",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    tried = mem['tried'].setdefault(state, {})",
  "    candidates = []",
  "    for index in range(len(moves)):",
  "        row = moves[index]",
  "        action = int(row[0])",
  "        if action not in avail:",
  "            continue",
  "        delta = row[1:3].copy()",
  "        if mode == int(cfg[2]):",
  "            delta[1] = -delta[1]",
  "        delta = mem['effects'].get((mode, action), delta)",
  "        shifted = points + delta.astype(int)",
  "        nextstate = (mode, tuple(np.sum(shifted, axis=0).tolist()), len(points))",
  "        score = w[2] * visits.get(nextstate, 0) + w[3] * tried.get(action, 0) + w[4] * index",
  "        invalid = np.sum((shifted[:, 0] < 0) | (shifted[:, 0] >= edge) | (shifted[:, 1] < 0) | (shifted[:, 1] >= edge))",
  "        score += w[5] * invalid",
  "        best = None",
  "        for goal in goals:",
  "            gc = np.sum(goal, axis=0) / len(goal)",
  "            distance = np.sum(np.abs(centre + delta - gc))",
  "            targetset = set(tuple(p) for p in goal.tolist())",
  "            overlap = 0",
  "            for pixel in shifted.tolist():",
  "                if tuple(pixel) in targetset:",
  "                    overlap += 1",
  "            value = w[6] * distance - w[7] * overlap + w[8] * abs(len(goal) - len(points))",
  "            if best is None or value < best:",
  "                best = value",
  "        if best is not None:",
  "            score += best",
  "        candidates.append([score, action])",
  "    if int(cfg[7]) in avail and visits[state] > cfg[8]:",
  "        candidates.append([w[9] + w[3] * tried.get(int(cfg[7]), 0), int(cfg[7])])",
  "    if len(candidates) == 0:",
  "        action = avail[0]",
  "    else:",
  "        candidates.sort()",
  "        action = candidates[0][1]",
  "    tried[action] = tried.get(action, 0) + 1",
  "    mem['centre'] = centre.copy()",
  "    mem['mode'] = mode",
  "    mem['last'] = action",
  "    mem['state'] = state",
  "    return (action, 0, 0)",
  "def components(frame, colour, edge, minimum):",
  "    pixels = np.argwhere(frame[:edge, :edge] == colour)",
  "    remaining = set(tuple(p) for p in pixels.tolist())",
  "    result = []",
  "    while remaining:",
  "        seed = min(remaining)",
  "        remaining.remove(seed)",
  "        queue = [seed]",
  "        head = 0",
  "        while head < len(queue):",
  "            y, x = queue[head]",
  "            head += 1",
  "            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:",
  "                neighbour = (y + dy, x + dx)",
  "                if neighbour in remaining:",
  "                    remaining.remove(neighbour)",
  "                    queue.append(neighbour)",
  "        if len(queue) >= minimum:",
  "            result.append(np.array(queue))",
  "    return result",
  "def fit(points, goals, delta, edge, weights):",
  "    if len(points) == 0 or len(goals) == 0:",
  "        return weights[5]",
  "    shifted = points + delta",
  "    distances = np.sum(np.abs(shifted[:, None, :] - goals[None, :, :]), axis=2)",
  "    forward = np.sum(np.min(distances, axis=1)) / len(points)",
  "    backward = np.sum(np.min(distances, axis=0)) / len(goals)",
  "    invalid = np.sum((shifted[:, 0] < 0) | (shifted[:, 0] >= edge) | (shifted[:, 1] < 0) | (shifted[:, 1] >= edge))",
  "    return weights[0] * forward + weights[1] * backward + weights[2] * invalid",
  "def act(params, mem, frame, avail, info):",
  "    if info['levels'] == 0:",
  "        return opening(params, mem, frame, avail, info)",
  "    cfg = params['search']",
  "    w = params['search_weights']",
  "    directions = params['directions']",
  "    edge = int(cfg[3])",
  "    fresh = mem.get('level') != info['levels'] or mem.get('reset') != info['resets']",
  "    if fresh:",
  "        mem.clear()",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['graph'] = {}",
  "        mem['tried'] = {}",
  "        mem['visits'] = {}",
  "        mem['effects'] = {}",
  "        mem['outcomes'] = []",
  "        mem['probe'] = 0",
  "        mem['clicks'] = []",
  "        mem['click_index'] = 0",
  "        target_components = components(frame, int(cfg[1]), edge, cfg[4])",
  "        if len(target_components) > 0:",
  "            mem['goals'] = np.concatenate(target_components, axis=0)",
  "        else:",
  "            mem['goals'] = np.zeros((0, 2))",
  "        for colour in [int(cfg[0]), int(cfg[1]), int(cfg[2]), int(cfg[5])]:",
  "            for component in components(frame, colour, edge, cfg[4]):",
  "                centre = np.sum(component, axis=0) / len(component)",
  "                nearest = int(np.argmin(np.sum(np.abs(component - centre), axis=1)))",
  "                y, x = component[nearest].tolist()",
  "                mem['clicks'].append((int(cfg[6]), int(x), int(y)))",
  "    points = np.argwhere(frame[:edge, :edge] == int(cfg[0]))",
  "    mode = int(cfg[0])",
  "    if len(points) == 0:",
  "        mode = int(cfg[2])",
  "        points = np.argwhere(frame[:edge, :edge] == mode)",
  "    state = tuple(frame[:edge, :edge].reshape(-1).tolist())",
  "    graph = mem['graph']",
  "    tried = mem['tried']",
  "    visits = mem['visits']",
  "    graph.setdefault(state, {})",
  "    tried.setdefault(state, set())",
  "    visits[state] = visits.get(state, 0) + 1",
  "    centre = np.sum(points, axis=0) / max(1, len(points))",
  "    previous_state = mem.get('state')",
  "    previous_action = mem.get('last')",
  "    if previous_state is not None:",
  "        graph.setdefault(previous_state, {})[previous_action] = state",
  "        changed = previous_state != state",
  "        mem['outcomes'].append((previous_action, changed, len(points)))",
  "        if len(mem['outcomes']) > int(cfg[9]):",
  "            mem['outcomes'].pop(0)",
  "        if changed and mem.get('mode') == mode and mem.get('count') == len(points):",
  "            delta = centre - mem['centre']",
  "            magnitude = np.sum(np.abs(delta))",
  "            if magnitude > cfg[7] and magnitude < cfg[8]:",
  "                mem['effects'][(mode, previous_action[0])] = delta.copy()",
  "    actions = []",
  "    for row in directions:",
  "        action = int(row[0])",
  "        if action in avail:",
  "            actions.append((action, 0, 0))",
  "    choice = None",
  "    while mem['probe'] < len(directions) and choice is None:",
  "        index = mem['probe']",
  "        mem['probe'] = index + 1",
  "        action = int(directions[index, 0])",
  "        token = (action, 0, 0)",
  "        if action in avail and token not in tried[state]:",
  "            choice = token",
  "    if choice is None and int(cfg[6]) in avail:",
  "        while mem['click_index'] < len(mem['clicks']) and choice is None:",
  "            index = mem['click_index']",
  "            mem['click_index'] = index + 1",
  "            token = mem['clicks'][index]",
  "            if token not in tried[state]:",
  "                choice = token",
  "    if choice is None:",
  "        candidates = []",
  "        for index in range(len(directions)):",
  "            row = directions[index]",
  "            token = (int(row[0]), 0, 0)",
  "            if token not in actions or token in tried[state]:",
  "                continue",
  "            delta = row[1:3].copy()",
  "            if mode == int(cfg[2]):",
  "                delta[1] = -delta[1]",
  "            delta = mem['effects'].get((mode, token[0]), delta)",
  "            score = fit(points, mem['goals'], delta, edge, w) + w[3] * index",
  "            shifted = points + delta.astype(int)",
  "            predicted = tuple(shifted.reshape(-1).tolist())",
  "            score += w[4] * mem.setdefault('positions', {}).get((mode, predicted), 0)",
  "            candidates.append((score, token))",
  "        if len(candidates) > 0:",
  "            candidates.sort()",
  "            choice = candidates[0][1]",
  "    if choice is None:",
  "        queue = [(state, None)]",
  "        seen = set([state])",
  "        head = 0",
  "        frontier = []",
  "        depth = {state: 0}",
  "        while head < len(queue) and head < int(cfg[10]):",
  "            node, first = queue[head]",
  "            head += 1",
  "            if node != state:",
  "                pending = [token for token in actions if token not in tried.get(node, set())]",
  "                if len(pending) > 0:",
  "                    frontier.append((depth[node], visits.get(node, 0), first))",
  "            for token, destination in graph.get(node, {}).items():",
  "                if destination != node and destination not in seen and token[0] in avail:",
  "                    seen.add(destination)",
  "                    depth[destination] = depth[node] + 1",
  "                    queue.append((destination, token if first is None else first))",
  "        if len(frontier) > 0:",
  "            frontier.sort()",
  "            choice = frontier[0][2]",
  "    if choice is None and int(cfg[6]) in avail:",
  "        clicks = []",
  "        for colour in [int(cfg[0]), int(cfg[1]), int(cfg[2]), int(cfg[5])]:",
  "            for component in components(frame, colour, edge, cfg[4]):",
  "                centre_click = np.sum(component, axis=0) / len(component)",
  "                nearest = int(np.argmin(np.sum(np.abs(component - centre_click), axis=1)))",
  "                y, x = component[nearest].tolist()",
  "                token = (int(cfg[6]), int(x), int(y))",
  "                if token not in tried[state]:",
  "                    clicks.append(token)",
  "        if len(clicks) > 0:",
  "            choice = clicks[0]",
  "    if choice is None:",
  "        alternatives = []",
  "        for token, destination in graph[state].items():",
  "            if destination != state and token[0] in avail:",
  "                alternatives.append((visits.get(destination, 0), token))",
  "        if len(alternatives) > 0:",
  "            alternatives.sort()",
  "            choice = alternatives[0][1]",
  "        elif len(actions) > 0:",
  "            choice = actions[int(mem.get('fallback', 0)) % len(actions)]",
  "            mem['fallback'] = mem.get('fallback', 0) + 1",
  "        else:",
  "            choice = (avail[0], 0, 0)",
  "    tried[state].add(choice)",
  "    position = (mode, tuple(points.reshape(-1).tolist()))",
  "    positions = mem.setdefault('positions', {})",
  "    positions[position] = positions.get(position, 0) + 1",
  "    mem['state'] = state",
  "    mem['last'] = choice",
  "    mem['centre'] = centre.copy()",
  "    mem['count'] = len(points)",
  "    mem['mode'] = mode",
  "    return choice"
 ],
