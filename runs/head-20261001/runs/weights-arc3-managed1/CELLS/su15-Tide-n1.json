 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['cfg']",
  "    priorities = params['priorities']",
  "    top = int(cfg[0])",
  "    bottom = int(cfg[1])",
  "    board = frame[top:bottom, :]",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['blocked'] = {}",
  "        mem['visits'] = {}",
  "        mem['response'] = {}",
  "    blocked = mem['blocked']",
  "    response = mem['response']",
  "    previous = mem.get('previous')",
  "    last = mem.get('last')",
  "    if previous is not None and last is not None:",
  "        changed = int(np.sum(board != previous))",
  "        colour = last[0]",
  "        if changed == 0:",
  "            blocked[last] = blocked.get(last, 0) + 1",
  "            response[colour] = response.get(colour, 0.0) - cfg[6]",
  "        else:",
  "            response[colour] = min(cfg[8], response.get(colour, 0.0) + cfg[7])",
  "            blocked.clear()",
  "    height, width = board.shape",
  "    seen = np.zeros(board.shape, dtype=bool)",
  "    candidates = []",
  "    for row in range(height):",
  "        for col in range(width):",
  "            if seen[row, col]:",
  "                continue",
  "            colour = int(board[row, col])",
  "            if colour == int(cfg[2]) or colour == int(cfg[3]):",
  "                seen[row, col] = True",
  "                continue",
  "            stack = [(row, col)]",
  "            seen[row, col] = True",
  "            pixels = []",
  "            while stack:",
  "                y, x = stack.pop()",
  "                pixels.append((y, x))",
  "                for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:",
  "                    ny, nx = y + dy, x + dx",
  "                    if ny >= 0 and ny < height and nx >= 0 and nx < width:",
  "                        if not seen[ny, nx] and int(board[ny, nx]) == colour:",
  "                            seen[ny, nx] = True",
  "                            stack.append((ny, nx))",
  "            area = len(pixels)",
  "            if area < cfg[4] or area > cfg[5]:",
  "                continue",
  "            cy = sum(p[0] for p in pixels) / area",
  "            cx = sum(p[1] for p in pixels) / area",
  "            point = min(pixels, key=lambda p: (p[0] - cy) ** 2 + (p[1] - cx) ** 2)",
  "            y, x = point[0] + top, point[1]",
  "            signature = (colour, x, y, area)",
  "            score = priorities[colour] + response.get(colour, 0.0)",
  "            score -= cfg[9] * blocked.get(signature, 0)",
  "            score -= cfg[10] * mem['visits'].get(signature, 0)",
  "            score += cfg[11] / area",
  "            candidates.append((score, signature))",
  "    mem['previous'] = board.copy()",
  "    if int(cfg[12]) in avail and candidates:",
  "        best = max(candidates, key=lambda item: item[0])",
  "        signature = best[1]",
  "        mem['visits'][signature] = mem['visits'].get(signature, 0) + 1",
  "        mem['last'] = signature",
  "        return (int(cfg[12]), signature[1], signature[2])",
  "    mem['last'] = None",
  "    if int(cfg[12]) in avail:",
  "        points = np.argwhere(frame == int(cfg[13]))",
  "        if len(points):",
  "            index = mem.get('fallback', 0) % len(points)",
  "            mem['fallback'] = index + 1",
  "            return (int(cfg[12]), int(points[index, 1]), int(points[index, 0]))",
  "        return (int(cfg[12]), int(cfg[14]), int(cfg[15]))",
  "    return (avail[0], 0, 0)"
