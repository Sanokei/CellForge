 "source_lines": [
  "def groups(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    result = []",
  "    while remaining:",
  "        p = next(iter(remaining))",
  "        remaining.remove(p)",
  "        todo = [p]",
  "        cells = [p]",
  "        while todo:",
  "            r, c = todo.pop()",
  "            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    todo.append(q)",
  "                    cells.append(q)",
  "        rs = [p[0] for p in cells]",
  "        cs = [p[1] for p in cells]",
  "        result.append((sum(rs) / len(rs), sum(cs) / len(cs), min(rs), max(rs), min(cs), max(cs), len(cells)))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    cfg = params['config']",
  "    colours = params['colours']",
  "    order = params['order']",
  "    height = frame.shape[0]",
  "    width = frame.shape[1]",
  "    agents = groups(frame == int(colours[0]))",
  "    agents.sort(key=lambda p: -p[6])",
  "    agent = agents[0] if agents else None",
  "    cargoes = groups(frame == int(colours[1]))",
  "    markers = groups(frame == int(colours[2]))",
  "    goals = groups(frame == int(colours[3]))",
  "    goals.sort(key=lambda p: p[1])",
  "    cargo = cargoes[0] if cargoes else None",
  "    if mem.get('level') != info['levels'] or mem.get('reset') != info['resets']:",
  "        motion = mem.get('motion', {})",
  "        preference = mem.get('preference', 0)",
  "        if mem.get('level', info['levels']) < info['levels']:",
  "            preference = mem.get('destination', preference)",
  "        mem.clear()",
  "        mem['motion'] = motion",
  "        mem['preference'] = preference",
  "        mem['level'] = info['levels']",
  "        mem['reset'] = info['resets']",
  "        mem['visits'] = {}",
  "        mem['blocked'] = {}",
  "        mem['effects'] = {}",
  "        mem['phase'] = 0",
  "        mem['stuck'] = 0",
  "        mem['contact'] = 0",
  "        mem['destination'] = preference",
  "        mem['cargo_start'] = cargo",
  "    signature = tuple(int(v) for v in frame[int(cfg[0]):int(cfg[1]), :].flatten())",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        oldsig, identity, oldagent, oldcargo, oldframe = previous",
  "        changed = int(np.sum(frame[int(cfg[0]):int(cfg[1]), :] != oldframe[int(cfg[0]):int(cfg[1]), :]))",
  "        if signature == oldsig:",
  "            mem['blocked'][(oldsig, identity)] = mem['blocked'].get((oldsig, identity), 0) + 1",
  "            mem['stuck'] += 1",
  "        else:",
  "            mem['stuck'] = 0",
  "        if identity[0] == 'key' and agent is not None and oldagent is not None:",
  "            dr = agent[0] - oldagent[0]",
  "            dc = agent[1] - oldagent[1]",
  "            if cfg[2] <= abs(dr) + abs(dc) <= cfg[3]:",
  "                mem['motion'][identity[1]] = (dr, dc)",
  "            if cargo is not None and oldcargo is not None:",
  "                cr = cargo[0] - oldcargo[0]",
  "                cc = cargo[1] - oldcargo[1]",
  "                if abs(cr) + abs(cc) >= cfg[2]:",
  "                    mem['phase'] = 1",
  "                    if abs(cr - dr) + abs(cc - dc) <= cfg[4]:",
  "                        mem['offset'] = (cargo[0] - agent[0], cargo[1] - agent[1])",
  "        if identity[0] == 'click' or identity[1] == int(cfg[5]):",
  "            mem['effects'][identity] = max(mem['effects'].get(identity, 0), changed)",
  "    if agent is not None and cargo is not None:",
  "        gap = max(0, agent[2] - cargo[3] - 1, cargo[2] - agent[3] - 1) + max(0, agent[4] - cargo[5] - 1, cargo[4] - agent[5] - 1)",
  "        if gap <= cfg[6]:",
  "            mem['contact'] += 1",
  "        else:",
  "            mem['contact'] = 0",
  "        start = mem.get('cargo_start')",
  "        if start is not None and abs(cargo[0] - start[0]) + abs(cargo[1] - start[1]) >= cfg[7]:",
  "            mem['phase'] = 1",
  "        if mem['contact'] >= cfg[8]:",
  "            mem['phase'] = 1",
  "            mem['offset'] = (cargo[0] - agent[0], cargo[1] - agent[1])",
  "    elif agent is not None and mem.get('cargo_start') is not None:",
  "        mem['phase'] = 1",
  "    visits = mem['visits'].setdefault(signature, {})",
  "    target = None",
  "    if agent is not None:",
  "        if mem['phase'] == 0 and cargo is not None:",
  "            target = (cargo[3] + cfg[9] + (agent[3] - agent[2]) / 2, cargo[1])",
  "        elif goals:",
  "            destination = int(mem['destination']) % len(goals)",
  "            goal = goals[destination]",
  "            offset = mem.get('offset', (-(agent[3] - agent[2]) / 2 - cfg[9], 0))",
  "            target = (goal[2] + cfg[10] - offset[0], goal[1] - offset[1])",
  "        elif markers:",
  "            target = (markers[0][0], markers[0][1])",
  "    candidates = []",
  "    for i in range(len(order)):",
  "        action = int(order[i])",
  "        if action not in avail:",
  "            continue",
  "        identity = ('key', action)",
  "        dr, dc = mem['motion'].get(action, (params['directions'][i][0], params['directions'][i][1]))",
  "        score = cfg[11] - i * cfg[12]",
  "        if agent is not None and target is not None:",
  "            before = abs(agent[0] - target[0]) + abs(agent[1] - target[1])",
  "            after = abs(agent[0] + dr - target[0]) + abs(agent[1] + dc - target[1])",
  "            score += cfg[13] * (before - after)",
  "            if agent[2] + dr < cfg[0] or agent[3] + dr >= cfg[1] or agent[4] + dc < 0 or agent[5] + dc >= width:",
  "                score -= cfg[14]",
  "            if mem['phase'] == 1 and cargo is not None and goals:",
  "                goal = goals[int(mem['destination']) % len(goals)]",
  "                horizontal = abs(cargo[1] - goal[1])",
  "                if horizontal > cfg[15] and dr > 0:",
  "                    score -= cfg[16]",
  "        if action == int(cfg[5]):",
  "            score += min(cfg[17], mem['contact']) * cfg[18]",
  "            score += min(cfg[19], mem['effects'].get(identity, 0)) * cfg[20]",
  "        candidates.append((score, identity, action, 0, 0))",
  "    click = int(cfg[21])",
  "    if click in avail:",
  "        for colour in params['click_colours']:",
  "            for obj in groups(frame == int(colour)):",
  "                if obj[6] <= cfg[22]:",
  "                    r = int(round(obj[0]))",
  "                    c = int(round(obj[1]))",
  "                    identity = ('click', int(colour), r, c)",
  "                    score = cfg[23] + min(cfg[24], mem['stuck']) * cfg[25]",
  "                    score += min(cfg[19], mem['effects'].get(identity, 0)) * cfg[20]",
  "                    candidates.append((score, identity, click, c, r))",
  "    best = None",
  "    bestscore = -1000000",
  "    for score, identity, action, x, y in candidates:",
  "        score -= cfg[26] * visits.get(identity, 0)",
  "        score -= cfg[27] * mem['blocked'].get((signature, identity), 0)",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = (identity, action, x, y)",
  "    if mem['stuck'] >= cfg[28]:",
  "        if mem['phase'] == 0:",
  "            mem['phase'] = 1",
  "        elif goals:",
  "            mem['destination'] = (int(mem['destination']) + 1) % len(goals)",
  "        mem['stuck'] = 0",
  "    if best is None:",
  "        best = (('key', avail[0]), avail[0], 0, 0)",
  "    identity, action, x, y = best",
  "    visits[identity] = visits.get(identity, 0) + 1",
  "    mem['previous'] = (signature, identity, agent, cargo, frame.copy())",
  "    return (action, max(0, min(width - 1, int(x))), max(0, min(height - 1, int(y))))"
 ],
