 "source_lines": [
  "def components(frame, colour):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    result = []",
  "    for yy, xx in np.argwhere(frame == colour):",
  "        y, x = int(yy), int(xx)",
  "        if seen[y, x]:",
  "            continue",
  "        todo = [(y, x)]",
  "        seen[y, x] = True",
  "        cells = []",
  "        while todo:",
  "            y, x = todo.pop()",
  "            cells.append((y, x))",
  "            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:",
  "                ny, nx = y + dy, x + dx",
  "                if 0 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == colour:",
  "                    seen[ny, nx] = True",
  "                    todo.append((ny, nx))",
  "        xs = [v[1] for v in cells]",
  "        ys = [v[0] for v in cells]",
  "        result.append((min(xs), min(ys), max(xs), max(ys), len(cells)))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if 'models' not in mem:",
  "        mem['models'] = {}",
  "        mem['attempts'] = {}",
  "        mem['edges'] = {}",
  "        mem['visits'] = {}",
  "        mem['wins'] = {}",
  "    if mem.get('level') != level or mem.get('reset') != reset:",
  "        if mem.get('level', level) < level and 'last_fire' in mem:",
  "            old, code, location = mem['last_fire']",
  "            mem['wins'][code] = mem['wins'].get(code, 0) + 1",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['pending'] = None",
  "        mem['last_fire'] = None",
  "        mem['turns'] = 0",
  "    board = np.argwhere(frame == int(p[0]))",
  "    if len(board):",
  "        left = int(np.min(board[:, 1]))",
  "        right = int(np.max(board[:, 1]))",
  "        top = int(np.min(board[:, 0]))",
  "        bottom = int(np.max(board[:, 0]))",
  "    else:",
  "        left, top, right, bottom = [int(v) for v in params['fallback']]",
  "    points = []",
  "    for offset in params['controls']:",
  "        x = max(0, min(frame.shape[1] - 1, left + int(offset)))",
  "        y = max(0, min(frame.shape[0] - 1, bottom + int(p[1])))",
  "        points.append((x, y))",
  "    current = 0",
  "    for i in range(len(points)):",
  "        x, y = points[i]",
  "        if int(frame[y, x]) == int(p[2]):",
  "            current += 2 ** i",
  "    button = (left + int(p[3]), bottom + int(p[4]))",
  "    circles = components(frame, int(p[5]))",
  "    circles = [v for v in circles if v[1] > bottom and v[4] >= p[6]]",
  "    if circles:",
  "        circle = max(circles, key=lambda v: v[4])",
  "        button = ((circle[0] + circle[2]) // 2, (circle[1] + circle[3]) // 2)",
  "    objects = components(frame, int(p[7]))",
  "    objects = [v for v in objects if v[1] >= top and v[3] <= bottom]",
  "    objects.sort(key=lambda v: v[4])",
  "    location = None",
  "    target = None",
  "    if len(objects) >= 2:",
  "        small, large = objects[0], objects[-1]",
  "        target = ((small[0] + small[2]) / 2, (small[1] + small[3]) / 2)",
  "        location = ((large[0] + large[2]) / 2, (large[1] + large[3]) / 2)",
  "    elif objects:",
  "        obj = objects[0]",
  "        location = ((obj[0] + obj[2]) / 2, (obj[1] + obj[3]) / 2)",
  "    visual = tuple((v[0], v[1], v[2], v[3], v[4]) for v in objects)",
  "    state = (level, visual)",
  "    if not visual:",
  "        stride = max(1, int(p[8]))",
  "        state = (level, tuple(int(frame[y, x]) for y in range(top, bottom + 1, stride) for x in range(left, right + 1, stride)))",
  "    if mem.get('last_fire') is not None:",
  "        old, code, old_location = mem['last_fire']",
  "        mem['edges'][(old, code)] = state",
  "        if location is not None and old_location is not None:",
  "            dx = location[0] - old_location[0]",
  "            dy = location[1] - old_location[1]",
  "            model = mem['models'].setdefault(code, [0.0, 0.0, 0.0, 0.0])",
  "            model[2] += 1",
  "            if abs(dx) + abs(dy) > p[9]:",
  "                model[0] += dx",
  "                model[1] += dy",
  "                model[3] += 1",
  "        mem['last_fire'] = None",
  "    if mem.get('pending') is None:",
  "        mem['visits'][state] = mem['visits'].get(state, 0) + 1",
  "        options = []",
  "        count = 2 ** len(points)",
  "        for code in range(count):",
  "            used = mem['attempts'].get((state, code), 0)",
  "            value = p[10] * used",
  "            model = mem['models'].get(code)",
  "            if model is not None:",
  "                value += p[11] * (model[2] - model[3]) / max(1, model[2])",
  "                if location is not None and target is not None and model[3] > 0:",
  "                    dx = model[0] / model[3]",
  "                    dy = model[1] / model[3]",
  "                    before = abs(location[0] - target[0]) + abs(location[1] - target[1])",
  "                    after = abs(location[0] + dx - target[0]) + abs(location[1] + dy - target[1])",
  "                    value += p[12] * (after - before)",
  "            else:",
  "                value -= p[13]",
  "            nxt = mem['edges'].get((state, code))",
  "            if nxt is not None:",
  "                value += p[14] * mem['visits'].get(nxt, 0)",
  "                if nxt == state:",
  "                    value += p[15]",
  "            value -= p[16] * mem['wins'].get(code, 0)",
  "            changes = sum(1 for i in range(len(points)) if (code // (2 ** i)) % 2 != (current // (2 ** i)) % 2)",
  "            value += p[17] * changes",
  "            value += params['priority'][code % len(params['priority'])]",
  "            options.append((value, code))",
  "        options.sort()",
  "        chosen = options[0][1]",
  "        if all(mem['attempts'].get((state, code), 0) > 0 for code in range(count)):",
  "            queue = [state]",
  "            parents = {state: None}",
  "            head = 0",
  "            found = None",
  "            while head < len(queue) and len(queue) < int(p[18]):",
  "                node = queue[head]",
  "                head += 1",
  "                if node != state and any(mem['attempts'].get((node, code), 0) == 0 for code in range(count)):",
  "                    found = node",
  "                    break",
  "                for code in range(count):",
  "                    nxt = mem['edges'].get((node, code))",
  "                    if nxt is not None and nxt != node and nxt not in parents:",
  "                        parents[nxt] = (node, code)",
  "                        queue.append(nxt)",
  "            if found is not None:",
  "                while parents[found][0] != state:",
  "                    found = parents[found][0]",
  "                chosen = parents[found][1]",
  "        mem['pending'] = chosen",
  "    chosen = mem['pending']",
  "    differences = [i for i in range(len(points)) if (chosen // (2 ** i)) % 2 != (current // (2 ** i)) % 2]",
  "    mem['turns'] += 1",
  "    if differences:",
  "        i = min(differences, key=lambda j: params['bit_order'][j])",
  "        x, y = points[i]",
  "    else:",
  "        x, y = button",
  "        mem['attempts'][(state, chosen)] = mem['attempts'].get((state, chosen), 0) + 1",
  "        mem['last_fire'] = (state, chosen, location)",
  "        mem['pending'] = None",
  "    action = int(p[19])",
  "    if action not in avail:",
  "        action = avail[0]",
  "    return (action, max(0, min(frame.shape[1] - 1, int(x))), max(0, min(frame.shape[0] - 1, int(y))))"
 ],
