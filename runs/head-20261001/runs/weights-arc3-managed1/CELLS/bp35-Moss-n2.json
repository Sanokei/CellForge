 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    moves = params['moves']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level', -1) != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['motion'] = {}",
  "    if mem.get('reset', -1) != reset:",
  "        mem['reset'] = reset",
  "        mem['visits'] = {}",
  "        mem.pop('previous', None)",
  "    height = max(1, min(frame.shape[0], int(p[0])))",
  "    agent = np.argwhere((frame[:height] == int(p[1])) | (frame[:height] == int(p[2])))",
  "    if len(agent) == 0:",
  "        targets = np.argwhere(frame[:height] == int(p[3]))",
  "        if len(targets) and int(p[4]) in avail:",
  "            point = targets[len(targets) // 2]",
  "            return (int(p[4]), int(point[1]), int(point[0]))",
  "        return (int(avail[0]), 0, 0)",
  "    ax = int(min(agent[:, 1])) + int(p[5])",
  "    ay = int(min(agent[:, 0])) + int(p[6])",
  "    if 'previous' in mem:",
  "        ox, oy, action = mem['previous']",
  "        dx = ax - ox",
  "        dy = ay - oy",
  "        if action != int(p[4]) and abs(dx) + abs(dy) > p[7]:",
  "            mem['motion'][action] = (dx, dy)",
  "    stride = max(1, int(p[8]))",
  "    key = (ax, ay, tuple(int(v) for v in np.sum(frame[:height] == int(p[3]), axis=1)))",
  "    visits = mem.setdefault('visits', {})",
  "    visits[key] = visits.get(key, 0) + 1",
  "    actions = []",
  "    for row in moves:",
  "        action = int(row[0])",
  "        if action in avail:",
  "            dx, dy = mem['motion'].get(action, (int(row[1]), int(row[2])))",
  "            actions.append((action, dx, dy))",
  "    queue = [(ax, ay, None, 0, 0)]",
  "    seen = set([(ax, ay)])",
  "    cursor = 0",
  "    best = None",
  "    bestscore = -float(p[9])",
  "    while cursor < len(queue) and cursor < int(p[10]):",
  "        x, y, first, depth, obstacles = queue[cursor]",
  "        cursor += 1",
  "        if first is not None:",
  "            score = p[11] * (ay - y) - p[12] * depth - p[13] * obstacles",
  "            if y <= p[14]:",
  "                score += p[15]",
  "            if score > bestscore:",
  "                bestscore = score",
  "                best = first",
  "        for action, dx, dy in actions:",
  "            nx = x + dx",
  "            ny = y + dy",
  "            if nx < int(p[16]) or nx >= frame.shape[1] - int(p[16]) or ny < 0 or ny >= height:",
  "                continue",
  "            if (nx, ny) in seen:",
  "                continue",
  "            radius = max(0, int(p[17]))",
  "            tile = frame[max(0, ny-radius):min(height, ny+radius+1), max(0, nx-radius):min(frame.shape[1], nx+radius+1)]",
  "            road = int(np.sum(tile == int(p[18])))",
  "            target = int(np.sum(tile == int(p[3])))",
  "            if road + target < tile.size * p[19]:",
  "                continue",
  "            if target > 0 and int(p[4]) not in avail:",
  "                continue",
  "            nextfirst = first",
  "            if first is None:",
  "                if target > 0:",
  "                    points = np.argwhere(tile == int(p[3]))",
  "                    point = points[len(points) // 2]",
  "                    nextfirst = (int(p[4]), max(0, nx-radius) + int(point[1]), max(0, ny-radius) + int(point[0]))",
  "                else:",
  "                    nextfirst = (action, 0, 0)",
  "            seen.add((nx, ny))",
  "            queue.append((nx, ny, nextfirst, depth+1, obstacles+int(target > 0)))",
  "    if best is None or visits[key] > p[20]:",
  "        targets = np.argwhere(frame[:height] == int(p[3]))",
  "        if len(targets) and int(p[4]) in avail:",
  "            chosen = None",
  "            distance = float(p[9])",
  "            for point in targets:",
  "                y = int(point[0])",
  "                x = int(point[1])",
  "                value = abs(x-ax) + p[21] * abs(y-ay) + p[22] * int(y > ay)",
  "                if value < distance:",
  "                    distance = value",
  "                    chosen = (int(p[4]), x, y)",
  "            best = chosen",
  "        elif actions:",
  "            counts = mem.setdefault('fallback', {})",
  "            best = (actions[0][0], 0, 0)",
  "            lowest = float(p[9])",
  "            for rank, entry in enumerate(actions):",
  "                action = entry[0]",
  "                value = counts.get((ax, ay, action), 0) + p[23] * rank",
  "                if value < lowest:",
  "                    lowest = value",
  "                    best = (action, 0, 0)",
  "            counts[(ax, ay, best[0])] = counts.get((ax, ay, best[0]), 0) + 1",
  "        else:",
  "            best = (int(avail[0]), 0, 0)",
  "    mem['previous'] = (ax, ay, best[0])",
  "    return best"
 ],
