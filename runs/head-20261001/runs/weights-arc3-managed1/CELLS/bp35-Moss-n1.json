 "source_lines": [
  "def objects(frame, colour, height):",
  "    pixels = np.argwhere(frame[:height] == colour)",
  "    remaining = set()",
  "    for p in pixels:",
  "        remaining.add((int(p[0]), int(p[1])))",
  "    result = []",
  "    while remaining:",
  "        seed = next(iter(remaining))",
  "        remaining.remove(seed)",
  "        stack = [seed]",
  "        sy = 0",
  "        sx = 0",
  "        count = 0",
  "        while stack:",
  "            y, x = stack.pop()",
  "            sy += y",
  "            sx += x",
  "            count += 1",
  "            for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:",
  "                q = (y + dy, x + dx)",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    stack.append(q)",
  "        result.append((int(sx / count), int(sy / count), count))",
  "    return result",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    weights = params['weights']",
  "    order = params['actions']",
  "    height = max(1, min(frame.shape[0], int(p[0])))",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    if mem.get('level', -1) != level or mem.get('reset', -1) != reset:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['reset'] = reset",
  "        mem['nodes'] = {}",
  "        mem['effects'] = {}",
  "        mem['tick'] = 0",
  "    mem['tick'] += 1",
  "    key = tuple(int(v) for v in frame[:height].flatten())",
  "    nodes = mem['nodes']",
  "    node = nodes.setdefault(key, {'visits': 0, 'edges': {}, 'trials': {}})",
  "    node['visits'] += 1",
  "    agent = np.argwhere((frame[:height] == int(p[1])) | (frame[:height] == int(p[2])))",
  "    if len(agent):",
  "        ay = float(np.sum(agent[:, 0])) / len(agent)",
  "        ax = float(np.sum(agent[:, 1])) / len(agent)",
  "    else:",
  "        ax = float(p[3])",
  "        ay = float(p[4])",
  "    targets = objects(frame, int(p[5]), height)",
  "    potential = weights[0] * ax + weights[1] * ay + weights[2] * len(targets)",
  "    node['potential'] = float(potential)",
  "    if 'previous' in mem:",
  "        oldkey = mem['previous']",
  "        action = mem['last']",
  "        oldnode = nodes[oldkey]",
  "        oldnode['edges'][action] = key",
  "        effect = mem['effects'].setdefault(action[0], [0.0, 0.0, 0.0, 0.0])",
  "        effect[0] += 1",
  "        effect[1] += ax - mem['ax']",
  "        effect[2] += ay - mem['ay']",
  "        effect[3] += float(key != oldkey)",
  "    candidates = []",
  "    for value in order:",
  "        action = int(value)",
  "        if action in avail and action != int(p[6]):",
  "            candidates.append((action, 0, 0))",
  "    if int(p[6]) in avail:",
  "        for x, y, area in targets:",
  "            if area >= p[7]:",
  "                candidates.append((int(p[6]), x, y))",
  "    if not candidates:",
  "        candidates = [(int(avail[0]), 0, 0)]",
  "    node['candidates'] = candidates",
  "    best = candidates[0]",
  "    bestscore = -float(p[8])",
  "    for rank, action in enumerate(candidates):",
  "        trials = node['trials'].get(action, 0)",
  "        score = weights[3] / (1 + trials) - weights[4] * rank",
  "        destination = node['edges'].get(action)",
  "        if destination is not None:",
  "            other = nodes[destination]",
  "            score += weights[5] * (other.get('potential', potential) - potential)",
  "            score -= weights[6] * other['visits']",
  "            if destination == key:",
  "                score -= weights[7]",
  "        if action[0] == int(p[6]):",
  "            distance = abs(action[1] - ax) + p[9] * abs(action[2] - ay)",
  "            score += weights[8] - weights[9] * distance",
  "            if action[2] < ay:",
  "                score += weights[10]",
  "        else:",
  "            effect = mem['effects'].get(action[0])",
  "            if effect is not None and effect[0] > 0:",
  "                score += weights[11] * (weights[0] * effect[1] + weights[1] * effect[2]) / effect[0]",
  "                score += weights[12] * effect[3] / effect[0]",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = action",
  "    if all(node['trials'].get(a, 0) > 0 for a in candidates):",
  "        queue = [(key, None, 0)]",
  "        seen = set([key])",
  "        cursor = 0",
  "        route = None",
  "        routescore = -float(p[8])",
  "        while cursor < len(queue) and cursor < int(p[10]):",
  "            state, first, depth = queue[cursor]",
  "            cursor += 1",
  "            entry = nodes[state]",
  "            if first is not None:",
  "                fresh = sum(1 for a in entry.get('candidates', []) if entry['trials'].get(a, 0) == 0)",
  "                if fresh:",
  "                    score = weights[13] * fresh - weights[14] * depth + weights[15] * (entry.get('potential', potential) - potential)",
  "                    if score > routescore:",
  "                        routescore = score",
  "                        route = first",
  "            for action, destination in entry['edges'].items():",
  "                if destination not in seen and destination in nodes:",
  "                    seen.add(destination)",
  "                    queue.append((destination, action if first is None else first, depth + 1))",
  "        if route is not None and route in candidates:",
  "            best = route",
  "    node['trials'][best] = node['trials'].get(best, 0) + 1",
  "    mem['previous'] = key",
  "    mem['last'] = best",
  "    mem['ax'] = ax",
  "    mem['ay'] = ay",
  "    return best"
 ],
