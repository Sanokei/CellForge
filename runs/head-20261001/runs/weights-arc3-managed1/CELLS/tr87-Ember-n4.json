 "source_lines": [
  "def glyph(frame, y, x, n, ink):",
  "    return tuple(int(frame[y+r, x+c] == ink) for r in range(n) for c in range(n))",
  "",
  "def transform(g, n, rotation, mirror):",
  "    a = [list(g[r*n:(r+1)*n]) for r in range(n)]",
  "    if mirror:",
  "        a = [list(reversed(row)) for row in a]",
  "    for k in range(rotation):",
  "        a = [[a[n-1-c][r] for c in range(n)] for r in range(n)]",
  "    return tuple(v for row in a for v in row)",
  "",
  "def search(graph, start, targets, actions, limit):",
  "    queue = [(start, [])]",
  "    seen = {start}",
  "    index = 0",
  "    frontier = None",
  "    while index < len(queue) and index < limit:",
  "        node, path = queue[index]",
  "        index += 1",
  "        if node in targets:",
  "            return path, True",
  "        edges = graph.get(node, {})",
  "        for action in actions:",
  "            if action not in edges:",
  "                if frontier is None:",
  "                    frontier = path + [action]",
  "            else:",
  "                nxt = edges[action]",
  "                if nxt not in seen:",
  "                    seen.add(nxt)",
  "                    queue.append((nxt, path + [action]))",
  "    return frontier, False",
  "",
  "def act(params, mem, frame, avail, info):",
  "    p = params['geometry']",
  "    n = max(1, min(8, int(p[0])))",
  "    count = max(1, min(7, int(p[1])))",
  "    stride = max(1, min(9, int(p[2])))",
  "    x0 = max(0, min(63-n-(count-1)*stride, int(p[3])))",
  "    sy = max(0, min(64-n, int(p[4])))",
  "    oy = max(0, min(64-n, int(p[5])))",
  "    ink = int(params['colours'][0])",
  "    marker = int(params['colours'][1])",
  "    cycles = [int(a) for a in params['actions'][:2] if int(a) in avail]",
  "    moves = [int(a) for a in params['actions'][2:] if int(a) in avail]",
  "    ordered = cycles + moves",
  "    if not ordered:",
  "        return (avail[0], 0, 0)",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem.update({'level': level, 'reset': reset, 'graph': {}, 'directions': {}, 'phase': 0, 'visits': {}, 'uses': {}, 'probe': 0})",
  "    if mem['reset'] != reset:",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "        mem['probe'] = 0",
  "        mem['visits'] = {}",
  "    sources = [glyph(frame, sy, x0+i*stride, n, ink) for i in range(count)]",
  "    outputs = [glyph(frame, oy, x0+i*stride, n, ink) for i in range(count)]",
  "    lo = max(0, min(63, int(p[6])))",
  "    hi = max(lo+1, min(64, int(p[7])))",
  "    points = np.argwhere(frame[lo:hi, :] == marker)",
  "    cursor = mem.get('cursor', 0)",
  "    if len(points):",
  "        center = float(np.sum(points[:, 1])) / len(points)",
  "        cursor = max(0, min(count-1, int((center-x0-(n-1)/2)/stride+float(params['settings'][0]))))",
  "    graph = mem['graph']",
  "    if 'last' in mem:",
  "        old_cursor, old_outputs, action = mem['last']",
  "        changes = [i for i in range(count) if old_outputs[i] != outputs[i]]",
  "        if action in cycles and len(changes) == 1:",
  "            i = changes[0]",
  "            graph.setdefault(old_outputs[i], {})[action] = outputs[i]",
  "            cursor = i",
  "        elif action in cycles and not changes:",
  "            graph.setdefault(old_outputs[old_cursor], {})[action] = outputs[old_cursor]",
  "        if action in moves and cursor != old_cursor:",
  "            delta = (cursor-old_cursor) % count",
  "            if delta == 1:",
  "                mem['directions'][action] = 1",
  "            elif delta == count-1:",
  "                mem['directions'][action] = -1",
  "    pairs = []",
  "    for row in params['rows']:",
  "        y = max(0, min(64-n, int(row)))",
  "        for columns in params['columns']:",
  "            leftx = max(0, min(64-n, int(columns[0])))",
  "            rightx = max(0, min(64-n, int(columns[1])))",
  "            pairs.append((glyph(frame, y, leftx, n, ink), glyph(frame, y, rightx, n, ink)))",
  "    target_lists = []",
  "    for source in sources:",
  "        candidates = []",
  "        for left, right in pairs:",
  "            for mirror in range(2):",
  "                for rotation in range(4):",
  "                    trial = transform(left, n, rotation, mirror)",
  "                    distance = sum(int(a != b) for a, b in zip(source, trial))",
  "                    oriented = transform(right, n, rotation, mirror)",
  "                    penalty = float(params['settings'][1])*distance",
  "                    candidates.append((penalty, right, oriented))",
  "        candidates.sort(key=lambda item: item[0])",
  "        best = candidates[0][0]",
  "        choices = []",
  "        phase = mem['phase']",
  "        for penalty, right, oriented in candidates:",
  "            if penalty != best:",
  "                continue",
  "            target = oriented if phase % 2 else right",
  "            if target not in choices:",
  "                choices.append(target)",
  "        if not choices:",
  "            choices = [outputs[len(target_lists)]]",
  "        offset = (phase // 2) % len(choices)",
  "        target_lists.append(choices[offset:]+choices[:offset])",
  "    state = (cursor, tuple(outputs))",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    targets = [choices[0] for choices in target_lists]",
  "    wrong = [i for i in range(count) if outputs[i] != targets[i]]",
  "    if not wrong and mem['probe'] >= len(ordered):",
  "        mem['phase'] += 1",
  "        mem['visits'] = {}",
  "        targets = [choices[-1] for choices in target_lists]",
  "        wrong = [i for i in range(count) if outputs[i] != targets[i]]",
  "    action = None",
  "    if mem['probe'] < len(ordered):",
  "        action = ordered[mem['probe']]",
  "        mem['probe'] += 1",
  "    elif cursor in wrong and cycles:",
  "        path, reached = search(graph, outputs[cursor], [targets[cursor]], cycles, max(1, int(params['settings'][2])))",
  "        if path:",
  "            action = path[0]",
  "        elif not reached:",
  "            alternatives = target_lists[cursor]",
  "            path, reached = search(graph, outputs[cursor], alternatives, cycles, max(1, int(params['settings'][2])))",
  "            if path:",
  "                action = path[0]",
  "            elif reached:",
  "                wrong = [i for i in wrong if i != cursor]",
  "            else:",
  "                mem['phase'] += 1",
  "                action = min(cycles, key=lambda a: mem['uses'].get((outputs[cursor], a), 0))",
  "    if action is None and wrong and moves:",
  "        scored = []",
  "        for j, candidate in enumerate(moves):",
  "            direction = mem['directions'].get(candidate, int(params['directions'][j % len(params['directions'])]))",
  "            if direction:",
  "                distance = min(((i-cursor)*direction) % count for i in wrong)",
  "                scored.append((distance, candidate))",
  "        if scored:",
  "            scored.sort()",
  "            action = scored[0][1]",
  "    if action is None:",
  "        action = min(ordered, key=lambda a: mem['uses'].get((state, a), 0))",
  "    if visits[state] > int(params['settings'][3]):",
  "        action = min(ordered, key=lambda a: mem['uses'].get((state, a), 0))",
  "        if visits[state] % max(1, int(params['settings'][3])) == 0:",
  "            mem['phase'] += 1",
  "    mem['uses'][(state, action)] = mem['uses'].get((state, action), 0) + 1",
  "    mem['uses'][(outputs[cursor], action)] = mem['uses'].get((outputs[cursor], action), 0) + 1",
  "    mem['cursor'] = cursor",
  "    mem['last'] = (cursor, tuple(outputs), action)",
  "    return (action, 0, 0)"
 ],
