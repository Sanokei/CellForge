 "source_lines": [
  "def components(frame, colours):",
  "    seen = np.zeros(frame.shape, dtype=bool)",
  "    out = []",
  "    for y in range(1, frame.shape[0]):",
  "        for x in range(frame.shape[1]):",
  "            c = int(frame[y, x])",
  "            if seen[y, x] or c not in colours:",
  "                continue",
  "            todo = [(y, x)]",
  "            seen[y, x] = True",
  "            cells = []",
  "            while todo:",
  "                yy, xx = todo.pop()",
  "                cells.append((yy, xx))",
  "                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
  "                    ny, nx = yy + dy, xx + dx",
  "                    if 1 <= ny < frame.shape[0] and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:",
  "                        seen[ny, nx] = True",
  "                        todo.append((ny, nx))",
  "            xs = [v[1] for v in cells]",
  "            ys = [v[0] for v in cells]",
  "            out.append((c, min(xs), min(ys), max(xs), max(ys), len(cells), sum(xs) / len(xs), sum(ys) / len(ys)))",
  "    return out",
  "def features(objects, p):",
  "    markers = sorted([o for o in objects if o[0] == int(p[1])], key=lambda o: (-o[5], o[2], o[1]))",
  "    agents = [o for o in objects if o[0] == int(p[2])]",
  "    tracks = [o for o in objects if o[0] == int(p[3])]",
  "    result = []",
  "    for i in range(2):",
  "        if i < len(markers):",
  "            result.extend([markers[i][6], markers[i][7]])",
  "        else:",
  "            result.extend([-1.0, -1.0])",
  "    for group in [agents, tracks]:",
  "        if group:",
  "            total = sum(o[5] for o in group)",
  "            result.extend([sum(o[6] * o[5] for o in group) / total, sum(o[7] * o[5] for o in group) / total])",
  "        else:",
  "            result.extend([-1.0, -1.0])",
  "    return tuple(result)",
  "def objective(v, p):",
  "    score = 0.0",
  "    if min(v[:4]) >= 0:",
  "        score += p[4] * abs(v[0] - v[2]) + p[5] * abs(v[1] - v[3])",
  "    if min(v[4:]) >= 0:",
  "        score += p[6] * abs(v[5] - v[7])",
  "    return score",
  "def geometry(objects, q):",
  "    bars = [o for o in objects if o[0] == int(q[0])]",
  "    vertical = sum(o[4] - o[2] for o in bars) >= sum(o[3] - o[1] for o in bars)",
  "    axis = 6 if vertical else 7",
  "    other = 7 if vertical else 6",
  "    markers = [o for o in objects if o[0] in (int(q[1]), int(q[2]))]",
  "    groups = []",
  "    for o in sorted(markers, key=lambda o: (o[axis], o[other])):",
  "        if groups and abs(groups[-1][0] - o[axis]) <= q[3]:",
  "            a, b, n = groups[-1]",
  "            groups[-1] = ((a * n + o[axis] * o[5]) / (n + o[5]), (b * n + o[other] * o[5]) / (n + o[5]), n + o[5])",
  "        else:",
  "            groups.append((o[axis], o[other], o[5]))",
  "    agents = [o for o in objects if o[0] == int(q[4])]",
  "    if agents:",
  "        n = sum(o[5] for o in agents)",
  "        agent = (sum(o[axis] * o[5] for o in agents) / n, sum(o[other] * o[5] for o in agents) / n)",
  "    else:",
  "        agent = (-1.0, -1.0)",
  "    result = [agent[0], agent[1]]",
  "    for a, b, n in groups:",
  "        result.extend([a, b])",
  "    return tuple(result)",
  "def transport_cost(v, q):",
  "    if len(v) < 4 or v[0] < 0:",
  "        return 0.0",
  "    groups = [(v[i], v[i + 1]) for i in range(2, len(v), 2)]",
  "    support = min(groups, key=lambda g: abs(g[0] - v[0]))",
  "    ahead = [g for g in groups if q[5] * (g[0] - v[0]) > q[6]]",
  "    score = -q[7] * q[5] * v[0]",
  "    if ahead:",
  "        target = min(ahead, key=lambda g: abs(g[0] - v[0]))",
  "        reference = support[1] if abs(support[0] - v[0]) < q[8] else v[1] + q[9]",
  "        score += q[10] * abs(target[1] - reference)",
  "        score += q[11] * abs(target[0] - v[0])",
  "    else:",
  "        score += q[12] * abs(support[1] - v[1] - q[9])",
  "    return score",
  "def act(params, mem, frame, avail, info):",
  "    p = params['settings']",
  "    q = params['transport']",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    early = level < int(q[13])",
  "    weights = params['colours'] if early else params['probe_colours']",
  "    if mem.get('level') != level:",
  "        wins = mem.get('wins', {})",
  "        if mem.get('level', level) < level and 'last' in mem:",
  "            action = mem['last'][1]",
  "            wins[action[0]] = wins.get(action[0], 0) + 1",
  "        mem.clear()",
  "        mem.update({'level': level, 'reset': reset, 'wins': wins, 'pairs': {}, 'visits': {}, 'effects': {}, 'uses': {}, 'models': {}, 'edges': {}, 'nodes': {}, 'streak': 0, 'probes': {}})",
  "    if mem.get('reset') != reset:",
  "        mem['reset'] = reset",
  "        mem.pop('last', None)",
  "    objects = components(frame, [i for i in range(len(weights)) if weights[i] > 0])",
  "    state = tuple(int(v) for v in frame[int(p[0]):, :].flatten())",
  "    feature = features(objects, p) if early else geometry(objects, q)",
  "    score = objective(feature, p) if early else transport_cost(feature, q)",
  "    visits = mem['visits']",
  "    visits[state] = visits.get(state, 0) + 1",
  "    if 'last' in mem:",
  "        old, action, before = mem['last']",
  "        changed = old != state",
  "        entry = mem['effects'].setdefault(action, [0, 0])",
  "        entry[0] += int(changed)",
  "        entry[1] += 1",
  "        mem['edges'].setdefault(old, {})[action] = state",
  "        if changed and len(feature) == len(before):",
  "            delta = tuple(feature[i] - before[i] for i in range(len(feature)))",
  "            model = mem['models'].get(action)",
  "            if model is None or len(model[0]) != len(delta):",
  "                mem['models'][action] = [delta, 1]",
  "            elif max(abs(delta[i] - model[0][i]) for i in range(len(delta))) <= p[7]:",
  "                count = model[1]",
  "                mem['models'][action] = [tuple((model[0][i] * count + delta[i]) / (count + 1) for i in range(len(delta))), count + 1]",
  "            else:",
  "                mem['models'][action] = [delta, 1]",
  "        elif not changed:",
  "            mem['models'].pop(action, None)",
  "    candidates = {}",
  "    for o in objects:",
  "        if o[5] > p[8]:",
  "            continue",
  "        c, x0, y0, x1, y1, area, cx, cy = o",
  "        x, y = int(cx), int(cy)",
  "        if int(frame[y, x]) != c:",
  "            positions = np.argwhere(frame[y0:y1 + 1, x0:x1 + 1] == c)",
  "            middle = positions[len(positions) // 2]",
  "            y, x = y0 + int(middle[0]), x0 + int(middle[1])",
  "        candidates[(c, x, y)] = weights[c]",
  "    mem['nodes'][state] = list(candidates)",
  "    if not candidates:",
  "        return (6 if 6 in avail else avail[0], int(p[9]), int(p[10]))",
  "    choices = []",
  "    for action, priority in candidates.items():",
  "        successes, trials = mem['effects'].get(action, [0, 0])",
  "        used = mem['pairs'].get((state, action), 0)",
  "        value = -p[11] * priority + p[12] * used",
  "        value += p[13] * (trials - successes) + p[14] * mem['uses'].get(action, 0)",
  "        if trials == 0:",
  "            value -= p[15]",
  "        if successes:",
  "            value -= p[16] * successes / max(1, trials)",
  "        destination = mem['edges'].get(state, {}).get(action)",
  "        if destination is not None:",
  "            value += p[17] * visits.get(destination, 0)",
  "        model = mem['models'].get(action)",
  "        if model is not None and len(model[0]) == len(feature):",
  "            if early and model[1] >= int(p[18]):",
  "                predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))",
  "                value += p[19] * (objective(predicted, p) - score)",
  "            elif not early:",
  "                predicted = tuple(feature[i] + model[0][i] for i in range(len(feature)))",
  "                gain = transport_cost(predicted, q) - score",
  "                best = gain",
  "                for repeat in range(2, int(q[14]) + 1):",
  "                    future = tuple(feature[i] + repeat * model[0][i] for i in range(len(feature)))",
  "                    best = min(best, (transport_cost(future, q) - score) / repeat)",
  "                value += q[15] * best",
  "        if 'last' in mem and action == mem['last'][1]:",
  "            value -= p[20] / (1 + mem['streak'] / max(1.0, p[21]))",
  "        value -= p[22] * mem['wins'].get(action[0], 0)",
  "        if not early:",
  "            value += q[16] * (trials - successes) / max(1, trials)",
  "            if action[0] == int(q[17]) and used == 0:",
  "                value -= q[18]",
  "            if destination == state:",
  "                value += q[19]",
  "        choices.append((value, action))",
  "    choices.sort(key=lambda item: (item[0], item[1]))",
  "    action = choices[0][1]",
  "    if not early:",
  "        controls = [a for a in candidates if a[0] == int(q[17])]",
  "        unprobed = [a for a in controls if mem['probes'].get(a, 0) == 0]",
  "        if unprobed:",
  "            action = min(unprobed, key=lambda a: (a[2], a[1]))",
  "        elif controls and all(mem['pairs'].get((state, a), 0) > 0 for a in controls):",
  "            queue = [(state, None)]",
  "            seen = {state}",
  "            index = 0",
  "            route = None",
  "            while index < len(queue) and index < int(q[20]):",
  "                node, first = queue[index]",
  "                index += 1",
  "                node_actions = mem['nodes'].get(node, [])",
  "                if node != state and any(a[0] == int(q[17]) and mem['pairs'].get((node, a), 0) == 0 for a in node_actions):",
  "                    route = first",
  "                    break",
  "                for a, destination in mem['edges'].get(node, {}).items():",
  "                    if destination != node and destination not in seen:",
  "                        seen.add(destination)",
  "                        queue.append((destination, a if first is None else first))",
  "            if route is not None and route in candidates:",
  "                action = route",
  "    if 'last' in mem and action == mem['last'][1]:",
  "        mem['streak'] += 1",
  "    else:",
  "        mem['streak'] = 0",
  "    mem['pairs'][(state, action)] = mem['pairs'].get((state, action), 0) + 1",
  "    mem['uses'][action] = mem['uses'].get(action, 0) + 1",
  "    mem['probes'][action] = mem['probes'].get(action, 0) + 1",
  "    mem['last'] = (state, action, feature)",
  "    return (6, action[1], action[2]) if 6 in avail else (avail[0], 0, 0)"
 ],
