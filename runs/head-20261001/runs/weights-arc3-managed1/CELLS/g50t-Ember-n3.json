 "source_lines": [
  "def blobs(frame, colour, low, high):",
  "    unseen = set()",
  "    for p in np.argwhere(frame == colour):",
  "        y, x = int(p[0]), int(p[1])",
  "        if low <= y < high:",
  "            unseen.add((y, x))",
  "    groups = []",
  "    while unseen:",
  "        p = unseen.pop()",
  "        stack = [p]",
  "        group = [p]",
  "        while stack:",
  "            y, x = stack.pop()",
  "            for q in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):",
  "                if q in unseen:",
  "                    unseen.remove(q)",
  "                    stack.append(q)",
  "                    group.append(q)",
  "        ys = [q[0] for q in group]",
  "        xs = [q[1] for q in group]",
  "        groups.append((min(ys),min(xs),max(ys),max(xs),len(group)))",
  "    return groups",
  "def act(params, mem, frame, avail, info):",
  "    c = params['cfg']",
  "    actor, ground, beam = int(c[0]), int(c[1]), int(c[2])",
  "    low, high, radius = int(c[3]), int(c[4]), max(1,int(abs(c[5])))",
  "    stride = max(1,int(abs(c[6])))",
  "    level = info.get('levels',0)",
  "    reset = info.get('resets',0)",
  "    epoch = (level,reset)",
  "    if mem.get('epoch') != epoch:",
  "        last = mem.get('last')",
  "        if mem.get('level') == level and last is not None:",
  "            edge = (last[0],last[1])",
  "            failures = mem.setdefault('failures',{})",
  "            failures[edge] = failures.get(edge,0)+1",
  "        if mem.get('level') != level:",
  "            mem['failures'] = {}",
  "        mem['epoch'] = epoch",
  "        mem['level'] = level",
  "        mem['visits'] = {}",
  "        mem['blocked'] = set()",
  "        mem['waiting'] = {}",
  "        mem['last'] = None",
  "        mem['position'] = None",
  "    groups = blobs(frame,actor,low,high)",
  "    old = mem.get('position')",
  "    players = []",
  "    goals = []",
  "    for g in groups:",
  "        height, width = g[2]-g[0]+1,g[3]-g[1]+1",
  "        center = ((g[0]+g[2])//2,(g[1]+g[3])//2)",
  "        if height <= int(c[7]) and width <= int(c[7]) and g[4] >= int(c[8]):",
  "            score = g[4]",
  "            if old is not None:",
  "                score -= float(c[9])*(abs(center[0]-old[0])+abs(center[1]-old[1]))",
  "            players.append((score,center))",
  "        if height >= int(c[10]) or width >= int(c[10]):",
  "            goals.append((g[4],center))",
  "    order = [int(a) for a in params['order'] if int(a) in avail]",
  "    if not order:",
  "        order = list(avail)",
  "    if not players:",
  "        index = mem.get('fallback',0)",
  "        mem['fallback'] = index+1",
  "        return (order[index % len(order)],0,0)",
  "    pos = max(players)[1]",
  "    last = mem.get('last')",
  "    vectors = mem.setdefault('vectors',{})",
  "    if last is not None:",
  "        before, action = last",
  "        dy, dx = pos[0]-before[0],pos[1]-before[1]",
  "        if dy != 0 or dx != 0:",
  "            vectors[action] = (dy,dx)",
  "        elif action != int(c[11]):",
  "            mem['blocked'].add((before,action))",
  "    mem['position'] = pos",
  "    visits = mem['visits']",
  "    visits[pos] = visits.get(pos,0)+1",
  "    target = max(goals)[1] if goals else pos",
  "    directions = []",
  "    for row in params['moves']:",
  "        a = int(row[0])",
  "        if a in avail:",
  "            v = vectors.get(a,(int(row[1])*stride,int(row[2])*stride))",
  "            directions.append((a,v[0],v[1]))",
  "    frontier = [pos]",
  "    costs = {pos:0.0}",
  "    first = {}",
  "    hazards = {}",
  "    settled = set()",
  "    destination = pos",
  "    best = float(c[12])*(abs(pos[0]-target[0])+abs(pos[1]-target[1]))",
  "    while frontier and len(settled) < int(c[13]):",
  "        p = min(frontier,key=lambda q: costs[q])",
  "        frontier.remove(p)",
  "        if p in settled:",
  "            continue",
  "        settled.add(p)",
  "        estimate = costs[p]+float(c[12])*(abs(p[0]-target[0])+abs(p[1]-target[1]))",
  "        if estimate < best or p == target:",
  "            best, destination = estimate,p",
  "        if abs(p[0]-target[0]) <= radius and abs(p[1]-target[1]) <= radius:",
  "            destination = p",
  "            break",
  "        for a,dy,dx in directions:",
  "            q = (p[0]+dy,p[1]+dx)",
  "            y,x = q",
  "            if q in settled or (p,a) in mem['blocked']:",
  "                continue",
  "            if y-radius < low or y+radius >= high or x-radius < 0 or x+radius >= frame.shape[1]:",
  "                continue",
  "            patch = frame[y-radius:y+radius+1,x-radius:x+radius+1]",
  "            if not bool(np.all((patch == ground)|(patch == actor)|(patch == beam))):",
  "                continue",
  "            hazard = bool(np.any(patch == beam))",
  "            penalty = float(c[14]) if hazard else 0.0",
  "            failure = mem['failures'].get((p,a),0)",
  "            cost = costs[p]+float(c[15])+penalty+float(c[16])*failure",
  "            if q not in costs or cost < costs[q]:",
  "                costs[q] = cost",
  "                first[q] = a if p == pos else first[p]",
  "                hazards[q] = hazard if p == pos else hazards[p]",
  "                frontier.append(q)",
  "    action = first.get(destination)",
  "    if action is None:",
  "        candidates = []",
  "        for a,dy,dx in directions:",
  "            if (pos,a) not in mem['blocked']:",
  "                q = (pos[0]+dy,pos[1]+dx)",
  "                candidates.append((visits.get(q,0)+float(c[16])*mem['failures'].get((pos,a),0),a))",
  "        action = min(candidates)[1] if candidates else int(c[11])",
  "    if hazards.get(destination,False):",
  "        edge = (pos,action)",
  "        waited = mem['waiting'].get(edge,0)",
  "        failures = mem['failures'].get(edge,0)",
  "        delay = int(c[17])+(failures*int(c[18])) % max(1,int(c[19]))",
  "        if waited < delay and int(c[11]) in avail:",
  "            mem['waiting'][edge] = waited+1",
  "            action = int(c[11])",
  "    if action not in avail:",
  "        action = order[0]",
  "    mem['last'] = (pos,action)",
  "    return (int(action),0,0)"
