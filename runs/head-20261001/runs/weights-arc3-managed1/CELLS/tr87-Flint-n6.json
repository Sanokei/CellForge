 "source_lines": [
  "def glyph(frame, y, x, size, ink):",
  "    return tuple(int(frame[y+r, x+c] == ink) for r in range(size) for c in range(size))",
  "",
  "def search(graph, start, target, actions, counts):",
  "    queue = [(start, [])]",
  "    seen = {start}",
  "    frontier = None",
  "    best = None",
  "    for node, path in queue:",
  "        if node == target:",
  "            return path",
  "        edges = graph.get(node, {})",
  "        for action in actions:",
  "            if action not in edges:",
  "                score = (len(path), counts.get((node, action), 0))",
  "                if best is None or score < best:",
  "                    best = score",
  "                    frontier = path + [action]",
  "            else:",
  "                dest = edges[action]",
  "                if dest not in seen:",
  "                    seen.add(dest)",
  "                    queue.append((dest, path + [action]))",
  "    return frontier",
  "",
  "def act(params, mem, frame, avail, info):",
  "    g = params['geometry']",
  "    size = max(1, min(8, int(abs(g[0]))))",
  "    count = max(1, min(7, int(abs(g[1]))))",
  "    stride = max(1, int(abs(g[2])))",
  "    sx = max(0, min(63-size, int(g[3])))",
  "    sy = max(0, min(63-size, int(g[4])))",
  "    oy = max(0, min(63-size, int(g[5])))",
  "    ink = int(params['colours'][0])",
  "    marker = int(params['colours'][1])",
  "    actions = [int(a) for a in params['actions'] if int(a) in avail]",
  "    if not actions:",
  "        return (avail[0], 0, 0)",
  "    sources = []",
  "    outputs = []",
  "    for i in range(count):",
  "        x = min(64-size, sx+i*stride)",
  "        sources.append(glyph(frame, sy, x, size, ink))",
  "        outputs.append(glyph(frame, oy, x, size, ink))",
  "    pairs = []",
  "    for row in params['rows']:",
  "        y = max(0, min(64-size, int(row)))",
  "        for cols in params['columns']:",
  "            x = max(0, min(64-size, int(cols[0])))",
  "            z = max(0, min(64-size, int(cols[1])))",
  "            pairs.append((glyph(frame, y, x, size, ink), glyph(frame, y, z, size, ink)))",
  "    targets = []",
  "    for source in sources:",
  "        matches = [(sum(int(a != b) for a, b in zip(source, left)), right) for left, right in pairs]",
  "        targets.append(min(matches, key=lambda item: item[0])[1])",
  "    low = max(0, min(63, int(g[6])))",
  "    high = max(low+1, min(64, int(g[7])))",
  "    points = np.argwhere(frame[low:high, :] == marker)",
  "    cursor = mem.get('cursor', 0)",
  "    if len(points):",
  "        center = float(np.sum(points[:, 1])) / len(points)",
  "        cursor = max(0, min(count-1, int((center-sx)/stride + params['control'][0])))",
  "    stamp = (info['levels'], info['resets'])",
  "    if mem.get('stamp') != stamp:",
  "        knowledge = mem.get('graph', {})",
  "        mapping = mem.get('mapping', {})",
  "        mem.clear()",
  "        mem['stamp'] = stamp",
  "        mem['graph'] = knowledge",
  "        mem['mapping'] = mapping",
  "        mem['counts'] = {}",
  "        mem['visits'] = {}",
  "        mem['probe'] = 0",
  "        mem['fail'] = 0",
  "    graph = mem['graph']",
  "    mapping = mem['mapping']",
  "    counts = mem['counts']",
  "    old = mem.get('previous')",
  "    if old is not None:",
  "        old_cursor, old_outputs, last = old",
  "        changed = [i for i in range(count) if old_outputs[i] != outputs[i]]",
  "        if cursor != old_cursor and not changed:",
  "            delta = cursor-old_cursor",
  "            if abs(delta) > count/2:",
  "                delta = delta-count if delta > 0 else delta+count",
  "            mapping[last] = ('move', delta)",
  "        elif changed:",
  "            mapping[last] = ('edit', 0)",
  "            for i in changed:",
  "                graph.setdefault(old_outputs[i], {})[last] = outputs[i]",
  "                counts[(old_outputs[i], last)] = counts.get((old_outputs[i], last), 0)+1",
  "        elif mapping.get(last, ('', 0))[0] == 'edit':",
  "            graph.setdefault(old_outputs[old_cursor], {})[last] = outputs[old_cursor]",
  "        mem['fail'] = mem['fail']+1 if cursor == old_cursor and not changed else 0",
  "    state = (cursor, tuple(outputs))",
  "    visits = mem['visits']",
  "    attempts = visits.setdefault(state, {})",
  "    edit = [a for a in actions if mapping.get(a, ('', 0))[0] == 'edit']",
  "    moves = [a for a in actions if mapping.get(a, ('', 0))[0] == 'move']",
  "    unknown = [a for a in actions if a not in mapping]",
  "    wrong = [i for i in range(count) if outputs[i] != targets[i]]",
  "    action = None",
  "    if unknown:",
  "        action = min(unknown, key=lambda a: attempts.get(a, 0))",
  "    elif cursor in wrong and edit:",
  "        path = search(graph, outputs[cursor], targets[cursor], edit, counts)",
  "        if path:",
  "            action = path[0]",
  "        else:",
  "            action = min(edit, key=lambda a: (attempts.get(a, 0), counts.get((outputs[cursor], a), 0)))",
  "    elif wrong and moves:",
  "        queue = [(cursor, None)]",
  "        seen = {cursor}",
  "        for pos, first in queue:",
  "            if pos in wrong:",
  "                action = first",
  "                break",
  "            for a in moves:",
  "                delta = mapping[a][1]",
  "                dest = (pos+delta) % count",
  "                if dest not in seen:",
  "                    seen.add(dest)",
  "                    queue.append((dest, a if first is None else first))",
  "    if action is None:",
  "        action = min(actions, key=lambda a: attempts.get(a, 0))",
  "    if attempts.get(action, 0) >= int(params['control'][1]):",
  "        alternatives = edit if cursor in wrong and edit else actions",
  "        action = min(alternatives, key=lambda a: attempts.get(a, 0))",
  "    attempts[action] = attempts.get(action, 0)+1",
  "    mem['cursor'] = cursor",
  "    mem['previous'] = (cursor, tuple(outputs), action)",
  "    return (action, 0, 0)"
 ],
