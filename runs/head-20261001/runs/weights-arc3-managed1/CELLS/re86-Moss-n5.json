 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    p = params['config']",
  "    border = int(p[0])",
  "    background = int(p[1])",
  "    marker = int(p[2])",
  "    limit = int(p[3])",
  "    stride = int(p[4])",
  "    if stride < 1:",
  "        stride = 1",
  "    epoch = (info['levels'], info['resets'])",
  "    if mem.get('epoch') != epoch:",
  "        mem.clear()",
  "        mem['epoch'] = epoch",
  "        mem['targets'] = {}",
  "        mem['seen'] = {}",
  "        mem['active'] = None",
  "    targets = mem['targets']",
  "    ring = frame == border",
  "    neighbours = np.zeros(frame.shape, dtype=int)",
  "    for dr in (-1, 0, 1):",
  "        for dc in (-1, 0, 1):",
  "            if dr != 0 or dc != 0:",
  "                neighbours += np.roll(np.roll(ring, dr, axis=0), dc, axis=1)",
  "    boxes = np.argwhere(neighbours[:limit] >= p[5])",
  "    excluded = set()",
  "    for point in boxes:",
  "        r, c = int(point[0]), int(point[1])",
  "        colour = int(frame[r, c])",
  "        if colour != border and colour != background and colour != marker:",
  "            group = targets.setdefault(colour, [])",
  "            if (r, c) not in group:",
  "                group.append((r, c))",
  "            excluded.add((r, c))",
  "    for group in targets.values():",
  "        for point in group:",
  "            excluded.add(point)",
  "    shapes = {}",
  "    for colour in targets:",
  "        points = np.argwhere(frame[:limit] == colour)",
  "        shape = set()",
  "        for point in points:",
  "            position = (int(point[0]), int(point[1]))",
  "            if position not in excluded:",
  "                shape.add(position)",
  "        shapes[colour] = shape",
  "    centers = np.argwhere(frame[:limit] == marker)",
  "    active = mem.get('active')",
  "    if len(centers) == 1:",
  "        r, c = int(centers[0][0]), int(centers[0][1])",
  "        best = -1",
  "        for colour in shapes:",
  "            count = 0",
  "            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):",
  "                rr, cc = r + dr, c + dc",
  "                if 0 <= rr < limit and 0 <= cc < frame.shape[1]:",
  "                    if int(frame[rr, cc]) == colour:",
  "                        count += 1",
  "            if count > best:",
  "                best = count",
  "                active = colour",
  "        if active in shapes:",
  "            shapes[active].add((r, c))",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        old_shapes, old_action, old_key = previous",
  "        direction = None",
  "        for index in range(len(params['order'])):",
  "            if int(params['order'][index]) == old_action:",
  "                direction = params['motion'][index]",
  "        if direction is not None and (direction[0] != 0 or direction[1] != 0):",
  "            dr, dc = int(direction[0]), int(direction[1])",
  "            best_gain = p[6]",
  "            for colour in shapes:",
  "                old = old_shapes.get(colour, set())",
  "                new = shapes[colour]",
  "                stationary = 0",
  "                moving = 0",
  "                for r, c in old:",
  "                    if (r, c) in new:",
  "                        stationary += 1",
  "                    if (r + dr, c + dc) in new:",
  "                        moving += 1",
  "                gain = moving - stationary",
  "                if gain > best_gain:",
  "                    best_gain = gain",
  "                    active = colour",
  "            if info['key'] == old_key:",
  "                failures = mem.setdefault('failures', {})",
  "                pair = (old_key, old_action)",
  "                failures[pair] = failures.get(pair, 0) + 1",
  "    mem['active'] = active",
  "    for colour in shapes:",
  "        shape = shapes[colour]",
  "        additions = []",
  "        for r, c in excluded:",
  "            for dr, dc in ((1, 0), (0, 1), (1, 1), (1, -1)):",
  "                if (r - dr, c - dc) in shape and (r + dr, c + dc) in shape:",
  "                    additions.append((r, c))",
  "                    break",
  "        for position in additions:",
  "            shape.add(position)",
  "    plans = {}",
  "    for colour in shapes:",
  "        shape = shapes[colour]",
  "        group = targets[colour]",
  "        if len(shape) == 0:",
  "            continue",
  "        shifts = {(0, 0)}",
  "        for tr, tc in group:",
  "            for r, c in shape:",
  "                dr, dc = tr - r, tc - c",
  "                if dr % stride == 0 and dc % stride == 0:",
  "                    shifts.add((dr, dc))",
  "        best_score = -1000000",
  "        best_shift = (0, 0)",
  "        current = 0",
  "        for target in group:",
  "            if target in shape:",
  "                current += 1",
  "        for dr, dc in shifts:",
  "            covered = 0",
  "            for tr, tc in group:",
  "                if (tr - dr, tc - dc) in shape:",
  "                    covered += 1",
  "            distance = abs(dr) + abs(dc)",
  "            score = p[7] * covered - p[8] * distance",
  "            if score > best_score:",
  "                best_score = score",
  "                best_shift = (dr, dc)",
  "        plans[colour] = (best_shift, current, len(group))",
  "    key = info['key']",
  "    visits = mem['seen'].setdefault(key, {})",
  "    best_score = -1000000",
  "    action = avail[0]",
  "    for index in range(len(params['order'])):",
  "        candidate = int(params['order'][index])",
  "        if candidate not in avail:",
  "            continue",
  "        dr, dc = params['motion'][index]",
  "        score = -params['priority'][index]",
  "        if active in plans:",
  "            shift, covered, total = plans[active]",
  "            before = abs(shift[0]) + abs(shift[1])",
  "            after = abs(shift[0] - dr) + abs(shift[1] - dc)",
  "            score += p[9] * (before - after)",
  "            if candidate == int(p[10]):",
  "                score = p[11] if covered == total else -p[12]",
  "        elif candidate == int(p[10]):",
  "            score -= p[13]",
  "        score -= p[14] * visits.get(candidate, 0)",
  "        score -= p[15] * mem.get('failures', {}).get((key, candidate), 0)",
  "        if score > best_score:",
  "            best_score = score",
  "            action = candidate",
  "    visits[action] = visits.get(action, 0) + 1",
  "    mem['previous'] = (shapes, action, key)",
  "    if action == 6:",
  "        clicks = mem.setdefault('clicks', {})",
  "        chosen = (int(p[16]), int(p[16]))",
  "        best = 1000000",
  "        for group in targets.values():",
  "            for point in group:",
  "                count = clicks.get(point, 0)",
  "                if count < best:",
  "                    best = count",
  "                    chosen = point",
  "        clicks[chosen] = clicks.get(chosen, 0) + 1",
  "        return (action, chosen[1], chosen[0])",
  "    return (action, int(p[16]), int(p[16]))"
 ],
