 "source_lines": [
  "def act(params, mem, frame, avail, info):",
  "    p = params['p']",
  "    order = [int(v) for v in params['order']]",
  "    level = info.get('levels', 0)",
  "    reset = info.get('resets', 0)",
  "    dark, light = int(p[0]), int(p[1])",
  "    if mem.get('level') != level:",
  "        mem.clear()",
  "        mem['level'] = level",
  "        mem['graph'] = {}",
  "        mem['tried'] = {}",
  "        mem['values'] = {}",
  "        mem['visits'] = {}",
  "        mem['effects'] = {}",
  "        mem['target'] = frame[int(p[2]):int(p[2])+int(p[4]), int(p[3]):int(p[3])+int(p[4])].copy()",
  "        seen = set()",
  "        regions = []",
  "        palette = set(int(v) for row in mem['target'] for v in row)",
  "        for y in range(int(p[5]), int(p[6])):",
  "            for x in range(int(p[7]), frame.shape[1]):",
  "                allowed = (dark, light) if level == 0 else palette",
  "                if (y, x) in seen or int(frame[y, x]) not in allowed:",
  "                    continue",
  "                todo = [(y, x)]",
  "                seen.add((y, x))",
  "                points = []",
  "                while todo:",
  "                    ry, rx = todo.pop()",
  "                    points.append((ry, rx))",
  "                    for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
  "                        ny, nx = ry+dy, rx+dx",
  "                        if ny >= int(p[5]) and ny < int(p[6]) and nx >= int(p[7]) and nx < frame.shape[1]:",
  "                            if (ny, nx) not in seen and int(frame[ny, nx]) in allowed:",
  "                                seen.add((ny, nx))",
  "                                todo.append((ny, nx))",
  "                ys = [q[0] for q in points]",
  "                xs = [q[1] for q in points]",
  "                h, w = max(ys)-min(ys)+1, max(xs)-min(xs)+1",
  "                score = len(points)-p[8]*abs(h-w)",
  "                if level > 0:",
  "                    score -= p[21]*(abs(h-int(p[4]))+abs(w-int(p[4])))",
  "                    score -= p[22]*abs(min(ys)-int(p[9]))",
  "                regions.append((score, min(ys), min(xs), h, w))",
  "        if regions:",
  "            mem['canvas'] = max(regions)[1:]",
  "        else:",
  "            mem['canvas'] = (int(p[9]), int(p[10]), int(p[4]), int(p[4]))",
  "    if mem.get('reset') != reset:",
  "        mem.pop('last', None)",
  "        mem.pop('previous', None)",
  "        mem['reset'] = reset",
  "    state = tuple(int(v) for row in frame[:int(p[6])] for v in row)",
  "    cy, cx, h, w = mem['canvas']",
  "    target = mem['target']",
  "    good = 0.0",
  "    total = 0",
  "    for y in range(h):",
  "        for x in range(w):",
  "            ty = min(target.shape[0]-1, y*target.shape[0]//max(1, h))",
  "            tx = min(target.shape[1]-1, x*target.shape[1]//max(1, w))",
  "            desired = int(target[ty, tx])",
  "            if (level > 0 or desired in (dark, light)) and cy+y < frame.shape[0] and cx+x < frame.shape[1]:",
  "                total += 1",
  "                if int(frame[cy+y, cx+x]) == desired:",
  "                    good += 1.0",
  "    quality = good/max(1, total)",
  "    graph, tried = mem['graph'], mem['tried']",
  "    values, visits = mem['values'], mem['visits']",
  "    graph.setdefault(state, {})",
  "    tried.setdefault(state, set())",
  "    values[state] = quality",
  "    visits[state] = visits.get(state, 0)+1",
  "    if 'last' in mem:",
  "        previous, action, before = mem['last']",
  "        graph.setdefault(previous, {})[action] = state",
  "        tried.setdefault(previous, set()).add(action)",
  "        effect = mem['effects'].setdefault(action, [0, 0, 0.0, 0, 0])",
  "        effect[0] += 1",
  "        effect[1] += int(previous != state)",
  "        effect[2] += quality-before",
  "        if level > 0 and 'previous' in mem:",
  "            old = mem['previous']",
  "            changes = np.argwhere(frame[:int(p[6])] != old[:int(p[6])])",
  "            painting = 0",
  "            for point in changes:",
  "                ry, rx = int(point[0]), int(point[1])",
  "                if cy <= ry < cy+h and cx <= rx < cx+w:",
  "                    painting += 1",
  "            effect[3] += painting",
  "            effect[4] += int(quality > before)",
  "    actions = [(a, 0, 0) for a in order if a in avail]",
  "    if 6 in avail:",
  "        if level == 0:",
  "            for point in params['clicks']:",
  "                actions.append((6, max(0, min(63, int(point[0]))), max(0, min(63, int(point[1])))))",
  "        else:",
  "            seen = set()",
  "            for y in range(int(p[23]), int(p[24])):",
  "                for x in range(int(p[25]), frame.shape[1]):",
  "                    colour = int(frame[y, x])",
  "                    if (y, x) in seen or colour in (int(p[26]), int(p[27])):",
  "                        continue",
  "                    todo = [(y, x)]",
  "                    seen.add((y, x))",
  "                    points = []",
  "                    while todo:",
  "                        ry, rx = todo.pop()",
  "                        points.append((ry, rx))",
  "                        for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
  "                            ny, nx = ry+dy, rx+dx",
  "                            if int(p[23]) <= ny < int(p[24]) and int(p[25]) <= nx < frame.shape[1]:",
  "                                if (ny, nx) not in seen and int(frame[ny, nx]) == colour:",
  "                                    seen.add((ny, nx))",
  "                                    todo.append((ny, nx))",
  "                    if len(points) >= int(p[28]):",
  "                        ys = [q[0] for q in points]",
  "                        xs = [q[1] for q in points]",
  "                        action = (6, (min(xs)+max(xs))//2, (min(ys)+max(ys))//2)",
  "                        if action not in actions:",
  "                            actions.append(action)",
  "    frontier = [(state, [])]",
  "    reached = {state}",
  "    index = 0",
  "    best = None",
  "    bestscore = -1000000.0",
  "    while index < len(frontier) and index < int(p[11]):",
  "        node, path = frontier[index]",
  "        index += 1",
  "        used = tried.setdefault(node, set())",
  "        for rank, action in enumerate(actions):",
  "            if action in used:",
  "                continue",
  "            effect = mem['effects'].get(action, [0, 0, 0.0, 0, 0])",
  "            activity = effect[1]/max(1, effect[0])",
  "            gain = effect[2]/max(1, effect[0])",
  "            if level == 0:",
  "                score = p[12]*values.get(node, quality)-p[13]*len(path)",
  "                score += p[14]*activity+p[15]*gain-p[16]*rank",
  "                score -= p[17]*visits.get(node, 0)",
  "            else:",
  "                score = p[29]*values.get(node, quality)-p[30]*len(path)",
  "                score += p[31]*activity+p[32]*gain-p[33]*rank",
  "                score -= p[34]*visits.get(node, 0)",
  "                if effect[0] == 0:",
  "                    score += p[35]",
  "                elif effect[1] == 0:",
  "                    score -= p[36]",
  "                if effect[3] > 0:",
  "                    score += p[37]*effect[4]/max(1, effect[0])",
  "                if action[0] == int(p[38]):",
  "                    score += p[39]/max(1, effect[0])",
  "            if score > bestscore:",
  "                bestscore, best = score, path[0] if path else action",
  "        for action, destination in graph.get(node, {}).items():",
  "            if destination not in reached and action in actions:",
  "                reached.add(destination)",
  "                frontier.append((destination, path+[action]))",
  "    if best is None:",
  "        for rank, action in enumerate(actions):",
  "            destination = graph[state].get(action)",
  "            score = p[12]*values.get(destination, quality)-p[18]*visits.get(destination, 0)-p[16]*rank",
  "            if destination == state:",
  "                score -= p[19]",
  "            if destination is None:",
  "                score += p[20]",
  "            if level > 0:",
  "                effect = mem['effects'].get(action, [0, 0, 0.0, 0, 0])",
  "                score += p[32]*effect[2]/max(1, effect[0])",
  "                score -= p[36]*int(effect[0] > 0 and effect[1] == 0)",
  "            if score > bestscore:",
  "                bestscore, best = score, action",
  "    if best is None:",
  "        best = (avail[0], 0, 0)",
  "    mem['last'] = (state, best, quality)",
  "    if level > 0:",
  "        mem['previous'] = frame.copy()",
  "    return best"
 ],
