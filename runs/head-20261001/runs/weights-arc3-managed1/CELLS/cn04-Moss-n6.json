 "n": 6,
 "source_lines": [
  "def parts(mask):",
  "    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))",
  "    result = []",
  "    while remaining:",
  "        seed = next(iter(remaining))",
  "        remaining.remove(seed)",
  "        queue = [seed]",
  "        points = []",
  "        while queue:",
  "            p = queue.pop()",
  "            points.append(p)",
  "            for q in ((p[0]-1,p[1]),(p[0]+1,p[1]),(p[0],p[1]-1),(p[0],p[1]+1)):",
  "                if q in remaining:",
  "                    remaining.remove(q)",
  "                    queue.append(q)",
  "        result.append(np.array(points))",
  "    return result",
  "def center(points):",
  "    return np.sum(points, axis=0)/max(1,len(points))",
  "def turn(points, sign):",
  "    return np.array([[sign*p[1],-sign*p[0]] for p in points])",
  "def act(params, mem, frame, avail, info):",
  "    c = params['control']",
  "    colors = params['colors']",
  "    level = info['levels']",
  "    reset = info['resets']",
  "    key = info['key']",
  "    if mem.get('level') != level:",
  "        mem['level'] = level",
  "        mem['graph'] = {}",
  "        mem['previous'] = None",
  "        mem['motion'] = {}",
  "        mem['rotation'] = float(params['signs'][0])",
  "        mem['effects'] = {}",
  "    graph = mem['graph']",
  "    node = graph.setdefault(key, {'used':{},'edges':{},'bad':{},'visits':0})",
  "    node['visits'] += 1",
  "    if 'scene' not in node:",
  "        counts = np.bincount(frame.reshape(-1), minlength=16)",
  "        background = int(np.argmax(counts))",
  "        bodies = []",
  "        for color in np.unique(frame):",
  "            color = int(color)",
  "            if color == background or color == int(colors[1]) or color == int(colors[2]):",
  "                continue",
  "            for part in parts(frame == color):",
  "                if c[0] <= len(part) <= c[1]:",
  "                    bodies.append((color,part,center(part)))",
  "        ports = [center(p) for p in parts(frame == int(colors[1])) if c[2] <= len(p) <= c[3]]",
  "        owned = [[] for b in bodies]",
  "        for port in ports:",
  "            best = float(c[4])",
  "            owner = None",
  "            for i in range(len(bodies)):",
  "                distance = float(np.min(np.sum((bodies[i][1]-port)**2,axis=1)))",
  "                if distance < best:",
  "                    best = distance",
  "                    owner = i",
  "            if owner is not None:",
  "                owned[owner].append(port)",
  "        active = None",
  "        for i in range(len(bodies)):",
  "            if bodies[i][0] == int(colors[0]) and len(owned[i]):",
  "                active = i",
  "                break",
  "        node['scene'] = (bodies,owned,active)",
  "    bodies,owned,active = node['scene']",
  "    position = None",
  "    ap = np.zeros((0,2))",
  "    if active is not None:",
  "        position = bodies[active][2]",
  "        ap = np.array(owned[active])",
  "    previous = mem.get('previous')",
  "    if previous is not None:",
  "        oldkey,oldreset,identity,oldposition,oldports = previous",
  "        oldnode = graph.get(oldkey)",
  "        if oldnode is not None:",
  "            if reset == oldreset:",
  "                oldnode['edges'][identity] = key",
  "                if key == oldkey:",
  "                    oldnode['bad'][identity] = True",
  "                effect = mem['effects'].setdefault(identity[0],[0,0])",
  "                effect[0] += 1",
  "                if key != oldkey:",
  "                    effect[1] += 1",
  "                if position is not None and oldposition is not None and len(ap) == len(oldports):",
  "                    delta = position-oldposition",
  "                    length = float(np.sum(np.abs(delta)))",
  "                    if identity[0] in [int(a) for a in params['order']] and c[5] <= length <= c[6]:",
  "                        if abs(delta[0]) < c[7] or abs(delta[1]) < c[7]:",
  "                            mem['motion'][identity[0]] = delta",
  "                    if identity[0] == int(c[8]) and len(ap):",
  "                        actual = ap-position",
  "                        best = float(c[9])",
  "                        for sign in params['signs']:",
  "                            predicted = turn(oldports-oldposition,float(sign))",
  "                            error = sum(float(np.min(np.sum((actual-p)**2,axis=1))) for p in predicted)",
  "                            if error < best:",
  "                                best = error",
  "                                mem['rotation'] = float(sign)",
  "            else:",
  "                oldnode['bad'][identity] = True",
  "    sign = mem['rotation']",
  "    if node.get('goal_sign') != sign:",
  "        bestgoal = None",
  "        if active is not None:",
  "            rp = ap-position",
  "            rb = bodies[active][1]-position",
  "            sample = rb[::max(1,int(c[10]))]",
  "            for rotation in range(int(c[11])):",
  "                vector = center(rp)",
  "                for target in range(len(bodies)):",
  "                    if target == active or not len(owned[target]):",
  "                        continue",
  "                    tp = np.array(owned[target])",
  "                    tb = bodies[target][1]",
  "                    targetvector = center(tp)-bodies[target][2]",
  "                    facing = float(np.sum((vector/(float(np.sum(vector*vector))**0.5+1e-6)+targetvector/(float(np.sum(targetvector*targetvector))**0.5+1e-6))**2))",
  "                    occupancy = np.zeros(frame.shape)",
  "                    occupancy[tb[:,0],tb[:,1]] = 1",
  "                    for port in tp:",
  "                        for ownport in rp:",
  "                            for offset in params['contacts']:",
  "                                destination = port+offset-ownport",
  "                                low = np.min(rb,axis=0)+destination",
  "                                high = np.max(rb,axis=0)+destination",
  "                                if np.any(low < c[12]) or np.any(high > c[13]):",
  "                                    continue",
  "                                movedports = rp+destination",
  "                                differences = movedports[:,None,None,:]-tp[None,:,None,:]-params['contacts'][None,None,:,:]",
  "                                distances = np.sum(differences*differences,axis=3)",
  "                                mismatch = float(np.sum(np.min(distances.reshape((len(rp),-1)),axis=1)))",
  "                                sampled = np.rint(sample+destination).astype(int)",
  "                                overlap = float(np.sum(occupancy[sampled[:,0],sampled[:,1]]))*len(rb)/max(1,len(sample))",
  "                                distance = float(np.sum(np.abs(destination-position)))/max(1.0,float(c[14]))",
  "                                cost = c[15]*mismatch+c[16]*facing+c[17]*overlap+distance+c[18]*rotation",
  "                                if bestgoal is None or cost < bestgoal[0]:",
  "                                    bestgoal = (cost,rotation,destination)",
  "                rp = turn(rp,sign)",
  "                rb = turn(rb,sign)",
  "                sample = turn(sample,sign)",
  "        node['goal'] = bestgoal",
  "        node['goal_sign'] = sign",
  "    goal = node['goal']",
  "    route = None",
  "    remaining = float(c[9])",
  "    if goal is not None:",
  "        cost,rotation,destination = goal",
  "        remaining = float(np.sum(np.abs(destination-position)))+c[19]*rotation",
  "        if rotation > 0:",
  "            route = int(c[8])",
  "        else:",
  "            distance = remaining",
  "            for i in range(len(params['order'])):",
  "                a = int(params['order'][i])",
  "                delta = mem['motion'].get(a,params['movement'][i])",
  "                trial = float(np.sum(np.abs(destination-position-delta)))",
  "                if trial < distance:",
  "                    distance = trial",
  "                    route = a",
  "    node['score'] = -remaining",
  "    candidates = []",
  "    for i in range(len(params['order'])):",
  "        a = int(params['order'][i])",
  "        if a in avail:",
  "            candidates.append(((a,0,0),float(c[20])-i*c[21]+(c[22] if a == route else 0)))",
  "    if int(c[8]) in avail:",
  "        candidates.append(((int(c[8]),0,0),float(c[23])+(c[22] if route == int(c[8]) else 0)))",
  "    if int(c[24]) in avail:",
  "        for i in range(len(bodies)):",
  "            if owned[i]:",
  "                port = owned[i][0]",
  "                base = float(c[25])",
  "                if active is None:",
  "                    base += c[26]",
  "                elif remaining <= c[27]:",
  "                    base += c[28]",
  "                if i != active:",
  "                    base += c[29]*min(node['visits']-1,c[30])",
  "                candidates.append(((int(c[24]),int(port[1]+0.5),int(port[0]+0.5)),base))",
  "    node['actions'] = candidates",
  "    best = None",
  "    bestscore = -float(c[9])*float(c[9])",
  "    for identity,base in candidates:",
  "        if node['bad'].get(identity,False):",
  "            continue",
  "        destination = node['edges'].get(identity)",
  "        score = base-c[31]*node['used'].get(identity,0)",
  "        if identity not in node['used']:",
  "            score += c[32]",
  "        if destination in graph:",
  "            score -= c[33]*graph[destination]['visits']",
  "            score += c[34]*(graph[destination].get('score',node['score'])-node['score'])",
  "        effect = mem['effects'].get(identity[0])",
  "        if effect is not None:",
  "            score += c[35]*effect[1]/max(1,effect[0])",
  "        if score > bestscore:",
  "            bestscore = score",
  "            best = identity",
  "    if node['visits'] > c[36] and node.get('searched',0) < int(c[37]):",
  "        node['searched'] = node.get('searched',0)+1",
  "        queue = [key]",
  "        depth = {key:0}",
  "        first = {}",
  "        head = 0",
  "        frontier = None",
  "        valuebest = -float(c[9])*float(c[9])",
  "        while head < len(queue) and head < int(c[38]):",
  "            state = queue[head]",
  "            head += 1",
  "            record = graph[state]",
  "            untested = [base for identity,base in record.get('actions',[]) if identity not in record['used'] and not record['bad'].get(identity,False)]",
  "            if state != key and untested:",
  "                value = max(untested)+c[39]*record.get('score',-c[9])-c[40]*depth[state]",
  "                if value > valuebest:",
  "                    valuebest = value",
  "                    frontier = first[state]",
  "            for identity,destination in record['edges'].items():",
  "                if destination in graph and destination not in depth and not record['bad'].get(identity,False):",
  "                    depth[destination] = depth[state]+1",
  "                    first[destination] = identity if state == key else first[state]",
  "                    queue.append(destination)",
  "        if frontier is not None:",
  "            best = frontier",
  "    if best is None:",
  "        best = (int(avail[0]),0,0)",
  "    node['used'][best] = node['used'].get(best,0)+1",
  "    mem['previous'] = (key,reset,best,position,ap.copy())",
  "    return best"
 ],
