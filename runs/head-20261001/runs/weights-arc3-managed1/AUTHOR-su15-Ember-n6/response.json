[{"game":"su15","source_lines":["def parts(frame, top, bottom, excluded):","    seen = np.zeros(frame.shape, dtype=bool)","    out = []","    for y in range(top, bottom):","        for x in range(frame.shape[1]):","            c = int(frame[y, x])","            if seen[y, x] or c in excluded:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                yy, xx = todo.pop()","                cells.append((yy, xx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = yy + dy, xx + dx","                    if top <= ny < bottom and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:","                        seen[ny, nx] = True","                        todo.append((ny, nx))","            xs = [v[1] for v in cells]","            ys = [v[0] for v in cells]","            out.append((c, int(round(sum(xs) / len(xs))), int(round(sum(ys) / len(ys))), len(cells), max(xs) - min(xs) + 1, max(ys) - min(ys) + 1))","    return out","def act(params, mem, frame, avail, info):","    p = params['settings']","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if 'levels' not in mem:","        mem['levels'] = {}","        mem['wins'] = {}","    if mem.get('level') != level:","        if 'trace' in mem and level > mem.get('level', level):","            book = mem['wins'].setdefault(mem['level'], {})","            for state, action in mem['trace']:","                book[state] = action","        mem['level'] = level","        mem['trace'] = []","        mem.pop('last', None)","    data = mem['levels'].setdefault(level, {'edges': {}, 'pairs': {}, 'bad': {}, 'visits': {}, 'effects': {}})","    if mem.get('reset') != reset:","        if 'last' in mem:","            old, action, oldpos = mem['last']","            data['bad'][(old, action)] = data['bad'].get((old, action), 0) + p[17]","        mem['reset']