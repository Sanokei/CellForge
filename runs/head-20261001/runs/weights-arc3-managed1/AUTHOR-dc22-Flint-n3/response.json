[{"game":"dc22","source_lines":["def act(params, mem, frame, avail, info):","    c = params['cfg']","    actions = params['actions']","    vectors = params['vectors']","    player = int(c[0])","    ground = int(c[1])","    background = int(c[2])","    colours = [int(c[3]), int(c[4])]","    goals = [int(c[5]), int(c[6])]","    split = max(1, min(frame.shape[1], int(c[7])))","    top = max(0, min(frame.shape[0] - 1, int(c[8])))","    bottom = max(top + 1, min(frame.shape[0], int(c[9])))","    unit = max(1, int(c[10]))","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level:","        mem.clear()","        mem['level'] = level","        mem['visits'] = {}","        mem['edges'] = {}","        mem['touched'] = {}","        mem['motion'] = {}","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('previous', None)","        mem['touched'] = {}","    points = np.argwhere(frame[top:bottom, :split] == player)","    if len(points) == 0:","        for a in actions:","            if int(a) in avail:","                return (int(a), 0, 0)","        return (avail[0], 0, 0)","    px = int(np.min(points[:, 1]))","    py = int(np.min(points[:, 0])) + top","    ox = px % unit","    oy = py % unit","    width = (split - ox) // unit","    height = (bottom - oy) // unit","    sx = (px - ox) // unit","    sy = (py - oy) // unit","    signature = tuple(tuple(row) for row in frame[top:bottom, :split])","    visits = mem['visits']","    visits[signature] = visits.get(signature, 0) + 1","    if 'previous' in mem:","        old = mem['previous']","        chosen = mem['chosen']","        mem['edges'].setdefault(old, {})[chosen] = signature","        oldpos = mem['position']","        if chosen[0] != 6:","            dx = px - oldpos[0]","            dy = py - oldpos[1]","            if abs(dx) + abs(dy) > 0 and abs(dx) + abs(dy) <= c[11]:","                mem['motion'][chosen[0]] = (dx, dy)","    hats = []","    for colour in colours:","        cells = np.argwhere(frame[top:bottom, split:] == colour)","        if len(cells):","            hats.append((6, split + int(np.sum(cells[:, 1]) / len(cells)), top + int(np.sum(cells[:, 0]) / len(cells))))","        else:","            hats.append(None)","    tiles = {}","    destinations = [[], []]","    for gy in range(height):","        y = oy + gy * unit","        if y < top:","            continue","        for gx in range(width):","            x = ox + gx * unit","            block = frame[y:y + unit, x:x + unit]","            kind = -1","            solid = False","            for k in range(len(colours)):","                amount = int(np.sum(block == colours[k]))","                if amount > 0:","                    kind = k","                    solid = amount >= block.size * c[12]","            ordinary = bool(np.any(block == ground) or np.any(block == player))","            for k in range(len(goals)):","                if np.any(block == goals[k]):","                    ordinary = True","                    destinations[k].append((gx, gy))","            if ordinary:","                tiles[(gx, gy)] = (-1, True)","            elif kind >= 0:","                tiles[(gx, gy)] = (kind, solid)","    tiles[(sx, sy)] = (-1, True)","    for k in range(len(goals)):","        if (sx, sy) in destinations[k]:","            mem['touched'][goals[k]] = True","    target_cells = []","    for k in range(len(goals)):","        if len(destinations[k]) and not mem['touched'].get(goals[k], False):","            target_cells = destinations[k]","            break","    if len(target_cells) == 0:","        target_cells = destinations[-1]","    start = (sx, sy, 0)","    queue = [start]","    first = {start: None}","    depth = {start: 0}","    cursor = 0","    winner = None","    alternatives = []","    known = mem['edges'].get(signature, {})","    while cursor < len(queue):","        state = queue[cursor]","        cursor += 1","        gx, gy, mode = state","        if (gx, gy) in target_cells and state != start:","            winner = first[state]","            break","        if first[state] is not None:","            distance = width + height","            for tx, ty in target_cells:","                distance = min(distance, abs(gx - tx) + abs(gy - ty))","            score = -c[13] * distance - c[14] * depth[state]","            action = first[state]","            outcome = known.get(action)","            if outcome is not None:","                score -= c[15] * visits.get(outcome, 0)","            alternatives.append((score, action))","        transitions = []","        for j in range(len(actions)):","            a = int(actions[j])","            if a not in avail or a == 6:","                continue","            displacement = mem['motion'].get(a)","            if displacement is None:","                displacement = (float(vectors[j][0]), float(vectors[j][1]))","            dx = int(round(displacement[0] / unit))","            dy = int(round(displacement[1] / unit))","            nx = gx + dx","            ny = gy + dy","            tile = tiles.get((nx, ny))","            if tile is None:","                continue","            kind, solid = tile","            if kind >= 0:","                bit = 1 << kind","                if mode & bit:","                    solid = not solid","            if solid:","                transitions.append(((nx, ny, mode), (a, 0, 0)))","        if 6 in avail:","            for k in range(len(hats)):","                if hats[k] is not None:","                    transitions.append(((gx, gy, mode ^ (1 << k)), hats[k]))","        for nextstate, action in transitions:","            if nextstate in first:","                continue","            initial = action if state == start else first[state]","            outcome = known.get(initial)","            if outcome == signature:","                continue","            first[nextstate] = initial","            depth[nextstate] = depth[state] + 1","            queue.append(nextstate)","    if winner is None:","        bestscore = -1000000000.0","        for score, action in alternatives:","            if score > bestscore:","                bestscore = score","                winner = action","    if winner is None:","        candidates = []","        for a in actions:","            if int(a) in avail:","                candidates.append((int(a), 0, 0))","        if 6 in avail:","            for hat in hats:","                if hat is not None:","                    candidates.append(hat)","        bestscore = -1000000000.0","        for j in range(len(candidates)):","            action = candidates[j]","            outcome = known.get(action)","            score = -c[16] * j","            if outcome is None:","                score += c[17]","            else:","                score -= c[15] * visits.get(outcome, 0)","                if outcome == signature:","                    score -= c[18]","            if score > bestscore:","                bestscore = score","                winner = action","    if winner is None:","        winner = (avail[0], 0, 0)","    mem['previous'] = signature","    mem['chosen'] = winner","    mem['position'] = (px, py)","    return winner"],"shapes":{"cfg":[19],"actions":[4],"vectors":[4,2]},"params":{"cfg":[14,2,4,8,9,13,11,30,10,54,2,8,0.75,3,0.12,9,0.04,20,40],"actions":[1,4,2,3],"vectors":[[0,-2],[2,0],[0,2],[-2,0]]},"rationale":"Plans over visible two-pixel platforms and hypothetical colour-switch states. Solid and checkerboard bridges have different traversability; clicking the corresponding hat is modeled as inverting that colour's bridges. Searches for the purple objective before the small exit, learns actual movement and failed transitions, and retains explored transitions across resets. This replaces centroid chasing with terrain-aware navigation and deliberate switching.","cannot_express":false}]