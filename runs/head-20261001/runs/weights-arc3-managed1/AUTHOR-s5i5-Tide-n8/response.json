[{"game":"s5i5","source_lines":["def groups(frame, colour):","    left = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))","    out = []","    while left:","        start = min(left)","        left.remove(start)","        todo = [start]","        cells = []","        while todo:","            y, x = todo.pop()","            cells.append((y, x))","            for dy in (-1, 0, 1):","                for dx in (-1, 0, 1):","                    q = (y + dy, x + dx)","                    if q in left:","                        left.remove(q)","                        todo.append(q)","        out.append(cells)","    return out","def measure(frame, p):","    markers = []","    targets = []","    for g in groups(frame, int(p[1])):","        x = sum(q[1] for q in g) / len(g)","        y = sum(q[0] for q in g) / len(g)","        if len(g) <= p[2]:","            markers.append((x, y))","        elif p[3] <= len(g) <= p[4]:","            targets.append((x, y))","    return tuple(sorted(markers)), tuple(sorted(targets))","def metric(state, targets):","    if not targets or not state:","        return 1000.0","    options = [(0.0, set())]","    for x, y in state:","        nxt = []","        for value, used in options:","            for j, target in enumerate(targets):","                if j not in used:","                    nxt.append((value + abs(x - target[0]) + abs(y - target[1]), used | {j}))","        nxt.sort(key=lambda q: q[0])","        options = nxt[:64]","        if not options:","            return 1000.0","    return options[0][0]","def predict(state, delta):","    return tuple((q[0] + d[0], q[1] + d[1]) for q, d in zip(state, delta))","def act(params, mem, frame, avail, info):","    p = params['settings']","    epoch = (info['levels'], info['resets'])","    state, targets = measure(frame, p)","    if mem.get('epoch') != epoch:","        library = mem.get('library', {})","        old = mem.get('epoch')","        if old is not None and info['levels'] > old[0]:","            library[old[0]] = (mem.get('models', {}), mem.get('history', []))","        mem.clear()","        mem['library'] = library","        mem['epoch'] = epoch","        controls = []","        for g in groups(frame, int(p[0])):","            if p[5] <= len(g) <= p[6]:","                cy = sum(q[0] for q in g) / len(g)","                cx = sum(q[1] for q in g) / len(g)","                if cy < p[7]:","                    y, x = min(g, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))","                    controls.append((x, y))","        mem['actions'] = sorted(controls)","        saved = library.get(info['levels'], ({}, []))","        mem['models'] = dict(saved[0])","        mem['success'] = dict(saved[1])","        mem['edges'] = {}","        mem['pairs'] = {}","        mem['uses'] = {}","        mem['visits'] = {}","        mem['history'] = []","    actions = mem['actions']","    if not actions or not state:","        return (avail[0], int(p[8]), int(p[9]))","    models = mem['models']","    edges = mem['edges']","    if 'last' in mem:","        before, action = mem['last']","        edges[(before, action)] = state","        if len(before) == len(state):","            remaining = list(state)","            matched = []","            for q in before:","                r = min(remaining, key=lambda r: abs(r[0] - q[0]) + abs(r[1] - q[1]))","                remaining.remove(r)","                matched.append(r)","            delta = tuple((r[0] - q[0], r[1] - q[1]) for q, r in zip(before, matched))","            if any(abs(d[0]) + abs(d[1]) > p[10] for d in delta):","                models[action] = delta","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    pairs = mem['pairs']","    uses = mem['uses']","    chosen = mem['success'].get(state)","    if chosen is not None and pairs.get((state, chosen), 0) >= p[11]:","        chosen = None","    unknown = [a for a in range(len(actions)) if a not in models and uses.get(a, 0) < p[12]]","    if chosen is None and unknown:","        chosen = min(unknown, key=lambda a: (uses.get(a, 0), a))","    if chosen is None:","        beam = [(state, None)]","        reached = {state}","        best = float('inf')","        solved = False","        for depth in range(int(p[13])):","            candidates = []","            for board, first in beam:","                for a, delta in models.items():","                    if len(delta) != len(board):","                        continue","                    nxt = edges.get((board, a), predict(board, delta))","                    if nxt in reached:","                        continue","                    valid = True","                    for x, y in nxt:","                        if x < p[14] or y < p[14] or x >= frame.shape[1] - p[14] or y >= frame.shape[0] - p[14]:","                            valid = False","                        elif int(frame[int(y), int(x)]) == int(p[15]):","                            valid = False","                    if not valid:","                        continue","                    reached.add(nxt)","                    initial = a if first is None else first","                    cost = metric(nxt, targets)","                    value = cost + p[16] * visits.get(nxt, 0) + p[17] * depth","                    if first is None:","                        value += p[18] * pairs.get((state, a), 0)","                    if value < best:","                        best = value","                        chosen = initial","                    if cost <= p[19]:","                        chosen = initial","                        solved = True","                        break","                    candidates.append((value, nxt, initial))","                if solved:","                    break","            if solved or not candidates:","                break","            candidates.sort(key=lambda q: q[0])","            beam = [(q[1], q[2]) for q in candidates[:int(p[20])]]","    if chosen is None or pairs.get((state, chosen), 0) >= p[11]:","        chosen = min(range(len(actions)), key=lambda a: p[21] * pairs.get((state, a), 0) + p[22] * visits.get(edges.get((state, a)), 0) + p[23] * uses.get(a, 0))","    pairs[(state, chosen)] = pairs.get((state, chosen), 0) + 1","    uses[chosen] = uses.get(chosen, 0) + 1","    mem['history'].append((state, chosen))","    mem['last'] = (state, chosen)","    x, y = actions[chosen]","    return (6 if 6 in avail else avail[0], int(x), int(y))"],"shapes":{"settings":[24]},"params":{"settings":[4,13,1,3,12,6,200,62,31,31,0.1,2,4,24,1,15,4,0.05,12,0,160,40,15,0.03]},"rationale":"Rebuilds click controls from colour-4 components, including bottom-row controls omitted previously. Learns marker displacement transitions online, transferring the donor's bounded beam search and observed-edge overrides rather than its tile permutations. Uses one-to-one marker-to-target assignment, obstacle rejection, repeated-state escape, and retains successful visual state-action mappings across resets. All coordinates come from the current frame.","cannot_express":false}]