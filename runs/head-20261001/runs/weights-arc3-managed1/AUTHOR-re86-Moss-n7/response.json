[{"game":"re86","source_lines":["def act(params, mem, frame, avail, info):","    cfg = params['config']","    level = info['levels']","    if mem.get('level') != level or mem.get('reset') != info['resets']:","        mem['level'] = level","        mem['reset'] = info['resets']","        mem['targets'] = {}","        mem['models'] = {}","        mem['visits'] = {}","        mem['previous'] = None","        mem['active'] = int(params['colours'][0])","    radius = int(cfg[0])","    templates = []","    for kind in range(len(params['families'])):","        offsets = set()","        for d in range(-radius, radius + 1):","            if params['families'][kind] == 0:","                offsets.add((d, 0))","                offsets.add((0, d))","            elif params['families'][kind] == 1:","                offsets.add((d, d))","                offsets.add((d, -d))","            else:","                edge = radius - abs(d)","                offsets.add((d, edge))","                offsets.add((d, -edge))","        templates.append(offsets)","    border = frame == int(cfg[1])","    neighbours = np.roll(border, 1, axis=0).astype(int) + np.roll(border, -1, axis=0).astype(int) + np.roll(border, 1, axis=1).astype(int) + np.roll(border, -1, axis=1).astype(int)","    centres = np.argwhere(neighbours >= cfg[2])","    for p in centres:","        row = int(p[0])","        col = int(p[1])","        colour = int(frame[row, col])","        if colour in params['colours']:","            targets = mem['targets'].setdefault(colour, [])","            if (row, col) not in targets:","                targets.append((row, col))","    models = {}","    for value in params['colours']:","        colour = int(value)","        pixels = np.argwhere((frame[:int(cfg[3])] == colour) & (neighbours[:int(cfg[3])] < cfg[2]))","        if len(pixels) < cfg[4]:","            continue","        best = -1000000","        old = mem['models'].get(colour)","        for kind in range(len(templates)):","            votes = np.zeros(frame.shape)","            for p in pixels:","                for dr, dc in templates[kind]:","                    rr = int(p[0]) - dr","                    cc = int(p[1]) - dc","                    if 0 <= rr < int(cfg[3]) and 0 <= cc < frame.shape[1]:","                        votes[rr, cc] += 1","            peak = np.max(votes)","            candidates = np.argwhere(votes >= peak - cfg[5])","            for p in candidates:","                rr = int(p[0])","                cc = int(p[1])","                score = votes[rr, cc] * cfg[6] - params['model_priority'][kind]","                if old is not None:","                    score -= cfg[7] * (abs(rr - old[0]) + abs(cc - old[1]))","                if score > best:","                    best = score","                    models[colour] = (rr, cc, kind)","    zeros = np.argwhere(frame[:int(cfg[3])] == int(cfg[8]))","    active = mem['active']","    if len(zeros) > 0 and len(models) > 0:","        zr = int(zeros[0][0])","        zc = int(zeros[0][1])","        distance = 1000000","        for colour, model in models.items():","            gap = abs(zr - model[0]) + abs(zc - model[1])","            if gap < distance:","                distance = gap","                active = colour","                models[colour] = (zr, zc, model[2])","    previous = mem.get('previous')","    effects = mem.setdefault('effects', {})","    transitions = mem.setdefault('transitions', {})","    if previous is not None:","        previous_colour, pr, pc, last, old_key = previous","        changes = []","        for colour, model in models.items():","            old = mem['models'].get(colour)","            if old is not None and (old[0] != model[0] or old[1] != model[1]):","                changes.append(colour)","        if len(zeros) == 0 and len(changes) == 1:","            active = changes[0]","        if last == int(cfg[9]) and active != previous_colour:","            transitions[previous_colour] = active","        if active == previous_colour and active in models and last != int(cfg[9]):","            dr = models[active][0] - pr","            dc = models[active][1] - pc","            if abs(dr) + abs(dc) > 0 and abs(dr) + abs(dc) <= cfg[10]:","                effects[last] = (dr, dc)","        results = mem.setdefault('results', {})","        results[(old_key, last)] = info['key']","    mem['active'] = active","    mem['models'] = models","    visits = mem['visits']","    key = info['key']","    visits[key] = visits.get(key, 0) + 1","    if active not in models:","        index = mem.get('fallback', 0)","        mem['fallback'] = index + 1","        action = int(params['order'][index % len(params['order'])])","        if action not in avail:","            action = avail[index % len(avail)]","        return (action, int(cfg[11]), int(cfg[11]))","    row, col, kind = models[active]","    targets = mem['targets'].get(active, [])","    offsets = templates[kind]","    step = max(1, int(cfg[12]))","    best = -1000000","    destination = (row, col)","    coverage = 0","    for rr in range(row % step, int(cfg[3]), step):","        for cc in range(col % step, frame.shape[1], step):","            covered = 0","            for tr, tc in targets:","                if (tr - rr, tc - cc) in offsets:","                    covered += 1","            distance = abs(rr - row) + abs(cc - col)","            score = cfg[13] * covered - cfg[14] * distance","            if score > best:","                best = score","                destination = (rr, cc)","                coverage = covered","    here = 0","    for tr, tc in targets:","        if (tr - row, tc - col) in offsets:","            here += 1","    action = None","    if len(targets) > 0 and here == len(targets) and int(cfg[9]) in avail:","        action = int(cfg[9])","    if action is None:","        best = -1000000","        for index in range(len(params['order'])):","            candidate = int(params['order'][index])","            if candidate not in avail:","                continue","            dr, dc = effects.get(candidate, (params['directions'][index][0], params['directions'][index][1]))","            before = abs(destination[0] - row) + abs(destination[1] - col)","            after = abs(destination[0] - row - dr) + abs(destination[1] - col - dc)","            score = cfg[15] * (before - after) - params['priority'][index]","            if candidate == int(cfg[9]):","                score = cfg[16] if before == 0 else -cfg[17]","            result = mem.get('results', {}).get((key, candidate))","            if result is not None:","                score -= cfg[18] * visits.get(result, 0)","                if result == key:","                    score -= cfg[19]","            if score > best:","                best = score","                action = candidate","    if action is None:","        action = avail[0]","    mem['previous'] = (active, row, col, action, key)","    if action == 6:","        clicks = mem.setdefault('clicks', {})","        points = []","        for group in mem['targets'].values():","            points.extend(group)","        if len(points) > 0:","            chosen = points[0]","            for point in points:","                if clicks.get(point, 0) < clicks.get(chosen, 0):","                    chosen = point","            clicks[chosen] = clicks.get(chosen, 0) + 1","            return (action, chosen[1], chosen[0])","    return (action, int(cfg[11]), int(cfg[11]))"],"shapes":{"config":[20],"colours":[4],"families":[3],"model_priority":[3],"order":[5],"directions":[5,2],"priority":[5]},"params":{"config":[13,4,3,63,8,0,10,0.02,0,5,6,32,3,700,1,10,20,15,8,60],"colours":[9,11,12,13],"families":[0,1,2],"model_priority":[0,0.1,0.2],"order":[1,2,3,4,5],"directions":[[-3,0],[3,0],[0,-3],[0,3],[0,0]],"priority":[0,0.1,0.2,0.3,0.4]},"rationale":"Preserves matching-colour cross alignment while extending perception to the additional colours and diagonal or diamond outlines visible after the first level. Fits movable outlines independently of bordered targets, remembers targets when obscured, and searches reachable centres for simultaneous coverage. Online action-result pairs identify movement and selector transitions, while observed successor visits discourage repeated failures. Newly learned transitions come from actual frames rather than a replayed action sequence.","cannot_express":false}]