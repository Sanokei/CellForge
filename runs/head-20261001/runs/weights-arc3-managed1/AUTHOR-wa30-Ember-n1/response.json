[{"game":"wa30","source_lines":["def act(params, mem, frame, avail, info):","    cfg = params['config']","    agent = int(cfg[0])","    background = int(cfg[1])","    target = int(cfg[2])","    marker = int(cfg[3])","    danger = int(cfg[4])","    stride = float(cfg[5])","    radius = float(cfg[6])","    points = np.argwhere(frame == agent)","    if len(points) == 0:","        action = int(cfg[7])","        if action not in avail:","            action = avail[0]","        return (action, 0, 0)","    pos = np.sum(points, axis=0) / len(points)","    level = info['levels']","    reset = info['resets']","    if mem.get('level') != level or mem.get('reset') != reset:","        mem['level'] = level","        mem['reset'] = reset","        mem['visits'] = {}","        mem['states'] = {}","        mem['objects'] = {}","        mem['probed'] = []","        mem['previous'] = None","        mem['focus'] = None","        mem['stall'] = 0","    moves = mem.setdefault('moves', {})","    quality = mem.setdefault('quality', {})","    previous = mem.get('previous')","    if previous is not None:","        action = previous['action']","        delta = pos - previous['pos']","        magnitude = float(np.sum(np.abs(delta)))","        changed = float(np.sum(frame != previous['frame']))","        reward = 0.0","        if magnitude > float(cfg[8]) and magnitude < float(cfg[9]):","            if action in moves:","                moves[action] = moves[action] * float(cfg[10]) + delta * (1.0 - float(cfg[10]))","            else:","                moves[action] = delta","            reward += float(cfg[11])","        if changed == 0:","            reward -= float(cfg[12])","            mem['stall'] += 1","        else:","            mem['stall'] = 0","        goal = previous['goal']","        if goal is not None:","            before = float(np.sum(np.abs(previous['pos'] - np.array(goal))))","            after = float(np.sum(np.abs(pos - np.array(goal))))","            reward += float(cfg[13]) * (before - after) / stride","        quality[action] = quality.get(action, 0.0) * float(cfg[14]) + reward * (1.0 - float(cfg[14]))","        transition = (previous['cell'], action)","        mem.setdefault('blocked', {})[transition] = magnitude <= float(cfg[8])","    cell = (int(pos[0] / stride), int(pos[1] / stride))","    visits = mem['visits']","    visits[cell] = visits.get(cell, 0) + 1","    states = mem['states']","    key = info['key']","    states[key] = states.get(key, 0) + 1","    mask = (frame == target) | (frame == marker)","    remaining = set()","    for point in np.argwhere(mask):","        remaining.add((int(point[0]), int(point[1])))","    objects = []","    while remaining:","        seed = next(iter(remaining))","        remaining.remove(seed)","        stack = [seed]","        component = []","        target_count = 0","        while stack:","            point = stack.pop()","            component.append(point)","            if int(frame[point[0], point[1]]) == target:","                target_count += 1","            for offset in params['neighbors']:","                neighbor = (point[0] + int(offset[0]), point[1] + int(offset[1]))","                if neighbor in remaining:","                    remaining.remove(neighbor)","                    stack.append(neighbor)","        if len(component) >= int(cfg[15]):","            center = np.sum(np.array(component), axis=0) / len(component)","            ident = (int(center[0] / stride), int(center[1] / stride))","            objects.append((ident, center, target_count))","    chosen = None","    best = None","    for ident, center, target_count in objects:","        record = mem['objects'].setdefault(ident, {'visits': 0, 'last': -float(cfg[16])})","        distance = float(np.sum(np.abs(pos - center))) / stride","        score = distance * float(cfg[17]) + record['visits'] * float(cfg[18])","        if target_count > 0:","            score += float(cfg[19])","        if mem.get('focus') == ident:","            score -= float(cfg[20])","        if info['step'] - record['last'] < float(cfg[21]):","            score += float(cfg[22])","        if best is None or score < best:","            best = score","            chosen = (ident, center)","    goal = None","    interact = False","    if chosen is not None:","        ident, center = chosen","        mem['focus'] = ident","        goal = center","        if float(np.sum(np.abs(pos - center))) <= radius:","            record = mem['objects'][ident]","            record['visits'] += 1","            record['last'] = info['step']","            mem['focus'] = None","            interact = True","    probed = mem['probed']","    action = None","    for value in params['order']:","        candidate = int(value)","        if candidate in avail and candidate not in probed:","            action = candidate","            probed.append(candidate)","            break","    if action is None and interact and int(cfg[7]) in avail:","        action = int(cfg[7])","    if action is None:","        best = None","        for index in range(len(params['order'])):","            candidate = int(params['order'][index])","            if candidate not in avail:","                continue","            vector = moves.get(candidate, params['vectors'][index] * stride)","            predicted = pos + vector","            next_cell = (int(predicted[0] / stride), int(predicted[1] / stride))","            score = float(params['bias'][index]) + quality.get(candidate, 0.0) * float(cfg[23])","            score -= visits.get(next_cell, 0) * float(cfg[24])","            if mem.setdefault('blocked', {}).get((cell, candidate), False):","                score -= float(cfg[25])","            if goal is not None:","                before = float(np.sum(np.abs(pos - goal)))","                after = float(np.sum(np.abs(predicted - goal)))","                score += (before - after) * float(cfg[26]) / stride","            row = int(predicted[0])","            col = int(predicted[1])","            if row < 0 or col < 0 or row >= frame.shape[0] or col >= frame.shape[1]:","                score -= float(cfg[27])","            else:","                if int(frame[row, col]) == danger:","                    score -= float(cfg[28])","                if int(frame[row, col]) == background:","                    score += float(cfg[29])","            if states[key] > int(cfg[30]):","                score -= visits.get(next_cell, 0) * float(cfg[31])","            if candidate == int(cfg[7]):","                score -= float(cfg[32])","                if mem['stall'] >= int(cfg[33]):","                    score += float(cfg[34])","            if best is None or score > best:","                best = score","                action = candidate","    if action is None:","        action = avail[0]","    mem['previous'] = {'action': action, 'pos': pos.copy(), 'frame': frame.copy(), 'goal': None if goal is None else list(goal), 'cell': cell}","    return (action, 0, 0)"],"shapes":{"config":[35],"order":[5],"vectors":[5,2],"bias":[5],"neighbors":[4,2]},"params":{"config":[14,1,2,9,3,4,3.5,5,0.5,12,0.25,1,5,0.8,0.8,2,100,1,12,5,2.5,8,20,0.3,1.2,9,4,25,18,0.2,2,2,3,4,8],"order":[1,2,3,4,5],"vectors":[[0,-1],[0,1],[-1,0],[1,0],[0,0]],"bias":[0.04,0.03,0.02,0.01,0],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Identifies the colour-14 player and connected colour-9 and colour-2 goal cues. Probes every keyboard action, learns actual displacement and goal-distance rewards from frame changes, and penalizes blocked transitions. Visits smaller marked objects before the larger target, tries interaction on contact, and uses position and frame visitation counts to escape loops. Tensor values determine perception, movement priors, target selection, exploration and action scoring.","cannot_express":false}]