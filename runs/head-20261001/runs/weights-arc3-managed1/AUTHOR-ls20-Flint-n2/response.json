[{"game":"ls20","source_lines":["def act(params, mem, frame, avail, info):","    c = params['colors']","    q = params['cfg']","    directions = params['directions']","    level = info['levels']","    reset = info['resets']","    if mem.get('level') != level or mem.get('reset') != reset:","        mem.clear()","        mem['level'] = level","        mem['reset'] = reset","        mem['phase'] = 0","        mem['blocked'] = {}","        mem['visits'] = {}","        mem['attempts'] = {}","        mem['fail'] = 0","    stride = max(1, int(abs(q[0])))","    half = max(0, int(abs(q[1])))","    ceiling = int(q[2])","    points = np.argwhere((frame == int(c[0])) & (np.arange(frame.shape[0])[:, None] < ceiling))","    if len(points) == 0:","        action = avail[int(abs(q[3])) % len(avail)]","        return (action, 0, 0)","    x = int(np.sum(points[:, 1]) / len(points) + q[4])","    y = int(np.sum(points[:, 0]) / len(points) + q[5])","    pos = (x, y)","    old = mem.get('pos')","    last = mem.get('last')","    phase = mem['phase']","    blocked = mem['blocked']","    if old is not None and last is not None:","        if old == pos:","            blocked[(phase, old, last)] = True","            mem['fail'] += 1","        else:","            mem['fail'] = 0","            dx = pos[0] - old[0]","            dy = pos[1] - old[1]","            if abs(dx) + abs(dy) > 0 and abs(dx) + abs(dy) < q[6]:","                mem['stride'] = abs(dx) + abs(dy)","    stride = int(mem.get('stride', stride))","    markers = np.argwhere(((frame == int(c[2])) | (frame == int(c[3]))) & (np.arange(frame.shape[0])[:, None] < ceiling))","    targets = []","    for p in markers:","        if int(p[1]) > int(q[7]):","            targets.append((int(p[1]), int(p[0])))","    touched = False","    for tx, ty in targets:","        if abs(x - tx) <= half and abs(y - ty) <= half:","            touched = True","    if phase == 0 and (touched or len(targets) == 0):","        phase = 1","        mem['phase'] = phase","        mem['fail'] = 0","        mem['goalsteps'] = 0","    goals = np.argwhere((frame == int(c[1])) & (np.arange(frame.shape[0])[:, None] < int(q[8])))","    goal = None","    if len(goals) > 0:","        goal = (int(np.sum(goals[:, 1]) / len(goals)), int(np.sum(goals[:, 0]) / len(goals)))","    if phase == 1:","        mem['goalsteps'] = mem.get('goalsteps', 0) + 1","        near = goal is not None and abs(x - goal[0]) + abs(y - goal[1]) <= q[9]","        if (near and mem['fail'] >= int(q[10])) or mem['goalsteps'] > int(q[11]):","            phase = 0","            mem['phase'] = phase","            mem['blocked'] = {}","            blocked = mem['blocked']","            mem['fail'] = 0","            mem['goalsteps'] = 0","    if phase == 1 and goal is not None:","        targets = [goal]","    if len(targets) == 0 and goal is not None:","        targets = [goal]","    visits = mem['visits']","    visitkey = (phase, pos)","    visits[visitkey] = visits.get(visitkey, 0) + 1","    legal = []","    for row in directions:","        action = int(row[0])","        if action in avail:","            legal.append((action, int(row[1]), int(row[2]), float(row[3])))","    if len(legal) == 0:","        return (avail[0], 0, 0)","    queue = [pos]","    first = {pos: None}","    depth = {pos: 0}","    head = 0","    best = None","    bestscore = -1000000.0","    while head < len(queue) and head < int(q[12]):","        node = queue[head]","        head += 1","        if node != pos:","            distance = 1000","            for tx, ty in targets:","                d = max(0, abs(node[0] - tx) - half) + max(0, abs(node[1] - ty) - half)","                distance = min(distance, d)","            if len(targets) == 0:","                distance = 0","            score = -distance * q[13] - depth[node] * q[14] - visits.get((phase, node), 0) * q[15]","            if score > bestscore:","                bestscore = score","                best = first[node]","        for action, dx, dy, priority in legal:","            if blocked.get((phase, node, action), False):","                continue","            dest = (node[0] + dx * stride, node[1] + dy * stride)","            if dest in first:","                continue","            valid = True","            for offset in range(1, stride + 1):","                cx = node[0] + dx * offset","                cy = node[1] + dy * offset","                for oy in (-half, 0, half):","                    for ox in (-half, 0, half):","                        px = cx + ox","                        py = cy + oy","                        if px < 0 or px >= frame.shape[1] or py < 0 or py >= ceiling:","                            valid = False","                        else:","                            color = int(frame[py, px])","                            if color == int(c[4]):","                                valid = False","                            if color == int(c[5]) and not (py < int(q[8]) and px > int(q[7])):","                                valid = False","            if valid:","                first[dest] = action if node == pos else first[node]","                depth[dest] = depth[node] + 1","                queue.append(dest)","    attempts = mem['attempts']","    state = (phase, pos, info['key'])","    counts = attempts.setdefault(state, {})","    if best is None:","        scorebest = -1000000.0","        for action, dx, dy, priority in legal:","            dest = (x + dx * stride, y + dy * stride)","            score = priority - counts.get(action, 0) * q[16] - visits.get((phase, dest), 0) * q[17]","            if blocked.get((phase, pos, action), False):","                score -= q[18]","            if score > scorebest:","                scorebest = score","                best = action","    counts[best] = counts.get(best, 0) + 1","    mem['pos'] = pos","    mem['last'] = best","    return (best, 0, 0)"],"shapes":{"colors":[6],"cfg":[19],"directions":[4,4]},"params":{"colors":[12,9,0,1,4,5],"cfg":[5,2,52,0,0,1.5,10,12,18,9,2,90,700,100,1,0.05,20,2,100],"directions":[[1,0,-1,0.4],[3,-1,0,0.3],[4,1,0,0.2],[2,0,1,0.1]]},"rationale":"Replaces perpetual exploration with a two-stage visual objective: touch the interior black/white marking, then approach the upper patterned chamber. Searches shortest routes using swept footprint collision checks, learns actual movement stride and blocked transitions, and retries the marking when entry fails. Strong distance weighting prevents visit penalties from repeatedly pulling the player away from its objective. Colors, geometry, action mapping, and stage thresholds are encoded in the tensors.","cannot_express":false}]