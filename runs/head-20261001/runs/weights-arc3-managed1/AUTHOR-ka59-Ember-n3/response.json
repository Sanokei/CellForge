[{"game":"ka59","source_lines":["def blobs(frame, colour, ceiling, limit):","    points = set((int(q[1]), int(q[0])) for q in np.argwhere(frame[:ceiling] == colour))","    result = []","    while points:","        todo = [points.pop()]","        cells = []","        while todo:","            x, y = todo.pop()","            cells.append((x, y))","            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):","                q = (x + dx, y + dy)","                if q in points:","                    points.remove(q)","                    todo.append(q)","        if 1 < len(cells) <= limit:","            result.append((int(round(sum(q[0] for q in cells) / len(cells))), int(round(sum(q[1] for q in cells) / len(cells)))))","    return sorted(result)","def quality(state, targets):","    best = None","    for t in targets:","        for u in targets:","            if t != u:","                d = abs(state[0]-t[0])+abs(state[1]-t[1])+abs(state[2]-u[0])+abs(state[3]-u[1])","                if best is None or d < best:","                    best = d","    return best if best is not None else 0","def act(params, mem, frame, avail, info):","    p = params['p']","    ring, goal, floor, gate, player = [int(round(v)) for v in p[:5]]","    stride = max(1, int(round(p[5])))","    ceiling = max(1, min(frame.shape[0], int(round(p[6]))))","    objects = blobs(frame, ring, ceiling, max(1, int(round(p[7]))))","    actor = None","    for x, y in objects:","        if int(frame[y, x]) == player:","            actor = (x, y)","            break","    others = [q for q in objects if q != actor]","    state = actor + others[0] if actor is not None and others else None","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level:","        mem.clear()","        mem['level'] = level","        mem['edges'] = {}","        mem['tried'] = {}","        mem['visits'] = {}","        mem['effects'] = {}","        mem['targets'] = blobs(frame, goal, ceiling, max(1, int(round(p[7]))))","        mem['board'] = set()","        if actor is not None:","            radius = stride // 2","            allowed = set((ring, goal, floor, gate, player, int(round(p[8]))))","            for y in range(actor[1] % stride, ceiling, stride):","                for x in range(actor[0] % stride, frame.shape[1], stride):","                    valid = True","                    for yy in range(y-radius, y+radius+1):","                        for xx in range(x-radius, x+radius+1):","                            if yy < 0 or xx < 0 or yy >= ceiling or xx >= frame.shape[1]:","                                valid = False","                            elif int(frame[yy, xx]) not in allowed:","                                valid = False","                    if valid:","                        mem['board'].add((x, y))","    if mem.get('reset') != reset:","        mem.pop('last', None)","        mem.pop('plan', None)","        mem['reset'] = reset","    moves = [(int(round(v[0])), int(round(v[1])), int(round(v[2]))) for v in params['moves'] if int(round(v[0])) in avail]","    edges = mem['edges']","    tried = mem['tried']","    visits = mem['visits']","    targets = mem['targets']","    if state is not None:","        visits[state] = visits.get(state, 0) + 1","        if 'last' in mem:","            old, a, expected = mem['last']","            edges.setdefault(old, {})[a] = state","            tried.setdefault(old, set()).add(a)","            effect = mem['effects'].setdefault(a, [0, 0, 0.0])","            effect[0] += 1","            effect[1] += int(old != state)","            effect[2] += quality(old, targets)-quality(state, targets)","            if expected != state:","                mem.pop('plan', None)","            if old[2:] == state[2:] and old[:2] != state[:2]:","                dx, dy = state[0]-old[0], state[1]-old[1]","                if abs(dx)+abs(dy) == stride:","                    mem.setdefault('directions', {})[a] = (dx, dy)","        learned = mem.get('directions', {})","        moves = [(a, learned.get(a, (dx, dy))[0], learned.get(a, (dx, dy))[1]) for a, dx, dy in moves]","    chosen = None","    expected = None","    if state is not None and mem.get('plan'):","        origin, a, destination = mem['plan'][0]","        if origin == state and a in avail:","            chosen, expected = a, destination","            mem['plan'].pop(0)","        else:","            mem.pop('plan', None)","    if chosen is None and state is not None and len(targets) >= 2:","        board = mem['board']","        queue = [state]","        parents = {state: None}","        index = 0","        terminal = None","        cap = max(1, int(round(p[9]))) * max(1, len(board))","        while index < len(queue) and index < cap:","            node = queue[index]","            index += 1","            if node != state and quality(node, targets) == 0:","                terminal = node","                break","            ax, ay, bx, by = node","            for a, dx, dy in moves:","                observed = edges.get(node, {})","                if a in observed:","                    following = observed[a]","                else:","                    destination = (ax+dx, ay+dy)","                    if destination not in board:","                        continue","                    box = (bx, by)","                    if destination == box:","                        box = (bx+dx, by+dy)","                        if box not in board:","                            continue","                    following = destination + box","                if following == node or following in parents:","                    continue","                parents[following] = (node, a)","                queue.append(following)","        if terminal is not None:","            plan = []","            node = terminal","            while parents[node] is not None:","                old, a = parents[node]","                plan.append((old, a, node))","                node = old","            plan.reverse()","            origin, chosen, expected = plan.pop(0)","            mem['plan'] = plan","    if chosen is None and state is not None:","        frontier = [(state, [])]","        reached = {state}","        index = 0","        bestscore = None","        while index < len(frontier) and index < max(1, int(round(p[9]))):","            node, path = frontier[index]","            index += 1","            for rank, move in enumerate(moves):","                a = move[0]","                if a in tried.get(node, set()):","                    continue","                effect = mem['effects'].get(a, [0, 0, 0.0])","                score = -p[10]*quality(node, targets)-p[11]*len(path)-p[12]*visits.get(node, 0)-p[13]*rank","                score += p[14]*effect[1]/max(1, effect[0])+p[15]*effect[2]/max(1, effect[0])","                if bestscore is None or score > bestscore:","                    bestscore = score","                    chosen = path[0] if path else a","            for a, destination in edges.get(node, {}).items():","                if a in avail and destination not in reached:","                    reached.add(destination)","                    frontier.append((destination, path+[a]))","        if chosen is None:","            for rank, move in enumerate(moves):","                a = move[0]","                destination = edges.get(state, {}).get(a, state)","                score = -p[10]*quality(destination, targets)-p[12]*visits.get(destination, 0)-p[13]*rank","                if destination == state:","                    score -= p[16]","                if bestscore is None or score > bestscore:","                    bestscore = score","                    chosen = a","        if expected is None:","            expected = edges.get(state, {}).get(chosen)","        mem['last'] = (state, chosen, expected)","    elif state is not None:","        mem['last'] = (state, chosen, expected)","    if chosen is None:","        legal = [a for a, dx, dy in moves]","        chosen = legal[0] if legal else avail[0]","    return (chosen, 0, 0)"],"shapes":{"p":[17],"moves":[4,3]},"params":{"p":[14,4,1,15,0,3,62,40,5,1000,1,0.12,2,0.01,0.3,0.5,20],"moves":[[1,0,-3],[2,0,3],[3,-3,0],[4,3,0]]},"rationale":"Replaces repeated probes and clicks with immediate Sokoban planning. Goal coordinates and traversable terrain are captured before moving objects obscure their pixels; the second ring remains identifiable even when its center changes colour. Plans are checked against actual transitions, and learned exceptions survive resets. The donor's observed transition graph, frontier search, action effects, and visit penalties provide exploration when the physical model fails. Tensor colours, movement geometry, search limits, and priorities govern frame-dependent decisions.","cannot_express":false}]