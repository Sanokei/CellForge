[{"game":"s5i5","source_lines":["def components(frame, colour):","    points = np.argwhere(frame == colour)","    remaining = set()","    for p in points:","        remaining.add((int(p[0]), int(p[1])))","    result = []","    while remaining:","        start = next(iter(remaining))","        remaining.remove(start)","        stack = [start]","        group = []","        while stack:","            y, x = stack.pop()","            group.append((y, x))","            for dy in (-1, 0, 1):","                for dx in (-1, 0, 1):","                    q = (y + dy, x + dx)","                    if q in remaining:","                        remaining.remove(q)","                        stack.append(q)","        result.append(group)","    return result","def distance(markers, targets):","    total = 0.0","    for x, y in markers:","        if targets:","            total += min(abs(x - tx) + abs(y - ty) for tx, ty in targets)","    return total","def act(params, mem, frame, avail, info):","    p = params['settings']","    control_colour = int(p[0])","    marker_colour = int(p[1])","    controls = []","    for group in components(frame, control_colour):","        if len(group) >= p[2] and len(group) <= p[3]:","            cy = sum(q[0] for q in group) / len(group)","            cx = sum(q[1] for q in group) / len(group)","            if cy < p[4]:","                point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))","                controls.append((point[1], point[0]))","    controls.sort()","    markers = []","    targets = []","    for group in components(frame, marker_colour):","        x = sum(q[1] for q in group) / len(group)","        y = sum(q[0] for q in group) / len(group)","        if len(group) <= p[5]:","            markers.append((x, y))","        elif len(group) >= p[6] and len(group) <= p[7]:","            targets.append((x, y))","    markers.sort()","    targets.sort()","    epoch = (info['levels'], info['resets'])","    if mem.get('epoch') != epoch:","        mem.clear()","        mem['epoch'] = epoch","        mem['models'] = {}","        mem['trials'] = {}","        mem['used'] = {}","        mem['visits'] = {}","    models = mem['models']","    trials = mem['trials']","    previous = mem.get('previous')","    if previous is not None:","        old_markers, old_targets, old_action = previous","        effects = []","        unmatched = list(markers)","        for ox, oy in old_markers:","            if unmatched:","                current = min(unmatched, key=lambda q: abs(q[0] - ox) + abs(q[1] - oy))","                unmatched.remove(current)","                dx = current[0] - ox","                dy = current[1] - oy","                if abs(dx) + abs(dy) > p[8]:","                    effects.append((current[0], current[1], dx, dy))","        models[old_action] = effects","        trials[old_action] = trials.get(old_action, 0) + 1","    state = (tuple(markers), tuple(targets), int(np.sum(frame == int(p[9]))), int(np.sum(frame == int(p[10]))))","    used = mem['used'].setdefault(state, {})","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if not controls:","        objects = []","        for colour in np.unique(frame):","            if int(colour) != int(p[11]):","                for group in components(frame, int(colour)):","                    if p[2] <= len(group) <= p[3]:","                        cy = sum(q[0] for q in group) / len(group)","                        cx = sum(q[1] for q in group) / len(group)","                        if cy < p[4]:","                            point = min(group, key=lambda q: abs(q[0] - cy) + abs(q[1] - cx))","                            objects.append((point[1], point[0]))","        controls = sorted(set(objects))","    if not controls:","        return (avail[0], int(p[12]), int(p[13]))","    current_distance = distance(markers, targets)","    best = controls[0]","    best_score = -1000000000.0","    for index, action in enumerate(controls):","        count = trials.get(action, 0)","        score = 0.0","        if count == 0:","            score += p[14]","        else:","            effects = models.get(action, [])","            predicted = list(markers)","            assigned = set()","            for ax, ay, dx, dy in effects:","                candidates = [i for i in range(len(markers)) if i not in assigned]","                if candidates:","                    i = min(candidates, key=lambda j: abs(markers[j][0] - ax) + abs(markers[j][1] - ay))","                    assigned.add(i)","                    predicted[i] = (markers[i][0] + dx * p[15], markers[i][1] + dy * p[15])","            score += p[16] * (current_distance - distance(predicted, targets))","            if not effects:","                score -= p[17]","            predicted_state = (tuple(sorted(predicted)), tuple(targets), state[2], state[3])","            score -= p[18] * visits.get(predicted_state, 0)","        score -= p[19] * used.get(action, 0)","        score -= p[20] * count","        score += p[21] * index","        if score > best_score:","            best_score = score","            best = action","    used[best] = used.get(best, 0) + 1","    mem['previous'] = (markers, targets, best)","    if 6 in avail:","        return (6, int(best[0]), int(best[1]))","    return (avail[0], 0, 0)"],"shapes":{"settings":[22]},"params":{"settings":[4,13,6,200,60,1,3,12,0.1,11,14,5,31,31,100,1,12,40,3,80,0.02,-0.001]},"rationale":"Builds a component-based click map and probes each control. Separates embedded markers from diamond targets, learns actual marker displacement from successive frames, and predicts which control reduces marker-to-target distance. Persistent state tracks explored transitions and penalizes ineffective clicks, revisited states, and repeated state-action pairs. Colour, component thresholds, movement scaling, and exploration priorities are tensor-controlled; each level rebuilds its online model.","cannot_express":false}]