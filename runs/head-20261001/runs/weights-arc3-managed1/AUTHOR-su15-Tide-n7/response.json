[{"game":"su15","source_lines":["def parts(frame, top, bottom, excluded):","    seen = np.zeros(frame.shape, dtype=bool)","    out = []","    for y in range(top, bottom):","        for x in range(frame.shape[1]):","            c = int(frame[y, x])","            if seen[y, x] or c in excluded:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                yy, xx = todo.pop()","                cells.append((yy, xx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = yy + dy, xx + dx","                    if top <= ny < bottom and 0 <= nx < frame.shape[1] and not seen[ny, nx] and int(frame[ny, nx]) == c:","                        seen[ny, nx] = True","                        todo.append((ny, nx))","            xs = [v[1] for v in cells]","            ys = [v[0] for v in cells]","            n = len(cells)","            out.append((c, int(round(sum(xs) / n)), int(round(sum(ys) / n)), n, max(xs) - min(xs) + 1, max(ys) - min(ys) + 1))","    return out","def act(params, mem, frame, avail, info):","    p = params['settings']","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if 'books' not in mem:","        mem['books'] = {}","        mem['wins'] = {}","    if mem.get('level') != level:","        if 'trace' in mem and level > mem.get('level', level):","            win = mem['wins'].setdefault(mem['level'], {})","            for state, point in mem['trace']:","                win[state] = point","        mem['level'] = level","        mem['trace'] = []","        mem.pop('last', None)","        mem.pop('position', None)","        mem.pop('previous', None)","    data = mem['books'].setdefault(level, {'tries': {}, 'bad': {}, 'edges': {}, 'visits': {}, 'effects': {}, 'fail': {}, 'stride': {}})","    if mem.get('reset') != reset:","        if 'last' in mem:","            old, point, oldpos, mode, kind = mem['last']","            pair = (oldpos, mode, point)","            data['fail'][pair] = data['fail'].get(pair, 0) + p[16]","        mem['reset'] = reset","        mem['trace'] = []","        mem.pop('last', None)","        mem.pop('position', None)","        mem.pop('previous', None)","    top = max(0, min(frame.shape[0], int(p[0])))","    bottom = max(top, min(frame.shape[0], int(p[1])))","    excluded = [int(p[2]), int(p[3])]","    body = parts(frame, top, bottom, excluded)","    header = parts(frame, 0, top, excluded)","    palettes = [o for o in header if p[4] <= o[3] <= p[5] and o[4] == o[5] and o[2] < p[6]]","    indicators = [o for o in header if o[2] >= p[6] and o[4] == o[5]]","    mode = max(indicators, key=lambda o: o[3])[0] if indicators else int(p[7])","    goals = [o for o in body if o[0] == int(p[8]) and o[3] >= p[9]]","    squares = [o for o in body if p[10] <= o[3] <= p[11] and o[4] == o[5] and o[3] == o[4] * o[5] and o[0] != int(p[8])]","    state = (tuple(sorted(body)), tuple(sorted(header)))","    previous = mem.get('previous', [])","    oldpos = mem.get('position')","    actor = None","    if oldpos is None and squares:","        actor = max(squares, key=lambda o: o[3])","    elif oldpos is not None:","        fresh = [o for o in squares if not any(v[1] == o[1] and v[2] == o[2] and v[3] == o[3] for v in previous)]","        stationary = [o for o in squares if abs(o[1] - oldpos[0]) + abs(o[2] - oldpos[1]) <= p[12]]","        if stationary:","            actor = min(stationary, key=lambda o: abs(o[1] - oldpos[0]) + abs(o[2] - oldpos[1]))","        elif fresh and len(fresh) <= p[13]:","            actor = min(fresh, key=lambda o: (o[1] - oldpos[0]) ** 2 + (o[2] - oldpos[1]) ** 2)","    if actor is not None:","        pos = (actor[1], actor[2])","        mem['position'] = pos","    else:","        pos = oldpos if oldpos is not None else (int(p[14]), int(p[15]))","    data['visits'][state] = data['visits'].get(state, 0) + 1","    if 'last' in mem:","        old, point, origin, oldmode, kind = mem['last']","        data['edges'][(old, point)] = state","        changed = state != old","        if not changed:","            data['bad'][(old, point)] = data['bad'].get((old, point), 0) + 1","            pair = (origin, oldmode, point)","            data['fail'][pair] = data['fail'].get(pair, 0) + p[17]","        else:","            data['effects'][kind] = data['effects'].get(kind, 0) + 1","            if actor is not None and origin != pos and kind[0] == 0:","                stride = ((pos[0] - origin[0]) ** 2 + (pos[1] - origin[1]) ** 2) ** 0.5","                record = data['stride'].get(oldmode, (0, 0))","                data['stride'][oldmode] = (record[0] + stride, record[1] + 1)","    if goals:","        goal = max(goals, key=lambda o: o[3])","        gx, gy = goal[1], goal[2]","        mem['goal'] = (gx, gy)","    else:","        gx, gy = mem.get('goal', pos)","    current = ((pos[0] - gx) ** 2 + (pos[1] - gy) ** 2) ** 0.5","    nodes = [o for o in body if o[3] <= p[18] and (o[1], o[2]) != pos]","    candidates = {}","    for o in nodes + goals:","        candidates[(o[1], o[2])] = (o, 0)","    for o in palettes:","        candidates[(o[1], o[2])] = (o, 1)","    movement = []","    for point, item in candidates.items():","        o, palette = item","        if palette:","            continue","        d = ((point[0] - pos[0]) ** 2 + (point[1] - pos[1]) ** 2) ** 0.5","        if d <= p[19]:","            continue","        remain = ((point[0] - gx) ** 2 + (point[1] - gy) ** 2) ** 0.5","        value = p[20] * d + p[21] * remain","        if remain >= current - p[22]:","            value += p[23]","        if d > p[24]:","            value += p[25] * (d - p[24])","        if o[0] == int(p[26]):","            value -= p[27]","        pair = (pos, mode, point)","        value += p[28] * data['fail'].get(pair, 0)","        movement.append((value, point))","    bestmove = min(movement)[0] if movement else p[29]","    options = []","    for point, item in candidates.items():","        o, palette = item","        kind = (palette, o[0], o[3])","        if palette:","            if o[0] == mode:","                value = p[30]","            else:","                value = bestmove + p[31]","                if actor is None:","                    value -= p[32]","                known = data['stride'].get(o[0])","                if known is not None and known[1] > 0 and movement:","                    target = min(movement)[1]","                    d = ((target[0] - pos[0]) ** 2 + (target[1] - pos[1]) ** 2) ** 0.5","                    value += p[33] * abs(d - known[0] / known[1])","        else:","            matches = [v for v in movement if v[1] == point]","            if not matches:","                continue","            value = matches[0][0]","        value += p[34] * data['tries'].get((state, point), 0)","        value += p[35] * data['bad'].get((state, point), 0)","        if palette:","            value += p[28] * data['fail'].get((pos, mode, point), 0)","        nxt = data['edges'].get((state, point))","        if nxt is not None:","            value += p[36] * data['visits'].get(nxt, 0)","        value -= p[37] * min(p[38], data['effects'].get(kind, 0))","        if mem['wins'].get(level, {}).get(state) == point:","            value -= p[39]","        options.append((value, point, kind))","    if options:","        options.sort()","        value, chosen, kind = options[0]","    else:","        chosen = (int(round(gx)), int(round(gy)))","        kind = (0, int(p[8]), 0)","    data['tries'][(state, chosen)] = data['tries'].get((state, chosen), 0) + 1","    mem['last'] = (state, chosen, pos, mode, kind)","    mem['trace'].append((state, chosen))","    mem['previous'] = body","    action = int(p[40])","    if action not in avail:","        action = avail[0]","    return (action, max(0, min(frame.shape[1] - 1, chosen[0])), max(0, min(frame.shape[0] - 1, chosen[1])))"],"shapes":{"settings":[41]},"params":{"settings":[10,63,5,4,4,25,3,15,9,12,4,25,1,2,4,59,4,1,100,1,3,1,0.1,100,5,10,0,8,75,200,700,18,45,2,12,250,20,1,6,500,6]},"rationale":"Keeps Tide's fast local movement scoring and Ember's palette detection, while tracking the moving square through component changes instead of confusing equal-sized landmarks with the actor. Learns useful click classes, movement strides, failed clicks and fatal transitions across resets. Footer-only changes do not count as progress; repeated ineffective clicks quickly trigger another landmark or palette. Components are detected again every turn, and successful choices are retained only under matching visual states.","cannot_express":false}]