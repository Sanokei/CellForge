[{"game":"su15","source_lines":["def components(frame, top, bottom, excluded):","    seen = np.zeros(frame.shape, dtype=bool)","    out = []","    for y in range(top, bottom):","        for x in range(frame.shape[1]):","            c = int(frame[y, x])","            if seen[y, x] or c in excluded:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                yy, xx = todo.pop()","                cells.append((yy, xx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = yy + dy, xx + dx","                    if top <= ny < bottom and 0 <= nx < frame.shape[1]:","                        if not seen[ny, nx] and int(frame[ny, nx]) == c:","                            seen[ny, nx] = True","                            todo.append((ny, nx))","            n = len(cells)","            out.append((c, int(round(sum(v[1] for v in cells) / n)), int(round(sum(v[0] for v in cells) / n)), n))","    return out","def act(params, mem, frame, avail, info):","    p = params['settings']","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level:","        mem.clear()","        mem['level'] = level","        mem['attempts'] = {}","        mem['failed'] = {}","        mem['edges'] = {}","        mem['visits'] = {}","        mem['responses'] = {}","        mem['danger'] = {}","    top = max(0, min(frame.shape[0], int(p[0])))","    bottom = max(top, min(frame.shape[0], int(p[1])))","    excluded = [int(p[2]), int(p[3])]","    body = components(frame, top, bottom, excluded)","    head = components(frame, 0, top, excluded)","    goals = [o for o in body if o[0] == int(p[4]) and o[3] >= p[5]]","    agents = [o for o in body if o[0] != int(p[4]) and p[6] <= o[3] <= p[7]]","    if agents:","        agent = max(agents, key=lambda o: o[3])","        origin = (agent[1], agent[2])","        mem['origin'] = origin","        mem['colour'] = agent[0]","    else:","        origin = mem.get('origin', (int(p[8]), int(p[9])))","    if goals:","        goal = max(goals, key=lambda o: o[3])","        mem['goal'] = (goal[1], goal[2])","    goal = mem.get('goal', origin)","    state = (tuple(sorted(body)), tuple(sorted(head)))","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        old, point, oldorigin, targetcolour = mem['last']","        pair = (old, point)","        if mem.get('reset') != reset:","            danger = (oldorigin, point)","            mem['danger'][danger] = mem['danger'].get(danger, 0) + 1","        else:","            mem['edges'][pair] = state","            if state == old:","                mem['failed'][pair] = mem['failed'].get(pair, 0) + 1","                mem['stall'] = mem.get('stall', 0) + 1","            else:","                mem['responses'][targetcolour] = mem['responses'].get(targetcolour, 0) + 1","                mem['stall'] = 0","                if origin != oldorigin:","                    mem['stride'] = ((origin[0] - oldorigin[0]) ** 2 + (origin[1] - oldorigin[1]) ** 2) ** 0.5","    mem['reset'] = reset","    candidates = []","    for o in body:","        if o[3] <= p[10] and (o[1], o[2]) != origin:","            candidates.append((o[1], o[2], o[0], 0))","    for o in goals:","        candidates.append((o[1], o[2], o[0], 0))","    if level >= p[11]:","        for o in head:","            if p[12] <= o[3] <= p[13] and o[1] < p[14]:","                candidates.append((o[1], o[2], o[0], 1))","    ax, ay = origin","    gx, gy = goal","    current = ((ax - gx) ** 2 + (ay - gy) ** 2) ** 0.5","    scored = []","    for x, y, colour, palette in candidates:","        point = (x, y)","        pair = (state, point)","        distance = ((x - ax) ** 2 + (y - ay) ** 2) ** 0.5","        remaining = ((x - gx) ** 2 + (y - gy) ** 2) ** 0.5","        if not palette and distance <= p[15]:","            continue","        failures = mem['failed'].get(pair, 0)","        score = p[16] * distance + p[17] * remaining","        if remaining >= current - p[18]:","            score += p[19]","        score += p[20] * mem['attempts'].get(pair, 0)","        score += p[21] * failures","        score += p[22] * mem['danger'].get((origin, point), 0)","        nxt = mem['edges'].get(pair)","        if nxt is not None:","            score += p[23] * visits.get(nxt, 0)","        if distance > p[24]:","            score += p[25] * (distance - p[24])","        if palette:","            matching = [o for o in body if o[0] == colour and o[3] <= p[10]]","            score = p[26] + p[20] * mem['attempts'].get(pair, 0) + p[21] * failures","            score += p[22] * mem['danger'].get((origin, point), 0)","            score -= p[27] * min(mem.get('stall', 0), p[28])","            if matching:","                nearest = min((((o[1] - ax) ** 2 + (o[2] - ay) ** 2) ** 0.5) for o in matching)","                score += p[29] * nearest","            else:","                score += p[30]","            if colour == mem.get('colour'):","                score += p[31]","            if not agents:","                score -= p[32]","        if failures >= p[33]:","            score += p[34]","        scored.append((score, x, y, colour))","    if scored:","        scored.sort()","        chosen = scored[0]","        point = (chosen[1], chosen[2])","        colour = chosen[3]","    else:","        pixels = np.argwhere((frame != int(p[2])) & (frame != int(p[3])))","        if len(pixels):","            index = int(info.get('step', 0)) % len(pixels)","            point = (int(pixels[index, 1]), int(pixels[index, 0]))","            colour = int(frame[point[1], point[0]])","        else:","            point = (int(p[8]), int(p[9]))","            colour = int(p[2])","    pair = (state, point)","    mem['attempts'][pair] = mem['attempts'].get(pair, 0) + 1","    mem['last'] = (state, point, origin, colour)","    action = int(p[35])","    if action not in avail:","        return (avail[0], 0, 0)","    return (action, max(0, min(frame.shape[1] - 1, point[0])), max(0, min(frame.shape[0] - 1, point[1])))"],"shapes":{"settings":[36]},"params":{"settings":[10,63,5,4,9,12,4,25,32,32,2,1,4,12,20,1,3,1,0.1,100,25,200,150,15,5,10,220,85,4,3,180,120,250,1,700,6]},"rationale":"Preserves the successful first-level movement scoring while detecting player and landmark colours afresh on every frame. Ignores the bottom action meter when judging click responses, blacklists unchanged state/click pairs immediately, learns responsive colours and transitions, and retains reset penalties. Later levels explore visible colour selectors as well as movement targets, preferring switches after failed movement or disappearance of the player.","cannot_express":false}]