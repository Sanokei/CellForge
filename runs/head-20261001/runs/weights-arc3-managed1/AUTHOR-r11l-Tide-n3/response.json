[{"game":"r11l","source_lines":["def blobs(frame, colour, radius):","    remaining = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))","    out = []","    while remaining:","        start = remaining.pop()","        todo = [start]","        cells = [start]","        while todo:","            y, x = todo.pop()","            for dy in range(-radius, radius + 1):","                for dx in range(-radius, radius + 1):","                    q = (y + dy, x + dx)","                    if q in remaining:","                        remaining.remove(q)","                        todo.append(q)","                        cells.append(q)","        out.append(cells)","    return out","def midpoint(cells):","    return (sum(q[1] for q in cells) / len(cells), sum(q[0] for q in cells) / len(cells))","def distance(a, b):","    return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2","def locate(frame, colour, area, tolerance, radius):","    groups = blobs(frame, colour, radius)","    good = [g for g in groups if abs(len(g) - area) <= tolerance]","    if not good:","        return None","    return midpoint(min(good, key=lambda g: abs(len(g) - area)))","def first_level(params, mem, frame, avail, info):","    p = params['settings']","    directions = params['directions']","    reset = info.get('resets', 0)","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('last', None)","        mem.pop('span', None)","    active = locate(frame, int(p[0]), p[6], p[7], int(p[8]))","    other = locate(frame, int(p[1]), p[6], p[7], int(p[8]))","    ball = locate(frame, int(p[2]), p[9], p[10], int(p[8]))","    if active is None or other is None or ball is None:","        groups = blobs(frame, int(p[3]), int(p[11]))","        if groups:","            x, y = midpoint(max(groups, key=len))","            return (avail[0], int(round(x)), int(round(y)))","        return (avail[0], int(p[12]), int(p[13]))","    targets = []","    for group in blobs(frame, int(p[3]), int(p[11])):","        centre = midpoint(group)","        if len(group) >= p[14] and min(distance(centre, active), distance(centre, other), distance(centre, ball)) > p[15] ** 2:","            targets.append((abs(len(group) - p[16]), centre))","    if targets:","        targets.sort(key=lambda v: v[0])","        mem['target'] = targets[0][1]","    target = mem.get('target', (p[12], p[13]))","    if 'span' not in mem:","        mem['span'] = (other[0] - active[0], other[1] - active[1])","    span = mem['span']","    quant = max(p[17], 1.0)","    state = tuple(int(round(v / quant)) for v in (active[0], active[1], other[0], other[1], ball[0], ball[1]))","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        oldstate, oldactive, oldother, oldball, action, oldframe = mem['last']","        mem['edges'][(oldstate, action)] = state","        if action < len(directions):","            dx = active[0] - oldactive[0]","            dy = active[1] - oldactive[1]","            motion = dx * dx + dy * dy","            changed = int(np.sum(frame != oldframe))","            failed = motion < p[18] ** 2 or changed <= p[19]","            mem['failed'][(oldstate, action)] = failed","            if not failed and motion < p[20] ** 2 and distance(other, oldother) < p[21] ** 2:","                model = mem['models'].setdefault(action, [0.0, 0.0, 0.0])","                model[0] += dx","                model[1] += dy","                model[2] += 1.0","    models = mem['models']","    moves = []","    for i in range(len(directions)):","        ux, uy = directions[i]","        length = max((ux * ux + uy * uy) ** 0.5, p[22])","        dx = p[23] * ux / length","        dy = p[23] * uy / length","        if i in models:","            m = models[i]","            dx = m[0] / max(m[2], 1.0)","            dy = m[1] / max(m[2], 1.0)","        moves.append((dx, dy))","    residual = (ball[0] - (active[0] + other[0]) / 2, ball[1] - (active[1] + other[1]) / 2)","    bound = int(p[24])","    def legal(a, b):","        for fraction in params['fractions']:","            x = int(round(a[0] + fraction * (b[0] - a[0])))","            y = int(round(a[1] + fraction * (b[1] - a[1])))","            if x < 0 or y < 0 or x > bound or y > bound:","                return False","            if int(frame[y, x]) == int(p[4]):","                return False","        return True","    def value(a, b):","        centre = ((a[0] + b[0]) / 2 + residual[0], (a[1] + b[1]) / 2 + residual[1])","        separation = distance(a, b) ** 0.5","        original = (span[0] * span[0] + span[1] * span[1]) ** 0.5","        return distance(centre, target) + p[25] * (distance(a, target) + distance(b, target)) + p[26] * (separation - original) ** 2","    beam = [(active, other, None, 0.0)]","    best = None","    bestvalue = float('inf')","    reached = set()","    switch = len(directions)","    for depth in range(max(1, int(p[27]))):","        candidates = []","        for a, b, first, cost in beam:","            for action in range(len(directions) + 1):","                if first is None:","                    if mem['failed'].get((state, action), False):","                        continue","                    penalty = p[28] * mem['pairs'].get((state, action), 0)","                    nxt = mem['edges'].get((state, action))","                    if nxt is not None:","                        penalty += p[29] * visits.get(nxt, 0)","                else:","                    penalty = 0.0","                if action == switch:","                    na, nb = b, a","                    penalty += p[30]","                else:","                    dx, dy = moves[action]","                    na = (a[0] + dx, a[1] + dy)","                    nb = b","                    if not legal(a, na):","                        continue","                initial = action if first is None else first","                signature = (int(round(na[0] / quant)), int(round(na[1] / quant)), int(round(nb[0] / quant)), int(round(nb[1] / quant)), initial)","                if signature in reached:","                    continue","                reached.add(signature)","                newcost = cost + penalty + p[31]","                score = value(na, nb) + newcost","                if score < bestvalue:","                    bestvalue = score","                    best = initial","                candidates.append((score, na, nb, initial, newcost))","        if not candidates:","            break","        candidates.sort(key=lambda v: v[0])","        beam = [(v[1], v[2], v[3], v[4]) for v in candidates[:max(1, int(p[32]))]]","    if best is None:","        options = []","        for action in range(len(directions) + 1):","            penalty = p[28] * mem['pairs'].get((state, action), 0)","            penalty += p[33] * float(mem['failed'].get((state, action), False))","            options.append((penalty, action))","        options.sort()","        best = options[0][1]","    if best == switch:","        x, y = other","    else:","        ux, uy = directions[best]","        norm = max((ux * ux + uy * uy) ** 0.5, p[22])","        x = active[0] + p[34] * ux / norm","        y = active[1] + p[34] * uy / norm","    x = max(0, min(bound, int(round(x))))","    y = max(0, min(bound, int(round(y))))","    mem['pairs'][(state, best)] = mem['pairs'].get((state, best), 0) + 1","    mem['last'] = (state, active, other, ball, best, frame.copy())","    return (6 if 6 in avail else avail[0], x, y)","def scene(params, frame):","    p = params['settings']","    q = params['learning']","    active = locate(frame, int(p[0]), p[6], p[7], int(p[8]))","    ends = [midpoint(g) for g in blobs(frame, int(p[1]), int(p[8])) if abs(len(g) - p[6]) <= p[7]]","    balls = [midpoint(g) for g in blobs(frame, int(p[2]), int(p[8])) if abs(len(g) - p[9]) <= p[10]]","    rings = []","    probes = []","    for colour in params['object_colours']:","        for g in blobs(frame, int(colour), int(p[11])):","            c = midpoint(g)","            if len(g) <= q[0] and len(g) >= q[1]:","                probes.append((int(colour), len(g), c))","            if abs(len(g) - p[16]) <= q[2]:","                rings.append((int(colour), c))","    for c in ends:","        probes.append((int(p[1]), int(p[6]), c))","    if active is not None:","        probes.append((int(p[0]), int(p[6]), active))","    pairs = []","    endpoints = ends + ([] if active is None else [active])","    for ball in balls:","        x, y = int(round(ball[0])), int(round(ball[1]))","        colours = []","        for dy, dx in params['samples']:","            yy = max(0, min(int(p[24]), y + int(dy)))","            xx = max(0, min(int(p[24]), x + int(dx)))","            colours.append(int(frame[yy, xx]))","        hue = max([int(c) for c in params['ring_colours']], key=lambda c: colours.count(c))","        goals = [c for h, c in rings if h == hue and distance(c, ball) > q[3] ** 2]","        if not goals or len(endpoints) < 2:","            continue","        combinations = []","        for i in range(len(endpoints)):","            for j in range(i + 1, len(endpoints)):","                a, b = endpoints[i], endpoints[j]","                mid = ((a[0] + b[0]) / 2, (a[1] + b[1]) / 2)","                combinations.append((distance(mid, ball), a, b))","        combinations.sort(key=lambda v: v[0])","        a, b = combinations[0][1], combinations[0][2]","        goal = min(goals, key=lambda c: distance(c, ball))","        pairs.append((ball, a, b, goal, hue))","    return active, pairs, probes","def advanced(params, mem, frame, avail, info):","    p = params['settings']","    q = params['learning']","    active, ropes, probes = scene(params, frame)","    key = info.get('key', '')","    reset = info.get('resets', 0)","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('observation', None)","    visits = mem.setdefault('state_visits', {})","    visits[key] = visits.get(key, 0) + 1","    attempts = mem.setdefault('attempts', {})","    effects = mem.setdefault('effects', {})","    tested = mem.setdefault('tested', {})","    if 'observation' in mem:","        oldkey, label, oldframe, oldactive, oldropes, click = mem['observation']","        changed = int(np.sum(frame != oldframe))","        ineffective = changed <= q[4]","        effects[(oldkey, label)] = (key, ineffective)","        if label[0] == 'probe':","            tested[label[1:]] = changed","        if active is not None and oldactive is not None and label[0] == 'move':","            dx, dy = active[0] - oldactive[0], active[1] - oldactive[1]","            ux, uy = click[0] - oldactive[0], click[1] - oldactive[1]","            denominator = ux * ux + uy * uy","            if denominator > q[5] and distance(active, oldactive) < q[6] ** 2:","                gain = (dx * ux + dy * uy) / denominator","                if gain > q[7] and gain < q[8]:","                    model = mem.setdefault('gain', [q[9], q[10]])","                    model[0] += gain","                    model[1] += 1","    candidates = []","    for colour, area, c in probes:","        signature = (colour, area, int(round(c[0] / q[11])), int(round(c[1] / q[11])))","        label = ('probe',) + signature","        if signature not in tested:","            score = -q[12] + q[13] * attempts.get((key, label), 0)","            candidates.append((score, label, c))","    gain_model = mem.get('gain', [q[9], q[10]])","    gain = max(q[14], min(q[15], gain_model[0] / max(gain_model[1], q[16])))","    for ball, a, b, target, hue in ropes:","        error = distance(ball, target)","        if error <= q[17] ** 2:","            continue","        for endpoint, other in [(a, b), (b, a)]:","            selected = active is not None and distance(active, endpoint) <= q[18] ** 2","            if not selected:","                label = ('switch', hue, int(round(endpoint[0])), int(round(endpoint[1])))","                score = error + q[19] + q[20] * distance(endpoint, target)","                candidates.append((score, label, endpoint))","                continue","            desired = (endpoint[0] + q[21] * (target[0] - ball[0]), endpoint[1] + q[21] * (target[1] - ball[1]))","            moves = [(desired[0] - endpoint[0], desired[1] - endpoint[1])]","            for dx, dy in params['directions']:","                norm = max((dx * dx + dy * dy) ** 0.5, p[22])","                moves.append((q[22] * dx / norm, q[22] * dy / norm))","            for index in range(len(moves)):","                dx, dy = moves[index]","                length = max((dx * dx + dy * dy) ** 0.5, p[22])","                scale = min(1.0, q[23] / length)","                dx, dy = dx * scale, dy * scale","                click = (endpoint[0] + dx / gain, endpoint[1] + dy / gain)","                click = (max(0, min(int(p[24]), int(round(click[0])))), max(0, min(int(p[24]), int(round(click[1])))))","                delta = (gain * (click[0] - endpoint[0]), gain * (click[1] - endpoint[1]))","                predicted = (ball[0] + delta[0] / q[21], ball[1] + delta[1] / q[21])","                score = distance(predicted, target) + q[20] * distance((endpoint[0] + delta[0], endpoint[1] + delta[1]), target)","                for fraction in params['fractions']:","                    xx = max(0, min(int(p[24]), int(round(endpoint[0] + fraction * delta[0]))))","                    yy = max(0, min(int(p[24]), int(round(endpoint[1] + fraction * delta[1]))))","                    if int(frame[yy, xx]) in [int(c) for c in params['obstacles']]:","                        score += q[24]","                label = ('move', hue, index, click[0], click[1])","                candidates.append((score, label, click))","    if not candidates:","        for colour, area, c in probes:","            label = ('object', colour, area, int(round(c[0])), int(round(c[1])))","            candidates.append((0.0, label, c))","    if not candidates:","        points = np.argwhere(frame == int(p[5]))","        if len(points):","            index = int(info.get('step', 0) * q[25]) % len(points)","            c = (int(points[index][1]), int(points[index][0]))","        else:","            c = (p[12], p[13])","        candidates.append((0.0, ('fallback', c[0], c[1]), c))","    scored = []","    for score, label, c in candidates:","        count = attempts.get((key, label), 0)","        score += q[13] * count","        edge = effects.get((key, label))","        if edge is not None:","            score += q[26] * visits.get(edge[0], 0)","            if edge[1]:","                score += q[27]","        scored.append((score, label, c))","    scored.sort(key=lambda v: v[0])","    score, label, c = scored[0]","    x = max(0, min(int(p[24]), int(round(c[0]))))","    y = max(0, min(int(p[24]), int(round(c[1]))))","    attempts[(key, label)] = attempts.get((key, label), 0) + 1","    mem['observation'] = (key, label, frame.copy(), active, ropes, (x, y))","    return (6 if 6 in avail else avail[0], x, y)","def act(params, mem, frame, avail, info):","    level = info.get('levels', 0)","    if mem.get('level') != level:","        mem.clear()","        mem['level'] = level","        mem['models'] = {}","        mem['pairs'] = {}","        mem['edges'] = {}","        mem['visits'] = {}","        mem['failed'] = {}","    if level < params['learning'][28]:","        return first_level(params, mem, frame, avail, info)","    return advanced(params, mem, frame, avail, info)"],"shapes":{"settings":[35],"directions":[16,2],"fractions":[3],"learning":[29],"object_colours":[4],"ring_colours":[2],"samples":[4,2],"obstacles":[2]},"params":{"settings":[0,3,6,15,2,5,12,5,1,1,0,2,32,32,8,7,12,1,0.2,1,12,2,0.01,2,63,0.08,0.025,7,18,8,1.5,0.2,48,80,14],"directions":[[1,0],[2,1],[1,1],[1,2],[0,1],[-1,2],[-1,1],[-2,1],[-1,0],[-2,-1],[-1,-1],[-1,-2],[0,-1],[1,-2],[1,-1],[2,-1]],"fractions":[0.33,0.67,1],"learning":[28,1,2,6,1,1,25,0.015,1.5,0.7,1,4,1000,180,0.05,1,0.01,2,2,20,0.08,2,7,14,500,37,80,700,1],"object_colours":[15,12,6,3],"ring_colours":[15,12],"samples":[[0,1],[1,0],[0,-1],[-1,0]],"obstacles":[2,10]},"rationale":"Retains the credited first-level policy and its original tensors. Later levels explicitly probe visible foreground components, compare settled frames, and record state-action effects and ineffective clicks. The revised controller associates each ball with its own endpoint pair and matching coloured target, learns click displacement online, and penalizes previously visited successors. All exploration and learned effects reset on level changes.","cannot_express":false}]