[{"game":"sc25","source_lines":["def groups(mask):","    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))","    result = []","    while remaining:","        point = next(iter(remaining))","        remaining.remove(point)","        todo = [point]","        cells = [point]","        while todo:","            r, c = todo.pop()","            for q in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):","                if q in remaining:","                    remaining.remove(q)","                    todo.append(q)","                    cells.append(q)","        r = sum(p[0] for p in cells)/len(cells)","        c = sum(p[1] for p in cells)/len(cells)","        near = min(cells,key=lambda p:abs(p[0]-r)+abs(p[1]-c))","        result.append((r,c,len(cells),near[0],near[1]))","    return result","def act(params, mem, frame, avail, info):","    cfg = params['cfg']","    col = params['col']","    height = max(1,min(frame.shape[0],int(cfg[0])))","    width = max(1,min(frame.shape[1],int(cfg[1])))","    mask = (frame==int(col[0])) | (frame==int(col[1]))","    mask[height:,:] = False","    mask[:,width:] = False","    objects = groups(mask)","    objects.sort(key=lambda p:p[2])","    agent = objects[0] if objects else None","    goal = objects[-1] if len(objects)>1 else None","    late = info['levels']>=int(cfg[2])","    if mem.get('level')!=info['levels'] or mem.get('reset')!=info['resets']:","        motion = mem.get('motion',{})","        effects = mem.get('effects',{})","        mem.clear()","        mem['motion'] = motion","        mem['effects'] = effects","        mem['level'] = info['levels']","        mem['reset'] = info['resets']","        mem['visits'] = {}","        mem['positions'] = {}","        mem['stuck'] = 0","        mem['mode'] = 0","    signature = tuple(int(v) for v in frame[:height,:width].flatten())","    old = mem.get('previous')","    if old is not None:","        oldsig, identity, oldagent, oldframe, oldmode = old","        same = signature==oldsig","        mem['stuck'] = mem['stuck']+1 if same else 0","        if identity[0]=='key' and agent is not None and oldagent is not None:","            dr = agent[0]-oldagent[0]","            dc = agent[1]-oldagent[1]","            magnitude = abs(dr)+abs(dc)","            if cfg[3]<=magnitude<=cfg[4]:","                mem['motion'][(oldmode,identity[1])] = (dr,dc)","                mem['motion'][identity[1]] = (dr,dc)","        if identity[0]=='click':","            delta = frame[:height,:width]!=oldframe[:height,:width]","            remote = delta.copy()","            radius = int(cfg[5])","            r,c = identity[-2],identity[-1]","            remote[max(0,r-radius):min(height,r+radius+1),max(0,c-radius):min(width,c+radius+1)] = False","            effect = float(np.sum(remote))","            mem['effects'][identity] = mem['effects'].get(identity,0)*cfg[6]+effect","            if not same:","                mem['mode'] += 1","                mem['positions'] = {}","    visits = mem['visits'].setdefault(signature,{})","    mode = mem['mode']","    position = None","    if agent is not None:","        position = (int(round(agent[0])),int(round(agent[1])))","        mem['positions'][position] = mem['positions'].get(position,0)+1","    targets = []","    if late:","        for rank in range(len(params['targets'])):","            tm = frame==int(params['targets'][rank])","            tm[height:,:] = False","            tm[:,width:] = False","            for obj in groups(tm):","                if obj[2]<=cfg[7] and obj[1]>=cfg[8]:","                    targets.append((rank,obj))","        if targets and agent is not None:","            targets.sort(key=lambda p:p[0]*cfg[9]+abs(p[1][0]-agent[0])+abs(p[1][1]-agent[1]))","            goal = targets[0][1]","    route = None","    moves = {}","    for i in range(len(params['order'])):","        action = int(params['order'][i])","        moves[action] = mem['motion'].get((mode,action),mem['motion'].get(action,tuple(params['directions'][i])))","    if late and position is not None and goal is not None:","        queue = [position]","        first = {}","        seen = set(queue)","        head = 0","        nearest = position","        bestdistance = abs(position[0]-goal[0])+abs(position[1]-goal[1])","        while head<len(queue) and head<int(cfg[10]):","            r,c = queue[head]","            head += 1","            distance = abs(r-goal[0])+abs(c-goal[1])","            if distance<bestdistance:","                nearest = (r,c)","                bestdistance = distance","            if distance<=cfg[11]:","                nearest = (r,c)","                break","            for action in moves:","                if action not in avail:","                    continue","                dr,dc = moves[action]","                nr,nc = int(round(r+dr)),int(round(c+dc))","                q = (nr,nc)","                if q in seen or nr<0 or nr>=height or nc<0 or nc>=width:","                    continue","                pixel = int(frame[nr,nc])","                passable = pixel==int(col[2]) or pixel==int(col[0]) or pixel==int(col[1])","                passable = passable or any(pixel==int(v) for v in params['targets'])","                if not passable:","                    continue","                seen.add(q)","                first[q] = action if (r,c)==position else first[(r,c)]","                queue.append(q)","        route = first.get(nearest)","    candidates = []","    for i in range(len(params['order'])):","        action = int(params['order'][i])","        if action not in avail:","            continue","        identity = ('key',action)","        score = cfg[12]-i*cfg[13]","        dr,dc = moves[action]","        if agent is not None and goal is not None:","            before = abs(agent[0]-goal[0])+abs(agent[1]-goal[1])","            after = abs(agent[0]+dr-goal[0])+abs(agent[1]+dc-goal[1])","            score += (cfg[14] if not late else cfg[15])*(before-after)","            nr,nc = int(round(agent[0]+dr)),int(round(agent[1]+dc))","            if nr<0 or nr>=height or nc<0 or nc>=width:","                score -= cfg[16]","            else:","                pixel = int(frame[nr,nc])","                if pixel==int(col[2]):","                    score += cfg[17] if not late else 0","                if pixel==int(col[3]):","                    score -= cfg[18] if not late else cfg[16]","                if late:","                    score -= cfg[19]*mem['positions'].get((nr,nc),0)","        if late and action==route:","            score += cfg[20]","        candidates.append((score,identity,action,0,0))","    click = int(cfg[21])","    if click in avail:","        for colour in params['controls']:","            for obj in groups(frame==int(colour)):","                r,c,area,pr,pc = obj","                if c>=width or area>cfg[22]:","                    continue","                if not late and r<cfg[23]:","                    continue","                identity = ('click',int(colour),int(round(r)),int(round(c)))","                score = cfg[24]+min(cfg[25],mem['stuck'])*cfg[26]","                if late:","                    score = cfg[27]+min(cfg[25],mem['stuck'])*cfg[28]","                    if route is None:","                        score += cfg[29]","                    if r<cfg[30] and c<cfg[31]:","                        score += cfg[32]","                score += min(cfg[33],mem['effects'].get(identity,0))*cfg[34]","                candidates.append((score,identity,click,pc,pr))","        if not late:","            for obj in objects:","                identity = ('click',int(col[0]),int(round(obj[0])),int(round(obj[1])))","                candidates.append((cfg[35],identity,click,obj[4],obj[3]))","    best = None","    bestscore = -1000000","    minimum = min((visits.get(item[1],0) for item in candidates),default=0)","    for score,identity,action,x,y in candidates:","        count = visits.get(identity,0)","        score -= cfg[36]*count","        if late and count>minimum+int(cfg[37]):","            score -= cfg[38]*(count-minimum)","        if old is not None and identity==old[1]:","            if signature!=old[0]:","                score += cfg[39]","            elif count<=cfg[40]:","                score += cfg[41] if late else 0","        if score>bestscore:","            bestscore = score","            best = (identity,action,x,y)","    if best is None:","        best = (('fallback',avail[0]),avail[0],0,0)","    identity,action,x,y = best","    visits[identity] = visits.get(identity,0)+1","    mem['previous'] = (signature,identity,agent,frame.copy(),mode)","    return (action,max(0,min(frame.shape[1]-1,int(x))),max(0,min(frame.shape[0]-1,int(y))))"],"shapes":{"cfg":[42],"col":[4],"order":[4],"directions":[4,2],"targets":[3],"controls":[6]},"params":{"cfg":[45,62,3,1,20,4,0.8,40,6,18,900,2,8,0.5,5,1.5,35,8,6,2,38,6,80,46,-12,12,3,-8,5,16,24,12,12,80,0.15,-16,9,1,90,3,2,14],"col":[9,10,2,5],"order":[3,1,2,4],"directions":[[0,-4],[-4,0],[4,0],[0,4]],"targets":[14,13,6],"controls":[0,2,15,6,14,13]},"rationale":"Retains the successful early-level visual agent and goal heuristic, but switches at the first unsolved level to live movement calibration, traversable-pixel planning, and collectible-first targeting. The new probe policy includes the previously excluded upper-left controls and the lower colour grid. It measures each click's remote board effects and conditions movement estimates on observed control changes. Revisited visual states force untried legal actions, preventing the persistent state-action cycles seen in the previous attempt. All probes and subsequent decisions depend on current frames; no solution sequence is stored.","cannot_express":false}]