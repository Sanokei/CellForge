[{"game":"cn04","source_lines":["def groups(mask):","    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(mask))","    result = []","    while remaining:","        p = next(iter(remaining))","        remaining.remove(p)","        todo = [p]","        cells = []","        while todo:","            r, c = todo.pop()","            cells.append((r, c))","            for q in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):","                if q in remaining:","                    remaining.remove(q)","                    todo.append(q)","        result.append(np.array(cells, dtype=float))","    return result","def center(points):","    return np.sum(points, axis=0) / max(1, len(points))","def spin(points, pivot, sign):","    v = points - pivot","    return np.array([[sign * p[1], -sign * p[0]] for p in v]) + pivot","def nearest(points, p):","    if not len(points):","        return 1000000.0","    return float(np.min(np.sum((points - p) ** 2, axis=1)))","def act(params, mem, frame, avail, info):","    col = params['colors']","    cfg = params['config']","    epoch = (info.get('levels', 0), info.get('resets', 0))","    if mem.get('epoch') != epoch:","        motion = mem.get('motion', {})","        turn = mem.get('turn', float(cfg[0]))","        mem.clear()","        mem['epoch'] = epoch","        mem['motion'] = motion","        mem['turn'] = turn","        mem['visits'] = {}","        mem['blocked'] = {}","        mem['edges'] = {}","        mem['effects'] = {}","    board = frame.copy()","    board[:int(cfg[1]), :] = int(col[4])","    signature = tuple(int(v) for v in board.flatten())","    body = np.argwhere(board == int(col[0])).astype(float)","    targets = groups((board == int(col[1])) | (board == int(col[2])))","    ports = groups(board == int(col[3]))","    active = []","    passive = [[] for part in targets]","    for port in ports:","        p = center(port)","        da = nearest(body, p)","        distances = [nearest(part, p) for part in targets]","        db = min(distances) if distances else 1000000.0","        if da < db:","            active.append(p)","        elif distances:","            passive[int(np.argmin(np.array(distances)))].append(p)","    ap = np.array(active) if active else np.zeros((0, 2))","    bc = center(body)","    allpoints = np.concatenate((body, ap), axis=0)","    pivot = (np.min(allpoints, axis=0) + np.max(allpoints, axis=0)) / 2 if len(allpoints) else bc","    old = mem.get('previous')","    if old is not None:","        os, identity, ob, op, oc, oldboard = old","        changed = int(np.sum(board != oldboard))","        mem['edges'][(os, identity)] = signature","        if not changed:","            pair = (os, identity)","            mem['blocked'][pair] = mem['blocked'].get(pair, 0) + 1","        else:","            mem['effects'][identity[0]] = mem['effects'].get(identity[0], 0) + 1","        if identity[0] in (1, 2, 3, 4) and len(body) and len(ob):","            delta = bc - center(ob)","            magnitude = float(np.sum(np.abs(delta)))","            if magnitude >= cfg[2] and magnitude <= cfg[3]:","                mem['motion'][identity[0]] = delta","        if identity[0] == 5 and len(ap) == len(op) and len(ap):","            pv = center(op) - oc","            nv = center(ap) - pivot","            positive = np.array([pv[1], -pv[0]])","            negative = -positive","            mem['turn'] = 1.0 if float(np.sum((positive - nv) ** 2)) < float(np.sum((negative - nv) ** 2)) else -1.0","    visits = mem['visits']","    visits[signature] = visits.get(signature, 0) + 1","    attempts = mem.setdefault('attempts', {})","    poses = []","    rb = body.copy()","    rp = ap.copy()","    if len(body) and len(ap):","        for turns in range(int(cfg[4])):","            ac = center(rp)","            av = ac - center(rb)","            for j in range(len(targets)):","                if not passive[j]:","                    continue","                tp = np.array(passive[j])","                pc = center(tp)","                tv = pc - center(targets[j])","                scale = float(np.max(np.abs(tv)))","                outward = tv / scale if scale else np.zeros(2)","                shape = 0.0","                for p in rp - ac:","                    shape += nearest(tp - pc, p)","                shape /= max(1, len(rp))","                if len(rp) != len(tp):","                    shape += cfg[5] * abs(len(rp) - len(tp))","                an = float(np.sum(av * av)) ** 0.5","                tn = float(np.sum(tv * tv)) ** 0.5","                facing = float(np.sum((av / an + tv / tn) ** 2)) if an and tn else cfg[5]","                for gi in range(len(params['gaps'])):","                    desired = pc + outward * params['gaps'][gi]","                    delta = desired - ac","                    placed = rb + delta","                    collision = 0","                    for p in placed:","                        r, c = int(round(p[0])), int(round(p[1]))","                        if r < int(cfg[1]) or r >= frame.shape[0] or c < 0 or c >= frame.shape[1]:","                            collision += 1","                        elif int(board[r, c]) in (int(col[1]), int(col[2])):","                            collision += 1","                    penalty = cfg[6] * facing + cfg[7] * shape + cfg[8] * collision + gi * cfg[9]","                    poses.append((turns, delta, penalty))","            rb = spin(rb, pivot, mem['turn'])","            rp = spin(rp, pivot, mem['turn'])","    candidates = []","    for i in range(len(params['order'])):","        a = int(params['order'][i])","        if a not in avail:","            continue","        identity = (a, 0, 0)","        movement = mem['motion'].get(a, params['directions'][i])","        score = -cfg[10] - i * cfg[11]","        if poses:","            costs = []","            for turns, delta, penalty in poses:","                if a == 5:","                    remaining = (turns - 1) % int(cfg[4])","                    distance = float(np.sum(np.abs(delta)))","                else:","                    remaining = turns","                    distance = float(np.sum(np.abs(delta - movement)))","                costs.append(distance / max(cfg[2], cfg[12]) + remaining * cfg[13] + penalty)","            score = -min(costs)","        candidates.append((score, identity))","    if 6 in avail:","        for part in ports:","            p = center(part)","            identity = (6, int(round(p[1])), int(round(p[0])))","            score = -cfg[14]","            if not len(body):","                score = cfg[15]","            elif poses and min(float(np.sum(np.abs(d))) / max(cfg[2], cfg[12]) + t * cfg[13] + penalty for t, d, penalty in poses) < cfg[16]:","                score = cfg[17]","            candidates.append((score, identity))","    best = None","    bestscore = -1000000000.0","    for score, identity in candidates:","        pair = (signature, identity)","        score -= cfg[18] * mem['blocked'].get(pair, 0)","        score -= cfg[19] * attempts.get(pair, 0)","        destination = mem['edges'].get(pair)","        if destination is not None:","            score -= cfg[20] * visits.get(destination, 0)","        if score > bestscore:","            bestscore = score","            best = identity","    if best is None:","        best = (int(avail[0]), 0, 0)","    pair = (signature, best)","    attempts[pair] = attempts.get(pair, 0) + 1","    mem['previous'] = (signature, best, body.copy(), ap.copy(), pivot.copy(), board.copy())","    return best"],"shapes":{"colors":[5],"config":[21],"order":[5],"directions":[5,2],"gaps":[4]},"params":{"colors":[0,14,12,8,10],"config":[1,1,1,6,4,25,35,0.8,4,0.35,12,0.02,3,1,18,8,0.8,1,100,3,1.5],"order":[4,2,5,3,1],"directions":[[3,0],[0,3],[0,0],[-3,0],[0,-3]],"gaps":[3,0,6,-3]},"rationale":"Transfers the donor's online motion inference, frame-derived state signatures, state-action failure suppression, and visitation penalties. Replaces its unrelated navigation assumptions with explicit connector geometry: associate blue ports with bodies, enumerate four rotations around the complete object's bounding-box pivot, match connector spacing and opposing faces, and plan translations to several observed-frame-derived docking poses. Tracks rotation direction and keyboard displacement online. Masks the changing timer so ineffective actions are recognized, and explores distinct connector clicks when selection is missing or docking is reached. Unlike the previous attempt, it retains the active/inactive distinction and plans across future rotations rather than using a local facing gradient.","cannot_express":false}]