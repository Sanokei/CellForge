[{"game":"cn04","source_lines":["def parts(mask):","    seen = set()","    result = []","    for rc in np.argwhere(mask):","        p = (int(rc[0]), int(rc[1]))","        if p in seen:","            continue","        todo = [p]","        seen.add(p)","        group = []","        while todo:","            r, c = todo.pop()","            group.append((r, c))","            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):","                q = (r + dr, c + dc)","                if 0 <= q[0] < mask.shape[0] and 0 <= q[1] < mask.shape[1] and q not in seen and mask[q[0], q[1]]:","                    seen.add(q)","                    todo.append(q)","        result.append(np.array(group))","    return result","def center(points):","    return np.sum(points, axis=0) / max(1, len(points))","def turn(points, pivot, sign):","    d = points - pivot","    return np.array([sign * d[:, 1], -sign * d[:, 0]]).T + pivot","def act(params, mem, frame, avail, info):","    colors = params['colors']","    cfg = params['config']","    epoch = (info['levels'], info['resets'])","    if mem.get('epoch') != epoch:","        effects = mem.get('effects', {})","        spin = mem.get('spin', float(cfg[0]))","        mem.clear()","        mem['epoch'] = epoch","        mem['effects'] = effects","        mem['spin'] = spin","        mem['visits'] = {}","        mem['edges'] = {}","        mem['attempts'] = {}","    active = np.argwhere(frame == int(colors[0]))","    active = active[active[:, 0] >= int(cfg[1])]","    targets = parts((frame == int(colors[1])) | (frame == int(colors[2])))","    ports = parts(frame == int(colors[3]))","    ac = center(active)","    own = []","    other = [[] for t in targets]","    for port in ports:","        pc = center(port)","        best = float(cfg[2])","        owner = -2","        if len(active):","            best = float(np.min(np.sum((active - pc) ** 2, axis=1)))","            owner = -1","        for i in range(len(targets)):","            distance = float(np.min(np.sum((targets[i] - pc) ** 2, axis=1)))","            if distance < best:","                best = distance","                owner = i","        if owner == -1:","            own.append(pc)","        elif owner >= 0:","            other[owner].append(pc)","    key = info['key']","    visits = mem['visits']","    visits[key] = visits.get(key, 0) + 1","    previous = mem.get('previous')","    if previous is not None:","        oldkey, action, oldbody, oldports, oldframe = previous","        mem['edges'][(oldkey, action)] = key","        if len(active) and len(oldbody) == len(active) and action[0] in (1, 2, 3, 4) and np.any(frame != oldframe):","            delta = ac - center(oldbody)","            if float(np.sum(delta * delta)) <= cfg[3]:","                mem['effects'][action[0]] = delta","        if action[0] == int(cfg[4]) and len(own) and len(oldports) == len(own):","            before = center(oldports) - center(oldbody)","            after = center(np.array(own)) - ac","            positive = np.array([before[1], -before[0]])","            negative = -positive","            mem['spin'] = 1.0 if np.sum((positive - after) ** 2) < np.sum((negative - after) ** 2) else -1.0","    action = None","    if not len(active) or not len(own):","        candidates = []","        for i in range(len(targets)):","            for pc in other[i]:","                candidates.append((6, int(pc[1]), int(pc[0])))","        if 6 in avail and len(candidates):","            action = min(candidates, key=lambda a: mem['attempts'].get((key, a), 0))","    if action is None and len(active) and len(own):","        op = np.array(own)","        extent = np.concatenate((active, op), axis=0)","        pivot = (np.min(extent, axis=0) + np.max(extent, axis=0)) / 2","        best = float(cfg[2])","        plan = None","        body = active.astype(float)","        pp = op.copy()","        for rotation in range(4):","            bc = center(body)","            pc = center(pp)","            for i in range(len(targets)):","                if not len(other[i]):","                    continue","                tp = np.array(other[i])","                tc = center(targets[i])","                outward = center(tp) - tc","                axis = int(np.argmax(np.abs(outward)))","                normal = np.zeros(2)","                normal[axis] = 1.0 if outward[axis] >= 0 else -1.0","                for gap in params['gaps']:","                    for p in pp:","                        for q in tp:","                            shift = q + normal * gap - p","                            moved = pp + shift","                            distance = 0.0","                            for z in moved:","                                distance += float(np.min(np.sum((tp + normal * gap - z) ** 2, axis=1)))","                            for z in tp + normal * gap:","                                distance += float(np.min(np.sum((moved - z) ** 2, axis=1)))","                            facing = pc - bc","                            fn = float(np.sum(facing * facing)) ** 0.5","                            on = float(np.sum(outward * outward)) ** 0.5","                            angle = 0.0","                            if fn > 0 and on > 0:","                                angle = float(np.sum((facing / fn + outward / on) ** 2))","                            placed = np.rint(body + shift).astype(int)","                            overlap = 0","                            outside = 0","                            for r, c in placed:","                                if r < cfg[1] or r >= frame.shape[0] or c < 0 or c >= frame.shape[1]:","                                    outside += 1","                                elif frame[r, c] == int(colors[1]) or frame[r, c] == int(colors[2]):","                                    overlap += 1","                            cost = cfg[5] * distance + cfg[6] * angle + cfg[7] * overlap + cfg[8] * outside","                            cost += cfg[9] * float(np.sum(np.abs(shift))) + cfg[10] * rotation","                            if cost < best:","                                best = cost","                                plan = (rotation, shift, i)","            body = turn(body, pivot, mem['spin'])","            pp = turn(pp, pivot, mem['spin'])","        if plan is not None:","            rotation, shift, target = plan","            options = []","            if rotation and int(cfg[4]) in avail:","                options.append((int(cfg[4]), 0, 0))","            else:","                bestmove = float(cfg[2])","                for raw in params['order']:","                    a = int(raw)","                    if a not in avail or a < 1 or a > 4:","                        continue","                    delta = mem['effects'].get(a, params['directions'][a - 1])","                    remaining = float(np.sum(np.abs(shift - delta)))","                    dest = mem['edges'].get((key, (a, 0, 0)))","                    penalty = 0.0","                    if dest == key:","                        penalty += cfg[11]","                    penalty += cfg[12] * mem['attempts'].get((key, (a, 0, 0)), 0)","                    score = remaining + penalty","                    if score < bestmove:","                        bestmove = score","                        options = [(a, 0, 0)]","                if float(np.sum(np.abs(shift))) <= cfg[13] and 6 in avail:","                    for p in own:","                        options.append((6, int(p[1]), int(p[0])))","                    for p in other[target]:","                        options.append((6, int(p[1]), int(p[0])))","                    if int(cfg[4]) in avail:","                        options.append((int(cfg[4]), 0, 0))","            if len(options):","                action = min(options, key=lambda a: cfg[12] * mem['attempts'].get((key, a), 0) + (cfg[11] if mem['edges'].get((key, a)) == key else 0))","    if action is None or mem['attempts'].get((key, action), 0) >= cfg[14]:","        choices = [(int(a), 0, 0) for a in params['order'] if int(a) in avail]","        if 6 in avail:","            for port in ports:","                p = center(port)","                choices.append((6, int(p[1]), int(p[0])))","        if len(choices):","            action = min(choices, key=lambda a: cfg[11] * mem['attempts'].get((key, a), 0) + cfg[12] * visits.get(mem['edges'].get((key, a)), 0))","    if action is None:","        action = (int(avail[0]), 0, 0)","    mem['attempts'][(key, action)] = mem['attempts'].get((key, action), 0) + 1","    mem['previous'] = (key, action, active.copy(), np.array(own), frame.copy())","    return action"],"shapes":{"colors":[4],"config":[15],"gaps":[3],"order":[5],"directions":[4,2]},"params":{"colors":[0,14,12,8],"config":[1,2,1000000,100,5,12,100,8,20,0.12,0.3,40,5,1,3],"gaps":[3,0,6],"order":[2,4,1,3,5],"directions":[[0,-3],[0,3],[-3,0],[3,0]]},"rationale":"Replaces local greedy steering with full rigid-pose connector matching across four rotations. Treats color 12 as an inactive selectable object, preserves selection while moving, learns movement and rotation effects from observed frames, penalizes blocked transitions, and explores alternative clicks at aligned configurations.","cannot_express":false}]