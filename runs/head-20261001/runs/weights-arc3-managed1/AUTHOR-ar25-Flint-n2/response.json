[{"game":"ar25","source_lines":["def objects(frame, colour, edge):","    p = np.argwhere(frame == colour)","    return p[(p[:, 0] < edge) & (p[:, 1] < edge)]","def centre(p):","    if len(p) == 0:","        return None","    return np.sum(p, axis=0) / len(p)","def act(params, mem, frame, avail, info):","    c = params['cfg']","    directions = params['directions']","    w = params['weights']","    edge = max(1, min(frame.shape[0], int(c[0])))","    colours = [int(c[1]), int(c[2])]","    parts = [objects(frame, colour, edge) for colour in colours]","    centres = [centre(p) for p in parts]","    target = objects(frame, int(c[3]), edge)","    epoch = (info['levels'], info['resets'])","    if mem.get('epoch') != epoch:","        mem.clear()","        mem['epoch'] = epoch","        mem['effects'] = {}","        mem['tested'] = {}","        mem['bad'] = {}","        mem['tried'] = {}","        mem['visits'] = {}","        mem['click_queue'] = []","        mem['goal'] = target.copy()","        seen = set()","        components = []","        for y in range(edge):","            for x in range(edge):","                if (y, x) in seen:","                    continue","                colour = int(frame[y, x])","                queue = [(y, x)]","                seen.add((y, x))","                head = 0","                while head < len(queue):","                    py, px = queue[head]","                    head += 1","                    for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:","                        ny, nx = py + dy, px + dx","                        if 0 <= ny < edge and 0 <= nx < edge and (ny, nx) not in seen and int(frame[ny, nx]) == colour:","                            seen.add((ny, nx))","                            queue.append((ny, nx))","                if colour != int(c[4]):","                    components.append((len(queue), queue))","        components.sort(key=lambda item: -item[0])","        for size, pixels in components[:max(0, int(c[5]))]:","            average = np.sum(np.array(pixels), axis=0) / size","            selected = min(pixels, key=lambda p: abs(p[0] - average[0]) + abs(p[1] - average[1]))","            mem['click_queue'].append((int(c[6]), selected[1], selected[0]))","    goal = mem['goal']","    if len(target) > 0:","        goal = target","        mem['goal'] = target.copy()","    signature = tuple(tuple(p.flatten().tolist()) for p in parts)","    last = mem.get('last')","    previous = mem.get('previous')","    if last is not None and previous is not None:","        token = (mem['signature'], last)","        unchanged = np.all(frame[:edge, :edge] == previous[:edge, :edge])","        if unchanged:","            mem['bad'][token] = mem['bad'].get(token, 0) + 1","        else:","            mem['bad'][token] = 0","        old_centres = mem['centres']","        for index in range(len(parts)):","            before = old_centres[index]","            after = centres[index]","            if before is not None and after is not None and len(parts[index]) == mem['sizes'][index]:","                delta = after - before","                if np.sum(np.abs(delta)) > c[7] and np.sum(np.abs(delta)) < c[8]:","                    key = (last[0], index)","                    existing = mem['effects'].get(key)","                    if existing is None:","                        mem['effects'][key] = delta.copy()","                    else:","                        mem['effects'][key] = existing * w[0] + delta * (1 - w[0])","    visits = mem['visits']","    visits[signature] = visits.get(signature, 0) + 1","    trials = mem['tried'].setdefault(signature, {})","    selected_index = None","    goal_centre = centre(goal)","    best_shape = None","    if goal_centre is not None:","        goal_origin = np.min(goal, axis=0)","        goal_shape = set(tuple(p) for p in (goal - goal_origin).tolist())","        for index in range(len(parts)):","            p = parts[index]","            if len(p) == 0:","                continue","            shape = set(tuple(v) for v in (p - np.min(p, axis=0)).tolist())","            mismatch = len(shape.symmetric_difference(goal_shape))","            score = w[1] * mismatch + w[2] * index","            if best_shape is None or score < best_shape:","                best_shape = score","                selected_index = index","    result = None","    for value in params['order']:","        action = int(value)","        if action in avail and action != int(c[6]) and action not in mem['tested']:","            result = (action, 0, 0)","            mem['tested'][action] = 1","            break","    if result is None and int(c[6]) in avail and len(mem['click_queue']) > 0:","        result = mem['click_queue'].pop(0)","    if result is None:","        candidates = []","        for rank in range(len(params['order'])):","            action = int(params['order'][rank])","            if action not in avail or action == int(c[6]):","                continue","            token = (action, 0, 0)","            failures = mem['bad'].get((signature, token), 0)","            score = w[3] * failures + w[4] * trials.get(token, 0) + w[5] * rank","            projected = []","            prediction = None","            for index in range(len(parts)):","                delta = mem['effects'].get((action, index))","                if delta is None:","                    for row in directions:","                        if int(row[0]) == action:","                            delta = row[1:3].copy()","                            if index == int(c[9]):","                                delta[1] *= c[10]","                if delta is None:","                    delta = np.zeros(2)","                p = parts[index]","                shifted = p + delta.astype(int)","                projected.append(tuple(shifted.flatten().tolist()))","                if index == selected_index:","                    prediction = delta","            score += w[6] * visits.get(tuple(projected), 0)","            if selected_index is not None and prediction is not None:","                cc = centres[selected_index]","                distance = np.sum(np.abs(cc + prediction - goal_centre))","                score += w[7] * distance","                if np.sum(np.abs(prediction)) < c[7]:","                    score += w[8]","            else:","                score += w[8] * mem['tested'].get(action, 0)","            candidates.append((score, action, 0, 0))","        if len(candidates) > 0:","            candidates.sort()","            pick = candidates[0]","            result = (pick[1], pick[2], pick[3])","        else:","            result = (avail[0], 0, 0)","    trials[result] = trials.get(result, 0) + 1","    mem['last'] = result","    mem['signature'] = signature","    mem['previous'] = frame.copy()","    mem['centres'] = centres","    mem['sizes'] = [len(p) for p in parts]","    return result"],"shapes":{"cfg":[11],"directions":[4,3],"weights":[9],"order":[7]},"params":{"cfg":[63,4,5,11,9,6,6,0.25,15,0,-1],"directions":[[1,-3,0],[2,3,0],[3,0,-3],[4,0,3]],"weights":[0.25,2,0.1,300,12,0.02,18,4,45],"order":[3,2,1,4,5,7,6]},"rationale":"Probe every key and six distinct visible components once, then suppress ineffective transitions using actual board comparisons excluding the timer borders. Match object silhouettes to the purple destination, prioritizing the solid matching L instead of chasing the red object with the hollow piece. Learn each object's displacement independently, allowing mirrored controls; navigate using predicted destination distance, transition attempts, and previously visited object configurations. Clicks are finite probes rather than an unlimited fallback.","cannot_express":false}]