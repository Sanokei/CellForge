[{"game":"dc22","source_lines":["def act(params, mem, frame, avail, info):","    p = params['p']","    order = [int(v) for v in params['order']]","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    top, bottom, split = int(p[0]), int(p[1]), int(p[2])","    player = int(p[3])","    if mem.get('level') != level:","        mem.clear()","        mem['level'] = level","        mem['graph'] = {}","        mem['tried'] = {}","        mem['values'] = {}","        mem['visits'] = {}","        mem['effects'] = {}","        mem['motion'] = {}","        mem['reached'] = set()","    if mem.get('reset') != reset:","        mem.pop('last', None)","        mem['reset'] = reset","    points = np.argwhere(frame[top:bottom, :split] == player)","    pos = None","    if len(points):","        pos = (int(min(points[:, 0])) + top, int(min(points[:, 1])))","    state = tuple(int(v) for row in frame[top:bottom, :split] for v in row)","    graph, tried = mem['graph'], mem['tried']","    values, visits = mem['values'], mem['visits']","    graph.setdefault(state, {})","    tried.setdefault(state, set())","    visits[state] = visits.get(state, 0) + 1","    targets = []","    for rank, colour in enumerate(params['goals']):","        cells = np.argwhere(frame[top:bottom, :split] == int(colour))","        if len(cells):","            gy = float(np.sum(cells[:, 0])) / len(cells) + top","            gx = float(np.sum(cells[:, 1])) / len(cells)","            targets.append((rank, gy, gx))","            if pos is not None and abs(pos[0] - gy) + abs(pos[1] - gx) <= p[4]:","                mem['reached'].add(rank)","    target = None","    for item in targets:","        if item[0] not in mem['reached']:","            target = item","            break","    if target is None and targets:","        target = targets[-1]","    distance = p[5]","    if pos is not None and target is not None:","        distance = abs(pos[0] - target[1]) + abs(pos[1] - target[2])","    quality = -distance / max(1.0, p[5]) + p[6] * len(mem['reached'])","    values[state] = quality","    if 'last' in mem:","        previous, action, before, oldpos = mem['last']","        graph.setdefault(previous, {})[action] = state","        tried.setdefault(previous, set()).add(action)","        effect = mem['effects'].setdefault(action, [0, 0, 0.0])","        effect[0] += 1","        effect[1] += int(previous != state)","        effect[2] += quality - before","        if oldpos is not None and pos is not None and action[0] != int(p[7]):","            dy, dx = pos[0] - oldpos[0], pos[1] - oldpos[1]","            if abs(dy) + abs(dx) > 0 and abs(dy) + abs(dx) <= p[8]:","                mem['motion'][action[0]] = (dy, dx)","    actions = [(a, 0, 0) for a in order if a in avail]","    click = int(p[7])","    if click in avail:","        for colour in params['tools']:","            cells = np.argwhere(frame[top:bottom, split:] == int(colour))","            if len(cells):","                x = int(float(np.sum(cells[:, 1])) / len(cells)) + split","                y = int(float(np.sum(cells[:, 0])) / len(cells)) + top","                actions.append((click, x, y))","    if not actions:","        return (avail[0], 0, 0)","    local = {}","    passable = [int(v) for v in params['floor']]","    for action in actions:","        bonus = 0.0","        if action[0] != click and pos is not None:","            dy, dx = 0, 0","            for index, a in enumerate(order):","                if a == action[0]:","                    dy, dx = int(params['moves'][index][0]), int(params['moves'][index][1])","            dy, dx = mem['motion'].get(action[0], (dy, dx))","            ny, nx = pos[0] + dy, pos[1] + dx","            good = 0","            size = max(1, int(p[9]))","            for oy in range(size):","                for ox in range(size):","                    yy, xx = ny + oy, nx + ox","                    if yy >= top and yy < bottom and xx >= 0 and xx < split:","                        if int(frame[yy, xx]) in passable:","                            good += 1","            if good < size * size:","                bonus -= p[10]","            elif target is not None:","                after = abs(ny - target[1]) + abs(nx - target[2])","                bonus += p[11] * (distance - after)","        elif action[0] == click:","            bonus -= p[12]","            if pos is not None:","                nearby = frame[max(top, pos[0]-int(p[9])):min(bottom, pos[0]+int(p[13])), max(0, pos[1]-int(p[9])):min(split, pos[1]+int(p[13]))]","                for colour in params['tools']:","                    if np.any(nearby == int(colour)):","                        bonus += p[14]","                        break","        local[action] = bonus","    frontier = [(state, [])]","    reached = {state}","    index = 0","    best = None","    bestscore = -1000000.0","    while index < len(frontier) and index < max(1, int(p[15])):","        node, path = frontier[index]","        index += 1","        used = tried.setdefault(node, set())","        for rank, action in enumerate(actions):","            if action in used:","                continue","            effect = mem['effects'].get(action, [0, 0, 0.0])","            activity = effect[1] / max(1, effect[0])","            gain = effect[2] / max(1, effect[0])","            score = p[16] * values.get(node, quality) - p[17] * len(path)","            score += p[18] * activity + p[19] * gain - p[20] * rank","            score -= p[21] * visits.get(node, 0)","            if not path:","                score += local[action]","            if score > bestscore:","                bestscore = score","                best = path[0] if path else action","        for action, destination in graph.get(node, {}).items():","            if destination not in reached and action in actions:","                reached.add(destination)","                frontier.append((destination, path + [action]))","    if best is None:","        for rank, action in enumerate(actions):","            destination = graph[state].get(action)","            score = p[16] * values.get(destination, quality) - p[22] * visits.get(destination, 0)","            score += local[action] - p[20] * rank","            if destination == state:","                score -= p[23]","            if destination is None:","                score += p[24]","            if score > bestscore:","                bestscore = score","                best = action","    mem['last'] = (state, best, quality, pos)","    return best"],"shapes":{"p":[25],"order":[4],"moves":[4,2],"goals":[2],"tools":[2],"floor":[6]},"params":{"p":[10,54,30,14,3,64,0.5,6,4,2,1.4,0.12,0.15,4,0.22,700,5,0.045,0.2,1.5,0.008,0.025,0.12,3,1],"order":[1,4,2,3],"moves":[[-2,0],[0,2],[2,0],[0,-2]],"goals":[13,11],"tools":[8,9],"floor":[2,8,9,11,13,14]},"rationale":"Transfers the donor's learned transition graph and BFS frontier routing, while replacing its image-matching objective with navigation through the narrow left-hand corridors. Tests the entire player footprint so checkerboard platforms are distinguished from solid ones. Learns actual movement, explores both platform controls, prioritizes controls near the player, ignores the changing action counter, and retains explored transitions across resets. Goal proximity guides exploration without prescribing an action sequence.","cannot_express":false}]