j < len(moves):","                        displacement = (float(moves[j][0]), float(moves[j][1]))","            if displacement is not None and pos is not None and target is not None:","                predicted = abs(pos[0] + displacement[0] - target[0]) + abs(pos[1] + displacement[1] - target[1])","                score += cfg[15] * (distance - predicted)","            if trials.get(candidate, 0) == 0:","                score += cfg[16]","        else:","            score -= cfg[17]","            if trials.get(candidate, 0) == 0:","                score += cfg[18]","            if mem['stuck'] >= int(cfg[19]):","                score += cfg[20]","            if mem['click_age'] < int(cfg[8]):","                score -= cfg[21]","        if outcome is not None and outcome != signature:","            frontier = edges.get(outcome, {})","            missing = 0","            for other in candidates:","                if other not in frontier:","                    missing += 1","            score += cfg[22] * missing","        if score > bestscore:","            bestscore = score","            best = candidate","    if best[0] == 6:","        mem['click_age'] = 0","    mem['previous'] = signature","    mem['action'] = best","    mem['pos'] = pos","    mem['frame'] = frame[top:bottom, :split].copy()","    return best"],"shapes":{"cfg":[23],"order":[4],"moves":[4,2]},"params":{"cfg":[14,13,11,8,9,30,10,54,8,12,48,0.03,3,18,5,1.7,12,5,17,2,14,18,0.5],"order":[1,4,2,3],"moves":[[0,-2],[2,0],[0,2],[-2,0]]},"rationale":"Tracks the visible colour-14 marker and learns actual keyboard displacement from frame transitions. Separately probes the two visible colour controls, recording their full board effects. Excludes the timer from state identity, penalizes revisited outcomes and ineffective actions, and favors unexplored transitions near the colour-13 and colour-11 landmarks. Recomputes decisions from each settled frame, alternates landmarks during prolonged exploration, and re