[{"game":"tu93","source_lines":["def act(params, mem, frame, avail, info):","    c = params['config']","    palette = params['palette']","    order = params['order']","    directions = params['directions']","    h = max(1, min(frame.shape[0], int(c[0])))","    board = frame[:h]","    level = info['levels']","    reset = info['resets']","    stride = max(1, int(c[1]))","    player = np.argwhere((board == int(palette[0])) | (board == int(palette[1])))","    goals = np.argwhere(board == int(palette[2]))","    if not len(player) or not len(goals):","        action = int(order[int(info['step']) % len(order)])","        if action not in avail:","            action = avail[0]","        return (action, 0, 0)","    pos = (int(round((int(player[:, 0].min()) + int(player[:, 0].max())) / 2)), int(round((int(player[:, 1].min()) + int(player[:, 1].max())) / 2)))","    goal = (int(round(float(np.sum(goals[:, 0])) / len(goals))), int(round(float(np.sum(goals[:, 1])) / len(goals))))","    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(board == int(palette[3])))","    enemies = []","    while remaining:","        p = next(iter(remaining))","        remaining.remove(p)","        todo = [p]","        component = [p]","        while todo:","            r, x = todo.pop()","            for q in ((r - 1, x), (r + 1, x), (r, x - 1), (r, x + 1)):","                if q in remaining:","                    remaining.remove(q)","                    todo.append(q)","                    component.append(q)","        r = int(round((min(q[0] for q in component) + max(q[0] for q in component)) / 2))","        x = int(round((min(q[1] for q in component) + max(q[1] for q in component)) / 2))","        r = pos[0] + int(round((r - pos[0]) / stride)) * stride","        x = pos[1] + int(round((x - pos[1]) / stride)) * stride","        enemies.append((r, x))","    enemies.sort()","    state = (pos, tuple(enemies))","    records = mem.setdefault('records', {})","    record = records.setdefault(level, {'visits': {}, 'used': {}, 'fatal': {}, 'blocked': {}, 'motion': {}, 'effects': {}})","    previous = mem.get('previous')","    same = previous is not None and previous[0] == level and previous[1] == reset","    predicted = []","    if previous is not None and previous[0] == level:","        oldlevel, oldreset, oldstate, oldaction = previous","        edge = (oldstate, oldaction)","        if oldreset != reset:","            record['fatal'][edge] = record['fatal'].get(edge, 0) + 1","        else:","            dr = pos[0] - oldstate[0][0]","            dx = pos[1] - oldstate[0][1]","            record['effects'][edge] = state","            if dr == 0 and dx == 0:","                record['blocked'][edge] = record['blocked'].get(edge, 0) + 1","            elif abs(dr) + abs(dx) == stride:","                record['motion'][oldaction] = (dr, dx)","    if same:","        unmatched = list(previous[2][1])","        for enemy in enemies:","            nearest = None","            distance = int(c[2])","            for old in unmatched:","                d = abs(enemy[0] - old[0]) + abs(enemy[1] - old[1])","                if d < distance:","                    nearest = old","                    distance = d","            if nearest is not None:","                unmatched.remove(nearest)","                dr = enemy[0] - nearest[0]","                dx = enemy[1] - nearest[1]","                if abs(dr) + abs(dx) <= stride:","                    predicted.append((enemy[0] + dr, enemy[1] + dx))","                else:","                    predicted.append(enemy)","            else:","                predicted.append(enemy)","    else:","        predicted = list(enemies)","    record['visits'][state] = record['visits'].get(state, 0) + 1","    moves = []","    for i in range(len(order)):","        action = int(order[i])","        if action in avail:","            dr, dx = record['motion'].get(action, (int(directions[i][0]), int(directions[i][1])))","            moves.append((action, dr, dx, i))","    graph = {}","    queue = [pos]","    found = {pos}","    head = 0","    while head < len(queue) and head < int(c[2]):","        p = queue[head]","        head += 1","        edges = []","        for action, dr, dx, rank in moves:","            q = (p[0] + dr, p[1] + dx)","            length = max(abs(dr), abs(dx))","            clear = length > 0 and q[0] >= 0 and q[1] >= 0 and q[0] < h and q[1] < board.shape[1]","            if clear:","                for t in range(1, length + 1):","                    r = p[0] + int(round(dr * t / length))","                    x = p[1] + int(round(dx * t / length))","                    if int(board[r, x]) == int(palette[4]):","                        clear = False","                        break","            if clear:","                edges.append((action, q, rank))","                if q not in found:","                    found.add(q)","                    queue.append(q)","        graph[p] = edges","    distance = {goal: 0}","    queue = [goal]","    head = 0","    reverse = {}","    for p, edges in graph.items():","        for action, q, rank in edges:","            reverse.setdefault(q, []).append(p)","    while head < len(queue):","        p = queue[head]","        head += 1","        for q in reverse.get(p, []):","            if q not in distance:","                distance[q] = distance[p] + 1","                queue.append(q)","    best = None","    bestscore = float(c[2]) * float(c[2])","    for action, dr, dx, rank in moves:","        q = (pos[0] + dr, pos[1] + dx)","        legal = any(a == action for a, destination, priority in graph.get(pos, []))","        edge = (state, action)","        score = c[3] * distance.get(q, int(c[2])) + c[4] * rank","        if not legal:","            score += c[5]","        if q in enemies:","            score += c[6]","        if q in predicted:","            score += c[7]","        for enemy, future in zip(enemies, predicted):","            i