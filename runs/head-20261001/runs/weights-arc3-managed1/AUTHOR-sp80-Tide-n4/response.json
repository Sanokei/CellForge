[{"game":"sp80","source_lines":["def groups(frame, colour):","    remaining = set((int(q[0]), int(q[1])) for q in np.argwhere(frame == colour))","    result = []","    while remaining:","        seed = next(iter(remaining))","        remaining.remove(seed)","        stack = [seed]","        cells = []","        while stack:","            r, c = stack.pop()","            cells.append((r, c))","            for q in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):","                if q in remaining:","                    remaining.remove(q)","                    stack.append(q)","        ys = [q[0] for q in cells]","        xs = [q[1] for q in cells]","        result.append((min(ys),max(ys),min(xs),max(xs),sum(ys)/len(ys),sum(xs)/len(xs),len(cells)))","    return sorted(result, key=lambda q: (-q[6],q[2]))","def act(params, mem, frame, avail, info):","    p = params['config']","    w = params['weights']","    agentlist = groups(frame, int(p[0]))","    cargoes = groups(frame, int(p[1]))","    goals = groups(frame, int(p[2]))","    floors = np.argwhere(frame == int(p[3]))","    agent = agentlist[0] if agentlist else None","    cargo = cargoes[0] if cargoes else None","    level = info['levels']","    reset = info['resets']","    if mem.get('level') != level:","        learned = mem.get('motion', {})","        successes = mem.get('successes', {})","        if mem.get('level', level) < level:","            successes[mem.get('mode',0)] = successes.get(mem.get('mode',0),0)+1","        mem.clear()","        mem.update({'level':level,'reset':-1,'attempt':0,'motion':learned,'successes':successes,'nodes':{}})","    if mem['reset'] != reset:","        mem['reset'] = reset","        modes = len(params['gaps'])","        attempt = mem['attempt']","        mem['attempt'] += 1","        preferred = sorted(mem['successes'],key=lambda k:-mem['successes'][k])","        mem['mode'] = preferred[0] if preferred and attempt % int(p[4]) == 0 else attempt % modes","        mem['phase'] = 0","        mem['dwell'] = 0","        mem['stuck'] = 0","        mem['source'] = cargo","        mem['destination'] = attempt // modes","        mem.pop('previous',None)","        mem.pop('attached',None)","    direction = 1","    if len(floors):","        direction = 1 if float(np.sum(floors[:,0]))/len(floors) > frame.shape[0]/2 else -1","    elif goals and cargo is not None:","        direction = 1 if goals[0][4] > cargo[4] else -1","    state = tuple(int(v) for v in frame[int(p[5]):int(p[6]),:].flatten())","    nodes = mem['nodes']","    node = nodes.setdefault(state,{'visits':0,'trials':{},'edges':{}})","    node['visits'] += 1","    previous = mem.get('previous')","    if previous is not None:","        oldstate, identity, oldagent, oldcargo = previous","        nodes[oldstate]['edges'][identity] = state","        mem['stuck'] = mem['stuck']+1 if oldstate == state else 0","        if agent is not None and oldagent is not None:","            dy = agent[4]-oldagent[4]","            dx = agent[5]-oldagent[5]","            if p[7] <= abs(dy)+abs(dx) <= p[8]:","                mem['motion'][identity[0]] = (dy,dx)","            if cargo is not None and oldcargo is not None:","                cy = cargo[4]-oldcargo[4]","                cx = cargo[5]-oldcargo[5]","                if abs(cy)+abs(cx) >= p[7]:","                    mem['phase'] = 1","                    if abs(cy-dy)+abs(cx-dx) <= p[9]:","                        mem['attached'] = (cargo[4]-agent[4],cargo[5]-agent[5])","    target = None","    near = False","    gap = params['gaps'][mem['mode']]","    if agent is not None:","        half = (agent[1]-agent[0]+1)/2","        if mem['phase'] == 0 and cargo is not None:","            edge = cargo[1]+1 if direction > 0 else cargo[0]","            ty = edge+direction*(half+gap)","            tx = cargo[5]","            target = (ty,tx)","            near = abs(agent[4]-ty)+abs(agent[5]-tx) <= p[10]","            mem['dwell'] = mem['dwell']+1 if near else 0","            if mem['dwell'] >= p[11]:","                mem['phase'] = 1","                mem['dwell'] = 0","        if mem['phase'] >= 1 and goals:","            goals.sort(key=lambda q:q[5])","            if 'goal' not in mem:","                if cargo is not None:","                    ranked = sorted(range(len(goals)),key=lambda i:abs(goals[i][5]-cargo[5]))","                    mem['goal'] = ranked[mem['destination'] % len(ranked)]","                else:","                    mem['goal'] = mem['destination'] % len(goals)","            goal = goals[mem['goal'] % len(goals)]","            opening = goal[0] if direction > 0 else goal[1]+1","            attached = mem.get('attached')","            if attached is not None:","                ty = opening+direction*p[12]-attached[0]","                tx = goal[5]-attached[1]","            else:","                ty = opening-direction*(half+p[13])","                tx = goal[5]","            ty = max(half,min(frame.shape[0]-half-1,ty))","            target = (ty,tx)","            near = abs(agent[4]-ty)+abs(agent[5]-tx) <= p[10]","            mem['dwell'] = mem['dwell']+1 if near else 0","            if mem['dwell'] > p[14]:","                mem['phase'] = 0","                mem['dwell'] = 0","                mem.pop('attached',None)","                mem.pop('goal',None)","    potential = 0.0","    if target is not None:","        potential = -w[0]*(abs(agent[4]-target[0])+abs(agent[5]-target[1]))","    node['value'] = potential","    candidates = []","    for i, raw in enumerate(params['order']):","        action = int(raw)","        if action not in avail:","            continue","        dy, dx = mem['motion'].get(action,(params['motion'][i][0],params['motion'][i][1]))","        score = -w[1]*i","        if target is not None:","            before = abs(agent[4]-target[0])+abs(agent[5]-target[1])","            after = abs(agent[4]+dy-target[0])+abs(agent[5]+dx-target[1])","            score += w[2]*(before-after)","            if agent[0]+dy < p[5] or agent[1]+dy >= p[6] or agent[2]+dx < 0 or agent[3]+dx >= frame.shape[1]:","                score -= w[3]","            if abs(agent[5]-target[1]) > p[10] and abs(dy) > 0:","                score -= w[4]","        if action == int(p[15]):","            score -= w[5]","            if near:","                score += w[6]","        candidates.append(((action,0,0),score))","    if int(p[16]) in avail and mem['stuck'] >= p[17]:","        for colour in params['click_colours']:","            for obj in groups(frame,int(colour)):","                candidates.append(((int(p[16]),int(obj[5]),int(obj[4])),w[7]))","    if not candidates:","        return (avail[0],0,0)","    node['candidates'] = [q[0] for q in candidates]","    best = candidates[0][0]","    bestscore = -float(p[18])","    for identity, score in candidates:","        trials = node['trials'].get(identity,0)","        score += w[8]/(1+trials)-w[9]*trials","        destination = node['edges'].get(identity)","        if destination is not None:","            score -= w[10]*nodes[destination]['visits']","            if destination == state:","                score -= w[11]","        if score > bestscore:","            bestscore = score","            best = identity","    if mem['stuck'] >= p[19] and all(node['trials'].get(q[0],0)>0 for q in candidates):","        queue = [(state,None,0)]","        seen = {state}","        head = 0","        route = None","        routescore = -float(p[18])","        while head < len(queue) and head < int(p[20]):","            key, first, depth = queue[head]","            head += 1","            entry = nodes[key]","            fresh = sum(1 for a in entry.get('candidates',[]) if entry['trials'].get(a,0)==0)","            if first is not None and fresh:","                score = w[12]*fresh-w[13]*depth","                if score > routescore:","                    routescore = score","                    route = first","            for identity, destination in entry['edges'].items():","                if destination in nodes and destination not in seen:","                    seen.add(destination)","                    queue.append((destination,identity if first is None else first,depth+1))","        if route is not None:","            best = route","    node['trials'][best] = node['trials'].get(best,0)+1","    mem['previous'] = (state,best,agent,cargo)","    return best"],"shapes":{"config":[21],"weights":[14],"order":[5],"motion":[5,2],"gaps":[6],"click_colours":[3]},"params":{"config":[9,6,11,1,3,1,63,1,8,1,2,2,3,0,5,5,6,4,1000,3,300],"weights":[1,0.1,7,100,35,20,35,-12,3,1.5,0.3,45,15,2],"order":[4,3,2,1,5],"motion":[[0,4],[0,-4],[4,0],[-4,0],[0,0]],"gaps":[0,4,8,-4,-8,12],"click_colours":[6,4,11]},"rationale":"Replaces fixed downward delivery with frame-derived orientation, addressing the inverted second-level layout. Approaches the actual cargo boundary, tests several contact distances across resets, learns observed movement and cargo attachment, and transports toward detected cup openings. Retains the donor's per-state action trials, learned transition graph, novelty penalties, and BFS routing to untried actions. Tensor values determine visual identities, contact geometry, controls, and action scoring.","cannot_express":false}]