[{"game":"wa30","source_lines":["def act(params, mem, frame, avail, info):","    c = params['colors']","    q = params['cfg']","    level = info['levels']","    reset = info['resets']","    moves = mem.setdefault('moves', {})","    if mem.get('level') != level or mem.get('reset') != reset:","        mem['level'] = level","        mem['reset'] = reset","        mem['visits'] = {}","        mem['blocked'] = {}","        mem['attempts'] = {}","        mem['objects'] = {}","        mem['focus'] = None","        mem['phase'] = 0","        mem['previous'] = None","        mem['probed'] = []","        mem['stall'] = 0","        mem['round'] = 0","    stride = max(1, int(abs(q[0])))","    ceiling = max(1, min(frame.shape[0], int(q[1])))","    points = np.argwhere(frame[:ceiling] == int(c[0]))","    if len(points) == 0:","        a = int(q[2])","        if a not in avail:","            a = avail[0]","        return (a, 0, 0)","    y = int(np.sum(points[:, 0]) / len(points) + q[3])","    x = int(np.sum(points[:, 1]) / len(points) + q[4])","    pos = (x, y)","    previous = mem.get('previous')","    if previous is not None:","        dx = x - previous['pos'][0]","        dy = y - previous['pos'][1]","        magnitude = abs(dx) + abs(dy)","        action = previous['action']","        if action != int(q[2]):","            if magnitude > q[5] and magnitude <= q[6]:","                moves[action] = (dx, dy)","                mem['stall'] = 0","            elif magnitude <= q[5]:","                mem['blocked'][(previous['phase'], previous['pos'], action)] = True","                mem['stall'] += 1","        if previous['key'] == info['key']:","            mem['stall'] += 1","    remaining = set()","    for p in np.argwhere((frame[:ceiling] == int(c[1])) | (frame[:ceiling] == int(c[2])) | (frame[:ceiling] == int(c[3]))):","        remaining.add((int(p[1]), int(p[0])))","    objects = []","    goals = []","    while remaining:","        seed = next(iter(remaining))","        remaining.remove(seed)","        stack = [seed]","        component = []","        special = 0","        while stack:","            p = stack.pop()","            component.append(p)","            if int(frame[p[1], p[0]]) == int(c[2]):","                special += 1","            for off in params['neighbors']:","                n = (p[0] + int(off[0]), p[1] + int(off[1]))","                if n in remaining:","                    remaining.remove(n)","                    stack.append(n)","        if len(component) >= int(q[7]):","            center = np.sum(np.array(component), axis=0) / len(component)","            tx = int(center[0] + q[4])","            ty = int(center[1] + q[3])","            ident = (int(tx / stride), int(ty / stride))","            item = (ident, (tx, ty), len(component))","            if special > 0 or len(component) >= int(q[8]):","                goals.append(item)","            else:","                objects.append(item)","    registry = mem['objects']","    for ident, center, size in objects:","        registry.setdefault(ident, {'center': center, 'count': 0})","    focus = mem.get('focus')","    phase = mem['phase']","    if phase == 0 and focus is not None:","        present = False","        for ident, center, size in objects:","            if ident == focus:","                present = True","        if not present:","            phase = 1","            mem['phase'] = phase","            mem['focus'] = None","    target = None","    if phase == 0:","        if focus is not None and focus in registry:","            target = registry[focus]['center']","        else:","            bestscore = None","            for ident, center, size in objects:","                record = registry[ident]","                score = record['count'] * q[9] + abs(x - center[0]) + abs(y - center[1])","                if bestscore is None or score < bestscore:","                    bestscore = score","                    focus = ident","                    target = center","            mem['focus'] = focus","        if target is None:","            phase = 1","            mem['phase'] = phase","    if phase == 1:","        bestscore = None","        for ident, center, size in goals:","            score = abs(x - center[0]) + abs(y - center[1])","            if bestscore is None or score < bestscore:","                bestscore = score","                target = center","    action = None","    if target is not None:","        distance = abs(x - target[0]) + abs(y - target[1])","        if distance <= q[10]:","            action = int(q[2])","            if phase == 0:","                if focus in registry:","                    registry[focus]['count'] += 1","                mem['phase'] = 1","            else:","                mem['phase'] = 0","                mem['round'] += 1","            mem['focus'] = None","            mem['blocked'] = {}","            mem['stall'] = 0","    legal = []","    for row in params['directions']:","        a = int(row[0])","        if a in avail:","            vector = moves.get(a, (int(row[1] * stride), int(row[2] * stride)))","            legal.append((a, vector[0], vector[1], float(row[3])))","    if action is None:","        for a, dx, dy, priority in legal:","            if a not in mem['probed']:","                mem['probed'].append(a)","                action = a","                break","    visits = mem['visits']","    visits[(phase, pos)] = visits.get((phase, pos), 0) + 1","    state = (phase, pos, info['key'])","    attempts = mem['attempts'].setdefault(state, {})","    if action is None:","        queue = [pos]","        first = {pos: None}","        depth = {pos: 0}","        head = 0","        bestscore = None","        bestaction = None","        while head < len(queue) and head < int(q[11]):","            node = queue[head]","            head += 1","            if node != pos:","                distance = 0","                if target is not None:","                    distance = max(0, abs(node[0] - target[0]) + abs(node[1] - target[1]) - q[10])","                score = -distance * q[12] - depth[node] * q[13] - visits.get((phase, node), 0) * q[14]","                score -= attempts.get(first[node], 0) * q[15]","                if bestscore is None or score > bestscore:","                    bestscore = score","                    bestaction = first[node]","            for a, dx, dy, priority in legal:","                if mem['blocked'].get((phase, node, a), False):","                    continue","                dest = (node[0] + dx, node[1] + dy)","                if dest in first or dest == node:","                    continue","                valid = True","                length = max(abs(dx), abs(dy), 1)","                for offset in range(1, length + 1):","                    px = int(node[0] + dx * offset / length)","                    py = int(node[1] + dy * offset / length)","                    if px < int(q[16]) or px >= frame.shape[1] - int(q[16]) or py < int(q[16]) or py >= ceiling - int(q[16]):","                        valid = False","                    elif int(frame[py, px]) == int(c[4]):","                        valid = False","                if valid:","                    first[dest] = a if node == pos else first[node]","                    depth[dest] = depth[node] + 1","                    queue.append(dest)","        action = bestaction","    if action is None:","        bestscore = None","        for a, dx, dy, priority in legal:","            dest = (x + dx, y + dy)","            score = priority - attempts.get(a, 0) * q[17] - visits.get((phase, dest), 0) * q[18]","            if mem['blocked'].get((phase, pos, a), False):","                score -= q[19]","            if bestscore is None or score > bestscore:","                bestscore = score","                action = a","    if mem['stall'] >= int(q[20]) and int(q[2]) in avail:","        action = int(q[2])","        mem['blocked'] = {}","        mem['stall'] = 0","    if action not in avail:","        action = avail[0]","    attempts[action] = attempts.get(action, 0) + 1","    mem['previous'] = {'pos': pos, 'action': action, 'phase': phase, 'key': info['key']}","    return (action, 0, 0)"],"shapes":{"colors":[5],"cfg":[21],"directions":[4,4],"neighbors":[4,2]},"params":{"colors":[14,9,2,4,3],"cfg":[4,60,5,-0.5,0,0.5,8,3,24,80,3,256,100,0.6,0.15,3,1,25,2,100,5],"directions":[[1,0,-1,0.4],[2,0,1,0.3],[3,-1,0,0.2],[4,1,0,0.1]],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Adapt the donor's bounded path search and learned blocked edges. Infer keyboard displacement from observed player motion instead of retaining the previous attempt's unverified mapping. Separate small framed objects from the large destination, test action 5 once at each small object, then navigate to and interact with the destination. Object disappearance also triggers delivery. Interaction counts, state-conditioned action attempts, and position visits prevent repeatedly selecting the same unsuccessful object or edge. All perception, movement priors, interaction choices, and search weights are tensor-controlled.","cannot_express":false}]