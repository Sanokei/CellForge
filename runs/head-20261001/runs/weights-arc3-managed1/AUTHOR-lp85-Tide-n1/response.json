[{"game":"lp85","source_lines":["def components(frame, params):","    seen = np.zeros(frame.shape, dtype=bool)","    out = []","    height, width = frame.shape","    for y in range(height):","        for x in range(width):","            colour = int(frame[y, x])","            if seen[y, x] or params['colours'][colour] <= 0:","                continue","            todo = [(y, x)]","            seen[y, x] = True","            cells = []","            while todo:","                cy, cx = todo.pop()","                cells.append((cy, cx))","                for dy, dx in [(0, 1), (1, 0), (0, -1), (-1, 0)]:","                    ny, nx = cy + dy, cx + dx","                    if 0 <= ny < height and 0 <= nx < width:","                        if not seen[ny, nx] and frame[ny, nx] == colour:","                            seen[ny, nx] = True","                            todo.append((ny, nx))","            area = len(cells)","            if params['limits'][0] <= area <= params['limits'][1]:","                ys = [p[0] for p in cells]","                xs = [p[1] for p in cells]","                h = max(ys) - min(ys) + 1","                w = max(xs) - min(xs) + 1","                if max(h, w) <= params['limits'][2] * min(h, w):","                    cy = int(sum(ys) / area)","                    cx = int(sum(xs) / area)","                    point = min(cells, key=lambda p: abs(p[0] - cy) + abs(p[1] - cx))","                    out.append((point[1], point[0], colour, area, w, h))","    return out","def ring_tiles(objects, params):","    tiles = [o for o in objects if params['limits'][3] <= o[3] <= params['limits'][4] and o[4] == o[5]]","    if len(tiles) < int(params['limits'][5]):","        return []","    left = min(o[0] for o in tiles)","    right = max(o[0] for o in tiles)","    top = min(o[1] for o in tiles)","    bottom = max(o[1] for o in tiles)","    def order(o):","        x, y = o[0], o[1]","        if y == top:","            return (0, x)","        if x == right:","            return (1, y)","        if y == bottom:","            return (2, -x)","        return (3, -y)","    return sorted(tiles, key=order)","def quality(values, tiles, params):","    if not values:","        return 0.0","    total = 0.0","    for i in range(len(values)):","        if values[i] == values[(i + 1) % len(values)]:","            total += params['score'][0]","    top = min(t[1] for t in tiles)","    bottom = max(t[1] for t in tiles)","    for i in range(len(tiles)):","        if tiles[i][1] == top:","            for j in range(len(tiles)):","                if tiles[j][1] == bottom and tiles[j][0] == tiles[i][0]:","                    if values[i] == values[j]:","                        total += params['score'][1]","    total += params['score'][2] * params['colours'][values[0]]","    return total","def act(params, mem, frame, avail, info):","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('epoch') != (level, reset):","        mem.clear()","        mem['epoch'] = (level, reset)","        mem['nodes'] = {}","        mem['models'] = {}","        mem['counts'] = {}","    objects = components(frame, params)","    tiles = ring_tiles(objects, params)","    positions = tuple((t[0], t[1]) for t in tiles)","    values = tuple(t[2] for t in tiles)","    key = info.get('key', '')","    nodes = mem['nodes']","    node = nodes.setdefault(key, {'visits': 0, 'edges': {}, 'blocked': []})","    node['visits'] += 1","    if 'last' in mem:","        oldkey, action, oldvalues, oldpositions = mem['last']","        oldnode = nodes[oldkey]","        oldnode['edges'][action] = key","        if key == oldkey:","            if action not in oldnode['blocked']:","                oldnode['blocked'].append(action)","        elif positions == oldpositions and len(values) == len(oldvalues) and values:","            models = mem['models']","            candidates = models.get(action)","            if candidates is None:","                candidates = [list(range(len(values))) for v in values]","            narrowed = []","            for i in range(len(values)):","                narrowed.append([j for j in candidates[i] if oldvalues[j] == values[i]])","            if all(len(c) > 0 for c in narrowed):","                models[action] = narrowed","            else:","                models[action] = [[j for j in range(len(values)) if oldvalues[j] == values[i]] for i in range(len(values))]","    choices = {}","    if 6 in avail:","        for o in objects:","            action = (6, o[0], o[1])","            priority = params['colours'][o[2]]","            if o[3] >= params['limits'][6]:","                priority += params['score'][3]","            choices[action] = priority","    for action in avail:","        if action != 6:","            choices[(action, 0, 0)] = params['score'][4]","    node['choices'] = list(choices)","    candidates = [a for a in choices if a not in node['blocked']]","    best = None","    bestscore = -1000000000.0","    for action in candidates:","        destination = node['edges'].get(action)","        visits = nodes.get(destination, {}).get('visits', 0)","        score = choices[action]","        score -= params['score'][5] * visits","        score -= params['score'][6] * mem['counts'].get(action, 0)","        if destination is None:","            score += params['score'][7]","        model = mem['models'].get(action)","        if model is not None and len(model) == len(values) and all(len(c) == 1 for c in model):","            predicted = tuple(values[c[0]] for c in model)","            beam = [(predicted, quality(predicted, tiles, params))]","            future = beam[0][1]","            for depth in range(int(params['limits'][7])):","                expanded = []","                for state, reward in beam:","                    for other in mem['models'].values():","                        if len(other) == len(state) and all(len(c) == 1 for c in other):","                            nxt = tuple(state[c[0]] for c in other)","                            value = quality(nxt, tiles, params)","                            expanded.append((nxt, value))","                            future = max(future, value * params['score'][8] ** (depth + 1))","                if not expanded:","                    break","                beam = sorted(expanded, key=lambda item: item[1], reverse=True)[:int(params['limits'][8])]","            score += params['score'][9] * future","        if score > bestscore:","            bestscore = score","            best = action","    if best is None or bestscore < params['score'][10]:","        queue = [(key, None)]","        seen = {key}","        head = 0","        route = None","        while head < len(queue) and head < int(params['limits'][9]):","            current, first = queue[head]","            head += 1","            currentnode = nodes[current]","            frontier = [a for a in currentnode.get('choices', []) if a not in currentnode['edges'] and a not in currentnode['blocked']]","            if frontier and first is not None:","                route = first","                break","            for action, destination in currentnode['edges'].items():","                if destination not in seen and destination in nodes and destination != current:","                    seen.add(destination)","                    queue.append((destination, action if first is None else first))","        if route is not None and route in choices:","            best = route","    if best is None:","        if choices:","            best = min(choices, key=lambda a: mem['counts'].get(a, 0))","        else:","            best = (avail[0], int(params['fallback'][0]), int(params['fallback'][1]))","    mem['counts'][best] = mem['counts'].get(best, 0) + 1","    mem['last'] = (key, best, values, positions)","    return best"],"shapes":{"colours":[16],"limits":[10],"score":[11],"fallback":[2]},"params":{"colours":[0,1,1,-1,-1,-1,0,0,4,1,1,1,0,0,4,1],"limits":[9,160,3,12,20,6,28,3,12,512],"score":[1,2,0.15,5,1,6,0.025,12,0.92,1.5,-8],"fallback":[32,32]},"rationale":"Segments visible coloured objects and prioritizes the two observed arrow controls. Learns state-dependent click transitions, suppresses unchanged clicks, tracks visited boards, and routes through known transitions toward unexplored actions. Repeated observations identify tile permutations; short model-based lookahead favors adjacent colour groups and matching opposing rows, exploratory hypotheses rather than assumed rules. Colour, geometry, exploration, and planning tensors directly determine behavior. No game runner was provided, so completion and control comparisons could not be validated.","cannot_express":false}]