[{"game":"tu93","source_lines":["def act(params, mem, frame, avail, info):","    c = params['config']","    colours = params['colours']","    board = frame[:max(1, min(frame.shape[0], int(c[0])))]","    signature = tuple(int(v) for v in board.flatten())","    level = info['levels']","    reset = info['resets']","    points = np.argwhere(board == int(colours[0]))","    actor = None","    if len(points):","        r, x = int(points[0][0]), int(points[0][1])","        body = np.argwhere((board == int(colours[0])) | (board == int(colours[1])))","        near = [(int(p[0]), int(p[1])) for p in body if abs(int(p[0]) - r) <= c[2] and abs(int(p[1]) - x) <= c[2]]","        if near:","            actor = ((min(p[0] for p in near) + max(p[0] for p in near)) // 2, (min(p[1] for p in near) + max(p[1] for p in near)) // 2)","    targets = np.argwhere(board == int(colours[2]))","    goals = [(int(p[0]), int(p[1])) for p in targets]","    records = mem.setdefault('records', {})","    record = records.setdefault(level, {'states': {}, 'fail': {}, 'death': {}, 'visits': {}})","    node = record['states'].setdefault(signature, {'used': {}, 'edges': {}})","    motion = mem.setdefault('motion', {})","    previous = mem.get('previous')","    if previous is not None:","        oldlevel, oldreset, oldsignature, oldactor, oldaction = previous","        oldrecord = records[oldlevel]","        oldnode = oldrecord['states'][oldsignature]","        if level == oldlevel and reset == oldreset:","            oldnode['edges'][oldaction] = signature","            if actor is not None and oldactor is not None:","                dr, dx = actor[0] - oldactor[0], actor[1] - oldactor[1]","                edge = (oldactor, oldaction)","                if c[3] <= abs(dr) + abs(dx) <= c[4] and (dr == 0 or dx == 0):","                    motion[oldaction] = (dr, dx)","                    oldrecord['fail'][edge] = 0","                elif actor == oldactor:","                    oldrecord['fail'][edge] = oldrecord['fail'].get(edge, 0) + 1","        elif level == oldlevel and oldactor is not None:","            edge = (oldactor, oldaction)","            oldrecord['death'][edge] = oldrecord['death'].get(edge, 0) + 1","    moves = []","    for i in range(len(params['order'])):","        action = int(params['order'][i])","        if action in avail:","            dr, dx = motion.get(action, (int(params['directions'][i][0]), int(params['directions'][i][1])))","            moves.append((action, dr, dx, i))","    if actor is not None:","        record['visits'][actor] = record['visits'].get(actor, 0) + 1","    route = None","    if actor is not None and goals:","        distances = {actor: 0.0}","        first = {}","        pending = [actor]","        done = set()","        expanded = 0","        while pending and expanded < int(c[5]):","            p = min(pending, key=lambda q: distances[q])","            pending.remove(p)","            if p in done:","                continue","            done.add(p)","            expanded += 1","            if min(abs(p[0] - g[0]) + abs(p[1] - g[1]) for g in goals) <= c[6]:","                route = first.get(p)","                break","            for action, dr, dx, rank in moves:","                q = (p[0] + dr, p[1] + dx)","                if q in done or q[0] < 0 or q[1] < 0 or q[0] >= board.shape[0] or q[1] >= board.shape[1]:","                    continue","                length = max(abs(dr), abs(dx))","                if length == 0:","                    continue","                clear = True","                danger = 0","                for t in range(1, length + 1):","                    r = p[0] + int(round(dr * t / length))","                    x = p[1] + int(round(dx * t / length))","                    value = int(board[r, x])","                    if value == int(colours[3]):","                        clear = False","                        break","                    if any(value == int(v) for v in params['hazards']):","                        danger = 1","                if not clear:","                    continue","                edge = (p, action)","                cost = distances[p] + c[7] + c[8] * danger + c[9] * record['death'].get(edge, 0) + c[10] * record['fail'].get(edge, 0)","                if p == actor:","                    cost += c[11] * record['visits'].get(q, 0) + c[12] * node['used'].get(action, 0)","                cost += c[13] * rank","                if q not in distances or cost < distances[q]:","                    distances[q] = cost","                    first[q] = action if p == actor else first[p]","                    pending.append(q)","    action = None","    if route is not None:","        action = route","    else:","        best = -float(c[14])","        for candidate, dr, dx, rank in moves:","            score = -c[15] * node['used'].get(candidate, 0) - c[13] * rank","            destination = node['edges'].get(candidate)","            if destination == signature:","                score -= c[16]","            elif destination is not None:","                score -= c[17] * sum(record['states'][destination]['used'].values())","            if actor is not None:","                score -= c[9] * record['death'].get((actor, candidate), 0)","            if score > best:","                best = score","                action = candidate","    click = int(c[18])","    x, y = 0, 0","    if action is None and click in avail:","        objects = np.argwhere((board == int(colours[2])) | (board == int(colours[0])))","        if len(objects):","            choices = [(int(p[1]), int(p[0])) for p in objects]","            x, y = min(choices, key=lambda p: node['used'].get((click, p[0], p[1]), 0))","        action = click","        identity = (click, x, y)","    else:","        if action is None:","            action = avail[0]","        identity = action","    node['used'][identity] = node['used'].get(identity, 0) + 1","    mem['previous'] = (level, reset, signature, actor, action)","    return (int(action), int(x), int(y))"],"shapes":{"config":[19],"colours":[4],"hazards":[2],"order":[4],"directions":[4,2]},"params":{"config":[63,6,3,4,8,1000,1,1,80,200,25,0.35,3,0.001,1000,20,80,0.5,6],"colours":[4,9,14,5],"hazards":[12,15],"order":[4,2,3,1],"directions":[[0,6],[6,0],[0,-6],[-6,0]]},"rationale":"Preserves the credited cell's maze routing, action priors, online movement learning, and level-specific exploration memory. Corrects its crucial localization error: colour 4 marks an offset within the nine-pixel player, so movement is inferred from the whole player's centre. Replaces novelty-dominated routing with weighted shortest paths, penalizes visible hazards, learns failed and fatal edges per level, and adds visited-position penalties when progress stalls. Timer pixels are excluded from state identity; all routes are computed from the current frame.","cannot_express":false}]