[{"game":"r11l","source_lines":["def blobs(frame, colour, radius):","    remaining = set((int(p[0]), int(p[1])) for p in np.argwhere(frame == colour))","    out = []","    while remaining:","        start = remaining.pop()","        todo = [start]","        cells = [start]","        while todo:","            y, x = todo.pop()","            for dy in range(-radius, radius + 1):","                for dx in range(-radius, radius + 1):","                    q = (y + dy, x + dx)","                    if q in remaining:","                        remaining.remove(q)","                        todo.append(q)","                        cells.append(q)","        out.append(cells)","    return out","def midpoint(cells):","    return (sum(p[1] for p in cells) / len(cells), sum(p[0] for p in cells) / len(cells))","def distance(a, b):","    return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2","def locate(frame, colour, area, tolerance, radius):","    groups = blobs(frame, colour, radius)","    good = [g for g in groups if abs(len(g) - area) <= tolerance]","    if not good:","        return None","    return midpoint(min(good, key=lambda g: abs(len(g) - area)))","def act(params, mem, frame, avail, info):","    p = params['settings']","    directions = params['directions']","    level = info.get('levels', 0)","    reset = info.get('resets', 0)","    if mem.get('level') != level:","        mem.clear()","        mem['level'] = level","        mem['models'] = {}","        mem['pairs'] = {}","        mem['edges'] = {}","        mem['visits'] = {}","        mem['failed'] = {}","    if mem.get('reset') != reset:","        mem['reset'] = reset","        mem.pop('last', None)","        mem.pop('span', None)","    active = locate(frame, int(p[0]), p[6], p[7], int(p[8]))","    other = locate(frame, int(p[1]), p[6], p[7], int(p[8]))","    ball = locate(frame, int(p[2]), p[9], p[10], int(p[8]))","    if active is None or other is None or ball is None:","        groups = blobs(frame, int(p[3]), int(p[11]))","        if groups:","            x, y = midpoint(max(groups, key=len))","            return (avail[0], int(round(x)), int(round(y)))","        return (avail[0], int(p[12]), int(p[13]))","    targets = []","    for group in blobs(frame, int(p[3]), int(p[11])):","        centre = midpoint(group)","        if len(group) >= p[14] and min(distance(centre, active), distance(centre, other), distance(centre, ball)) > p[15] ** 2:","            targets.append((abs(len(group) - p[16]), centre))","    if targets:","        targets.sort(key=lambda v: v[0])","        mem['target'] = targets[0][1]","    target = mem.get('target')","    if target is None:","        target = (p[12], p[13])","    if 'span' not in mem:","        mem['span'] = (other[0] - active[0], other[1] - active[1])","    span = mem['span']","    quant = max(p[17], 1.0)","    state = tuple(int(round(v / quant)) for v in (active[0], active[1], other[0], other[1], ball[0], ball[1]))","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    if 'last' in mem:","        oldstate, oldactive, oldother, oldball, action, oldframe = mem['last']","        mem['edges'][(oldstate, action)] = state","        if action < len(directions):","            dx = active[0] - oldactive[0]","            dy = active[1] - oldactive[1]","            motion = dx * dx + dy * dy","            changed = int(np.sum(frame != oldframe))","            failed = motion < p[18] ** 2 or changed <= p[19]","            mem['failed'][(oldstate, action)] = failed","            if not failed and motion < p[20] ** 2 and distance(other, oldother) < p[21] ** 2:","                model = mem['models'].setdefault(action, [0.0, 0.0, 0.0])","                model[0] += dx","                model[1] += dy","                model[2] += 1.0","    models = mem['models']","    moves = []","    for i in range(len(directions)):","        ux, uy = directions[i]","        length = max((ux * ux + uy * uy) ** 0.5, p[22])","        dx = p[23] * ux / length","        dy = p[23] * uy / length","        if i in models:","            m = models[i]","            dx = m[0] / max(m[2], 1.0)","            dy = m[1] / max(m[2], 1.0)","        moves.append((dx, dy))","    residual = (ball[0] - (active[0] + other[0]) / 2, ball[1] - (active[1] + other[1]) / 2)","    bound = int(p[24])","    def legal(a, b):","        for fraction in params['fractions']:","            x = int(round(a[0] + fraction * (b[0] - a[0])))","            y = int(round(a[1] + fraction * (b[1] - a[1])))","            if x < 0 or y < 0 or x > bound or y > bound:","                return False","            if int(frame[y, x]) == int(p[4]):","                return False","        return True","    def value(a, b):","        centre = ((a[0] + b[0]) / 2 + residual[0], (a[1] + b[1]) / 2 + residual[1])","        separation = distance(a, b) ** 0.5","        original = (span[0] * span[0] + span[1] * span[1]) ** 0.5","        return distance(centre, target) + p[25] * (distance(a, target) + distance(b, target)) + p[26] * (separation - original) ** 2","    beam = [(active, other, None, 0.0)]","    best = None","    bestvalue = float('inf')","    reached = set()","    switch = len(directions)","    for depth in range(max(1, int(p[27]))):","        candidates = []","        for a, b, first, cost in beam:","            for action in range(len(directions) + 1):","                if first is None:","                    if mem['failed'].get((state, action), False):","                        continue","                    penalty = p[28] * mem['pairs'].get((state, action), 0)","                    nxt = mem['edges'].get((state, action))","                    if nxt is not None:","                        penalty += p[29] * visits.get(nxt, 0)","                else:","                    penalty = 0.0","                if action == switch:","                    na, nb = b, a","                    penalty += p[30]","                else:","                    dx, dy = moves[action]","                    na = (a[0] + dx, a[1] + dy)","                    nb = b","                    if not legal(a, na):","                        continue","                initial = action if first is None else first","                signature = (int(round(na[0] / quant)), int(round(na[1] / quant)), int(round(nb[0] / quant)), int(round(nb[1] / quant)), initial)","                if signature in reached:","                    continue","                reached.add(signature)","                newcost = cost + penalty + p[31]","                score = value(na, nb) + newcost","                if score < bestvalue:","                    bestvalue = score","                    best = initial","                candidates.append((score, na, nb, initial, newcost))","        if not candidates:","            break","        candidates.sort(key=lambda v: v[0])","        beam = [(v[1], v[2], v[3], v[4]) for v in candidates[:max(1, int(p[32]))]]","    if best is None:","        options = []","        for action in range(len(directions) + 1):","            penalty = p[28] * mem['pairs'].get((state, action), 0)","            penalty += p[33] * float(mem['failed'].get((state, action), False))","            options.append((penalty, action))","        options.sort()","        best = options[0][1]","    if best == switch:","        x, y = other","    else:","        ux, uy = directions[best]","        norm = max((ux * ux + uy * uy) ** 0.5, p[22])","        x = active[0] + p[34] * ux / norm","        y = active[1] + p[34] * uy / norm","    x = max(0, min(bound, int(round(x))))","    y = max(0, min(bound, int(round(y))))","    mem['pairs'][(state, best)] = mem['pairs'].get((state, best), 0) + 1","    mem['last'] = (state, active, other, ball, best, frame.copy())","    return (6 if 6 in avail else avail[0], x, y)"],"shapes":{"settings":[35],"directions":[16,2],"fractions":[3]},"params":{"settings":[0,3,6,15,2,5,12,5,1,1,0,2,32,32,8,7,12,1,0.2,1,12,2,0.01,2,63,0.08,0.025,7,18,8,1.5,0.2,48,80,14],"directions":[[1,0],[2,1],[1,1],[1,2],[0,1],[-1,2],[-1,1],[-2,1],[-1,0],[-2,-1],[-1,-1],[-1,-2],[0,-1],[1,-2],[1,-1],[2,-1]],"fractions":[0.33,0.67,1]},"rationale":"Treat the two small endpoint components as selectable moving handles and the isolated colour-6 centre as the controlled object. Detect the distant white ring from current geometry. Retain the donor's observed transition graph, visit penalties, online action models and bounded lookahead, replacing tile permutations with learned endpoint displacements. Clicking the alternative endpoint permits coordinated movement of both ends. Frame comparisons identify ineffective state/action pairs, while terrain checks and midpoint scoring guide a short beam search toward the ring. All colour roles, geometry thresholds, movement scales and search preferences are tensor parameters.","cannot_express":false}]