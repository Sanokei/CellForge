[{"game":"ar25","source_lines":["def act(params, mem, frame, avail, info):","    cfg = params['cfg']","    moves = params['moves']","    w = params['weights']","    level = info['levels']","    if mem.get('level') != level or mem.get('reset') != info['resets']:","        mem.clear()","        mem['level'] = level","        mem['reset'] = info['resets']","        mem['effects'] = {}","        mem['visits'] = {}","        mem['tried'] = {}","    edge = int(cfg[3])","    points = np.argwhere(frame == int(cfg[0]))","    points = points[(points[:, 0] < edge) & (points[:, 1] < edge)]","    mode = int(cfg[0])","    if len(points) == 0:","        mode = int(cfg[2])","        points = np.argwhere(frame == mode)","        points = points[(points[:, 0] < edge) & (points[:, 1] < edge)]","    pixels = np.argwhere(frame == int(cfg[1]))","    pixels = pixels[(pixels[:, 0] < edge) & (pixels[:, 1] < edge)]","    remaining = set(tuple(p) for p in pixels.tolist())","    goals = []","    while remaining:","        seed = remaining.pop()","        component = [seed]","        queue = [seed]","        head = 0","        while head < len(queue):","            y, x = queue[head]","            head += 1","            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:","                neighbour = (y + dy, x + dx)","                if neighbour in remaining:","                    remaining.remove(neighbour)","                    queue.append(neighbour)","                    component.append(neighbour)","        if len(component) >= cfg[4]:","            goals.append(np.array(component))","    if len(goals) > 0:","        mem['goals'] = goals","    else:","        goals = mem.get('goals', [])","    if len(points) == 0:","        for row in moves:","            if int(row[0]) in avail:","                return (int(row[0]), 0, 0)","        return (avail[0], 0, 0)","    centre = np.sum(points, axis=0) / len(points)","    previous = mem.get('centre')","    last = mem.get('last')","    if previous is not None and last is not None and mem.get('mode') == mode:","        delta = centre - previous","        magnitude = np.sum(np.abs(delta))","        if magnitude > cfg[5] and magnitude < cfg[6]:","            token = (mode, last)","            old = mem['effects'].get(token)","            if old is None:","                mem['effects'][token] = delta.copy()","            else:","                mem['effects'][token] = old * w[0] + delta * (1 - w[0])","        if magnitude < cfg[5]:","            oldstate = mem.get('state')","            if oldstate is not None:","                blocked = mem['tried'].setdefault(oldstate, {})","                blocked[last] = blocked.get(last, 0) + w[1]","    state = (mode, tuple(np.sum(points, axis=0).tolist()), len(points))","    visits = mem['visits']","    visits[state] = visits.get(state, 0) + 1","    tried = mem['tried'].setdefault(state, {})","    candidates = []","    for index in range(len(moves)):","        row = moves[index]","        action = int(row[0])","        if action not in avail:","            continue","        delta = row[1:3].copy()","        if mode == int(cfg[2]):","            delta[1] = -delta[1]","        delta = mem['effects'].get((mode, action), delta)","        shifted = points + delta.astype(int)","        nextstate = (mode, tuple(np.sum(shifted, axis=0).tolist()), len(points))","        score = w[2] * visits.get(nextstate, 0) + w[3] * tried.get(action, 0) + w[4] * index","        invalid = np.sum((shifted[:, 0] < 0) | (shifted[:, 0] >= edge) | (shifted[:, 1] < 0) | (shifted[:, 1] >= edge))","        score += w[5] * invalid","        best = None","        for goal in goals:","            gc = np.sum(goal, axis=0) / len(goal)","            distance = np.sum(np.abs(centre + delta - gc))","            targetset = set(tuple(p) for p in goal.tolist())","            overlap = 0","            for pixel in shifted.tolist():","                if tuple(pixel) in targetset:","                    overlap += 1","            value = w[6] * distance - w[7] * overlap + w[8] * abs(len(goal) - len(points))","            if best is None or value < best:","                best = value","        if best is not None:","            score += best","        candidates.append([score, action])","    if int(cfg[7]) in avail and visits[state] > cfg[8]:","        candidates.append([w[9] + w[3] * tried.get(int(cfg[7]), 0), int(cfg[7])])","    if len(candidates) == 0:","        action = avail[0]","    else:","        candidates.sort()","        action = candidates[0][1]","    tried[action] = tried.get(action, 0) + 1","    mem['centre'] = centre.copy()","    mem['mode'] = mode","    mem['last'] = action","    mem['state'] = state","    return (action, 0, 0)"],"shapes":{"cfg":[9],"moves":[4,3],"weights":[10]},"params":{"cfg":[4,11,5,63,3,0.5,12,5,3],"moves":[[2,3,0],[3,0,3],[1,-3,0],[4,0,-3]],"weights":[0.25,4,2,3,0.03,12,4,2,0.1,25]},"rationale":"The probe and final frame indicate that the solid colour-4 shape moves horizontally opposite the perforated colour-5 shape. This revision directly aligns that reflected shape with interior colour-11 target components, learns actual movement effects online, excludes the border and timer from state keys, penalizes blocked moves, and eliminates the previous unbounded click loop. Shape overlap guides alignment more precisely than chasing the other movable shape.","cannot_express":false}]