[{"task_id":"30f42897","source_lines":["def run(params, grid, demos):","    bg = int(round(params['rule'][0]))","    z = int(round(params['rule'][1]))","    step = int(round(params['rule'][2]))","    factor = int(round(params['rule'][3]))","    back = int(round(params['rule'][4]))","    out = grid.copy()","    h, w = grid.shape","    if step == 0 or back == 0:","        return out","    coords = []","    for c in range(z, w, step):","        coords.append((z, c))","    for r in range(step, h, step):","        coords.append((r, w - step))","    for c in range(w - factor, back, back):","        coords.append((h - step, c))","    for r in range(h - factor, z, back):","        coords.append((r, z))","    if len(coords) == 0:","        return out","    for r, c in coords:","        if r < 0 or r >= h or c < 0 or c >= w:","            return out","    marks = [grid[r, c] != bg for r, c in coords]","    n = sum(marks)","    period = factor * n","    if n == 0 or period <= 0:","        return out","    start = None","    for i in range(len(coords)):","        if marks[i] and not marks[(i + back) % len(coords)]:","            start = i","            break","    if start is None:","        return out","    r, c = coords[start]","    color = int(grid[r, c])","    for i in range(len(coords)):","        if (i - start) % period < n:","            r, c = coords[i]","            out[r, c] = color","    return out"],"shapes":{"rule":[5]},"params":{"rule":[8,0,1,2,-1]},"rationale":"Trace the perimeter clockwise. The existing colored segment sets the phase and run length; extend it around the border with alternating equally long colored and background runs."}]