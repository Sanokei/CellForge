[{"task_id":"45bbe264~v","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    intersection = int(round(params['colors'][1]))","    points = np.argwhere(grid != background)","    result = grid.copy()","    for r, c in points:","        color = int(grid[r, c])","        result[r, :] = color","        result[:, c] = color","    for r, c in points:","        for s, t in points:","            if r != s and c != t:","                result[r, t] = intersection","    return result"],"shapes":{"colors":[2]},"params":{"colors":[0,3]},"rationale":"Extend every nonbackground seed across its entire row and column in its original color. Mark crossings between different seeds with green, while preserving each seed's own crossing."}]