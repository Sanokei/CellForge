[{"task_id":"5daaa586","source_lines":["def run(params, grid, demos):","    background = int(round(params['settings'][0]))","    dominance = float(params['settings'][1])","    height = len(grid)","    width = len(grid[0])","    rows = []","    columns = []","    for r in range(height):","        for color in np.unique(grid[r, :]):","            if color != background and np.count_nonzero(grid[r, :] == color) >= dominance * width:","                rows.append(r)","                break","    for c in range(width):","        for color in np.unique(grid[:, c]):","            if color != background and np.count_nonzero(grid[:, c] == color) >= dominance * height:","                columns.append(c)","                break","    if len(rows) < 2 or len(columns) < 2:","        return grid.copy()","    top = min(rows)","    bottom = max(rows)","    left = min(columns)","    right = max(columns)","    original = grid[top:bottom + 1, left:right + 1].copy()","    result = original.copy()","    h = len(original)","    w = len(original[0])","    for position in np.argwhere(original != background):","        r = int(position[0])","        c = int(position[1])","        if r == 0 or r == h - 1 or c == 0 or c == w - 1:","            continue","        color = original[r, c]","        for direction in params['directions']:","            dr = int(round(direction[0]))","            dc = int(round(direction[1]))","            if dr == 0 and dc == 0:","                continue","            endpoint_r = r","            endpoint_c = c","            if dr < 0:","                endpoint_r = 0","            elif dr > 0:","                endpoint_r = h - 1","            if dc < 0:","                endpoint_c = 0","            elif dc > 0:","                endpoint_c = w - 1","            if original[endpoint_r, endpoint_c] != color:","                continue","            rr = r","            cc = c","            while 0 < rr < h - 1 and 0 < cc < w - 1:","                result[rr, cc] = color","                rr += dr","                cc += dc","    return result"],"shapes":{"settings":[2],"directions":[4,2]},"params":{"settings":[0,0.75],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Identify the two dominant horizontal and vertical boundary lines and crop inclusively to their rectangle. Extend each interior colored seed toward any boundary of the same color, preserving the boundary cells. The tensors encode background, line dominance, and the four ray directions."}]