[{"task_id":"8fbca751~v","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    fg = int(round(params['colors'][1]))","    fill = int(round(params['colors'][2]))","    near = int(round(params['merge'][0]))","    overlap = int(round(params['merge'][1]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    h, w = grid.shape","    seen = set()","    boxes = []","    for r in range(h):","        for c in range(w):","            if grid[r, c] != fg or (r, c) in seen:","                continue","            pending = [(r, c)]","            seen.add((r, c))","            rows = []","            cols = []","            while pending:","                y, x = pending.pop()","                rows.append(y)","                cols.append(x)","                for dy, dx in directions:","                    yy, xx = y + dy, x + dx","                    if 0 <= yy < h and 0 <= xx < w:","                        if grid[yy, xx] == fg and (yy, xx) not in seen:","                            seen.add((yy, xx))","                            pending.append((yy, xx))","            boxes.append([min(rows), max(rows), min(cols), max(cols)])","    changed = True","    while changed:","        changed = False","        for i in range(len(boxes)):","            if changed:","                break","            for j in range(i + 1, len(boxes)):","                a, b = boxes[i], boxes[j]","                rowgap = max(a[0] - b[1], b[0] - a[1])","                colgap = max(a[2] - b[3], b[2] - a[3])","                if (rowgap <= overlap and colgap <= near) or (colgap <= overlap and rowgap <= near):","                    boxes[i] = [min(a[0], b[0]), max(a[1], b[1]), min(a[2], b[2]), max(a[3], b[3])]","                    boxes.pop(j)","                    changed = True","                    break","    out = grid.copy()","    for top, bottom, left, right in boxes:","        for r in range(top, bottom + 1):","            for c in range(left, right + 1):","                if out[r, c] == bg:","                    out[r, c] = fill","    return out"],"shapes":{"colors":[3],"directions":[4,2],"merge":[2]},"params":{"colors":[0,2,6],"directions":[[-1,0],[1,0],[0,-1],[0,1]],"merge":[1,0]},"rationale":"Find red components and merge their bounding rectangles when they overlap or meet along an edge, preserving separation at diagonal corners. Fill background cells inside each resulting rectangle with magenta. This also incorporates isolated red cells adjacent to an object's bounding rectangle."}]