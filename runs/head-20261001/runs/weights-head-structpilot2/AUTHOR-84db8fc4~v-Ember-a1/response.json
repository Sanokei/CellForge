[{"task_id":"84db8fc4~v","source_lines":["def run(params, grid, demos):","    blank = int(round(params['colors'][0]))","    exterior = int(round(params['colors'][1]))","    interior = int(round(params['colors'][2]))","    low = int(round(params['bounds'][0]))","    step = int(round(params['bounds'][1]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    height, width = grid.shape","    out = grid.copy()","    out[grid == blank] = interior","    pending = []","    visited = set()","    for r in range(height):","        for c in range(width):","            if grid[r, c] == blank:","                if r == low or c == low or r == height - step or c == width - step:","                    visited.add((r, c))","                    pending.append((r, c))","    while pending:","        r, c = pending.pop()","        out[r, c] = exterior","        for dr, dc in directions:","            nr, nc = r + dr, c + dc","            if low <= nr < height and low <= nc < width:","                if (nr, nc) not in visited and grid[nr, nc] == blank:","                    visited.add((nr, nc))","                    pending.append((nr, nc))","    return out"],"shapes":{"colors":[3],"bounds":[2],"directions":[4,2]},"params":{"colors":[0,1,4],"bounds":[0,1],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Replace zero regions connected orthogonally to the grid boundary with blue (1), and enclosed zero regions with yellow (4). Preserve all other cells. Colors, boundary offsets, and connectivity directions are encoded in the tensors."}]