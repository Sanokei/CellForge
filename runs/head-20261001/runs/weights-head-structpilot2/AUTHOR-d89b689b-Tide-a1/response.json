[{"task_id":"d89b689b","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    marker = int(round(params['colors'][1]))","    fraction = float(params['geometry'][0])","    near = int(round(params['geometry'][1]))","    far = int(round(params['geometry'][2]))","    result = grid.copy()","    result[:] = background","    positions = np.argwhere(grid == marker)","    if len(positions) == 0:","        return result","    lower = np.min(positions, axis=0)","    upper = np.max(positions, axis=0)","    center = lower + fraction * (upper - lower)","    sources = np.argwhere(np.logical_and(grid != background, grid != marker))","    for position in sources:","        row = int(position[0])","        col = int(position[1])","        row_offset = far if row > center[0] else near","        col_offset = far if col > center[1] else near","        target_row = int(lower[0]) + row_offset","        target_col = int(lower[1]) + col_offset","        if 0 <= target_row < grid.shape[0] and 0 <= target_col < grid.shape[1]:","            result[target_row, target_col] = grid[row, col]","    return result"],"shapes":{"colors":[2],"geometry":[3]},"params":{"colors":[0,8],"geometry":[0.5,0,1]},"rationale":"Replace the azure square with the four isolated colors, preserving their quadrants relative to the square's center, and clear all other cells. The tensors specify background, marker, center fraction, and quadrant offsets."}]