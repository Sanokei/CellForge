[{"task_id":"9caba7c3","source_lines":["def run(params, grid, demos):","    red = int(round(params['rule'][0]))","    gray = int(round(params['rule'][1]))","    border = int(round(params['rule'][2]))","    center = int(round(params['rule'][3]))","    size = int(round(params['rule'][4]))","    unit = int(round(params['rule'][5]))","    out = grid.copy()","    if unit <= 0 or size <= unit:","        return out","    reach = size - unit","    middle = size // (unit + unit)","    points = np.argwhere(grid == red).tolist()","    pending = list(range(len(points)))","    groups = []","    while pending:","        group = [pending.pop()]","        cursor = 0","        while cursor < len(group):","            p = points[group[cursor]]","            remaining = []","            for index in pending:","                q = points[index]","                if max(abs(p[0] - q[0]), abs(p[1] - q[1])) <= reach:","                    group.append(index)","                else:","                    remaining.append(index)","            pending = remaining","            cursor += unit","        groups.append([points[index] for index in group])","    height, width = grid.shape","    for group in groups:","        rows = [p[0] for p in group]","        cols = [p[1] for p in group]","        for top in range(max(0, max(rows) - reach), min(rows) + unit):","            for left in range(max(0, max(cols) - reach), min(cols) + unit):","                if top + size > height or left + size > width:","                    continue","                patch = grid[top:top + size, left:left + size]","                if not np.all(np.isin(patch, [red, gray])):","                    continue","                if patch[middle, middle] != gray:","                    continue","                for dr in range(size):","                    for dc in range(size):","                        if patch[dr, dc] == gray:","                            out[top + dr, left + dc] = border","                out[top + middle, left + middle] = center","    return out"],"shapes":{"rule":[6]},"params":{"rule":[2,5,7,4,3,1]},"rationale":"Group nearby red clues belonging to the same square. Find the solid 3×3 gray/red square containing every clue in each group, preserve red cells, recolor the remaining perimeter orange, and mark its center yellow."}]