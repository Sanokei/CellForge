[{"task_id":"5c0a986e","source_lines":["def run(params, grid, demos):","    out = grid.copy()","    background = int(round(params['background'][0]))","    height, width = grid.shape","    for gene in params['rays']:","        colour = int(round(gene[0]))","        dr = int(round(gene[1]))","        dc = int(round(gene[2]))","        points = np.argwhere(grid == colour)","        if len(points) == 0:","            continue","        if dr < 0:","            row = int(np.min(points[:, 0]))","        else:","            row = int(np.max(points[:, 0]))","        if dc < 0:","            col = int(np.min(points[:, 1]))","        else:","            col = int(np.max(points[:, 1]))","        for step in range(height + width):","            row += dr","            col += dc","            if row < 0 or row >= height or col < 0 or col >= width:","                break","            if out[row, col] == background:","                out[row, col] = colour","    return out"],"shapes":{"background":[1],"rays":[2,3]},"params":{"background":[0],"rays":[[1,-1,-1],[2,1,1]]},"rationale":"Extend a blue diagonal northwest from the blue square's upper-left corner and a red diagonal southeast from the red square's lower-right corner, continuing to the grid boundary."}]