[{"task_id":"e57337a4","source_lines":["def run(params, grid, demos):","    marker = int(round(params['rule'][0]))","    size = int(round(params['rule'][1]))","    block = int(round(params['rule'][2]))","    if size <= 0 or size > 30 or block <= 0:","        return grid.copy()","    background = int(np.argmax(np.bincount(grid.flatten())))","    output = np.full((size, size), background, dtype=int)","    for position in np.argwhere(grid == marker):","        row = int(position[0]) // block","        col = int(position[1]) // block","        if 0 <= row < size and 0 <= col < size:","            output[row, col] = marker","    return output"],"shapes":{"rule":[3]},"params":{"rule":[0,3,5]},"rationale":"Compress the input into a 3×3 grid of 5×5 regions. Each region containing a black pixel becomes black; other regions retain the dominant input colour."}]