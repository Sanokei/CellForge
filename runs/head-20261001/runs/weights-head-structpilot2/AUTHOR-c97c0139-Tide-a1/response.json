[{"task_id":"c97c0139","source_lines":["def run(params, grid, demos):","    source = int(round(params['rule'][0]))","    fill = int(round(params['rule'][1]))","    background = int(round(params['rule'][2]))","    unit = int(round(params['rule'][3]))","    minimum_length = int(round(params['rule'][4]))","    taper = int(round(params['rule'][5]))","    if unit <= 0 or minimum_length <= 0 or taper <= 0 or fill < 0 or fill > 9:","        return grid.copy()","    result = grid.copy()","    for axis_value in params['axes']:","        axis = int(round(axis_value))","        if axis == 0:","            original = grid","            target = result","        elif axis == 1:","            original = grid.T","            target = result.T","        else:","            continue","        height = len(original)","        width = len(original[0])","        for row in range(height):","            col = 0","            while col < width:","                if original[row, col] != source:","                    col += unit","                    continue","                start = col","                while col < width and original[row, col] == source:","                    col += unit","                end = min(col, width)","                if end - start < minimum_length:","                    continue","                for other_row in range(height):","                    distance = abs(other_row - row)","                    if distance == 0:","                        continue","                    left = start + distance * taper","                    right = end - distance * taper","                    for other_col in range(max(0, left), min(width, right)):","                        if original[other_row, other_col] == background:","                            target[other_row, other_col] = fill","    return result"],"shapes":{"rule":[6],"axes":[2]},"params":{"rule":[2,8,0,1,2,1],"axes":[0,1]},"rationale":"Each horizontal or vertical red segment forms the central diameter of a cyan diamond. On both sides, each successive parallel slice is inset by one cell at each endpoint. Preserve red segments and paint only background cells; even-length segments produce two-cell tips."}]