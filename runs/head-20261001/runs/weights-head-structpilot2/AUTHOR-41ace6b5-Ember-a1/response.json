[{"task_id":"41ace6b5","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    red = int(round(params['colors'][1]))","    gray = int(round(params['colors'][2]))","    orange = int(round(params['colors'][3]))","    blue = int(round(params['colors'][4]))","    fill = int(round(params['colors'][5]))","    unit = int(round(params['geometry'][0]))","    out = grid.copy()","    red_positions = np.argwhere(grid == red)","    gray_positions = np.argwhere(grid == gray)","    if len(red_positions) == 0 or len(gray_positions) == 0:","        return out","    red_row = int(red_positions[0][0])","    gray_row = int(gray_positions[0][0])","    rows = np.arange(grid.shape[0])","    for col in range(grid.shape[1]):","        orange_count = int(np.count_nonzero(grid[:, col] == orange))","        blue_count = int(np.count_nonzero(grid[:, col] == blue))","        if orange_count + blue_count > 0:","            out[:, col] = background","            orange_mask = (rows >= red_row - orange_count + unit) & (rows <= red_row)","            blue_mask = (rows >= gray_row) & (rows < gray_row + blue_count)","            fill_mask = rows >= gray_row + blue_count","            out[orange_mask, col] = orange","            out[blue_mask, col] = blue","            out[fill_mask, col] = fill","    return out"],"shapes":{"colors":[6],"geometry":[1]},"params":{"colors":[7,2,5,8,1,9],"geometry":[1]},"rationale":"Each colored vertical column retains its orange and blue cell counts. Orange segments align their bottoms with the red reference row; blue segments align their tops with the gray reference row. Remaining cells below each blue segment become 9, and vacated cells become background."}]