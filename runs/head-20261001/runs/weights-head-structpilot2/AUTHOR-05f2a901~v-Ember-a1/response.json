[{"task_id":"05f2a901~v","source_lines":["def run(params, grid, demos):","    background = int(round(params['v'][0]))","    moving = int(round(params['v'][1]))","    target = int(round(params['v'][2]))","    gap = int(round(params['v'][3]))","    points = np.argwhere(grid == moving)","    anchors = np.argwhere(grid == target)","    out = grid.copy()","    if len(points) == 0 or len(anchors) == 0:","        return out","    low = np.min(points, axis=0)","    high = np.max(points, axis=0)","    target_low = np.min(anchors, axis=0)","    target_high = np.max(anchors, axis=0)","    dr = int(low[0] - low[0])","    dc = int(low[1] - low[1])","    if high[0] < target_low[0]:","        dr = int(target_low[0] - gap - high[0])","    elif low[0] > target_high[0]:","        dr = int(target_high[0] + gap - low[0])","    elif high[1] < target_low[1]:","        dc = int(target_low[1] - gap - high[1])","    elif low[1] > target_high[1]:","        dc = int(target_high[1] + gap - low[1])","    out[grid == moving] = background","    for point in points:","        r = int(point[0]) + dr","        c = int(point[1]) + dc","        if 0 <= r < len(out) and 0 <= c < len(out[0]):","            out[r, c] = moving","    return out"],"shapes":{"v":[4]},"params":{"v":[0,6,2,1]},"rationale":"Translate the magenta shape toward the stationary red square along their separating axis until their bounding boxes touch, preserving its shape and perpendicular position. The test shape moves upward two rows. Tensor values encode background, moving color, target color, and adjacency distance."}]