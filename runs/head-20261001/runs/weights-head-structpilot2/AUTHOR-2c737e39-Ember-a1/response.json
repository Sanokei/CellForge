l]","    return result"],"shapes":{"colors":[2],"directions":[4,2]},"params":{"colors":[0,5],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Find the connected multicolored object containing a gray anchor. Copy its colored cells to each isolated gray marker using the anchor-relative offsets, erase the destination marker, and preserve the original object. Background, anchor color, and connectivity are tensor-controlled."}]