[{"task_id":"1a244afd~v","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    pivot = int(round(params['colors'][1]))","    marker = int(round(params['colors'][2]))","    target = int(round(params['colors'][3]))","    zero = int(round(params['rotation'][0]))","    positive = int(round(params['rotation'][1]))","    negative = int(round(params['rotation'][2]))","    out = grid.copy()","    anchors = np.argwhere(grid == pivot).tolist()","    points = np.argwhere(grid == marker).tolist()","    out[grid == marker] = bg","    used_anchors = set()","    used_points = set()","    height = len(grid)","    width = len(grid[0])","    while len(used_points) < len(points):","        best = None","        for i, point in enumerate(points):","            if i in used_points:","                continue","            for j, anchor in enumerate(anchors):","                if j in used_anchors:","                    continue","                dr = point[0] - anchor[0]","                dc = point[1] - anchor[1]","                if dr != zero and dc != zero:","                    continue","                distance = abs(dr) + abs(dc)","                if best is None or distance < best[0]:","                    best = (distance, i, j, dr, dc)","        if best is None:","            break","        distance, i, j, dr, dc = best","        used_points.add(i)","        used_anchors.add(j)","        row = anchors[j][0] + zero * dr + positive * dc","        col = anchors[j][1] + negative * dr + zero * dc","        if zero <= row < height and zero <= col < width:","            out[row, col] = target","    return out"],"shapes":{"colors":[4],"rotation":[3]},"params":{"colors":[1,4,9,2],"rotation":[0,1,-1]},"rationale":"Pair aligned yellow pivots and maroon markers by shortest available distance. Rotate each marker displacement clockwise by 90 degrees around its pivot, erase the original marker, and draw the rotated position red when it lies inside the grid."}]