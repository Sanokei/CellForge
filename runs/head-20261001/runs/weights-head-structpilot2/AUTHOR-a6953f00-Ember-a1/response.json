[{"task_id":"a6953f00","source_lines":["def run(params, grid, demos):","    size = int(round(params['rule'][0]))","    modulus = int(round(params['rule'][1]))","    residue = int(round(params['rule'][2]))","    side = int(round(params['rule'][3]))","    if size <= 0 or modulus <= 0:","        return grid.copy()","    height, width = grid.shape","    start = 0","    if width % modulus == residue:","        start = side * (width - size)","    start = max(0, min(width - size, start))","    return grid[:size, start:start + size].copy()"],"shapes":{"rule":[4]},"params":{"rule":[2,2,0,1]},"rationale":"Extract a 2×2 patch from the top edge: the right corner for even widths and the left corner for odd widths. This reproduces all demonstrations, though the parity rule is uncertain from the available examples."}]