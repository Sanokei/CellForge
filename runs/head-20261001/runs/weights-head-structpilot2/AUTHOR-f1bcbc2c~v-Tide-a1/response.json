[{"task_id":"f1bcbc2c~v","source_lines":["def run(params, grid, demos):","    background = int(round(params['colours'][0]))","    wall = int(round(params['colours'][1]))","    marker = int(round(params['colours'][2]))","    fill = int(round(params['colours'][3]))","    threshold = int(round(params['threshold'][0]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    pairs = []","    for pair in params['pairs']:","        pairs.append((int(round(pair[0])), int(round(pair[1]))))","    height, width = grid.shape","    eligible = np.zeros(grid.shape, dtype=bool)","    starts = []","    for r in range(height):","        for c in range(width):","            neighbours = []","            for dr, dc in directions:","                rr, cc = r + dr, c + dc","                neighbours.append(0 <= rr < height and 0 <= cc < width and grid[rr, cc] == wall)","            straight = False","            for a, b in pairs:","                if 0 <= a < len(neighbours) and 0 <= b < len(neighbours):","                    if neighbours[a] and neighbours[b]:","                        straight = True","            value = grid[r, c]","            if value == background and sum(neighbours) >= threshold:","                eligible[r, c] = True","            elif value == marker and straight:","                eligible[r, c] = True","            if eligible[r, c] and straight:","                boundary = False","                for dr, dc in directions:","                    rr, cc = r + dr, c + dc","                    if rr < 0 or rr >= height or cc < 0 or cc >= width:","                        boundary = True","                if boundary:","                    starts.append((r, c))","    result = grid.copy()","    if not starts or fill < 0 or fill > 9:","        return result","    pending = [starts[0]]","    visited = set()","    while pending:","        r, c = pending.pop()","        if (r, c) in visited:","            continue","        visited.add((r, c))","        result[r, c] = fill","        for dr, dc in directions:","            rr, cc = r + dr, c + dc","            if 0 <= rr < height and 0 <= cc < width:","                if eligible[rr, cc] and (rr, cc) not in visited:","                    pending.append((rr, cc))","    return result"],"shapes":{"colours":[4],"directions":[4,2],"pairs":[2,2],"threshold":[1]},"params":{"colours":[0,8,4,3],"directions":[[-1,0],[1,0],[0,-1],[0,1]],"pairs":[[0,1],[2,3]],"threshold":[2]},"rationale":"Fill the narrow corridor from its first boundary entrance. Corridor cells have at least two adjacent wall cells. Yellow is traversable and recoloured when sandwiched between opposite walls; yellow at a bend blocks passage and remains unchanged."}]