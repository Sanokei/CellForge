[{"task_id":"b7fb29bc~v","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    marker = int(round(params['colors'][1]))","    odd_color = int(round(params['colors'][2]))","    even_color = int(round(params['colors'][3]))","    step = int(round(params['rings'][0]))","    period = int(round(params['rings'][1]))","    odd_phase = int(round(params['rings'][2]))","    out = grid.copy()","    if step <= 0 or period <= 0:","        return out","    points = np.argwhere(grid == marker)","    if len(points) == 0:","        return out","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0]))","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1]))","    centers = []","    for point in points:","        r = int(point[0])","        c = int(point[1])","        if top < r < bottom and left < c < right:","            centers.append((r, c))","    if len(centers) == 0:","        return out","    center_r, center_c = centers[0]","    for r in range(top + step, bottom):","        for c in range(left + step, right):","            if grid[r, c] == background:","                distance = max(abs(r - center_r), abs(c - center_c))","                phase = (distance // step) % period","                out[r, c] = odd_color if phase == odd_phase else even_color","    return out"],"shapes":{"colors":[4],"rings":[3]},"params":{"colors":[0,4,2,3],"rings":[1,2,1]},"rationale":"Fill the yellow frame's interior with concentric square rings centered on its interior yellow marker. Odd Chebyshev distances are red and even distances are green; preserve the frame and marker."}]