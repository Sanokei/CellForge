[{"task_id":"7e4d4f7c","source_lines":["def run(params, grid, demos):","    height = int(round(params['layout'][0]))","    top = int(round(params['layout'][1]))","    middle = int(round(params['layout'][2]))","    target = int(round(params['layout'][3]))","    background_column = int(round(params['layout'][4]))","    color = int(round(params['paint'][0]))","    background = grid[middle, background_column]","    result = grid[:height].copy()","    result[target] = np.where(grid[top] != background, color, background)","    return result"],"shapes":{"layout":[5],"paint":[1]},"params":{"layout":[3,0,1,2,-1],"paint":[6]},"rationale":"Keep the first three rows. Infer the background from the rightmost cell of the second row, then replace foreground positions from the first row with color 6 in the third row."}]