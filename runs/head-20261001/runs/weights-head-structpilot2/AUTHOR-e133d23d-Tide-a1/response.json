[{"task_id":"e133d23d","source_lines":["def run(params, grid, demos):","    left_color = int(round(params['colors'][0]))","    right_color = int(round(params['colors'][1]))","    separator = int(round(params['colors'][2]))","    foreground = int(round(params['colors'][3]))","    background = int(round(params['colors'][4]))","    separator_width = int(round(params['geometry'][0]))","    columns = np.argwhere(np.all(grid == separator, axis=0)).flatten()","    if len(columns) != separator_width or separator_width <= 0:","        return grid.copy()","    split = int(columns[0])","    left = grid[:, :split]","    right = grid[:, split + separator_width:]","    if left.shape != right.shape:","        return grid.copy()","    occupied = np.logical_or(left == left_color, right == right_color)","    return np.where(occupied, foreground, background)"],"shapes":{"colors":[5],"geometry":[1]},"params":{"colors":[6,8,4,2,0],"geometry":[1]},"rationale":"Split at the solid color-4 separator column, overlay the left color-6 and right color-8 masks with logical OR, and render occupied cells as 2 and empty cells as 0."}]