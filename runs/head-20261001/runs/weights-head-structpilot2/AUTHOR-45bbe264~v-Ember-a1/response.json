[{"task_id":"45bbe264~v","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    crossing = int(round(params['rule'][1]))","    row_axis = int(round(params['rule'][2]))","    col_axis = int(round(params['rule'][3]))","    points = np.argwhere(grid != background)","    out = np.full(grid.shape, background, dtype=int)","    for point in points:","        r = int(point[row_axis])","        c = int(point[col_axis])","        color = int(grid[r, c])","        out[r, :] = color","        out[:, c] = color","    for first in points:","        for second in points:","            if np.any(first != second):","                r = int(first[row_axis])","                c = int(second[col_axis])","                out[r, c] = crossing","    return out"],"shapes":{"rule":[4]},"params":{"rule":[0,3,0,1]},"rationale":"Extend each nonbackground seed across its entire row and column in its original color. Mark intersections between crosses from different seeds green. The tensor specifies the background, intersection color, and coordinate axes."}]