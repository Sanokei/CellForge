[{"task_id":"5a719d11","source_lines":["def bands(active):","    result = []","    start = None","    for i in range(len(active)):","        if active[i]:","            if start is None:","                start = i","        elif start is not None:","            result.append((start, i))","            start = None","    if start is not None:","        result.append((start, len(active)))","    return result","","def run(params, grid, demos):","    separator = int(round(params['rule'][0]))","    partner_shift = int(round(params['rule'][1]))","    rows = bands(np.any(grid != separator, axis=1))","    cols = bands(np.any(grid != separator, axis=0))","    result = grid.copy()","    for top, bottom in rows:","        for j in range(len(cols)):","            left, right = cols[j]","            other_left, other_right = cols[(j + partner_shift) % len(cols)]","            tile = grid[top:bottom, left:right]","            other = grid[top:bottom, other_left:other_right]","            if tile.shape == other.shape:","                background = int(tile[0, 0])","                other_background = int(other[0, 0])","                result[top:bottom, left:right] = np.where(other != other_background, other_background, background)","    return result"],"shapes":{"rule":[2]},"params":{"rule":[0,1]},"rationale":"Black separator bands partition the grid into paired panels. Each panel receives its horizontal partner's foreground mask at the same local coordinates, colored with the partner's background. Equal panel backgrounds make both objects disappear. The tensors specify the separator color and partner shift; zeroing the shift instead erases every object."}]