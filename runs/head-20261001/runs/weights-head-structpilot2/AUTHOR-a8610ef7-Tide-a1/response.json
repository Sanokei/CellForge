[{"task_id":"a8610ef7","source_lines":["def run(params, grid, demos):","    bg = int(round(params['config'][0]))","    ink = int(round(params['config'][1]))","    red = int(round(params['config'][2]))","    gray = int(round(params['config'][3]))","    size = int(round(params['config'][4]))","    radius = int(round(params['config'][5]))","    base = int(round(params['config'][6]))","    training = []","    for k in range(len(params['inputs'])):","        a = np.full((size, size), bg)","        b = np.full((size, size), bg)","        for r in range(size):","            x = int(round(params['inputs'][k][r]))","            y = int(round(params['labels'][k][r]))","            for c in range(size):","                if (x // (base ** c)) % base:","                    a[r, c] = ink","                    b[r, c] = red if (y // (base ** c)) % base else gray","        training.append((a, b))","    offsets = []","    for dr in range(-radius, radius + 1):","        for dc in range(-radius, radius + 1):","            offsets.append((dr, dc))","    examples = []","    for a, b in training:","        for r in range(a.shape[0]):","            for c in range(a.shape[1]):","                if a[r, c] == ink:","                    patch = []","                    for dr, dc in offsets:","                        rr = r + dr","                        cc = c + dc","                        patch.append(int(a[rr, cc] == ink) if 0 <= rr < a.shape[0] and 0 <= cc < a.shape[1] else -1)","                    examples.append((patch, int(b[r, c])))","    result = np.full(grid.shape, bg)","    for r in range(grid.shape[0]):","        for c in range(grid.shape[1]):","            if grid[r, c] == ink:","                patch = []","                for dr, dc in offsets:","                    rr = r + dr","                    cc = c + dc","                    patch.append(int(grid[rr, cc] == ink) if 0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1] else -1)","                best = None","                votes = {}","                for candidate, label in examples:","                    score = 0","                    for i in range(len(offsets)):","                        dr, dc = offsets[i]","                        weight = radius + radius + 1 - abs(dr) - abs(dc)","                        if patch[i] != candidate[i]:","                            score += weight","                    if best is None or score < best:","                        best = score","                        votes = {label: 1}","                    elif score == best:","                        votes[label] = votes.get(label, 0) + 1","                result[r, c] = red if votes.get(red, 0) >= votes.get(gray, 0) else gray","    return result"],"shapes":{"config":[7],"inputs":[4,6],"labels":[4,6]},"params":{"config":[0,8,2,5,6,2,2],"inputs":[[58,31,21,46,27,35],[27,29,60,50,43,41],[38,7,23,45,3,31],[7,44,2,51,61,48]],"labels":[[34,27,4,4,27,34],[9,9,48,48,9,9],[6,3,5,5,3,6],[0,44,2,2,12,0]]},"rationale":"The tensors encode the demonstration occupancy and red-label masks, with explicit color and neighborhood parameters. The structure transfers labels through weighted local patch matching. This is a best-effort generalization; the underlying exact rule has not been identified."}]