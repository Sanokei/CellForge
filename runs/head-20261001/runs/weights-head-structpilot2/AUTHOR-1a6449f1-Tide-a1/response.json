[{"task_id":"1a6449f1","source_lines":["def run(params, grid, demos):","    background = int(round(params['frame'][0]))","    span = int(round(params['frame'][1]))","    inset = int(round(params['frame'][2]))","    if span <= 0 or inset <= 0:","        return grid.copy()","    height, width = grid.shape","    best_area = 0","    result = grid.copy()","    for top in range(height):","        for left in range(width):","            color = int(grid[top, left])","            if color == background:","                continue","            for bottom in range(top + span - 1, height):","                if grid[bottom, left] != color:","                    continue","                if not np.all(grid[top:bottom + 1, left] == color):","                    continue","                for right in range(left + span - 1, width):","                    inner_height = bottom - top + 1 - inset - inset","                    inner_width = right - left + 1 - inset - inset","                    area = inner_height * inner_width","                    if inner_height <= 0 or inner_width <= 0 or area <= best_area:","                        continue","                    if not np.all(grid[top, left:right + 1] == color):","                        continue","                    if not np.all(grid[bottom, left:right + 1] == color):","                        continue","                    if not np.all(grid[top:bottom + 1, right] == color):","                        continue","                    best_area = area","                    result = grid[top + inset:bottom + 1 - inset, left + inset:right + 1 - inset].copy()","    return result"],"shapes":{"frame":[3]},"params":{"frame":[0,3,1]},"rationale":"Find complete monochromatic rectangular frames excluding the learned background, select the frame with the largest interior area, and return its contents with the learned border thickness removed. This selects the 4, 8, and 1 frames in the demonstrations and the large 3 frame in the test."}]