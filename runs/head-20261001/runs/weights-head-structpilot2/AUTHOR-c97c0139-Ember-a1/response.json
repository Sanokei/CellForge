[{"task_id":"c97c0139","source_lines":["def run(params, grid, demos):","    source = int(round(params['colors'][0]))","    fill = int(round(params['colors'][1]))","    background = int(round(params['colors'][2]))","    unit = int(round(params['geometry'][0]))","    minimum_length = int(round(params['geometry'][1]))","    out = grid.copy()","    height = len(grid)","    width = len(grid[0])","    for direction in params['directions']:","        dr = int(round(direction[0]))","        dc = int(round(direction[1]))","        if dr == 0 and dc == 0:","            continue","        for r in range(height):","            for c in range(width):","                if grid[r, c] != source:","                    continue","                previous_r = r - dr","                previous_c = c - dc","                if 0 <= previous_r < height and 0 <= previous_c < width:","                    if grid[previous_r, previous_c] == source:","                        continue","                segment = []","                for distance in range(max(height, width)):","                    rr = r + distance * dr","                    cc = c + distance * dc","                    if not (0 <= rr < height and 0 <= cc < width):","                        break","                    if grid[rr, cc] != source:","                        break","                    segment.append((rr, cc))","                length = len(segment)","                if length < minimum_length:","                    continue","                for index in range(length):","                    rr, cc = segment[index]","                    radius = min(index, length - unit - index)","                    for offset in range(-radius, radius + unit):","                        target_r = rr - offset * dc","                        target_c = cc + offset * dr","                        if 0 <= target_r < height and 0 <= target_c < width:","                            if grid[target_r, target_c] == background:","                                out[target_r, target_c] = fill","    return out"],"shapes":{"colors":[3],"geometry":[2],"directions":[2,2]},"params":{"colors":[2,8,0],"geometry":[1,2],"directions":[[0,1],[1,0]]},"rationale":"Each red line becomes the central diameter of a filled azure diamond. At each position along the line, extend perpendicularly in both directions by the distance to the nearer endpoint. Even-length lines produce diamonds with two-cell tips. Preserve the original red lines and grid dimensions."}]