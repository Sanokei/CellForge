[{"task_id":"a8610ef7","source_lines":["def run(params, grid, demos):","    ink = int(round(params['colors'][0]))","    bg = int(round(params['colors'][1]))","    red = int(round(params['colors'][2]))","    gray = int(round(params['colors'][3]))","    offsets = []","    for k in range(len(params['offsets'])):","        offsets.append((int(round(params['offsets'][k][0])), int(round(params['offsets'][k][1]))))","    def features(a, r, c):","        h, w = a.shape","        result = []","        for dr, dc in offsets:","            rr, cc = r + dr, c + dc","            if rr >= 0 and rr < h and cc >= 0 and cc < w:","                result.append(int(a[rr, cc] == ink))","            else:","                result.append(int(round(params['boundary'][0])))","        return result","    examples = []","    for a, b in demos:","        for r in range(a.shape[0]):","            for c in range(a.shape[1]):","                if a[r, c] == ink:","                    examples.append((features(a, r, c), int(b[r, c])))","    out = np.full(grid.shape, bg, dtype=int)","    for r in range(grid.shape[0]):","        for c in range(grid.shape[1]):","            if grid[r, c] != ink:","                continue","            f = features(grid, r, c)","            best = float(params['limit'][0])","            votes = {red: 0.0, gray: 0.0}","            for e, label in examples:","                distance = 0.0","                for k in range(len(f)):","                    distance += float(params['weights'][k]) * abs(f[k] - e[k])","                if distance < best:","                    best = distance","                    votes = {red: 0.0, gray: 0.0}","                if distance == best and label in votes:","                    votes[label] += float(params['vote'][0])","            out[r, c] = red if votes[red] >= votes[gray] else gray","    return out"],"shapes":{"colors":[4],"offsets":[24,2],"weights":[24],"boundary":[1],"limit":[1],"vote":[1]},"params":{"colors":[8,0,2,5],"offsets":[[-2,-2],[-2,-1],[-2,0],[-2,1],[-2,2],[-1,-2],[-1,-1],[-1,0],[-1,1],[-1,2],[0,-2],[0,-1],[0,1],[0,2],[1,-2],[1,-1],[1,0],[1,1],[1,2],[2,-2],[2,-1],[2,0],[2,1],[2,2]],"weights":[0.25,0.5,1,0.5,0.25,0.5,1,2,1,0.5,1,2,2,1,0.5,1,2,1,0.5,0.25,0.5,1,0.5,0.25],"boundary":[0],"limit":[1000],"vote":[1]},"rationale":"Best attempt: infer recoloring from weighted local occupancy templates in the other demonstrations. Tensor values specify the colors, neighborhood, distance weights, boundary convention, and voting. Exact reproduction of every demonstration is not established."}]