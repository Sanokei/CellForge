[{"task_id":"2601afb7","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    color_shift = int(round(params['rule'][1]))","    height_shift = int(round(params['rule'][2]))","    columns = []","    colors = []","    masks = []","    for column in range(grid.shape[1]):","        mask = grid[:, column] != background","        if np.any(mask):","            columns.append(column)","            colors.append(int(np.unique(grid[:, column][mask])[0]))","            masks.append(mask)","    output = np.full(grid.shape, background)","    count = len(columns)","    for index in range(count):","        color = colors[(index + color_shift) % count]","        mask = masks[(index + height_shift) % count]","        output[mask, columns[index]] = color","    return output"],"shapes":{"rule":[3]},"params":{"rule":[7,-1,1]},"rationale":"Across occupied columns, rotate colors one position right and independently rotate bar heights one position left, preserving column positions and vertical masks."}]