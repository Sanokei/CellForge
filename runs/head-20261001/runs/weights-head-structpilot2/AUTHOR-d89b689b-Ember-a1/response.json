[{"task_id":"d89b689b","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    marker = int(round(params['colors'][1]))","    row_axis = int(round(params['geometry'][0]))","    col_axis = int(round(params['geometry'][1]))","    divisor = float(params['geometry'][2])","    direction = float(params['geometry'][3])","    out = np.full(grid.shape, background, dtype=int)","    locations = np.argwhere(grid == marker)","    if len(locations) == 0 or divisor == 0:","        return out","    row_low = int(np.min(locations[:, row_axis]))","    row_high = int(np.max(locations[:, row_axis]))","    col_low = int(np.min(locations[:, col_axis]))","    col_high = int(np.max(locations[:, col_axis]))","    row_center = (row_low + row_high) / divisor","    col_center = (col_low + col_high) / divisor","    objects = np.argwhere(np.logical_and(grid != background, grid != marker))","    for point in objects:","        r = int(point[row_axis])","        c = int(point[col_axis])","        target_r = row_high if direction * (r - row_center) > 0 else row_low","        target_c = col_high if direction * (c - col_center) > 0 else col_low","        out[target_r, target_c] = grid[r, c]","    return out"],"shapes":{"colors":[2],"geometry":[4]},"params":{"colors":[0,8],"geometry":[0,1,2,1]},"rationale":"Move each isolated colored cell into the corresponding quadrant of the azure block, clearing its original position. The tensors specify background, block color, coordinate axes, center divisor, and quadrant orientation."}]