[{"task_id":"2601afb7","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    color_shift = int(round(params['rule'][1]))","    height_shift = int(round(params['rule'][2]))","    vertical_direction = int(round(params['rule'][3]))","    columns = []","    colors = []","    heights = []","    for column, values in enumerate(grid.T):","        occupied = np.argwhere(values != background).flatten()","        if len(occupied) > 0:","            columns.append(column)","            colors.append(int(values[occupied[0]]))","            heights.append(len(occupied))","    result = np.full(grid.shape, background, dtype=int)","    count = len(columns)","    for index, column in enumerate(columns):","        color = colors[(index + color_shift) % count]","        height = heights[(index + height_shift) % count]","        if vertical_direction > 0:","            result[len(grid) - height:, column] = color","        else:","            result[:height, column] = color","    return result"],"shapes":{"rule":[4]},"params":{"rule":[7,-1,1,1]},"rationale":"Keep the occupied columns fixed. Independently rotate their colors one position right and their heights one position left, then draw each resulting bar aligned to the bottom. The tensors specify the background, both cyclic shifts, and vertical alignment."}]