[{"task_id":"fe9372f3","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    seed = int(round(params['colors'][1]))","    diagonal = int(round(params['colors'][2]))","    axial = int(round(params['colors'][3]))","    marker = int(round(params['colors'][4]))","    radius = int(round(params['geometry'][0]))","    period = int(round(params['geometry'][1]))","    phase = int(round(params['geometry'][2]))","    slope = int(round(params['geometry'][3]))","    out = grid.copy()","    points = np.argwhere(grid == seed)","    if len(points) == 0 or period <= 0:","        return out","    center_r = int(round(np.mean(points[:, 0])))","    center_c = int(round(np.mean(points[:, 1])))","    for r in range(grid.shape[0]):","        for c in range(grid.shape[1]):","            if grid[r, c] != bg:","                continue","            dr = abs(r - center_r)","            dc = abs(c - center_c)","            if dr == dc * slope and dr > 0:","                out[r, c] = diagonal","            if (dr == 0 or dc == 0) and dr + dc > radius:","                distance = dr + dc","                if distance % period == phase:","                    out[r, c] = marker","                else:","                    out[r, c] = axial","    return out"],"shapes":{"colors":[5],"geometry":[4]},"params":{"colors":[0,2,1,8,4],"geometry":[1,3,1,1]},"rationale":"Locate the red cross center. Extend blue diagonal rays and cyan axial rays to the boundaries, preserving the cross. Axial cells at distances 4, 7, 10, and so on are yellow."}]