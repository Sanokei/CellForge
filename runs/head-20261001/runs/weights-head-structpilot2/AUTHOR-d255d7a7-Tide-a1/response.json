[{"task_id":"d255d7a7","source_lines":["def run(params, grid, demos):","    zero = int(round(params['colors'][0]))","    background = int(round(params['colors'][1]))","    size = max(1, int(round(params['head'][0])))","    steps = [(int(round(v[0])), int(round(v[1]))) for v in params['neighbors']]","    height, width = grid.shape","    result = grid.copy()","    result[grid == zero] = background","    seen = set()","    for point in np.argwhere(grid == zero):","        start = (int(point[0]), int(point[1]))","        if start in seen:","            continue","        seen.add(start)","        pending = [start]","        component = []","        while pending:","            row, col = pending.pop()","            component.append((row, col))","            for dr, dc in steps:","                rr, cc = row + dr, col + dc","                if 0 <= rr < height and 0 <= cc < width:","                    neighbor = (rr, cc)","                    if neighbor not in seen and grid[rr, cc] == zero:","                        seen.add(neighbor)","                        pending.append(neighbor)","        top = min(p[0] for p in component)","        bottom = max(p[0] for p in component) + 1","        left = min(p[1] for p in component)","        right = max(p[1] for p in component) + 1","        if bottom - top > right - left:","            thickness = min(size, bottom - top)","            first = np.count_nonzero(grid[top:top + thickness, left:right] == zero)","            last = np.count_nonzero(grid[bottom - thickness:bottom, left:right] == zero)","            if first > last:","                source = top","                destination = height - thickness","            else:","                source = bottom - thickness","                destination = 0","            block = grid[source:source + thickness, left:right].copy()","            result[source:source + thickness, left:right] = background","            result[destination:destination + thickness, left:right] = block","        else:","            thickness = min(size, right - left)","            first = np.count_nonzero(grid[top:bottom, left:left + thickness] == zero)","            last = np.count_nonzero(grid[top:bottom, right - thickness:right] == zero)","            if first > last:","                source = left","                destination = width - thickness","            else:","                source = right - thickness","                destination = 0","            block = grid[top:bottom, source:source + thickness].copy()","            result[top:bottom, source:source + thickness] = background","            result[top:bottom, destination:destination + thickness] = block","    return result"],"shapes":{"colors":[2],"head":[1],"neighbors":[4,2]},"params":{"colors":[0,7],"head":[3],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Each connected black shape is a three-cell-wide head with a long stem. Remove the stem and translate the intact head, including enclosed maroon cells, to the opposite grid boundary without rotating it. Maroon cells outside the heads stay fixed. The tensors encode black, background, head size, and connectivity."}]