[{"task_id":"45bbe264","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    crossing = int(round(params['colors'][1]))","    row_axis = int(round(params['axes'][0]))","    col_axis = int(round(params['axes'][1]))","    if row_axis != 0 or col_axis != 1:","        return grid.copy()","    points = np.argwhere(grid != bg)","    out = grid.copy()","    for point in points:","        r = int(point[row_axis])","        c = int(point[col_axis])","        color = int(grid[r, c])","        out[r, :] = color","        out[:, c] = color","    for first in points:","        for second in points:","            r = int(first[row_axis])","            c = int(second[col_axis])","            first_color = int(grid[int(first[row_axis]), int(first[col_axis])])","            second_color = int(grid[int(second[row_axis]), int(second[col_axis])])","            if first_color != second_color:","                out[r, c] = crossing","    return out"],"shapes":{"colors":[2],"axes":[2]},"params":{"colors":[0,2],"axes":[0,1]},"rationale":"Extend each nonbackground seed across its entire row and column in its original color. Paint intersections of lines from differently colored seeds red (2). Tensor values specify the background, intersection color, and coordinate axes."}]