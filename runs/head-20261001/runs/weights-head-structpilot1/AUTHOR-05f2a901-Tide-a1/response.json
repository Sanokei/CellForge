[{"task_id":"05f2a901","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    moving = int(round(params['colors'][1]))","    anchor = int(round(params['colors'][2]))","    unit = int(round(params['unit'][0]))","    out = grid.copy()","    if background == moving or moving == anchor or background == anchor or unit <= 0:","        return out","    cells = np.argwhere(grid == moving)","    anchors = np.argwhere(grid == anchor)","    if len(cells) == 0 or len(anchors) == 0:","        return out","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    height, width = grid.shape","    best = None","    best_distance = None","    for dr, dc in directions:","        for distance in range(unit, max(height, width) + unit, unit):","            shifted = []","            valid = True","            touching = False","            for row, col in cells:","                nr = int(row) + dr * distance","                nc = int(col) + dc * distance","                if nr < 0 or nr >= height or nc < 0 or nc >= width:","                    valid = False","                    break","                if grid[nr, nc] == anchor:","                    valid = False","                    break","                shifted.append((nr, nc))","                for ar, ac in directions:","                    rr = nr + ar","                    cc = nc + ac","                    if 0 <= rr < height and 0 <= cc < width:","                        if grid[rr, cc] == anchor:","                            touching = True","            if valid and touching:","                if best_distance is None or distance < best_distance:","                    best_distance = distance","                    best = shifted","                break","    if best is not None:","        for row, col in cells:","            out[row, col] = background","        for row, col in best:","            out[row, col] = moving","    return out"],"shapes":{"colors":[3],"unit":[1],"directions":[4,2]},"params":{"colors":[0,2,8],"unit":[1],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Translate the red shape along a cardinal direction by the smallest distance that makes it touch the stationary cyan square without overlap. Preserve its shape and the background. The test shape moves two columns left."}]