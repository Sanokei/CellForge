[{"task_id":"84db8fc4","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    exterior = int(round(params['colors'][1]))","    interior = int(round(params['colors'][2]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    height, width = grid.shape","    result = grid.copy()","    reached = np.zeros(grid.shape)","    queue = []","    for position in np.argwhere(grid == background):","        row, col = int(position[0]), int(position[1])","        result[row, col] = interior","        boundary = False","        for dr, dc in directions:","            nr, nc = row + dr, col + dc","            if nr < 0 or nr >= height or nc < 0 or nc >= width:","                boundary = True","        if boundary:","            reached[row, col] = 1","            queue.append((row, col))","    cursor = 0","    while cursor < len(queue):","        row, col = queue[cursor]","        cursor += 1","        result[row, col] = exterior","        for dr, dc in directions:","            nr, nc = row + dr, col + dc","            if 0 <= nr < height and 0 <= nc < width:","                if grid[nr, nc] == background and reached[nr, nc] == 0:","                    reached[nr, nc] = 1","                    queue.append((nr, nc))","    return result"],"shapes":{"colors":[3],"directions":[4,2]},"params":{"colors":[0,2,5],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Recolor zero cells connected to the grid boundary through orthogonal zero neighbors as 2; recolor enclosed zero cells as 5. Preserve other colors. The tensors specify the colors and connectivity."}]