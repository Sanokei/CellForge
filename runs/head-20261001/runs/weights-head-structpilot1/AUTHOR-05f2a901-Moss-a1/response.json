[{"task_id":"05f2a901","source_lines":["def run(params, grid, demos):","    bg = int(round(params['colors'][0]))","    moving = int(round(params['colors'][1]))","    target = int(round(params['colors'][2]))","    step = int(round(params['motion'][0]))","    zero = int(round(params['motion'][1]))","    out = grid.copy()","    if moving == target or moving == bg or target == bg or step <= zero:","        return out","    red = np.argwhere(grid == moving)","    blue = np.argwhere(grid == target)","    if len(red) == 0 or len(blue) == 0:","        return out","    rlo = np.min(red, axis=0)","    rhi = np.max(red, axis=0)","    blo = np.min(blue, axis=0)","    bhi = np.max(blue, axis=0)","    dr = zero","    dc = zero","    if rlo[0] <= bhi[0] and blo[0] <= rhi[0]:","        if np.mean(red[:, 1]) < np.mean(blue[:, 1]):","            dc = step","        else:","            dc = -step","    else:","        if np.mean(red[:, 0]) < np.mean(blue[:, 0]):","            dr = step","        else:","            dr = -step","    fixed = set()","    for r, c in blue:","        fixed.add((int(r), int(c)))","    positions = red.copy()","    for iteration in range(grid.shape[0] + grid.shape[1]):","        touching = False","        for r, c in positions:","            for delta in params['neighbors']:","                nr = int(r) + int(round(delta[0]))","                nc = int(c) + int(round(delta[1]))","                if (nr, nc) in fixed:","                    touching = True","        if touching:","            break","        candidate = positions + np.array([dr, dc])","        valid = True","        for r, c in candidate:","            if r < zero or c < zero or r >= grid.shape[0] or c >= grid.shape[1] or (int(r), int(c)) in fixed:","                valid = False","        if not valid:","            break","        positions = candidate","    out[grid == moving] = bg","    for r, c in positions:","        out[int(r), int(c)] = moving","    return out"],"shapes":{"colors":[3],"motion":[2],"neighbors":[4,2]},"params":{"colors":[0,2,8],"motion":[1,0],"neighbors":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Translate the red object toward the cyan square along their aligned axis, preserving its shape, until the objects first share an edge. The tensors encode the background and object colors, unit translation, and edge-neighbor offsets."}]