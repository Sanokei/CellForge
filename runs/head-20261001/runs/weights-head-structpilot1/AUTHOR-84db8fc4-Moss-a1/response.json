[{"task_id":"84db8fc4","source_lines":["def run(params, grid, demos):","    background = int(round(params['config'][0]))","    exterior = int(round(params['config'][1]))","    interior = int(round(params['config'][2]))","    margin = int(round(params['config'][3]))","    unit = int(round(params['config'][4]))","    directions = []","    for pair in params['directions']:","        directions.append((int(round(pair[0])), int(round(pair[1]))))","    height, width = grid.shape","    output = grid.copy()","    visited = np.zeros(grid.shape, dtype=bool)","    for position in np.argwhere(grid == background):","        row, col = int(position[0]), int(position[1])","        if visited[row, col]:","            continue","        pending = [(row, col)]","        visited[row, col] = True","        component = []","        touches_edge = False","        while pending:","            row, col = pending.pop()","            component.append((row, col))","            if row == margin or col == margin or row + unit == height - margin or col + unit == width - margin:","                touches_edge = True","            for dr, dc in directions:","                nr, nc = row + dr, col + dc","                if 0 <= nr < height and 0 <= nc < width:","                    if not visited[nr, nc] and grid[nr, nc] == background:","                        visited[nr, nc] = True","                        pending.append((nr, nc))","        color = exterior if touches_edge else interior","        for row, col in component:","            output[row, col] = color","    return output"],"shapes":{"config":[5],"directions":[4,2]},"params":{"config":[0,2,5,0,1],"directions":[[-1,0],[1,0],[0,-1],[0,1]]},"rationale":"Recolor orthogonally connected zero components: those touching the grid boundary become 2, and enclosed components become 5. Preserve other colors. The tensors encode the colors, boundary geometry, and connectivity."}]