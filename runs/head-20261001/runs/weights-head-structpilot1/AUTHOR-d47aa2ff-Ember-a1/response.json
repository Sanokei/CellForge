[{"task_id":"d47aa2ff","source_lines":["def run(params, grid, demos):","    background = int(round(params['colors'][0]))","    separator = int(round(params['colors'][1]))","    added = int(round(params['colors'][2]))","    removed = int(round(params['colors'][3]))","    gap = int(round(params['geometry'][0]))","    cuts = np.where(np.all(grid == separator, axis=0))[0]","    if len(cuts) != 1:","        return grid.copy()","    cut = int(cuts[0])","    left = grid[:, :cut].copy()","    right = grid[:, cut + gap:]","    if left.shape != right.shape:","        return grid.copy()","    changed = left != right","    result = left.copy()","    result[np.logical_and(changed, left != background)] = removed","    result[np.logical_and(changed, right != background)] = added","    return result"],"shapes":{"colors":[4],"geometry":[1]},"params":{"colors":[0,5,1,2],"geometry":[1]},"rationale":"The gray column separates before and after panels. Preserve unchanged cells, mark removed objects red (2), and mark newly occupied positions blue (1). The tensors specify background, divider, change colors, and divider width."}]