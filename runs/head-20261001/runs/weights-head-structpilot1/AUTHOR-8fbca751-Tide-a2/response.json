[{"task_id":"8fbca751","source_lines":["def run(params, grid, demos):","    foreground = int(round(params['colors'][0]))","    background = int(round(params['colors'][1]))","    fill = int(round(params['colors'][2]))","    band_height = int(round(params['geometry'][0]))","    result = grid.copy()","    points = np.argwhere(grid == foreground)","    if len(points) == 0 or band_height <= 0:","        return result","    first_row = int(np.min(points[:, 0]))","    last_row = int(np.max(points[:, 0]))","    for start in range(first_row, last_row + 1, band_height):","        selected = points[(points[:, 0] >= start) & (points[:, 0] < start + band_height)]","        if len(selected) == 0:","            continue","        top = int(np.min(selected[:, 0]))","        bottom = int(np.max(selected[:, 0]))","        left = int(np.min(selected[:, 1]))","        right = int(np.max(selected[:, 1]))","        for row in range(top, bottom + 1):","            for col in range(left, right + 1):","                if grid[row, col] == background:","                    result[row, col] = fill","    return result"],"shapes":{"colors":[3],"geometry":[1]},"params":{"colors":[8,0,2],"geometry":[4]},"rationale":"The shapes occupy four-row bands anchored at the first foreground row. Fill background cells inside each band's foreground bounding rectangle with red. This keeps diagonally touching shapes in successive bands separate while including disconnected fragments within the same band, reproducing all three demonstrations."}]