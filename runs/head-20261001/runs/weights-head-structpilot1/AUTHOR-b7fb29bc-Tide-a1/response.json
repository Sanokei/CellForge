[{"task_id":"b7fb29bc","source_lines":["def run(params, grid, demos):","    green = int(round(params['colors'][0]))","    yellow = int(round(params['colors'][1]))","    red = int(round(params['colors'][2]))","    inset = int(round(params['geometry'][0]))","    period = int(round(params['geometry'][1]))","    yellow_phase = int(round(params['geometry'][2]))","    out = grid.copy()","    if inset <= 0 or period <= 0:","        return out","    points = np.argwhere(grid == green)","    if len(points) == 0:","        return out","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0]))","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1]))","    markers = []","    for point in points:","        r = int(point[0])","        c = int(point[1])","        if top < r < bottom and left < c < right:","            markers.append((r, c))","    if len(markers) == 0:","        return out","    mr, mc = markers[0]","    for r in range(top + inset, bottom):","        for c in range(left + inset, right):","            if grid[r, c] != green:","                distance = int(np.maximum(np.abs(r - mr), np.abs(c - mc)))","                if distance % period == yellow_phase:","                    out[r, c] = yellow","                else:","                    out[r, c] = red","    return out"],"shapes":{"colors":[3],"geometry":[3]},"params":{"colors":[3,4,2],"geometry":[1,2,1]},"rationale":"Fill the green frame's interior with concentric square rings centered on the isolated green marker. Odd Chebyshev distances are yellow; even distances are red. Preserve the marker, frame, and exterior."}]