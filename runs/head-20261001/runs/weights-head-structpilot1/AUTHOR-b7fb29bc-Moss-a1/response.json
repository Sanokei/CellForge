[{"task_id":"b7fb29bc","source_lines":["def run(params, grid, demos):","    background = int(round(params['config'][0]))","    border = int(round(params['config'][1]))","    period = int(round(params['config'][2]))","    inset = int(round(params['config'][3]))","    even_color = int(round(params['colors'][0]))","    odd_color = int(round(params['colors'][1]))","    out = grid.copy()","    if period <= 0 or inset <= 0:","        return out","    points = np.argwhere(grid == border)","    if len(points) == 0:","        return out","    top = int(np.min(points[:, 0]))","    bottom = int(np.max(points[:, 0]))","    left = int(np.min(points[:, 1]))","    right = int(np.max(points[:, 1]))","    markers = []","    for point in points:","        r = int(point[0])","        c = int(point[1])","        if top < r < bottom and left < c < right:","            markers.append((r, c))","    if len(markers) == 0:","        return out","    mr, mc = markers[0]","    for r in range(top + inset, bottom):","        for c in range(left + inset, right):","            if grid[r, c] == background:","                distance = max(abs(r - mr), abs(c - mc))","                if distance % period == 0:","                    out[r, c] = even_color","                else:","                    out[r, c] = odd_color","    return out"],"shapes":{"config":[4],"colors":[2]},"params":{"config":[0,3,2,1],"colors":[2,4]},"rationale":"Fill the green frame's interior with concentric square rings centered on the interior green marker. Chebyshev distances alternate yellow at odd distances and red at even distances; preserve the frame and marker."}]