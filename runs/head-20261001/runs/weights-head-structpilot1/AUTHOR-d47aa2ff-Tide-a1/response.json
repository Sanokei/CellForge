[{"task_id":"d47aa2ff","source_lines":["def run(params, grid, demos):","    background = int(round(params['rule'][0]))","    separator = int(round(params['rule'][1]))","    added = int(round(params['rule'][2]))","    removed = int(round(params['rule'][3]))","    gap = int(round(params['rule'][4]))","    axis = int(round(params['rule'][5]))","    if axis != 0 and axis != 1:","        return grid.copy()","    boundaries = np.argwhere(np.all(grid == separator, axis=axis)).flatten()","    if len(boundaries) == 0:","        return grid.copy()","    cut = int(boundaries[0])","    if axis == 0:","        before = grid[:, :cut].copy()","        after = grid[:, cut + gap:].copy()","    else:","        before = grid[:cut, :].copy()","        after = grid[cut + gap:, :].copy()","    if before.shape != after.shape:","        return grid.copy()","    result = before.copy()","    result[np.logical_and(before != background, after == background)] = removed","    result[np.logical_and(before == background, after != background)] = added","    return result"],"shapes":{"rule":[6]},"params":{"rule":[0,5,1,2,1,0]},"rationale":"The gray divider separates before and after panels. Preserve unchanged pixels, mark disappeared pixels red (2), and mark newly appearing pixels blue (1). Tensor entries specify background, divider, addition and removal colors, divider width, and comparison axis."}]